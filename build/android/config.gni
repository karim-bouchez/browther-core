  "//brave/third_party/android_deps:google_play_services_safetynet_java",
  # Browther: Sawtunaa Voie B (pièce #6) — AAR ORT 1.26.0. Deux entrées
  # nécessaires : `_java` pour les classes ai.onnxruntime.* + `_J__unpack_aar`
  # (auto-générée par android_aar_prebuilt quand extract_native_libraries=true)
  # qui packe libonnxruntime.so + libonnxruntime4j_jni.so dans l'APK pour les
  # 4 ABIs. Pattern emprunté à `com_wireguard_android_java`. Le bisect du
  # 2026-05-20 a confirmé que le crash startup 100% est PRE-EXISTING dans le
  # snapshot v10 (commit d5c0e1674cd), pas lié à ces deps.
  "//brave/third_party/browther_android_deps:onnxruntime_android_J__unpack_aar",
  "//brave/third_party/browther_android_deps:onnxruntime_android_java",
  "//brave/third_party/browther_android_deps:sentry_android_core_java",
  "//brave/third_party/browther_android_deps:sentry_java",

  # Browther: bundle Shields filter lists dans assets/adblock_lists/ de
  # l'APK. Le target android_assets est défini dans
  # shields_bundled_lists/BUILD.gn (auto-généré par fetch-shields-lists.sh,
  # gitignored) et est gated `is_android`. On le tire ici depuis
  # brave_chrome_java_deps (qui finit dans `android_library("chrome_java")`,
  # voir patches/chrome-android-BUILD.gn.patch) — sinon il ne se propage
  # pas depuis le static_library C++ qui le référence côté C++. Sans ça,
  # l'APK ne contient pas assets/adblock_lists/ et shields_bundled_apk_
  # extractor.cc échoue → 0 ads bloqués.
  "//brave/components/brave_shields/core/browser/shields_bundled_lists:shields_bundled_lists_android_assets",

  # Browther: bundle 10 paysages islamiques dans assets/browther_backgrounds_
  # mobile/ de l'APK pour la NTP. Même mécanisme que Shields ci-dessus :
  # extrait au boot vers DIR_USER_DATA par browther_backgrounds_apk_
  # extractor.cc, puis NTPBackgroundImagesService lit le dossier sur disque
  # via la branche Android dans RegisterBackgroundImagesComponent().
  "//brave/components/ntp_background_images/browther_backgrounds_mobile:browther_backgrounds_mobile_android_assets",

  # Browther: Sawtunaa Voie B (pièce #7) — bundle le modèle NSNet2 (~25 MB,
  # ONNX Protobuf) dans assets/sawtunaa/ de l'APK. Le fichier réel est
  # gitignored et copié à chaque build par private/scripts/fetch-sawtunaa-
  # model.sh depuis private/extensions/sawtunaa/public/models/. Lu au
  # runtime par NSNet2Processor (pièce #4) via AssetManager.openFd.
  "//brave/components/sawtunaa/android_assets:sawtunaa_model_android_assets",

  # Browther: Basarunaa Android — Jalon 1 (bench ML runtime). Bundle les 4
  # modèles ONNX critiques (~30 MB) dans assets/basarunaa/ de l'APK :
  # yolo11n-pose, yolov8n-face, genderage, nanodet-plus-m_320. Modèles
  # gitignored, copiés par private/scripts/fetch-basarunaa-models.sh.
  # Lus par BasarunaaBenchmark via AssetManager.open().
  "//brave/components/basarunaa/android_assets:basarunaa_models_android_assets",

  "//brave/third_party/zxing:zxing_java",
  "//brave/ui/android:base_java",
