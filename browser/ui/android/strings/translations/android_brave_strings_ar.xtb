<translation id="3482868954775580230">فشل في قراءة الملف المحدد. <ph name="EXCEPTION_INFO"/></translation>
<translation id="9162995380643712715">{IMPORT_COUNT, plural,
        one {تم استيراد كلمة المرور <ph name="IMPORT_COUNT_MANY"/> بنجاح.}
