import("//brave/third_party/onnxruntime/onnxruntime.gni")

static_library("basarunaa") {
  sources = [
    "basarunaa_image_analyzer.cc",
    "basarunaa_image_analyzer.h",
    "basarunaa_service_factory.cc",
    "basarunaa_service_factory.h",
  ]

  deps = [
    "//base",
    "//brave/components/basarunaa/common/mojom",
    "//brave/components/basarunaa/core",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//content/public/browser",
    "//mojo/public/cpp/base",
    "//mojo/public/cpp/bindings",
  ]

  # ⚠️ ODR : ce macro conditionne le LAYOUT de BasarunaaService (membres ORT
  # sous `#if defined(BASARUNAA_NATIVE_ML)`). `basarunaa_service_factory.cc`
  # fait `make_unique<BasarunaaService>()` → DOIT voir la même taille que le
  # target `core` qui définit le constructeur/destructeur, sinon débordement
  # de tas (crash `_xzm_xzone_malloc_freelist_outlined`, 2026-07-02). Aucun
  # symbole ORT n'est référencé ici (types juste forward-declared) → pas besoin
  # de la dep onnxruntime, juste du define pour le sizeof.
  if (enable_basarunaa_native_ml) {
    defines = [ "BASARUNAA_NATIVE_ML=1" ]
  }
}
