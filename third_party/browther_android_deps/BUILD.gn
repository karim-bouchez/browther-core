# Targets Android AAR pour Browther, hors mécanisme //third_party/android_deps
# (fork-friendly — voir README.md). Les AAR/JAR sont téléchargés par
# `private/scripts/fetch-android-deps.sh` dans `libs/` (gitignored), avec
# les .info auto-générés via build/android/gyp/aar.py.

import("//build/config/android/rules.gni")

assert(is_android)

# ── Sentry-Android (crash reporting Java + ANR) ──────────────────────────────
# Version cohérente avec iOS Sentry-Cocoa 8.40 (cf. private/configs/analytics.env).

# Java core SDK (sentry-X.Y.Z.jar). Pas d'Android-specific code, juste les types
# d'event, transports, options, etc.
java_prebuilt("sentry_java") {
  jar_path = "libs/sentry/sentry-8.41.0.jar"
  output_name = "sentry"
  supports_android = true
  enable_bytecode_checks = false
}

# Tombstone protobuf decoder (transitif runtime). Optionnel — sert au
# sentry-android-ndk (pas inclus en Batch 2 ; ajouté ici par sécurité car
# le runtime de sentry-android-core peut le scruter via reflection).
java_prebuilt("epitaph_java") {
  jar_path = "libs/epitaph/epitaph-0.1.1.jar"
  output_name = "epitaph"
  supports_android = true
  enable_bytecode_checks = false
}

# Android runtime SDK (ContentProvider auto-init, ANR detector, app lifecycle
# breadcrumbs, etc.). Dépend de sentry_java + lifecycle Chromium-provided.
android_aar_prebuilt("sentry_android_core_java") {
  aar_path = "libs/sentry-android-core/sentry-android-core-8.41.0.aar"
  info_path = "libs/sentry-android-core/sentry-android-core.info"
  enable_bytecode_checks = false
  # Note : les transitives androidx (core, lifecycle_common_java8,
  # lifecycle_process) sont déjà dans `chrome_java` via Chromium, mais leur
  # visibility GN ne permet pas qu'on les ajoute en deps directes ici. Ce
  # n'est pas bloquant : chrome_java les expose à BrowtherSentry à la
  # compilation Java, et à l'exécution elles sont dans libchrome.so.
  deps = [
    ":epitaph_java",
    ":sentry_java",
  ]
}

# Note : sentry-android-core référence en bytecode des intégrations
# optionnelles (Fragment, Replay, Distribution, Timber, Navigation, Compose)
# qu'on ne veut pas embarquer. R8 honore les -dontwarn de Sentry pour ces
# classes, MAIS le step trace-references qui suit (Chromium-spécifique)
# ignore les proguard configs et crashe sur ces refs manquantes. Solution :
# patch upstream `build/android/gyp/tracereferences.py` pour ajouter
# io.sentry.android.* à `_SUPPRESSION_PATTERN`. Voir
# brave/patches/build-android-gyp-tracereferences.py.patch.

# ── ONNX Runtime Android (Sawtunaa Voie B pièce #6) ──────────────────────────
# AAR full build, version 1.26.0 alignée sur onnxruntime-web (extension
# Sawtunaa desktop). Le AAR embarque :
#  - libonnxruntime.so pour arm64-v8a, armeabi-v7a, x86_64, x86 (~45 MB).
#  - Java JNI bindings (`ai.onnxruntime.*`) — consommés directement par
#    `BrowtherSawtunaaBridge.java` (cf. spec pièce #3) ou wrappés par notre
#    propre processeur C++ via dlopen.
#  - Headers (extraits du AAR si besoin pour le code C++ NDK pièce #4).
android_aar_prebuilt("onnxruntime_android_java") {
  aar_path = "libs/onnxruntime-android/onnxruntime-android-1.26.0.aar"
  info_path = "libs/onnxruntime-android/onnxruntime-android.info"
  enable_bytecode_checks = false
  # L'AAR embarque libonnxruntime.so + libonnxruntime4j_jni.so pour 4 ABIs
  # (arm64-v8a, armeabi-v7a, x86, x86_64). Forcer l'extraction → packagées
  # dans l'APK final, dispo via System.loadLibrary depuis le code Java
  # ai.onnxruntime.OrtEnvironment.
  extract_native_libraries = true
  # Pas de dep transitive Java externe — l'AAR est self-contained.
}

# ── TensorFlow Lite Android (Basarunaa V3 — GPU delegate) ────────────────────
# AAR 2.16.1 runtime + GPU delegate. Cf. private/docs/TODO.md
# § "V3 Basarunaa Android : runtime GPU via TFLite + GPU delegate".
#
# 4 AAR :
#  - tensorflow-lite-api : interfaces abstraites InterpreterApi / Tensor /
#    Delegate. Dépendance transitive Maven de tensorflow-lite et -gpu mais
#    android_aar_prebuilt n'embarque PAS les transitives → faut un target
#    séparé sinon "class file for InterpreterApi not found" au compile.
#  - tensorflow-lite : runtime core, libtensorflowlite_jni.so + Interpreter
#    (extends InterpreterApi)
#  - tensorflow-lite-gpu : GPU delegate, libtensorflowlite_gpu_jni.so (4 ABIs)
#  - tensorflow-lite-gpu-api : interfaces partagées GPU (CompatibilityList +
#    GpuDelegateFactory.Options, Java pur)
#
# Pattern emprunté à onnxruntime_android_java + com_wireguard_android_java :
# extract_native_libraries = true → .so packagées dans l'APK pour les 4 ABIs
# (arm64-v8a, armeabi-v7a, x86_64, x86), accessibles via System.loadLibrary
# depuis le code Java org.tensorflow.lite.*.

# Interfaces TFLite (InterpreterApi/Tensor/Delegate). Java pur, pas de .so.
# Pas de chaîne de `deps` sur les android_aar_prebuilt — toutes les targets
# sont déclarées flat dans brave_chrome_java_deps (config.gni). Mettre des
# deps inter-AAR bloque la propagation des native libs (.so) jusqu'au
# chrome_public_apk (incident 2026-06-09 : .so absents de l'APK).
android_aar_prebuilt("tflite_api_android_java") {
  aar_path = "libs/tensorflow-lite-api/tensorflow-lite-api-2.16.1.aar"
  info_path = "libs/tensorflow-lite-api/tensorflow-lite-api.info"
  enable_bytecode_checks = false
}

# Runtime core (Interpreter + JNI .so).
android_aar_prebuilt("tflite_android_java") {
  aar_path = "libs/tensorflow-lite/tensorflow-lite-2.16.1.aar"
  info_path = "libs/tensorflow-lite/tensorflow-lite.info"
  enable_bytecode_checks = false
  extract_native_libraries = true
}

# Interfaces partagées GPU (CompatibilityList + GpuDelegateFactory.Options,
# Java pur, pas de .so). Sert à vérifier que le delegate GPU est supporté
# AVANT d'instancier le GpuDelegate (évite un crash sur device avec drivers
# GPU castrés) et fournit le builder GpuDelegateFactory.Options.
android_aar_prebuilt("tflite_gpu_api_android_java") {
  aar_path = "libs/tensorflow-lite-gpu-api/tensorflow-lite-gpu-api-2.16.1.aar"
  info_path = "libs/tensorflow-lite-gpu-api/tensorflow-lite-gpu-api.info"
  enable_bytecode_checks = false
}

# GPU delegate (OpenGL ES / Vulkan compute selon device).
android_aar_prebuilt("tflite_gpu_android_java") {
  aar_path = "libs/tensorflow-lite-gpu/tensorflow-lite-gpu-2.16.1.aar"
  info_path = "libs/tensorflow-lite-gpu/tensorflow-lite-gpu.info"
  enable_bytecode_checks = false
  extract_native_libraries = true
}

# Group d'agrégation : facilite l'import depuis le code Browther.
group("browther_android_deps") {
  public_deps = [
    ":onnxruntime_android_java",
    ":sentry_android_core_java",
    ":tflite_android_java",
    ":tflite_api_android_java",
    ":tflite_gpu_android_java",
    ":tflite_gpu_api_android_java",
  ]
}
