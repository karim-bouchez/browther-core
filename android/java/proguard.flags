# Keep Play Core Review classes to prevent ClassNotFoundException during Parcelable deserialization
-keep class com.google.android.play.core.review.** { *; }
-keep class com.google.android.play.core.common.** { *; }

# Keep Play Core App Update classes to prevent ClassNotFoundException during Parcelable deserialization
-keep class com.google.android.play.core.appupdate.** { *; }
-keep class com.google.android.play.core.install.** { *; }

# Browther: Sawtunaa Voie B — ONNX Runtime Android AAR (no proguard.txt
# embedded, has_proguard_flags=false in onnxruntime-android.info). Les classes
# ai.onnxruntime.* sont reachées via JNI reflection (FindClass + GetMethodID)
# depuis libonnxruntime4j_jni.so dans OrtSession.run(). Sans ces keeps R8 les
# obfusque ou les strippe → SIGSEGV/JNIAbort dans convertToTensorInfo+628 au
# 1er call de run() (validé 2026-05-21 sur device). Le crash startup que je
# soupçonnais hier soir n'était PAS lié au keep — c'était un état flaky du
# device (écran verrouillé + monkey).
-keep class ai.onnxruntime.** { *; }
-keepclassmembers class ai.onnxruntime.** { *; }
-keepnames class ai.onnxruntime.**

# Browther: Basarunaa V3 — TensorFlow Lite Android AAR. Pattern identique à
# ORT : libtensorflowlite_jni.so + libtensorflowlite_gpu_jni.so utilisent
# FindClass/GetMethodID via JNI reflection sur les classes org.tensorflow.lite.*
# (Tensor, Interpreter, GpuDelegate, CompatibilityList). Sans keeps R8 strip
# → JNI lookup KO au premier Interpreter.run() ou GpuDelegate ctor.
-keep class org.tensorflow.lite.** { *; }
-keepclassmembers class org.tensorflow.lite.** { *; }
-keepnames class org.tensorflow.lite.**
