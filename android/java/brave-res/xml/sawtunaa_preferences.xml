<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:key="sawtunaa_enabled"
        android:title="@string/sawtunaa_title"
        android:summary="@string/sawtunaa_summary" />

    <androidx.preference.Preference
        android:key="sawtunaa_run_benchmark"
        android:title="@string/sawtunaa_run_benchmark_title"
        android:summary="@string/sawtunaa_run_benchmark_summary" />

    <androidx.preference.Preference
        android:key="sawtunaa_benchmark_result"
        android:title="@string/sawtunaa_benchmark_result_title"
        android:summary="@string/sawtunaa_benchmark_result_idle"
        android:selectable="false" />

    <androidx.preference.Preference
        android:key="sawtunaa_run_full_pipeline_bench"
        android:title="@string/sawtunaa_run_full_pipeline_bench_title"
        android:summary="@string/sawtunaa_run_full_pipeline_bench_summary" />

    <androidx.preference.Preference
        android:key="sawtunaa_full_pipeline_bench_result"
        android:title="@string/sawtunaa_full_pipeline_bench_result_title"
        android:summary="@string/sawtunaa_benchmark_result_idle"
        android:selectable="false" />

</PreferenceScreen>
