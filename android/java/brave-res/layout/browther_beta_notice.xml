<!-- Bandeau « accès anticipé » en tête du NTP. Parité desktop
     (browther_beta_notice.tsx) et iOS (BrowtherBetaNoticeSectionProvider).
     Dit dans l'app que ce n'est pas la version finale : le site ne peut pas
     jouer ce rôle, la plupart des installs viennent du store et ne le voient
     jamais. Les deux liens sont des canaux de DIFFUSION auxquels on s'abonne,
     pas un support — d'où « Chaîne WhatsApp » / « Canal Telegram » en libellé.
     ic_channel_science est le bécher, le même pictogramme que l'icône Leo
     `beaker` du desktop : « en expérimentation », pas « erreur ». -->
<org.chromium.chrome.browser.ntp.BrowtherBetaNoticeView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browther_beta_notice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/browther_beta_notice_bg"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <!-- L'icône s'aligne sur la première ligne du titre, pas sur le centre du
         bandeau : sa hauteur varie avec le texte (traductions longues, grande
         taille de police système). -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/browther_beta_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_channel_science"
        app:tint="#FBBF24" />

    <LinearLayout
        android:id="@+id/browther_beta_text"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/browther_beta_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/browther_beta_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#BFFFFFFF"
            android:textSize="13sp" />

        <!-- Le libellé d'intro occupe sa propre ligne : les traductions varient
             trop en longueur (l'arabe et l'allemand débordent) pour tenir sur la
             même ligne que les deux liens sans risquer de les tronquer.
             FlexboxLayout aurait permis le repli automatique, mais la dépendance
             n'est utilisée nulle part ailleurs dans ce build. -->
        <TextView
            android:id="@+id/browther_beta_follow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#BFFFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/browther_beta_channels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/browther_beta_whatsapp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/browther_beta_telegram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/browther_beta_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_baseline_close_24"
        app:tint="#99FFFFFF" />

</org.chromium.chrome.browser.ntp.BrowtherBetaNoticeView>
