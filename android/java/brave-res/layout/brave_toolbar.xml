<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:app="http://schemas.android.com/apk/res-auto"
      xmlns:tools="http://schemas.android.com/tools"
      android:orientation="horizontal"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content" >

    <FrameLayout android:id="@+id/brave_youtube_pip_layout"
        android:layout_width="45dp"
        android:orientation="vertical"
        android:background="@drawable/modern_toolbar_background_grey_middle_segment"
        android:layout_marginTop="8dp"
        android:layout_height="40dp"
        android:visibility="gone" >

        <ImageButton android:id="@+id/brave_youtube_pip_button"
            style="@style/ToolbarButton"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_picture_in_picture"
            android:layout_gravity="center"
            android:contentDescription="@string/accessibility_toolbar_btn_brave_pip" />
    </FrameLayout>

  <FrameLayout android:id="@+id/brave_wallet_button_layout"
      android:layout_width="45dp"
      android:orientation="vertical"
      android:background="@drawable/modern_toolbar_background_grey_middle_segment"
      android:layout_marginTop="8dp"
      android:layout_height="40dp"
      android:visibility="gone" >

      <ImageButton android:id="@+id/brave_wallet_button"
          style="@style/ToolbarButton"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:src="@drawable/ic_product_brave_wallet"
          android:layout_gravity="center"
          android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

      <View
          android:id="@+id/wallet_notfication_badge"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:layout_marginTop="7dp"
          android:layout_marginEnd="6dp"
          android:layout_gravity="end"
          android:visibility="gone"
          android:background="@drawable/brave_rewards_circle"/>
  </FrameLayout>

  <!-- Browther: Sawtunaa (music/noise suppression) toolbar button. iOS-parity
       style (2026-06-01) : pas de background carré (le `baseline_neutral_90`
       du modern_toolbar_background_grey_middle_segment est gris très clair
       fixe → ressort en dark theme, c'est pour ça que Shields btn_brave a
       son propre fond opaque intégré au PNG). Badge dot en bas-droite,
       width réduite à 38dp pour un spacing plus serré, comme iOS. -->
  <FrameLayout android:id="@+id/brave_sawtunaa_button_layout"
      android:layout_width="38dp"
      android:orientation="vertical"
      android:layout_marginTop="8dp"
      android:layout_height="40dp" >

      <ImageButton android:id="@+id/brave_sawtunaa_button"
          style="@style/ToolbarButton"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:src="@drawable/sawtunaa_icon_toolbar"
          android:layout_gravity="center"
          android:contentDescription="@string/accessibility_toolbar_btn_sawtunaa" />

      <View
          android:id="@+id/brave_sawtunaa_badge"
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:layout_marginBottom="6dp"
          android:layout_marginEnd="4dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/sawtunaa_badge_red" />
  </FrameLayout>

  <!-- Browther: Basarunaa (gender-aware person blurring) toolbar button.
       Same iOS-parity style as Sawtunaa above. Note: the Android ML
       pipeline is not implemented yet; the toggle flips the
       kBasarunaaEnabled pref but no native filtering runs until the
       C++/native renderer pipeline lands (Phase 3.1 follow-up). -->
  <FrameLayout android:id="@+id/brave_basarunaa_button_layout"
      android:layout_width="38dp"
      android:orientation="vertical"
      android:layout_marginTop="8dp"
      android:layout_height="40dp" >

      <ImageButton android:id="@+id/brave_basarunaa_button"
          style="@style/ToolbarButton"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:src="@drawable/basarunaa_icon_toolbar"
          android:layout_gravity="center"
          android:contentDescription="@string/accessibility_toolbar_btn_basarunaa" />

      <View
          android:id="@+id/brave_basarunaa_badge"
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:layout_marginBottom="6dp"
          android:layout_marginEnd="4dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/sawtunaa_badge_red" />
  </FrameLayout>

  <!-- Browther: Brave Shields toolbar button. Aligned on Sawtunaa/Basarunaa
       style (no background, dedicated monochrome icon from iOS browther.shield.bar,
       bottom-right status badge) 2026-06-01. The legacy btn_brave.png (with
       green pill background) is kept for other usages (favicon list, etc.). -->
  <FrameLayout android:id="@+id/brave_shields_button_layout"
      android:layout_width="38dp"
      android:orientation="vertical"
      android:layout_marginTop="8dp"
      android:layout_height="40dp" >

      <ImageButton android:id="@+id/brave_shields_button"
          style="@style/ToolbarButton"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:src="@drawable/shield_icon_toolbar"
          android:layout_gravity="center"
          android:contentDescription="@string/accessibility_toolbar_btn_brave_shields" />

      <View
          android:id="@+id/brave_shields_badge"
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:layout_marginBottom="6dp"
          android:layout_marginEnd="4dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/sawtunaa_badge_green" />
  </FrameLayout>

  <FrameLayout android:id="@+id/brave_rewards_button_layout"
      android:layout_width="45dp"
      android:orientation="vertical"
      android:layout_marginTop="8dp"
      android:background="@drawable/modern_toolbar_background_grey_end_segment"
      android:layout_height="40dp"
      android:visibility="gone" >

      <ImageButton android:id="@+id/brave_rewards_button"
          style="@style/ToolbarButton"
          android:layout_marginTop="8dp"
          android:layout_marginBottom="8dp"
          android:src="@drawable/btn_bat"
          android:layout_gravity="center"
          android:contentDescription="@string/accessibility_toolbar_btn_brave_rewards" />

      <ImageView 
          android:id="@+id/br_rewards_onboarding_icon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="7dp"
          android:layout_marginEnd="6dp"
          android:layout_gravity="end"
          android:gravity="center"
          android:visibility="gone"
          android:contentDescription="@null"
          app:srcCompat="@drawable/ic_help_filled"/>

      <TextView
          android:id="@+id/br_notifications_count"
          android:layout_width="14dp"
          android:layout_height="14dp"
          android:text=""
          android:layout_marginTop="7dp"
          android:layout_marginEnd="6dp"
          android:layout_gravity="end"
          android:gravity="center"
          android:visibility="gone"
          android:textColor="#ffffff"
          android:background="@drawable/brave_rewards_circle"
          android:textSize="9sp"
          tools:ignore="SmallSp" />

      <View
          android:id="@+id/rewards_notfication_badge"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:layout_marginTop="7dp"
          android:layout_marginEnd="6dp"
          android:layout_gravity="end"
          android:visibility="gone"
          android:background="@drawable/brave_rewards_circle"/>
  </FrameLayout>
</LinearLayout>
