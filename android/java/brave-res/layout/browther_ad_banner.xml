<!-- Bannière pub devndin-ads (NTP, sous les favoris). Carousel paginé ratio
     3.2:1 + indicateur de pages. La hauteur du pager est fixée en code
     (largeur / 3.2) — parité desktop browther_ad_banner.tsx + iOS carousel. -->
<org.chromium.chrome.browser.ntp.BrowtherAdBannerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browther_ad_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/browther_ad_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <LinearLayout
        android:id="@+id/browther_ad_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

</org.chromium.chrome.browser.ntp.BrowtherAdBannerView>
