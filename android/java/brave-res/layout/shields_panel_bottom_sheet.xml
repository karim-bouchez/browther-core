<!-- Shields panel V1: same layout as Sawtunaa/Basarunaa (visual coherence,
     user request 2026-06-01). Header lockup + big toggle (per-site Shields)
     + status + description. Advanced Shields settings remain in
     Settings → Brave Shields. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="22dp">

    <!-- Single TextView with compound drawable (start) — lint UseCompoundDrawables. -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:drawableStart="@drawable/btn_brave"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="@string/shields_panel_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.02" />

    <org.chromium.chrome.browser.browther_widgets.BrowtherBigToggleView
        android:id="@+id/shields_panel_toggle"
        android:layout_width="96dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/shields_panel_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:gravity="start"
        android:text="@string/shields_panel_description" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="8dp"
        android:gravity="start"
        android:text="@string/shields_panel_advanced_settings_hint" />

</LinearLayout>
