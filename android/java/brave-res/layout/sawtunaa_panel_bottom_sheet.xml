<!-- Sawtunaa panel shown from the URL bar Sawtunaa button. Layout mirrors
     iOS SawtunaaPanelView and macOS sawtunaa_bubble_view.cc.
     Spec: private/docs/UI_UX_FEATURES.md § Sawtunaa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="22dp">

    <!-- Header: real Sawtunaa icon-with-bg PNG + wordmark PNG (parity with
         iOS SawtunaaPanelView, deployed from private/logo/sawtunaa/). The
         wordmark PNG ships at the right ratio (2513x716 → ~3.5:1) and we
         let the ImageView decide its width from the intrinsic ratio. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/sawtunaa_icon_with_bg"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/sawtunaa_panel_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:adjustViewBounds="true"
            android:src="@drawable/sawtunaa_wordmark"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Big animated toggle, 96x52 dp. -->
    <org.chromium.chrome.browser.browther_widgets.BrowtherBigToggleView
        android:id="@+id/sawtunaa_panel_toggle"
        android:layout_width="96dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp" />

    <!-- Status text: "Suppression de la musique ACTIVÉE/DÉSACTIVÉE". -->
    <TextView
        android:id="@+id/sawtunaa_panel_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <!-- Description: "Pour l'instant, ça fonctionne uniquement sur YouTube.
         (en savoir plus)" — last part is a clickable underlined span. -->
    <TextView
        android:id="@+id/sawtunaa_panel_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:gravity="start" />

</LinearLayout>
