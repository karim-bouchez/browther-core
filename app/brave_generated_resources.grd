    <!-- Pseudolocales -->
    <output filename="brave_generated_resources_ar-XB.pak" type="data_package" lang="ar-XB" />
    <output filename="brave_generated_resources_en-XA.pak" type="data_package" lang="en-XA" />
  </outputs>
  <translations>
    <file path="resources/brave_generated_resources_am.xtb" lang="am" />
