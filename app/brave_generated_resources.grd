        <message name="IDS_PLAYLIST_CONTEXT_MENU_REMOVE_OFFLINE_DATA" desc="Context menu item on Playlist item to clear cache for the item">
          Remove offline data
        </message>
        <message name="IDS_PLAYLIST_CONTEXT_MENU_REMOVE_FROM_PLAYLIST" desc="Context menu item on Playlist item to remove it from the folder">
          Remove from playlist
        </message>
        <message name="IDS_PLAYLIST_CONTEXT_MENU_VIEW_ORIGINAL_PAGE" desc="Context menu item on Playlist item to open the source page in a new tab">
          View original page
        </message>
        <message name="IDS_PLAYLIST_EMPTY_FOLDER_MESSAGE" desc="A message that shows up when a playlist folder is empty">
          The fun starts when you have something to play. Add your favorite media and playback anytime, anywhere. Even offline.
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_CREATE_PLAYLIST_FOLDER" desc="An a11y name for a button to create new playlist folder">
          Create a new folder
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_OPEN_PLAYLIST_SETTINGS" desc="An a11y name for a button to open playlist settings">
          Open Playlist settings
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_PLAY" desc="An a11y name for a 'play' button in media player">
          Play
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_PAUSE" desc="An a11y name for a 'pause' button in media player">
          Pause
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_NEXT" desc="An a11y name for a 'next' button in media player">
          Next track
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_PREVIOUS" desc="An a11y name for a 'prev' button in media player">
          Previous track
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_TOGGLE_MUTED" desc="An a11y name for a 'mute' button in media player">
          Toggle mute
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_SHUFFLE" desc="An a11y name for a 'shuffle' button in media player">
          Shuffle
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_REWIND" desc="An a11y name for a 'rewind' button in media player">
          Rewind
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_FORWARD" desc="An a11y name for a 'forward' button in media player">
          Forward
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_CLOSE" desc="An a11y name for a 'close' button in media player when it's mini player mode">
          Close
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_LOOP_OFF" desc="An a11y name for a 'loop' button in media player when the loop is off">
          Repeat off
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_LOOP_ONE" desc="An a11y name for a 'loop' button in media player when repeating one item">
          Repeat one
        </message>
        <message name="IDS_PLAYLIST_TOOLTIP_LOOP_ALL" desc="An a11y name for a 'loop' button in media player when repeating all items">
          Repeat all
        </message>
        <message name="IDS_PLAYLIST_FAILED_TO_PLAY_TITLE" desc="A title for alert that shows up when an item is not playable">
          Failed to play item
        </message>
        <message name="IDS_PLAYLIST_FAILED_TO_PLAY_DESCRIPTION" desc="Description for alert that shows up when an item is not playable">
          [<ph name="ITEM_NAME">$1<ex>Awesome video</ex></ph>] may be expired. Would you like to recover it?
        </message>
        <message name="IDS_PLAYLIST_FAILED_TO_PLAY_RECOVER" desc="A label for 'Recover' button">
          Recover
        </message>
        <message name="IDS_PLAYLIST_ALERT_DISMISS" desc="A label for 'Dismiss' button on alert">
          Dismiss
        </message>
        <message name="IDS_PLAYLIST_ADD_MEDIA_FROM_PAGE" desc="A label for 'Add media from page' button">
          Add media from page
        </message>
      </if> <!-- enable_playlist_webui -->

      <!-- File select -->
      <message name="IDS_BRAVE_FILE_SELECT_OPEN_TITLE" desc="">
        <ph name="SITE">$1<ex>http://foo.com</ex></ph> wants to open
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_OPEN_TITLE_IFRAME" desc="">
        An embedded page at <ph name="SITE">$1<ex>http://foo.com</ex></ph> wants to open
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_OPEN_TITLE_NONSTANDARD_URL" desc="">
        This page wants to open
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_OPEN_TITLE_NONSTANDARD_URL_IFRAME" desc="">
        An embedded page on this page wants to open
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_SAVE_TITLE" desc="">
        <ph name="SITE">$1<ex>http://foo.com</ex></ph> wants to save
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_SAVE_TITLE_IFRAME" desc="">
        An embedded page at <ph name="SITE">$1<ex>http://foo.com</ex></ph> wants to save
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_SAVE_TITLE_NONSTANDARD_URL" desc="">
        This page wants to save
      </message>
      <message name="IDS_BRAVE_FILE_SELECT_SAVE_TITLE_NONSTANDARD_URL_IFRAME" desc="">
        An embedded page on this page wants to save
      </message>

      <!-- Tab Search -->
      <message name="IDS_BRAVE_TAB_SEARCH_TAB_NAME" desc="Tab name for the search tab in the tab search panel">
        Search
      </message>
      <message name="IDS_BRAVE_TAB_ORGANIZATION_TAB_NAME" desc="Tab name for the Leo AI tab organization tab in the tab search panel">
        Organize
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_TITLE" desc="Title for the tab organizer page">
        Tab focus
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_SUBTITLE" desc="Subtitle for the tab organizer page">
        Gather all related tabs into a new window
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_SUGGESTED_TOPICS_SUBTITLE" desc="Subtitle for the suggested topics section">
        Suggested topics
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_TOPIC_INPUT_PLACEHOLDER" desc="Placeholder text for the input field to enter a topic">
        Enter a topic to focus on...
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_SUBMIT_BUTTON_LABEL" desc="Label for the submit topic input button">
        Go
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_UNDO_BUTTON_LABEL" desc="Label for the undo button">
        Undo
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_WINDOW_CREATED_MESSAGE" desc="Message shown when a new window is created">
        New window created for <ph name="TOPIC">$1<ex>Social media</ex></ph>
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_SEND_TAB_DATA_MESSAGE" desc="Description of how tab data is shared with Leo">
        This feature sends data about your open tabs to Leo, Browther's AI-powered browser assistant.
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_LEARN_MORE_LABEL" desc="Text of the learn more link">
        Learn more
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_GO_PREMIUM_BUTTON_LABEL" desc="Text of go premium button">
        Go Premium
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_DISMISS_BUTTON_LABEL" desc="Text of the dismiss button">
        Dismiss
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_PRIVACY_DISCLAIMER" desc="Disclaimer text for enabling the tab focus feature">
        When opened, this will automatically send the titles and origin of all non-private tabs to Leo to classify them.
      </message>
      <message name="IDS_BRAVE_ORGANIZE_TAB_ENABLE_BUTTON_LABEL" desc="Text of enable tab focus button">
        Enable
      </message>

      <!--PSST -->
      <message name="IDS_BRAVE_PSST_INFOBAR_MESSAGE" desc="Infobar message body informing the user that Brave's Privacy Settings Suggestion Tool (PSST) can optimize their privacy settings on this site.">
        Browther can help you optimize this site's privacy settings. Would you like to review Browther's suggestions?
      </message>
      <message name="IDS_BRAVE_PSST_INFO_BAR_REVIEW_SUGGESTIONS" desc="Button label for the infobar action that starts the review of Privacy Settings Suggestion Tool (PSST) recommendations.">
        Review Suggestions
      </message>

      <!-- Brave policy -->
      <message name="IDS_BRAVE_CONTROLLED_SETTING_POLICY" desc="Text displayed in the controlled settings bubble when a setting's value is managed by policy.">
        This setting is managed by your administrator or by another Browther policy.
      </message>

      <!--Customize Chrome Panel -->
      <message name="IDS_BRAVE_CUSTOMIZE_MENU_TOOLBAR_LABEL" desc="The label for the option to customize toolbar icons in the customization menu on the New Tab Page. This is a button which opens a panel for customizing toolbar icons when clicked.">
        Customize toolbar
      </message>
      <message name="IDS_BRAVE_NTP_CUSTOMIZE_APPEARANCE_LABEL" desc="The label for header of the customize appearance section in customize chrome side panel">
        Theme and colors
      </message>

      <!--Password Manager -->
      <message name="IDS_BRAVE_PASSWORD_MANAGER_UI_EMPTY_STATE_SIGNEDOUT_USERS" desc="A label shown if there are no saved passwords prompting user to import them.">
        Saved passwords will appear here. To import passwords to <ph name="BRAND">$1<ex>Browther Password Manager</ex></ph> on this device, <ph name="BEGIN_LINK">&lt;a href="#" &gt;</ph> select a CSV file<ph name="END_LINK">&lt;/a&gt;</ph>
      </message>
      <message name="IDS_BRAVE_PASSWORD_MANAGER_UI_IMPORT_DESCRIPTION_SIGNEDOUT_USERS" desc="The description for the password import banner in Password Manager settings.">
        To import passwords to <ph name="BRAND">$1<ex>Browther Password Manager</ex></ph> on this device, select a CSV file
      </message>
      <message name="IDS_LOCAL_AI_TASK_MANAGER_TITLE" desc="The label for the on-device AI background process in the Task Manager.">
        On-Device AI
      </message>
      <!-- Browther: Sawtunaa -->
      <message name="IDS_SETTINGS_SAWTUNAA_TITLE" desc="Title for the Sawtunaa section in settings">
        Sawtunaa
      </message>
      <message name="IDS_SETTINGS_SAWTUNAA_TOGGLE_LABEL" desc="Label for the Sawtunaa toggle in settings">
        Enable Sawtunaa
      </message>
      <message name="IDS_SETTINGS_SAWTUNAA_TOGGLE_DESC" desc="Description for the Sawtunaa toggle in settings">
        Automatically remove background music and noise from audio and video
      </message>
      <message name="IDS_BASARUNAA_PANEL_NAME" desc="Window title of the Basarunaa toolbar panel" formatter_data="webui=Basarunaa">
        Basarunaa
      </message>
      <!-- Browther: Sawtunaa popup (toolbar bubble + action tooltips) -->
      <message name="IDS_SAWTUNAA_POPUP_STATUS_ON" desc="Status text in Sawtunaa popup when enabled">
        Music removal ENABLED
      </message>
      <message name="IDS_SAWTUNAA_POPUP_STATUS_OFF" desc="Status text in Sawtunaa popup when disabled">
        Music removal DISABLED
      </message>
      <message name="IDS_SAWTUNAA_POPUP_DESCRIPTION" desc="Description text in Sawtunaa popup">
        Removes background music and noise from videos in real time on any site, keeping only the voice.
      </message>
      <message name="IDS_SAWTUNAA_POPUP_RELOAD_HINT" desc="Hint shown in the Sawtunaa popup right after the user turns Sawtunaa on while media is playing in the current tab">
        Reload the tab to activate
      </message>
      <message name="IDS_SAWTUNAA_POPUP_PROTECTED_HINT" desc="Hint inside the Sawtunaa popup when the current tab plays DRM-protected media: explains why the amber toolbar badge is showing, why music removal has no effect there, and what to do about it.">
        No effect on this page: the content is protected (DRM) and Browther is not allowed to modify it. To remove the music anyway, install the Sawtunaa app together with its browser extension.
      </message>
      <message name="IDS_SAWTUNAA_POPUP_PROTECTED_HINT_BLOCKED" desc="Hint inside the Sawtunaa popup when the DRM video cannot be played at all in Browther. Installing the app is not enough here: the page itself must be opened in another browser first.">
        This page cannot play here: protected content (DRM). Open it in another browser, and install the Sawtunaa app with its extension there to remove the music.
      </message>
      <message name="IDS_BASARUNAA_POPUP_PROTECTED_HINT" desc="Hint inside the Basarunaa panel when the current tab plays DRM-protected media: explains the amber toolbar badge. Unlike Sawtunaa there is no workaround, and the wording must not pretend otherwise.">
        No effect on this page: the content is protected (DRM) and Browther is not allowed to modify it. There is no way around it for blurring.
      </message>
      <message name="IDS_SAWTUNAA_TOGGLE_TOOLTIP_ON" desc="Tooltip on Sawtunaa toolbar action when enabled">
        Sawtunaa — ON
      </message>
      <message name="IDS_SAWTUNAA_TOGGLE_TOOLTIP_OFF" desc="Tooltip on Sawtunaa toolbar action when disabled">
        Sawtunaa — OFF
      </message>
      <!-- Browther: contenu protégé (DRM) — barre d'information. -->
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_BLOCKED_MESSAGE" desc="Infobar shown when a DRM-protected video cannot be played because the browser has no Widevine VMP certification. States the cause, not just the symptom.">
        Protected video (DRM): Browther is not certified to play it. It will work in another browser.
      </message>
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_BLOCKED_MESSAGE_SAWTUNAA" desc="Same as above, shown when the user has Sawtunaa (music removal) enabled. Adds that the standalone app alone is not enough: its browser extension is required too.">
        Protected video (DRM): Browther is not certified to play it. It will work in another browser — and to remove the music there, install the Sawtunaa app together with its browser extension.
      </message>
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_UNFILTERED_MESSAGE" desc="Infobar shown when DRM-protected playback works, to explain why Browther's filters do not apply to it.">
        Protected video (DRM): Browther is not allowed to modify it, so its filters do not apply here.
      </message>
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_UNFILTERED_MESSAGE_SAWTUNAA" desc="Same as above, shown when the user has Sawtunaa (music removal) enabled. Adds that the standalone app alone is not enough: its browser extension is required too.">
        Protected video (DRM): Browther is not allowed to modify it, so blurring and music removal do not apply here. To remove the music, install the Sawtunaa app together with its browser extension.
      </message>
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_OPEN_IN_DEFAULT_BROWSER" desc="Infobar button that opens the current page in the operating system's default browser">
        Open in default browser
      </message>
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_COPY_LINK" desc="Infobar button shown instead of 'open in default browser' when Browther is itself the default browser. Must say WHERE to paste the link, otherwise 'copy link' alone leaves the user stuck.">
        Copy link for another browser
      </message>
      <message name="IDS_BROWTHER_PROTECTED_CONTENT_GET_SAWTUNAA" desc="Infobar button opening the download page of the standalone Sawtunaa application">
        Install Sawtunaa
      </message>
      <!-- Browther: Basarunaa panel (toolbar WebUI bubble) -->
      <message name="IDS_BASARUNAA_POPUP_STATUS_ON" desc="Status text in Basarunaa panel when enabled">
        Person blurring ENABLED
      </message>
      <message name="IDS_BASARUNAA_POPUP_STATUS_OFF" desc="Status text in Basarunaa panel when disabled">
        Person blurring DISABLED
      </message>
      <message name="IDS_BASARUNAA_POPUP_DESCRIPTION" desc="Description text in Basarunaa panel">
        Automatically blurs people on web pages according to the chosen mode.
      </message>
      <message name="IDS_BASARUNAA_PANEL_MODE_LABEL" desc="Section label for the blur mode selector in the Basarunaa panel">
        Mode
      </message>
      <message name="IDS_BASARUNAA_PANEL_MODE_FEMALE" desc="Radio option to blur women in the Basarunaa panel">
        Blur women
      </message>
      <message name="IDS_BASARUNAA_PANEL_MODE_MALE" desc="Radio option to blur men in the Basarunaa panel">
        Blur men
      </message>
      <message name="IDS_BASARUNAA_PANEL_MODE_ALL" desc="Radio option to blur everyone in the Basarunaa panel">
        Blur everyone
      </message>
      <message name="IDS_BASARUNAA_PANEL_DETECTION_LABEL" desc="Section label for detection thresholds in the Basarunaa panel">
        Detection
      </message>
      <message name="IDS_BASARUNAA_PANEL_CONF_BODY" desc="Debug-section slider label for the advanced detection floor (below this score a detection is discarded entirely) in the Basarunaa panel">
        Detection floor (advanced)
      </message>
      <message name="IDS_BASARUNAA_PANEL_CONF_FACE" desc="Slider label for face-detection confidence threshold in the Basarunaa panel">
        Face confidence
      </message>
      <message name="IDS_BASARUNAA_PANEL_GENDER_CERTAINTY" desc="Main slider label: below this certainty a detected person is blurred as a precaution in the Basarunaa panel">
        Blur caution level
      </message>
      <message name="IDS_BASARUNAA_PANEL_SENTINEL_CONF" desc="Slider label for the NanoDet sentinel detection confidence threshold in the Basarunaa panel">
        Sentinel confidence
      </message>
      <message name="IDS_BASARUNAA_PANEL_MIN_SKELETON" desc="Slider label for the minimum body-skeleton threshold (anti false-positive) in the Basarunaa panel">
        Min skeleton
      </message>
      <message name="IDS_BASARUNAA_PANEL_NSFW_CONF" desc="Slider label for the NSFW (Marqo) full-image threshold in the Basarunaa panel">
        NSFW (Marqo)
      </message>
      <message name="IDS_BASARUNAA_PANEL_NUDENET_CONF" desc="Slider label for the NudeNet explicit-parts threshold in the Basarunaa panel">
        NudeNet
      </message>
      <!-- Browther: options et descriptions du panel Basarunaa. Étaient
           codées en dur (en français) dans basarunaa_panel.html jusqu'au
           2026-07-26 : elles restaient donc en français quelle que soit la
           langue du navigateur. -->
      <message name="IDS_BASARUNAA_PANEL_CENSOR_EYES" desc="Label of the eye-censoring toggle in the Basarunaa panel">
        Censor eyes
      </message>
      <message name="IDS_BASARUNAA_PANEL_CENSOR_EYES_DESC" desc="Description of the eye-censoring toggle in the Basarunaa panel">
        Erases the eyes of every visible person (men, women, children) by reconstructing the skin — regardless of the mode above. People already blurred by the mode are not affected.
      </message>
      <message name="IDS_BASARUNAA_PANEL_NSFW_TOGGLE" desc="Label of the NSFW detection toggle in the Basarunaa panel">
        NSFW detection
      </message>
      <message name="IDS_BASARUNAA_PANEL_NSFW_TOGGLE_DESC" desc="Description of the NSFW detection toggle in the Basarunaa panel">
        Blurs the whole image when explicit content is detected (nudity, intimate parts). Off by default for better responsiveness — turn it on if you want it.
      </message>
      <message name="IDS_BASARUNAA_PANEL_HAND_FILTER" desc="Label of the toggle that skips blurring when only a hand is visible">
        Ignore lone hands
      </message>
      <message name="IDS_BASARUNAA_PANEL_HAND_FILTER_DESC" desc="Description of the toggle that skips blurring when only a hand is visible">
        Does not blur when only a hand is visible (e.g. video tutorials). As soon as more shows — face, arm with elbow, leg, body — blurring applies as usual.
      </message>
      <message name="IDS_BASARUNAA_PANEL_SCALE_LESS_BLUR" desc="Left end of the blur caution slider scale in the Basarunaa panel">
        Less blur
      </message>
      <message name="IDS_BASARUNAA_PANEL_SCALE_SAFER" desc="Right end of the blur caution slider scale in the Basarunaa panel">
        More cautious
      </message>
      <message name="IDS_BASARUNAA_PANEL_GENDER_CERTAINTY_DESC" desc="Description of the blur caution slider in the Basarunaa panel">
        Every detected person gets a certainty score. Below this threshold they are blurred as a precaution — when in doubt, blur. Above it, their class decides (woman → blurred, man or child → not).
      </message>
      <message name="IDS_BASARUNAA_PANEL_NSFW_CONF_DESC" desc="Description of the NSFW threshold slider in the Basarunaa panel">
        Threshold of the global NSFW classifier. Above it, the whole image is blurred.
      </message>
      <message name="IDS_BASARUNAA_PANEL_NUDENET_CONF_DESC" desc="Description of the NudeNet threshold slider in the Basarunaa panel">
        Detection threshold for explicit body parts. Lower means more sensitive.
      </message>
      <message name="IDS_BASARUNAA_PANEL_LOADING" desc="Loading text shown while the Basarunaa panel fetches its initial state">
        Loading…
      </message>
      <message name="IDS_BASARUNAA_PANEL_TOGGLE_ARIA" desc="Accessibility label for the main on/off toggle in the Basarunaa panel">
        Toggle Basarunaa
      </message>
      <!-- Browther: Shields internal-page bubble (toolbar mini-popup) -->
      <message name="IDS_BROWTHER_SHIELDS_INTERNAL_TITLE" desc="Title of the Shields bubble shown on internal browser pages">
        Browther Shields
      </message>
      <message name="IDS_BROWTHER_SHIELDS_INTERNAL_DESCRIPTION" desc="Description shown in the Shields bubble explaining what Browther Shields block">
        Browther Shields block ads, trackers, fingerprinting and unwanted scripts on every site you visit.
      </message>
      <message name="IDS_BROWTHER_SHIELDS_INTERNAL_PER_SITE_INFO" desc="Inline info shown when the user tries to disable Shields from the internal-page bubble — Brave manages Shields per site only">
        Shields are managed per site. Open the website you want to exclude and click the shield button at the top right.
      </message>
      <message name="IDS_BROWTHER_SHIELDS_INTERNAL_STATUS_ON" desc="Status text in Shields bubble when default protection is enabled">
        Ad blocking ENABLED
      </message>
      <message name="IDS_BROWTHER_SHIELDS_INTERNAL_STATUS_OFF" desc="Status text in Shields bubble when default protection is disabled">
        Ad blocking DISABLED
      </message>
      <!--Add new items to the appropriate sections above -->
    </messages>
  </release>
</grit>
