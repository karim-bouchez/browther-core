<?xml version="1.0" encoding="UTF-8"?>
<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/brave_generated_resources.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="grit/brave_generated_resources_webui_strings.h" type="webui_header" />
    <output filename="grit/brave_generated_resources_webui_strings.ts" type="webui_ts" />
    <output filename="brave_generated_resources.pak" type="data_package" />
