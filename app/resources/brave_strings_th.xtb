<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="7099479769133613710">เปิดอีกครั้งเพื่ออัปเดต &amp;Chrome OS</translation>
<translation id="7264054672589027446">Browther ขอแนะนำให้คุณตรวจสอบส่วนขยายนี้</translation>
<translation id="7848219163187166649">เมื่อเว็บไซต์ขอโหลดลิงก์ในหน้าเว็บของตนล่วงหน้าแบบส่วนตัว Browther จะใช้เซิร์ฟเวอร์ของ Browther การดำเนินการนี้จะซ่อนตัวตนของคุณจากเว็บไซต์ที่โหลดล่วงหน้า แต่ Browther จะทราบถึงเว็บไซต์ที่ได้รับการโหลดล่วงหน้า</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="8837164267124113709">ผู้ปกครองได้ปิด "สิทธิ์สำหรับเว็บไซต์ แอป และส่วนขยาย" ใน Browther</translation>
<translation id="881513728707488138">Browther ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="112640046208448578">ระบุสิ่งหรือสถานที่ต่างๆ แล้วคัดลอกหรือแปลข้อความ เมื่อใช้การค้นหารูปภาพ ระบบจะส่งภาพหน้าจอของหน้าเว็บไปยังเซิร์ฟเวอร์ <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="6580138787163923852"><ph name="BEGIN_LINK"/>ลงชื่อเข้าใช้ Browther<ph name="END_LINK"/> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="1089111274164380772">คลิกเมนู Browther</translation>
<translation id="1157985233335035034">ภาษาล่าสุด</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> ได้เพิ่มส่วนขยายที่อาจเปลี่ยนวิธีการทำงานของ Browther

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">ติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับ Windows เวอร์ชันที่คุณใช้</translation>
<translation id="8291401179516272335">เกี่ยวกับ Browther</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME"/></translation>
<translation id="1232234696885483911">เมื่อคุณเปิดการค้นหารูปภาพ ระบบจะส่งชื่อหน้า, URL และเนื้อหา รวมถึง PDF ไปยังเซิร์ฟเวอร์โดยอัตโนมัติ <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี Browther ใน Browther ได้ หากต้องการเปลี่ยน ให้ไปที่ "บัญชีของคุณใน Browther"</translation>
<translation id="9034321258761608912">ขณะที่แท็บนี้ไม่มีการใช้งาน ระบบจะเพิ่มพื้นที่ว่างในหน่วยความจำเพื่อให้ใช้ Browther ได้อย่างรวดเร็วอยู่เสมอ ทั้งนี้คุณจะเลือกยกเว้นให้เว็บไซต์นี้ทำงานตลอดเวลาได้</translation>
<translation id="249571811018731941">Browther บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์เป็นอันตราย</translation>
<translation id="8850227089720975601">เมื่อลงชื่อเข้าใช้บริการของ Browther อย่าง Gmail หรือ YouTube ด้วย <ph name="USER_EMAIL"/> คุณจะลงชื่อเข้าใช้ Browther ด้วยบัญชีเดียวกันได้โดยอัตโนมัติ</translation>
<translation id="1290883685122687410">ข้อผิดพลาดในการตั้งค่า: <ph name="METAINSTALLER_EXIT_CODE"/> <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">ตั้งค่าโปรไฟล์ Browther ใหม่</translation>
<translation id="4437862975743821367">Browther ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อสำรวจอุปกรณ์บลูทูธ <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">ตรวจหาภาษา</translation>
<translation id="1206925267243987362">ใช้การตั้งค่าเบราว์เซอร์ที่ Browther แนะนำ</translation>
<translation id="8270483548049772782">ลบข้อมูลออกจาก Browther (<ph name="URL"/>) ด้วย</translation>
<translation id="1345251407431278948">ปักหมุดแล้ว คุณเข้าถึงการค้นหารูปภาพได้อีกครั้งจากปุ่มใหม่ในแถบเครื่องมือ</translation>
<translation id="1356661055722410047">ใหม่! คุณแปลได้ทั้งข้อความและรูปภาพบนหน้าจอ</translation>
<translation id="1383876407941801731">ค้นหา</translation>
<translation id="1592588950737518481">&amp;จัดการโปรไฟล์ Browther</translation>
<translation id="1404026649028693342">แสดงโหมด AI เสมอ</translation>
<translation id="141901961143729572">แชร์ความคิดเห็นของคุณ</translation>
<translation id="1743952081001089298">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ Browther ใน "การตั้งค่าระบบ"</translation>
<translation id="8627385813382688019">รับความช่วยเหลือเกี่ยวกับ Browther สำหรับการทดสอบ</translation>
<translation id="1497802159252041924">ข้อผิดพลาดในการติดตั้ง: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">หน้านี้ได้รับการป้องกัน</translation>
<translation id="7252430412915798987">แชร์แท็บ Browther</translation>
<translation id="6388429281015199562">ลงชื่อเข้าใช้ Browther</translation>
<translation id="1547469039832541117">สิ้นสุดงานที่ไฮไลต์ไว้</translation>
<translation id="1801944307203212016">Browther ต้องการสิทธิ์เข้าถึงกล้องเพื่อสร้างแผนที่ 3 มิติของสิ่งที่อยู่รอบตัวคุณ</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{ระบบไม่รองรับส่วนขยายนี้อีกต่อไป Browther ขอแนะนำให้คุณนำออก}other{ระบบไม่รองรับส่วนขยายเหล่านี้อีกต่อไป Browther ขอแนะนำให้คุณนำออก}}</translation>
<translation id="4667068923142532753">ปักหมุด Browther</translation>
<translation id="3006560544901646947">เครื่องมือด้านความปลอดภัยของ Browther</translation>
<translation id="686052171138185761">Browther ต้องการลบข้อมูลในเครื่องมือจัดการรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="8713026329083542796">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน Browther</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="1680687534629375545">ถามการค้นหารูปภาพเกี่ยวกับหน้านี้</translation>
<translation id="1709772298389099340">ให้สิทธิ์ในระดับสูงขึ้นกับ <ph name="BROWSER_NAME"/></translation>
<translation id="4243382967656566037">Browther จะส่งข้อมูลการโต้ตอบของคุณให้กับ Browther เพื่อช่วยปรับปรุงฟีเจอร์เหล่านี้ เจ้าหน้าที่ตรวจสอบอาจอ่าน ประมวลผล และใส่คำอธิบายประกอบข้อมูลดังกล่าว</translation>
<translation id="1722488837206509557">สิทธิ์นี้จะช่วยให้คุณสามารถเลือกจากอุปกรณ์ที่พร้อมใช้งานและแสดงเนื้อหาบนอุปกรณ์เหล่านั้น</translation>
<translation id="6820510278633522408">Browther จะลบข้อมูลการท่องเว็บเร็วๆ นี้</translation>
<translation id="7775028004939172516">Browther จะพยายามอัปเกรดการนำทางให้เป็นแบบ HTTPS</translation>
<translation id="6963959729951758069">ล้างข้อมูล Browther แล้ว</translation>
<translation id="4085139922884095932">Browther จะรีสตาร์ทใน <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">เมื่อ HTTPS ไม่พร้อมใช้งาน Browther จะใช้การเชื่อมต่อที่ไม่ปลอดภัยโดยไม่แจ้งเตือนคุณ</translation>
<translation id="3975328336074677101">ให้ Browther ทำงานในพื้นหลัง</translation>
<translation id="2497443204974841650">ติดตั้ง Browther ใหม่</translation>
<translation id="1724309687045787742">Browther กำลังพยายาม<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">ครั้งถัดไปที่เปิด Browther ใน <ph name="DEVICE_TYPE"/> คุณจะเห็นข้อความแจ้งให้ใช้เครื่องมือจัดการรหัสผ่านบน Browther</translation>
<translation id="1838374766361614909">ล้างการค้นหา</translation>
<translation id="2337233040802538155">หากต้องการลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้เท่านั้น แต่ยังเก็บข้อมูลดังกล่าวไว้ในบัญชี Browther ให้<ph name="BEGIN_LINK"/>ออกจากระบบ Browther<ph name="END_LINK"/></translation>
<translation id="3927415701154897844">ดาวน์โหลด Browther บนโทรศัพท์เพื่อเปิดหรือสร้างกลุ่มแท็บใหม่ได้ทุกที่ทุกเวลา</translation>
<translation id="2063443520349987970">คุณจัดการบัญชี Browther ที่ลงชื่อเข้าใช้ได้ บัญชี Browther ใช้สำหรับเบราว์เซอร์ Browther, Play Store, Gmail และอื่นๆ หากต้องการเพิ่มบัญชีให้คนอื่น เช่น สมาชิกในครอบครัว ให้เพิ่มบุคคลใหม่ลงใน <ph name="DEVICE_TYPE"/> แทน <ph name="LINK_BEGIN"/>ดูข้อมูลเพิ่มเติม<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ค้นหาด้วยการค้นหารูปภาพ</translation>
<translation id="1880677175115548835">เลือกข้อความ</translation>
<translation id="3183933389992069620">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Browther ของคุณ ข้อมูล Browther เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME"/> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Browther แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น คุณสามารถเลือกที่จะสร้างโปรไฟล์ใหม่เพื่อแยกเก็บข้อมูล Browther ที่มีอยู่ของคุณ <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther จะช่วยสงวนพลังงานแบตเตอรี่โดยการจำกัดกิจกรรมในเบื้องหลังและเอฟเฟกต์ภาพ เช่น การเลื่อนอย่างราบรื่นและอัตราเฟรมวิดีโอ <ph name="BEGIN_LINK"/>ดูข้อมูลเพิ่มเติมเกี่ยวกับโหมดประหยัดพลังงาน<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">สอบถามเกี่ยวกับหน้านี้</translation>
<translation id="9128006428501241840">บริการ Browther Updater</translation>
<translation id="6302815314157879372">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ Browther อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ Browther</translation>
<translation id="1063611196035804685">Browther ไม่ตอบสนอง เปิดใหม่เลยหรือไม่</translation>
<translation id="2873360330889594383">องค์กร <ph name="MANAGER"/> กำหนดให้คุณต้องลงชื่อเข้าใช้ Browther</translation>
<translation id="4035053306113201399">ต้องรีสตาร์ท Chrome OS เพื่อใช้การอัปเดต</translation>
<translation id="2861285003831382718">Browther บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์ประเภทนี้ไม่ได้มีการดาวน์โหลดกันโดยทั่วไปและอาจเป็นอันตราย</translation>
<translation id="1953553007165777902">กำลังดาวน์โหลด... เหลืออีก <ph name="MINUTE"/> นาที</translation>
<translation id="2080160985220483492">เคล็ดลับสำหรับ Browther: บันทึกรหัสผ่าน</translation>
<translation id="8037497710694492565">Browther ไม่สามารถกำหนดหรือตั้งค่าเบราว์เซอร์เริ่มต้น</translation>
<translation id="7395009124247513849">ดูสาเหตุที่ Browther บล็อกบางไฟล์ เปิดในแท็บใหม่</translation>
<translation id="762710512520170632">โปรดอัปเดตซอฟต์แวร์ Browther ให้เป็นเวอร์ชันล่าสุดอยู่เสมอ หากปิดใช้หรือหยุดบริการนี้ ซอฟต์แวร์ Browther ของคุณจะไม่ได้รับการอัปเดต ซึ่งหมายความว่าช่องโหว่ด้านความปลอดภัยที่อาจเกิดขึ้นจะไม่สามารถแก้ไขได้และฟีเจอร์อาจไม่ทำงาน บริการนี้จะถอนการติดตั้งตัวเองเมื่อไม่มีซอฟต์แวร์ Browther ใช้งานอยู่</translation>
<translation id="5793588180426267429">การดำเนินการนี้จะลบ 1 รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Browther ด้วย <ph name="USER_EMAIL"/></translation>
<translation id="2018879682492276940">การติดตั้งไม่สำเร็จ โปรดลองอีกครั้ง</translation>
<translation id="6351516710581760512"><ph name="BEGIN_LINK"/>ลงชื่อเข้าใช้ Browther<ph name="END_LINK"/> เพื่อตรวจสอบว่ารหัสผ่านรายการอื่นไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="2039417478970545937">การตั้งค่า</translation>
<translation id="8194525816714210105">เลือกว่าจะรวมประวัติการเข้าชม Browther เพื่อรับประสบการณ์ที่ปรับเปลี่ยนในแบบของคุณมากขึ้นในบริการของ Browther หรือไม่</translation>
<translation id="5909559127548969159">คลิกปุ่มปรับแต่ง Browther ในหน้าแท็บใหม่เพื่อสร้างรูปลักษณ์ใหม่ๆ ให้ Browther</translation>
<translation id="2066690553719545730">แสดงโหมด AI เสมอ</translation>
<translation id="3283892260110318935">Browther บล็อกการดาวน์โหลดนี้เนื่องจากไฟล์มีการหลอกลวงและอาจทำการเปลี่ยนแปลงที่ไม่คาดคิดกับอุปกรณ์</translation>
<translation id="6160571936643742128">คุณจะเห็นข้อความแจ้งให้ลองใช้ <ph name="FEATURE_NAME"/> ในครั้งถัดไปที่เปิด Browther บน iOS</translation>
<translation id="8380517409933452343">ระบบจะนำรหัสผ่านและข้อมูลอื่นๆ ของ Browther ที่คุณบันทึกไว้ในบัญชี Browther ออกจากอุปกรณ์นี้ หากต้องการใช้ข้อมูลเหล่านี้ใน Browther ให้ลงชื่อเข้าใช้อีกครั้ง</translation>
