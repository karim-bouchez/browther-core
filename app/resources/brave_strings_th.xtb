<translation id="6436260184216827876">การค้นหารูปภาพไม่พร้อมใช้งาน โปรดลองอีกครั้งในภายหลัง</translation>
<translation id="2139300032719313227">รีสตาร์ท Chrome OS</translation>
<translation id="6110616900529884221">Browther จะโหลดหน้าเว็บที่คุณน่าจะเข้าชมเอาไว้ล่วงหน้าเพิ่มมากขึ้น เพื่อให้หน้าเหล่านั้นโหลดเร็วขึ้นเมื่อคุณเข้าชม</translation>
<translation id="1217194059001819677">ดาวน์โหลด Browther บนโทรศัพท์เพื่อติดตามราคาและรับการแจ้งเตือนเมื่อราคาต่ำลงในเว็บไซต์ใดก็ตาม</translation>
<translation id="7058555680120557198">ปิด • Browther ยืนยันไม่ได้ว่าส่วนขยายนี้มาจากไหน</translation>
<translation id="676533642429632127">ยินดีต้อนรับสู่โปรไฟล์ Browther</translation>
<translation id="5518682889576009702">ครั้งถัดไปที่เปิด Browther ใน <ph name="DEVICE_TYPE"/> คุณจะเห็นข้อความแจ้งให้ใช้กลุ่มแท็บ</translation>
<translation id="6038105561107837619">นำบัญชีออกจาก Browther</translation>
<translation id="2675662665675552980">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด Browther ด้วย</translation>
<translation id="648319183876919572">Safe Browsing พร้อมการปกป้องที่ดียิ่งขึ้นทำสิ่งต่างๆ ได้มากขึ้นเพื่อปกป้องคุณจากเว็บไซต์และการดาวน์โหลดที่เป็นอันตราย</translation>
<translation id="2930243146591999795">ถอนการติดตั้ง Browther</translation>
<translation id="5241183382286817629">เปิดทางลัดใน Browther</translation>
<translation id="7907014599435829661">องค์กรจะปิด Browther เมื่อไม่มีการใช้งานเป็นเวลา <ph name="TIMEOUT_DURATION"/> ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด</translation>
<translation id="2088471423667794811">แต่ละโปรไฟล์จะเก็บข้อมูล Browther ของตัวเอง เช่น บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และอื่นๆ</translation>
<translation id="9040334484455218184">ดูข้อมูลเพิ่มเติมเกี่ยวกับ<ph name="BEGIN_LINK"/>วิธีที่ Browther ช่วยรักษาข้อมูลของคุณให้เป็นส่วนตัว<ph name="END_LINK"/></translation>
<translation id="1718697235867382480">การเปลี่ยนแปลงการตั้งค่านี้จะมีผลเมื่อ Browther รีสตาร์ท</translation>
<translation id="6331317152404762758">คุณสามารถสลับเพื่อดูรหัสผ่านจากโปรไฟล์ Browther อื่นได้</translation>
<translation id="6097706403184348562">Browther จะส่งข้อความที่คุณพิมพ์ในช่องข้อความไปยัง Browther เพื่อแก้ไขข้อผิดพลาดของการสะกดคำ</translation>
<translation id="2319647238307402812">ไปที่การตั้งค่าการแจ้งเตือน Browther</translation>
<translation id="6600016381025017075">ค้นหาอะไรก็ได้ในหน้านี้</translation>
<translation id="8031938899816118394">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณเปิด Browther ขึ้นอีก</translation>
<translation id="7412185356697187964">ตอนนี้ระบบจะเปิด Browther เมื่อ Windows เริ่มทำงาน คุณจึงเริ่มท่องเว็บได้ทันที คุณปิดการดำเนินการนี้ได้ในการตั้งค่า</translation>
<translation id="9123343592576384616">ดำเนินการต่อจากที่ค้างไว้: Browther ได้คืนค่าแท็บจากการเข้าชมล่าสุด คุณปิดตัวเลือกนี้ได้ใน</translation>
<translation id="5847926498049048567">Browther ต้องการสิทธิ์เข้าถึงกล้องเพื่อสร้างแผนที่ 3 มิติของสิ่งที่อยู่รอบตัวคุณ</translation>
<translation id="5532585028508811858">หากบันทึกบุ๊กมาร์กไว้ในบัญชี Browther ด้วย คุณก็จะติดตามราคาผลิตภัณฑ์ใน Browther และรับการแจ้งเตือนเมื่อราคาต่ำลงได้</translation>
<translation id="6676384891291319759">เข้าถึงอินเทอร์เน็ต</translation>
<translation id="1363996462118479832">Chrome OS ซิงค์ข้อมูลไม่ได้เนื่องจากเกิดข้อผิดพลาดในการลงชื่อเข้าใช้</translation>
<translation id="3373239673945775810">นำข้อมูลแอปนี้ออกจาก Browther</translation>
<translation id="8122759674786039814">Browther ให้คุณควบคุมโฆษณาที่เห็นได้มากขึ้น และจำกัดว่าเว็บไซต์จะรู้อะไรเกี่ยวกับคุณได้บ้างเมื่อแสดงโฆษณาที่ปรับตามโปรไฟล์ของผู้ใช้</translation>
<translation id="6277682530398500159">Browther ต้องการสิทธิ์เข้าถึงไมโครโฟนสำหรับเว็บไซต์นี้</translation>
<translation id="6712881677154121168">ข้อผิดพลาดในการดาวน์โหลด: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="2972046656127603037">โปรไฟล์ของคุณไม่สามารถใช้ได้เนื่องจากมาจาก Browther รุ่นใหม่

ฟีเจอร์บางประการอาจไม่มี โปรดระบุไดเรกทอรีโปรไฟล์อื่น หรือใช้ Browther รุ่นใหม่</translation>
<translation id="871671753163165892">รวม Browther ไว้ในกิจกรรมบนเว็บและแอป ตลอดจนบริการของ Browther ที่ลิงก์ไว้เพื่อรับการปรับเปลี่ยนในแบบของคุณและฟีเจอร์อื่นๆ</translation>
<translation id="5000832110229523807">มีการติดตั้ง Browther สำหรับผู้ใช้ทุกคนบนคอมพิวเตอร์ของคุณแล้ว</translation>
<translation id="5204575479550973859">ลงชื่อเข้าใช้ Browther เพื่อเข้าถึงรหัสผ่าน บุ๊กมาร์ก และข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่อง ระบบจะบันทึกบุ๊กมาร์กนี้ไว้ในบัญชี Browther หลังจากที่คุณลงชื่อเข้าใช้</translation>
<translation id="2874208284092283937">เพิ่มความเร็วให้เว็บไซต์ด้วยเครื่องมือ V8 ของ Browther แต่ทำให้ Browther ต้านทานการโจมตีได้น้อยลงเล็กน้อย การตั้งค่านี้เปิดอยู่</translation>
<translation id="3268577459683869744">{count,plural, =1{ยังไม่ได้บันทึกข้อมูล Browther บางอย่างของคุณลงในบัญชี Browther โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้ (1 รายการ)}other{ยังไม่ได้บันทึกข้อมูล Browther บางอย่างของคุณลงในบัญชี Browther โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้ ({count} รายการ)}}</translation>
<translation id="7683816018918395929">Browther แนะนำให้สแกนไฟล์นี้เนื่องจากอาจเป็นอันตราย</translation>
<translation id="1547295885616600893">Chrome OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS"/>อื่นเพิ่มเติม</translation>
<translation id="6831043979455480757">แปลภาษา</translation>
<translation id="2142653375108595728">Browther จะแจ้งให้ทราบหากมีคนล่วงรู้รหัสผ่านของคุณ</translation>
<translation id="684888714667046800">เชื่อมต่อกับอินเทอร์เน็ตไม่ได้ หากคุณใช้ไฟร์วอลล์ โปรดตรวจสอบว่า <ph name="PRODUCT_EXE_NAME"/> อยู่ในรายการที่อนุญาต</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">แตะเพื่อดำเนินการต่อ</translation>
<translation id="6862030660799253820">ค้นหารูปภาพนี้ด้วยการค้นหารูปภาพ</translation>
<translation id="3860339351709082396">Browther พบว่า "<ph name="EXTENSION_NAME"/>" มีมัลแวร์</translation>
<translation id="6877155553248388166">มุมขวาล่างของพื้นที่การค้นหา: ขวา <ph name="RIGHT"/>% ล่าง <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">คัดลอก</translation>
<translation id="7804113502310231166">ตั้ง Browther เป็นเบราว์เซอร์เริ่มต้นและปักหมุดไว้ที่แถบงาน</translation>
<translation id="3228374215117173004">&amp;จัดการโปรไฟล์ Browther</translation>
<translation id="6934579572334859869">ถามการค้นหารูปภาพเกี่ยวกับรูปภาพนี้</translation>
<translation id="5995328366516663808">คุณมีบุ๊กมาร์กถึงขีดจำกัด <ph name="BOOKMARK_LIMIT"/> รายการของ Browther แล้ว ระบบจึงยังไม่ได้บันทึกบุ๊กมาร์กบางรายการลงในบัญชี Browther

บันทึกบุ๊กมาร์กใหม่ในบัญชีไม่ได้จนกว่าคุณจะลบบุ๊กมาร์กบางรายการ หากคุณออกจากระบบตอนนี้ ระบบจะลบบุ๊กมาร์กที่ยังไม่ได้บันทึก</translation>
<translation id="6965382102122355670">ตกลง</translation>
<translation id="4533562834763015352">รหัสผ่านที่ไม่รัดกุมนั้นคาดเดาได้ง่าย ให้ Browther <ph name="BEGIN_LINK"/>สร้างและจดจำรหัสผ่านที่รัดกุมให้คุณ<ph name="END_LINK"/></translation>
<translation id="3453763134178591239">ข้อกำหนดของ Chrome OS</translation>
<translation id="5379058926689137454">Browther ต้องการสิทธิ์เข้าถึงไมโครโฟนของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="4684462982894889021">ป้อนรหัสผ่านเพื่อใช้และบันทึกข้อมูล Browther ในบัญชี <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">การติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับระบบปฏิบัติการเวอร์ชันนี้</translation>
<translation id="7024536598735240744">ข้อผิดพลาดในการคลายการแพคข้อมูล: <ph name="UNPACK_ERROR"/></translation>
<translation id="7025789849649390912">หยุดการติดตั้งแล้ว</translation>
<translation id="8257174622576051374">ปรับเปลี่ยน Browther ในแบบของคุณ</translation>
<translation id="7047386856539490735">ผลการค้นหาเหล่านี้มีประโยชน์ไหม</translation>
<translation id="1772745060691790742">อัปเดต Browther</translation>
<translation id="4937970118065051027">หากรูปภาพไม่มีคำอธิบายที่เป็นประโยชน์ Browther จะพยายามใส่คำอธิบายให้คุณ รูปภาพจะส่งมายัง Browther เพื่อสร้างคำอธิบาย</translation>
<translation id="1594112132009288601">ปรับแต่ง Browther สำหรับการทดสอบ</translation>
<translation id="5915000938288527952">คุณจะใช้ Browther ได้ทุกครั้งที่คลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ</translation>
<translation id="8775664994493381735">นำ <ph name="EXTENSION_NAME"/> ออกจาก Browther</translation>
<translation id="3276648807841991013">องค์กรจะลบข้อมูล Browther เมื่อไม่มีการใช้งานเป็นเวลา <ph name="TIMEOUT_DURATION"/> ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด</translation>
<translation id="4725226878394159809">Browther ต้องการสิทธิ์เข้าถึงกล้องสำหรับเว็บไซต์นี้</translation>
<translation id="8931474625901592021">เปิด Browther ไม่ได้ โปรดลองอีกครั้ง</translation>
<translation id="8242947409070121799">Browther ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดรอ 24 ชั่วโมงแล้วลองอีกครั้ง</translation>
<translation id="1737922827960215472">ปักหมุด Browther ไว้ที่แถบแอปเพื่อให้เข้าถึงได้อย่างรวดเร็วทุกเมื่อ</translation>
<translation id="335855266303176628">ใช้ Browther ทุกครั้งที่คุณคลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ</translation>
<translation id="709455597778444012">ตัวจัดการงาน - Browther</translation>
<translation id="7147140345767587643">ความสนใจของคุณตามที่คาดคะเนโดย Browther</translation>
<translation id="7337408274890534789">เริ่มท่องเว็บได้ทันที: ตอนนี้ระบบสามารถเปิด Browther เมื่อ Windows เริ่มทำงานได้แล้ว</translation>
<translation id="7274695763216404502">ปักหมุดแล้ว ใช้การค้นหารูปภาพอีกครั้งจากแถบเครื่องมือ</translation>
<translation id="7288567540154601580">แท็บและส่วนขยาย</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{Browther แนะนำให้คุณนำออก}other{Browther แนะนำให้คุณนำออก}}</translation>
<translation id="1527644038571473502">หากต้องการแชร์เสียงของระบบ ให้เปิดการตั้งค่าระบบและอนุญาต "การบันทึกเสียงของระบบเท่านั้น" สำหรับ Browther จากนั้นคุณต้องรีสตาร์ท Browther</translation>
<translation id="1427913074981060872">การวัดผลโฆษณาจะให้เว็บไซต์ที่คุณเข้าชมสามารถขอข้อมูลจาก Browther เพื่อช่วยในการวัดประสิทธิภาพโฆษณาของเว็บไซต์ดังกล่าวได้ การวัดผลโฆษณาจะจำกัดการติดตามข้ามเว็บไซต์โดยโอนข้อมูลระหว่างเว็บไซต์ให้น้อยที่สุด</translation>
<translation id="1657652725060525338">กำลังอัปเดต Browther</translation>
<translation id="884846289464870238">ไฟล์ค่ากำหนดของคุณขัดข้องหรือไม่ถูกต้อง

Browther ไม่สามารถกู้คืนการตั้งค่าของคุณได้</translation>
<translation id="7339898014177206373">หน้าต่างใหม่</translation>
<translation id="633044855886370183">เว็บของคุณ บุ๊กมาร์ก และข้อมูลอื่นๆ ใน Browther พร้อมใช้แล้วที่นี่</translation>
<translation id="1185960088713242527">เฉพาะผู้ที่มีรหัสผ่านของคุณเท่านั้นที่จะอ่านข้อมูลที่เข้ารหัสได้ Browther จะไม่ได้รับหรือจัดเก็บรหัสผ่านดังกล่าว หากลืมรหัสผ่านหรือต้องการเปลี่ยนการตั้งค่านี้ คุณจะต้อง<ph name="BEGIN_LINK"/>ลบข้อมูล Browther ในบัญชี<ph name="END_LINK"/></translation>
<translation id="7125151836477182110">ผู้ดูแลระบบได้กำหนดค่าให้ Browther เปิด <ph name="ALTERNATIVE_BROWSER_NAME"/> เพื่อเข้าถึง <ph name="TARGET_URL_HOSTNAME"/></translation>
<translation id="7352651011704765696">มีข้อผิดพลาดเกิดขึ้น</translation>
<translation id="6638123710106659002">คุณจะต้องใช้ macOS 13 ขึ้นไปเพื่อรับการอัปเดต Browther ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ macOS 12</translation>
<translation id="7286289384512061761">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Browther นำสิทธิ์เข้าถึง<ph name="PERMISSION_1"/>และ<ph name="PERMISSION_2"/>ออกแล้ว</translation>
