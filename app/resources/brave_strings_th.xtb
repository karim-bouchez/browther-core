<translation id="6436260184216827876">การค้นหารูปภาพไม่พร้อมใช้งาน โปรดลองอีกครั้งในภายหลัง</translation>
<translation id="2139300032719313227">รีสตาร์ท Chrome OS</translation>
<translation id="638302211119176182">Browther จะโหลดหน้าเว็บที่คุณน่าจะเข้าชมเอาไว้ล่วงหน้าเพิ่มมากขึ้น เพื่อให้หน้าเหล่านั้นโหลดเร็วขึ้นเมื่อคุณเข้าชม</translation>
<translation id="7167975344637731051">ดาวน์โหลด Browther บนโทรศัพท์เพื่อติดตามราคาและรับการแจ้งเตือนเมื่อราคาต่ำลงในเว็บไซต์ใดก็ตาม</translation>
<translation id="890319829408077946">ปิด • Browther ยืนยันไม่ได้ว่าส่วนขยายนี้มาจากไหน</translation>
<translation id="1684121725014454063">ยินดีต้อนรับสู่โปรไฟล์ Browther</translation>
<translation id="8211983866539058675">ครั้งถัดไปที่เปิด Browther ใน <ph name="DEVICE_TYPE"/> คุณจะเห็นข้อความแจ้งให้ใช้กลุ่มแท็บ</translation>
<translation id="7906693299331092358">นำบัญชีออกจาก Browther</translation>
<translation id="2675662665675552980">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด Browther ด้วย</translation>
<translation id="648319183876919572">Safe Browsing พร้อมการปกป้องที่ดียิ่งขึ้นทำสิ่งต่างๆ ได้มากขึ้นเพื่อปกป้องคุณจากเว็บไซต์และการดาวน์โหลดที่เป็นอันตราย</translation>
<translation id="5590013613412457132">ถอนการติดตั้ง Browther</translation>
<translation id="7185585387858242335">เปิดทางลัดใน Browther</translation>
<translation id="3617744907966785605">องค์กรจะปิด Browther เมื่อไม่มีการใช้งานเป็นเวลา <ph name="TIMEOUT_DURATION"/> ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด</translation>
<translation id="8646609321956191980">แต่ละโปรไฟล์จะเก็บข้อมูล Browther ของตัวเอง เช่น บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และอื่นๆ</translation>
<translation id="6756656512757374876">ดูข้อมูลเพิ่มเติมเกี่ยวกับ<ph name="BEGIN_LINK"/>วิธีที่ Browther ช่วยรักษาข้อมูลของคุณให้เป็นส่วนตัว<ph name="END_LINK"/></translation>
<translation id="3556601443414636547">การเปลี่ยนแปลงการตั้งค่านี้จะมีผลเมื่อ Browther รีสตาร์ท</translation>
<translation id="2535436634051789953">คุณสามารถสลับเพื่อดูรหัสผ่านจากโปรไฟล์ Browther อื่นได้</translation>
<translation id="2312399718665761438">Browther จะส่งข้อความที่คุณพิมพ์ในช่องข้อความไปยัง Browther เพื่อแก้ไขข้อผิดพลาดของการสะกดคำ</translation>
<translation id="3507835409099344374">ไปที่การตั้งค่าการแจ้งเตือน Browther</translation>
<translation id="6600016381025017075">ค้นหาอะไรก็ได้ในหน้านี้</translation>
<translation id="9156965752763025780">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณเปิด Browther ขึ้นอีก</translation>
<translation id="3387992981600748596">ตอนนี้ระบบจะเปิด Browther เมื่อ Windows เริ่มทำงาน คุณจึงเริ่มท่องเว็บได้ทันที คุณปิดการดำเนินการนี้ได้ในการตั้งค่า</translation>
<translation id="3119017564683030312">ดำเนินการต่อจากที่ค้างไว้: Browther ได้คืนค่าแท็บจากการเข้าชมล่าสุด คุณปิดตัวเลือกนี้ได้ใน</translation>
<translation id="245693535809364497">Browther ต้องการสิทธิ์เข้าถึงกล้องเพื่อสร้างแผนที่ 3 มิติของสิ่งที่อยู่รอบตัวคุณ</translation>
<translation id="9210457680074341078">หากบันทึกบุ๊กมาร์กไว้ในบัญชี Browther ด้วย คุณก็จะติดตามราคาผลิตภัณฑ์ใน Browther และรับการแจ้งเตือนเมื่อราคาต่ำลงได้</translation>
<translation id="6676384891291319759">เข้าถึงอินเทอร์เน็ต</translation>
<translation id="1363996462118479832">Chrome OS ซิงค์ข้อมูลไม่ได้เนื่องจากเกิดข้อผิดพลาดในการลงชื่อเข้าใช้</translation>
<translation id="4694512973195649124">นำข้อมูลแอปนี้ออกจาก Browther</translation>
<translation id="5324448127277983819">Browther ให้คุณควบคุมโฆษณาที่เห็นได้มากขึ้น และจำกัดว่าเว็บไซต์จะรู้อะไรเกี่ยวกับคุณได้บ้างเมื่อแสดงโฆษณาที่ปรับตามโปรไฟล์ของผู้ใช้</translation>
<translation id="1257247502847251159">Browther ต้องการสิทธิ์เข้าถึงไมโครโฟนสำหรับเว็บไซต์นี้</translation>
<translation id="6712881677154121168">ข้อผิดพลาดในการดาวน์โหลด: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="1489465648257900784">โปรไฟล์ของคุณไม่สามารถใช้ได้เนื่องจากมาจาก Browther รุ่นใหม่

ฟีเจอร์บางประการอาจไม่มี โปรดระบุไดเรกทอรีโปรไฟล์อื่น หรือใช้ Browther รุ่นใหม่</translation>
<translation id="1505112054322049777">รวม Browther ไว้ในกิจกรรมบนเว็บและแอป ตลอดจนบริการของ Browther ที่ลิงก์ไว้เพื่อรับการปรับเปลี่ยนในแบบของคุณและฟีเจอร์อื่นๆ</translation>
<translation id="6666624454809779082">มีการติดตั้ง Browther สำหรับผู้ใช้ทุกคนบนคอมพิวเตอร์ของคุณแล้ว</translation>
<translation id="5848830584656405219">ลงชื่อเข้าใช้ Browther เพื่อเข้าถึงรหัสผ่าน บุ๊กมาร์ก และข้อมูลอื่นๆ ในอุปกรณ์ทุกเครื่อง ระบบจะบันทึกบุ๊กมาร์กนี้ไว้ในบัญชี Browther หลังจากที่คุณลงชื่อเข้าใช้</translation>
<translation id="4020203987234748583">เพิ่มความเร็วให้เว็บไซต์ด้วยเครื่องมือ V8 ของ Browther แต่ทำให้ Browther ต้านทานการโจมตีได้น้อยลงเล็กน้อย การตั้งค่านี้เปิดอยู่</translation>
<translation id="3848421741245997269">{count,plural, =1{ยังไม่ได้บันทึกข้อมูล Browther บางอย่างของคุณลงในบัญชี Browther โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้ (1 รายการ)}other{ยังไม่ได้บันทึกข้อมูล Browther บางอย่างของคุณลงในบัญชี Browther โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้ ({count} รายการ)}}</translation>
<translation id="3136039682492230890">Browther แนะนำให้สแกนไฟล์นี้เนื่องจากอาจเป็นอันตราย</translation>
<translation id="1547295885616600893">Chrome OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS"/>อื่นเพิ่มเติม</translation>
<translation id="6831043979455480757">แปลภาษา</translation>
<translation id="8211837073776713955">Browther จะแจ้งให้ทราบหากมีคนล่วงรู้รหัสผ่านของคุณ</translation>
<translation id="684888714667046800">เชื่อมต่อกับอินเทอร์เน็ตไม่ได้ หากคุณใช้ไฟร์วอลล์ โปรดตรวจสอบว่า <ph name="PRODUCT_EXE_NAME"/> อยู่ในรายการที่อนุญาต</translation>
<translation id="7830723774663008396">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">แตะเพื่อดำเนินการต่อ</translation>
<translation id="6862030660799253820">ค้นหารูปภาพนี้ด้วยการค้นหารูปภาพ</translation>
<translation id="3028928628792374067">Browther พบว่า "<ph name="EXTENSION_NAME"/>" มีมัลแวร์</translation>
<translation id="6877155553248388166">มุมขวาล่างของพื้นที่การค้นหา: ขวา <ph name="RIGHT"/>% ล่าง <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">คัดลอก</translation>
<translation id="862687584320433626">ตั้ง Browther เป็นเบราว์เซอร์เริ่มต้นและปักหมุดไว้ที่แถบงาน</translation>
<translation id="1991562568473125499">&amp;จัดการโปรไฟล์ Browther</translation>
<translation id="6934579572334859869">ถามการค้นหารูปภาพเกี่ยวกับรูปภาพนี้</translation>
<translation id="5529781826378237601">คุณมีบุ๊กมาร์กถึงขีดจำกัด <ph name="BOOKMARK_LIMIT"/> รายการของ Browther แล้ว ระบบจึงยังไม่ได้บันทึกบุ๊กมาร์กบางรายการลงในบัญชี Browther

บันทึกบุ๊กมาร์กใหม่ในบัญชีไม่ได้จนกว่าคุณจะลบบุ๊กมาร์กบางรายการ หากคุณออกจากระบบตอนนี้ ระบบจะลบบุ๊กมาร์กที่ยังไม่ได้บันทึก</translation>
<translation id="6965382102122355670">ตกลง</translation>
<translation id="6418340404893954563">รหัสผ่านที่ไม่รัดกุมนั้นคาดเดาได้ง่าย ให้ Browther <ph name="BEGIN_LINK"/>สร้างและจดจำรหัสผ่านที่รัดกุมให้คุณ<ph name="END_LINK"/></translation>
<translation id="3453763134178591239">ข้อกำหนดของ Chrome OS</translation>
<translation id="3335606533094650083">Browther ต้องการสิทธิ์เข้าถึงไมโครโฟนของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="6643520655691573653">ป้อนรหัสผ่านเพื่อใช้และบันทึกข้อมูล Browther ในบัญชี <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">การติดตั้งไม่สำเร็จเนื่องจากระบบไม่รองรับระบบปฏิบัติการเวอร์ชันนี้</translation>
<translation id="7024536598735240744">ข้อผิดพลาดในการคลายการแพคข้อมูล: <ph name="UNPACK_ERROR"/></translation>
<translation id="7025789849649390912">หยุดการติดตั้งแล้ว</translation>
<translation id="280382502853897110">ปรับเปลี่ยน Browther ในแบบของคุณ</translation>
<translation id="7047386856539490735">ผลการค้นหาเหล่านี้มีประโยชน์ไหม</translation>
<translation id="1705567146636171298">อัปเดต Browther</translation>
<translation id="5499063270485366718">หากรูปภาพไม่มีคำอธิบายที่เป็นประโยชน์ Browther จะพยายามใส่คำอธิบายให้คุณ รูปภาพจะส่งมายัง Browther เพื่อสร้างคำอธิบาย</translation>
<translation id="5966368554860795750">ปรับแต่ง Browther สำหรับการทดสอบ</translation>
<translation id="792838367208896130">คุณจะใช้ Browther ได้ทุกครั้งที่คลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ</translation>
<translation id="375314543563594498">นำ <ph name="EXTENSION_NAME"/> ออกจาก Browther</translation>
<translation id="2332301637111071062">องค์กรจะลบข้อมูล Browther เมื่อไม่มีการใช้งานเป็นเวลา <ph name="TIMEOUT_DURATION"/> ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด</translation>
<translation id="1008530050039597147">Browther ต้องการสิทธิ์เข้าถึงกล้องสำหรับเว็บไซต์นี้</translation>
<translation id="1197672524850678392">เปิด Browther ไม่ได้ โปรดลองอีกครั้ง</translation>
<translation id="3405035915691517126">Browther ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดรอ 24 ชั่วโมงแล้วลองอีกครั้ง</translation>
<translation id="3625983487600668413">ปักหมุด Browther ไว้ที่แถบแอปเพื่อให้เข้าถึงได้อย่างรวดเร็วทุกเมื่อ</translation>
<translation id="5755581833598928580">ใช้ Browther ทุกครั้งที่คุณคลิกลิงก์ในข้อความ เอกสาร และแอปอื่นๆ</translation>
<translation id="5516268345616100622">ตัวจัดการงาน - Browther</translation>
<translation id="713191641919118540">ความสนใจของคุณตามที่คาดคะเนโดย Browther</translation>
<translation id="1871621397473741084">เริ่มท่องเว็บได้ทันที: ตอนนี้ระบบสามารถเปิด Browther เมื่อ Windows เริ่มทำงานได้แล้ว</translation>
<translation id="7274695763216404502">ปักหมุดแล้ว ใช้การค้นหารูปภาพอีกครั้งจากแถบเครื่องมือ</translation>
<translation id="7288567540154601580">แท็บและส่วนขยาย</translation>
<translation id="5468053269968670855">{NUM_EXTENSIONS,plural, =1{Browther แนะนำให้คุณนำออก}other{Browther แนะนำให้คุณนำออก}}</translation>
<translation id="4600669988724328687">หากต้องการแชร์เสียงของระบบ ให้เปิดการตั้งค่าระบบและอนุญาต "การบันทึกเสียงของระบบเท่านั้น" สำหรับ Browther จากนั้นคุณต้องรีสตาร์ท Browther</translation>
<translation id="9068395155143628872">การวัดผลโฆษณาจะให้เว็บไซต์ที่คุณเข้าชมสามารถขอข้อมูลจาก Browther เพื่อช่วยในการวัดประสิทธิภาพโฆษณาของเว็บไซต์ดังกล่าวได้ การวัดผลโฆษณาจะจำกัดการติดตามข้ามเว็บไซต์โดยโอนข้อมูลระหว่างเว็บไซต์ให้น้อยที่สุด</translation>
<translation id="1864557848095568223">กำลังอัปเดต Browther</translation>
<translation id="3403365884036456766">ไฟล์ค่ากำหนดของคุณขัดข้องหรือไม่ถูกต้อง

Browther ไม่สามารถกู้คืนการตั้งค่าของคุณได้</translation>
<translation id="7339898014177206373">หน้าต่างใหม่</translation>
<translation id="3511996232906761537">เว็บของคุณ บุ๊กมาร์ก และข้อมูลอื่นๆ ใน Browther พร้อมใช้แล้วที่นี่</translation>
<translation id="1754899895078387289">เฉพาะผู้ที่มีรหัสผ่านของคุณเท่านั้นที่จะอ่านข้อมูลที่เข้ารหัสได้ Browther จะไม่ได้รับหรือจัดเก็บรหัสผ่านดังกล่าว หากลืมรหัสผ่านหรือต้องการเปลี่ยนการตั้งค่านี้ คุณจะต้อง<ph name="BEGIN_LINK"/>ลบข้อมูล Browther ในบัญชี<ph name="END_LINK"/></translation>
<translation id="5380963249588143069">ผู้ดูแลระบบได้กำหนดค่าให้ Browther เปิด <ph name="ALTERNATIVE_BROWSER_NAME"/> เพื่อเข้าถึง <ph name="TARGET_URL_HOSTNAME"/></translation>
<translation id="7352651011704765696">มีข้อผิดพลาดเกิดขึ้น</translation>
<translation id="6085660187823915017">คุณจะต้องใช้ macOS 13 ขึ้นไปเพื่อรับการอัปเดต Browther ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ macOS 12</translation>
<translation id="2865744782251083875">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Browther นำสิทธิ์เข้าถึง<ph name="PERMISSION_1"/>และ<ph name="PERMISSION_2"/>ออกแล้ว</translation>
<translation id="4631170166710903214">ระบบไม่รองรับส่วนขยายนี้แล้ว Browther แนะนำให้คุณนำออกแทน</translation>
