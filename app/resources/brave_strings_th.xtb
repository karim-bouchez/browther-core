<translation id="7304389940068374923">กำลังปรับแต่ง Browther ในแบบของคุณ...</translation>
<translation id="9216183508558772570">Browther จะแจ้งให้ทราบเมื่อคุณลงชื่อเข้าใช้ด้วยรหัสผ่านที่ไม่รัดกุม</translation>
<translation id="5853262807109651878">การดำเนินการนี้จะลบ <ph name="ITEMS_COUNT"/> รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Browther ด้วย <ph name="USER_EMAIL"/></translation>
<translation id="2024972335338126423"><ph name="SHORTCUT"/> จะสลับไปมาระหว่างโปรไฟล์ Browther ได้</translation>
<translation id="8703492925273919597">โปรดปิดหน้าต่าง Browther ทั้งหมดแล้วลองอีกครั้ง</translation>
<translation id="599091950194451698">หากต้องการแชร์หน้าต่าง ให้อนุญาตการบันทึกหน้าจอสำหรับ Browther ใน "การตั้งค่าระบบ"</translation>
<translation id="1447863765638888625"><ph name="EXISTING_USER"/> ลงชื่อเข้าใช้อยู่แล้ว  หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก ให้ลงชื่อเข้าใช้ Browther ในโปรไฟล์ของคุณเองด้วย <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="8981774130895723211">หากต้องการแชร์หน้าจอ ให้อนุญาตการบันทึกหน้าจอสำหรับ Browther ใน "การตั้งค่าระบบ"</translation>
<translation id="3597003331831379823">เรียกใช้การตั้งค่าด้วยสิทธิ์ในระดับสูงขึ้นไม่สำเร็จ <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="4167284810587724062">ลงชื่อเข้าใช้ Browther</translation>
<translation id="3066805437003400520">ระบบจะลบข้อมูลการท่องเว็บของบุคคลนี้ออกจากอุปกรณ์นี้ หากต้องการกู้ข้อมูลคืน ให้ลงชื่อเข้าใช้ Browther ในชื่อ <ph name="USER_EMAIL"/></translation>
<translation id="7029305463989165490">หากต้องการส่งหมายเลขจาก <ph name="ORIGIN"/> ไปยังโทรศัพท์ Android ให้ลงชื่อเข้าใช้ Browther ในอุปกรณ์ทั้งสองเครื่อง</translation>
<translation id="3667616615096815454">ติดตั้งไม่ได้เนื่องจากเซิร์ฟเวอร์ไม่รู้จักแอปพลิเคชัน</translation>
<translation id="1128485277465085828">ใช้<ph name="BEGIN_LINK"/>รหัสผ่านของคุณเอง<ph name="END_LINK"/>ในการเข้ารหัสข้อมูล Browther ทั้งหมดในบัญชี Browther ที่อยู่และวิธีการชำระเงินจาก Google Pay จะไม่มีการเข้ารหัส ประวัติการท่องเว็บจาก Browther จะไม่ซิงค์</translation>
<translation id="4304059894777924102">Browther ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดลองตรวจสอบการเชื่อมต่ออินเทอร์เน็ต</translation>
<translation id="1807774211756215222">เปิดลิงก์ใน Browther แท็บใหม่</translation>
<translation id="387105482057676379">ลิงก์ Browther และบริการอื่นๆ ของ Browther เพื่อการปรับเปลี่ยนในแบบของคุณและวัตถุประสงค์อื่นๆ</translation>
<translation id="3729187154190517324">เจาะลึกการค้นหาด้วยการเพิ่มแท็บ ไฟล์ และเครื่องมือหลายรายการโดยใช้ปุ่ม "เพิ่มแท็บและอื่นๆ"</translation>
<translation id="3867175562099983425">จัดการโปรไฟล์ Browther</translation>
<translation id="308146532933302843">ดูสาเหตุที่ Browther บล็อกการดาวน์โหลดบางรายการ</translation>
<translation id="2189149060536531804">Browther จะแจ้งให้คุณทราบหากมีสิ่งใดที่คุณควรตรวจสอบ</translation>
<translation id="8422094375343667686">โปรไฟล์ Browther ช่วยให้คุณแยกชีวิตแต่ละด้านออกจากกันได้ เพิ่มโปรไฟล์ใหม่เลย</translation>
<translation id="6324134303015966238">Browther จะโหลดหน้าเว็บที่คุณน่าจะเข้าชมเอาไว้ล่วงหน้าเพื่อให้หน้าเหล่านั้นโหลดเร็วขึ้นเมื่อคุณเข้าชม</translation>
<translation id="3810973564298564668">จัดการ</translation>
<translation id="4815742196440583661">หากต้องการใช้รหัสผ่านที่บันทึกไว้ ให้สแกนคิวอาร์โค้ด, ดาวน์โหลด Browther สำหรับ iOS และลงชื่อเข้าใช้บัญชี Browther</translation>
<translation id="6093965249696204223">เคล็ดลับสำหรับ Browther: Safe Browsing พร้อมการปกป้องที่ดียิ่งขึ้น</translation>
<translation id="3846683726093018685">**สรุป:** อธิบายเรื่องหลักและวัตถุประสงค์ของเนื้อหาในภาพหน้าจอในประโยคเดียวที่มีไม่เกิน 30 คำ

          **แนะนำคำถาม:** สร้างรายการสัญลักษณ์หัวข้อย่อยของคำถามกระตุ้นความคิด 3-5 ข้อที่ผู้ใช้อาจถามเพื่อทำความเข้าใจภาพหน้าจอได้ดียิ่งขึ้น คำถามเหล่านี้ควรมีอย่างน้อย 1 ข้อที่เกี่ยวกับวัตถุภาพ การออกแบบ หรือตำแหน่งของวัตถุนั้นโดยเฉพาะ</translation>
<translation id="5381622442243174305"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">เครื่องมือเลือกภาษา</translation>
<translation id="6315734375101223238">ปรับแต่งและควบคุม Browther มีสิ่งที่คุณจำเป็นต้องทราบ โปรดคลิกเพื่อดูรายละเอียด</translation>
<translation id="7130675370997202556">คลิกชื่อของคุณเพื่อเปิด Browther และเริ่มท่องเว็บ</translation>
<translation id="3892148308691398805">คัดลอกข้อความ</translation>
<translation id="4920958997042285125"><ph name="EXISTING_USER"/> ลงชื่อเข้าใช้โปรไฟล์ Browther นี้แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก Browther สร้างโปรไฟล์ให้คุณโดยเฉพาะได้</translation>
<translation id="8744239658215739511">ปรับแต่ง Browther</translation>
<translation id="3941890832296813527">ข้อผิดพลาดในการติดตั้ง: ชื่อไฟล์ของโปรแกรมติดตั้งไม่ถูกต้องหรือระบบไม่รองรับ</translation>
<translation id="8090497651549769448">Browther กำลังพยายามคัดลอกรหัสผ่าน โปรดพิมพ์รหัสผ่าน Windows ของคุณเพื่ออนุญาต</translation>
<translation id="4256965182800026277">ระบบจะนำรหัสผ่าน วิธีการชำระเงิน และที่อยู่ที่คุณบันทึกไว้ในบัญชี Browther ออกจากอุปกรณ์นี้ หากต้องการใช้ข้อมูลเหล่านี้ใน Browther ให้ลงชื่อเข้าใช้อีกครั้ง</translation>
<translation id="395904275706073188">อ่านหน้าเว็บที่มีการป้องกันไม่ได้ โปรดลองใช้หน้าอื่น</translation>
<translation id="4194619960643453552">ดูวิธีที่ Browther ช่วยให้คุณปลอดภัย</translation>
<translation id="1486377520191913768">เมื่อคุณพิมพ์ในแถบที่อยู่หรือช่องค้นหา Browther จะส่งสิ่งที่คุณพิมพ์ไปยังเครื่องมือค้นหา, AI และเครื่องมือตัวแทนขององค์กรเพื่อรับคำแนะนำ</translation>
<translation id="1311808042904310985">เกี่ยวกับ Browther สำหรับการทดสอบ</translation>
<translation id="1152920704813762236">เกี่ยวกับ Chrome OS</translation>
<translation id="8282895427217902177">เมื่อคุณเข้าชมเว็บไซต์ Browther จะนำเฉพาะบางส่วนของ URL มาปรับให้ยากต่อการอ่าน (Obfuscate) แล้วส่งไปยัง <ph name="BEGIN_LINK"/>Google Safe Browsing<ph name="END_LINK"/> ผ่านเซิร์ฟเวอร์ส่วนตัวที่ซ่อนที่อยู่ IP ของคุณ หากเว็บไซต์ทำสิ่งที่น่าสงสัย ระบบจะส่ง URL แบบเต็มและเนื้อหาของหน้าเว็บบางส่วนด้วย</translation>
<translation id="3703994572283698466">Chrome OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS"/>อื่นเพิ่มเติม ตลอดจน<ph name="BEGIN_LINK_LINUX_OSS"/>สภาพแวดล้อมในการพัฒนาซอฟต์แวร์ Linux<ph name="END_LINK_LINUX_OSS"/></translation>
<translation id="4022972681110646219">แปลหน้าจอ</translation>
<translation id="4023601594785368013">ภาษาต้นฉบับ: <ph name="LANGUAGE"/></translation>
<translation id="5540160525564738506">เปิดลิงก์ใน Browther จากแอปใดก็ได้ และปักหมุดไว้ที่แถบงานเพื่อให้เข้าถึงได้ง่าย</translation>
<translation id="6056473803837713617">ช่วยให้ Browther ดียิ่งขึ้นด้วยการรายงาน<ph name="BEGIN_LINK"/>การตั้งค่าปัจจุบัน<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">การปรับปรุงด้านความปลอดภัยที่สำคัญและฟีเจอร์ใหม่ๆ พร้อมให้บริการในเวอร์ชันล่าสุด</translation>
<translation id="4055805654398742145">เครื่องมือจัดการรหัสผ่าน</translation>
<translation id="6654312501894761082">โปรแกรมอื่นในคอมพิวเตอร์เพิ่มส่วนขยายที่อาจเปลี่ยนวิธีการทำงานของ Browther

<ph name="EXTENSION_NAME"/></translation>
<translation id="6217792792122501564">{COUNT,plural, =1{องค์กรจะปิด Browther โดยอัตโนมัติเมื่อไม่มีการใช้งานเป็นเวลา 1 นาที ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด}other{องค์กรจะปิด Browther โดยอัตโนมัติเมื่อไม่มีการใช้งานเป็นเวลา # นาที ลบข้อมูลการท่องเว็บแล้ว ซึ่งอาจรวมถึงประวัติการเข้าชม การป้อนข้อความอัตโนมัติ และการดาวน์โหลด}}</translation>
<translation id="5794951150713244901">ไปที่หน้าเกี่ยวกับ Browther</translation>
<translation id="10925962326134232">ปรับแต่ง Browther เพื่อสร้างรูปลักษณ์ใหม่ๆ ให้เบราว์เซอร์</translation>
<translation id="6596295505984504022">ปรับแต่ง Browther</translation>
<translation id="4148957013307229264">กำลังติดตั้ง...</translation>
<translation id="4658486203392098459"><ph name="PAGE_TITLE"/> - หน้าลงชื่อเข้าใช้ของเครือข่าย - Browther</translation>
<translation id="2871190378186459992">พบกับแอป เกม ส่วนขยาย และธีมเด็ดๆ สำหรับ Browther</translation>
<translation id="462105622535258178">ลงชื่อเข้าใช้ Browther เพื่อรับส่วนขยายนี้และข้อมูลอื่นๆ ในคอมพิวเตอร์ทุกเครื่อง</translation>
<translation id="6670140629169983459">หากต้องการท่องโลกออนไลน์อย่างปลอดภัยยิ่งขึ้นด้วยตัวเลือกของผู้ปกครอง ให้เปลี่ยนไปใช้โปรไฟล์ Browther ที่คุณลงชื่อเข้าใช้ด้วย <ph name="USER_EMAIL_ADDRESS"/> อยู่แล้ว</translation>
<translation id="4222932583846282852">กำลังยกเลิก...</translation>
<translation id="4224210481850767180">ยกเลิกการติดตั้งแล้ว</translation>
<translation id="1853997773668795891">เชื่อมโยงข้อมูล Browther กับบัญชีนี้ไหม</translation>
<translation id="4732930052828648898">เตือนคุณเกี่ยวกับเว็บไซต์ที่เป็นอันตราย แม้แต่เว็บไซต์ที่ Browther ไม่เคยรู้จักมาก่อนด้วยการวิเคราะห์ข้อมูลจากเว็บไซต์มากกว่าการปกป้องแบบมาตรฐาน คุณเลือกข้ามคำเตือนของ Browther ได้</translation>
<translation id="2201661640076600072">ออกจากระบบ Browther</translation>
<translation id="3262506503470845422">รับความช่วยเหลือเกี่ยวกับ Browther</translation>
<translation id="4281844954008187215">ข้อกำหนดในการให้บริการ</translation>
<translation id="7691786510374174420">การติดตั้งล้มเหลวเนื่องจากมีข้อผิดพลาดที่ไม่ได้ระบุ หาก Browther ทำงานอยู่ในขณะนี้ โปรดปิดและลองอีกครั้ง</translation>
<translation id="6368144843345980623">ส่งออกรหัสผ่านจาก Browther</translation>
<translation id="4304713468139749426">เครื่องมือจัดการรหัสผ่าน</translation>
<translation id="4334241893986177674">ค้นหาในภาพหน้าจอนี้</translation>
<translation id="4334294535648607276">ดาวน์โหลดเสร็จสมบูรณ์</translation>
<translation id="242356249838681145">เปิด Browther เมื่อ Windows เริ่มทำงาน</translation>
<translation id="4747339441562331861">เข้าถึงฟีเจอร์ที่คุณรู้จัก ชื่นชอบ และไว้วางใจได้อย่างง่ายดายด้วยการตั้ง Browther เป็นเบราว์เซอร์เริ่มต้น ระบบจะปักหมุด Browther ไว้ที่แถบงานเพื่อให้เข้าถึงได้อย่างรวดเร็ว</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> กำหนดว่าคุณต้องอ่านและยอมรับข้อกำหนดในการให้บริการต่อไปนี้ก่อนใช้อุปกรณ์นี้ ข้อกำหนดเหล่านี้ไม่ได้ขยาย แก้ไข หรือจำกัดข้อกำหนดของ Chrome OS</translation>
<translation id="9183662282810237335">ออกจาก Browther ใช่ไหม</translation>
<translation id="4413205837991854510">แสดงทางลัดการค้นหารูปภาพเสมอ</translation>
<translation id="4065288863231444640">ให้ Browther ทำงานในพื้นหลัง</translation>
<translation id="1749140836512789834">{NUM_EXTENSIONS,plural, =1{Browther ขอแนะนำให้คุณนำออก <ph name="BEGIN_LINK"/>ดูข้อมูลเพิ่มเติมเกี่ยวกับส่วนขยายที่รองรับ<ph name="END_LINK"/>}other{Browther ขอแนะนำให้คุณนำออก <ph name="BEGIN_LINK"/>ดูข้อมูลเพิ่มเติมเกี่ยวกับส่วนขยายที่รองรับ<ph name="END_LINK"/>}}</translation>
<translation id="8148611988012584308">กำหนดค่าและควบคุม Browther</translation>
<translation id="4427306783828095590">การปกป้องที่ปรับปรุงแล้วทำได้มากกว่าบล็อกฟิชชิงและมัลแวร์</translation>
<translation id="4434353761996769206">ข้อผิดพลาดของโปรแกรมติดตั้ง: <ph name="INSTALLER_ERROR"/></translation>
<translation id="175926951572479413"><ph name="MANAGER"/> จัดการ Browther</translation>
<translation id="3579012341787637143">เพิ่มโปรไฟล์ Browther</translation>
<translation id="6786534271003695094">เกี่ยวกับ Browther สำหรับการทดสอบ</translation>
<translation id="526235294307144732">โปรดป้อนรหัสผ่านเพื่อใช้และบันทึกข้อมูล Browther ในบัญชี Browther</translation>
<translation id="4493028449971051158">ข้อผิดพลาดในการเริ่มต้น: โปรดเรียกใช้โปรแกรมติดตั้งในฐานะผู้ดูแลระบบ</translation>
<translation id="4501471624619070934">การติดตั้งล้มเหลวเนื่องจากมีการควบคุมการเข้าใช้งานในประเทศนี้</translation>
<translation id="8594994021633965927">ส่วนขยายนี้ไม่ได้เผยแพร่หลักปฏิบัติเกี่ยวกับนโยบายความเป็นส่วนตัว เช่น วิธีเก็บรวบรวมและใช้ข้อมูล Browther แนะนำให้คุณนำออก</translation>
<translation id="7084397798469173252">ยินดีต้อนรับสู่ Browther เปิดหน้าต่างเบราวเซอร์ใหม่แล้ว</translation>
<translation id="137732229629632648">Browther ต้องการสิทธิ์ในการแมปสิ่งต่างๆ รอบตัวคุณและติดตามการเคลื่อนไหวของมือ</translation>
<translation id="5036046007335188949">คุณลงชื่อเข้าใช้ด้วย <ph name="USER_EMAIL_ADDRESS"/> ในโปรไฟล์ Browther อื่นอยู่แล้ว</translation>
<translation id="1878185978731985193">Browther จะโหลดหน้าเว็บล่วงหน้าซึ่งทำให้ท่องเว็บและค้นหาได้เร็วขึ้น <ph name="BEGIN_LINK"/>ดูข้อมูลเพิ่มเติมเกี่ยวกับการโหลดหน้าเว็บล่วงหน้า<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">ช่วยให้ทุกคนบนโลกออนไลน์ปลอดภัยยิ่งขึ้นด้วยการรายงานเว็บไซต์ที่คิดว่าเป็นอันตราย</translation>
<translation id="8669339108356170796">Browther บล็อกการดาวน์โหลดนี้เนื่องจากคุณปิด Google Safe Browsing จึงยืนยันไฟล์ไม่ได้</translation>
<translation id="7583343841997441047">ลองใช้ Google Lens กับ Browther ในโทรศัพท์</translation>
<translation id="4594305310729380060">ไปยังเครื่องมือจัดการรหัสผ่านบนอุปกรณ์นี้</translation>
<translation id="3349475100979552835">แอป Browther</translation>
<translation id="4598116752460667024">ค้นหากระบวนการใดๆ จากรายการ</translation>
<translation id="4970880042055371251">เวอร์ชัน Chrome OS</translation>
<translation id="2182657378556811785">การอัปเดตใกล้จะเสร็จเรียบร้อยแล้ว เปิด Browther อีกครั้งเพื่อให้การอัปเดตเสร็จสิ้น</translation>
<translation id="6311668361877328515">เพิ่มความเร็วให้เว็บไซต์ด้วยเครื่องมือ V8 ของ Browther แต่ทำให้ Browther ต้านทานการโจมตีได้น้อยลงเล็กน้อย</translation>
<translation id="7402642357351265733">หากคุณแชร์รายงานการใช้งาน Browther ด้วย รายงานดังกล่าวจะรวม URL ที่คุณเข้าชม</translation>
<translation id="8142245354207161805">ดูเหมือนว่าโปรไฟล์กำลังถูกใช้งานโดยกระบวนการอื่นของ Browther (<ph name="PROCESS_ID"/>) บนคอมพิวเตอร์อีกเครื่อง (<ph name="HOST_NAME"/>) Browther ล็อกโปรไฟล์ไว้เพื่อไม่ให้โปรไฟล์เกิดความเสียหาย หากคุณมั่นใจว่าไม่มีกระบวนการอื่นใดกำลังใช้โปรไฟล์นี้อยู่ คุณสามารถปลดล็อกโปรไฟล์และเปิด Browther ใหม่</translation>
<translation id="4680828127924988555">ยกเลิกการติดตั้ง</translation>
<translation id="2014343159590733363">ยังไม่ได้บันทึกข้อมูล Browther บางอย่างของคุณลงในบัญชี Browther โปรดรอสักครู่ก่อนออกจากระบบ หากคุณออกจากระบบตอนนี้ ระบบจะลบข้อมูลนี้</translation>
<translation id="2408746614080689238">เมื่อลงชื่อเข้าใช้อยู่ คุณจะใช้รหัสผ่านและข้อมูลอื่นๆ จากบัญชี Browther ใน Browther ได้ โดยสามารถใช้ <ph name="SHORTCUT"/> เพื่อเปลี่ยนการตั้งค่าบริการของ Browther</translation>
<translation id="847561904663814268">ก่อนหน้านี้มีผู้ลงชื่อเข้าใช้ Browther ในคอมพิวเตอร์นี้ด้วยชื่อ <ph name="ACCOUNT_EMAIL_LAST"/> โปรดสร้างผู้ใช้ Browther ใหม่เพื่อเก็บข้อมูลแยก</translation>
<translation id="4724676981607797757">การติดตั้งไม่สำเร็จเนื่องจากเกิดข้อผิดพลาดเกี่ยวกับโปรโตคอลที่ไม่รองรับ</translation>
<translation id="3834935463915107022">ปิด Browther ใช่ไหม</translation>
<translation id="8668413672647811944">ระบบเพิ่งนำการอัปเดตความปลอดภัยพิเศษไปใช้กับ Browther รีสตาร์ทเลย แล้วเราจะคืนค่าแท็บให้คุณ</translation>
<translation id="9029438584415578308">ถาม Browther</translation>
<translation id="4941816441131888792">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Browther นำสิทธิ์เข้าถึง<ph name="PERMISSION_1"/> <ph name="PERMISSION_2"/> และอีก <ph name="COUNT"/> รายการออกแล้ว</translation>
<translation id="4823369970559443694">Browther ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดรอ 24 ชั่วโมงแล้วลองอีกครั้งหรือ<ph name="BEGIN_LINK"/>ตรวจสอบรหัสผ่านในบัญชี Browther<ph name="END_LINK"/></translation>
<translation id="215320507915280336">การดำเนินการนี้จะใช้โปรแกรมตรวจตัวสะกดแบบเดียวกับใน Brave Search ข้อความที่คุณพิมพ์ในเบราว์เซอร์จะส่งไปยัง Browther คุณปรับเปลี่ยนลักษณะการทำงานนี้ได้ทุกเมื่อในการตั้งค่า</translation>
<translation id="2899369907387169108">ใช้ Browther โดยไม่มีบัญชี</translation>
<translation id="1912973375560256099">กฎขาเข้าสำหรับ Browther เพื่ออนุญาตการเข้าชมแบบ mDNS</translation>
<translation id="711601904575862069">เปิดอีกครั้งเพื่ออัปเดต Browther</translation>
<translation id="4918086044614829423">ยอมรับ</translation>
<translation id="4918844574251943176">คัดลอกรูปภาพแล้ว</translation>
<translation id="8797356639448065696">Browther กำลังอยู่ในโหมดทำงานในพื้นหลัง</translation>
<translation id="1895567721497166950">คลิกเพื่อปิดกล่องโต้ตอบการลงชื่อเข้าใช้ Browther</translation>
<translation id="2692971232706994729">โปรไฟล์ Browther ช่วยให้คุณแยกข้อมูลต่างๆ ใน Browther ออกจากกันได้ สร้างโปรไฟล์สำหรับเพื่อนและครอบครัว หรือแยกการทำงานออกจากความบันเทิง</translation>
<translation id="7406627712452599344">ผู้เยี่ยมชมสามารถใช้ Browther โดยไม่ทิ้งร่องรอยไว้</translation>
<translation id="844471735881341044">บัญชีของคุณใน Browther</translation>
<translation id="5952898964075639679">เพิ่มตัวคุณเองใน Browther</translation>
<translation id="7995865526174204486">Gemini ใน Browther ใช้การท่องเว็บอัตโนมัติเพื่อทำงานในแท็บและดำเนินงานที่คุณมอบหมายให้เสร็จสมบูรณ์ <ph name="LINK_BEGIN"/>ดูข้อมูลเพิ่มเติม<ph name="LINK_END"/></translation>
<translation id="1204184037023366446">Browther ต้องการสิทธิ์ในการติดตามการเคลื่อนไหวของมือ</translation>
<translation id="5406591571925937375">คุณไม่ได้เข้าชมเมื่อเร็วๆ นี้ Browther นำสิทธิ์เข้าถึง<ph name="PERMISSION_1"/> <ph name="PERMISSION_2"/> และ<ph name="PERMISSION_3"/>ออกแล้ว</translation>
<translation id="5174969993834422967">คุณมักจะบล็อกการแจ้งเตือน หากต้องการให้เว็บไซต์ส่งการแจ้งเตือน ให้คลิกไอคอนการแจ้งเตือนที่มุมขวาของแถบตําแหน่ง</translation>
<translation id="5174983315706567306">มีพื้นที่ในดิสก์ไม่เพียงพอ</translation>
<translation id="8157129267754368853">บัญชี Browther ต้องมีการตรวจสอบสิทธิ์อีกครั้ง</translation>
<translation id="9078804073692109646">ไม่มีรหัสผ่านที่บันทึกไว้ Browther จะตรวจสอบรหัสผ่านได้เมื่อคุณบันทึกรหัสผ่านไว้</translation>
<translation id="6234515504547364178">ออกจากระบบ Browther</translation>
<translation id="5234764350956374838">ปิด</translation>
<translation id="5254739261293693943">ถามเกี่ยวกับวิดีโอนี้</translation>
<translation id="8586264863973514035">เปิด Browther ขึ้นมาใหม่เพื่อให้การเปลี่ยนแปลงมีผล</translation>
<translation id="5286907366254680517">ตรวจพบ</translation>
<translation id="7264453786974905915">ดาวน์โหลดแอป Browther</translation>
<translation id="6944930779012811739">บริการภายในของ Browther Updater</translation>
<translation id="5346389065299425353">เจาะลึกการค้นหาด้วยการเพิ่มแท็บ ไฟล์ และเครื่องมือหลายรายการ</translation>
<translation id="7573068992266397941">Browther พบคำแนะนำด้านความปลอดภัยบางอย่างที่คุณควรตรวจสอบ</translation>
<translation id="8174413867995118050">โปรไฟล์ Browther อื่นๆ</translation>
<translation id="7708394612738038097">คุณกำลังลงชื่อเข้าใช้ด้วยบัญชีที่จัดการ และให้การควบคุมระดับผู้ดูแลระบบของบัญชีดังกล่าวเหนือโปรไฟล์ Browther ของคุณ ข้อมูล Browther เช่น แอป บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ จะเชื่อมโยงอย่างถาวรกับ <ph name="USER_NAME"/> คุณจะสามารถลบข้อมูลนี้ผ่านทางแผงควบคุมบัญชี Browther แต่คุณจะไม่สามารถเชื่อมโยงข้อมูลนี้กับบัญชีอื่น <ph name="LEARN_MORE"/></translation>
