<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="1026101648481255140">Συνέχιση εγκατάστασης</translation>
<translation id="7099479769133613710">Επανεκκίνηση για ενημέρωση του &amp;Chrome OS</translation>
<translation id="7264054672589027446">Το Browther συνιστά να ελέγξετε αυτή την επέκταση</translation>
<translation id="7848219163187166649">Όταν ένας ιστότοπος ζητά την ιδιωτική προφόρτωση συνδέσμων στη σελίδα του, το Browther χρησιμοποιεί τους διακομιστές της Browther. Με αυτόν τον τρόπο, η ταυτότητά σας αποκρύπτεται από τον προφορτωμένο ιστότοπο, αλλά η Browther μαθαίνει ποιοι ιστότοποι προφορτώνονται.</translation>
<translation id="1065672644894730302">Δεν είναι δυνατή η ανάγνωση των προτιμήσεών σας. Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες και οι αλλαγές στις προτιμήσεις δεν θα αποθηκευτούν.</translation>
<translation id="8837164267124113709">Ο γονέας σου απενεργοποίησε την επιλογή "Άδειες για ιστοτόπους, εφαρμογές και επεκτάσεις" για το Browther</translation>
<translation id="881513728707488138">Το Browther θέλει να εξαγάγει τους κωδικούς πρόσβασής σας. Για να το επιτρέψετε αυτό, πληκτρολογήστε τον κωδικό πρόσβασης για τα Windows.</translation>
<translation id="112640046208448578">Αναγνωρίστε αντικείμενα ή μέρη και αντιγράψτε ή μεταφράστε κείμενο. Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ένα στιγμιότυπο οθόνης της σελίδας αποστέλλεται στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Το Browther είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="6580138787163923852">Για να ελέγξετε αν οι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK"/>συνδεθείτε στο Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Κάντε κλικ στο μενού του Browther</translation>
<translation id="1157985233335035034">Πρόσφατες γλώσσες</translation>
<translation id="3673786631598474384">Ο συνεργάτης <ph name="PARTNER_NAME"/> πρόσθεσε μια επέκταση που ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Η εγκατάσταση απέτυχε επειδή η έκδοση των Windows που χρησιμοποιείτε δεν υποστηρίζεται.</translation>
<translation id="8291401179516272335">Σχετικά με το Browther</translation>
<translation id="1203500561924088507">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε το πρόγραμμα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Όταν ανοίγετε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, θα αποστέλλονται αυτόματα στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Browther στο Browther. Για να αλλάξετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα Ο λογαριασμός σας στο Browther.</translation>
<translation id="9034321258761608912">Ενώ αυτή η καρτέλα ήταν ανενεργή, ελευθερώθηκε μνήμη για να παραμείνει γρήγορο το Browther. Μπορείτε να επιλέξετε να εξαιρείται πάντα αυτός ο ιστότοπος, ώστε να παραμένει ενεργός.</translation>
<translation id="249571811018731941">Το Browther απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι επικίνδυνο</translation>
<translation id="8850227089720975601">Όταν συνδέεστε σε υπηρεσίες Browther, όπως το Gmail ή το YouTube, με τον λογαριασμό <ph name="USER_EMAIL"/>, μπορείτε να συνδέεστε αυτόματα στο Browther με τον ίδιο λογαριασμό</translation>
<translation id="1290883685122687410">Σφάλμα ρύθμισης: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Ρυθμίστε το νέο σας προφίλ στο Browther</translation>
<translation id="4437862975743821367">Το Browther χρειάζεται πρόσβαση στο Bluetooth για εξερεύνηση 
 Συσκευών Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Εντοπισμός γλώσσας</translation>
<translation id="1206925267243987362">Χρήση προτεινόμενων ρυθμίσεων προγράμματος περιήγησης του Browther</translation>
<translation id="8270483548049772782">Να διαγραφούν επίσης δεδομένα από το Browther (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Καρφιτσώθηκε! Μπορείτε να αποκτήσετε ξανά πρόσβαση στην Αναζήτηση με εικόνες από το νέο κουμπί στη γραμμή εργαλείων</translation>
<translation id="1356661055722410047">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας</translation>
<translation id="1383876407941801731">Αναζήτηση</translation>
<translation id="1592588950737518481">&amp;Διαχείριση προφίλ Browther</translation>
<translation id="1404026649028693342">Να εμφανίζεται πάντα η Λειτουργία AI</translation>
<translation id="141901961143729572">Μοιραστείτε τις σκέψεις σας</translation>
<translation id="1743952081001089298">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Browther στις Ρυθμίσεις συστήματος.</translation>
<translation id="8627385813382688019">Λήψη βοήθειας για το Browther for Testing</translation>
<translation id="1497802159252041924">Σφάλμα εγκατάστασης: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Αυτή η σελίδα είναι προστατευμένη</translation>
<translation id="7252430412915798987">Μοιραστείτε μια καρτέλα του Browther</translation>
<translation id="6388429281015199562">Σύνδεση στο Browther</translation>
<translation id="1547469039832541117">Τερματίζει την επισημασμένη εργασία.</translation>
<translation id="1801944307203212016">Το Browther χρειάζεται άδεια πρόσβασης στην κάμερά σας, για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Αυτή η επέκταση δεν υποστηρίζεται πλέον. Το Browther συνιστά να την καταργήσετε.}other{Αυτές οι επεκτάσεις δεν υποστηρίζονται πλέον. Το Browther συνιστά να τις καταργήσετε.}}</translation>
<translation id="4667068923142532753">Καρφίτσωμα Browther</translation>
<translation id="3006560544901646947">Εργαλεία ασφάλειας του Browther</translation>
<translation id="686052171138185761">Το Browther θέλει να διαγράψει τα δεδομένα της Διαχείρισης κωδικών πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="8713026329083542796">Ελέγξτε σημαντικά στοιχεία ελέγχου για το απόρρητο και την ασφάλεια στο Browther</translation>
<translation id="1640672724030957280">Γίνεται λήψη…</translation>
<translation id="1680687534629375545">Ερώτηση στην Αναζήτηση με εικόνες σχετικά με αυτή τη σελίδα</translation>
<translation id="1709772298389099340">Παρέχει αναβαθμισμένα προνόμια για το <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Στο πλαίσιο της βελτίωσης αυτών των λειτουργιών, το Browther στέλνει στην Browther τις αλληλεπιδράσεις σας με τις λειτουργίες. Αυτά τα δεδομένα ενδέχεται να αναγνωστούν, να υποβληθούν σε επεξεργασία και να σχολιαστούν από αναθεωρητές.</translation>
<translation id="1722488837206509557">Αυτό θα σας επιτρέψει να επιλέγετε μία από τις διαθέσιμες συσκευές και να προβάλλετε περιεχόμενο σε αυτήν.</translation>
<translation id="6820510278633522408">Το Browther θα διαγράψει σύντομα τα δεδομένα περιήγησης</translation>
<translation id="7775028004939172516">Το Browther θα προσπαθήσει να αναβαθμίσει τις πλοηγήσεις σε HTTPS</translation>
<translation id="6963959729951758069">Διαγρ. δεδ. Browther</translation>
<translation id="4085139922884095932">Θα γίνει επανεκκίνηση του Browther σε <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Όταν δεν είναι διαθέσιμο το HTTPS, το Browther θα χρησιμοποιεί μια μη ασφαλή σύνδεση χωρίς να σας ειδοποιεί</translation>
<translation id="3975328336074677101">Να επιτρέπεται στο Browther να εκτελείται στο παρασκήνιο</translation>
<translation id="2497443204974841650">Επανεγκατάσταση του Browther</translation>
<translation id="1724309687045787742">Το Browther προσπαθεί να <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Την επόμενη φορά που θα ανοίξετε το Browther στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για χρήση της Διαχείρισης κωδικών πρόσβασης Browther.</translation>
<translation id="1838374766361614909">Διαγραφή αναζητήσεων</translation>
<translation id="2337233040802538155">Για να διαγράψετε τα δεδομένα περιήγησης μόνο από αυτή τη συσκευή και να τα διατηρήσετε στον Λογαριασμό σας Browther, <ph name="BEGIN_LINK"/>αποσυνδεθείτε από το Browther<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Κατεβάστε το Browther στο τηλέφωνό σας για άνοιγμα ή δημιουργία νέων ομάδων καρτελών εν κινήσει.</translation>
<translation id="2063443520349987970">Μπορείτε να διαχειριστείτε τους συνδεδεμένους Λογαριασμούς σας Browther. Οι Λογαριασμοί σας Browther χρησιμοποιούνται για το πρόγραμμα περιήγησης Browther, το Play Store, το Gmail κ.ά. Εάν θέλετε να προσθέσετε έναν λογαριασμό για κάποιο άλλο άτομο, όπως για ένα μέλος της οικογένειας, προσθέστε, αντ' αυτού, ένα νέο άτομο στη συσκευή σας <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Μάθετε περισσότερα<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Αναζητήστε με την Αναζήτηση με εικόνες</translation>
<translation id="1880677175115548835">Επιλογή κειμένου</translation>
<translation id="3183933389992069620">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Browther. Τα δεδομένα σας στο Browther, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Browther, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. Αν θέλετε, μπορείτε να δημιουργήσετε ένα νέο προφίλ στο οποίο θα διατηρηθούν ξεχωριστά τα υπάρχοντα δεδομένα του Browther. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Το Browther εξοικονομεί μπαταρία περιορίζοντας τη δραστηριότητα στο παρασκήνιο και τα οπτικά εφέ, όπως είναι η ομαλή κύλιση και οι ρυθμοί καρέ βίντεο. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με την Εξοικονόμηση ενέργειας<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Ρωτήστε σχετικά με αυτή τη σελίδα</translation>
<translation id="9128006428501241840">Υπηρεσία Browther Updater</translation>
<translation id="6302815314157879372">Με την απενεργοποίηση αυτής της λειτουργίας, μπορείτε να συνδεθείτε σε ιστοτόπους Browther, όπως το Gmail, χωρίς να συνδεθείτε στο Browther</translation>
<translation id="1063611196035804685">Το Browther δεν ανταποκρίνεται. Να γίνει επανεκκίνηση τώρα;</translation>
<translation id="2873360330889594383">Ο οργανισμός σας, <ph name="MANAGER"/>, απαιτεί να συνδεθείτε στο Browther</translation>
<translation id="4035053306113201399">Για να εφαρμοστεί η ενημέρωση, πρέπει να γίνει επανεκκίνηση του Chrome OS.</translation>
<translation id="2861285003831382718">Το Browther απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του τύπου αρχείου και ενδέχεται να είναι επικίνδυνος</translation>
<translation id="1953553007165777902">Λήψη… Απομένουν <ph name="MINUTE"/> λεπτά</translation>
<translation id="2080160985220483492">Συμβουλή για το Browther: Αποθήκευση κωδικών πρόσβασης</translation>
<translation id="8037497710694492565">Το Browther δεν μπορεί να καθορίσει ή να ορίσει το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="7395009124247513849">Μάθετε γιατί το Browther αποκλείει ορισμένα αρχεία, ανοίγει σε νέα καρτέλα</translation>
<translation id="762710512520170632">Διατηρεί το λογισμικό Browther ενημερωμένο. Εάν αυτή η υπηρεσία απενεργοποιηθεί ή σταματήσει, το λογισμικό Browther δεν θα ενημερώνεται, πράγμα που σημαίνει ότι δεν θα είναι δυνατή η επιδιόρθωση ευπαθειών ασφάλειας που μπορεί να εμφανιστούν και μπορεί να μη λειτουργούν ορισμένα χαρακτηριστικά. Η εγκατάσταση της υπηρεσίας αυτής καταργείται αυτόματα, όταν δεν υπάρχει λογισμικό Browther που να τη χρησιμοποιεί.</translation>
<translation id="5793588180426267429">Με αυτή την ενέργεια θα διαγραφεί 1 στοιχείο από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Browther ως <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Αποτυχία εγκατάστασης. Δοκιμάστε ξανά.</translation>
<translation id="6351516710581760512">Για να ελέγξετε αν οι άλλοι κωδικοί πρόσβασής σας είναι ασφαλείς από παραβιάσεις δεδομένων και άλλα ζητήματα ασφαλείας, <ph name="BEGIN_LINK"/>συνδεθείτε στο Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Ρυθμίσεις.</translation>
<translation id="8194525816714210105">Επιλέξτε αν θέλετε να συμπεριλαμβάνεται το ιστορικό Browther για πιο εξατομικευμένες εμπειρίες στις υπηρεσίες Browther.</translation>
<translation id="5909559127548969159">Κάντε κλικ στο κουμπί Προσαρμογή Browther στη σελίδα Νέα καρτέλα, για να δώσετε μια νέα εμφάνιση στο Browther</translation>
<translation id="2066690553719545730">Να εμφανίζεται πάντα η Λειτουργία AI</translation>
<translation id="3283892260110318935">Το Browther απέκλεισε αυτή τη λήψη επειδή το αρχείο είναι παραπλανητικό και μπορεί να κάνει μη αναμενόμενες αλλαγές στη συσκευή σας</translation>
<translation id="6160571936643742128">Την επόμενη φορά που θα ανοίξετε το Browther iOS, θα δείτε μια προτροπή για να δοκιμάσετε τη λειτουργία <ph name="FEATURE_NAME"/>.</translation>
<translation id="8380517409933452343">Οι κωδικοί πρόσβασης και άλλα δεδομένα του Browther που αποθηκεύσατε στον Λογαριασμό σας Browther θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Browther, συνδεθείτε ξανά.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Browther δεν χρησιμοποιείται για 1 λεπτό. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}other{Ο οργανισμός σας διαγράφει αυτόματα τα δεδομένα περιήγησης όταν το Browther δεν χρησιμοποιείται για # λεπτά. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις. Οι καρτέλες σας θα παραμείνουν ανοιχτές.}}</translation>
<translation id="2126108037660393668">Η επιβεβαίωση του ληφθέντος αρχείου απέτυχε.</translation>
<translation id="2135919691573380097">Αναφορά αυτού του ιστοτόπου</translation>
<translation id="2137162749895930932">Κλείσιμο οθόνης μετάφρασης</translation>
<translation id="4283559398694996391">Το Browther απέκλεισε αυτή τη λήψη επειδή ο ιστότοπος δεν χρησιμοποιεί ασφαλή σύνδεση και το αρχείο μπορεί να έχει παραβιαστεί</translation>
<translation id="2170098639895543546">Επιλέξτε οτιδήποτε στη σελίδα</translation>
<translation id="2495182092286337191">Προσαρμογή του Browther</translation>
<translation id="2174917724755363426">Η εγκατάσταση δεν έχει ολοκληρωθεί. Είστε βέβαιοι ότι θέλετε να την ακυρώσετε;</translation>
<translation id="4877141231724140862">Browther - Σύνδεση δικτύου - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Σφάλμα ελέγχου για ενημερώσεις: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Κατάργηση λογαριασμού από το Browther</translation>
<translation id="1084363153644366288">Παραμείνετε ασφαλείς εν κινήσει με τη Βελτιωμένη Ασφαλή περιήγηση στο Browther για iOS</translation>
<translation id="7949164640723239455">Επικίνδυνος ιστότοπος. Το Browther κατάργησε ειδοποιήσεις.</translation>
<translation id="2236949375853147973">Η δραστηριότητά μου</translation>
<translation id="4536403809133456417">Για να έχετε πρόσβαση στις διευθύνσεις σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Browther. Αυτή η διεύθυνση θα αποθηκευτεί στον Λογαριασμό σας Browther μετά τη σύνδεσή σας.</translation>
<translation id="5627930103267312171">Αν χρησιμοποιείτε έναν υπολογιστή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Browther ακριβώς όπως θέλουν.</translation>
<translation id="2283803047247799269">Αναζήτηση σε αυτή την καρτέλα με την Αναζήτηση με εικόνες</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Το Browther συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Browther συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="2307973900865360088">Διατήρηση στο Dock</translation>
<translation id="5161617112768367959">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Browther. Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Browther μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση.</translation>
<translation id="4123094831918713833">Αυτή η ενέργεια:
          <ph name="LINE_BREAKS"/>
           • Θα επαναφέρει ορισμένες ρυθμίσεις και συντομεύσεις του Browther
           <ph name="LINE_BREAK"/>
           • Θα απενεργοποιήσει τις επεκτάσεις
           <ph name="LINE_BREAK"/>
           • Θα διαγράψει τα cookie και τα άλλα προσωρινά δεδομένα ιστοτόπων
            <ph name="LINE_BREAKS"/>
           Οι σελιδοδείκτες, το ιστορικό και οι αποθηκευμένοι κωδικοί πρόσβασης δεν θα επηρεαστούν.</translation>
<translation id="5456070119344236353">Για να στείλετε από εδώ έναν αριθμό στο τηλέφωνό σας Android, συνδεθείτε στο Browther και στις δύο συσκευές.</translation>
<translation id="2356070529366658676">Να γίνεται ερώτηση</translation>
<translation id="2359808026110333948">Συνέχεια</translation>
<translation id="6468415397021485143">Η επέκταση <ph name="EXTENSION_NAME"/> θέλει να συνδεθείτε στο Browther</translation>
<translation id="2558600429878197587">Απενεργοποίηση του Browther, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="5295781918312989856">Για να χρησιμοποιήσετε αυτή την επέκταση με τον λογαριασμό <ph name="USER_EMAIL_ADDRESS"/>, συνδεθείτε στο Browther.</translation>
<translation id="8418845734693287262">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή τα στοιχεία σύνδεσης του λογαριασμού σας δεν είναι ενημερωμένα.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Browther}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή HID από μία ή περισσότερες επεκτάσεις Browther}other{Αποκτήθηκε πρόσβαση σε # συσκευές HID από μία ή περισσότερες επεκτάσεις Browther}}</translation>
<translation id="434258293817844111">Το Browther χρειάζεται άδεια μικροφώνου και κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="2403703063067034158">Σφάλμα εκκίνησης: Αυτή τη στιγμή εκτελείται μια άλλη παρουσία της ρύθμισης. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="5458993228789433099">Ανοίξτε συνδέσμους στο Browther από οποιαδήποτε εφαρμογή και διατηρήστε το πρόγραμμα περιήγησης προσβάσιμο στη γραμμή εργαλείων</translation>
<translation id="1677640217693742525">Με τα <ph name="BEGIN_LINK"/>εργαλεία του Browther<ph name="END_LINK"/>, μπορείτε να περιηγείστε με ασφάλεια και να διατηρείτε τον έλεγχο</translation>
<translation id="2451727308784734061">Χρησιμοποιήστε τη συντόμευση για να μεταβείτε γρήγορα στον Διαχειριστή κωδικών πρόσβασης. Μπορείτε να μετακινήσετε τη συντόμευση στην αρχική οθόνη ή στην εφαρμογή εκκίνησης του υπολογιστή.</translation>
<translation id="2280315911954332435">Το Browther θα κλείσει σύντομα</translation>
<translation id="6410820860979094113">Στο Browther</translation>
<translation id="2485422356828889247">Απεγκατάσταση</translation>
<translation id="2513154137948333830">Απαιτείται επανεκκίνηση: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Επιλογή κειμένου με την Αναζήτηση με εικόνες</translation>
<translation id="7892218991241200190">Το Browther προσπαθεί να αντικαταστήσει τους υπάρχοντες κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασης των Windows για να επιτρέψετε αυτή την ενέργεια.</translation>
<translation id="8976443723926188033">Το Browther χρειάζεται πρόσβαση στον αποθηκευτικό χώρο για τη λήψη αρχείων</translation>
<translation id="1973587471928846950">Πρόγραμμα βοήθειας Browther</translation>
<translation id="2575822587468774919">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="8705561858232289221">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Browther</translation>
<translation id="437162022240011372">Συνέχεια χρήσης του Browther</translation>
<translation id="259935314519650377">Απέτυχε η αποθήκευση του ληφθέντος προγράμματος εγκατάστασης στην κρυφή μνήμη. Σφάλμα: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Σύστημα</translation>
<translation id="2907676829052962091">Ο οργανισμός σας μπορεί να βλέπει και να διαχειρίζεται τα δεδομένα περιήγησης, όπως σελιδοδείκτες, ιστορικό και κωδικούς πρόσβασης. Δεν μπορεί να βλέπει τα δεδομένα περιήγησης σε άλλα προφίλ στο Browther</translation>
<translation id="1289116577679005654">Επαληθεύστε την ταυτότητά σας, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7192278346779151664">Παρουσιάστηκε σφάλμα στο λειτουργικό σύστημα κατά την εγκατάσταση. Κατεβάστε το Browther ξανά.</translation>
<translation id="7724398260867885339">Εάν χρησιμοποιείτε μια συσκευή από κοινού με άλλα άτομα, οι φίλοι και τα μέλη της οικογένειάς σας μπορούν να περιηγούνται αυτόνομα και να ρυθμίζουν το Browther ακριβώς όπως θέλουν.</translation>
<translation id="1679595317134614424">Καρτέλα Browther</translation>
<translation id="7189168846924379421">Για επιπλέον ασφάλεια, το Browther θα κρυπτογραφήσει τα δεδομένα σας.</translation>
<translation id="4052643592793184278">Για να καταργήσετε τον Λογαριασμό σας Browther από το Browther, αποσυνδεθείτε</translation>
<translation id="7694616023994438906">Για να έχετε πρόσβαση στους κωδικούς πρόσβασης, στους σελιδοδείκτες και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Browther</translation>
<translation id="2738871930057338499">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 403 Forbidden. Ελέγξτε τη διαμόρφωση των παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="2753623023919742414">Κάντε κλικ για αναζήτηση</translation>
<translation id="9078193405195503710">Ορισμός του Browther ως προεπιλεγμένου προγράμματος προβολής PDF</translation>
<translation id="2456995288904753506">Το Browther μπορεί να συμπληρώνει αυτόματα δύσκολα πεδία που η βασική αυτόματη συμπλήρωση μπορεί να παραλείπει</translation>
<translation id="3271730304285122987">Αυτή η επέκταση περιέχει κακόβουλο πρόγραμμα και δεν είναι ασφαλής. Καταργήστε την από το Browther, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="2799223571221894425">Επανεκκίνηση</translation>
<translation id="1427337251963884503">Το δικό σας Browther</translation>
<translation id="2816462166102338036">Αναζήτηση αυτού του βίντεο με την Αναζήτηση με εικόνες</translation>
<translation id="2841525013647267359">Μετάφραση από</translation>
<translation id="2846251086934905009">Σφάλμα εγκατάστασης: Το πρόγραμμα εγκατάστασης δεν ολοκληρώθηκε. Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="928966105228355994">Κατάργηση από το Browther…</translation>
<translation id="587805782197019018">Διατηρεί την ασφάλειά σας στο Browther και μπορεί να χρησιμοποιηθεί για τη βελτίωση της ασφάλειάς σας σε άλλες εφαρμογές Browther όταν είστε συνδεδεμένοι.</translation>
<translation id="2885378588091291677">Διαχείριση εργασιών</translation>
<translation id="3055995278166070443">Σχετικά με το &amp;Browther</translation>
<translation id="2915996080311180594">Επανεκκίνηση αργότερα</translation>
<translation id="2928420929544864228">Η εγκατάσταση ολοκληρώθηκε.</translation>
<translation id="70453521937551896">Τα δεδομένα σας κρυπτογραφούνται με τη φράση πρόσβασης. Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον Λογαριασμό σας Browther.</translation>
<translation id="2945997411976714835">Σφάλμα εγκατάστασης: Απέτυχε η εκκίνηση της διεργασίας του προγράμματος εγκατάστασης.</translation>
<translation id="3188308520233701133">Συνδεθείτε πιο γρήγορα σε ιστοτόπους χρησιμοποιώντας αποθηκευμένους κωδικούς πρόσβασης για το Browther σε iOS</translation>
<translation id="8145318807880784886">Προσθέστε ένα νέο προφίλ Browther για να διατηρείτε ξεχωριστούς τους σελιδοδείκτες, τους κωδικούς πρόσβασης και τις ρυθμίσεις.</translation>
<translation id="4330268530227888227">Ο οργανισμός σας διαχειρίζεται το Browther</translation>
<translation id="6488090896442998436">Το Browther έχει ενημερωθεί</translation>
<translation id="300557164611864786">Εάν ένας ιστότοπος προσπαθήσει να υποκλέψει τον κωδικό πρόσβασής σας ή όταν κατεβάζετε ένα επιβλαβές αρχείο, το Browther μπορεί επίσης να στείλει URL, καθώς και τμήματα του περιεχομένου της σελίδας, στην Ασφαλή περιήγηση</translation>
<translation id="2447145782593796785">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, συνδέσου στο Browther</translation>
<translation id="3003694935412297923">Όλες οι εργασίες</translation>
<translation id="7554113777150891030">{count,plural, =1{Το Browther πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Browther και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Το Browther πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Browther και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="5522228731050510047">Άνοιγμα της διεύθυνσης <ph name="URL"/> σε νέα καρτέλα στο Browther.</translation>
<translation id="6358780591055960280">Το Browther δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="1386422761453740126">Προσθήκη στο Browther…</translation>
<translation id="3038232873781883849">Αναμονή για εγκατάσταση…</translation>
<translation id="3045032126857188731">Γλώσσα μετάφρασης: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Κλείσιμο παραθύρου διαλόγου σχολίων</translation>
<translation id="369127628511662602">Άλλα προφίλ Browther</translation>
<translation id="2370255879896574713">Βοηθήστε μας να κάνουμε το Browther καλύτερο, αποστέλλωντας αναφορές σφαλμάτων και <ph name="UMA_LINK"/> στην Browther</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Browther}=1{Αποκτήθηκε πρόσβαση σε 1 συσκευή USB από μία ή περισσότερες επεκτάσεις Browther}other{Αποκτήθηκε πρόσβαση σε # συσκευές USB από μία ή περισσότερες επεκτάσεις Browther}}</translation>
<translation id="2065456480740480340">Ιστορικό Browther</translation>
<translation id="5011660649081947055">Η αποσυμπίεση του αρχείου από το πρόγραμμα εγκατάστασης απέτυχε. Κατεβάστε το Browther ξανά.</translation>
<translation id="310459126943037700">Ο τερματισμός των εργασιών απέτυχε.</translation>
<translation id="3104828284009500087">Αναζητήστε οτιδήποτε στη σελίδα</translation>
<translation id="4917564010081457061">Διατηρήστε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και το ιστορικό σας σε πλήρη συγχρονισμό σε όλες τις συσκευές. Αποκτήστε εύκολα πρόσβαση στις λειτουργίες που γνωρίζετε και αγαπάτε, ορίζοντας το Browther ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="1041472930719344928">Το Browther χρησιμοποιεί το μικρόφωνό σας.</translation>
<translation id="3130333203120345554">Νέα αναζήτηση</translation>
<translation id="3137969841538672700">Σύρετε για αναζήτηση</translation>
<translation id="5312717254055363883">Αυτή η καρτέλα χρησιμοποιεί επιπλέον πόρους. Για να βελτιώσετε την απόδοση, επιτρέψτε στο Browther να την απενεργοποιήσει.</translation>
<translation id="373523409348786203">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Browther στις Ρυθμίσεις συστήματος</translation>
<translation id="802113445299754598">Επανεκκίνηση Browther</translation>
<translation id="3161522574479303604">Όλες οι γλώσσες</translation>
<translation id="4522189060330781648">Κάποιο άλλο πρόγραμμα στον υπολογιστή σας πρόσθεσε ένα θέμα, το οποίο ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">Προσαρμόστε το νέο σας προφίλ Browther</translation>
<translation id="5150830326120505481">Για να καταργήσετε τον Λογαριασμό σας Browther από το Browther, αποσυνδεθείτε από το Browther στη σελίδα Ρυθμίσεις</translation>
<translation id="7113660200899017820">Αργότερα, το Browther μπορεί να σας ρωτήσει αν θέλετε να χρησιμοποιήσετε τα αποθηκευμένα στοιχεία για την αυτόματη συμπλήρωση φορμών για εσάς</translation>
<translation id="4475011322243623412">Το Browther δεν έχει δυνατότητα ανάγνωσης και εγγραφής στον κατάλογο δεδομένων του:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Άμεση επανεκκίνηση</translation>
<translation id="3536063527222598206">Λείπουν κλειδιά του Browther API. Ορισμένες λειτουργίες του Browther Browther θα απενεργοποιηθούν.</translation>
<translation id="1011450868746766298">Να συνεχίζεται η εκτέλεση εφαρμογών παρασκηνίου όταν το Browther είναι κλειστό</translation>
<translation id="179611081153855734">Το Browther θα σας ειδοποιεί πριν από τη φόρτωση ιστοτόπων με μη ασφαλή σύνδεση</translation>
<translation id="8965591964936552871">Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Browther, εκτός από τον Λογαριασμό σας Browther εάν είστε συνδεδεμένοι στο Browther. Για να επιτρέψετε στους ιστοτόπους να απομνημονεύουν τα στοιχεία σας, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Η προεπιλεγμένη μηχανή αναζήτησης άλλαξε από άλλο πρόγραμμα εκτός του Browther. Για την προστασία σας, το Browther την επανέφερε.</translation>
<translation id="1170501833661894915">Συνδεθείτε στο Browther, για να έχετε τους κωδικούς πρόσβασης, τους σελιδοδείκτες και άλλα στοιχεία σε όλες τις συσκευές σας</translation>
<translation id="3352986031709923790">επάνω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT"/>%, επάνω <ph name="TOP"/>%</translation>
<translation id="120745000989996104">Δεδομένα Browther στον λογαριασμό σας</translation>
<translation id="3369405342922656244">Αναζήτηση αυτής της σελίδας με την Αναζήτηση με εικόνες</translation>
<translation id="7173761126541905083">Χρησιμοποιήστε τους κωδικούς πρόσβασης με το Browther στο τηλέφωνό σας</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="5266583242423616945">Εναλλαγή σε υπάρχον προφίλ Browther;</translation>
<translation id="3412460710772753638">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="4282363917570905631">Επεκτείνετε τη Βελτιωμένη Ασφαλή περιήγηση με το Browther στο τηλέφωνό σας</translation>
<translation id="986094398735583155">Προσαρμογή του Browther…</translation>
<translation id="3266047225484320321">Το Browther θα σας ειδοποιήσει όταν συνδεθείτε με έναν παραβιασμένο κωδικό πρόσβασης.</translation>
<translation id="3508047337876211050">Με αυτή την ενέργεια θα διαγραφούν <ph name="ITEMS_COUNT"/> στοιχεία από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Browther ως <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">Με τη συντόμευση <ph name="SHORTCUT"/> μπορείτε να κάνετε εναλλαγή μεταξύ των προφίλ Browther</translation>
<translation id="7225005776233199285">Κλείστε όλα τα παράθυρα του Browther και δοκιμάστε ξανά.</translation>
<translation id="5465054931427475969">Για να μοιραστείτε το παράθυρό σας, επιτρέψτε την εγγραφή οθόνης για το Browther στις Ρυθμίσεις συστήματος</translation>
<translation id="6905469223518185641">Ο χρήστης <ph name="EXISTING_USER"/> είναι ήδη συνδεδεμένος.  Για να διατηρήσετε ξεχωριστά την περιήγησή σας, συνδεθείτε στο Browther με το δικό σας προφίλ ως <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">Για να μοιραστείτε την οθόνη σας, επιτρέψτε την εγγραφή οθόνης για το Browther στις Ρυθμίσεις συστήματος.</translation>
<translation id="3597003331831379823">Απέτυχε η εκτέλεση της ρύθμισης με αναβαθμισμένα προνόμια. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Σύνδεση στο Browther</translation>
<translation id="2492221622209669678">Τα δεδομένα περιήγησης αυτού του ατόμου θα διαγραφούν από αυτήν τη συσκευή. Για να επαναφέρετε τα δεδομένα, συνδεθείτε στο Browther ως <ph name="USER_EMAIL"/>.</translation>
<translation id="6793778233257855801">Για να στείλετε έναν αριθμό από το <ph name="ORIGIN"/> στο τηλέφωνό σας Android, συνδεθείτε στο Browther και στις δύο συσκευές.</translation>
<translation id="3667616615096815454">Δεν είναι δυνατή η εγκατάσταση, ο διακομιστής δεν γνωρίζει την εφαρμογή.</translation>
<translation id="5585500151754164442">Χρησιμοποιήστε τη <ph name="BEGIN_LINK"/>δική σας φράση πρόσβασης<ph name="END_LINK"/> για την κρυπτογράφηση όλων των δεδομένων Browther στον Λογαριασμό σας Browther. Οι τρόποι και οι διευθύνσεις πληρωμής από το Google Pay δεν θα κρυπτογραφούνται. Το ιστορικό περιήγησης από το Browther δεν θα συγχρονίζεται.</translation>
<translation id="404323216042159951">Το Browther δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε να ελέγξετε τη σύνδεσή σας στο διαδίκτυο.</translation>
<translation id="5004936474632127765">Άνοιγμα συνδέσμου σε νέα καρτέ&amp;λα Browther</translation>
<translation id="6236643159256182256">Σύνδεση του Browther και άλλων υπηρεσιών Browther για εξατομίκευση και για άλλους σκοπούς</translation>
<translation id="3729187154190517324">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία, χρησιμοποιώντας το κουμπί "Προσθήκη καρτέλας και άλλων".</translation>
<translation id="1400697664933775238">Διαχείριση προφίλ Browther</translation>
<translation id="2461315395128103158">Μάθετε γιατί το Browther αποκλείει ορισμένες λήψεις</translation>
<translation id="8058420662026104226">Το Browther θα σας ενημερώσει σε περίπτωση που χρειαστεί να ελέγξετε κάτι</translation>
<translation id="3177448557921912221">Τα προφίλ του Browther σας βοηθούν να διαχωρίσετε διαφορετικές πτυχές της ζωής σας. Προσθέστε ένα νέο προφίλ τώρα.</translation>
<translation id="1541177876035612043">Το Browther προφορτώνει σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνονται πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="3810973564298564668">Διαχείριση</translation>
<translation id="1117103475254549453">Για να χρησιμοποιήσετε τους αποθηκευμένους κωδικούς πρόσβασης, ακολουθήστε τον σύνδεσμο του κωδικού QR, κατεβάστε το Browther για iOS και συνδεθείτε στον Λογαριασμό σας Browther</translation>
<translation id="8880695882192156860">Συμβουλή για το Browther: Βελτιωμένη Ασφαλής περιήγηση</translation>
<translation id="3846683726093018685">**Δημιουργήστε μια σύνοψη:** Σε μία πρόταση με λιγότερες από 30 λέξεις, περιγράψτε το κύριο θέμα και τον σκοπό του περιεχομένου στο στιγμιότυπο οθόνης.

          **Προτείνετε ερωτήσεις:** Δημιουργήστε μια λίστα με κουκκίδες με 3-5 ερωτήσεις που θα μπορούσε να κάνει ένας χρήστης για να κατανοήσει καλύτερα το στιγμιότυπο οθόνης. Αυτές οι ερωτήσεις πρέπει να περιλαμβάνουν τουλάχιστον μία η οποία θα αφορά συγκεκριμένα ένα οπτικό αντικείμενο, τον σχεδιασμό ή την τοποθέτησή του.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">Εργαλείο επιλογής γλώσσας</translation>
<translation id="4861846616763552424">Προσαρμογή και έλεγχος του Browther. Θα πρέπει να ελέγξετε μια ειδοποίηση, κάντε κλικ για λεπτομέρειες.</translation>
<translation id="6126366281251241386">Κάντε κλικ στο όνομά σας, για να ανοίξετε το Browther και να ξεκινήσετε την περιήγηση.</translation>
<translation id="3892148308691398805">Αντιγραφή κειμένου</translation>
<translation id="3760801273210219822">Ο χρήστης <ph name="EXISTING_USER"/> είναι συνδεδεμένος ήδη με αυτό το προφίλ Browther. Για να διατηρήσει ξεχωριστά την περιήγησή σας, το Browther μπορεί να δημιουργήσει το προφίλ σας για εσάς.</translation>
<translation id="3821553157234855663">Π&amp;ροσαρμογή του Browther</translation>
<translation id="3941890832296813527">Σφάλμα εγκατάστασης: Το όνομα αρχείου του προγράμματος εγκατάστασης δεν είναι έγκυρο ή δεν υποστηρίζεται.</translation>
<translation id="6482299900191767005">Το Browther προσπαθεί να αντιγράψει κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="5853011008278898603">Οι κωδικοί πρόσβασης, οι τρόποι πληρωμής και οι διευθύνσεις που αποθηκεύσατε στον Λογαριασμό σας Browther θα καταργηθούν από αυτή τη συσκευή. Για να τα χρησιμοποιήσετε ξανά στο Browther, συνδεθείτε ξανά.</translation>
<translation id="395904275706073188">Δεν είναι δυνατή η ανάγνωση προστατευμένων σελίδων. Δοκιμάστε διαφορετική σελίδα.</translation>
<translation id="1832973663231751701">Μάθετε πώς σας προστατεύει το Browther</translation>
<translation id="4531502594774670767">Όταν πληκτρολογείτε στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Browther στέλνει αυτό που πληκτρολογείτε στα εργαλεία αναζήτησης, AI και agent του οργανισμού σας για να λάβει προτάσεις.</translation>
<translation id="300013383485253006">Σχετικά με το &amp;Browther for Testing</translation>
<translation id="1152920704813762236">Σχετικά με το Chrome OS</translation>
<translation id="8126752030994997015">Όταν επισκέπτεστε έναν ιστότοπο, το Browther στέλνει ένα παραμορφωμένο τμήμα του URL στην <ph name="BEGIN_LINK"/>Ασφαλή περιήγηση Browther<ph name="END_LINK"/> μέσω ενός διακομιστή απορρήτου που αποκρύπτει τη διεύθυνση IP σας. Εάν ένας ιστότοπος κάνει κάτι ύποπτο, αποστέλλονται επίσης πλήρη URL και τμήματα περιεχομένου της σελίδας.</translation>
<translation id="3703994572283698466">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>, όπως είναι το <ph name="BEGIN_LINK_LINUX_OSS"/>περιβάλλον ανάπτυξης Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Μετάφραση οθόνης</translation>
<translation id="4023601594785368013">Αρχική γλώσσα: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Ανοίξτε συνδέσμους στο Browther από οποιαδήποτε εφαρμογή. Επιπλέον, για εύκολη πρόσβαση, καρφιτσώνεται στη γραμμή εργαλείων.</translation>
<translation id="3437506136408403836">Συμβάλετε στη βελτίωση του Browther, αναφέροντας τις <ph name="BEGIN_LINK"/>τρέχουσες ρυθμίσεις<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Στην πιο πρόσφατη έκδοση διατίθενται σημαντικές βελτιώσεις ασφάλειας και νέες λειτουργίες.</translation>
<translation id="4055805654398742145">Δ&amp;ιαχειριστής κωδικών πρόσβασης</translation>
<translation id="2164947358785939495">Κάποιο άλλο πρόγραμμα στον υπολογιστή σας πρόσθεσε μια επέκταση, η οποία ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Browther όταν δεν χρησιμοποιείται για 1 λεπτό. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}other{Ο οργανισμός σας κλείνει αυτόματα το Browther όταν δεν χρησιμοποιείται για # λεπτά. Τα δεδομένα περιήγησης διαγράφονται. Σε αυτά περιλαμβάνονται το ιστορικό, η αυτόματη συμπλήρωση και οι λήψεις.}}</translation>
<translation id="1535413545339990419">Μετάβαση στη σελίδα Σχετικά με το Browther</translation>
<translation id="692283249649018289">Προσαρμόστε το Browther για να δώσετε μια νέα εμφάνιση στο πρόγραμμα περιήγησης</translation>
<translation id="6375229634133804834">Π&amp;ροσαρμογή του Browther</translation>
<translation id="4148957013307229264">Γίνεται εγκατάσταση...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου - Browther</translation>
<translation id="2911246138082876798">Ανακαλύψτε καταπληκτικές εφαρμογές, παιχνίδια, επεκτάσεις και θέματα για το Browther.</translation>
<translation id="2528977475313334293">Για να λάβετε αυτή την επέκταση και άλλα στοιχεία σε όλους τους υπολογιστές σας, συνδεθείτε στο Browther</translation>
<translation id="8244267655940711467">Για να είσαι πιο ασφαλής στο διαδίκτυο με τις επιλογές του γονέα σου, επίλεξε το προφίλ Browther στο οποίο έχεις ήδη συνδεθεί ως <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Ακύρωση…</translation>
<translation id="4224210481850767180">Η εγκατάσταση ακυρώθηκε.</translation>
<translation id="8219359042845534271">Να συνδεθούν τα δεδομένα σας στο Browther με αυτόν το λογαριασμό;</translation>
<translation id="5520777668172961882">Σας προειδοποιεί για επικίνδυνους ιστοτόπους, ακόμα και για όσους δεν γνώριζε η Browther στο παρελθόν, αναλύοντας περισσότερα δεδομένα από ιστοτόπους σε σχέση με την βασική προστασία. Μπορείτε να επιλέξετε να παραβλέψετε τις ειδοποιήσεις του Browther.</translation>
<translation id="2014920019837536689">Αποσύνδεση από το Browther</translation>
<translation id="4341512411059715879">Λήψη βοήθειας σχετικά με το Browther</translation>
<translation id="4281844954008187215">Όροι Παροχής Υπηρεσιών</translation>
<translation id="322492684764924424">Η εγκατάσταση απέτυχε λόγω απροσδιόριστου σφάλματος. Εάν το Browther εκτελείται αυτήν τη στιγμή, κλείστε το και δοκιμάστε ξανά.</translation>
<translation id="3813060261346666066">Εξαγωγή κωδικών πρόσβασης από το Browther</translation>
<translation id="4304713468139749426">Διαχείριση κωδικών πρόσβασης</translation>
<translation id="4334241893986177674">Αναζήτηση αυτού του στιγμιότυπου οθόνης</translation>
<translation id="4334294535648607276">Η λήψη ολοκληρώθηκε.</translation>
<translation id="2177954934431828302">Άνοιγμα του Browther κατά την εκκίνηση των Windows</translation>
<translation id="2472318668926455009">Αποκτήστε εύκολη πρόσβαση στις λειτουργίες που γνωρίζετε, αγαπάτε και εμπιστεύεστε, ορίζοντας το Browther ως το προεπιλεγμένο πρόγραμμα περιήγησης. Το Browther θα καρφιτσωθεί στη γραμμή εργαλείων για γρήγορη πρόσβαση.</translation>
<translation id="1068681683510904753">Το <ph name="MANAGER"/> απαιτεί να διαβάσετε και να αποδεχτείτε τους παρακάτω Όρους Παροχής Υπηρεσιών πριν από τη χρήση αυτής της συσκευής. Οι συγκεκριμένοι όροι δεν επεκτείνουν, τροποποιούν ή περιορίζουν τους Όρους του Chrome OS.</translation>
<translation id="2897580280700805340">Να γίνει έξοδος από το Browther ούτως ή άλλως;</translation>
<translation id="4413205837991854510">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="2454897022983434851">Να επιτρέπεται στο Browther να εκτελείται στο παρασκήνιο</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Το Browther προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/>}other{Το Browther προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Προσαρμογή και έλεγχος του Browther</translation>
<translation id="4427306783828095590">Η βελτιωμένη προστασία κάνει περισσότερα για τον αποκλεισμό ηλεκτρονικού ψαρέματος (phishing) και κακόβουλων προγραμμάτων</translation>
<translation id="4434353761996769206">Σφάλμα προγράμματος εγκατάστασης: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846">Ο οργανισμός <ph name="MANAGER"/> διαχειρίζεται το Browther</translation>
<translation id="4007482010626246887">Προσθήκη προφίλ Browther</translation>
<translation id="6888322430074420631">Σχετικά με το Browther for Testing</translation>
<translation id="8912436499620582668">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον Λογαριασμό σας Browther, εισαγάγετε τη φράση πρόσβασης</translation>
<translation id="4493028449971051158">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως διαχειριστής.</translation>
<translation id="4501471624619070934">Η εγκατάσταση απέτυχε επειδή η πρόσβαση είναι περιορισμένη σε αυτήν τη χώρα.</translation>
<translation id="8976207309012239417">Αυτή η επέκταση δεν έχει δημοσιεύσει πρακτικές απορρήτου, όπως τον τρόπο συλλογής και χρήσης δεδομένων. Το Browther προτείνει να την καταργήσετε.</translation>
<translation id="2174621824527957495">Καλωσορίσατε στο Browther. Ένα νέο παράθυρο προγράμματος περιήγησης έχει ανοίξει.</translation>
<translation id="6391148383688605718">Το Browther χρειάζεται άδεια για να χαρτογραφήσει τον περιβάλλοντα χώρο και να παρακολουθεί τα χέρια σας</translation>
<translation id="7756445485815468244">Έχετε συνδεθεί ήδη ως <ph name="USER_EMAIL_ADDRESS"/> σε άλλο προφίλ Browther</translation>
<translation id="137435413163730206">Το Browther προφορτώνει τις σελίδες, κάτι το οποίο επιταχύνει την περιήγηση και την αναζήτηση. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις σελίδες προφόρτωσης<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Βελτιώστε την ασφάλεια στο διαδίκτυο για όλους, αναφέροντας ιστοτόπους που πιστεύετε ότι είναι επιβλαβείς.</translation>
<translation id="3266647901351304597">Το Browther απέκλεισε αυτή τη λήψη, επειδή απενεργοποιήσατε την Ασφαλή περιήγηση και δεν είναι δυνατή η επαλήθευση του αρχείου</translation>
<translation id="6980208900390333646">Δοκιμάστε το Google Lens με το Browther στο τηλέφωνό σας</translation>
<translation id="4594305310729380060">Στον Διαχειριστή κωδικών πρόσβασης σε αυτήν τη συσκευή</translation>
<translation id="738228944918383850">Εφαρμογές Browther</translation>
<translation id="4598116752460667024">Αναζητήστε οποιαδήποτε διεργασία από τη λίστα.</translation>
<translation id="4970880042055371251">Έκδοση Chrome OS</translation>
<translation id="4482468019601425607">Η ενημέρωση σχεδόν ολοκληρώθηκε! Εκτελέστε ξανά το Browther για να ολοκληρωθεί η ενημέρωση.</translation>
<translation id="5517890123509214766">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Browther, αλλά καθιστά το Browther ελαφρώς λιγότερο ανθεκτικό σε επιθέσεις</translation>
<translation id="7690070364551268156">Εάν κοινοποιείτε επίσης αναφορές χρήσης του Browther, αυτές περιλαμβάνουν τα URL που επισκέπτεστε.</translation>
<translation id="5020487088453637212">Το προφίλ φαίνεται ότι χρησιμοποιείται από άλλη διεργασία του Browther (<ph name="PROCESS_ID"/>) σε άλλο υπολογιστή (<ph name="HOST_NAME"/>). Το Browther έχει κλειδώσει το προφίλ, για να μην καταστραφεί. Αν είστε σίγουροι ότι το προφίλ δεν χρησιμοποιείται από κάποια άλλη διεργασία, μπορείτε να το ξεκλειδώσετε και να επανεκκινήσετε το Browther.</translation>
<translation id="4680828127924988555">Ακύρωση εγκατάστασης</translation>
<translation id="8134827615154347946">Ορισμένα δεδομένα του Browther δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Browther. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="3508712423420506333">Ενώ είστε συνδεδεμένοι, μπορείτε να χρησιμοποιήσετε τους κωδικούς πρόσβασής σας και πολλά άλλα από τον Λογαριασμό σας Browther στο Browther. Η συντόμευση <ph name="SHORTCUT"/> μπορεί να αλλάξει τις ρυθμίσεις των υπηρεσιών Browther.</translation>
<translation id="2388739442635757494">Κάποιο άτομο συνδέθηκε προηγουμένως στο Browther σε αυτόν τον υπολογιστή ως <ph name="ACCOUNT_EMAIL_LAST"/>. Δημιουργήστε έναν νέο χρήστη του Browther, για να διατηρείτε τις πληροφορίες σας ξεχωριστά.</translation>
<translation id="4724676981607797757">Η εγκατάσταση απέτυχε λόγω σφάλματος μη υποστηριζόμενου πρωτοκόλλου.</translation>
<translation id="8305313684264112434">Να τερματιστεί η λειτουργία του Browther ούτως ή άλλως;</translation>
<translation id="418155915144835101">Μόλις εφαρμόστηκε μια ειδική ενημέρωση ασφαλείας για το Browther. Επανεκκινήστε τώρα και θα γίνει επαναφορά των καρτελών σας.</translation>
<translation id="2683970367518529374">Ρωτήστε το Browther</translation>
<translation id="5064473048847774331">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Browther κατάργησε τις άδειες <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> και <ph name="COUNT"/> ακόμη.</translation>
<translation id="5941343075741207533">Το Browther δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά μετά από 24 ώρες ή <ph name="BEGIN_LINK"/>ελέγξτε τους κωδικούς πρόσβασης στον Λογαριασμό σας Browther<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">Αυτό χρησιμοποιεί τον ίδιο ορθογραφικό έλεγχο που χρησιμοποιείται στην Αναζήτηση Browther. Το κείμενο που πληκτρολογείτε στο πρόγραμμα περιήγησης αποστέλλεται στην Browther. Μπορείτε ανά πάσα στιγμή να αλλάξετε αυτήν τη συμπεριφορά στις ρυθμίσεις.</translation>
<translation id="4581078588976787792">Χρήση του Browther χωρίς λογαριασμό</translation>
<translation id="5921583137589782067">Εισερχόμενος κανόνας για το Browther για να επιτρέπεται η κυκλοφορία του mDNS.</translation>
<translation id="6563126962881169552">Επανεκκίνηση για ενημέρωση του &amp;Browther</translation>
<translation id="4918086044614829423">Αποδοχή</translation>
<translation id="4918844574251943176">Η εικόνα αντιγράφηκε</translation>
<translation id="5240982928057703861">Το Browther εκτελείται στο παρασκήνιο.</translation>
<translation id="3603134280602182991">Κάντε κλικ για να κλείσετε το παράθυρο διαλόγου σύνδεσης του Browther</translation>
<translation id="6120233890602288442">Με τα προφίλ του Browther μπορείτε να διαχωρίσετε όλη τη δραστηριότητα και το περιεχόμενό σας στο Browther. Δημιουργήστε προφίλ για φίλους και μέλη της οικογένειας ή διαχωρίστε την εργασία και τη διασκέδαση.</translation>
<translation id="5722688387568011881">Οι επισκέπτες μπορούν να χρησιμοποιούν το Browther χωρίς να αφήνουν κανένα ίχνος.</translation>
<translation id="7786958592460743302">Ο λογαριασμός σας στο Browther</translation>
<translation id="9114640791491590337">Προσθήκη του εαυτού σας στο Browther</translation>
<translation id="3536391594566515053">Το Gemini στο Browther χρησιμοποιεί την αυτόματη περιήγηση για να εργάζεται στις καρτέλες σας και να ολοκληρώνει τις εργασίες που του αναθέτετε. <ph name="LINK_BEGIN"/>Μάθετε περισσότερα<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">Το Browther χρειάζεται άδεια για να παρακολουθεί τα χέρια σας</translation>
<translation id="1627123463102858476">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Browther κατάργησε τις άδειες <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> και <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ στο εικονίδιο ειδοποίησης στη δεξιά γωνία της γραμμής τοποθεσίας.</translation>
<translation id="5174983315706567306">Δεν υπάρχει αρκετός χώρος δίσκου.</translation>
<translation id="7091313576354542088">Ο λογαριασμός Browther απαιτεί εκ νέου έλεγχο ταυτότητας</translation>
<translation id="9045390598305758496">Δεν υπάρχουν αποθηκευμένοι κωδικοί πρόσβασης. Το Browther μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύσετε.</translation>
<translation id="5686724084351858452">Αποσύνδεση από το Browther</translation>
<translation id="5234764350956374838">Παράβλεψη</translation>
<translation id="5254739261293693943">Ερώτηση σχετικά με αυτό το βίντεο</translation>
<translation id="8165028066129227692">Για να εφαρμόσετε τις αλλαγές σας, επανεκκινήστε το Browther</translation>
<translation id="5286907366254680517">Εντοπίστηκε</translation>
<translation id="198210130507193824">Λήψη της εφαρμογής Browther</translation>
<translation id="8472078903122489041">Εσωτερική υπηρεσία Browther Updater</translation>
<translation id="5346389065299425353">Εμβαθύνετε την αναζήτησή σας, προσθέτοντας πολλές καρτέλες, αρχεία και εργαλεία</translation>
<translation id="3904682305383981098">Το Browther εντόπισε ορισμένες προτάσεις ασφάλειας για να ελέγξετε</translation>
<translation id="509616246140011182">Άλλα προφίλ Browther</translation>
<translation id="8214429210535362385">Είστε συνδεδεμένοι με έναν διαχειριζόμενο λογαριασμό και παραχωρείτε στο διαχειριστή του τον έλεγχο του προφίλ σας στο Browther. Τα δεδομένα σας στο Browther, όπως οι εφαρμογές, οι σελιδοδείκτες, το ιστορικό, οι κωδικοί πρόσβασης και άλλες ρυθμίσεις θα συνδεθούν μόνιμα με το όνομα χρήστη <ph name="USER_NAME"/>. Θα έχετε τη δυνατότητα να διαγράψετε αυτά τα δεδομένα μέσω του Πίνακα ελέγχου των Λογαριασμών Browther, αλλά δεν θα μπορείτε να τα συσχετίσετε με άλλο λογαριασμό. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Επιπλέον κωδικός: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">Για εξατομίκευση, συμπεριλάβετε το Browther στη Δραστηριότητα ιστού και εφαρμογών</translation>
<translation id="8096544113811780871">Μάθετε γιατί το Browther αποκλείει ορισμένα αρχεία</translation>
<translation id="2384387444932590174">Ενημέρωση του Browther (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">Να επιτρέπεται η σύνδεση στο Browther</translation>
<translation id="6557334704331248411">Κατάργηση από το Browther</translation>
<translation id="5832041381258620673">Μειώνει την απόδοση αλλά καθιστά το Browther πιο ανθεκτικό σε επιθέσεις</translation>
<translation id="3763317028635993788">Ορισμός του Browther ως προεπιλεγμένου προγράμματος περιήγησης</translation>
<translation id="8756552710915246172"><ph name="PAGE_TITLE"/> - Browther Beta</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{Το Browther συνιστά να θέσετε σε παύση την καρτέλα που επιβραδύνει το πρόγραμμα περιήγησης}other{Το Browther συνιστά να θέσετε σε παύση τις καρτέλες που επιβραδύνουν το πρόγραμμα περιήγησης}}</translation>
<translation id="4423621904097888155">Το Browther ενδέχεται να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πλέον σε αυτήν τη διανομή Linux.</translation>
<translation id="6201726364919996698">Το Browther απέκλεισε αυτή τη λήψη, επειδή το αρχείο μπορεί να βλάψει τους προσωπικούς σας λογαριασμούς και τους λογαριασμούς σας σε κοινωνικά δίκτυα</translation>
<translation id="7679204468655335605">Το Browther χρειάζεται πρόσβαση στην τοποθεσία σας, για να την κοινοποιήσει σε αυτόν τον ιστότοπο</translation>
<translation id="1163572992704966942">Περιμένετε μέχρι να γίνει εγκατάσταση των πιο πρόσφατων ενημερώσεων συστήματος από το Browther.</translation>
<translation id="5050118226119231029">Το Browther προσπαθεί να επεξεργαστεί κωδικούς πρόσβασης. Για να επιτρέψετε αυτή την ενέργεια, πληκτρολογήστε τον κωδικό πρόσβασης των Windows.</translation>
<translation id="5524890928877629608">επάνω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT"/>%, επάνω <ph name="TOP"/>%</translation>
<translation id="5875549039106594731">Άνοιγμα PDF στο Browther</translation>
<translation id="5536164441519929134">Ερώτηση<ph name="LINE_BREAK"/>σχετικά με αυτή την καρτέλα</translation>
<translation id="5579324208890605088">Σφάλμα εκκίνησης: Εκτελέστε το πρόγραμμα εγκατάστασης ως απλός χρήστης και όχι ως διαχειριστής.</translation>
<translation id="202315329304302571">Χρήση Browther από προεπιλογή και καρφίτσωμα</translation>
<translation id="5596627076506792578">Περισσότερες επιλογές</translation>
<translation id="5605834417512968703">Επιλέξτε οτιδήποτε για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5618818588972826921">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες ή πατήστε Escape για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="5823076755666406442">{0,plural, =0{Υπάρχει μια διαθέσιμη ενημέρωση του Browther}=1{Υπάρχει μια διαθέσιμη ενημέρωση του Browther}other{Υπάρχει μια διαθέσιμη ενημέρωση του Browther για # ημέρες}}</translation>
<translation id="8414129876440043675">Να διαγράφονται πάντα τα δεδομένα ιστοτόπων από τη συσκευή σας όταν κλείνετε το Browther</translation>
<translation id="5156991567152325333">Επανεκκινήστε το Browther τώρα</translation>
<translation id="5710072384986281834">Browther LLC</translation>
<translation id="1536693367017293028">Να εμφανίζεται το Browther σε αυτήν τη γλώσσα</translation>
<translation id="569897634095159764">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Ο διακομιστής μεσολάβησης απαιτεί έλεγχο ταυτότητας.</translation>
<translation id="4215338057953170891">Με τα προφίλ του Browther μπορείτε να διαχωρίσετε την προσωπική περιήγηση από την εργασία. Προσθέστε ένα νέο προφίλ τώρα.</translation>
<translation id="5366435608642317052">Το Browther αποδεσμεύει μνήμη από τις ανενεργές καρτέλες. Αυτό προσφέρει στις ενεργές καρτέλες και σε άλλες εφαρμογές περισσότερους πόρους υπολογιστή και διατηρεί το Browther γρήγορο. Οι ανενεργές καρτέλες σας ενεργοποιούνται ξανά αυτόματα, όταν επιστρέψετε σε αυτές. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με την Εξοικονόμηση μνήμης<ph name="END_LINK"/></translation>
<translation id="4941518395341035738">Εάν ξεχάσατε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="SETTINGS_LINK"/> τα δεδομένα του Browther στον λογαριασμό σας</translation>
<translation id="7763291835437810978">Προσαρμογή και έλεγχος του Browther. Ορίστε το Browther ως προεπιλογή.</translation>
<translation id="5809516625706423866">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. HTTP 401 Unauthorized. Ελέγξτε τη διαμόρφωση παραμέτρων του διακομιστή μεσολάβησης.</translation>
<translation id="1827132270895283425">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Browther, αλλά καθιστά το Browther ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι απενεργοποιημένη.</translation>
<translation id="1553025851718680114">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον Λογαριασμό σας Browther, ενημερώστε το Browther</translation>
<translation id="5824893331272123205">Δεν ήταν δυνατή η φόρτωση αυτού του πλαισίου. Δοκιμάστε ξανά.</translation>
<translation id="7339353273994862168">Καλώς ήρθατε στο Browther</translation>
<translation id="5871205389137001634">Κάντε κλικ για έξοδο από την Αναζήτηση με εικόνες</translation>
<translation id="7586794330537887406">Το Browther εντόπισε κακόβουλο πρόγραμμα σε αυτά τα στοιχεία:</translation>
<translation id="1666897346518812892">Το Browther ελέγχει τακτικά για να διασφαλίζει ότι το πρόγραμμα περιήγησης που χρησιμοποιείτε έχει τις πιο ασφαλείς ρυθμίσεις. Θα σας ενημερώνουμε, αν χρειάζεται να ελέγξετε κάτι.</translation>
<translation id="5895138241574237353">Επανεκκίνηση</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - Σύνδεση δικτύου</translation>
<translation id="5924017743176219022">Γίνεται σύνδεση στο διαδίκτυο…</translation>
<translation id="5941711191222866238">Ελαχιστοποίηση</translation>
<translation id="4938357262936377412">Για να έχετε πρόσβαση σε αυτόν τον σελιδοδείκτη και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Browther</translation>
<translation id="260974496993853147">Εξατομίκευση του Browther</translation>
<translation id="5960071705175224773">Οι ρυθμίσεις σας άλλαξαν από μια άγνωστη εφαρμογή</translation>
<translation id="5968400720580217226">Λειτουργία AI</translation>
<translation id="8697015289720079159">{COUNT,plural, =1{Ο οργανισμός σας κλείνει αυτόματα το Browther όταν δεν χρησιμοποιείται για 1 λεπτό.}other{Ο οργανισμός σας κλείνει αυτόματα το Browther όταν δεν χρησιμοποιείται για # λεπτά.}}</translation>
<translation id="5852664780493076676">Για να ξεκινήσει ο συγχρονισμός, ενημερώστε το Browther</translation>
<translation id="6003112304606738118">Λήψη… Απομένουν <ph name="HOURS"/> ώρες</translation>
<translation id="6009821354356307391">Κάντε ένα επιπλέον ερώτημα</translation>
<translation id="6040143037577758943">Κλείσιμο</translation>
<translation id="2495504229007749358">Για την προστασία των δεδομένων σας, επιτρέψτε στο Browther να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα. Δεν διακόπτει τις ειδοποιήσεις.</translation>
<translation id="6038969823662006832">&amp;Άνοιγμα στο Browther</translation>
<translation id="6069027071882229820">Αντιγραφή ως εικόνα</translation>
<translation id="6606690217326148454">Η επέκταση <ph name="EXTENSION_NAME"/> έχει προστεθεί στο Browther</translation>
<translation id="6037324269860323082">Προσαρμόστε και ελέγξτε το Browther. Υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="3695768481578778794">Ενεργή • Το Browther δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="4401885752362736126">Ο λογαριασμός σας στο Browther</translation>
<translation id="4310817187912076496">Να επιτρέπεται στην επέκταση να εμφανίζει αιτήματα πρόσβασης στη γραμμή εργαλείων του Browther</translation>
<translation id="4602490888173698813">Το αρχείο <ph name="FILE_NAME"/> είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Browther.</translation>
<translation id="5139243417751674628">Το Browther θα κλείσει σύντομα και θα διαγράψει τα δεδομένα</translation>
<translation id="4696750309605389299">Μπορείτε εδώ να κάνετε εναλλαγή μεταξύ των προφίλ σας Browther</translation>
<translation id="7475001351099358916">Εάν επιτρέπεται η λήψη cookie, το Browther μπορεί να τα χρησιμοποιεί κατά την προφόρτωση</translation>
<translation id="6165508094623778733">Μάθετε περισσότερα</translation>
<translation id="5975099973700540482">Διαγράψετε τα δεδομένα του Browther στον λογαριασμό σας</translation>
<translation id="6800151735486681860">Αυτό το αρχείο ενδέχεται να είναι επικίνδυνο<ph name="LINE_BREAK"/>Το Browther μπορεί να ελέγξει αυτή τη λήψη για εσάς εάν καταχωρίσετε τον κωδικό πρόσβασης. Οι πληροφορίες σχετικά με το αρχείο αποστέλλονται στην Ασφαλή περιήγηση Browther, αλλά το περιεχόμενο και ο κωδικός πρόσβασης του αρχείου παραμένουν στη συσκευή σας.</translation>
<translation id="6182736845697986886">Η εγκατάσταση απέτυχε λόγω εσωτερικού σφάλματος στον διακομιστή ενημέρωσης.</translation>
<translation id="48832130233362517">Βεβαιωθείτε ότι έχετε συνδεθεί στο Browther στη συσκευή σας <ph name="TARGET_DEVICE_NAME"/> και έπειτα δοκιμάστε ξανά την αποστολή.</translation>
<translation id="8868210753005945522">Κάποιο άλλο πρόγραμμα στον υπολογιστή σας πρόσθεσε μια εφαρμογή, η οποία ενδέχεται να αλλάξει τον τρόπο λειτουργίας του Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">Αυτός ο υπολογιστής διαθέτει ήδη μια πιο πρόσφατη έκδοση του Browther. Αν το λογισμικό δεν λειτουργεί, απεγκαταστήστε το Browther και κατεβάστε το ξανά.</translation>
<translation id="9222998061982994203">{0,plural, =0{Η επανεκκίνηση του Browther θα γίνει τώρα}=1{Η επανεκκίνηση του Browther θα γίνει σε 1 δευτερόλεπτο}other{Η επανεκκίνηση του Browther θα γίνει σε # δευτερόλεπτα}}</translation>
<translation id="6239161312595354541">Ερώτηση στην Αναζήτηση με εικόνες σχετικά με αυτό το βίντεο</translation>
<translation id="1755464917870815989">Το Browther χρειάζεται άδεια πρόσβασης στον αποθηκευτικό χώρο για τη λήψη αρχείων.</translation>
<translation id="304681001513922736">Ελέγχει εάν τα URL περιλαμβάνονται στη λίστα μη ασφαλών ιστοτόπων που είναι αποθηκευμένη στο Browther</translation>
<translation id="7785903492969539081">Ορισμός Browther ως προεπιλεγμένο πρόγραμμα</translation>
<translation id="3987833816263696343">Θέλετε να αποσυνδεθείτε από το Browther;</translation>
<translation id="4723540739671534529">Αυτές οι καρτέλες χρησιμοποιούν επιπλέον πόρους. Για να βελτιώσετε την απόδοσή σας, επιτρέψτε στο Browther να τις απενεργοποιήσει.</translation>
<translation id="6540151687468239291">Προσαρμόστε το προφίλ σας Browther</translation>
<translation id="770793114032605647">Ονομάστε το προφίλ σας στο Browther</translation>
<translation id="385867753870250529">Μια επέκταση θέλει να συνδεθείτε στο Browther</translation>
<translation id="2022337046348377650">Το αρχείο <ph name="FILE_NAME"/> μπορεί να είναι επικίνδυνο, επομένως έχει αποκλειστεί από το Browther.</translation>
<translation id="45270956603278068">Το Browther χρησιμοποιεί την κάμερά σας.</translation>
<translation id="6327105987658262776">Δεν υπάρχει διαθέσιμη ενημέρωση.</translation>
<translation id="673633752219771459">Μια άλλη λειτουργία στο Browther βρίσκεται σε εξέλιξη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="1482759407165416070">Τώρα μπορείτε να χρησιμοποιείτε πιο εύκολα το Browther με το Λογαριασμό σας Browther και σε κοινόχρηστους υπολογιστές.</translation>
<translation id="5538042432112726532">Συντόμευση Browther</translation>
<translation id="833085228901080512">Το Browther απέκλεισε αυτή τη λήψη επειδή δεν πραγματοποιείται συχνά λήψη αυτού του αρχείου και ενδέχεται να είναι επικίνδυνο</translation>
<translation id="491120842288314439">Είστε βέβαιοι ότι θέλετε να απεγκαταστήσετε του Browther;</translation>
<translation id="6375219077595103062">Προσθήκη συντόμευσης στον Διαχειριστή κωδικών πρόσβασης</translation>
<translation id="6388799252195623474">βοήθησέ με με αυτή την εργασία</translation>
<translation id="6715003312952407375">Για να συνεχίσετε, συνδεθείτε στο Browther ως <ph name="EMAIL"/>. Αυτή η ενέργεια διασφαλίζει ότι ακολουθείτε τις πολιτικές του οργανισμού σας.</translation>
<translation id="1897845318651970239">Λογότυπο Browther μέσα σε οθόνη υπολογιστή.</translation>
<translation id="3669522483038684532">Το Browther είναι ένα πρόγραμμα περιήγησης ιστού που εκτελεί εφαρμογές και ιστοσελίδες με απίστευτη ταχύτητα. Είναι γρήγορο, σταθερό και εύχρηστο. Περιηγηθείτε στον ιστό με μεγαλύτερη ασφάλεια με την ενσωματωμένη προστασία από κακόβουλα προγράμματα και ηλεκτρονικό "ψάρεμα" (phishing).</translation>
<translation id="5669767676913031391">Το Browther εκτελείται πιο γρήγορα και οι λειτουργίες που χρησιμοποιούν JavaScript θα πρέπει να λειτουργούν με τον αναμενόμενο τρόπο</translation>
<translation id="6436260184216827876">Η Αναζήτηση με εικόνες δεν είναι διαθέσιμη. Δοκιμάστε ξανά αργότερα.</translation>
<translation id="2139300032719313227">Επανεκκίνηση Chrome OS</translation>
<translation id="6110616900529884221">Το Browther προφορτώνει ακόμα περισσότερες σελίδες που είναι πιθανό να επισκεφτείτε, ώστε να φορτώνουν πιο γρήγορα όταν τις επισκέπτεστε</translation>
<translation id="1217194059001819677">Κατεβάστε το Browther στο τηλέφωνό σας για παρακολούθηση τιμών και λήψη ειδοποιήσεων σε περίπτωση πτώσης τιμής σε οποιονδήποτε ιστότοπο</translation>
<translation id="7058555680120557198">Ανενεργή • Το Browther δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης</translation>
<translation id="676533642429632127">Καλώς ήρθατε στα προφίλ του Browther</translation>
<translation id="5518682889576009702">Την επόμενη φορά που θα ανοίξετε το Browther στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για χρήση των ομάδων καρτελών.</translation>
<translation id="6038105561107837619">Κατάργηση λογαριασμού από το Browther</translation>
<translation id="2675662665675552980">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Browther.</translation>
<translation id="648319183876919572">Η Βελτιωμένη Ασφαλής περιήγηση κάνει περισσότερα για την προστασία σας από επικίνδυνους ιστοτόπους και λήψεις</translation>
<translation id="2930243146591999795">Απεγκατάσταση Browther</translation>
<translation id="5241183382286817629">Οι συντομεύσεις ανοίγουν στο Browther</translation>
<translation id="7907014599435829661">Ο οργανισμός σας κλείνει το Browther όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>. Τα δεδομένα περιήγησης διαγράφηκαν. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="2088471423667794811">Κάθε προφίλ διατηρεί τις δικές του πληροφορίες στο Browther, όπως σελιδοδείκτες, ιστορικό, κωδικούς πρόσβασης και άλλα.</translation>
<translation id="9040334484455218184">Μάθετε περισσότερα σχετικά με το <ph name="BEGIN_LINK"/>πώς το Browther διατηρεί ιδιωτικά τα δεδομένα σας<ph name="END_LINK"/></translation>
<translation id="1718697235867382480">Οι αλλαγές σε αυτή τη ρύθμιση θα εφαρμοστούν μετά από την επανεκκίνηση του Browther.</translation>
<translation id="6331317152404762758">Μπορείτε να κάνετε εναλλαγή για να δείτε τους κωδικούς πρόσβασης από ένα άλλο προφίλ Browther</translation>
<translation id="6097706403184348562">Για τη διόρθωση ορθογραφικών λαθών, το Browther στέλνει το κείμενο που πληκτρολογείτε σε πεδία κειμένου στο Browther</translation>
<translation id="2319647238307402812">Μετάβαση στις ρυθμίσεις ειδοποιήσεων του Browther</translation>
<translation id="6600016381025017075">Αναζητήστε οτιδήποτε σε αυτή τη σελίδα</translation>
<translation id="8031938899816118394">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Browther.</translation>
<translation id="7412185356697187964">Το Browther ανοίγει πλέον κατά την εκκίνηση των Windows, ώστε να μπορείτε να ξεκινήσετε άμεσα την περιήγηση. Μπορείτε να απενεργοποιήσετε αυτή τη λειτουργία στις ρυθμίσεις.</translation>
<translation id="9123343592576384616">Συνεχίστε από εκεί που σταματήσατε: Το Browther έκανε επαναφορά των καρτελών σας από την τελευταία περίοδο λειτουργίας. Μπορείτε να απενεργοποιήσετε αυτή τη ρύθμιση στην ενότητα</translation>
<translation id="5847926498049048567">Το Browther χρειάζεται άδεια κάμερας για να δημιουργήσει έναν τρισδιάστατο χάρτη του περιβάλλοντα χώρου σας.</translation>
<translation id="5532585028508811858">Εάν αποθηκεύσετε τους σελιδοδείκτες σας και στον Λογαριασμό σας Browther, μπορείτε να παρακολουθείτε τις τιμές των προϊόντων στο Browther και να λαμβάνετε ειδοποιήσεις όταν παρατηρείται πτώση τιμών</translation>
<translation id="6676384891291319759">Πρόσβαση στο Διαδίκτυο</translation>
<translation id="1363996462118479832">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS λόγω σφάλματος κατά τη σύνδεση.</translation>
<translation id="3373239673945775810">Κατάργηση των δεδομένων αυτής της εφαρμογής από το Browther</translation>
<translation id="8122759674786039814">Το Browther προσφέρει περισσότερο έλεγχο ως προς τις διαφημίσεις που βλέπετε και περιορίζει τις πληροφορίες που μπορούν να μάθουν για εσάς οι ιστότοποι κατά την προβολή εξατομικευμένων διαφημίσεων</translation>
<translation id="6277682530398500159">Το Browther χρειάζεται άδεια μικροφώνου για αυτόν τον ιστότοπο.</translation>
<translation id="6712881677154121168">Σφάλμα λήψης: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">Δεν είναι δυνατή η χρήση του προφίλ σας επειδή προέρχεται από νεότερη έκδοση του Browther.

Ορισμένες λειτουργίες ενδέχεται να μην είναι διαθέσιμες. Καθορίστε έναν διαφορετικό κατάλογο προφίλ ή χρησιμοποιήστε μια νεότερη έκδοση του Browther.</translation>
<translation id="871671753163165892">Για να αξιοποιήσετε την εξατομίκευση και άλλες λειτουργίες, συμπεριλάβετε το Browther στη Δραστηριότητα ιστού και εφαρμογών και στις συνδεδεμένες υπηρεσίες Browther</translation>
<translation id="5000832110229523807">Το Browther είναι ήδη εγκατεστημένο για όλους τους χρήστες στον υπολογιστή σας.</translation>
<translation id="5204575479550973859">Για να έχετε πρόσβαση στους σελιδοδείκτες σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Browther. Αυτός ο σελιδοδείκτης θα αποθηκευτεί στον Λογαριασμό σας Browther αφού συνδεθείτε.</translation>
<translation id="2874208284092283937">Επιταχύνει τους ιστοτόπους με τη μηχανή V8 του Browther, αλλά καθιστά το Browther ελαφρώς λιγότερο ανθεκτικό στις επιθέσεις. Αυτή η ρύθμιση είναι ενεργοποιημένη.</translation>
<translation id="3268577459683869744">{count,plural, =1{Ορισμένα δεδομένα του Browther δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Browther. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα (1 στοιχείο) θα διαγραφούν.}other{Ορισμένα δεδομένα του Browther δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Browther. Δοκιμάστε να περιμένετε λίγα λεπτά προτού αποσυνδεθείτε. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα ({count} στοιχεία) θα διαγραφούν.}}</translation>
<translation id="7683816018918395929">Το Browther συνιστά τη σάρωση αυτού του αρχείου επειδή μπορεί να είναι επικίνδυνο.</translation>
<translation id="1547295885616600893">Το Chrome OS υλοποιήθηκε με τη βοήθεια πρόσθετου <ph name="BEGIN_LINK_CROS_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">Μετάφραση</translation>
<translation id="2142653375108595728">Το Browther σας ενημερώνει σε περίπτωση παραβίασης των κωδικών πρόσβασής σας.</translation>
<translation id="684888714667046800">Δεν είναι δυνατή η σύνδεση στο διαδίκτυο. Εάν χρησιμοποιείτε τείχος προστασίας, βεβαιωθείτε ότι το <ph name="PRODUCT_EXE_NAME"/> είναι στη λίστα επιτρεπομένων.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">Πατήστε Tab για συνέχεια</translation>
<translation id="6862030660799253820">Αναζήτηση αυτής της εικόνας με την Αναζήτηση με εικόνες</translation>
<translation id="3860339351709082396">Το Browther εντόπισε κακόβουλο πρόγραμμα στην επέκταση <ph name="EXTENSION_NAME"/>.</translation>
<translation id="6877155553248388166">κάτω δεξιά γωνία της περιοχής αναζήτησης: δεξιά <ph name="RIGHT"/>%, κάτω <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">Αντιγραφή</translation>
<translation id="7804113502310231166">Ορίστε το Browther ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="3228374215117173004">&amp;Διαχείριση προφίλ Browther</translation>
<translation id="6934579572334859869">Ερώτηση στην Αναζήτηση εικόνων σχετικά με αυτή την εικόνα</translation>
<translation id="5995328366516663808">Έχετε συμπληρώσει το όριο των <ph name="BOOKMARK_LIMIT"/> σελιδοδεικτών του Browther, επομένως ορισμένοι από τους σελιδοδείκτες σας δεν έχουν αποθηκευτεί ακόμα στον Λογαριασμό σας Browther.

Δεν θα είναι δυνατή η αποθήκευση νέων σελιδοδεικτών στον λογαριασμό σας μέχρι να διαγράψετε ορισμένους. Εάν αποσυνδεθείτε τώρα, οι μη αποθηκευμένοι σελιδοδείκτες θα διαγραφούν.</translation>
<translation id="6965382102122355670">OK</translation>
<translation id="4533562834763015352">Είναι εύκολο να μαντέψει κανείς τους ασθενείς κωδικούς πρόσβασης. Επιτρέψτε στο Browther να <ph name="BEGIN_LINK"/>δημιουργεί και να απομνημονεύει ισχυρούς κωδικούς πρόσβασης για εσάς<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">Όροι του Chrome OS</translation>
<translation id="5379058926689137454">Το Browther χρειάζεται άδεια, για να αποκτήσει πρόσβαση στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="4684462982894889021">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον λογαριασμό σας, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">Η εγκατάσταση απέτυχε επειδή αυτή η έκδοση του λειτουργικού συστήματος δεν υποστηρίζεται.</translation>
<translation id="7024536598735240744">Σφάλμα αποσυσκευασίας: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">Η εγκατάσταση διακόπηκε.</translation>
<translation id="8257174622576051374">Προσαρμόστε το Browther για εσάς</translation>
<translation id="7047386856539490735">Είναι χρήσιμα αυτά τα αποτελέσματα;</translation>
<translation id="1772745060691790742">Ενημέρωση Browther</translation>
<translation id="4937970118065051027">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Browther θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Browther.</translation>
<translation id="1594112132009288601">Προσαρμογή του Browther for Testing</translation>
<translation id="5915000938288527952">Μπορείτε να χρησιμοποιείτε το Browther κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="8775664994493381735">Κατάργηση της επέκτασης <ph name="EXTENSION_NAME"/> από το Browther</translation>
<translation id="3276648807841991013">Ο οργανισμός σας διαγράφει τα δεδομένα του Browther όταν δεν χρησιμοποιούνται για <ph name="TIMEOUT_DURATION"/>. Σε αυτά περιλαμβάνονται το ιστορικό, τα δεδομένα αυτόματης συμπλήρωσης και οι λήψεις.</translation>
<translation id="4725226878394159809">Το Browther χρειάζεται άδεια κάμερας για αυτόν τον ιστότοπο.</translation>
<translation id="8931474625901592021">Δεν ήταν δυνατή η εκκίνηση του Browther. Προσπάθησε ξανά.</translation>
<translation id="8242947409070121799">Το Browther δεν μπορεί να ελέγξει τους κωδικούς πρόσβασής σας. Δοκιμάστε ξανά σε 24 ώρες.</translation>
<translation id="1737922827960215472">Διατηρήστε το Browther στο Dock για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="335855266303176628">Χρησιμοποιήστε το Browther κάθε φορά που κάνετε κλικ σε συνδέσμους σε μηνύματα, έγγραφα και άλλες εφαρμογές</translation>
<translation id="709455597778444012">Διαχείριση Εργασιών - Browther</translation>
<translation id="7147140345767587643">Τα ενδιαφέροντά σας σύμφωνα με την εκτίμηση του Browther</translation>
<translation id="7337408274890534789">Ξεκινήστε άμεσα την περιήγηση: Το Browther μπορεί πλέον να ανοίγει κατά την εκκίνηση των Windows.</translation>
<translation id="7274695763216404502">Καρφιτσώθηκε! Χρησιμοποιήστε ξανά την Αναζήτηση με εικόνες από τη γραμμή εργαλείων</translation>
<translation id="7288567540154601580">Καρτέλες και επεκτάσεις</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{Το Browther προτείνει να την καταργήσετε}other{Το Browther προτείνει να τις καταργήσετε}}</translation>
<translation id="1527644038571473502">Για κοινή χρήση του ήχου συστήματος, ανοίξτε τις Ρυθμίσεις συστήματος και επιτρέψτε την επιλογή "Μόνο εγγραφή ήχου συστήματος" για το Browther. Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Browther.</translation>
<translation id="1427913074981060872">Η Μέτρηση διαφημίσεων επιτρέπει στους ιστοτόπους που επισκέπτεστε να ζητούν πληροφορίες από το Browther που βοηθούν τον ιστότοπο να μετρήσει την απόδοση των διαφημίσεών του. Η Μέτρηση διαφημίσεων περιορίζει την παρακολούθηση μεταξύ ιστοτόπων μεταφέροντας όσο το δυνατόν λιγότερες πληροφορίες μεταξύ των ιστοτόπων.</translation>
<translation id="1657652725060525338">Ενημέρωση του Browther</translation>
<translation id="884846289464870238">Το αρχείο προτιμήσεών σας είναι κατεστραμμένο ή μη έγκυρο.

Το Browther δεν μπορεί να ανακτήσει τις ρυθμίσεις σας.</translation>
<translation id="7339898014177206373">Νέο παράθυρο</translation>
<translation id="633044855886370183">Εδώ μπορείτε να βρείτε τις ιστοσελίδες, τους σελιδοδείκτες σας και άλλα δεδομένα του Browther.</translation>
<translation id="1185960088713242527">Μόνο κάποιος που γνωρίζει τη φράση πρόσβασης μπορεί να διαβάσει τα κρυπτογραφημένα δεδομένα σας. H φράση πρόσβασης δεν αποστέλλεται στην Browther, ούτε αποθηκεύεται από αυτήν. Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, θα χρειαστεί να <ph name="BEGIN_LINK"/>διαγράψετε τα δεδομένα του Browther στον λογαριασμό σας<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110">Ο διαχειριστής συστήματος έχει διαμορφώσει το Browther ώστε να ανοίγει το <ph name="ALTERNATIVE_BROWSER_NAME"/> για την πρόσβαση σε <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">Παρουσιάστηκε κάποιο πρόβλημα</translation>
<translation id="6638123710106659002">Για τη λήψη μελλοντικών ενημερώσεων του Browther, θα χρειαστείτε macOS 13 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί macOS 12.</translation>
<translation id="7286289384512061761">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Browther κατάργησε τις άδειες <ph name="PERMISSION_1"/> και <ph name="PERMISSION_2"/>.</translation>
<translation id="113593073175678746">Αυτή η επέκταση δεν υποστηρίζεται πλέον. Το Browther προτείνει να την καταργήσετε.</translation>
<translation id="137615076640044304">Συνεχίστε από το σημείο που σταματήσατε: Το Browther επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να απενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="5967238175620483220">Εισαγωγή κωδικών πρόσβασης στο Browther</translation>
<translation id="4719434010343478165"><ph name="PAGE_TITLE"/> - Browther Dev</translation>
<translation id="7450541714075000668">Το κείμενο αντιγράφηκε</translation>
<translation id="7766009218653304791">Το Browther χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα για αυτόν τον ιστότοπο</translation>
<translation id="5844418066487488520">Για χρήση του μικροφώνου, παραχωρήστε πρόσβαση στο Browther στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="8065480549334161841">Για τη λήψη μελλοντικών ενημερώσεων του Browther, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 7.</translation>
<translation id="6299293759264950896">Επανεκκίνηση του Browther;</translation>
<translation id="180908550381040105">Δεν είναι δυνατή η εγκατάσταση της ίδια έκδοσης του Browther που εκτελείται αυτήν τη στιγμή. Κλείστε το Browther και δοκιμάστε ξανά.</translation>
<translation id="7625576878150380853">Θα αποθηκεύετε και θα χρησιμοποιείτε κωδικούς πρόσβασης και άλλα στοιχεία στον Λογαριασμό σας Browther κάθε φορά που είστε συνδεδεμένοι στο Browther. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">Οι ιστότοποι πιθανώς θα λειτουργούν με τον αναμενόμενο τρόπο. Θα αποσυνδεθείτε από τους περισσότερους ιστοτόπους όταν κλείσετε όλα τα παράθυρα του Browther, εκτός από τον Λογαριασμό σας Browther εάν είστε συνδεδεμένοι στο Browther.</translation>
<translation id="7099370564362681943">{0,plural, =1{Η επανεκκίνηση του Browther θα γίνει σε 1 λεπτό}other{Η επανεκκίνηση του Browther θα γίνει σε # λεπτά}}</translation>
<translation id="3602613943932672197">Για την προστασία των δεδομένων σας, επιτρέψτε στο Browther να καταργεί τις άδειες από τους ιστοτόπους που δεν έχετε επισκεφτεί πρόσφατα.</translation>
<translation id="8759568213742229377">Ανοίξτε αυτόματα το Browther, για να αρχίσετε άμεσα την περιήγηση.</translation>
<translation id="7583399374488819119">Πρόγραμμα εγκατάστασης <ph name="COMPANY_NAME"/></translation>
<translation id="8991800242749014880">Το Browther χρησιμοποιεί την κάμερα και το μικρόφωνό σας.</translation>
<translation id="2692328388439821508">Το Browther έγινε ακόμα καλύτερο</translation>
<translation id="4318444066563223295">Έχετε πλέον περισσότερες διαθέσιμες λειτουργίες στο Browther</translation>
<translation id="7649070708921625228">Βοήθεια</translation>
<translation id="5591287320769313116">Επιτρέψτε στο Browther να κάνει περιήγηση για εσάς</translation>
<translation id="7658239707568436148">Ακύρωση</translation>
<translation id="6325482130534634729">Το Browther δεν είναι το προεπιλεγμένο πρόγραμμα περιήγησης</translation>
<translation id="8185915921134219287">Συγχρονίστε και εξατομικεύστε το Browther στις συσκευές σας</translation>
<translation id="5120421624925726813">Ενημέρωση Browther</translation>
<translation id="7716950018788545737">Οι εργασίες τερματίστηκαν.</translation>
<translation id="77283119132245232">Παρέχει υπηρεσίες ανίχνευσης συστήματος για το <ph name="BROWSER_NAME"/>. Εάν αυτή η υπηρεσία είναι απενεργοποιημένη, τα ίχνη απόδοσης που δημιουργούνται από το πρόγραμμα περιήγησης δεν θα περιλαμβάνουν συμβάντα σε επίπεδο συστήματος, όπως συμβάντα εναλλαγής περιβάλλοντος και συμβάντα ετοιμότητας νήματος.</translation>
<translation id="6542096191573265107">Με αυτή την ενέργεια θα διαγραφούν τα δεδομένα περιήγησης από αυτήν τη συσκευή. Για να ανακτήσετε τα δεδομένα σας αργότερα, συνδεθείτε στο Browther ως <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">Δεν ήταν δυνατή η δημιουργία ενός προσωρινού καταλόγου από το πρόγραμμα εγκατάστασης. Ελέγξτε τον κενό χώρο του δίσκου και το δικαίωμα εγκατάστασης του λογισμικού.</translation>
<translation id="351575328720488268">Επαναφορά της προεπιλογής Browther</translation>
<translation id="1054170408395182418">Ορίστε το Browther ως προεπιλογή και καρφιτσώστε το στη γραμμή εργαλείων</translation>
<translation id="4569594230301902490">Κάντε το Browther πιο γρήγορο</translation>
<translation id="5525298466557654312"><ph name="PAGE_TITLE"/> - Browther Canary</translation>
<translation id="7893465573639396635">Κάντε πιο δύσκολο για άτομα που έχουν πρόσβαση στη διαδικτυακή κίνησή σας να βλέπουν ποιους ιστοτόπους επισκέπτεστε. Το Browther χρησιμοποιεί μια ασφαλή σύνδεση για να αναζητήσει τη διεύθυνση IP ενός ιστοτόπου στο DNS (Domain Name System).</translation>
<translation id="7810005234485217901">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση</translation>
<translation id="2462631024103158515">Υπάρχει ήδη σε αυτήν τη συσκευή ένα προφίλ Browther με αυτόν τον λογαριασμό</translation>
<translation id="7845233973568007926">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε τον υπολογιστή σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="311190437086049332">Προσαρμόστε το Browther για να του δώσετε μια νέα εμφάνιση</translation>
<translation id="6728847658878265103">Δεν ήταν δυνατή η ενημέρωση του Browther στην τελευταία έκδοση και έτσι δεν θα έχετε πρόσβαση στις νέες λειτουργίες και στις επιδιορθώσεις ασφαλείας.</translation>
<translation id="7872446069773932638">Λήψη… Απομένουν <ph name="SECONDS"/> δευτερόλεπτα.</translation>
<translation id="5374532739787768601">Εάν ξεχάσετε τη φράση πρόσβασης ή θέλετε να αλλάξετε αυτή τη ρύθμιση, <ph name="BEGIN_LINK"/>διαγράψτε τα δεδομένα του Browther στον λογαριασμό σας<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">Ερώτηση σχετικά με αυτή την εικόνα</translation>
<translation id="9172499982238113829">Ορισμός του Browther ως προεπιλογής</translation>
<translation id="3313826726620159669">Το Browther αναβαθμίζει αυτόματα τις μη ασφαλείς συνδέσεις σε HTTPS, όταν είναι εφικτό</translation>
<translation id="3317928686912559532">Συνδεθήκατε στο Browther ως <ph name="USER_EMAIL_ADDRESS"/>. Χρησιμοποιήστε τον ίδιο λογαριασμό για να συνδεθείτε ξανά.</translation>
<translation id="6007009085341946457">Αυτή είναι μια δευτερεύουσα εγκατάσταση του Browther και δεν μπορεί να γίνει το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="8004582292198964060">Πρόγραμμα περιήγησης</translation>
<translation id="8010081455002666927">Αυτόματος εντοπισμός</translation>
<translation id="174885789898161653">Όταν το Browther αποκτήσει πρόσβαση, οι ιστότοποι θα μπορούν να σας ζητήσουν πρόσβαση.</translation>
<translation id="3001754454174546602">Καρφιτσώστε το Browther στη γραμμή εργαλείων για γρήγορη πρόσβαση ανά πάσα στιγμή</translation>
<translation id="80471789339884597">Ευχαριστούμε για την εγκατάσταση. Πρέπει να επανεκκινήσετε όλα τα προγράμματα περιήγησής σας πριν από τη χρήση του <ph name="BUNDLE_NAME"/>.</translation>
<translation id="8054112667659782652">Να εμφανίζεται πάντα η συντόμευση Αναζήτησης με εικόνες</translation>
<translation id="6993312779622863465">Απενεργοποίηση του Browther, όταν εκτελούνται εφαρμογές στο παρασκήνιο</translation>
<translation id="80790299200510644">Αναζήτηση με εικόνες</translation>
<translation id="8086881907087796310">Η εγκατάσταση απέτυχε επειδή ο υπολογιστής σας δεν πληροί τις ελάχιστες απαιτήσεις εξοπλισμού.</translation>
<translation id="4734875482699037091"><ph name="PAGE_TITLE"/> – Browther for Testing</translation>
<translation id="543407324609820492">Το Browther χρειάζεται άδεια τοποθεσίας για αυτόν τον ιστότοπο.</translation>
<translation id="1767887552863788514">Την επόμενη φορά που θα ανοίξετε το Browther στη συσκευή <ph name="DEVICE_TYPE"/>, θα δείτε μια προτροπή για ενεργοποίηση των ειδοποιήσεων παρακολούθησης τιμής.</translation>
<translation id="8118331347066725040">Αποστολή σχολίων για την αναζήτηση με το Lens</translation>
<translation id="5334309298019785904">Δεν ήταν δυνατός ο συγχρονισμός των δεδομένων σας από το Chrome OS, επειδή ο συγχρονισμός δεν είναι διαθέσιμος για τον τομέα σας.</translation>
<translation id="813913629614996137">Εκκίνηση…</translation>
<translation id="4879101934056397619">Πρόσθετοι Όροι Παροχής Υπηρεσιών του Browther</translation>
<translation id="4505690237431768764">Αυτό το αρχείο είναι επικίνδυνο και έχει αποκλειστεί από το Browther.</translation>
<translation id="8177472873527554730">Δεν είναι δυνατή η εύρεση περιεχομένου στη σελίδα</translation>
<translation id="4720341280133158605">Εισαγάγετε τη φράση πρόσβασης, για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον λογαριασμό σας, <ph name="USER_EMAIL"/></translation>
<translation id="8221491193165283816">Συνήθως αποκλείετε τις ειδοποιήσεις. Για να επιτρέψετε σε αυτόν τον ιστότοπο να σας στέλνει ειδοποιήσεις, κάντε κλικ εδώ.</translation>
<translation id="1083711467946065278">Για χρήση της κάμερας, παραχωρήστε πρόσβαση στο Browther στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="6569785137733211804">Το Browther δεν μπορεί να επαληθεύσει την προέλευση αυτής της επέκτασης και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Browther, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων.</translation>
<translation id="1122818205373648656">Εάν μια εικόνα δεν έχει κάποια χρήσιμη περιγραφή, το Browther θα προσπαθήσει να σας προσφέρει μια περιγραφή. Για τη δημιουργία περιγραφών, αποστέλλονται εικόνες στην Browther. Μπορείτε να απενεργοποιήσετε αυτήν τη λειτουργία στις ρυθμίσεις οποιαδήποτε στιγμή.</translation>
<translation id="6877990294324319801">Σύνδεση στο Browther με νέο προφίλ;</translation>
<translation id="6478811748813986578"><ph name="BEGIN_LINK"/>Το Browther σας προειδοποιεί<ph name="END_LINK"/> σχετικά με μη ασφαλείς ιστοτόπους και λήψεις</translation>
<translation id="1685486387921540822">Δεν έχετε επισκεφτεί πρόσφατα τον ιστότοπο. Το Browther κατάργησε την άδεια <ph name="PERMISSION"/>.</translation>
<translation id="8921153410460268589">Αγοράστε, μεταφράστε και προσδιορίστε ό,τι βλέπετε με την κάμερα στην εφαρμογή Browther iOS</translation>
<translation id="8313851650939857356">Σφάλμα εκκίνησης: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">Ο οργανισμός σας κλείνει το Browther όταν δεν χρησιμοποιείται για <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">Αποθήκευση ως εικόνα</translation>
<translation id="143016831128278157">Συνδεθείτε, για να συγχρονίσετε και να εξατομικεύσετε το Browther στις συσκευές σας</translation>
<translation id="4784945022248750283">Η διεύθυνση <ph name="USER_EMAIL_ADDRESS"/> χρησιμοποιούσε το Browther στο παρελθόν</translation>
<translation id="1288164710697017468">Ενημερώστε το Browther, για να συνεχίσετε να χρησιμοποιείτε τα δεδομένα του Browther στον Λογαριασμό σας Browther, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="8648401677359150296">Για τη λήψη μελλοντικών ενημερώσεων του Browther, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.</translation>
<translation id="8362914115861174987">Μετάφραση στα</translation>
<translation id="8367705492654390392">Ρωτήστε οτιδήποτε</translation>
<translation id="5769022907892823357">Για να έχετε πρόσβαση στους κωδικούς πρόσβασής σας και σε άλλα στοιχεία σε όλες τις συσκευές σας, συνδεθείτε στο Browther. Αυτός ο κωδικός πρόσβασης θα αποθηκευτεί στον Λογαριασμό σας Browther αφού συνδεθείτε.</translation>
<translation id="4782442810031768771">Στη συνέχεια, θα πρέπει να επανεκκινήσετε το Browther.</translation>
<translation id="8265348385714408341">Το Browther προτείνει να την καταργήσετε. <ph name="BEGIN_LINK"/>Μάθετε περισσότερα σχετικά με τις υποστηριζόμενες επεκτάσεις<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">Η δημοσίευση αυτής της επέκτασης καταργήθηκε από τον προγραμματιστή της και ενδέχεται να μην είναι ασφαλής. Καταργήστε την από το Browther, ώστε να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα σας σε ιστοτόπους που επισκέπτεστε, συμπεριλαμβανομένων των προσωπικών στοιχείων σας.</translation>
<translation id="1613655732912855341">Το Browther πρέπει να επαληθεύσει την ταυτότητά σας, για να είναι δυνατή η αποθήκευση ορισμένων δεδομένων στον Λογαριασμό σας Browther και η χρήση τους σε όλες τις συσκευές σας. Εάν αποσυνδεθείτε τώρα, αυτά τα δεδομένα θα διαγραφούν.</translation>
<translation id="9103715009358215214">{0,plural, =1{Επανεκκίνηση του Browther σε μία ημέρα}other{Επανεκκίνηση του Browther σε # ημέρες}}</translation>
<translation id="8438543370129609977">Όταν χρησιμοποιείτε την Αναζήτηση με εικόνες, ο τίτλος, το URL και το περιεχόμενο της σελίδας, συμπεριλαμβανομένων των PDF, αποστέλλονται στον διακομιστή. <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">Μάθετε περισσότερα σχετικά με την αναζήτηση με την Αναζήτηση εικόνων στο Browther</translation>
<translation id="1401757916223057494">Το αρχείο του προγράμματος εγκατάστασης είναι κατεστραμμένο ή μη έγκυρο. Κατεβάστε το Browther ξανά.</translation>
<translation id="5029760494698649486">Το Browther απαιτεί Windows 10 ή νεότερη έκδοση.</translation>
<translation id="7906734902028783072">Προαιρετικό: Συμβάλετε στη βελτίωση των λειτουργιών και της απόδοσης του Chrome OS με αυτόματη αποστολή διαγνωστικών και δεδομένων χρήσης στην Browther.</translation>
<translation id="6791756730901393492">Για να χρησιμοποιήσετε και να αποθηκεύσετε δεδομένα Browther στον Λογαριασμό σας Browther, επαληθεύστε την ταυτότητά σας</translation>
<translation id="4879869745782826167">Εμφάνιση οδηγιών για σύνδεση στο Browther</translation>
<translation id="2967761098021401720">Το Browther δεν είναι ενημερωμένο</translation>
<translation id="7674832651694000881">Σας ευχαριστούμε που ορίσατε το Browther ως το προεπιλεγμένο πρόγραμμα περιήγησης!</translation>
<translation id="4507581730979762077">Το Browther μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν τους αποθηκεύετε</translation>
<translation id="7205233182271132386">Λάβετε ειδοποίηση, εάν το Browther εντοπίσει έναν από τους κωδικούς πρόσβασής σας σε μια δημόσια παραβίαση δεδομένων</translation>
<translation id="8555465886620020932">Σφάλμα υπηρεσίας: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">Μπορείτε να καρφιτσώσετε την Αναζήτηση με εικόνες για εύκολη πρόσβαση. Κάντε κλικ στο κουμπί Καρφίτσωμα στο επάνω μέρος του πλαϊνού πλαισίου</translation>
<translation id="856656450041460113">Αναζήτηση λίστας γλωσσών</translation>
<translation id="75470458211269379">Το Browther μπορεί να ελέγξει τους κωδικούς πρόσβασής σας όταν συνδέεστε με τον Λογαριασμό σας Browther.</translation>
<translation id="2108930010779660436">Πολλοί οργανισμοί διαχειρίζονται το Browther</translation>
<translation id="7209630341463003999">Πνευματικά δικαιώματα <ph name="YEAR"/> Οι συντάκτες του Browther. Με επιφύλαξη παντός δικαιώματος.</translation>
<translation id="8601359445272098721">Νέο! Μπορείτε να μεταφράσετε κείμενο και εικόνες που εμφανίζονται στην οθόνη σας, επιλέγοντας το κουμπί Μετάφραση οθόνης</translation>
<translation id="782928371899183269">Εκκίνηση του Browther…</translation>
<translation id="8624541899164515475">Ρυθμίσεις, ανοίγει σε νέα καρτέλα.</translation>
<translation id="5879341334716115002">Το Browther for Testing δεν μπορεί να οριστεί ως το προεπιλεγμένο πρόγραμμα περιήγησης.</translation>
<translation id="2433912322225810055">Επίσης, ελέγχει τη σελίδα που εμφανίζεται κατά την εκκίνηση του Browther ή όταν κάνετε αναζήτηση από το κύριο πλαίσιο.</translation>
<translation id="4816541973978692496">Ορίστε το δικό σας Browther</translation>
<translation id="8712637175834984815">Κατάλαβα!</translation>
<translation id="9037464035997618895">Σύνδεση στο Browther;</translation>
<translation id="7897185368811431919">Διατηρήστε τα πάντα στο Browther</translation>
<translation id="8747073452963259673">κάτω αριστερή γωνία της περιοχής αναζήτησης: αριστερά <ph name="LEFT"/>%, κάτω <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">Σφάλμα εγκατάστασης: Ο διαχειριστής του δικτύου σας έχει εφαρμόσει μια πολιτική ομάδας που εμποδίζει την εγκατάσταση: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">Το Browther χρειάζεται άδεια, για να αποκτήσει πρόσβαση στην κάμερα και στο μικρόφωνο για αυτόν τον ιστότοπο</translation>
<translation id="8813277370772331957">Υπενθύμιση αργότερα</translation>
<translation id="6831999464349484462">Σύνδεση στο Browther;</translation>
<translation id="3698151322107951111">Ορισμός Browther ως προεπιλεγμένο πρόγραμμα περιήγησης και καρφίτσωμα στη γραμμή εργαλείων</translation>
<translation id="8826492472752484139">Κάντε κλικ στην επιλογή Διαχείριση κωδικών πρόσβασης</translation>
<translation id="6933858244219479645">Σύστημα Chrome OS</translation>
<translation id="3986927308621489499">Αυτή η γλώσσα χρησιμοποιείται για την προβολή μενού, ρυθμίσεων, ειδοποιήσεων και άλλου κειμένου στο Browther</translation>
<translation id="8862326446509486874">Δεν έχετε τα απαραίτητα δικαιώματα για εγκατάσταση σε επίπεδο συστήματος. Δοκιμάστε να εκτελέσετε ξανά το πρόγραμμα εγκατάστασης ως Διαχειριστής.</translation>
<translation id="5318226144018267261">Προσθήκη προφίλ Browther</translation>
<translation id="1298790608554316415">Σε αυτή την περίπτωση, επεξεργαστείτε τον αποθηκευμένο κωδικό πρόσβασής σας στο Browther έτσι ώστε να ταιριάζει με τον νέο κωδικό πρόσβασής σας.</translation>
<translation id="960933321883777733">Ο οργανισμός σας απαιτεί να συνδεθείτε στο Browther</translation>
<translation id="948979409756947611">Το Browther προσπαθεί να εμφανίσει τους κωδικούς πρόσβασης. Πληκτρολογήστε τον κωδικό πρόσβασής σας Windows για να το επιτρέψετε αυτό.</translation>
<translation id="1418854271943945136">Το Browther δεν είναι πλέον το προεπιλεγμένο πρόγραμμα περιήγησης. Θέλετε να ορίσετε το Browther ως το προεπιλεγμένο πρόγραμμα περιήγησης;</translation>
<translation id="7228667329366610727">Δεν είναι δυνατή η ενημέρωση του Browther</translation>
<translation id="4817697255467736794">Λογότυπο Browther Enterprise</translation>
<translation id="3507731466523097529">Δεν είναι δυνατή η έναρξη του Browther, επειδή προέκυψε πρόβλημα κατά το άνοιγμα του προφίλ σας. Δοκιμάστε να επανεκκινήσετε το Browther.</translation>
<translation id="3234473600657230663">Διαχείριση προφίλ Browther</translation>
<translation id="8953887022581653484">Το Browther απέκλεισε αυτή τη λήψη, επειδή το αρχείο αρχειοθέτησης περιλαμβάνει άλλα αρχεία που ενδέχεται να κρύβουν κάποιο κακόβουλο πρόγραμμα</translation>
<translation id="532304972436358335">Σύνδεση στο Browther όταν συνδέεστε σε άλλες υπηρεσίες Browther</translation>
<translation id="3425998261052065067">Το Browther έκλεισε αυτόματα</translation>
<translation id="4377377022617011492">Το Browther δεν είναι ενημερωμένο</translation>
<translation id="3247296757162889864">{0,plural, =1{Η επανεκκίνηση του Browther θα γίνει σε μία ώρα}other{Η επανεκκίνηση του Browther θα γίνει σε # ώρες}}</translation>
<translation id="9106236359747881194">Επιλογή κειμένου για αναζήτηση</translation>
<translation id="5115014198092384730">Για τη λήψη μελλοντικών ενημερώσεων του Browther, θα χρειαστείτε Windows 10 ή νεότερη έκδοση. Αυτός ο υπολογιστής χρησιμοποιεί Windows 8.1.</translation>
<translation id="7129101984664345614">Άνοιγμα Συνδέσμου σε Νέα καρτέ&amp;λα Browther</translation>
<translation id="911206726377975832">Να γίνει διαγραφή και των δεδομένων περιήγησης;</translation>
<translation id="9134482777260927479">Βοήθεια για σχολικές εργασίες</translation>
<translation id="9148058034647219655">Έξοδος</translation>
<translation id="1734388504720121468">Συνεχίστε από το σημείο που σταματήσατε: Το Browther μπορεί να επαναφέρει τις καρτέλες σας κάθε φορά που κάνετε επανεκκίνηση. Για να ενεργοποιήσετε αυτή τη ρύθμιση, μεταβείτε στην ενότητα</translation>
<translation id="8633974232736772207">Ο διαχειριστής συστήματος έχει διαμορφώσει το Browther έτσι ώστε να ανοίγει άλλο πρόγραμμα περιήγησης για την πρόσβαση στη διεύθυνση <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="1122669402846843682">Συμβουλή για το Browther: Αναζήτηση με το Lens</translation>
<translation id="595330134356385835">Επανεκκίνηση για ενημέρωση του &amp;Browther</translation>
<translation id="4659389438500978709">Browther (mDNS-In)</translation>
<translation id="6491100124044190139">Αποκτήστε περισσότερα όταν είστε συνδεδεμένοι στο Browther</translation>
<translation id="1665840797775025867">Εξατομίκευση του Browther</translation>
<translation id="4407047432656809023">Το Browther μπορεί να μην λειτουργεί σωστά, επειδή δεν υποστηρίζεται πια σε Windows XP και Windows Vista</translation>
<translation id="945522503751344254">Αποστολή σχολίων</translation>
<translation id="7620348044248809366">Ποιος χρησιμοποιεί το Browther;</translation>
<translation id="7299962884342109067">Λάβετε την ισχυρότερη προστασία του Browther</translation>
<translation id="983803489796659991">Η εγκατάσταση απέτυχε επειδή ο διακομιστής ενημέρωσης δεν διαθέτει δεδομένα κατακερματισμού για την εφαρμογή.</translation>
<translation id="8775461190334353148">Χρήση του Browther χωρίς λογαριασμό</translation>
<translation id="7146761239544860058">Οι συντάκτες του Browther</translation>
<translation id="989970834842471429">Επιλέξτε οποιοδήποτε κείμενο ή εικόνα για αναζήτηση με την Αναζήτηση με εικόνες</translation>
<translation id="6616551030373607751">Για χρήση της τοποθεσίας σας, παραχωρήστε πρόσβαση στο Browther στις <ph name="BEGIN_LINK"/>ρυθμίσεις συστήματος<ph name="END_LINK"/></translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">Η εγκατάσταση απέτυχε λόγω μη καθορισμένου σφάλματος. Κατεβάστε το Browther ξανά.</translation>
<translation id="9074842261125908635">Οι επεκτάσεις, οι εφαρμογές και τα θέματα από άγνωστες πηγές μπορούν να βλάψουν τη συσκευή σας. Το Browther συνιστά την εγκατάστασή τους μόνο από το <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="3593119910409528681">Η επέκταση αυτή παραβιάζει την πολιτική του διαδικτυακού καταστήματος. Αφαιρέστε τη από τον Browther, για να μην μπορεί πλέον να βλέπει και να αλλάζει τα δεδομένα στους ιστότοπους που επισκέπτεστε, ούτε τα προσωπικά στοιχεία σας.</translation>
<translation id="5245976396374147971">Προειδοποίηση: Το Browther δεν μπορεί να αποτρέψει την καταγραφή του ιστορικού περιήγησης από τις επεκτάσεις. Για να απενεργοποιήσετε αυτήν την επέκταση σε Ιδιωτική λειτουργία, καταργήστε αυτήν την επιλογή.</translation>
<translation id="3629539416935660172">Για να κάνουμε το Browther πιο ασφαλές, απενεργοποιήσαμε ορισμένες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="157534302749986451">Για να κάνουμε το Browther πιο ασφαλές, απενεργοποιήσαμε τις ακόλουθες επεκτάσεις που δεν αναφέρονται στο <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> και ενδέχεται να έχουν προστεθεί εν αγνοία σας.</translation>
<translation id="3031052147361385845">Ανοίξτε τον σύνδεσμο σε &amp;ιδιωτικό παράθυρο Browther</translation>
<translation id="5556794247782664281">Άνοιγμα συνδέσμου σε &amp;Ιδιωτικό παράθυρο Browther</translation>
<translation id="4555500675737067970">{COUNT, plural,
          =0 {Μια νέα ενημέρωση για το Browther είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση.}
          =1 {Μια νέα ενημέρωση για το Browther είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
          other {Μια νέα ενημέρωση για το Browther είναι διαθέσιμη και θα εφαρμοστεί μόλις κάνετε επανεκκίνηση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="6181263681651521876">{COUNT, plural,
              =0 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το Browther για να εφαρμόσετε αυτήν την ενημέρωση}
              =1 {Ο διαχειριστής σας ζητά να επανεκκινήσετε το Browther για να εφαρμόσετε αυτήν την ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας ζητά να επανεκκινήσετε το Browther για να εφαρμόσετε αυτήν την ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="1341091418019636353">{COUNT, plural,
              =0 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Browther για να εφαρμόσετε μια ενημέρωση}
              =1 {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Browther για να εφαρμόσετε μια ενημέρωση. Το Ιδιωτικό σας παράθυρο δεν θα ανοίξει ξανά.}
              other {Ο διαχειριστής σας απαιτεί να επανεκκινήσετε το Browther για να εφαρμόσετε μια ενημέρωση. Τα # Ιδιωτικά παράθυρά σας δεν θα ανοίξουν ξανά.}}</translation>
<translation id="8762228142105311329">{COUNT, plural,
              =0 {Η προηγμένη προστασία απαιτεί να επανεκκινήσετε το Browther για να εφαρμόσετε μια ενημέρωση}
              =1 {Η προηγμένη προστασία απαιτεί να επανεκκινήσετε το Browther για να εφαρμόσετε μια ενημέρωση. Το ιδιωτικό σας παράθυρο δεν ανοίγει ξανά.}
              other {Η Προστασία για προχωρημένους απαιτεί να επανεκκινήσετε το Browther για να εφαρμόσετε μια ενημέρωση. Τα # ιδιωτικά παράθυρα δεν ανοίγουν ξανά.}}</translation>
<translation id="5749154344207139683">Βοηθήστε μας να βελτιώσουμε το Private, συμμετέχοντας σε αυτή την έρευνα διάρκειας 1 λεπτού.</translation>
<translation id="6954203250660846933">Όταν πληκτρολογείτε κάτι στη γραμμή διευθύνσεων ή στο πλαίσιο αναζήτησης, το Browther στέλνει το περιεχόμενο που πληκτρολογείτε στην προεπιλεγμένη μηχανή αναζήτησής σας για να λαμβάνετε καλύτερες προτάσεις. Αυτή η επιλογή είναι απενεργοποιημένη στην Ιδιωτική λειτουργία.</translation>
<translation id="3542179014707218534">Ιδιωτική λειτουργία Browther</translation>
<translation id="2076355018722231995">Κατά την Ανώνυμη Περιήγηση, ο Browther θα σας προειδοποιεί πριν φορτώσετε κάποια ιστοσελίδα με μη ασφαλή σύνδεση</translation>
</translationbundle>