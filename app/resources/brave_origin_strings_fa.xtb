<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="7099479769133613710">‏راه‌اندازی مجدد برای به‌روزرسانی ChromeOS</translation>
<translation id="7264054672589027446">‏Browther توصیه می‌کند این افزونه را بررسی کنید</translation>
<translation id="7848219163187166649">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Browther از سرورهای Browther استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Browther متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="8837164267124113709">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای Browther خاموش کرده است</translation>
<translation id="881513728707488138">‏Browther می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="112640046208448578">چیزها یا مکان‌ها را شناسایی کنید و نوشتار را کپی یا ترجمه کنید. وقتی از «جستجوی تصویر» استفاده می‌کنید، نماگرفتی از صفحه به سرور ارسال می‌شود. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">‏Browther مرورگر پیش‌فرضتان است</translation>
<translation id="6580138787163923852">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK"/>به سیستم Browther وارد شوید<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">‏روی منو Browther کلیک کنید</translation>
<translation id="1157985233335035034">زبان‌های اخیر</translation>
<translation id="3673786631598474384">‏‫<ph name="PARTNER_NAME"/> افزونه‌ای اضافه کرده است که ممکن است نحوه کارکرد Browther را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">‏نصب انجام نشد چون از نسخه Windows شما پشتیبانی نمی‌شود.</translation>
<translation id="8291401179516272335">‏درباره Browther</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1232234696885483911">‏وقتی‌که «جستجوی تصویر» را باز می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به‌طور خودکار به سرور ارسال می‌شوند. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و سایر داده‌های «حساب Browther» خود در Browther استفاده کنید. برای تغییر دادن این تنظیم، به «حساب شما در Browther» بروید.</translation>
<translation id="9034321258761608912">‏وقتی این زبانه غیرفعال بود، مقداری از حافظه آزاد شد تا سرعت Browther حفظ شود. می‌توانید انتخاب کنید این سایت همیشه از غیرفعال شدن مستثنی شود.</translation>
<translation id="249571811018731941">‏‫Browther این بارگیری را مسدود کرد زیرا این فایل خطرناک است</translation>
<translation id="8850227089720975601">‏وقتی با <ph name="USER_EMAIL"/> به سیستم سرویس‌های Browther مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Browther وارد شوید</translation>
<translation id="1290883685122687410">خطای راه‌اندازی: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">‏راه‌اندازی نمایه Browther جدید</translation>
<translation id="4437862975743821367">‏‫Browther برای کاوش دستگاه‌های بلوتوث
باید به بلوتوث دسترسی داشته باشد. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">تشخیص دادن زبان</translation>
<translation id="1206925267243987362">‏استفاده از تنظیمات مرورگر توصیه‌شده Browther</translation>
<translation id="8270483548049772782">‏داده‌ها از Browther هم حذف شود (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">سنجاق شد! دفعه بعد می‌توانید «جستجوی تصویر» را ازطریق این دکمه جدید در نوارابزار باز کنید</translation>
<translation id="1356661055722410047">جدید! می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="1383876407941801731">جستجو</translation>
<translation id="1592588950737518481">‏مدیریت نمایه‌های Browther</translation>
<translation id="1404026649028693342">نمایش همیشه «حالت هوشواره‌ای»</translation>
<translation id="141901961143729572">افکارتان را هم‌رسانی</translation>
<translation id="1743952081001089298">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Browther مجاز کنید.</translation>
<translation id="8627385813382688019">‏دریافت راهنمایی درباره Browther for Testing</translation>
<translation id="1497802159252041924">خطای نصب: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">این صفحه محافظت شده است</translation>
<translation id="7252430412915798987">‏هم‌رسانی برگه Browther</translation>
<translation id="6388429281015199562">‏ورود به سیستم Browther</translation>
<translation id="1547469039832541117">تکلیف برجسته‌شده را به‌پایان می‌رساند.</translation>
<translation id="1801944307203212016">‏Browther برای ایجاد نقشه سه‌بعدی محیط شما باید اجازه دسترسی به دوربین داشته باشد</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{‏دیگر از این افزونه پشتیبانی نمی‌شود. ‫Browther توصیه می‌کند آن را حذف کنید.}one{‏دیگر از این افزونه‌ها پشتیبانی نمی‌شود. ‫Browther توصیه می‌کند آن‌ها را بردارید.}other{‏دیگر از این افزونه‌ها پشتیبانی نمی‌شود. ‫Browther توصیه می‌کند آن‌ها را بردارید.}}</translation>
<translation id="4667068923142532753">‏سنجاق کردن Browther</translation>
<translation id="3006560544901646947">‏ابزارهای ایمنی Browther</translation>
<translation id="686052171138185761">‏‫Browther می‌خواهد داده‌های «مدیر گذرواژه» شما را حذف کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8713026329083542796">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Browther</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1680687534629375545">پرسیدن از «جستجوی تصویر» درباره این صفحه</translation>
<translation id="1709772298389099340">امتیازهای عالی برای <ph name="BROWSER_NAME"/> ارائه می‌دهد.</translation>
<translation id="4243382967656566037">‏برای کمک به بهبود این ویژگی‌ها، Browther تعاملات شما با این ویژگی‌ها را به Browther ارسال می‌کند. ممکن است افراد بازبین این داده‌ها را بخوانند، و پردازش و حاشیه‌نویسی کنند.</translation>
<translation id="1722488837206509557">این کار به شما امکان می‌دهد از بین دستگاه‌های دردسترس انتخاب کنید و محتوا را در آن‌ها نمایش دهید.</translation>
<translation id="6820510278633522408">‏Browther به‌زودی داده‌های مرور را حذف می‌کند</translation>
<translation id="7775028004939172516">‏Browther سعی می‌کند پیمایش‌ها را به HTTPS ارتقا دهد</translation>
<translation id="6963959729951758069">‏داده‌های Browther پاک شد</translation>
<translation id="4085139922884095932">‏Browther تا <ph name="REMAINING_TIME"/> دیگر بازراه‌اندازی خواهد شد</translation>
<translation id="2586248102295515296">‏وقتی HTTPS دردسترس نباشد، Browther بدون دادن هشدار به شما از اتصال ناامن استفاده می‌کند</translation>
<translation id="3975328336074677101">‏اجازه به Browther برای اجرا در پس‌زمینه</translation>
<translation id="2497443204974841650">‏نصب مجدد Browther</translation>
<translation id="1724309687045787742">‏Browther در تلاش است <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">‏دفعه بعد که Browther را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از «مدیر گذرواژه Browther» خواهید دید.</translation>
<translation id="1838374766361614909">پاک کردن جستجو</translation>
<translation id="2337233040802538155">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Browther»، <ph name="BEGIN_LINK"/>از سیستم Browther خارج شوید<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">‏با بارگیری Browther در تلفنتان، درحال حرکت گروه‌های برگه جدید باز کنید یا بسازید.</translation>
<translation id="2063443520349987970">‏می‌توانید «حساب‌های Browther» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Browther» شما در مرورگر Browther، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE"/> خود اضافه کنید. <ph name="LINK_BEGIN"/>بیشتر بدانید<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">جستجو کردن با «جستجوی تصویر»</translation>
<translation id="1880677175115548835">انتخاب نوشتار</translation>
<translation id="3183933389992069620">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Browther خود را می‌دهید. داده‌های Browther شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Browther حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Browther موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">‏‫Browther با محدود کردن فعالیت پس‌زمینه و جلوه‌های دیداری، مثل پیمایش روان و نرخ فریم ویدیو، در مصرف باتری صرفه‌جویی می‌کند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی انرژی» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">پرسش درباره این صفحه</translation>
<translation id="9128006428501241840">‏سرویس به‌روزرسان Browther</translation>
<translation id="6302815314157879372">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Browther به سیستم سایت‌های Browther مانند Gmail وارد شوید</translation>
<translation id="1063611196035804685">‏Browther پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="2873360330889594383">‏سازمانتان (<ph name="MANAGER"/>) شما را ملزم می‌کند به سیستم Browther وارد شوید</translation>
<translation id="4035053306113201399">‏برای اعمال به‌روزرسانی، ChromeOS باید بازراه‌اندازی شود.</translation>
<translation id="2861285003831382718">‏‫Browther این بارگیری را مسدود کرد زیرا این نوع فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE"/> دقیقه باقی مانده است</translation>
<translation id="2080160985220483492">‏نکته Browther: گذرواژه‌ها را ذخیره کنید</translation>
<translation id="8037497710694492565">‏Browther نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="7395009124247513849">‏ببینید چرا Browther برخی‌از فایل‌ها را مسدود می‌کند، در زبانه جدید باز می‌شود</translation>
<translation id="762710512520170632">‏نرم‌افزار Browther را به‌روز نگه می‌دارد. اگر این سرویس غیرفعال یا متوقف شود، نرم‌افزار Browther به‌روز نخواهد ماند، به این معنی که آسیب‌پذیری‌های امنیتی احتمالی برطرف نمی‌شود و ممکن است ویژگی‌ها کار نکنند. این سرویس زمانی‌که هیچ نرم‌افزار Browther از آن استفاده نکند، خود را حذف نصب می‌کند.</translation>
<translation id="5793588180426267429">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Browther وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="6351516710581760512">‏برای بررسی اینکه از دیگر گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK"/>به سیستم Browther وارد شوید<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">تنظیمات.</translation>
<translation id="8194525816714210105">‏انتخاب کنید که آیا سابقه Browther برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Browther لحاظ شود یا نه</translation>
<translation id="5909559127548969159">‏روی دکمه «سفارشی‌سازی Browther» در «صفحه زبانه جدید» کلیک کنید و ظاهری جدید به Browther ببخشید</translation>
<translation id="2066690553719545730">نمایش همیشه «حالت هوشواره‌ای»</translation>
<translation id="3283892260110318935">‏‫Browther این بارگیری را مسدود کرد زیرا این فایل فریب‌دهنده است و ممکن است تغییرات غیرمنتظره‌ای در دستگاهتان ایجاد کند</translation>
<translation id="6160571936643742128">‏دفعه بعد که Browther iOS را باز می‌کنید، پیام‌واره‌ای برای امتحان کردن «<ph name="FEATURE_NAME"/>» خواهید دید.</translation>
<translation id="8380517409933452343">‏گذرواژه‌ها و دیگر داده‌های Browther که در «حساب Browther» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Browther، دوباره به سیستم وارد شوید.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Browther استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}one{‏اگر به‌مدت # دقیقه از Browther استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}other{‏اگر به‌مدت # دقیقه از Browther استفاده نشود، سازمانتان داده‌های مرور را به‌طور خودکار حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود. برگه‌هایتان باز خواهد ماند.}}</translation>
<translation id="2126108037660393668">فایل بارگیری‌شده تأیید نشد.</translation>
<translation id="2135919691573380097">گزارش کردن این سایت</translation>
<translation id="2137162749895930932">بستن صفحه ترجمه</translation>
<translation id="4283559398694996391">‏‫Browther این بارگیری را مسدود کرد زیرا این سایت از اتصال ایمن استفاده نمی‌کند و ممکن است فایل دستکاری شده باشد</translation>
<translation id="2170098639895543546">هر چیزی در صفحه را انتخاب کنید</translation>
<translation id="2495182092286337191">‏سفارشی کردن Browther</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="4877141231724140862">‏Browther - ورود به سیستم شبکه - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">خطای بررسی به‌روزرسانی: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">‏برداشتن حساب از Browther</translation>
<translation id="1084363153644366288">‏با «مرور ایمن پیشرفته» در Browther برای iOS، درحرکت ایمن‌تر مرور کنید</translation>
<translation id="7949164640723239455">‏سایت خطرناک. ‫Browther اعلان‌ها را برداشت.</translation>
<translation id="2236949375853147973">فعالیت‌هایم</translation>
<translation id="4536403809133456417">‏برای دریافت نشانی‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانی در «حساب Browther» شما ذخیره خواهد شد.</translation>
<translation id="5627930103267312171">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Browther را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="2283803047247799269">این زبانه با «جستجوی تصویر» جستجو شود</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{‏‫Browther توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Browther توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Browther توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="2307973900865360088">‏نگه داشتن در Dock</translation>
<translation id="5161617112768367959">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Browther ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Browther ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="4123094831918713833">‏با این اقدام:
          <ph name="LINE_BREAKS"/>
           • برخی‌از تنظیمات Browther و میان‌برهای Browther بازنشانی می‌شوند
           <ph name="LINE_BREAK"/>
           • افزونه‌ها غیرفعال می‌شوند
           <ph name="LINE_BREAK"/>
           • کوکی‌ها و دیگر داده‌های موقت سایت حذف می‌شوند
            <ph name="LINE_BREAKS"/>
           نشانک‌ها، سابقه، و گذرواژه‌های ذخیره‌شده تحت‌تأثیر قرار نمی‌گیرند.</translation>
<translation id="5456070119344236353">‏برای ارسال شماره از اینجا به تلفن Android خود، در هر دو دستگاه به سیستم Browther وارد شوید.</translation>
<translation id="2356070529366658676">سؤال شود</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="6468415397021485143">‏افزونه «<ph name="EXTENSION_NAME"/>» از شما می‌خواهد به سیستم Browther وارد شوید</translation>
<translation id="2558600429878197587">‏غیرفعال کردن اجرای Browther در پس‌زمینه برای برنامه‌ها</translation>
<translation id="5295781918312989856">‏برای استفاده از این افزونه با حساب <ph name="USER_EMAIL_ADDRESS"/>، به سیستم Browther وارد شوید.</translation>
<translation id="8418845734693287262">‏ChromeOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Browther به یک «دستگاه میانای انسانی» (HID) دسترسی داشتند}=1{‏یک یا چند افزونه Browther به یک «دستگاه میانای انسانی» (HID) دسترسی دارند}one{‏یک یا چند افزونه Browther به # «دستگاه میانای انسانی» (HID) دسترسی دارند}other{‏یک یا چند افزونه Browther به # «دستگاه میانای انسانی» (HID) دسترسی دارند}}</translation>
<translation id="434258293817844111">‏Browther برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2403703063067034158">خطای راه‌اندازی: فعلاً راه‌اندازی دیگری درحال اجرا است، لطفاً کمی بعد دوباره امتحان کنید.</translation>
<translation id="5458993228789433099">‏پیوندها را از هر برنامه‌ای در Browther باز کنید و مرورگر را در نوار وظیفه دردسترس نگه دارید</translation>
<translation id="1677640217693742525">‏با <ph name="BEGIN_LINK"/>ابزارهای Browther<ph name="END_LINK"/>، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="2451727308784734061">از میان‌بر برای دسترسی سریع به «مدیر گذرواژه» استفاده کنید. می‌توانید میان‌برتان را به صفحه اصلی رایانه یا راه‌انداز برنامه منتقل کنید.</translation>
<translation id="2280315911954332435">‏Browther به‌زودی بسته می‌شود</translation>
<translation id="6410820860979094113">‏در Browther</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="2513154137948333830">بازراه‌اندازی لازم است: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">نوشتاری را برای استفاده از «جستجوی تصویر» انتخاب کنید</translation>
<translation id="7892218991241200190">‏Browther می‌خواهد گذواژه‌های موجود را جایگزین کند. برای مجاز کردن این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="8976443723926188033">‏Browther برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="4131374838781785973">Browther Origin Helper</translation>
<translation id="2575822587468774919">هرچیزی را می‌خواهید انتخاب کنید تا با «جستجوی تصویر» جستجو شود</translation>
<translation id="8705561858232289221">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید</translation>
<translation id="437162022240011372">‏ادامه استفاده از Browther</translation>
<translation id="259935314519650377">نصب‌کننده بارگیری‌شده در حافظه نهان ذخیره نشد. خطا: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">سیستم</translation>
<translation id="2907676829052962091">‏سازمانتان می‌تواند داده‌های مرور، مثل نشانک‌ها، سابقه، و گذرواژه‌هایتان را ببیند و مدیریت کند. سازمانتان نمی‌تواند داده‌های مرور دیگر نمایه‌های Browther را ببیند</translation>
<translation id="1289116577679005654">‏برای استفاده از داده‌های Browther و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، هویت خود را درستی‌سنجی کنید</translation>
<translation id="7192278346779151664">‏یک خطای سیستم‌عامل در طول نصب روی داد. لطفاً Browther را دوباره نصب کنید.</translation>
<translation id="7724398260867885339">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و Browther را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="1679595317134614424">‏برگه Browther</translation>
<translation id="7189168846924379421">‏برای امنیت بیشتر، Browther داده‌های شما را رمزگذاری می‌کند.</translation>
<translation id="4052643592793184278">‏برای برداشتن «حساب Browther» خود از Browther، از سیستم خارج شوید</translation>
<translation id="7694616023994438906">‏برای دریافت گذرواژه‌ها، نشانک‌ها، و موارد دیگر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید</translation>
<translation id="2738871930057338499">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۳ ممنوع است. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
<translation id="2753623023919742414">برای جستجو، کلیک کنید</translation>
<translation id="9078193405195503710">‏تنظیم Browther به‌عنوان نمایشگر PDF پیش‌فرض</translation>
<translation id="2456995288904753506">‏‫Browther می‌تواند فیلدهای دشواری را که تکمیل خودکار استاندارد ممکن است ازدست بدهد تکمیل کند.</translation>
<translation id="3271730304285122987">‏این افزونه حاوی بدافزار است و ناامن است. آن را از Browther حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="2799223571221894425">راه‌اندازی مجدد</translation>
<translation id="1427337251963884503">‏‫Browther شما</translation>
<translation id="2816462166102338036">جستجوی این ویدیو با «جستجوی تصویر»</translation>
<translation id="2841525013647267359">ترجمه کردن از</translation>
<translation id="2846251086934905009">خطای نصب: نصب‌کننده کامل نشد. نصب لغو شد.</translation>
<translation id="928966105228355994">‏حذف از Browther...</translation>
<translation id="587805782197019018">‏وقتی به سیستم وارد شده باشید، امنیت شما را در Browther حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر Browther استفاده شود</translation>
<translation id="2885378588091291677">مدیر وظایف</translation>
<translation id="3055995278166070443">‏درباره &amp;Browther</translation>
<translation id="2915996080311180594">بازراه‌اندازی در فرصتی دیگر</translation>
<translation id="2928420929544864228">نصب کامل شد.</translation>
<translation id="70453521937551896">‏داده‌هایتان بااستفاده از گذرعبارت شما رمزگذاری شده است. برای استفاده از داده‌های Browther و ذخیره کردن این داده‌ها در «حساب Browther»، این گذرعبارت را وارد کنید.</translation>
<translation id="2945997411976714835">خطای نصب: فرایند نصب‌کننده شروع نشد.</translation>
<translation id="3188308520233701133">‏با گذرواژه‌های ذخیره‌شده برای Browther در iOS، در سایت‌ها سریع‌تر به سیستم وارد شوید</translation>
<translation id="8145318807880784886">‏نمایه Browther جدیدی اضافه کنید تا نشانک‌ها، گذرواژه‌ها، و تنظیمات به‌صورت جداگانه نگهداری شوند.</translation>
<translation id="4330268530227888227">‏سازمان شما Browther را مدیریت می‌کند</translation>
<translation id="6488090896442998436">‏Browther به‌روز است</translation>
<translation id="300557164611864786">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Browther ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند</translation>
<translation id="2447145782593796785">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به سیستم Browther وارد شوید</translation>
<translation id="3003694935412297923">همه تکلیف‌ها</translation>
<translation id="7554113777150891030">{count,plural, =1{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Browther» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Browther باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Browther» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Browther باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Browther» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Browther باید هویت شما را درستی‌سنجی کند. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="5522228731050510047">‏‫<ph name="URL"/> در زبانه جدیدی در Browther باز می‌شود.</translation>
<translation id="6358780591055960280">‏Browther نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعداً دوباره امتحان کنید.</translation>
<translation id="1386422761453740126">‏افزودن به Browther…</translation>
<translation id="3038232873781883849">درانتظار نصب…</translation>
<translation id="3045032126857188731">زبان ترجمه‌شده: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">بستن کادر گفتگوی بازخورد</translation>
<translation id="369127628511662602">‏دیگر نمایه‌های Browther</translation>
<translation id="2370255879896574713">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK"/> به Browther، به بهبود Browther کمک کنید</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{‏یک یا چند افزونه Browther به یک دستگاه USB دسترسی داشتند}=1{‏یک یا چند افزونه Browther به یک دستگاه USB دسترسی دارند}one{‏یک یا چند افزونه Browther به # دستگاه USB دسترسی دارند}other{‏یک یا چند افزونه Browther به # دستگاه USB دسترسی دارند}}</translation>
<translation id="2065456480740480340">‏سابقه Browther</translation>
<translation id="5011660649081947055">‏نصب‌کننده در خارج کردن بایگانی از حالت فشرده ناموفق بود. لطفاً دوباره Browther را بارگیری کنید.</translation>
<translation id="310459126943037700">تکلیف(ها) پایان نیافت.</translation>
<translation id="3104828284009500087">جستجو کردن هر چیزی در صفحه</translation>
<translation id="4917564010081457061">‏گذرواژه‌ها، نشانک‌ها، و سابقه را در همه دستگاه‌ها کاملاً همگام‌سازی کنید. با به‌روز کردن مرورگر پیش‌فرض به Browther، به‌راحتی به ویژگی‌هایی که می‌شناسید و دوست دارید دسترسی داشته باشید.</translation>
<translation id="1041472930719344928">‏Browther درحال استفاده از میکروفون شما است.</translation>
<translation id="3130333203120345554">جستجوی جدید</translation>
<translation id="3137969841538672700">برای جستجو، بخش موردنظر را بکشید</translation>
<translation id="5312717254055363883">‏این زبانه از منابع اضافی استفاده می‌کند. برای بهبود عملکرد، اجازه دهید Browther آن را غیرفعال کند.</translation>
<translation id="373523409348786203">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Browther مجاز کنید</translation>
<translation id="802113445299754598">‏اجرای مجدد Browther</translation>
<translation id="3161522574479303604">همه زبان‌ها</translation>
<translation id="4522189060330781648">‏برنامه‌ای دیگر در رایانه شما یک زمینه اضافه کرده است که ممکن است نحوه کارکرد Browther را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">‏سفارشی کردن نمایه جدید Browther</translation>
<translation id="5150830326120505481">‏برای برداشتن «حساب Browther» خود از Browther، در صفحه «تنظیمات» از سیستم Browther خارج شوید</translation>
<translation id="7113660200899017820">‏بعداً Browther می‌تواند از شما بپرسد که آیا می‌خواهید از اطلاعات ذخیره‌شده برای تکمیل خودکار فرم‌ها استفاده کنید</translation>
<translation id="4475011322243623412">‏Browther نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد:
<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">راه‌اندازی مجدد اکنون</translation>
<translation id="3536063527222598206">‏کلیدهای Browther API وجود ندارند. برخی از عملکردهای Browther از کار خواهند افتاد.</translation>
<translation id="1011450868746766298">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Browther بسته می‌شود</translation>
<translation id="179611081153855734">‏Browther قبل‌از اینکه هر سایتی را ازطریق اتصال ناامن بار کند به شما هشدار می‌دهد</translation>
<translation id="8965591964936552871">‏وقتی همه پنجره‌های Browther را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Browther وارد شده باشید از «حساب Browther» خارج نخواهید شد. برای اینکه سایت‌ها شما را به‌خاطر بسپارند، <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">‏موتور جستجوی پیش‌فرض شما از خارج‌از Browther تغییر کرد. برای محافظت از شما، Browther آن را بازنشانی کرد.</translation>
<translation id="1170501833661894915">‏برای دریافت گذرواژه‌ها، نشانک‌ها، و موارد دیگر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید</translation>
<translation id="3352986031709923790">‏گوشه بالا سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT"/> سمت چپ، ‎٪<ph name="TOP"/> بالا</translation>
<translation id="120745000989996104">‏داده‌های Browther در حساب شما</translation>
<translation id="3369405342922656244">جستجوی این صفحه با «جستجوی تصویر»</translation>
<translation id="7173761126541905083">‏از گذرواژه‌هایتان با Browther در تلفنتان استفاده کنید</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">‏به نمایه Browther موجود می‌روید؟</translation>
<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="4282363917570905631">‏«مرور ایمن پیشرفته» را با Browther در تلفنتان گسترش دهید</translation>
<translation id="986094398735583155">‏درحال شخصی‌سازی Browther…</translation>
<translation id="3266047225484320321">‏وقتی با گذرواژه‌ای لورفته به سیستم وارد می‌شوید، Browther شما را مطلع می‌کند</translation>
<translation id="3508047337876211050">‏این کار <ph name="ITEMS_COUNT"/> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Browther وارد شوید.</translation>
<translation id="7772248897860792723">‏با <ph name="SHORTCUT"/> می‌توانید بین نمایه‌های Browther جابه‌جا شوید</translation>
<translation id="7225005776233199285">‏لطفاً همه پنجره‌های Browther را ببندید و دوباره سعی کنید.</translation>
<translation id="5465054931427475969">‏برای هم‌رسانی پنجره، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Browther مجاز کنید</translation>
<translation id="6905469223518185641">‏‫<ph name="EXISTING_USER"/> درحال‌حاضر به سیستم وارد شده است.  برای جدا نگه داشتن مرورتان، در نمایه خودتان با حساب <ph name="USER_EMAIL_ADDRESS"/> به سیستم Browther وارد شوید.</translation>
<translation id="8133590217245064579">‏برای هم‌رسانی صفحه‌نمایش، ضبط صفحه‌نمایش را در «تنظیمات سیستم» برای Browther مجاز کنید.</translation>
<translation id="3597003331831379823">راه‌اندازی با امتیازهای عالی اجرا نشد. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">‏ورود به سیستم Browther</translation>
<translation id="2492221622209669678">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL"/> به سیستم Browther وارد شوید.</translation>
<translation id="6793778233257855801">‏برای ارسال شماره از <ph name="ORIGIN"/> به تلفن Android خود، در هر دو دستگاه به سیستم Browther وارد شوید.</translation>
<translation id="3667616615096815454">نصب نشد، برنامه برای سرور ناشناس است.</translation>
<translation id="5585500151754164442">‏استفاده از <ph name="BEGIN_LINK"/>گذرعبارت خودتان<ph name="END_LINK"/> برای رمزگذاری همه داده‌های Browther موجود در «حساب Browther» شما. روش‌های پرداخت و نشانی‌های موجود در Google Pay رمزگذاری نخواهند شد. سابقه مرور Browther همگام‌سازی نخواهد شد.</translation>
<translation id="404323216042159951">‏Browther نمی‌تواند گذرواژه‌هایتان را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="5004936474632127765">‏باز کردن پیوند در &amp;برگه جدید Browther</translation>
<translation id="6236643159256182256">‏برای شخصی‌سازی و اهداف بیشتر، Browther و دیگر سرویس‌های Browther را به‌هم پیوند دهید</translation>
<translation id="3729187154190517324">بااستفاده از دکمه «افزودن زبانه و موارد دیگر»، چند زبانه، فایل، و ابزار اضافه کنید و جستجویتان را عمیق‌تر کنید.</translation>
<translation id="1400697664933775238">‏مدیریت نمایه‌های Browther</translation>
<translation id="2461315395128103158">‏ببینید چرا Browther برخی‌از بارگیری‌ها را مسدود می‌کند</translation>
<translation id="8058420662026104226">‏اگر موردی نیاز به بررسی داشته باشد، Browther به شما اطلاع می‌دهد</translation>
<translation id="3177448557921912221">‏نمایه‌های Browther به شما کمک می‌کنند بخش‌های مختلف زندگی‌تان را از هم جدا کنید. اکنون نمایه جدیدی اضافه کنید.</translation>
<translation id="1541177876035612043">‏‫Browther صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="3810973564298564668">مدیریت</translation>
<translation id="1117103475254549453">‏برای استفاده کردن از گذرواژه‌های ذخیره‌شده، رمزینه پاسخ‌سریع را دنبال کنید، Browther ویژه iOS را بارگیری کنید، و به سیستم «حساب Browther» وارد شوید</translation>
<translation id="8880695882192156860">‏نکته Browther: «مرور ایمن پیشرفته»</translation>
<translation id="3846683726093018685">**خلاصه کردن:** در یک جمله کمتر از ۳۰ کلمه، موضوع اصلی و هدف محتوای نماگرفت را شرح بده.

          **پیشنهاد سؤال:** فهرستی گلوله‌ای با ۳ تا ۵ سؤال تأمل‌برانگیز تولید کن که کاربر بتواند برای درک بهتر نماگرفت بپرسد. حداقل یک مورد از این سؤالات باید به‌طور خاص درباره یک شیء بصری، طراحی، یا جای آن باشد.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> - Browther Origin</translation>
<translation id="3885770153807205175">انتخاب‌گر زبان</translation>
<translation id="4861846616763552424">‏Browther را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="6126366281251241386">‏برای باز کردن Browther و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="3892148308691398805">کپی کردن نوشتار</translation>
<translation id="3760801273210219822">‏<ph name="EXISTING_USER"/> قبلاً به سیستم این نمایه Browther وارد شده است. برای جدا نگه داشتن مرور، Browther می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="3821553157234855663">‏سفارشی‌سازی Browther</translation>
<translation id="3941890832296813527">خطای نصب: نام فایل نصب‌کننده نامعتبر است یا از آن پشتیبانی نمی‌شود.</translation>
<translation id="6482299900191767005">‏Browther می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="5853011008278898603">‏گذرواژه‌ها، روش‌های پرداخت، و نشانی‌هایی که در «حساب Browther» خود ذخیره کرده‌اید از این دستگاه برداشته خواهد شد. برای استفاده مجدد از آن‌ها در Browther، دوباره به سیستم وارد شوید.</translation>
<translation id="395904275706073188">صفحه‌های محافظت‌شده خوانده نمی‌شوند. صفحه دیگری را امتحان کنید.</translation>
<translation id="1832973663231751701">‏ببینید Browther چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="4531502594774670767">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Browther چیزی را که تایپ می‌کنید برای دریافت پیشنهاد به ابزارهای عامل، جستجو، و هوش مصنوعی سازمانتان ارسال می‌کند.</translation>
<translation id="300013383485253006">‏درباره Browther for Testing</translation>
<translation id="1152920704813762236">‏درباره ChromeOS</translation>
<translation id="8126752030994997015">‏وقتی‌که از سایتی بازدید می‌کنید، Browther بخش مبهم‌سازی‌شده‌ای از نشانی وب را ازطریق سرور حافظ حریم خصوصی‌ای که نشانی IP شما را پنهان می‌کند به <ph name="BEGIN_LINK"/>مرور ایمن Browther<ph name="END_LINK"/> ارسال می‌کند. اگر سایتی کار مشکوکی انجام دهد، نشانی‌های وب کامل و بخش‌هایی از محتوای صفحه نیز ارسال می‌شوند.</translation>
<translation id="3703994572283698466">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS"/>محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS"/> ممکن شده است.</translation>
<translation id="4022972681110646219">ترجمه کردن صفحه‌نمایش</translation>
<translation id="4023601594785368013">زبان اصلی: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">‏پیوندها را از هر برنامه‌ای در Browther باز کنید. همچنین برای دسترسی آسان، Browther به نوار وظیفه شما سنجاق می‌شود.</translation>
<translation id="3437506136408403836">‏با گزارش <ph name="BEGIN_LINK"/>تنظیمات کنونی<ph name="END_LINK"/>، به بهتر شدن Browther کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4055805654398742145">مدیر گذرواژه</translation>
<translation id="2164947358785939495">‏برنامه‌ای دیگر در رایانه شما یک افزونه اضافه کرده است که ممکن است نحوه کارکرد Browther را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Browther استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}one{‏اگر به‌مدت # دقیقه از Browther استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}other{‏اگر به‌مدت # دقیقه از Browther استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد. داده‌های مرور حذف می‌شود. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.}}</translation>
<translation id="1535413545339990419">‏رفتن به صفحه «درباره Browther»</translation>
<translation id="692283249649018289">‏با سفارشی‌سازی Browther، ظاهر جدیدی به مرورگرتان بدهید</translation>
<translation id="6375229634133804834">‏سفارشی‌سازی Browther</translation>
<translation id="4148957013307229264">درحال نصب…</translation>
<translation id="2399933334889379115">‏<ph name="PAGE_TITLE"/> - ورود به سیستم شبکه - Browther</translation>
<translation id="2911246138082876798">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه Browther را کشف کنید.</translation>
<translation id="2528977475313334293">‏برای دریافت این افزونه و موارد دیگر در همه رایانه‌هایتان، به سیستم Browther وارد شوید</translation>
<translation id="8244267655940711467">‏برای ایمن‌تر ماندن در فضای آنلاین با کمک انتخاب‌های ولی‌تان، به همان نمایه Browther بروید که قبلاً با <ph name="USER_EMAIL_ADDRESS"/> به سیستم وارد شده‌اید</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4224210481850767180">نصب لغو شده است.</translation>
<translation id="8219359042845534271">‏داده‌های Browther به این حساب مرتبط شود؟</translation>
<translation id="5520777668172961882">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Browther قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Browther را رد کنید.</translation>
<translation id="2014920019837536689">‏خروج از سیستم Browther</translation>
<translation id="4341512411059715879">‏دریافت کمک برای Browther</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="322492684764924424">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Browther در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="3813060261346666066">‏صادر کردن گذرواژه‌ها از Browther</translation>
<translation id="4304713468139749426">مدیر گذرواژه</translation>
<translation id="4334241893986177674">جستجو کردن این نماگرفت</translation>
<translation id="4334294535648607276">بارگیری کامل شد.</translation>
<translation id="2177954934431828302">‏راه‌اندازی Browther هنگام شروع Windows</translation>
<translation id="2472318668926455009">‏با تنظیم کردن Browther به‌عنوان مرورگر پیش‌فرض، به‌راحتی به ویژگی‌هایی که می‌شناسید، دوست دارید، و به آن‌ها اعتماد دارید دسترسی پیدا کنید. ‫Browther برای دسترسی سریع به نوار وظیفه سنجاق خواهد شد.</translation>
<translation id="1068681683510904753">‏<ph name="MANAGER"/> لازم می‌داند که شما «شرایط خدمات» زیر را قبل‌از استفاده از این دستگاه بخوانید و بپذیرید. این شرایط بسط داده نمی‌شود، اصلاح نمی‌شود، و شرایط Chrome OS را محدود نمی‌کند.</translation>
<translation id="2897580280700805340">‏درهرصورت از Browther خارج می‌شوید؟</translation>
<translation id="4413205837991854510">میان‌بر «جستجوی تصویر» همیشه نشان داده شود</translation>
<translation id="2454897022983434851">‏اجازه به Browther برای اجرا در پس‌زمینه</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{‏‫Browther توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}one{‏‫Browther توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}other{‏‫Browther توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">‏سفارشی کردن و کنترل Browther</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4434353761996769206">خطای نصب‌کننده: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846">‏‫<ph name="MANAGER"/> ‏Browther را مدیریت می‌کند</translation>
<translation id="4007482010626246887">‏افزودن نمایه Browther</translation>
<translation id="6888322430074420631">‏درباره Browther for Testing</translation>
<translation id="8912436499620582668">‏برای ذخیره کردن داده‌های Browther در «حساب Browther» خود و استفاده از آن‌ها، گذرعبارتتان را وارد کنید</translation>
<translation id="4493028449971051158">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش سرپرست اجرا کنید.</translation>
<translation id="4501471624619070934">نصب انجام نشد زیرا دسترسی در این کشور محدود است.</translation>
<translation id="8976207309012239417">‏این افزونه روش‌های اعمال حریم خصوصی، مثل نحوه جمع‌آوری و استفاده از داده‌ها را منتشر نکرده است. ‫Browther توصیه می‌کند آن را حذف کنید.</translation>
<translation id="8888202093812883067">‏به Browther Origin خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="6391148383688605718">‏‫Browther برای نقشه‌برداری از محیط اطراف و ردیابی دستان شما به اجازه نیاز دارد</translation>
<translation id="7756445485815468244">‏قبلاً با <ph name="USER_EMAIL_ADDRESS"/> در نمایه Browther دیگری به سیستم وارد شده‌اید</translation>
<translation id="137435413163730206">‏‫Browther صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK"/>درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">وقتی سایتی را که فکر می‌کنید مضر است گزارش می‌کنید، به بهبود ایمنی آنلاین برای همه کمک می‌کنید.</translation>
<translation id="3266647901351304597">‏‫Browther این بارگیری را مسدود کرد زیرا «مرور ایمن» خاموش است و نمی‌توان فایل را تأیید کرد</translation>
<translation id="6980208900390333646">‏«لنز Browther» را با Browther در تلفنتان امتحان کنید</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="5282047884678321451">‏برنامه‌های Browther Origin</translation>
<translation id="4598116752460667024">فرایندی را ازطریق فهرست جستجو کنید.</translation>
<translation id="4970880042055371251">‏نسخه ChromeOS</translation>
<translation id="4482468019601425607">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Browther را راه‌اندازی مجدد کنید.</translation>
<translation id="5517890123509214766">‏سرعت سایت‌ها را با موتورV8 مرورگر Browther بالاتر می‌برد اما مقاومت Browther را دربرابر حمله‌ها کمی کمتر می‌کند</translation>
<translation id="7690070364551268156">‏اگر گزارش‌های استفاده از Browther را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="5020487088453637212">‏ظاهراً نمایه توسط فرآیند Browther دیگری (<ph name="PROCESS_ID"/>) در رایانه‌ای دیگر (<ph name="HOST_NAME"/>) در حال استفاده است. Browther نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرآیندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و Browther را مجدداً راه‌اندازی نمایید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="8134827615154347946">‏برخی‌از داده‌های Browther هنوز در «حساب Browther» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="3508712423420506333">‏اکنون که به سیستم وارد شده‌اید، می‌توانید از گذرواژه‌ها و موارد دیگر «حساب Browther» خود در Browther استفاده کنید. ‫<ph name="SHORTCUT"/> می‌تواند تنظیمات سرویس‌های Browther را تغییر دهد.</translation>
<translation id="2388739442635757494">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST"/> به سیستم Browther در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Browther جدیدی ایجاد کنید.</translation>
<translation id="4724676981607797757">نصب به‌دلیل خطای پروتکل پشتیبانی‌نشده انجام نشد.</translation>
<translation id="8305313684264112434">‏درهرصورت از Browther خارج می‌شوید؟</translation>
<translation id="418155915144835101">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Browther اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="2683970367518529374">‏پرسیدن از Browther</translation>
<translation id="5064473048847774331">‏اخیراً بازدیدی نداشته‌اید. ‫Browther ‏<ph name="PERMISSION_1"/>،‏ <ph name="PERMISSION_2"/>،‏ و <ph name="COUNT"/> مورد دیگر را برداشت.</translation>
<translation id="5941343075741207533">‏Browther نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید یا <ph name="BEGIN_LINK"/>گذرواژه‌ها را در «حساب Browther» خود بررسی کنید<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Browther استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Browther ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4581078588976787792">‏استفاده از Browther بدون حساب</translation>
<translation id="3394520491703535051">‏قانون ترافیک ورودی برای Browther Origin جهت اجازه به ترافیک mDNS.</translation>
<translation id="6563126962881169552">‏راه‌اندازی مجدد برای به‌روزرسانی Browther</translation>
<translation id="4918086044614829423">می‌پذیرم</translation>
<translation id="4918844574251943176">تصویر کپی شد</translation>
<translation id="5240982928057703861">‏Browther در حالت پس‌زمینه است.</translation>
<translation id="3603134280602182991">‏برای بستن کادر گفتگوی ورود به سیستم Browther، کلیک کنید</translation>
<translation id="6120233890602288442">‏با نمایه‌های Browther می‌توانید همه چیزهای مربوط به Browther را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="5722688387568011881">‏مهمان‌ها می توانند از Browther استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="7786958592460743302">‏حساب شما در Browther</translation>
<translation id="9114640791491590337">‏افرودن خودتان به Browther</translation>
<translation id="3536391594566515053">‏‫«Gemini در Browther» از مرور خودکار برای کار کردن در زبانه‌ها و تکمیل کردن تکلیف‌هایی که به آن می‌دهید استفاده می‌کند. <ph name="LINK_BEGIN"/>بیشتر بدانید<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">‏‫Browther برای ردیابی کردن دست‌های شما به اجازه نیاز دارد</translation>
<translation id="1627123463102858476">‏اخیراً بازدیدی نداشته‌اید. ‫Browther ‏<ph name="PERMISSION_1"/>،‏ <ph name="PERMISSION_2"/>،‏ و <ph name="PERMISSION_3"/> را برداشت.</translation>
<translation id="5174969993834422967">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان ارسال کند، روی نماد اعلان در گوشه چپ نوار نشانی کلیک کنید.</translation>
<translation id="5174983315706567306">فضای دیسک کافی نیست.</translation>
<translation id="7091313576354542088">‏حساب Browther به اصالت‌سنجی مجدد نیاز دارد</translation>
<translation id="9045390598305758496">‏گذرواژه ذخیره‌شده‌ای وجود ندارد. Browther زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید.</translation>
<translation id="5686724084351858452">‏خروج از سیستم Browther</translation>
<translation id="5234764350956374838">بستن</translation>
<translation id="5254739261293693943">پرسش درباره این ویدیو</translation>
<translation id="8165028066129227692">‏برای اعمال تغییراتتان، Browther را راه‌اندازی مجدد کنید</translation>
<translation id="5286907366254680517">تشخیص داده شد</translation>
<translation id="198210130507193824">‏دریافت برنامه Browther</translation>
<translation id="8472078903122489041">‏سرویس داخلی به‌روزرسان Browther</translation>
<translation id="5346389065299425353">جستجویتان را با افزودن چند زبانه، فایل، و ابزار عمیق‌تر کنید</translation>
<translation id="3904682305383981098">‏Browther چند توصیه ایمنی برای بررسی پیدا کرد</translation>
<translation id="509616246140011182">‏دیگر نمایه‌های Browther</translation>
<translation id="8214429210535362385">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Browther خود را می‌دهید. داده‌های Browther شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME"/> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Browther حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">کد اضافی: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">‏برای گرفتن شخصی‌سازی‌ها، Browther را به «فعالیت‌ها در وب و برنامه» اضافه کنید</translation>
<translation id="8096544113811780871">‏ببینید چرا Browther برخی‌از فایل‌ها را مسدود می‌کند</translation>
<translation id="2384387444932590174">‏درحال به‌روزرسانی Browther (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">‏مجاز کردن ورود به سیستم Browther</translation>
<translation id="6557334704331248411">‏حذف از Browther</translation>
<translation id="5832041381258620673">‏عملکرد را کاهش می‌دهد اما Browther را دربرابر حملات مقاوم‌تر می‌کند</translation>
<translation id="3763317028635993788">‏تنظیم Browther به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="862357563072119126"><ph name="PAGE_TITLE"/> - Browther Origin Beta</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{‏‫Browther توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}one{‏‫Browther توصیه می‌کند زبانه‌ای را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}other{‏‫Browther توصیه می‌کند زبانه‌هایی را که باعث کند شدن مرورگرتان شده است موقتاً متوقف کنید}}</translation>
<translation id="4423621904097888155">‏Browther ممکن است درست کار نکند زیرا این توزیع Linux دیگر از آن پشتیبانی نمی‌کند.</translation>
<translation id="6201726364919996698">‏‫Browther این بارگیری را مسدود کرد زیرا این فایل می‌تواند به حساب‌های شخصی و شبکه‌های اجتماعی شما آسیب برساند</translation>
<translation id="7679204468655335605">‏Browther برای هم‌رسانی مکانتان با این سایت باید به مکان شما دسترسی داشته باشد</translation>
<translation id="1163572992704966942">‏وقتی Browther جدیدترین به‌روزرسانی‌های سیستم را نصب می‌کند، لطفاً صبر کنید.</translation>
<translation id="5050118226119231029">‏Browther می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="5524890928877629608">‏گوشه بالا سمت راست ناحیه جستجو: ‎٪<ph name="LEFT"/> سمت راست، ‎٪<ph name="TOP"/> بالا</translation>
<translation id="5875549039106594731">‏باز کردن فایل‌های PDF در Browther</translation>
<translation id="5536164441519929134">درباره این زبانه<ph name="LINE_BREAK"/>بپرسید</translation>
<translation id="5579324208890605088">خطای راه‌اندازی: لطفاً نصب‌کننده را با نقش کاربر معمولی اجرا کنید، نه با نقش سرپرست.</translation>
<translation id="202315329304302571">‏استفاده کردن از Browther به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن</translation>
<translation id="5596627076506792578">گزینه‌های بیشتر</translation>
<translation id="5605834417512968703">هرچیزی را که می‌خواهید برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید «گریز» را فشار دهید</translation>
<translation id="5618818588972826921">‏نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید یا برای خارج شدن از «جستجوی تصویر»، کلید Escape را فشار دهید</translation>
<translation id="5823076755666406442">{0,plural, =0{‏به‌روزرسانی Browther دردسترس است}=1{‏به‌روزرسانی Browther دردسترس است}one{‏به‌روزرسانی Browther از # روز پیش دردسترس است}other{‏به‌روزرسانی Browther از # روز پیش دردسترس است}}</translation>
<translation id="8414129876440043675">‏داده‌های سایت همواره بعداز بستن Browther از دستگاه حذف شود</translation>
<translation id="5156991567152325333">‏لطفاً اکنون Browther را بازراه‌اندازی کنید</translation>
<translation id="5710072384986281834">dev&amp;din Inc</translation>
<translation id="1536693367017293028">‏نمایش Browther به این زبان</translation>
<translation id="569897634095159764">اتصال به اینترنت برقرار نشد. سرور پروکسی به اصالت‌سنجی نیاز دارد.</translation>
<translation id="4215338057953170891">‏نمایه‌های Browther به شما امکان می‌دهند فضای مرور شخصی و کاری را جدا نگه دارید. اکنون نمایه جدیدی اضافه کنید.</translation>
<translation id="5366435608642317052">‏‫Browther حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌های فعال و سایر برنامه‌ها اختصاص داده می‌شود و سرعت بالای Browther حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند. <ph name="BEGIN_LINK"/>درباره «بهینه‌سازی حافظه» بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="4941518395341035738">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، داده‌های Browther ذخیره‌شده در حسابتان را <ph name="SETTINGS_LINK"/></translation>
<translation id="7763291835437810978">‏‫Browther را سفارشی‌سازی و کنترل کنید. ‫Browther را به‌عنوان مرورگر پیش‌فرض تنظیم کنید.</translation>
<translation id="5809516625706423866">‏اتصال به اینترنت برقرار نشد. HTTP ۴۰۱ مجاز نیست. لطفاً پیکربندی پروکسی‌تان را بررسی کنید.</translation>
<translation id="1827132270895283425">‏با این کار سرعت سایت‌ها با موتور Browther نسخه ۸ بالاتر می‌رود اما مقاومت Browther دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم خاموش است.</translation>
<translation id="1553025851718680114">‏برای استفاده و ذخیره کردن داده‌های Browther در «حساب Browther» خود، Browther را به‌روز کنید</translation>
<translation id="5824893331272123205">این پانل بارگیری نشد، دوباره امتحان کنید</translation>
<translation id="6642862349634944253">‏به Browther Origin خوش آمدید</translation>
<translation id="5871205389137001634">برای خارج شدن از «جستجوی تصویر»، کلیک کنید</translation>
<translation id="7586794330537887406">‏Browther متوجه شده است که این موارد حاوی بدافزار هستند:</translation>
<translation id="1666897346518812892">‏Browther به‌طور منظم بررسی می‌کند تا مطمئن شود مرورگرتان ایمن‌ترین تنظیمات را دارد. اگر موردی به بازبینی شما نیاز داشته باشد، به شما اطلاع خواهیم داد.</translation>
<translation id="5895138241574237353">راه‌اندازی مجدد</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - ورود به سیستم شبکه</translation>
<translation id="5924017743176219022">درحال متصل شدن به اینترنت…</translation>
<translation id="5941711191222866238">کوچک کردن</translation>
<translation id="4938357262936377412">‏برای دریافت این نشانک و موارد بیشتر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید</translation>
<translation id="260974496993853147">‏‫Browther را مخصوص خودتان کنید</translation>
<translation id="5960071705175224773">برنامه‌ای ناشناس تنظیمات شما را تغییر داد</translation>
<translation id="5968400720580217226">حالت هوشواره‌ای</translation>
<translation id="8697015289720079159">{COUNT,plural, =1{‏اگر به‌مدت یک دقیقه از Browther استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}one{‏اگر به‌مدت # دقیقه از Browther استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}other{‏اگر به‌مدت # دقیقه از Browther استفاده نشود، سازمانتان آن را به‌طور خودکار می‌بندد.}}</translation>
<translation id="5852664780493076676">‏به‌روزرسانی Browther برای شروع همگام‌سازی</translation>
<translation id="6003112304606738118">درحال بارگیری… <ph name="HOURS"/> ساعت باقی مانده است</translation>
<translation id="6009821354356307391">پرسیدن سؤال تعقیبی</translation>
<translation id="6040143037577758943">بستن</translation>
<translation id="2495504229007749358">‏برای محافظت از داده‌هایتان، به Browther اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="6038969823662006832">‏&amp;باز کردن در Browther</translation>
<translation id="6069027071882229820">کپی کردن به‌عنوان تصویر</translation>
<translation id="6606690217326148454">‏<ph name="EXTENSION_NAME"/> به Browther اضافه شد</translation>
<translation id="6037324269860323082">‏سفارشی کردن و کنترل Browther. به‌روزرسانی‌ در دسترس است.</translation>
<translation id="3695768481578778794">‏روشن • Browther نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="4401885752362736126">‏حساب شما در Browther</translation>
<translation id="4310817187912076496">‏مجاز کردن افزونه برای نمایش درخواست‌های دسترسی در نوارابزار Browther</translation>
<translation id="4602490888173698813">‏<ph name="FILE_NAME"/> خطرناک است، بنابراین Browther آن را مسدود کرده است.</translation>
<translation id="5139243417751674628">‏Browther به‌زودی بسته می‌شود و داده‌ها را حذف می‌کند</translation>
<translation id="4696750309605389299">‏می‌توانید در اینجا بین نمایه‌های Browther جابه‌جا شوید</translation>
<translation id="7475001351099358916">‏اگر کوکی‌ها را مجاز کنید، ممکن است Browther از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="6165508094623778733">بیشتر بدانید</translation>
<translation id="5975099973700540482">‏داده‌های Browther ذخیره‌شده در حسابتان را پاک کنید</translation>
<translation id="6800151735486681860">‏این فایل ممکن است خطرناک باشد<ph name="LINE_BREAK"/>اگر گذرواژه را ارائه دهید، Browther می‌تواند این بارگیری را برایتان بررسی کند. اطلاعات فایل به «مرور ایمن Browther» ارسال می‌شود، اما محتوای فایل و گذرواژه در دستگاهتان باقی می‌ماند.</translation>
<translation id="6182736845697986886">نصب به‌دلیل وجود خطای داخلی در سرور به‌روزرسانی انجام نشد.</translation>
<translation id="48832130233362517">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME"/> به سیستم Browther وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="8868210753005945522">‏برنامه‌ای دیگر در رایانه شما یک برنامه اضافه کرده است که ممکن است نحوه کارکرد Browther را تغییر دهد.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">‏این رایانه در حال حاضر دارای یک نسخه جدیدتر از Browther است. درصورتی‌که نرم‌افزار کار نمی‌کند، لطفاً Browther را حذف نصب کنید و دوباره سعی کنید.</translation>
<translation id="9222998061982994203">{0,plural, =0{‏Browther هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏Browther ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏Browther ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏Browther ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="6239161312595354541">پرسیدن از «جستجوی تصویر» درباره این ویدیو</translation>
<translation id="1755464917870815989">‏Browther برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="304681001513922736">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Browther ذخیره شده است مقایسه می‌کند</translation>
<translation id="7785903492969539081">‏Browther  مرورگر پیش‌فرض شود</translation>
<translation id="3987833816263696343">‏از Browther خارج می‌شوید؟</translation>
<translation id="4723540739671534529">‏این زبانه‌ها از منابع بیشتری استفاده می‌کنند. برای بهبود عملکرد، اجازه دهید Browther آن‌ها را غیرفعال کند.</translation>
<translation id="6540151687468239291">‏سفارشی کردن نمایه Browther</translation>
<translation id="770793114032605647">‏نام‌گذاری نمایه Browther</translation>
<translation id="385867753870250529">‏یکی از افزونه‌ها از شما می‌خواهد به سیستم Browther وارد شوید</translation>
<translation id="2022337046348377650">‏<ph name="FILE_NAME"/> ممکن است خطرناک باشد، بنابراین Browther آن را مسدود کرده است.</translation>
<translation id="45270956603278068">‏Browther درحال استفاده از دوربین شما است.</translation>
<translation id="6327105987658262776">به‌روزرسانی دردسترس نیست.</translation>
<translation id="673633752219771459">‏عملیات دیگری در Browther درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="1482759407165416070">‏اکنون استفاده از Browther با حساب Browther شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="5538042432112726532">‏میان‌بر Browther</translation>
<translation id="833085228901080512">‏‫Browther این بارگیری را مسدود کرد زیرا این فایل معمولاً بارگیری نمی‌شود و ممکن است خطرناک باشد</translation>
<translation id="491120842288314439">‏آیا مطمئن هستید که می‌خواهید Browther را حذف نصب کنید؟</translation>
<translation id="6375219077595103062">میان‌بری به «مدیر گذرواژه» اضافه کنید</translation>
<translation id="6388799252195623474">در این مورد به من کمک کنید</translation>
<translation id="6715003312952407375">‏برای ادامه دادن، با حساب <ph name="EMAIL"/> به سیستم Browther وارد شوید. با این کار مطمئن می‌شوید که خط‌مشی‌های سازمانتان اعمال شده‌اند.</translation>
<translation id="1897845318651970239">‏نشان‌واره Browther درون صفحه‌نمایش رایانه.</translation>
<translation id="4702069255970029302">‏‫Browther Origin یک مرورگر وب است که صفحات وب و برنامه‌ها را با سرعت بسیار زیاد اجرا می‌کند. این مرورگر خیلی سریع و پایدار است کار کردن با آن آسان است. با محافظت دربرابر بدافزار و رمزگیری تعبیه‌شده در Browther Origin، با امنیت بیشتری وب را مرور کنید.</translation>
<translation id="5669767676913031391">‏‫Browther سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند</translation>
<translation id="6436260184216827876">«جستجوی تصویر» دردسترس نیست. بعداً دوباره امتحان کنید.</translation>
<translation id="2139300032719313227">‏بازراه‌اندازی ChromeOS</translation>
<translation id="6110616900529884221">‏‫Browther صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="1217194059001819677">‏با بارگیری Browther در تلفنتان، قیمت‌ها را پیگیری کنید و برای کاهش قیمت در هر سایتی هشدار دریافت کنید</translation>
<translation id="7058555680120557198">‏خاموش • Browther نمی‌تواند منبع این افزونه را تأیید کند</translation>
<translation id="676533642429632127">‏به نمایه‌های Browther خوش‌آمدید</translation>
<translation id="5518682889576009702">‏دفعه بعد که Browther را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای استفاده از گروه‌های زبانه خواهید دید.</translation>
<translation id="6038105561107837619">‏برداشتن حساب از Browther</translation>
<translation id="2675662665675552980">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Browther نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="648319183876919572">«مرور ایمن پیشرفته» کارهای بیشتری برای محافظت از شما درمقابل وب‌سایت‌ها و بارگیری‌های خطرناک انجام می‌دهد</translation>
<translation id="2930243146591999795">‏حذف نصب Browther </translation>
<translation id="5241183382286817629">‏میان‌برها در Browther باز می‌شود</translation>
<translation id="7907014599435829661">‏اگر <ph name="TIMEOUT_DURATION"/> از Browther استفاده نشود، سازمانتان آن را می‌بندد. داده‌های مرور حذف شد. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="2088471423667794811">‏هرکدام از نمایه‌ها دارای اطلاعات Browther مختص خودش است (مثلاً نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="9040334484455218184">‏درباره اینکه <ph name="BEGIN_LINK"/>Browther چگونه داده‌های شما را خصوصی نگه می‌دارد<ph name="END_LINK"/> بیشتر بدانید</translation>
<translation id="1718697235867382480">‏پس‌از بازراه‌اندازی Browther، تغییرات این تنظیم اعمال خواهد شد.</translation>
<translation id="6331317152404762758">‏برای دیدن گذرواژه‌های نمایه Browther دیگر، می‌توانید به آن نمایه بروید</translation>
<translation id="6097706403184348562">‏برای رفع خطاهای املائی، Browther نوشتاری را که در فیلد نوشتار تایپ می‌کنید، برای Browther ارسال می‌کند</translation>
<translation id="2319647238307402812">‏رفتن به تنظیمات اعلان Browther</translation>
<translation id="6600016381025017075">هرچیزی در این صفحه را جستجو کنید</translation>
<translation id="8031938899816118394">‏دفعه بعدی که Browther را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="7412185356697187964">‏اکنون Browther با شروع Windows راه‌اندازی می‌شود تا بتوانید بلافاصله مرور را شروع کنید. می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="9123343592576384616">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Browther زبانه‌های جلسه قبلی‌تان را بازگرداند. می‌توانید این ویژگی را در اینجا خاموش کنید:</translation>
<translation id="5847926498049048567">‏Browther برای ایجاد نقشه سه‌بعدی از محیط اطراف شما به اجازه دوربین نیاز دارد</translation>
<translation id="5532585028508811858">‏اگر نشانک‌ها را در «حساب Browther» هم ذخیره کنید، می‌توانید قیمت محصولات را در Browther پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="1363996462118479832">‏به‌دلیل بروز خطا هنگام ورود به سیستم، ChromeOS نتوانست داده‌های شما را همگام‌سازی کند.</translation>
<translation id="3373239673945775810">‏برداشتن داده‌های این برنامه از Browther</translation>
<translation id="8122759674786039814">‏‫Browther به شما کمک می‌کند بر آگهی‌هایی که می‌بینید تسلط بیشتری داشته باشید و همچنین میزان اطلاعاتی را که سایت‌ها هنگام نمایش آگهی‌های شخصی‌سازی‌شده به شما درباره‌تان جمع‌آوری می‌کنند محدود می‌کند</translation>
<translation id="6277682530398500159">‏Browther برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6712881677154121168">خطای بارگیری: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">‏از نمایهٔ شما نمی‌توان استفاده کرد زیرا دارای نسخه جدیدتری از Browther است.

برخی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک فهرست راهنمای نمایه دیگری را مشخص کنید یا از نسخه جدیدتری از Browther استفاده کنید.</translation>
<translation id="871671753163165892">‏برای گرفتن شخصی‌سازی‌ها و ویژگی‌های دیگر، Browther را به «فعالیت‌ها در وب و برنامه» و سرویس‌های پیوندشده Browther اضافه کنید</translation>
<translation id="5000832110229523807">‏Browther از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="5204575479550973859">‏برای دریافت نشانک‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید. بعداز اینکه به سیستم وارد شدید، این نشانک در «حساب Browther» شما ذخیره خواهد شد.</translation>
<translation id="2874208284092283937">‏با این کار سرعت سایت‌ها با موتور Browther نسخه ۸ بالاتر می‌رود اما مقاومت Browther دربرابر حمله‌ها مقداری کمتر می‌شود. این تنظیم روشن است.</translation>
<translation id="3268577459683869744">{count,plural, =1{‏برخی‌از داده‌های Browther هنوز در «حساب Browther» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده (۱ مورد) حذف خواهد شد.}one{‏برخی‌از داده‌های Browther هنوز در «حساب Browther» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده ({count} مورد) حذف خواهد شد.}other{‏برخی‌از داده‌های Browther هنوز در «حساب Browther» شما ذخیره نشده است. پیش‌از خروج از سیستم، چند دقیقه صبر کنید. اگر اکنون از سیستم خارج شوید، این داده‌ها ({count} مورد) حذف خواهند شد.}}</translation>
<translation id="7683816018918395929">‏Browther توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد.</translation>
<translation id="1547295885616600893">‏ارائه ChromeOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS"/> تکمیلی ممکن شده است.</translation>
<translation id="6831043979455480757">ترجمه</translation>
<translation id="2142653375108595728">‏Browther می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="684888714667046800">نمی‌توان به اینترنت متصل شد. اگر از دیوار آتش استفاده می‌کنید، لطفاً مطمئن شوید <ph name="PRODUCT_EXE_NAME"/> در فهرست مجازها باشد.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">برای ادامه دادن، کلید «جهش» را فشار دهید</translation>
<translation id="6862030660799253820">جستجوی این تصویر با «جستجوی تصویر»</translation>
<translation id="3860339351709082396">‏Browther متوجه شده است که «<ph name="EXTENSION_NAME"/>» حاوی بدافزار است</translation>
<translation id="6877155553248388166">‏گوشه پایین سمت چپ ناحیه جستجو: ‎٪<ph name="RIGHT"/> سمت چپ، ‎٪<ph name="BOTTOM"/> پایین</translation>
<translation id="6896758677409633944">کپی</translation>
<translation id="7804113502310231166">‏‫Browther را به‌عنوان مرورگر پیش‌فرض خود تنظیم کنید و آن را به نوار وظیفه‌تان سنجاق کنید</translation>
<translation id="3228374215117173004">‏مدیریت نمایه‌های Browther</translation>
<translation id="6934579572334859869">پرسیدن از «جستجوی تصویر» درباره این تصویر</translation>
<translation id="5995328366516663808">‏به حداکثر تعداد نشانک‌های Browther (<ph name="BOOKMARK_LIMIT"/>) رسیده‌اید، بنابراین برخی‌از نشانک‌هایتان هنوز در «حساب Browther» شما ذخیره نشده است.

تا زمانی‌که تعدادی از نشانک‌ها را حذف نکنید، نمی‌توانید نشانک‌های جدید را در حسابتان ذخیره کنید. اگر اکنون از سیستم خارج شوید، نشانک‌های ذخیره‌نشده حذف خواهد شد.</translation>
<translation id="6965382102122355670">تأیید</translation>
<translation id="4533562834763015352">‏گذرواژه‌های ضعیف را می‌توان به‌راحتی حدس زد. به Browther اجازه دهید <ph name="BEGIN_LINK"/>گذرواژه‌هایی قوی برایتان ایجاد کند و آن‌ها را به‌خاطر بسپارد<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">‏شرایط ChromeOS</translation>
<translation id="5379058926689137454">‏Browther برای این سایت به مجوز دسترسی به میکروفون نیاز دارد</translation>
<translation id="4684462982894889021">‏برای استفاده از داده‌های Browther و ذخیره کردن آن‌ها در حسابتان (<ph name="ACCOUNT_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="7011190694940573312">نصب انجام نشد زیرا این نسخه از سیستم‌عامل پشتیبانی نمی‌شود.</translation>
<translation id="7024536598735240744">خطای لغو فشرده‌سازی: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">نصب متوقف شد.</translation>
<translation id="8257174622576051374">‏Browther را برای خود اختصاصی کنید</translation>
<translation id="7047386856539490735">این نتایج مفیدند؟</translation>
<translation id="1772745060691790742">‏به‌روزرسانی Browther</translation>
<translation id="4937970118065051027">‏اگر تصویری توضیح مفیدی نداشته باشد، Browther توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Browther ارسال می‌شود.</translation>
<translation id="1594112132009288601">‏سفارشی‌سازی Browther for Testing</translation>
<translation id="5915000938288527952">‏می‌توانید پیوندهای موجود در پیام‌ها، سندها، و برنامه‌های دیگر را همیشه بااستفاده از Browther باز کنید</translation>
<translation id="8775664994493381735">‏حذف <ph name="EXTENSION_NAME"/> از Browther</translation>
<translation id="3276648807841991013">‏اگر <ph name="TIMEOUT_DURATION"/> از Browther استفاده نشود، سازمانتان داده‌های آن را حذف می‌کند. این داده‌ها می‌تواند شامل سابقه، تکمیل خودکار، و بارگیری‌ها شود.</translation>
<translation id="4725226878394159809">‏Browther برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="8931474625901592021">‏Browther راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="8242947409070121799">‏Browther نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید.</translation>
<translation id="1737922827960215472">‏‫Browther را در Dock نگه دارید تا هرزمان خواستید سریع به آن دسترسی داشته باشید</translation>
<translation id="335855266303176628">‏از Browther برای باز کردن پیوندهای موجود در پیام‌ها، اسناد، و برنامه‌های دیگر استفاده کنید</translation>
<translation id="709455597778444012">‏مدیر وظایف - Browther</translation>
<translation id="7147140345767587643">‏علایق شما به‌طوری‌که Browther برآورد کرده است</translation>
<translation id="7337408274890534789">‏مرور را فوراً شروع کنید: اکنون Browther می‌تواند هنگام شروع Windows راه‌اندازی شود.</translation>
<translation id="7274695763216404502">سنجاق شد! دفعه بعد «جستجوی تصویر» را از نوارابزار باز کنید</translation>
<translation id="7288567540154601580">زبانه‌ها و افزونه‌ها</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{‏Browther توصیه می‌کند آن را بردارید}one{‏Browther توصیه می‌کند آن را بردارید}other{‏Browther توصیه می‌کند آن‌ها را بردارید}}</translation>
<translation id="1527644038571473502">‏برای هم‌رسانی کردن صدای سیستم، «تنظیمات سیستم» را باز کنید و «فقط ضبط صدای سیستم» را برای Browther مجاز کنید. سپس باید Browther را بازراه‌اندازی کنید.</translation>
<translation id="1427913074981060872">‏سنجش آگهی به سایت‌هایی که بازدید می‌کنید امکان می‌دهد اطلاعاتی را از Browther درخواست کنند که به آن‌ها کمک می‌کند عملکرد آگهی‌هایشان را بسنجند. «سنجش آگهی» ردیابی بین‌سایتی را با انتقال حداقل اطلاعات ممکن بین سایت‌ها محدود می‌کند.</translation>
<translation id="1657652725060525338">‏در حال به‌روزرسانی Browther</translation>
<translation id="884846289464870238">‏فایل اولویت‌های شما خراب یا نامعتبر است. 
Browther قادر به بازیابی تنظیمات شما نیست.</translation>
<translation id="7339898014177206373">پنجرهٔ جدید</translation>
<translation id="633044855886370183">‏وب، نشانک‌ها و موارد دیگر Browther شما در اینجا هستند.</translation>
<translation id="1185960088713242527">‏فقط شخصی که گذرعبارت شما را دراختیار داشته باشد می‌تواند داده‌های رمزگذاری‌شده‌تان را بخواند. گذرعبارت به Browther ارسال نمی‌شود یا توسط آن ذخیره نمی‌شود. اگر گذرعبارت را فراموش کنید یا بخواهید این تنظیم را تغییر دهید، باید <ph name="BEGIN_LINK"/>داده‌های Browther ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME"/> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، Browther را پیکربندی کرده است.</translation>
<translation id="7352651011704765696">مشکلی پیش آمد</translation>
<translation id="6638123710106659002">‏برای دریافت به‌روزرسانی‌های بعدی Browther، باید macOS نسخه ۱۳ یا بالاتر داشته باشید. این رایانه از macOS نسخه ۱۲ استفاده می‌کند.</translation>
<translation id="7286289384512061761">‏اخیراً بازدیدی نداشته‌اید. ‫Browther ‏<ph name="PERMISSION_1"/> و <ph name="PERMISSION_2"/> را برداشت.</translation>
<translation id="113593073175678746">‏دیگر از این افزونه پشتیبانی نمی‌شود. ‫Browther توصیه می‌کند آن را حذف کنید.</translation>
<translation id="137615076640044304">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Browther هربار که آن را بازراه‌اندازی کنید، زبانه‌هایتان را بازمی‌گرداند. برای خاموش کردن این ویژگی، به اینجا بروید:</translation>
<translation id="5967238175620483220">‏وارد کردن گذرواژه‌ها به Browther</translation>
<translation id="4935019315986703336"><ph name="PAGE_TITLE"/> - Browther Origin Dev</translation>
<translation id="7450541714075000668">نوشتار کپی شد</translation>
<translation id="7766009218653304791">‏Browther برای این سایت به مجوز دسترسی به دوربین نیاز دارد</translation>
<translation id="5844418066487488520">‏برای استفاده از میکروفون، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Browther دسترسی دهید</translation>
<translation id="8065480549334161841">‏برای دریافت به‌روزرسانی‌های آتی Browther، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 7 استفاده می‌کند.</translation>
<translation id="6299293759264950896">‏Browther راه‌اندازی مجدد شود؟</translation>
<translation id="180908550381040105">‏نمی‌توانید Browther دارای نسخه مشابه با نسخه در حال اجرا را نصب کنید. لطفاً Browther را ببندید و دوباره سعی کنید.</translation>
<translation id="7625576878150380853">‏هرزمان به سیستم Browther وارد شده باشید، می‌توانید گذرواژه‌ها و داده‌های دیگر را در «حساب Browther» خود ذخیره کنید و از آن‌ها استفاده کنید. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">‏سایت‌ها احتمالاً عملکرد موردانتظار را خواهند داشت. وقتی همه پنجره‌های Browther را ببندید از سیستم اکثر سایت‌ها خارج خواهید شد، اما اگر به سیستم Browther وارد شده باشید از «حساب Browther» خارج نخواهید شد.</translation>
<translation id="7099370564362681943">{0,plural, =1{‏Browther ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏Browther ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏Browther ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="3602613943932672197">‏برای محافظت از داده‌هایتان، به Browther اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند.</translation>
<translation id="8759568213742229377">‏برای شروع فوری مرور، Browther را به‌طور خودکار راه‌اندازی کنید.</translation>
<translation id="7583399374488819119">نصب‌کننده <ph name="COMPANY_NAME"/></translation>
<translation id="8991800242749014880">‏Browther درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="2692328388439821508">‏Browther اکنون بهتر شده است</translation>
<translation id="4318444066563223295">‏اکنون ویژگی‌های بیشتری در Browther دردسترس شما قرار دارد</translation>
<translation id="7649070708921625228">راهنما</translation>
<translation id="5591287320769313116">‏اجازه دهید Browther برایتان مرور کند</translation>
<translation id="7658239707568436148">لغو</translation>
<translation id="6325482130534634729">‏Browther مرورگر پیش‌فرض شما نیست</translation>
<translation id="8185915921134219287">‏Browther را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="5120421624925726813">‏به‌روزرسانی Browther</translation>
<translation id="7716950018788545737">تکلیف(ها) پایان یافت.</translation>
<translation id="77283119132245232">سرویس‌های ردیابی سیستم را برای <ph name="BROWSER_NAME"/> ارائه می‌دهد. اگر این سرویس غیرفعال باشد، ردیابی‌های عملکردی که مرورگر ایجاد می‌کند شامل رویدادهای در سطح سیستم مانند رویدادهای تغییر زمینه و آماده‌سازی رشته نخواهد بود.</translation>
<translation id="6542096191573265107">‏این کار داده‌های محصول مرورتان را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL"/> به سیستم Browther وارد شوید.</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="351575328720488268">‏بازنشانی به Browther پیش‌فرض</translation>
<translation id="1054170408395182418">‏‫Browther را به‌عنوان پیش‌فرض تنظیم کنید و آن را به نوار وظیفه سنجاق کنید</translation>
<translation id="4569594230301902490">‏سرعت Browther را افزایش دهید</translation>
<translation id="8041924294044943913"><ph name="PAGE_TITLE"/> - Browther Origin Canary</translation>
<translation id="7893465573639396635">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Browther برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="7810005234485217901">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید</translation>
<translation id="2462631024103158515">‏درحال‌حاضر یک نمایه Browther با این حساب در این دستگاه وجود دارد</translation>
<translation id="7845233973568007926">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید رایانه را بازراه‌اندازی کنید.</translation>
<translation id="311190437086049332">‏با سفارشی‌سازی Browther، ظاهری جدید به آن ببخشید</translation>
<translation id="6728847658878265103">‏Browther به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="7872446069773932638">درحال بارگیری… <ph name="SECONDS"/> ثانیه باقی مانده است</translation>
<translation id="5374532739787768601">‏اگر گذرعبارت را فراموش کرده‌اید یا می‌خواهید این تنظیم را تغییر دهید، <ph name="BEGIN_LINK"/>داده‌های Browther ذخیره‌شده در حسابتان را حذف کنید<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">پرسش درباره این تصویر</translation>
<translation id="9172499982238113829">‏تنظیم Browther به‌عنوان مرورگر پیش‌فرض</translation>
<translation id="3313826726620159669">‏‫Browther اتصال‌های ناامن را درصورت امکان به‌طور خودکار به HTTPS ارتقا می‌دهد</translation>
<translation id="3317928686912559532">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS"/> وارد سیستم Browther شده‌اید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="6007009085341946457">‏این نصب ثانویه Browther است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="8004582292198964060">مرورگر</translation>
<translation id="8010081455002666927">شناسایی خودکار</translation>
<translation id="174885789898161653">‏وقتی Browther دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="3001754454174546602">‏‫Browther را به نوار وظیفه سنجاق کنید تا هرزمان خواستید سریع‌تر به آن دسترسی داشته باشید</translation>
<translation id="80471789339884597">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME"/>، باید همه مرورگرها را بازراه‌اندازی کنید.</translation>
<translation id="8054112667659782652">میان‌بر «جستجوی تصویر» همیشه نشان داده شود</translation>
<translation id="6993312779622863465">‏غیرفعال کردن اجرای Browther در پس‌زمینه برای برنامه‌ها</translation>
<translation id="80790299200510644">جستجوی تصویر</translation>
<translation id="8086881907087796310">نصب انجام نشد زیرا رایانه شما با حداقل شرایط سخت‌افزاری مطابقت ندارد.</translation>
<translation id="3217614128548917842"><ph name="PAGE_TITLE"/> - Browther Origin for Testing</translation>
<translation id="543407324609820492">‏Browther برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="1767887552863788514">‏دفعه بعد که Browther را در <ph name="DEVICE_TYPE"/> باز می‌کنید، پیام‌واره‌ای برای فعال کردن هشدارهای ردگیری قیمت خواهید دید.</translation>
<translation id="8118331347066725040">درباره جستجو با «لنز»، بازخورد ارسال کنید</translation>
<translation id="5334309298019785904">‏ChromeOS نتوانست داده‌هایتان را همگام‌سازی کند زیرا «همگام‌سازی» برای دامنه شما دردسترس نیست.</translation>
<translation id="813913629614996137">درحال مقداردهی اولیه…</translation>
<translation id="4879101934056397619">‏شرایط خدمات تکمیلی Browther</translation>
<translation id="4505690237431768764">‏این فایل خطرناک است، بنابراین Browther آن را مسدود کرده است.</translation>
<translation id="8177472873527554730">محتوای موردنظر در صفحه پیدا نشد</translation>
<translation id="4720341280133158605">‏برای استفاده از داده‌های Browther و ذخیره کردن آن‌ها در حسابتان (<ph name="USER_EMAIL"/>)، گذرعبارت خود را وارد کنید</translation>
<translation id="8221491193165283816">معمولاً اعلان‌ها را مسدود می‌کنید. برای اینکه اجازه دهید این سایت اعلان بفرستد، اینجا را کلیک کنید.</translation>
<translation id="1083711467946065278">‏برای استفاده از دوربین، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Browther دسترسی دهید</translation>
<translation id="6569785137733211804">‏‫Browther نمی‌تواند منبع این افزونه را تأیید کند و این افزونه ممکن است ناامن باشد. آن را از Browther حذف کنید تا دیگر نتواند داده‌های شما را (ازجمله اطلاعات شخصی) در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="1122818205373648656">‏اگر تصویری توضیح مفیدی نداشته باشد، Browther توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Browther ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="6877990294324319801">‏در نمایه جدید به سیستم Browther وارد می‌شوید؟</translation>
<translation id="6478811748813986578">‏‫Browther درباره سایت‌ها و بارگیری‌های ناامن <ph name="BEGIN_LINK"/>به شما هشدار می‌دهد<ph name="END_LINK"/></translation>
<translation id="1685486387921540822">‏اخیراً بازدیدی نداشته‌اید. ‫Browther ‏<ph name="PERMISSION"/> را برداشت.</translation>
<translation id="8921153410460268589">‏در برنامه Browther ویژه iOS، با دوربینتان آنچه را می‌بینید بخرید، ترجمه کنید، و شناسایی کنید</translation>
<translation id="8313851650939857356">خطای راه‌اندازی: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">‏اگر <ph name="TIMEOUT_DURATION"/> از Browther استفاده نشود، سازمانتان آن را می‌بندد.</translation>
<translation id="8321888067342493336">ذخیره کردن به‌عنوان تصویر</translation>
<translation id="143016831128278157">‏برای همگام‌سازی و شخصی‌سازی Browther در همه دستگاه‌هایتان، به سیستم وارد شوید</translation>
<translation id="4784945022248750283">‏<ph name="USER_EMAIL_ADDRESS"/> قبلاً از Browther استفاده می‌کرد</translation>
<translation id="1288164710697017468">‏برای ادامه استفاده از داده‌های Browther ذخیره‌شده در «حساب Browther» خود (<ph name="ACCOUNT_EMAIL"/>)،‏ Browther را به‌روز کنید</translation>
<translation id="8648401677359150296">‏برای دریافت به‌روزرسانی‌های آتی Browther، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8 استفاده می‌کند.</translation>
<translation id="8362914115861174987">ترجمه به</translation>
<translation id="8367705492654390392">هرچه می‌خواهید بپرسید</translation>
<translation id="5769022907892823357">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Browther وارد شوید. بعداز اینکه به سیستم وارد شدید، این گذرواژه در «حساب Browther» شما ذخیره خواهد شد.</translation>
<translation id="4782442810031768771">‏سپس باید Browther را بازراه‌اندازی کنید.</translation>
<translation id="8265348385714408341">‏‫Browther توصیه می‌کند آن را بردارید. <ph name="BEGIN_LINK"/>درباره افزونه‌های پشتیبانی‌شده بیشتر بدانید<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">‏این افزونه توسط توسعه‌دهنده آن لغو انتشار شده است و ممکن است ناامن باشد. آن را از Browther حذف کنید تا دیگر نتواند داده‌های شما (ازجمله اطلاعات شخصی) را در سایت‌هایی که بازدید می‌کنید ببیند و تغییر دهد.</translation>
<translation id="1613655732912855341">‏قبل‌از اینکه بتوان برخی‌از داده‌ها را در «حساب Browther» شما ذخیره کرد و در همه دستگاه‌هایتان استفاده کرد، Browther باید هویت شما را تأیید کند. اگر اکنون از سیستم خارج شوید، این داده‌ها حذف خواهد شد.</translation>
<translation id="9103715009358215214">{0,plural, =1{‏Browther را ظرف یک روز راه‌اندازی مجدد کنید}one{‏Browther را ظرف # روز راه‌اندازی مجدد کنید}other{‏Browther را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="8438543370129609977">‏وقتی از «جستجوی تصویر» استفاده می‌کنید، عنوان، نشانی وب، و محتوای صفحه (ازجمله فایل‌های PDF) به سرور ارسال می‌شود. <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">‏درباره جستجو کردن با «جستجوی تصویر» در Browther بیشتر بدانید</translation>
<translation id="1401757916223057494">‏بایگانی نصب‌کننده خراب یا نامعتبر است. لطفاً Browther را دوباره را بارگیری کنید.</translation>
<translation id="5029760494698649486">‏Browther به Windows 10 یا بالاتر نیاز دارد.</translation>
<translation id="7906734902028783072">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به Browther، به بهبود ویژگی‌ها و عملکرد ChromeOS کمک کنید.</translation>
<translation id="6791756730901393492">‏برای ذخیره کردن داده‌های Browther در «حساب Browther» خود و استفاده کردن از آن‌ها، هویتتان را درستی‌سنجی کنید</translation>
<translation id="4879869745782826167">‏پیام‌واره‌های ورود به سیستم Browther را نشان می‌دهد</translation>
<translation id="2967761098021401720">‏نسخه Browther قدیمی است</translation>
<translation id="7674832651694000881">‏از اینکه Browther را به‌عنوان مرورگر پیش‌فرض خود انتخاب کردید سپاس‌گزاریم!</translation>
<translation id="4507581730979762077">‏‫Browther زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="7205233182271132386">‏اگر Browther یکی از گذرواژه‌هایتان را در سرقت اطلاعات شبکه عمومی پیدا کند، هشدار دریافت می‌کنید</translation>
<translation id="8555465886620020932">خطای سرویس: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">می‌توانید «جستجوی تصویر» را برای دسترسی آسان سنجاق کنید؛ روی دکمه «سنجاق کردن» در بالای پانل کناری کلیک کنید</translation>
<translation id="856656450041460113">جستجوی فهرست زبان‌ها</translation>
<translation id="75470458211269379">‏وقتی با «حساب Browther» خود به سیستم وارد می‌شوید، Browther می‌تواند گذرواژه‌هایتان را بررسی کند</translation>
<translation id="2108930010779660436">‏چندین سازمان Browther را مدیریت می‌کنند</translation>
<translation id="7209630341463003999">‏حق نشر <ph name="YEAR"/> نویسندگان Browther. کلیه حقوق محفوظ است.</translation>
<translation id="8601359445272098721">جدید! با انتخاب دکمه «ترجمه کردن صفحه‌نمایش»، می‌توانید هم نوشتار و هم تصاویر روی صفحه‌نمایش را ترجمه کنید</translation>
<translation id="782928371899183269">‏درحال راه‌اندازی Browther…</translation>
<translation id="8624541899164515475">«تنظیمات»، در زبانه جدیدی باز می‌شود.</translation>
<translation id="5879341334716115002">‏نمی‌توان Browther for Testing را به‌عنوان مرورگر پیش‌فرض تنظیم کرد.</translation>
<translation id="2433912322225810055">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی Browther یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="4816541973978692496">‏این Browther شماست</translation>
<translation id="8712637175834984815">متوجه شدم</translation>
<translation id="9037464035997618895">‏به سیستم Browther وارد می‌شوید؟</translation>
<translation id="7897185368811431919">‏همه‌چیز را در Browther نگه دارید</translation>
<translation id="8747073452963259673">‏گوشه پایین سمت راست ناحیه جستجو: ‎٪<ph name="LEFT"/> سمت راست، ‎٪<ph name="BOTTOM"/> پایین</translation>
<translation id="878572486461146056">خطای نصب: سرپرست شبکه شما «خط‌مشی گروهی» اعمال کرده است که از نصب جلوگیری می‌کند: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">‏Browther به مجوز دسترسی به دوربین و میکروفون برای این سایت نیاز دارد</translation>
<translation id="8813277370772331957">بعداً به من یادآوری شود</translation>
<translation id="6831999464349484462">‏به سیستم Browther وارد می‌شوید؟</translation>
<translation id="3698151322107951111">‏تنظیم کردن Browther به‌عنوان مرورگر پیش‌فرض و سنجاق کردن آن به نوار وظیفه</translation>
<translation id="8826492472752484139">روی «مدیر گذرواژه» کلیک کنید</translation>
<translation id="6933858244219479645">‏سیستم ChromeOS</translation>
<translation id="3986927308621489499">‏این زبان برای نمایش منوها، تنظیمات، هشدارها، و نوشتارهای دیگر در Browther استفاده می‌شود</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="5318226144018267261">‏افزودن نمایه Browther</translation>
<translation id="1298790608554316415">‏در این صورت، لطفاً گذرواژه ذخیره‌شده در Browther را ویرایش کنید تا با گذرواژه جدیدتان مطابقت داشته باشد.</translation>
<translation id="960933321883777733">‏سازمانتان شما را ملزم می‌کند به سیستم Browther وارد شوید</translation>
<translation id="948979409756947611">‏Browther در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="1418854271943945136">‏‫Browther دیگر مرورگر پیش‌فرض شما نیست. Browther  مرورگر پیش‌فرض شود</translation>
<translation id="7228667329366610727">‏به‌روزرسانی Browther امکان‌پذیر نیست</translation>
<translation id="4817697255467736794">‏نشان‌واره Browther Enterprise</translation>
<translation id="3507731466523097529">‏‫Browther شروع نشد، زیرا هنگام باز کردن نمایه‌تان مشکلی پیش آمد. ‫Browther را بازراه‌اندازی کنید.</translation>
<translation id="3234473600657230663">‏مدیریت نمایه‌های Browther</translation>
<translation id="8953887022581653484">‏‫Browther این بارگیری را مسدود کرد زیرا فایل بایگانی حاوی فایل‌های دیگری است که ممکن است بدافزار باشد</translation>
<translation id="532304972436358335">‏ورود به سیستم Browther هنگام وارد شدن به سیستم دیگر سرویس‌های Browther</translation>
<translation id="3425998261052065067">‏Browther به‌طور خودکار بسته شد</translation>
<translation id="4377377022617011492">‏نسخه Browther قدیمی است</translation>
<translation id="3247296757162889864">{0,plural, =1{‏Browther یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏Browther # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏Browther # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="9106236359747881194">نوشتاری را برای جستجو انتخاب کنید</translation>
<translation id="5115014198092384730">‏برای دریافت به‌روزرسانی‌های آتی Browther، باید Windows 10 یا بالاتر داشته باشید. این رایانه از Windows 8.1 استفاده می‌کند.</translation>
<translation id="7129101984664345614">‏باز کردن پیوند در &amp;برگه جدید Browther</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="9134482777260927479">کمک در تکالیف</translation>
<translation id="9148058034647219655">خارج شدن</translation>
<translation id="1734388504720121468">‏کارتان را از جایی که متوقف کرده بودید ادامه دهید: Browther می‌تواند هربار که آن را بازراه‌اندازی می‌کنید، زبانه‌هایتان را بازگرداند. برای روشن کردن این ویژگی، به اینجا بروید:</translation>
<translation id="8633974232736772207">‏سرپرست سیستم شما برای باز شدن مرورگر جایگزین برای دسترسی به <ph name="TARGET_URL_HOSTNAME"/>، Browther را پیکربندی کرده است.</translation>
<translation id="1122669402846843682">‏نکته Browther: جستجو کردن با «لنز»</translation>
<translation id="595330134356385835">‏راه‌اندازی مجدد برای به‌روزرسانی Browther</translation>
<translation id="2556178781950124146">‏Browther Origin‏ (mDNS ورودی)</translation>
<translation id="6491100124044190139">‏با ورود به سیستم Browther، از مزایای بیشتری بهره‌مند شوید</translation>
<translation id="1665840797775025867">‏شخصی‌سازی کردن Browther</translation>
<translation id="4407047432656809023">‏Browther ممکن است درست کار نکند زیرا دیگر در Windows XP یا Windows Vista پشتیبانی نمی‌شود</translation>
<translation id="945522503751344254">ارسال بازخورد</translation>
<translation id="7620348044248809366">‏چه‌کسی از Browther استفاده می‌کند؟</translation>
<translation id="7299962884342109067">‏دریافت قوی‌ترین امنیت Browther</translation>
<translation id="983803489796659991">نصب انجام نشد چون سرور به‌روزرسانی هیچ‌گونه داده درهمی برای برنامه ندارد.</translation>
<translation id="8775461190334353148">‏استفاده از Browther بدون حساب</translation>
<translation id="7146761239544860058">Browther Authors</translation>
<translation id="989970834842471429">نوشتار یا تصویری را برای جستجو کردن با «جستجوی تصویر» انتخاب کنید</translation>
<translation id="6616551030373607751">‏برای استفاده از مکان، در <ph name="BEGIN_LINK"/>تنظیمات سیستم<ph name="END_LINK"/> به Browther دسترسی دهید</translation>
<translation id="137466361146087520">‏Google Chrome نسخه بتا</translation>
<translation id="7535429826459677826">‏Google Chrome نسخه Dev</translation>
<translation id="5110032212554763592">‏به دلیل خطای نامشخص، نصب ناموفق بود. لطفاً دوباره Browther را بارگیری کنید.</translation>
<translation id="9074842261125908635">افزونه‌ها، برنامه‌ها و طرح‌های زمینه دریافتی از منابع ناشناخته می‌توانند به دستگاه شما آسیب بزنند. Browther توصیه می‌کند که آنها را فقط از <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> نصب کنید</translation>
<translation id="3593119910409528681">این افزونه خط‌مشی فروشگاه وب را نقض می‌کند و ممکن است ناامن باشد. آن را از Browther حذف کنید تا دیگر نتواند داده‌های شما را در سایت هایی که بازدید می‌کنید، از جمله اطلاعات شخصی شما، ببیند و تغییر دهد.</translation>
<translation id="5245976396374147971">‏هشدار: Browther نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت خصوصی»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="3629539416935660172">‏برای ایمن‌تر کردن Browther، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="157534302749986451">‏برای ایمن‌تر کردن Browther، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="3031052147361385845">‏باز کردن پیوند در پنجره &amp;ناشناس Browther</translation>
<translation id="5556794247782664281">‏باز کردن پیوند در پنجره &amp;ناشناس Browther</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Browther در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Browther در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Browther در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Browther در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Browther را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Browther را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Browther را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Browther را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Browther را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Browther را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Browther را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Browther را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="8762228142105311329">{COUNT, plural,
              =0 {محافظت پیشرفته نیاز دارد که Browther را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید}
              =1 {محافظت پیشرفته نیاز دارد که Browther را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید. پنجرهٔ خصوصی شما باز نخواهد شد.}
              other {محافظت پیشرفته نیاز دارد که Browther را برای اعمال به‌روزرسانی مجدد راه‌اندازی کنید. # پنجرهٔ خصوصی شما باز نخواهد شد.}}</translation>
<translation id="5749154344207139683">با پاسخ به این نظرسنجی ۱ دقیقه‌ای به ما کمک کنید تا حریم خصوصی را بهبود دهیم.</translation>
<translation id="6954203250660846933">وقتی در نوار آدرس یا کادر جستجو تایپ می‌کنید، Browther آنچه را که تایپ می‌کنید به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادات بهتری دریافت کند. این قابلیت در حالت «خصوصی» خاموش است.</translation>
<translation id="3542179014707218534">Browther خصوصی</translation>
<translation id="2076355018722231995">هنگام مرور صفحات در حالت خصوصی، Browther قبل از بارگیری سایت با استفاده از اتصال ناامن به شما هشدار می‌دهد.</translation>
</translationbundle>