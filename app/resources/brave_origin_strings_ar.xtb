<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="1026101648481255140">استئناف التثبيت</translation>
<translation id="7099479769133613710">‏إعادة التشغيل لتحديث نظام التشغيل &amp;Browther</translation>
<translation id="7264054672589027446">‏ينصح Browther بمراجعة هذه الإضافة</translation>
<translation id="7848219163187166649">‏عندما يطلب موقع إلكتروني تحميل الروابط في صفحته مسبقًا بخصوصية تامة، يستخدم Browther خوادم Browther. يؤدي هذا الإجراء إلى إخفاء هويتك عن الموقع الإلكتروني الذي يتم تحميله مسبقًا، ولكن تبقى Browther على اطّلاع بالمواقع الإلكترونية التي يتم تحميلها مسبقًا.</translation>
<translation id="1065672644894730302">لا يمكن قراءة إعداداتك المفضّلة. قد تكون بعض الميزات غير متاحة، ولن يتم حفظ التغييرات في الإعدادات المفضّلة.</translation>
<translation id="8837164267124113709">‏أوقفَ أحد والدَيك "أذونات المواقع الإلكترونية والتطبيقات والإضافات" لمتصفِّح Browther.</translation>
<translation id="881513728707488138">‏يرغب Browther في تصدير كلمات المرور، لذا يُرجى كتابة كلمة مرور Windows للسماح بذلك.</translation>
<translation id="112640046208448578">يمكنك التعرّف على الصور أو الأماكن ونسخ النصوص أو ترجمتها. وعند استخدام ميزة "البحث بالصور"، يتمّ إرسال لقطة شاشة للصفحة إلى الخادم. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">‏Browther هو متصفحك التلقائي</translation>
<translation id="6580138787163923852">‏للتحقُّق مما إذا كانت كلمات المرور آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK"/>تسجيل الدخول إلى Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">‏انقر على قائمة Browther.</translation>
<translation id="1157985233335035034">أحدث اللغات</translation>
<translation id="3673786631598474384">‏ثبَّت الشريك <ph name="PARTNER_NAME"/> إضافة جديدة قد تؤدي إلى تغيير طريقة عمل Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">‏تعذَّر التثبيت بسبب عدم توافُق الإصدار الذي تستخدمه من نظام التشغيل Windows.</translation>
<translation id="8291401179516272335">‏لمحة عن Browther</translation>
<translation id="1203500561924088507">شكرًا على التثبيت. عليك إعادة تشغيل المتصفِّح قبل استخدام <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">‏عند فتح ميزة "البحث بالصور"، سيتم تلقائيًا إرسال عنوان الصفحة وعنوان URL والمحتوى (بما في ذلك ملفات PDF) إلى الخادم. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">‏بعد تسجيل الدخول إلى حسابك، يمكنك استخدام كلمات المرور وغيرها من بيانات حسابك على Browther في Browther. لتغيير ذلك، يُرجى الانتقال إلى "حسابك في Browther".</translation>
<translation id="9034321258761608912">‏عندما كانت علامة التبويب هذه غير نشطة، تم إخلاء مساحة في الذاكرة للحفاظ على سرعة Browther. يمكنك اختيار أن يظل هذا الموقع الإلكتروني نشطًا دائمًا.</translation>
<translation id="249571811018731941">‏حَظَر Browther عملية التنزيل هذه لأنّ الملف خطير.</translation>
<translation id="8850227089720975601">‏عند تسجيل الدخول إلى خدمات Browther، مثل Gmail أو YouTube باستخدام <ph name="USER_EMAIL"/>، يمكنك تسجيل الدخول تلقائيًا إلى Browther باستخدام الحساب نفسه</translation>
<translation id="1290883685122687410">حدث خطأ أثناء الإعداد: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">‏إعداد ملفك الشخصي الجديد على Browther</translation>
<translation id="4437862975743821367">‏يجب منح Browther الإذن بالوصول إلى البلوتوث لاستكشاف 
الأجهزة التي تتضمّن بلوتوث. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">رصد اللغة</translation>
<translation id="1206925267243987362">‏استخدام إعدادات المتصفِّح المقترَحة من Browther</translation>
<translation id="8270483548049772782">‏حذف البيانات من Browther أيضًا (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">تمّ تثبيت اللوحة. يمكنك الوصول إلى ميزة "البحث بالصور" مرة أخرى من خلال الزر الجديد في شريط الأدوات</translation>
<translation id="1356661055722410047">ميزة جديدة: يمكنك ترجمة كل من النص والصور على شاشتك</translation>
<translation id="1383876407941801731">البحث</translation>
<translation id="1592588950737518481">‏&amp;إدارة الملفات الشخصية على Browther</translation>
<translation id="1404026649028693342">‏عرض "وضع AI" دائمًا</translation>
<translation id="141901961143729572">شارِك أفكارك</translation>
<translation id="1743952081001089298">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في Browther ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="8627385813382688019">‏الحصول على مساعدة بشأن Browther for Testing</translation>
<translation id="1497802159252041924">حدث خطأ أثناء التثبيت: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">هذه الصفحة محمية</translation>
<translation id="7252430412915798987">‏مشاركة علامة تبويب Browther</translation>
<translation id="6388429281015199562">‏تسجيل الدخول إلى Browther</translation>
<translation id="1547469039832541117">يؤدي النقر على هذا الزر إلى إنهاء المهمّة المحدّدة.</translation>
<translation id="1801944307203212016">‏يحتاج Browther إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للبيئة المحيطة بك.</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{‏لم تعُد هذه الإضافة متوافقة. ينصح المتصفّح Browther بإزالتها.}zero{‏لم تعُد هذه الإضافات متوافقة. ينصح المتصفّح Browther بإزالتها.}two{‏لم تعُد هاتان الإضافتان متوافقتين. ينصح المتصفّح Browther بإزالتهما.}few{‏لم تعُد هذه الإضافات متوافقة. ينصح المتصفّح Browther بإزالتها.}many{‏لم تعُد هذه الإضافات متوافقة. ينصح المتصفّح Browther بإزالتها.}other{‏لم تعُد هذه الإضافات متوافقة. ينصح المتصفّح Browther بإزالتها.}}</translation>
<translation id="4667068923142532753">‏تثبيت Browther</translation>
<translation id="3006560544901646947">‏أدوات الأمان في Browther</translation>
<translation id="686052171138185761">‏يريد Browther حذف بياناتك في "مدير كلمات المرور". للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="8713026329083542796">‏يمكنك مراجعة العناصر الرئيسية للتحكّم في الخصوصية والأمان في Browther.</translation>
<translation id="1640672724030957280">جارٍ التنزيل...</translation>
<translation id="1680687534629375545">طرح أسئلة حول محتوى هذه الصفحة باستخدام ميزة "البحث بالصور"</translation>
<translation id="1709772298389099340">توفِّر الخدمة أذونات مميّزة وعالية المستوى لمتصفِّح <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">‏يُرسل Browther تفاعلاتك مع هذه الميزات إلى Browther للمساعدة في تحسينها. وقد يقرأ المراجعون هذه البيانات ويعالجونها ويضيفون تعليقات توضيحية إليها.</translation>
<translation id="1722488837206509557">سيتيح لك هذا الإجراء الاختيار من بين الأجهزة المتاحة وعرض المحتوى عليها.</translation>
<translation id="6820510278633522408">‏سيحذف Browther بيانات التصفُّح قريبًا</translation>
<translation id="7775028004939172516">‏سيحاول Browther ترقية عمليات الانتقال إلى بروتوكول HTTPS.</translation>
<translation id="6963959729951758069">‏تم محو بيانات Browther</translation>
<translation id="4085139922884095932">‏ستتم إعادة تشغيل Browther خلال <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">‏سيستخدم Browther اتصالاً غير آمن بدون تحذيرك في حال عدم توفُّر بروتوكول HTTPS.</translation>
<translation id="3975328336074677101">‏دع Browther يعمل في الخلفية</translation>
<translation id="2497443204974841650">‏إعادة تثبيت Browther</translation>
<translation id="1724309687045787742">‏يحاول Browther <ph name="AUTHENTICATION_PURPOSE"/>.</translation>
<translation id="4553225588627299783">‏عند فتح Browther على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام "مدير كلمات المرور في Browther".</translation>
<translation id="1838374766361614909">محو البحث</translation>
<translation id="2337233040802538155">‏لحذف بيانات التصفّح من هذا الجهاز فقط والاحتفاظ بها في حسابك على Browther، يُرجى <ph name="BEGIN_LINK"/>تسجيل الخروج من Browther<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">‏يكفي تنزيل متصفِّح Browther على هاتفك لفتح مجموعات علامات التبويب أو إنشائها أثناء التنقّل.</translation>
<translation id="2063443520349987970">‏يمكنك إدارة حسابات Browther التي تم تسجيل الدخول إليها. يتم استخدام حساباتك على Browther في متصفّح Browther و"متجر Play" وGmail والمزيد. إذا أردت إضافة حساب لمستخدم آخر، مثل أحد أفراد العائلة، أضِف شخصًا جديدًا إلى <ph name="DEVICE_TYPE"/> بدلاً من ذلك. <ph name="LINK_BEGIN"/>مزيد من المعلومات<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">البحث باستخدام ميزة "البحث بالصور"</translation>
<translation id="1880677175115548835">اختيار نص</translation>
<translation id="3183933389992069620">‏أنت تسجل الدخول باستخدام حساب يخضع للإدارة وتتيح للمشرف إمكانية التحكم في ملفك الشخصي على Browther. وستكون بياناتك في Browther مثل تطبيقاتك وإشاراتك المرجعية وسجلك وكلمات المرور التابعة لك والإعدادات الأخرى مرتبطة دائمًا بالمستخدم <ph name="USER_NAME"/>. ستتمكن من حذف هذه البيانات عبر لوحة تحكم حسابات Browther، ولكنك لن تتمكن من إقران هذه البيانات بحساب آخر. ويُمكنك اختيار إنشاء ملف شخصي جديد للإبقاء على بياناتك الحالية في Browther بشكل مستقل. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">‏يحافظ Browther على طاقة البطارية من خلال الحدّ من الأنشطة في الخلفية والتأثيرات المرئية، مثل التمرير السلس وعدد اللقطات في الثانية للفيديو. <ph name="BEGIN_LINK"/>مزيد من المعلومات حول ميزة "توفير البطارية"<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">طرح سؤال حول هذه الصفحة</translation>
<translation id="9128006428501241840">‏خدمة Browther Updater</translation>
<translation id="6302815314157879372">‏من خلال إيقاف هذا الإعداد، يمكنك تسجيل الدخول إلى "مواقع Browther" مثل Gmail بدون الحاجة إلى تسجيل الدخول إلى Browther</translation>
<translation id="1063611196035804685">‏لا يستجيب Browther. هل تريد إعادة التشغيل الآن؟</translation>
<translation id="2873360330889594383">‏تطلُب المؤسسة (<ph name="MANAGER"/>) منك تسجيل الدخول إلى Browther</translation>
<translation id="4035053306113201399">‏يجب إعادة تشغيل نظام التشغيل Browther حتى يتم تطبيق التحديث.</translation>
<translation id="2861285003831382718">‏حَظَر Browther عملية التنزيل هذه لأنّ نوع الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="1953553007165777902">جارٍ التنزيل… عدد الدقائق المتبقّية: <ph name="MINUTE"/></translation>
<translation id="2080160985220483492">‏نصيحة من Browther: حفظ كلمات المرور أولوية</translation>
<translation id="8037497710694492565">‏يتعذَّر على Browther تحديد المتصفح التلقائي أو تعيينه</translation>
<translation id="7395009124247513849">‏التعرّف على سبب حظر بعض الملفات في Browther، يتم فتح الرابط في علامة تبويب جديدة</translation>
<translation id="762710512520170632">‏تساعد هذه الخدمة على تحديث برامج Browther باستمرار. لذا في حال إيقافها بشكل نهائي أو مؤقت، لن يتم تحديث برامج Browther باستمرار، ما يعني أنّه لا يمكن إصلاح الثغرات الأمنية التي قد تحدث وقد لا تعمل بعض الميزات. ويتمّ إلغاء تثبيت هذه الخدمة تلقائيًا من الجهاز عند عدم استخدام أي من برامج Browther لها.</translation>
<translation id="5793588180426267429">‏سيعمل هذا على حذف عنصر واحد من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Browther كـ <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">تعذّر التثبيت. يُرجى إعادة المحاولة.</translation>
<translation id="6351516710581760512">‏للتحقُّق مما إذا كانت كلمات المرور الأخرى آمنة من عمليات اختراق البيانات ومشاكل الأمان الأخرى، يُرجى <ph name="BEGIN_LINK"/>تسجيل الدخول إلى Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">الإعدادات</translation>
<translation id="8194525816714210105">‏اختَر ما إذا كنت تريد تضمين سجلّ Browther للحصول على تجارب أكثر تخصيصًا في خدمات Browther.</translation>
<translation id="5909559127548969159">‏يمكنك النقر على زر "تخصيص Browther" في صفحة "علامة تبويب جديدة" لإضفاء مظهر جديد عليه</translation>
<translation id="2066690553719545730">‏عرض "وضع AI" دائمًا</translation>
<translation id="3283892260110318935">‏حَظَر Browther عملية التنزيل هذه لأنّ الملف مخادع وقد يُجري تغييرات غير متوقعة على جهازك.</translation>
<translation id="6160571936643742128">‏ستظهر لك رسالة تطلب منك تجربة "<ph name="FEATURE_NAME"/>" عند فتح Browther على iOS في المرة القادمة.</translation>
<translation id="8380517409933452343">‏ستتم إزالة كلمات المرور وبيانات Browther الأخرى التي تم حفظها في حسابك على Browther من هذا الجهاز. ولاستخدامها مرة أخرى في Browther، عليك تسجيل الدخول مجددًا.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Browther لمدة دقيقة واحدة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Browther لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}two{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Browther لمدة دقيقتَين. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}few{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Browther لمدة # دقائق. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}many{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Browther لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}other{‏استنادًا إلى إعدادات مؤسستك، يتم حذف بيانات التصفُّح تلقائيًا عند عدم استخدام Browther لمدة # دقيقة. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل. وستظل علامات التبويب مفتوحة.}}</translation>
<translation id="2126108037660393668">تعذَّر التحقق من الملف الذي تم تنزيله.</translation>
<translation id="2135919691573380097">الإبلاغ عن هذا الموقع الإلكتروني</translation>
<translation id="2137162749895930932">إغلاق شاشة الترجمة</translation>
<translation id="4283559398694996391">‏حَظَر Browther عملية التنزيل هذه لأنّ الموقع الإلكتروني لا يستخدم اتصالاً آمنًا وربما تمّ التلاعب بالملف.</translation>
<translation id="2170098639895543546">اختيار أي محتوى على الصفحة</translation>
<translation id="2495182092286337191">‏تخصيص Browther</translation>
<translation id="2174917724755363426">لم يكتمل التثبيت. هل تريد فعلاً الإلغاء؟</translation>
<translation id="4877141231724140862">‏Browther - تسجيل الدخول إلى الشبكة - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">خطأ في عملية التحقق من التحديث: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">‏إزالة الحساب من Browther</translation>
<translation id="1084363153644366288">‏يمكنك الحفاظ على أمانك أثناء التنقّل باستخدام ميزة "الحماية المحسّنة للتصفّح الآمن" في Browther على أجهزة iOS</translation>
<translation id="7949164640723239455">‏هذا الموقع الإلكتروني خطير، لذلك أزال Browther إذن الإشعارات.</translation>
<translation id="2236949375853147973">نشاطي</translation>
<translation id="4536403809133456417">‏يمكنك تسجيل الدخول إلى Browther للوصول إلى العناوين وغيرها على جميع أجهزتك. وسيتم حفظ هذا العنوان في حسابك على Browther بعد تسجيل الدخول.</translation>
<translation id="5627930103267312171">‏إذا كنت تشارك الكمبيوتر مع أصدقائك وعائلتك، فبإمكانهم التصفح على حدة وإعداد Browther على النحو الذي يريدونه.</translation>
<translation id="2283803047247799269">البحث في علامة التبويب هذه باستخدام ميزة "البحث بالصور"</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{‏ينصح Browther بإيقاف علامة التبويب التي تبطئ المتصفّح مؤقتًا}zero{‏ينصح Browther بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}two{‏ينصح Browther بإيقاف علامتَي التبويب اللتين تبطئان المتصفّح مؤقتًا}few{‏ينصح Browther بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}many{‏ينصح Browther بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}other{‏ينصح Browther بإيقاف علامات التبويب التي تبطئ المتصفّح مؤقتًا}}</translation>
<translation id="2307973900865360088">‏إبقاء التطبيق في شريط التطبيقات (Dock)</translation>
<translation id="5161617112768367959">‏يعمل هذا الوضع على التحقّق من عناوين URL التي تحتوي على قائمة بمواقع إلكترونية غير آمنة مُخزّنة في Browther. وإذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسل متصفِّح Browther أيضًا عناوين URL تتضمّن أجزاء من محتوى الصفحة إلى "التصفُّح الآمن".</translation>
<translation id="4123094831918713833">‏سيؤدي هذا الإجراء إلى ما يلي:
        <ph name="LINE_BREAKS"/>
          • إعادة ضبط بعض إعدادات Browther واختصاراته
          <ph name="LINE_BREAK"/>
          • إيقاف الإضافات
          <ph name="LINE_BREAK"/>
          • حذف ملفات تعريف الارتباط والبيانات المؤقَّتة الأخرى للمواقع الإلكترونية
          <ph name="LINE_BREAKS"/>
          لن يؤثّر هذا الإجراء في الإشارات المرجعية والسجلّ وكلمات المرور المحفوظة.</translation>
<translation id="5456070119344236353">‏لإرسال رقم من هذا الجهاز إلى جهازك الذي يعمل بنظام التشغيل Android، يُرجى تسجيل الدخول إلى Browther على الجهازَين.</translation>
<translation id="2356070529366658676">طلب</translation>
<translation id="2359808026110333948">متابعة</translation>
<translation id="6468415397021485143">‏تطلب منك الإضافة "<ph name="EXTENSION_NAME"/>" تسجيل الدخول إلى Browther</translation>
<translation id="2558600429878197587">‏إيقاف تشغيل Browther في الخلفية أثناء عمل التطبيقات</translation>
<translation id="5295781918312989856">‏لاستخدام هذه الإضافة على الحساب <ph name="USER_EMAIL_ADDRESS"/>، عليك تسجيل الدخول إلى Browther.</translation>
<translation id="8418845734693287262">‏تعذّر على نظام التشغيل Browther مزامنة بياناتك لأن تفاصيل تسجيل الدخول إلى حسابك قديمة.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات Browther تصل إلى جهاز HID واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى جهاز HID واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى جهازَي HID}few{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # أجهزة HID}many{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # جهاز HID}other{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # جهاز HID}}</translation>
<translation id="434258293817844111">‏يحتاج Browther إلى إذن للوصول إلى الكاميرا والميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="2403703063067034158">خطأ في بدء التشغيل: هناك عملية إعداد أخرى قيد التشغيل حاليًا. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="5458993228789433099">‏يمكنك فتح الروابط من أي تطبيق على Browther والوصول إلى المتصفّح بسهولة من خلال شريط المهام</translation>
<translation id="1677640217693742525">‏باستخدام <ph name="BEGIN_LINK"/>أدوات من Browther<ph name="END_LINK"/>، يمكنك التصفُّح بأمان والتحكُّم بشكل كامل</translation>
<translation id="2451727308784734061">استخدِم الاختصار للوصول بسرعة إلى "مدير كلمات المرور". بإمكانك نقل هذا الاختصار إلى الشاشة الرئيسية أو مشغِّل التطبيقات في جهاز الكمبيوتر.</translation>
<translation id="2280315911954332435">‏سيتم إغلاق Browther قريبًا</translation>
<translation id="6410820860979094113">‏في Browther</translation>
<translation id="2485422356828889247">إزالة التثبيت</translation>
<translation id="2513154137948333830"><ph name="INSTALL_SUCCESS"/>: يجب إعادة التشغيل.</translation>
<translation id="2542968102051442371">اختيار نص باستخدام ميزة "بحث بالصور"</translation>
<translation id="7892218991241200190">‏يحاول Browther استبدال كلمات المرور الحالية. للسماح بذلك، يُرجى كتابة كلمة المرور المستخدَمة في Windows.</translation>
<translation id="8976443723926188033">‏يحتاج Browther إلى الوصول إلى مساحة التخزين لتنزيل الملفات.</translation>
<translation id="4131374838781785973">‏أداة مساعدة Browther Origin</translation>
<translation id="2575822587468774919">انقر أي محتوى للبحث عنه باستخدام ميزة "البحث بالصور"</translation>
<translation id="8705561858232289221">‏سجِّل الدخول إلى Browther للوصول إلى كلمات المرور وغيرها على جميع أجهزتك</translation>
<translation id="437162022240011372">‏مواصلة استخدام Browther</translation>
<translation id="259935314519650377">تعذَّر إجراء تخزين مؤقت للمثبّت الذي تم تنزيله. الخطأ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">النظام</translation>
<translation id="2907676829052962091">‏يمكن لمؤسستك الاطّلاع على بيانات التصفّح وإدارتها، مثل الإشارات المرجعية والسجلّ وكلمات المرور. ولا يمكنها الاطّلاع على بيانات التصفّح في الملفات الشخصية الأخرى على Browther</translation>
<translation id="1289116577679005654">‏يُرجى إثبات هويتك لاستخدام بيانات Browther وحفظها في حسابك (<ph name="ACCOUNT_EMAIL"/>)</translation>
<translation id="7192278346779151664">‏حدث خطأ في نظام التشغيل أثناء عملية التثبيت. يُرجى إعادة تنزيل Browther.</translation>
<translation id="7724398260867885339">‏في حال مشاركة جهاز مع الأصدقاء والعائلة، يمكنهم الحصول على تجربة تصفّح منفصلة وإعداد Browther على النحو المفضّل لديهم.</translation>
<translation id="1679595317134614424">‏علامة تبويب Browther</translation>
<translation id="7189168846924379421">‏لمزيد من الأمان، سيشفر Browther بياناتك</translation>
<translation id="4052643592793184278">‏لإزالة حسابك على Browther من Browther، يجب تسجيل الخروج</translation>
<translation id="7694616023994438906">‏للوصول إلى كلمات المرور والإشارات المرجعية وغيرهما على جميع أجهزتك، يجب تسجيل الدخول إلى Browther</translation>
<translation id="2738871930057338499">‏تعذر الاتصال بالإنترنت. بروتوكول HTTP 403 محظور. يُرجى التحقق من إعدادات الخادم الوكيل.</translation>
<translation id="2753623023919742414">انقر للبحث</translation>
<translation id="9078193405195503710">‏ضبط Browther كعارض PDF التلقائي</translation>
<translation id="2456995288904753506">‏يمكن لمتصفِّح Browther ملء الحقول الصعبة التي قد لا ترصدها ميزة "الملء التلقائي" العادية</translation>
<translation id="3271730304285122987">‏هذه الإضافة غير آمنة وتحتوي على برامج ضارة. يُرجى إزالة هذه الإضافة من Browther كي لا تتمكّن من الاطّلاع على بياناتك وتغييرها، بما في ذلك معلوماتك الشخصية، على المواقع الإلكترونية التي تزورها.</translation>
<translation id="2799223571221894425">إعادة تشغيل</translation>
<translation id="1427337251963884503">‏بياناتك على Browther</translation>
<translation id="2816462166102338036">البحث عن هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="2841525013647267359">ترجمة من</translation>
<translation id="2846251086934905009">خطأ في التثبيت: لم تكتمل أداة التثبيت. تم إلغاء عملية التثبيت.</translation>
<translation id="928966105228355994">‏إزالة من Browther</translation>
<translation id="587805782197019018">‏يوفّر لك هذا الوضع حماية في Browther، ويمكن استخدامه لتحسين مستوى أمانك في تطبيقات Browther الأخرى عندما تكون مسجلاً دخولك.</translation>
<translation id="2885378588091291677">إدارة المهام</translation>
<translation id="3055995278166070443">‏حو&amp;ل Browther</translation>
<translation id="2915996080311180594">إعادة التشغيل لاحقًا</translation>
<translation id="2928420929544864228">اكتمل التثبيت.</translation>
<translation id="70453521937551896">‏تم تشفير بياناتك باستخدام عبارة المرور. عليك إدخال عبارة المرور لاستخدام بيانات Browther وحفظها في حسابك على Browther.</translation>
<translation id="2945997411976714835">خطأ في التثبيت: تعذّر بدء عملية التثبيت.</translation>
<translation id="3188308520233701133">‏يمكنك تسجيل الدخول بشكل أسرع إلى المواقع الإلكترونية باستخدام كلمات المرور المحفوظة في Browther على أجهزة iOS</translation>
<translation id="8145318807880784886">‏يمكنك إضافة ملف شخصي جديد على Browther للفصل بين الإشارات المرجعية وكلمات المرور والإعدادات.</translation>
<translation id="4330268530227888227">‏تدير مؤسستك متصفِّح Browther</translation>
<translation id="6488090896442998436">‏Browther محدّث</translation>
<translation id="300557164611864786">‏إذا حاول موقع إلكتروني سرقة كلمة المرور أو إذا نزّلت ملفًا ضارًا، قد يرسِل متصفِّح Browther أيضًا عناوين URL تتضمّن أجزاءً من محتوى الصفحة إلى خدمة "التصفُّح الآمن".</translation>
<translation id="2447145782593796785">‏للحفاظ على أمانك على الإنترنت من خلال خيارات أحد والدَيك، سجِّل الدخول إلى Browther</translation>
<translation id="3003694935412297923">كل المهام</translation>
<translation id="7554113777150891030">{count,plural, =1{‏يحتاج Browther إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Browther واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏يحتاج Browther إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Browther واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏يحتاج Browther إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Browther واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏يحتاج Browther إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Browther واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏يحتاج Browther إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Browther واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏يحتاج Browther إلى إثبات هويتك قبل حفظ بعض البيانات في حسابك على Browther واستخدامها على جميع أجهزتك. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="5522228731050510047">‏افتح <ph name="URL"/> في علامة تبويب جديدة في Browther.</translation>
<translation id="6358780591055960280">‏يتعذّر على Browther التحقّق من كلمات المرور. يُرجى إعادة المحاولة.</translation>
<translation id="1386422761453740126">‏جارٍ الإضافة إلى Browther...</translation>
<translation id="3038232873781883849">في انتظار التثبيت...</translation>
<translation id="3045032126857188731">اللغة الهدف: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">إغلاق مربّع حوار الملاحظات</translation>
<translation id="369127628511662602">‏الملفات الشخصية الأخرى على Browther</translation>
<translation id="2370255879896574713">‏يمكنك المساعدة في تحسين Browther عن طريق إرسال تقارير الأعطال و<ph name="UMA_LINK"/> إلى Browther</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{‏كانت إضافة واحدة أو أكثر من إضافات Browther تصل إلى جهاز USB واحد}=1{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى جهاز USB واحد}two{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # جهازَي USB}few{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # أجهزة USB}many{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # جهاز USB}other{‏تصل إضافة واحدة أو أكثر من إضافات Browther إلى # جهاز USB}}</translation>
<translation id="2065456480740480340">‏سجلّ Browther</translation>
<translation id="5011660649081947055">‏تعذّرت أداة التثبيت في فك ضغط الأرشيف. يُرجى إعادة تنزيل Browther.</translation>
<translation id="310459126943037700">تعذَّر إنهاء المهام.</translation>
<translation id="3104828284009500087">البحث عن أي محتوى على الصفحة</translation>
<translation id="4917564010081457061">‏يمكنك الحفاظ على مزامنة كلمات المرور والإشارات المرجعية والسجلّ بشكل مثالي على جميع الأجهزة، وكذلك الوصول بسهولة إلى الميزات المألوفة والمفضَّلة لديك من خلال ضبط Browther كمتصفِّحك التلقائي.</translation>
<translation id="1041472930719344928">‏يستخدم Browther الميكروفون.</translation>
<translation id="3130333203120345554">بحث جديد</translation>
<translation id="3137969841538672700">اسحب للبحث</translation>
<translation id="5312717254055363883">‏تستخدم علامة التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح Browther بإيقاف علامة التبويب هذه.</translation>
<translation id="373523409348786203">‏لمشاركة شاشتك، يجب السماح بتسجيل الشاشة في Browther ضِمن "إعدادات النظام" (System Settings)</translation>
<translation id="802113445299754598">‏إعادة تشغيل Browther</translation>
<translation id="3161522574479303604">كل اللغات</translation>
<translation id="4522189060330781648">‏أضاف برنامج آخر على جهاز الكمبيوتر مظهرًا قد يؤدي إلى تغيير طريقة عمل Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">‏يمكنك الآن تخصيص ملفك الشخصي الجديد على Browther.</translation>
<translation id="5150830326120505481">‏لإزالة حسابك على Browther من Browther، يجب تسجيل الخروج من Browther في صفحة "الإعدادات"</translation>
<translation id="7113660200899017820">‏يمكن أن يسألك متصفِّح Browther لاحقًا عن رغبتك في استخدام المعلومات المحفوظة لملء النماذج تلقائيًا بالنيابة عنك</translation>
<translation id="4475011322243623412">‏يتعذر على Browther القراءة والكتابة في دليل البيانات الخاص به:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">إعادة التشغيل الآن</translation>
<translation id="3536063527222598206">‏مفاتيح واجهة برمجة تطبيقات Browther مفقودة. وسيترتب على ذلك توقف بعض وظائف Browther عن العمل.</translation>
<translation id="1011450868746766298">‏استمرار تشغيل تطبيقات الخلفية عند إغلاق Browther</translation>
<translation id="179611081153855734">‏سيحذرك Browther قبل تحميل أي موقع إلكتروني يستخدم اتصالاً غير آمن.</translation>
<translation id="8965591964936552871">‏سيتم تسجيل خروجك من معظم المواقع الإلكترونية عند إغلاق جميع نوافذ Browther، باستثناء حسابك على Browther إذا كنت مسجلاً الدخول إلى Browther. للسماح للمواقع الإلكترونية بتذكُّر بياناتك، <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">‏تم تغيير محرك البحث التلقائي من مصدر خارج Browther. ولحمايتك، أعاد Browther ضبطه.</translation>
<translation id="1170501833661894915">‏يُرجى تسجيل الدخول إلى Browther للوصول إلى كلمات المرور والإشارات المرجعية وغيرها على جميع أجهزتك</translation>
<translation id="3352986031709923790">أعلى يسار مساحة البحث: %<ph name="RIGHT"/> من الجهة اليسرى و%<ph name="TOP"/> من الأعلى</translation>
<translation id="120745000989996104">‏بيانات Browther في حسابك</translation>
<translation id="3369405342922656244">البحث في محتوى هذه الصفحة باستخدام ميزة "البحث بالصور"</translation>
<translation id="7173761126541905083">‏بتنزيل Browther، يمكنك استخدام كلمات المرور الخاصة بك على هاتفك</translation>
<translation id="2645435784669275700">‏نظام التشغيل Browther</translation>
<translation id="5266583242423616945">‏هل تريد الانتقال إلى الملف الشخصي الحالي على Browther؟</translation>
<translation id="3412460710772753638">في "مدير كلمات المرور" على هذا الجهاز</translation>
<translation id="4282363917570905631">‏بتنزيل Browther، ستكون "الحماية المحّسنة للتصفح الآمن" متاحة على هاتفك أيضًا</translation>
<translation id="986094398735583155">‏جارٍ تخصيص Browther…</translation>
<translation id="3266047225484320321">‏في حال تسجيل الدخول باستخدام كلمة مرور محتمَل تعرّضها للاختراق، سيرسل Browther إشعارًا إليك.</translation>
<translation id="3508047337876211050">‏سيعمل هذا على حذف <ph name="ITEMS_COUNT"/> من العناصر من هذا الجهاز. لاسترداد بياناتك لاحقًا، سجّل الدخول إلى Browther كـ <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">‏يعمل الاختصار <ph name="SHORTCUT"/> على التبديل بين الملفات الشخصية على Browther.</translation>
<translation id="7225005776233199285">‏يُرجى إغلاق جميع نوافذ Browther وإعادة المحاولة.</translation>
<translation id="5465054931427475969">‏لمشاركة النافذة، يجب السماح بتسجيل الشاشة في Browther ضِمن "إعدادات النظام" (System Settings)</translation>
<translation id="6905469223518185641">‏سبق أن تم تسجيل الدخول إلى حساب "<ph name="EXISTING_USER"/>".  للحصول على تجربة تصفّح منفصلة، سجِّل الدخول إلى Browther في ملفك الشخصي باستخدام العنوان <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">‏لمشاركة شاشتك، يجب السماح بتسجيل الشاشة في Browther ضِمن "إعدادات النظام" (System Settings).</translation>
<translation id="3597003331831379823">تعذَّر إجراء عملية الإعداد باستخدام أذونات مميزة وعالية المستوى. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">‏سجِّل الدخول إلى Browther</translation>
<translation id="2492221622209669678">‏ستُحذَف بيانات تصفُّح هذا المستخدم من هذا الجهاز. ولاسترداد البيانات، سجّل الدخول إلى Browther بصفتك <ph name="USER_EMAIL"/>.</translation>
<translation id="6793778233257855801">‏لإرسال رقم من <ph name="ORIGIN"/> إلى هاتفك الذي يعمل بنظام التشغيل Android، يُرجى تسجيل الدخول إلى Browther على الجهازَين.</translation>
<translation id="3667616615096815454">يتعذّر تثبيت التطبيق لأنّه غير معروف لدى الخادم.</translation>
<translation id="5585500151754164442">‏لتشفير جميع بيانات Browther في حسابك على Browther، يمكنك استخدام <ph name="BEGIN_LINK"/>عبارة المرور الخاصة بك<ph name="END_LINK"/>. لن يتم تشفير طُرق الدفع والعناوين من Google Pay. ولن تتم مزامنة سجلّ التصفُّح من Browther.</translation>
<translation id="404323216042159951">‏يتعذّر على Browther التحقّق من كلمات المرور. يُرجى التحقّق من اتصال الإنترنت.</translation>
<translation id="5004936474632127765">‏فتح الرابط في علامة تبويب جديدة في Browther</translation>
<translation id="6236643159256182256">‏ربط متصفّح Browther وخدمات Browther الأخرى لأغراض تخصيص الخيارات وأغراض أخرى</translation>
<translation id="3729187154190517324">يمكنك تعزيز نتائج بحثك عن طريق إضافة علامات تبويب وملفات وأدوات متعدّدة باستخدام زر "إضافة علامة تبويب والمزيد".</translation>
<translation id="1400697664933775238">‏إدارة الملفات الشخصية على Browther</translation>
<translation id="2461315395128103158">‏تعرّف على سبب حظر Browther لبعض عمليات التنزيل</translation>
<translation id="8058420662026104226">‏سيُعلِمك Browther في حال العثور على اقتراحات مطلوب مراجعتها.</translation>
<translation id="3177448557921912221">‏تساعدك الملفات الشخصية على Browther في الفصل بين جوانب حياتك المختلفة. بإمكانك إضافة ملف شخصي جديد الآن.</translation>
<translation id="1541177876035612043">‏يُحمِّل Browther مسبقًا الصفحات التي من المرجَح أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="3810973564298564668">إدارة</translation>
<translation id="1117103475254549453">‏لاستخدام كلمات المرور المحفوظة، يُرجى مسح رمز الاستجابة السريعة ضوئيًا وتنزيل Browther لجهاز iOS، ثم تسجيل الدخول إلى حسابك على Browther</translation>
<translation id="8880695882192156860">‏نصيحة من Browther: حان وقت "الحماية المحسّنة للتصفّح الآمن"</translation>
<translation id="3846683726093018685">**تلخيص:** أريد وصفًا للموضوع الرئيسي وهدف محتوى لقطة الشاشة في جملة واحدة لا تزيد عن 30 كلمة.

          **اقتراح أسئلة:** أريد قائمة نقطية تتضمّن من 3 إلى 5 أسئلة تشجّع على التفكير ويمكن للمستخدم طرحها لفهم لقطة الشاشة بشكل أفضل. يجب أن تتضمّن هذه الأسئلة سؤالاً واحدًا على الأقل يتعلّق بعنصر مرئي أو تصميمه أو موضعه تحديدًا.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> - Browther Origin</translation>
<translation id="3885770153807205175">أداة اختيار اللغة</translation>
<translation id="4861846616763552424">‏تخصيص Browther والتحكُّم فيه معلومات مهمة - انقر للحصول على التفاصيل.</translation>
<translation id="6126366281251241386">‏انقر على اسمك لفتح Browther وبدء التصفح.</translation>
<translation id="3892148308691398805">نسخ النص</translation>
<translation id="3760801273210219822">‏سبَق تسجيل دخول <ph name="EXISTING_USER"/> إلى هذا الملف الشخصي على Browther. لتوفير تجربة تصفّح منفصلة دائمًا، يمكن لمتصفِّح Browther إنشاء ملف شخصي خاص بك.</translation>
<translation id="3821553157234855663">‏تخصيص Browther</translation>
<translation id="3941890832296813527">خطأ في التثبيت: اسم ملف أداة التثبيت غير صالح أو غير متوافق.</translation>
<translation id="6482299900191767005">‏يحاول Browther نسخ كلمات المرور. اكتب كلمة مرور Windows للسماح بذلك.</translation>
<translation id="5853011008278898603">‏ستتم إزالة كلمات المرور وطرق الدفع والعناوين التي حفظتها في حسابك على Browther من هذا الجهاز. ولاستخدامها مرة أخرى في Browther، عليك تسجيل الدخول مجددًا.</translation>
<translation id="395904275706073188">لا يمكن قراءة الصفحات المحمية. ننصحك بتجربة الميزة على صفحة مختلفة.</translation>
<translation id="1832973663231751701">‏تعرّف على الطريقة التي يحافظ بها Browther على أمانك</translation>
<translation id="4531502594774670767">‏عند الكتابة في شريط العناوين أو مربّع البحث، يرسل Browther ما تمّت كتابته إلى أدوات البحث والذكاء الاصطناعي والوكلاء في مؤسستك للحصول على اقتراحات.</translation>
<translation id="300013383485253006">‏لمحة عن الإصدار Browther for Testing</translation>
<translation id="1152920704813762236">‏لمحة عن نظام التشغيل Browther</translation>
<translation id="8126752030994997015">‏عند الانتقال إلى موقع إلكتروني، يرسل متصفِّح Browther جزءًا مشفّرًا من عنوان URL إلى <ph name="BEGIN_LINK"/>ميزة "التصفّح الآمن من Browther"<ph name="END_LINK"/> من خلال خادم لحماية الخصوصية يُخفي عنوان IP الخاص بجهازك. وفي حال رصد سلوك مريب على موقع إلكتروني، يتم أيضًا إرسال عناوين URL الكاملة وأجزاء من محتوى الصفحة.</translation>
<translation id="3703994572283698466">‏أصبح نظام التشغيل Browther متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS"/>برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS"/>، كما هو الحال في <ph name="BEGIN_LINK_LINUX_OSS"/>بيئة تطوير Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">ترجمة محتوى الشاشة</translation>
<translation id="4023601594785368013">اللغة الأصلية: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">‏يمكنك فتح الروابط من أي تطبيق في Browther، ويمكن تثبيته في شريط المهام للوصول إليه بسهولة.</translation>
<translation id="3437506136408403836">‏ساعد في تحسين Browther بالإبلاغ عن <ph name="BEGIN_LINK"/>الإعدادات الحالية<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">تحسينات الأمان المهمة والميزات الجديدة متاحة في أحدث إصدار.</translation>
<translation id="4055805654398742145">مدير كلمات المرور</translation>
<translation id="2164947358785939495">‏ثبَّتَ برنامج آخر موجود على الكمبيوتر إضافة جديدة قد تؤدي إلى تغيير طريقة عمل Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Browther تلقائيًا عند عدم استخدامه لمدة دقيقة واحدة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}zero{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Browther تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}two{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Browther تلقائيًا عند عدم استخدامه لمدة دقيقتَين. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}few{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Browther تلقائيًا عند عدم استخدامه لمدة # دقائق. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}many{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Browther تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}other{‏استنادًا إلى إعدادات مؤسستك، يتم إغلاق متصفِّح Browther تلقائيًا عند عدم استخدامه لمدة # دقيقة. سيتم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.}}</translation>
<translation id="1535413545339990419">‏الانتقال إلى صفحة "لمحة عن Browther"</translation>
<translation id="692283249649018289">‏تخصيص Browther لإضفاء مظهر جديد على المتصفّح</translation>
<translation id="6375229634133804834">‏تخصيص Browther</translation>
<translation id="4148957013307229264">جارٍ التثبيت...</translation>
<translation id="2399933334889379115">‏<ph name="PAGE_TITLE"/> - تسجيل الدخول إلى الشبكة - Browther</translation>
<translation id="2911246138082876798">‏اكتشف تطبيقات، وألعاب، وإضافات، ومظاهر رائعة لمتصفح Browther.</translation>
<translation id="2528977475313334293">‏يمكنك تسجيل الدخول إلى Browther للحصول على هذه الإضافة وغيرها على جميع أجهزة الكمبيوتر الخاصة بك</translation>
<translation id="8244267655940711467">‏للحفاظ على أمانك على الإنترنت من خلال خيارات أحد والدَيك، انتقِل إلى ملفك الشخصي على Browther الذي سجّلت الدخول إليه من قبل باستخدام الحساب <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">جارٍ الإلغاء...</translation>
<translation id="4224210481850767180">تم إلغاء عملية التثبيت.</translation>
<translation id="8219359042845534271">‏هل ترغب في ربط بياناتك في Browther بهذا الحساب؟</translation>
<translation id="5520777668172961882">‏ستتلقّى تحذيرات بشأن المواقع الإلكترونية الخطيرة، بما فيها المواقع الإلكترونية التي لم يتعرّف عليها محرك بحث Browther، من خلال تحليل قدر أكبر من البيانات الواردة من مواقع إلكترونية، مقارنةً بالحماية العادية. يمكنك اختيار تخطّي تحذيرات Browther.</translation>
<translation id="2014920019837536689">‏تسجيل الخروج من Browther</translation>
<translation id="4341512411059715879">‏الحصول على مساعدة في Browther</translation>
<translation id="4281844954008187215">بنود الخدمة</translation>
<translation id="322492684764924424">‏تعذّر إتمام عملية التثبيت بسبب خطأ غير محدد. إذا كان Browther في حالة التشغيل حاليًا، يُرجى إغلاقه وإعادة المحاولة.</translation>
<translation id="3813060261346666066">‏تصدير كلمات المرور من Browther</translation>
<translation id="4304713468139749426">مدير كلمات المرور</translation>
<translation id="4334241893986177674">البحث في لقطة الشاشة هذه</translation>
<translation id="4334294535648607276">اكتمل التنزيل.</translation>
<translation id="2177954934431828302">‏يمكنك فتح Browther تلقائيًا عند بدء تشغيل Windows</translation>
<translation id="2472318668926455009">‏يمكنك الوصول بسهولة إلى الميزات المفضَّلة والموثوقة لديك من خلال ضبط Browther كمتصفِّحك التلقائي وتثبيته في شريط المهام للوصول إليه بسرعة.</translation>
<translation id="1068681683510904753">‏يشترط <ph name="MANAGER"/> قراءة بنود الخدمة التالية وقبولها قبل استخدام هذا الجهاز، مع العلم بأنّ هذه البنود لا توسِّع نطاق بنود نظام التشغيل Browther ولا تعدِّلها ولا تفرض قيودًا عليها.</translation>
<translation id="2897580280700805340">‏هل تريد الخروج من Browther على أي حال؟</translation>
<translation id="4413205837991854510">عرض اختصار ميزة "البحث بالصور" دائمًا</translation>
<translation id="2454897022983434851">‏السماح بتشغيل Browther في الخلفية</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{‏ينصح Browther بإزالة هذه الإضافة. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}zero{‏ينصح Browther بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}two{‏ينصح Browther بإزالة هاتين الإضافتَين. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}few{‏ينصح Browther بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}many{‏ينصح Browther بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}other{‏ينصح Browther بإزالة هذه الإضافات. <ph name="BEGIN_LINK"/>مزيد من المعلومات عن الإضافات المتوافقة<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">‏تخصيص Browther والتحكم فيه</translation>
<translation id="4427306783828095590">يؤدي تفعيل إعداد "الحماية المُحسَّنة" إلى حظر التصيّد الاحتيالي والبرامج الضارّة.</translation>
<translation id="4434353761996769206">خطأ في أداة التثبيت: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846">‏تدير "<ph name="MANAGER"/>" متصفِّح Browther</translation>
<translation id="4007482010626246887">‏إضافة ملف شخصي على Browther</translation>
<translation id="6888322430074420631">‏لمحة عن الإصدار Browther for Testing</translation>
<translation id="8912436499620582668">‏عليك إدخال عبارة المرور لاستخدام بيانات Browther وحفظها في حسابك على Browther</translation>
<translation id="4493028449971051158">خطأ في بدء التشغيل: يُرجى تشغيل أداة التثبيت بصفتك مشرفًا.</translation>
<translation id="4501471624619070934">تعذّر تثبيت التطبيق بسبب حظر الدخول المفروض في هذا البلد.</translation>
<translation id="8976207309012239417">‏لم تنشر هذه الإضافة الممارسات المتعلقة بالخصوصية، مثل كيفية جمعها للبيانات واستخدامها. ينصح متصفِّح Browther بإزالتها.</translation>
<translation id="8888202093812883067">‏مرحبًا بك في Browther Origin. تم فتح نافذة متصفّح جديدة.</translation>
<translation id="6391148383688605718">‏يحتاج Browther إلى إذن لتتبُّع اليدين وإنشاء خريطة للبيئة المحيطة بك</translation>
<translation id="7756445485815468244">‏سبق أن سجّلت الدخول باستخدام الحساب <ph name="USER_EMAIL_ADDRESS"/> في ملف شخصي آخر على Browther</translation>
<translation id="137435413163730206">‏يُحمِّل Browther الصفحات مسبقًا لزيادة سرعة التصفُّح والبحث. <ph name="BEGIN_LINK"/>مزيد من المعلومات حول التحميل المُسبَق للصفحات<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">يمكنك المساهمة في تحسين الأمان على الإنترنت للجميع عند الإبلاغ عن أي موقع إلكتروني في اعتقادك أنّه ضار.</translation>
<translation id="3266647901351304597">‏حَظَر Browther عملية التنزيل هذه لأنّك أوقفت ميزة "التصفُّح الآمن" ولا يمكن التحقّق من الملف.</translation>
<translation id="6980208900390333646">‏"عدسة Browther" بانتظارك في Browther على هاتفك</translation>
<translation id="4594305310729380060">في "مدير كلمات المرور" على هذا الجهاز</translation>
<translation id="5282047884678321451">‏تطبيقات Browther Origin</translation>
<translation id="4598116752460667024">يمكنك البحث عن أي عملية ضِمن القائمة.</translation>
<translation id="4970880042055371251">‏إصدار نظام التشغيل Browther</translation>
<translation id="4482468019601425607">‏أوشك التحديث على الانتهاء! إعادة تشغيل Browther لإنهاء التحديث.</translation>
<translation id="5517890123509214766">‏يعمل هذا الإعداد على زيادة سرعة المواقع الإلكترونية باستخدام محرّك V8 في Browther، ولكنه يحد قليلاً من قدرة Browther على مقاومة الهجمات</translation>
<translation id="7690070364551268156">‏في حال مشاركة تقارير استخدام Browther أيضًا، ستتضمّن هذه التقارير عناوين URL التي تنتقل إليها.</translation>
<translation id="5020487088453637212">‏يبدو أن الملف الشخصي قيد الاستخدام بواسطة عملية أخرى في Browther (<ph name="PROCESS_ID"/>) على جهاز كمبيوتر آخر (<ph name="HOST_NAME"/>). وقد تمّ قفل الملف الشخصي من جانب Browther لضمان عدم تعرضه للتلف. فإذا كنت واثقًا من عدم وجود عمليات أخرى قيد التشغيل على جهاز الكمبيوتر، فيُمكنك فتح قفل الملف الشخصي وإعادة تشغيل Browther مجددًا.</translation>
<translation id="4680828127924988555">إلغاء التثبيت</translation>
<translation id="8134827615154347946">‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجّلت الخروج الآن، فسيتم حذف هذه البيانات.</translation>
<translation id="3508712423420506333">‏بعد تسجيل الدخول إلى حسابك، يمكنك استخدام كلمات المرور وغيرها من بيانات حسابك على Browther في Browther. يمكنك تغيير إعدادات خدمات Browther باستخدام <ph name="SHORTCUT"/>.</translation>
<translation id="2388739442635757494">‏سجّل شخص ما الدخول من قبل إلى Browther على جهاز الكمبيوتر هذا باسم <ph name="ACCOUNT_EMAIL_LAST"/>. يُرجى إنشاء حساب مستخدم جديد في Browther للإبقاء على معلوماتك بشكلٍ منفصل.</translation>
<translation id="4724676981607797757">تعذَّر تثبيت التطبيق بسبب استخدام بروتوكول غير متوافق.</translation>
<translation id="8305313684264112434">‏هل تريد الخروج من Browther على أي حال؟</translation>
<translation id="418155915144835101">‏تم للتو تطبيق تحديث أمان خاص لمتصفِّح Browther. يمكنك إعادة التشغيل الآن وستتم استعادة علامات التبويب.</translation>
<translation id="2683970367518529374">‏طرح سؤال في Browther</translation>
<translation id="5064473048847774331">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال Browther إذنَي <ph name="PERMISSION_1"/> و<ph name="PERMISSION_2"/> وأذونات أخرى (<ph name="COUNT"/>).</translation>
<translation id="5941343075741207533">‏يتعذّر على Browther التحقُّق من كلمات المرور. يُرجى إعادة المحاولة بعد 24 ساعة أو <ph name="BEGIN_LINK"/>التحقُّق من كلمات المرور في حسابك على Browther<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">‏يستخدم ذلك المدقق الإملائي نفسه الذي يتم استخدامه في "بحث Browther". ويتم إرسال النص الذي تكتبه في المتصفّح إلى Browther. يمكنك دائمًا تغيير هذا السلوك في الإعدادات.</translation>
