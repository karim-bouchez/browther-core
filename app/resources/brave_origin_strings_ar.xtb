<translation id="48832130233362517">‏يُرجى التأكُّد من تسجيل الدخول إلى متصفِّح Browther على جهازك <ph name="TARGET_DEVICE_NAME"/> ثم محاولة الإرسال مرة أخرى.</translation>
<translation id="8868210753005945522">‏ثبَّتَ برنامج آخر على جهاز الكمبيوتر تطبيقًا قد يؤدي إلى تغيير طريقة عمل Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">‏يحتوي هذا الكمبيوتر فعلاً على إصدار أحدث من Browther. إذا كان البرنامج لا يعمل، يُرجى إزالة Browther وإعادة المحاولة.</translation>
<translation id="9222998061982994203">{0,plural, =0{‏ستتم إعادة تشغيل Browther الآن}=1{‏ستتم إعادة تشغيل Browther في غضون ثانية واحدة}two{‏ستتم إعادة تشغيل Browther في غضون ثانيتين}few{‏ستتم إعادة تشغيل Browther في غضون # ثوان}many{‏ستتم إعادة تشغيل Browther في غضون # ثانيةً}other{‏ستتم إعادة تشغيل Browther في غضون # ثانية}}</translation>
<translation id="6239161312595354541">طرح أسئلة حول هذا الفيديو باستخدام ميزة "البحث بالصور"</translation>
<translation id="1755464917870815989">‏يحتاج Browther إلى إذن للوصول إلى مساحة التخزين من أجل تنزيل الملفات.</translation>
<translation id="304681001513922736">‏يعمل هذا الوضع على التحقّق من عناوين URL باستخدام قائمة بمواقع إلكترونية غير آمنة مُخزّنة في Browther.</translation>
<translation id="7785903492969539081">‏جعل Browther المتصفح التلقائي</translation>
<translation id="3987833816263696343">‏هل تريد الخروج من Browther؟</translation>
<translation id="4723540739671534529">‏تستخدم علامات التبويب هذه موارد إضافية. لتحسين أداء التصفُّح، ننصح بالسماح لمتصفّح Browther بإيقاف علامات التبويب هذه.</translation>
<translation id="6540151687468239291">‏تخصيص ملفك الشخصي في Browther</translation>
<translation id="770793114032605647">‏تسمية ملفك الشخصي على Browther</translation>
<translation id="385867753870250529">‏تطلب منك إحدى الإضافات تسجيل الدخول إلى Browther</translation>
<translation id="2022337046348377650">‏قد يكون ملف <ph name="FILE_NAME"/> ضارًا، لذلك فقد حظره Browther.</translation>
<translation id="45270956603278068">‏يستخدم Browther الكاميرا.</translation>
<translation id="6327105987658262776">ما مِن تحديث متوفّر.</translation>
<translation id="673633752219771459">‏عملية أخرى على Browther قيد التقدم. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="1482759407165416070">‏الآن أصبح استخدام Browther مع حسابك في Browther وفي أجهزة الكمبيوتر المشتركة أكثر سهولة.</translation>
<translation id="5538042432112726532">‏اختصار Browther</translation>
<translation id="833085228901080512">‏حَظَر Browther عملية التنزيل هذه لأنّ الملف لا يتم تنزيله عادةً، وقد يكون خطيرًا.</translation>
<translation id="491120842288314439">‏هل تريد فعلًا إزالة Browther؟</translation>
<translation id="6375219077595103062">إضافة اختصار إلى "مدير كلمات المرور"</translation>
<translation id="6388799252195623474">أريد مساعدة بخصوص هذا المحتوى</translation>
<translation id="6715003312952407375">‏للمتابعة، يُرجى تسجيل الدخول إلى Browther باستخدام حساب <ph name="EMAIL"/>. ويضمن ذلك أنّك قد اطّلعت على سياسات مؤسستك.</translation>
<translation id="1897845318651970239">‏شعار Browther على شاشة كمبيوتر</translation>
<translation id="4702069255970029302">‏ إن Browther Origin هو متصفح ويب يشغّل صفحات الويب والتطبيقات بسرعة مذهلة. إنه سريع وثابت وسهل الاستخدام. يمكنك تصفح الويب بشكل أكثر أمانًا من خلال ميزات الحماية من البرامج الضارة والتصيّد الاحتيالي المدمجة في Browther Origin.</translation>
<translation id="5669767676913031391">‏سيعمل Browther بشكل أسرع ومن المفترض أن تعمل الميزات التي تستخدِم JavaScript على النحو المطلوب</translation>
<translation id="6436260184216827876">ميزة "البحث بالصور" ليست متوفرة. يُرجى إعادة المحاولة لاحقًا.</translation>
<translation id="2139300032719313227">‏إعادة تشغيل نظام التشغيل Browther</translation>
<translation id="6110616900529884221">‏يُحمِّل Browther مسبقًا المزيد من الصفحات التي يُحتمل أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="1217194059001819677">‏يكفي تنزيل متصفِّح Browther على هاتفك لتتبُّع الأسعار والحصول على تنبيهات عند انخفاضها على أي موقع إلكتروني</translation>
<translation id="7058555680120557198">‏غير مفعَّلة • لا يمكن لمتصفّح Browther التحقُّق من مصدر هذه الإضافة</translation>
<translation id="676533642429632127">‏مرحبًا بك في الملفات الشخصية على Browther</translation>
<translation id="5518682889576009702">‏عند فتح Browther على <ph name="DEVICE_TYPE"/> في المرة القادمة، ستظهر لك رسالة تطلب منك استخدام مجموعات علامات التبويب.</translation>
<translation id="6038105561107837619">‏إزالة الحساب من Browther</translation>
<translation id="2675662665675552980">‏كما أنها تتحكم في الصفحة التي تظهر عند تشغيل Browther.</translation>
<translation id="648319183876919572">تعزِّز ميزة "الحماية المُحسّنة للتصفّح الآمن" حمايتك من المواقع الإلكترونية الضارة وعمليات التنزيل الخطيرة.</translation>
<translation id="2930243146591999795">‏إزالة Browther</translation>
<translation id="5241183382286817629">‏يتم فتح الاختصارات في Browther</translation>
<translation id="7907014599435829661">‏تغلق مؤسستك Browther في حال عدم استخدامه لمدّة <ph name="TIMEOUT_DURATION"/>. تم حذف بيانات التصفُّح. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="2088471423667794811">‏يحتفظ كل ملف شخصي بالمعلومات الخاصة به على Browther، مثل الإشارات المرجعية والسجلّ وكلمات المرور وغير ذلك.</translation>
<translation id="9040334484455218184">‏مزيد من المعلومات حول <ph name="BEGIN_LINK"/>الطريقة التي يتّبعها Browther للحفاظ على خصوصية بياناتك<ph name="END_LINK"/></translation>
<translation id="1718697235867382480">‏سيتم تطبيق التغييرات في هذا الإعداد بعد إعادة تشغيل Browther.</translation>
<translation id="6331317152404762758">‏يمكنك التبديل للاطّلاع على كلمات المرور من ملف شخصي آخر في Browther.</translation>
<translation id="6097706403184348562">‏لإصلاح الأخطاء الإملائية، يُرسِل Browther ما تكتبه في حقول النص إلى Browther</translation>
<translation id="2319647238307402812">‏الانتقال إلى إعدادات الإشعارات في Browther</translation>
<translation id="6600016381025017075">البحث عن أي محتوى على هذه الصفحة</translation>
<translation id="8031938899816118394">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Browther.</translation>
<translation id="7412185356697187964">‏يتم الآن فتح Browther تلقائيًا عند بدء تشغيل Windows، ما يتيح لك بدء التصفّح على الفور. ويمكنك إيقاف هذا الإجراء من خلال الإعدادات.</translation>
<translation id="9123343592576384616">‏المتابعة من حيث توقفت: استعاد Browther علامات التبويب من جلستك الأخيرة. يمكنك إيقاف هذه الميزة في</translation>
<translation id="5847926498049048567">‏يحتاج Browther إلى إذن للوصول إلى الكاميرا من أجل إنشاء خريطة ثلاثية الأبعاد للمكان حولك.</translation>
<translation id="5532585028508811858">‏إذا حفظت أيضًا إشاراتك المرجعية في حسابك على Browther، يمكنك تتبُّع أسعار المنتجات من خلال Browther وتلقّي إشعارات عند انخفاض السعر.</translation>
<translation id="6676384891291319759">الدخول إلى الإنترنت</translation>
<translation id="1363996462118479832">‏تعذّر على نظام التشغيل Browther مزامنة بياناتك بسبب حدوث خطأ أثناء تسجيل الدخول.</translation>
<translation id="3373239673945775810">‏إزالة بيانات هذا التطبيق من Browther</translation>
<translation id="8122759674786039814">‏يتيح لك Browther التحكّم بشكل أكبر في الإعلانات التي تظهر لك والحدّ من مقدار معلوماتك التي يمكن للمواقع الإلكترونية معرفتها عندما تعرض لك إعلانات مخصّصة</translation>
<translation id="6277682530398500159">‏يحتاج Browther إلى إذن للوصول إلى الميكروفون من أجل هذا الموقع الإلكتروني.</translation>
<translation id="6712881677154121168">حدث خطأ في عملية التنزيل: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">‏لا يمكن استخدام ملفك الشخصي نظرًا لأنه من إصدار أحدث من Browther.

قد تكون بعض الميزات غير متاحة. يُرجى تحديد دليل ملف شخصي مختلف أو استخدام إصدار أحدث من Browther.</translation>
<translation id="871671753163165892">‏للحصول على خيارات مخصَّصة والاستفادة من ميزات أخرى، يمكنك تضمين متصفّح Browther في "النشاط على الويب وفي التطبيقات" وخدمات Browther المرتبطة</translation>
<translation id="5000832110229523807">‏يتم تثبيت Browther بالفعل لجميع المستخدمين على جهاز الكمبيوتر.</translation>
<translation id="5204575479550973859">‏يتيح لك تسجيل الدخول إلى Browther الوصول إلى الإشارات المرجعية وغيرها على جميع أجهزتك. وسيتم حفظ هذه الإشارة المرجعية في حسابك على Browther بعد تسجيل الدخول إليه.</translation>
<translation id="2874208284092283937">‏يعمل هذا الإعداد على زيادة سرعة المواقع الإلكترونية باستخدام محرّك V8 في Browther، مع تقليل قدرة Browther على مقاومة الهجمات قليلاً. هذا الإعداد مفعَّل.</translation>
<translation id="3268577459683869744">{count,plural, =1{‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصر واحد من هذه البيانات.}zero{‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}two{‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف عنصرَين ({count}) من هذه البيانات.}few{‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عناصر من هذه البيانات.}many{‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصرًا من هذه البيانات.}other{‏لم يتم حفظ بعض بيانات Browther في حسابك على Browther إلى الآن. يُرجى الانتظار بضع دقائق قبل تسجيل الخروج. إذا سجَّلت الخروج الآن، فسيتم حذف {count} عنصر من هذه البيانات.}}</translation>
<translation id="7683816018918395929">‏ينصح متصفِّح Browther بفحص هذا الملف لأنّه قد يكون خطيرًا.</translation>
<translation id="1547295885616600893">‏أصبح نظام التشغيل Browther متاحًا من خلال <ph name="BEGIN_LINK_CROS_OSS"/>برنامج إضافي مفتوح المصدر<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">ترجمة</translation>
<translation id="2142653375108595728">‏يتم إعلامك من خلال Browther في حال تم اختراق كلمات المرور في أي وقت.</translation>
<translation id="684888714667046800">يتعذّر الاتصال بالإنترنت. في حال استخدام جدار حماية، يُرجى التأكّد من إدراج <ph name="PRODUCT_EXE_NAME"/> في القائمة المسموح بها.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">‏يجب النقر على مفتاح Tab للمتابعة</translation>
<translation id="6862030660799253820">البحث عن هذه الصورة باستخدام ميزة "البحث بالصور"</translation>
<translation id="3860339351709082396">‏رصد Browther أنّ الإضافة "<ph name="EXTENSION_NAME"/>" تحتوي على برامج ضارة.</translation>
<translation id="6877155553248388166">أسفل يسار مساحة البحث: %<ph name="RIGHT"/> من الجهة اليسرى و%<ph name="BOTTOM"/> من الأسفل</translation>
<translation id="6896758677409633944">نسخ</translation>
<translation id="7804113502310231166">‏ننصحك بضبط Browther كمتصفّح تلقائي وتثبيته في شريط المهام</translation>
<translation id="3228374215117173004">‏&amp;إدارة الملفات الشخصية على Browther</translation>
<translation id="6934579572334859869">طرح أسئلة حول هذه الصورة باستخدام ميزة "البحث بالصور"</translation>
<translation id="5995328366516663808">‏لقد بلغت الحدّ الأقصى لعدد الإشارات المرجعية في Browther، وهو <ph name="BOOKMARK_LIMIT"/>، لذا لم يتم حفظ بعض إشاراتك المرجعية في حسابك على Browther حتى الآن.

ولا يمكن حفظ إشارات مرجعية جديدة في حسابك إلا بعد حذف بعض الإشارات. وفي حال سجّلت الخروج الآن، سيتم حذف الإشارات المرجعية غير المحفوظة.</translation>
<translation id="6965382102122355670">حسنًا</translation>
<translation id="4533562834763015352">‏من السهل تخمين كلمات المرور الضعيفة. يمكنك السماح لمتصفِّح Browther <ph name="BEGIN_LINK"/>بإنشاء كلمات مرور قوية وتذكُّرها نيابة عنك<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">‏بنود نظام التشغيل Browther</translation>
<translation id="5379058926689137454">‏يحتاج Browther إلى إذن للوصول إلى الميكروفون من أجل الموقع الإلكتروني هذا.</translation>
<translation id="4684462982894889021">‏يُرجى إدخال عبارة المرور لاستخدام بيانات Browther وحفظها في حسابك (<ph name="ACCOUNT_EMAIL"/>)</translation>
<translation id="7011190694940573312">تعذّر تثبيت هذا الإصدار من نظام التشغيل لأنّه غير متوافق.</translation>
<translation id="7024536598735240744">حدث خطأ في فك ضغط الحزمة: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">تم إيقاف التثبيت.</translation>
<translation id="8257174622576051374">‏اجعل Browther متصفِّحك الدائم</translation>
<translation id="7047386856539490735">هل هذه النتائج مفيدة؟</translation>
<translation id="1772745060691790742">‏تحديث Browther</translation>
<translation id="4937970118065051027">‏في حال لم تتضمن صورة ما وصفًا مفيدًا، سيحاول Browther توفير وصف لك. لإنشاء الأوصاف، سيتم إرسال الصور إلى Browther.</translation>
<translation id="1594112132009288601">‏تخصيص Browther for Testing</translation>
<translation id="5915000938288527952">‏يمكنك استخدام Browther في أي وقت عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى</translation>
<translation id="8775664994493381735">‏إزالة "<ph name="EXTENSION_NAME"/>" من Browther</translation>
<translation id="3276648807841991013">‏تحذف مؤسستك بيانات Browther في حال عدم استخدامها لمدّة <ph name="TIMEOUT_DURATION"/>. ويمكن أن يشمل ذلك بيانات السجلّ والملء التلقائي وعمليات التنزيل.</translation>
<translation id="4725226878394159809">‏يحتاج Browther إلى إذن للوصول إلى الكاميرا من أجل هذا الموقع الإلكتروني.</translation>
<translation id="8931474625901592021">‏تعذَّر إطلاق Browther. يُرجى إعادة المحاولة.</translation>
<translation id="8242947409070121799">‏يتعذّر على Browther التحقُّق من كلمات المرور. يُرجى إعادة المحاولة بعد 24 ساعة.</translation>
<translation id="1737922827960215472">‏يمكنك الاحتفاظ بمتصفِّح Browther في شريط التطبيقات (Dock) للوصول إليه بسرعة في أي وقت</translation>
<translation id="335855266303176628">‏يمكنك فتح Browther عند النقر على الروابط في الرسائل والمستندات والتطبيقات الأخرى</translation>
<translation id="709455597778444012">‏إدارة المهام - Browther</translation>
<translation id="7147140345767587643">‏قائمة اهتماماتك وفقًا لتقدير Browther</translation>
<translation id="7337408274890534789">‏بدء التصفّح على الفور: يمكن الآن فتح Browther تلقائيًا عند بدء تشغيل Windows.</translation>
<translation id="7274695763216404502">تمّ تثبيت اللوحة. يمكنك استخدام ميزة "البحث بالصور" مرة أخرى من خلال شريط الأدوات</translation>
<translation id="7288567540154601580">علامات التبويب والإضافات</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{‏ينصح متصفّح Browther بإزالتها}zero{‏ينصح متصفّح Browther بإزالتها}two{‏ينصح متصفّح Browther بإزالتهما}few{‏ينصح متصفّح Browther بإزالتها}many{‏ينصح متصفّح Browther بإزالتها}other{‏ينصح متصفّح Browther بإزالتها}}</translation>
<translation id="1527644038571473502">‏لمشاركة صوت النظام، افتح "إعدادات النظام" (System Settings) وفعِّل خيار "تسجيل صوت النظام فقط" (System Audio Recording Only) لمتصفّح Browther، ثم أعِد تشغيل المتصفّح.</translation>
<translation id="1427913074981060872">‏تسمح ميزة "قياس أداء الإعلانات" للمواقع الإلكترونية التي تزورها بطلب معلومات من Browther تساعد الموقع الإلكتروني في قياس أداء الإعلانات التي يعرضها. وتحدّ هذه الميزة من عملية تتبّع البيانات ونشاط التصفّح على المواقع الإلكترونية، وذلك من خلال نقل أقل قدر ممكن من المعلومات بينها.</translation>
<translation id="1657652725060525338">‏تحديث Browther</translation>
<translation id="884846289464870238">‏ملف الإعدادات المفضّلة تالف أو غير صالح.

يتعذر على Browther استعادة إعداداتك.</translation>
<translation id="7339898014177206373">نافذة جديدة</translation>
<translation id="633044855886370183">‏الويب والإشارات المرجعية وغيرها من عناصر Browther توجد هنا.</translation>
<translation id="1185960088713242527">‏لا يمكن لأحد الوصول إلى بياناتك المشفّرة بدون استخدام عبارة المرور. ولا تحصل Browther على عبارة المرور هذه أو تخزّنها. وفي حال نسيتها أو أردت تغيير هذه الإعدادات، يجب <ph name="BEGIN_LINK"/>حذف بيانات Browther في حسابك<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110">‏ضَبَط مشرف النظام Browther لفتح <ph name="ALTERNATIVE_BROWSER_NAME"/> للوصول إلى <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">حدث خطأ</translation>
<translation id="6638123710106659002">‏للحصول على تحديثات Browther في المستقبل، يجب استخدام كمبيوتر يعمل بنظام التشغيل macOS 13 أو إصدار أحدث. ويعمل هذا الكمبيوتر بنظام التشغيل macOS 12.</translation>
<translation id="7286289384512061761">‏لم تتم زيارة هذا الموقع الإلكتروني مؤخرًا، لذلك أزال Browther إذنَي <ph name="PERMISSION_1"/> و<ph name="PERMISSION_2"/>.</translation>
<translation id="113593073175678746">‏لم تعُد هذه الإضافة متاحة. ينصح متصفّح Browther بإزالتها.</translation>
<translation id="137615076640044304">‏المتابعة من حيث توقفت: يمكن لمتصفّح Browther استعادة علامات التبويب كلما أعدت تشغيله. لإيقاف هذه الميزة، يُرجى الانتقال إلى</translation>
<translation id="5967238175620483220">‏استيراد كلمات المرور إلى Browther</translation>
<translation id="4935019315986703336">‏<ph name="PAGE_TITLE"/> - إصدار قناة مطوري البرامج من Browther Origin</translation>
<translation id="7450541714075000668">تم نسخ النص.</translation>
<translation id="7766009218653304791">‏يحتاج Browther إلى إذن للوصول إلى الكاميرا من أجل الموقع الإلكتروني هذا.</translation>
<translation id="5844418066487488520">‏لاستخدام الميكروفون، يجب منح Browther إذن الوصول في <ph name="BEGIN_LINK"/>إعدادات النظام<ph name="END_LINK"/></translation>
<translation id="8065480549334161841">‏للحصول على تحديثات Browther في المستقبل، يجب استخدام جهاز يعمل بنظام التشغيل Windows 10 أو إصدار أحدث. يعمل هذا الكمبيوتر بنظام التشغيل Windows 7.</translation>
<translation id="6299293759264950896">‏هل تريد إعادة تشغيل Browther؟</translation>
<translation id="180908550381040105">‏لا يمكن تثبيت إصدار Browther ذاته الذي يتم تشغيله حاليًا. يُرجى إغلاق Browther وإعادة المحاولة.</translation>
<translation id="7625576878150380853">‏يمكنك حفظ كلمات المرور وغيرها من البيانات في حسابك على Browther واستخدامها في أي وقت من خلال تسجيل الدخول إلى متصفِّح Browther. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">‏من المحتمل أن تعمل المواقع الإلكترونية على النحو المتوقَّع. وسيتم تسجيل خروجك من معظم المواقع الإلكترونية عند إغلاق جميع نوافذ Browther، باستثناء حسابك على Browther إذا كنت مسجلاً الدخول إلى Browther.</translation>
<translation id="7099370564362681943">{0,plural, =1{‏ستتم إعادة تشغيل Browther في غضون دقيقة واحدة}zero{‏ستتم إعادة تشغيل Browther في غضون # دقيقة}two{‏ستتم إعادة تشغيل Browther في غضون دقيقتين}few{‏ستتم إعادة تشغيل Browther في غضون # دقائق}many{‏ستتم إعادة تشغيل Browther في غضون # دقيقةً}other{‏ستتم إعادة تشغيل Browther في غضون # دقيقة}}</translation>
<translation id="3602613943932672197">‏لحماية بياناتك، يمكنك السماح لمتصفِّح Browther بإزالة الأذونات من المواقع الإلكترونية التي لم تتم زيارتها مؤخرًا.</translation>
