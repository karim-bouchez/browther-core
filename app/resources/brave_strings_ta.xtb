<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">
<translation id="1026101648481255140">நிறுவலை மீண்டும் தொடங்கு</translation>
<translation id="7099479769133613710">&amp;ChromeOSஸைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="7264054672589027446">இந்த நீட்டிப்பைச் சரிபார்க்குமாறு Browther பரிந்துரைக்கிறது</translation>
<translation id="7848219163187166649">ஒரு தளம் அதன் பக்கத்தில் இருக்கும் இணைப்புகளைத் தனிப்பட்ட முறையில் முன்கூட்டியே ஏற்றுமாறு கேட்கும்போது Browther சேவையகங்களை Browther பயன்படுத்துகிறது. இதனால் முன்கூட்டியே ஏற்றப்பட்ட தளத்துடன் உங்கள் அடையாளம் பகிரப்படாது. ஆனால் எந்தத் தளம் முன்கூட்டியே ஏற்றப்பட வேண்டும் என்பதை Browther அறிந்துகொள்ளும்.</translation>
<translation id="1065672644894730302">உங்கள் விருப்பதேர்வுகள் படிக்கும்படி இல்லை. சில அம்சங்கள் கிடைக்காமல் இருக்கலாம் மேலும் விருப்பதேர்வுகளின் மாற்றங்களைச் சேமிக்க முடியாது.</translation>
<translation id="8837164267124113709">Braveமில் "தளங்கள், ஆப்ஸ், நீட்டிப்புகள் ஆகியவற்றுக்கான அனுமதிகள்" என்பதை உங்கள் பெற்றோர் முடக்கிவிட்டார்</translation>
<translation id="881513728707488138">Browther உங்கள் கடவுச்சொற்களை ஏற்ற விரும்புகிறது. இதை அனுமதிக்க, உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="112640046208448578">பொருட்களையும் இடங்களையும் கண்டறியலாம், வார்த்தைகளை நகலெடுக்கலாம் மொழிபெயர்க்கலாம். படத் தேடலைப் பயன்படுத்தும்போது அந்தப் பக்கத்தின் ஸ்கிரீன்ஷாட் சேவையகத்துக்கு அனுப்பப்படும். <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">உங்கள் இயல்புநிலை உலாவி Browther ஆகும்</translation>
<translation id="6580138787163923852">தரவு மீறல்கள் மற்றும் பிற பாதுகாப்புச் சிக்கல்களிலிருந்து உங்கள் கடவுச்சொற்கள் பாதுகாப்பாக இருக்கின்றனவா என்பதைச் சரிபார்க்க <ph name="BEGIN_LINK"/>Braveமில் உள்நுழையுங்கள்<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther மெனுவைக் கிளிக் செய்யவும்</translation>
<translation id="1157985233335035034">சமீபத்திய மொழிகள்</translation>
<translation id="3673786631598474384">Browther வேலை செய்யும் விதத்தை மாற்றக்கூடிய நீட்டிப்பை <ph name="PARTNER_NAME"/> சேர்த்துள்ளார்.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">ஆதரிக்கப்படாத Windows பதிப்பை நீங்கள் பயன்படுத்துவதால் நிறுவ முடியவில்லை.</translation>
<translation id="8291401179516272335">Browther அறிமுகம்</translation>
<translation id="1203500561924088507">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME"/> ஐப் பயன்படுத்துவதற்கு முன் உலாவியை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="1232234696885483911">படத் தேடலைத் திறக்கும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை தானாகவே சேவையகத்திற்கு அனுப்பப்படும். <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">உள்நுழைந்திருக்கும்போது உங்கள் Browther கணக்கில் உள்ள கடவுச்சொற்களையும், மேலும் பலவற்றையும் நீங்கள் Braveமில் பயன்படுத்தலாம். இதை மாற்ற, “Braveமில் உங்கள் கணக்கு” என்பதற்குச் செல்லவும்.</translation>
<translation id="9034321258761608912">Browther தொடர்ந்து வேகமாக இயங்குவதற்கு, இந்தப் பக்கம் செயலில் இல்லாதபோது நினைவகம் காலியாக்கப்பட்டது. இந்தத் தளத்தை எப்போதும் செயலற்ற நிலையில் இருந்து விலக்க நீங்கள் தேர்வுசெய்யலாம்.</translation>
<translation id="249571811018731941">இந்த ஃபைல் ஆபத்தானது என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> கணக்கின் மூலம் Gmail, YouTube போன்ற Browther சேவைகளில் உள்நுழையும்போது Braveமிலும் அதே கணக்கின் மூலம் தானாக நீங்கள் உள்நுழையலாம்.</translation>
<translation id="1290883685122687410">அமைவுப் பிழை: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">உங்கள் புதிய Browther சுயவிவரத்தை அமைத்திடுங்கள்</translation>
<translation id="4437862975743821367">புளூடூத் சாதனங்களைக் கண்டறிய 
 Braveமிற்கு புளூடூத் அணுகல் தேவை. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">மொழியைக் கண்டறி</translation>
<translation id="1206925267243987362">Browther பரிந்துரைக்கும் பிரவுசர் அமைப்புகளைப் பயன்படுத்துதல்</translation>
<translation id="8270483548049772782">Browther தரவையும் நீக்கு (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">பின் செய்யப்பட்டது! கருவிப்பட்டியில் உள்ள புதிய பட்டன் மூலம் படத் தேடலை மீண்டும் அணுகலாம்</translation>
<translation id="1356661055722410047">புதிது! திரையில் உள்ள வார்த்தைகளையும் படங்களையும் மொழிபெயர்க்கலாம்</translation>
<translation id="1383876407941801731">தேடுக</translation>
<translation id="1592588950737518481">&amp;Browther சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="1404026649028693342">AI மோடை எப்போதும் காட்டு</translation>
<translation id="141901961143729572">உங்கள் கருத்துகளைப் பகிருங்கள்</translation>
<translation id="1743952081001089298">சாளரத்தைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்.</translation>
<translation id="8627385813382688019">Browther for Testing தொடர்பான உதவியைப் பெறுங்கள்</translation>
<translation id="1497802159252041924">நிறுவல் பிழை: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">இந்தப் பக்கம் பாதுகாக்கப்படுகிறது</translation>
<translation id="7252430412915798987">Browther தாவலைப் பகிர்தல்</translation>
<translation id="6388429281015199562">Braveமில் உள்நுழை</translation>
<translation id="1547469039832541117">தனிப்படுத்திய பணியை முடிக்கும்.</translation>
<translation id="1801944307203212016">உங்களைச் சுற்றியுள்ள இடங்களின் 3D வரைபடத்தை உருவாக்க, Braveமுக்கு உங்கள் கேமராவை அணுக அனுமதி தேவை</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{இந்த நீட்டிப்பை இனி பயன்படுத்த முடியாது. இதை அகற்றும்படி Browther பரிந்துரைக்கிறது.}other{இந்த நீட்டிப்புகளை இனி பயன்படுத்த முடியாது. இவற்றை அகற்றும்படி Browther பரிந்துரைக்கிறது.}}</translation>
<translation id="4667068923142532753">Braveமைப் பின் செய்</translation>
<translation id="3006560544901646947">Braveமின் பாதுகாப்புக் கருவிகள்</translation>
<translation id="686052171138185761">உங்கள் Password Managerரில் உள்ள தரவை Browther நீக்க விரும்புகிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை டைப் செய்யவும்.</translation>
<translation id="8713026329083542796">Braveமில் உள்ள முக்கியமான தனியுரிமை மற்றும் பாதுகாப்புக் கட்டுப்பாடுகளைச் சரிபாருங்கள்</translation>
<translation id="1640672724030957280">பதிவிறக்குகிறது...</translation>
<translation id="1680687534629375545">இந்தப் பக்கம் பற்றி படத் தேடல் அம்சத்திடம் கேளுங்கள்</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> பிரவுசருக்குக் கூடுதல் அணுகலை வழங்கும்.</translation>
<translation id="4243382967656566037">இந்த அம்சங்களை மேம்படுத்த உதவ, அவற்றுடனான உங்கள் உரையாடல்களை Braveளுக்கு Browther அனுப்பும். இந்தத் தரவை மதிப்பாய்வாளர்கள் படிக்கலாம், செயலாக்கலாம், அவற்றைப் பற்றி சிறு குறிப்புகளை எழுதலாம்.</translation>
<translation id="1722488837206509557">கிடைக்கக்கூடிய சாதனங்களில் இருந்து தேர்ந்தெடுக்கவும், அவற்றில் உள்ளடக்கத்தைக் காட்டவும் இது அனுமதிக்கும்.</translation>
<translation id="6820510278633522408">உலாவிய தரவை Browther விரைவில் நீக்கும்</translation>
<translation id="7775028004939172516">வழிசெலுத்தல்களை HTTPSக்கு மேம்படுத்த Browther முயலும்</translation>
<translation id="6963959729951758069">Browther தரவு அழிக்கப்பட்டது</translation>
<translation id="4085139922884095932"><ph name="REMAINING_TIME"/> இல் Browther மீண்டும் தொடங்கும்</translation>
<translation id="2586248102295515296">HTTPS கிடைக்காதபோது, Browther உங்களை எச்சரிக்காமலேயே பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தும்</translation>
<translation id="3975328336074677101">பின்புலத்தில் Browther ஐ இயக்கு</translation>
<translation id="2497443204974841650">Browther ஐ மீண்டும்நிறுவு</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> முயல்கிறது</translation>
<translation id="4553225588627299783">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் Braveமைத் திறக்கும்போது, Browther Password Managerரைப் பயன்படுத்தும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="1838374766361614909">தேடலை அழி</translation>
<translation id="2337233040802538155">உலாவிய தரவை உங்கள் Browther கணக்கில் இருந்து நீக்காமல் இந்தச் சாதனத்தில் இருந்து மட்டும் நீக்க, <ph name="BEGIN_LINK"/>Braveமில் இருந்து வெளியேறுங்கள்<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">எங்கிருந்தும் புதிய பக்கக் குழுக்களைத் திறக்கவோ உருவாக்கவோ உங்கள் மொபைலில் Braveமைப் பதிவிறக்குங்கள்.</translation>
<translation id="2063443520349987970">நீங்கள் உள்நுழைந்துள்ள Browther கணக்குகளை நிர்வகிக்கலாம். Browther உலாவி, Play Store, Gmail மற்றும் பலவற்றில் உங்கள் Browther கணக்குகள் பயன்படுத்தப்படும். வேறு ஒருவரின் (எ.கா. குடும்ப உறுப்பினர்) கணக்கைச் சேர்க்க விரும்பினால் உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் ஒரு புதிய பயனரைச் சேர்க்கவும். <ph name="LINK_BEGIN"/>மேலும் அறிக<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">படத் தேடல் மூலம் தேடு</translation>
<translation id="1880677175115548835">உரையைத் தேர்வுசெய்க</translation>
<translation id="3183933389992069620">நீங்கள் நிர்வகிக்கப்படும் கணக்கு மூலம் உள்நுழைகிறீர்கள், மேலும் அதன் நிர்வாகிக்கு உங்கள் Browther சுயவிவரத்தின் கட்டுப்பாட்டை வழங்குகிறீர்கள். உங்கள் ஆப்ஸ், புக்மார்க்குகள், வரலாறு, கடவுச்சொற்கள் போன்ற உங்கள் Browther தரவு மற்றும் பிற அமைப்புகள் நிரந்தரமாக <ph name="USER_NAME"/> உடன் இணைக்கப்படும். இந்தத் தரவை Browther கணக்குகளின் டாஷ்போர்டு வழியாக நீக்க முடியும், ஆனால் இந்தத் தரவை வேறொரு கணக்குடன் தொடர்புபடுத்த முடியாது. விரும்பினால், உங்களுடைய நடப்பு Browther தரவைத் தனிப்பட்ட முறையில் வைத்திருக்க நீங்கள் புதிய சுயவிவரத்தை உருவாக்கலாம். <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">பின்னணிச் செயல்பாடுகளையும் ஸ்மூத் ஸ்க்ரோலிங், வீடியோ ஃப்ரேம் வீதங்கள் போன்ற விஷுவல் எஃபெக்ட்டுகளையும் கட்டுப்படுத்தி Browther பேட்டரி பவரைச் சேமிக்கிறது. <ph name="BEGIN_LINK"/>எனர்ஜி சேமிப்பு குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">இந்தப் பக்கத்தைப் பற்றிக் கேளுங்கள்</translation>
<translation id="9128006428501241840">Browther Updater Service</translation>
<translation id="6302815314157879372">இதை முடக்கினால், நீங்கள் Braveமில் உள்நுழையாமலேயே Gmail போன்ற Browther தளங்களில் உள்நுழையலாம்</translation>
<translation id="1063611196035804685">Browther பதிலளிக்கவில்லை. இப்போது மீண்டும் தொடங்கவா?</translation>
<translation id="2873360330889594383">Braveமில் உள்நுழையும்படி உங்கள் நிறுவனம் (<ph name="MANAGER"/>) வலியுறுத்துகிறது</translation>
<translation id="4035053306113201399">புதுப்பிப்பைப் பயன்படுத்த, ChromeOSஸை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="2861285003831382718">இந்த ஃபைல் வகை பொதுவாகப் பதிவிறக்கப்படுவதில்லை என்பதுடன் ஆபத்தானதாகவும் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="1953553007165777902">பதிவிறக்குகிறது... <ph name="MINUTE"/> நிமிடங்கள் மீதமுள்ளன</translation>
<translation id="2080160985220483492">Browther உதவிக்குறிப்பு: கடவுச்சொற்களைச் சேமியுங்கள்</translation>
<translation id="8037497710694492565">இயல்புநிலை உலாவியைக் கண்டறியவோ அமைக்கவோ Browther ஆல் முடியவில்லை</translation>
<translation id="7395009124247513849">சில ஃபைல்களைத் தடுத்து, புதிய பக்கத்தில் Browther ஏன் திறக்கிறது என்று தெரிந்துகொள்ளுங்கள்.</translation>
<translation id="762710512520170632">Browther மென்பொருளைச் சமீபத்தியதாக வைத்திருக்கும். இந்தச் சேவை முடக்கப்பட்டாலோ நிறுத்தப்பட்டாலோ, உங்கள் Browther மென்பொருள் சமீபத்தியதாக வைத்திருக்கப்படாது. அதாவது, பாதுகாப்புக் குறைபாடுகள் ஏற்படக்கூடும். அவற்றைச் சரிசெய்ய முடியாது என்பதுடன் அம்சங்களும் செயல்படாமல் போகலாம். இந்தச் சேவையை Browther மென்பொருள் எதுவும் பயன்படுத்தவில்லை என்றால், சேவை தானாகவே நிறுவல் நீக்கப்படும்.</translation>
<translation id="5793588180426267429">வெளியேறினால், இந்தச் சாதனத்திலிருந்து ஓர் உருப்படி நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Browther இல் <ph name="USER_EMAIL"/> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="2018879682492276940">நிறுவ முடியவில்லை. மீண்டும் முயலவும்.</translation>
<translation id="6351516710581760512">தரவு மீறல்கள் மற்றும் பிற பாதுகாப்புச் சிக்கல்களிலிருந்து உங்கள் மற்ற கடவுச்சொற்கள் பாதுகாப்பாக இருக்கின்றனவா என்பதைச் சரிபார்க்க <ph name="BEGIN_LINK"/>Braveமில் உள்நுழையுங்கள்<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">அமைப்புகள்.</translation>
<translation id="8194525816714210105">Browther சேவைகளில் மேலும் பிரத்தியேகமான அனுபவங்களைப் பெறுவதற்கு Browther செயல்பாடுகளைச் சேர்க்க வேண்டுமா என்பதைத் தேர்வுசெய்யலாம்</translation>
<translation id="5909559127548969159">Braveமிற்குப் புதிய தோற்றத்தைக் கொடுக்க, புதிய பக்கத்தில் உள்ள Braveமைப் பிரத்தியேகமாக்குவதற்கான பட்டனைக் கிளிக் செய்யுங்கள்</translation>
<translation id="2066690553719545730">AI மோடை எப்போதும் காட்டு</translation>
<translation id="3283892260110318935">இந்த ஃபைல் ஏமாற்றக்கூடியது என்பதுடன் உங்கள் சாதனத்தில் எதிர்பாராத மாற்றங்களையும் செய்யலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="6160571936643742128">அடுத்த முறை Browther iOSஸைத் திறக்கும்போது <ph name="FEATURE_NAME"/> அம்சத்தைப் பயன்படுத்திப் பார்க்கும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="8380517409933452343">உங்கள் Browther கணக்கில் நீங்கள் சேமித்த உங்கள் கடவுச்சொற்களும் பிற Browther தரவும் இந்தச் சாதனத்தில் இருந்து அகற்றப்படும். அவற்றைத் திரும்பவும் Braveமில் பயன்படுத்த, மீண்டும் உள்நுழையவும்.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Browther 1 நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உலாவிய தரவை உங்கள் நிறுவனம் தானாகவே நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம். உலாவிப் பக்கங்கள் திறந்தே இருக்கும்.}other{Browther # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உலாவிய தரவை உங்கள் நிறுவனம் தானாகவே நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம். உலாவிப் பக்கங்கள் திறந்தே இருக்கும்.}}</translation>
<translation id="2126108037660393668">பதிவிறக்கப்பட்ட ஃபைலைச் சரிபார்க்க முடியவில்லை.</translation>
<translation id="2135919691573380097">இந்தத் தளத்தைப் புகாரளிக்கவும்</translation>
<translation id="2137162749895930932">மொழிபெயர்ப்புத் திரையை மூடும்</translation>
<translation id="4283559398694996391">இந்தத் தளம் பாதுகாப்பான இணைப்பைப் பயன்படுத்தவில்லை என்பதுடன் ஃபைலும் சிதைந்து இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="2170098639895543546">இந்தப் பக்கத்தில் எதையும் தேர்ந்தெடுங்கள்</translation>
<translation id="2495182092286337191">Braveமைப் பிரத்தியேகப்படுத்து</translation>
<translation id="2174917724755363426">நிறுவல் நிறைவடையவில்லை. நிச்சயமாக ரத்துசெய்ய வேண்டுமா?</translation>
<translation id="4877141231724140862">Browther - நெட்வொர்க் உள்நுழைவு - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">புதுப்பிப்புச் சரிபார்ப்புப் பிழை: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Braveமில் இருந்து கணக்கை அகற்று</translation>
<translation id="1084363153644366288">iOSஸிற்கான Braveமில் மேம்பட்ட பாதுகாப்பான பிரவுசிங் மூலம் எங்கும் பாதுகாப்பாக இருக்கலாம்</translation>
<translation id="7949164640723239455">ஆபத்தான தளம். அறிவிப்புகள் அனுமதியை Browther அகற்றிவிட்டது.</translation>
<translation id="2236949375853147973">எனது செயல்பாடுகள்</translation>
<translation id="4536403809133456417">முகவரிகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் Browther கணக்கில் இந்த முகவரி சேமிக்கப்படும்.</translation>
<translation id="5627930103267312171">நீங்கள் கம்ப்யூட்டரைப் பகிர்ந்தால், நண்பர்களும் குடும்பத்தினரும் தனிப்பட்ட முறையில் உலாவலாம், மேலும் Braveமை அவர்கள் விருப்பத்திற்கு ஏற்ப அமைத்துக்கொள்ளலாம்.</translation>
<translation id="2283803047247799269">படத் தேடல் மூலம் இந்தப் பக்கத்தைத் தேடுங்கள்</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கத்தை இடைநிறுத்தும்படி Browther பரிந்துரைக்கிறது}other{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கங்களை இடைநிறுத்தும்படி Browther பரிந்துரைக்கிறது}}</translation>
<translation id="2307973900865360088">Dockகில் வைத்திரு</translation>
<translation id="5161617112768367959">Braveமில் சேமிக்கப்பட்டுள்ள பாதுகாப்பில்லாத தளங்களின் பட்டியலைப் பயன்படுத்தி URLகளைச் சரிபார்க்கும். ஏதாவதொரு தளம் உங்கள் கடவுச்சொல்லைத் திருட முயன்றாலோ தீங்குவிளைவிக்கும் ஃபைலை நீங்கள் பதிவிறக்கினாலோ Browther, பாதுகாப்பு உலாவல் விழிப்பூட்டல்களில் பக்க உள்ளடக்கத்தின் சிறிய பகுதிகள் உட்பட URLகளையும் அனுப்பக்கூடும்.</translation>
<translation id="4123094831918713833">இதனால்:
          <ph name="LINE_BREAKS"/>
           • சில Browther அமைப்புகளும் Browther ஷார்ட்கட்களும் மீட்டமைக்கப்படும்
           <ph name="LINE_BREAK"/>
           • நீட்டிப்புகள் ஆஃப் செய்யப்படும்
           <ph name="LINE_BREAK"/>
           • குக்கீகளும் பிற தற்காலிகத் தளத் தரவும் நீக்கப்படும்
            <ph name="LINE_BREAKS"/>
           புக்மார்க்குகள், பதிவுகள், சேமிக்கப்பட்ட கடவுச்சொற்கள் ஆகியவை பாதிக்கப்படாது.</translation>
<translation id="5456070119344236353">இதிலிருந்து உங்கள் Android மொபைலுக்கு ஓர் எண்ணை அனுப்ப, இரு சாதனங்களிலும் Braveமில் உள்நுழையுங்கள்.</translation>
<translation id="2356070529366658676">கேள்</translation>
<translation id="2359808026110333948">தொடர்க</translation>
<translation id="6468415397021485143">"<ph name="EXTENSION_NAME"/>" நீட்டிப்பைப் பயன்படுத்த Braveமில் நீங்கள் உள்நுழைய வேண்டும்</translation>
<translation id="2558600429878197587">ஆப்ஸிற்காக Browther பின்புலத்தில் இயங்குவதை முடக்கு</translation>
<translation id="5295781918312989856"><ph name="USER_EMAIL_ADDRESS"/> என்ற கணக்கில் இந்த நீட்டிப்பைப் பயன்படுத்த Braveமில் உள்நுழையுங்கள்.</translation>
<translation id="8418845734693287262">உங்கள் கணக்கின் உள்நுழைவு விவரங்கள் காலாவதியாகிவிட்டதால் உங்கள் தரவை ChromeOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 HID சாதனம் ஒன்று அல்லது அதற்கு மேற்பட்ட Browther நீட்டிப்புகளால் அணுகப்பட்டது}=1{1 HID சாதனத்தை ஒன்று அல்லது அதற்கு மேற்பட்ட Browther நீட்டிப்புகள் அணுகுகின்றன}other{# HID சாதனங்களை ஒன்று அல்லது அதற்கு மேற்பட்ட Browther நீட்டிப்புகள் அணுகுகின்றன}}</translation>
<translation id="434258293817844111">இந்தத் தளத்தை அணுக, Braveமிற்கு கேமரா மற்றும் மைக்ரோஃபோன் அணுகல் தேவை</translation>
<translation id="2403703063067034158">துவக்கப் பிழை: அமைவுச் செயல்முறை ஏற்கெனவே நடைபெறுகிறது, பிறகு முயலவும்.</translation>
<translation id="5458993228789433099">எந்த ஆப்ஸில் இருந்தும் Braveமில் இணைப்புகளைத் திறக்கலாம், உங்கள் செயல் பட்டியில் பிரவுசரை அணுகும் வகையில் வைத்திருக்கலாம்</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Braveமின் கருவிகள்<ph name="END_LINK"/> மூலம் பாதுகாப்பாக உலாவலாம், உங்கள் வசமே கட்டுப்பாட்டை வைத்திருக்கலாம்</translation>
<translation id="2451727308784734061">ஷார்ட்கட்டைப் பயன்படுத்தி Password Managerரை விரைவாகத் திறக்கலாம். கம்ப்யூட்டரின் முகப்புத் திரைக்கோ ஆப்ஸ் துவக்கிக்கோ ஷார்ட்கட்டை நகர்த்தலாம்.</translation>
<translation id="2280315911954332435">Browther விரைவில் மூடப்படும்</translation>
<translation id="6410820860979094113">Browther இல்</translation>
<translation id="2485422356828889247">நிறுவல் நீக்கு</translation>
<translation id="2513154137948333830">மறுதொடக்கம் செய்ய வேண்டும்: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">படத் தேடல் மூலம் வார்த்தையைத் தேர்ந்தெடுக்கலாம்</translation>
<translation id="7892218991241200190">ஏற்கெனவே இருக்கும் கடவுச்சொற்களை Browther மாற்ற விரும்புகிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை டைப்செய்யவும்.</translation>
<translation id="8976443723926188033">ஃபைல்களைப் பதிவிறக்க, Braveக்குச் சேமிப்பிட அணுகல் தேவை</translation>
<translation id="1973587471928846950">Browther உதவி</translation>
<translation id="2575822587468774919">படத் தேடல் மூலம் தேட வேண்டியதைத் தேர்ந்தெடுங்கள்</translation>
<translation id="8705561858232289221">கடவுச்சொற்கள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் அனைத்திலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="437162022240011372">தொடர்ந்து Browther பயன்படுத்துக</translation>
<translation id="259935314519650377">பதிவிறக்கப்பட்ட நிறுவியைத் தற்காலிக நினைவகத்தில் சேமிக்க முடியவில்லை. பிழை: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">அமைப்பு</translation>
<translation id="2907676829052962091">உங்கள் புக்மார்க்குகள், பதிவுகள், கடவுச்சொற்கள் போன்ற பிரவுசிங் தரவை உங்கள் நிறுவனத்தால் பார்க்கவும் நிர்வகிக்கவும் முடியும். பிற Browther கணக்குகளில் உள்ள பிரவுசிங் தரவை நிறுவனத்தால் பார்க்க முடியாது.</translation>
<translation id="1289116577679005654">உங்கள் கணக்கில் (<ph name="ACCOUNT_EMAIL"/>) உள்ள Browther தரவைப் பயன்படுத்தவும் சேமிக்கவும் இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்</translation>
<translation id="7192278346779151664">நிறுவலின்போது இயக்க முறைமை பிழை ஏற்பட்டது. Braveமை மீண்டும் பதிவிறக்கம் செய்க.</translation>
<translation id="7724398260867885339">நீங்கள் சாதனத்தைப் பகிர்ந்தால், நண்பர்களும் குடும்பத்தினரும் தனிப்பட்ட முறையில் உலாவலாம், மேலும் Braveமை அவர்கள் விருப்பத்திற்கேற்ப அமைத்துக்கொள்ளலாம்</translation>
<translation id="1679595317134614424">Browther தாவல்</translation>
<translation id="7189168846924379421">கூடுதல் பாதுகாப்பிற்கு, Browther உங்கள் தரவை என்க்ரிப்ட் செய்யும்.</translation>
<translation id="4052643592793184278">உங்கள் Browther கணக்கை Braveமில் இருந்து அகற்ற, வெளியேறவும்</translation>
<translation id="7694616023994438906">கடவுச்சொற்கள், புக்மார்க்குகள் மற்றும் பலவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="2738871930057338499">இணையத்துடன் இணைக்க முடியவில்லை. HTTP 403 தடுக்கப்பட்டது. உங்கள் ப்ராக்ஸி உள்ளமைவைச் சரிபார்க்கவும்.</translation>
<translation id="2753623023919742414">தேட கிளிக் செய்யவும்</translation>
<translation id="9078193405195503710">Braveமை இயல்பு PDF வியூவராக அமையுங்கள்</translation>
<translation id="2456995288904753506">வழக்கமான தன்னிரப்பி நிரப்பத் தவறக்கூடிய கடினமான புலங்களை Browther தானாக நிரப்பலாம்</translation>
<translation id="3271730304285122987">இந்த நீட்டிப்பில் மால்வேர் உள்ளது, மேலும் இது பாதுகாப்பற்றது. நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="2799223571221894425">மீண்டும் தொடங்கு</translation>
<translation id="1427337251963884503">உங்கள் Browther</translation>
<translation id="2816462166102338036">படத் தேடல் அம்சம் மூலம் இந்த வீடியோவைத் தேடுங்கள்</translation>
<translation id="2841525013647267359">இதிலிருந்து மொழிபெயர்</translation>
<translation id="2846251086934905009">நிறுவல் பிழை: நிறுவியின் செயல்பாடு நிறைவடையவில்லை. நிறுவல் ரத்துசெய்யப்பட்டது.</translation>
<translation id="928966105228355994">Browther இலிருந்து அகற்று...</translation>
<translation id="587805782197019018">Braveமைப் பயன்படுத்தும்போது பாதுகாப்பளிப்பதோடு நீங்கள் பிற Browther ஆப்ஸில் உள்நுழைந்திருக்கும்போதும் பாதுகாப்பை அதிகரிக்கும்</translation>
<translation id="2885378588091291677">செயல் நிர்வாகி</translation>
<translation id="3055995278166070443">&amp;Browther அறிமுகம்</translation>
<translation id="2915996080311180594">பின்னர் மீண்டும் தொடங்கு</translation>
<translation id="2928420929544864228">நிறுவப்பட்டது.</translation>
<translation id="70453521937551896">உங்கள் தரவு உங்கள் கடவுச்சொற்றொடர் மூலம் என்க்ரிப்ட் செய்யப்பட்டுள்ளது. உங்கள் Browther கணக்கில் உள்ள Browther தரவைப் பயன்படுத்தவும் சேமிக்கவும் அதை டைப் செய்யவும்.</translation>
<translation id="2945997411976714835">நிறுவல் பிழை: நிறுவியின் செயல்பாடு தொடங்கவில்லை.</translation>
<translation id="3188308520233701133">iOSஸிற்கான Braveமில் சேமித்துள்ள கடவுச்சொற்களைப் பயன்படுத்தி தளங்களில் விரைவாக உள்நுழையலாம்</translation>
<translation id="8145318807880784886">புக்மார்க்குகள், கடவுச்சொற்கள், அமைப்புகள் ஆகியவற்றைத் தனித்தனியாக வைத்திருக்க புதிய Browther சுயவிவரத்தைச் சேர்க்கலாம்.</translation>
<translation id="4330268530227888227">Braveமை உங்கள் நிறுவனம் நிர்வகிக்கிறது</translation>
<translation id="6488090896442998436">Browther புதுப்பித்த நிலையில் உள்ளது</translation>
<translation id="300557164611864786">எந்தத் தளமாவது உங்கள் கடவுச்சொல்லைத் திருட முயன்றாலோ தீங்கிழைக்கும் ஃபைலை நீங்கள் பதிவிறக்கினாலோ பக்க உள்ளடக்கத்தின் சிறிய பகுதிகள் உட்பட URLகளையும் பாதுகாப்பு உலாவலுக்கு Browther அனுப்பக்கூடும்</translation>
<translation id="2447145782593796785">உங்கள் பெற்றோர் தேர்வுசெய்துள்ள அமைப்புகளுடன் ஆன்லைனில் பாதுகாப்பாக இருக்க, Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3003694935412297923">எல்லாப் பணிகளும்</translation>
<translation id="7554113777150891030">{count,plural, =1{இது நீங்கள்தான் என்பதை Browther உறுதிசெய்ய வேண்டும். அதன் பிறகே, சில தரவுகளை உங்கள் Browther கணக்கில் சேமித்து அவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பயன்படுத்த முடியும். நீங்கள் இப்போதே வெளியேறினால் இந்தத் தரவு (1 தரவு) நீக்கப்படும்.}other{இது நீங்கள்தான் என்பதை Browther உறுதிசெய்ய வேண்டும். அதன் பிறகே, சில தரவுகளை உங்கள் Browther கணக்கில் சேமித்து அவற்றை உங்களின் எல்லாச் சாதனங்களிலும் பயன்படுத்த முடியும். இப்போதே வெளியேறினால் இந்தத் தரவு ({count} தரவுகள்) நீக்கப்படும்.}}</translation>
<translation id="5522228731050510047">Braveமில் புதிய பக்கத்தில் <ph name="URL"/> ஐத் திறக்கும்.</translation>
<translation id="6358780591055960280">Braveமால் உங்கள் கடவுச்சொற்களைச் சரிபார்க்க முடியவில்லை. பிறகு முயலவும்.</translation>
<translation id="1386422761453740126">Browther இல் சேர்க்கிறது...</translation>
<translation id="3038232873781883849">நிறுவக் காத்திருக்கிறது...</translation>
<translation id="3045032126857188731">மொழிபெயர்க்கப்படும் மொழி: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">கருத்திற்கான பெட்டியை மூடும்</translation>
<translation id="369127628511662602">பிற Browther சுயவிவரங்கள்</translation>
<translation id="2370255879896574713">சிதைவு அறிக்கைகளையும் <ph name="UMA_LINK"/> உம் Browther க்கு அனுப்புவதன் மூலம் Browther ஐ மேலும் சிறப்பானதாக்க உதவவும்</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 USB சாதனம் ஒன்று அல்லது அதற்கு மேற்பட்ட Browther நீட்டிப்புகளால் அணுகப்பட்டது}=1{1 USB சாதனத்தை ஒன்று அல்லது அதற்கு மேற்பட்ட Browther நீட்டிப்புகள் அணுகுகின்றன}other{# USB சாதனங்களை ஒன்று அல்லது அதற்கு மேற்பட்ட Browther நீட்டிப்புகள் அணுகுகின்றன}}</translation>
<translation id="2065456480740480340">Browther பதிவுகள்</translation>
<translation id="5011660649081947055">காப்பகத்தைச் சுருக்குவதில் நிறுவி தோல்வியடைந்தது. Braveமை மீண்டும் பதிவிறக்குக.</translation>
<translation id="310459126943037700">பணிகளை நிறுத்த முடியவில்லை.</translation>
<translation id="3104828284009500087">இந்தப் பக்கத்தில் எதையும் தேடுங்கள்</translation>
<translation id="4917564010081457061">கடவுச்சொற்கள், புக்மார்க்குகள், பதிவுகள் ஆகியவற்றை எல்லாச் சாதனங்களிலும் சரியாக ஒத்திசைத்த நிலையில் வைத்திருக்கலாம். Braveமை இயல்பு பிரவுசராக மாற்றுவதன் மூலம் உங்களுக்குத் தெரிந்த மற்றும் பிடித்த அம்சங்களை எளிதாக அணுகலாம்.</translation>
<translation id="1041472930719344928">Browther உங்கள் மைக்ரோஃபோனைப் பயன்படுத்துகிறது.</translation>
<translation id="3130333203120345554">புதிய தேடல்</translation>
<translation id="3137969841538672700">தேட இழுக்கவும்</translation>
<translation id="5312717254055363883">இந்தப் பக்கம் கூடுதல் வளங்களைப் பயன்படுத்துகிறது. செயல்திறனை மேம்படுத்த, அதை முடக்குவதற்கு Braveமை அனுமதியுங்கள்.</translation>
<translation id="373523409348786203">ஸ்கிரீனைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்</translation>
<translation id="802113445299754598">Browther ஐ மீண்டும் தொடங்கு</translation>
<translation id="3161522574479303604">எல்லா மொழிகளும்</translation>
<translation id="4522189060330781648">உங்கள் கம்ப்யூட்டரில் உள்ள மற்றொரு நிரல் Browther இயங்கும் முறையை மாற்றும் தீமினைச் சேர்த்துள்ளது.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">புதிய Browther சுயவிவரத்தைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="5150830326120505481">உங்கள் Browther கணக்கை Braveமில் இருந்து அகற்ற, அமைப்புகள் பக்கத்தில் Braveமில் இருந்து வெளியேறவும்</translation>
<translation id="7113660200899017820">சேமித்துள்ள தகவல்களை வைத்து படிவங்களைத் தானாகவே நிரப்ப விரும்புகிறீர்களா என்று Browther பின்னர் கேட்கலாம்</translation>
<translation id="4475011322243623412">தன்னுடைய தரவுக் கோப்பகத்தில் Browther படிக்கவும் எழுதவும் செய்யாது:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">இப்போது மறுதொடக்கம் செய்க</translation>
<translation id="3536063527222598206">Browther API விசைகள் காணப்படவில்லை. Browther இன் சில செயல்பாடுகள் முடக்கப்படும்.</translation>
<translation id="1011450868746766298">Browther ஐ மூடியபிறகு, பின்புலப் பயன்பாடுகளைத் தொடர்ந்து இயக்கு</translation>
<translation id="179611081153855734">பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தி ஒரு தளத்தை ஏற்றும் முன்னர் Browther உங்களை எச்சரிக்கும்</translation>
<translation id="8965591964936552871">ஆனால், Browther சாளரங்கள் அனைத்தையும் மூடும்போது Braveமில் உள்நுழைந்திருக்கும் உங்களின் Browther கணக்கைத் தவிர பெரும்பாலான தளங்களில் இருந்து வெளியேற்றப்படுவீர்கள். தளங்கள் உங்களை நினைவில் வைத்துக்கொள்ள அனுமதிக்க, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">உங்கள் இயல்புத் தேடல் இன்ஜின், Browther அல்லாத பிற பிரவுசர் என்பதில் இருந்து மாற்றப்பட்டுள்ளது. உங்களைப் பாதுகாக்க, Browther இதை மீட்டமைத்துள்ளது.</translation>
<translation id="1170501833661894915">எல்லாச் சாதனங்களிலும் உங்கள் கடவுச்சொற்கள், புக்மார்க்குகள் மற்றும் பலவற்றைப் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="3352986031709923790">தேடல் பகுதியின் மேல் வலது மூலை: வலது <ph name="RIGHT"/>%, மேல் <ph name="TOP"/>%</translation>
<translation id="120745000989996104">உங்கள் கணக்கில் உள்ள Browther தரவு</translation>
<translation id="3369405342922656244">படத் தேடல் அம்சம் மூலம் இந்தப் பக்கத்தைத் தேடுங்கள்</translation>
<translation id="7173761126541905083">மொபைலில் Browther மூலம் உங்கள் கடவுச்சொற்களைப் பயன்படுத்துங்கள்</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">ஏற்கெனவே உள்ள Browther சுயவிவரத்திற்கு மாறவா?</translation>
<translation id="3412460710772753638">இந்தச் சாதனத்தில் உள்ள Password Managerரில்</translation>
<translation id="4282363917570905631">உங்கள் மொபைலில் Browther மூலம் மேம்பட்ட பாதுகாப்பான பிரவுசிங்கைப் பெறுங்கள்</translation>
<translation id="986094398735583155">உங்களுக்கான Browther தயாராகிறது...</translation>
<translation id="3266047225484320321">களவாடப்பட்ட கடவுச்சொல்லைக் கொண்டு நீங்கள் உள்நுழையும்போது Browther அது குறித்து உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="3508047337876211050">வெளியேறினால், இந்தச் சாதனத்திலிருந்து <ph name="ITEMS_COUNT"/> உருப்படிகள் நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Browther இல் <ph name="USER_EMAIL"/> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> விசைகளை அழுத்தி Browther சுயவிவரங்களுக்கு இடையே மாறலாம்</translation>
<translation id="7225005776233199285">அனைத்து Browther சாளரங்களையும் மூடி, பின்னர் முயலவும்.</translation>
<translation id="5465054931427475969">சாளரத்தைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> ஆக ஏற்கெனவே உள்நுழைந்துள்ளீர்கள்.  உங்கள் உலாவலைத் தனிப்பட்டதாக வைத்திருக்க, உங்கள் சுயவிவரத்தில் <ph name="USER_EMAIL_ADDRESS"/> என்ற மின்னஞ்சல் முகவரி மூலம் Braveமில் உள்நுழையவும்.</translation>
<translation id="8133590217245064579">ஸ்கிரீனைப் பகிர, சிஸ்டம் அமைப்புகளில் Braveமிற்கு ஸ்கிரீன் ரெக்கார்டிங்கை அனுமதிக்கவும்.</translation>
<translation id="3597003331831379823">கூடுதல் அணுகல்களுடன் அமைவை இயக்க முடியவில்லை. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Braveமில் உள்நுழையுங்கள்</translation>
<translation id="2492221622209669678">இவருடைய உலாவிய தரவு இந்தச் சாதனத்திலிருந்து நீக்கப்படும். தரவை மீட்டெடுக்க, Braveமில் <ph name="USER_EMAIL"/> ஆக உள்நுழையவும்.</translation>
<translation id="6793778233257855801"><ph name="ORIGIN"/> என்ற தளத்தில் இருந்து உங்கள் Android மொபைலுக்கு ஓர் எண்ணை அனுப்ப, இரு சாதனங்களிலும் Braveமில் உள்நுழையுங்கள்.</translation>
<translation id="3667616615096815454">நிறுவ முடியவில்லை, சேவையகத்திற்கு ஆப்ஸ் பற்றி தெரியவில்லை.</translation>
<translation id="5585500151754164442">எனது Browther கணக்கில் உள்ள Browther தரவு எல்லாவற்றையும் என்க்ரிப்ஷன் செய்ய <ph name="BEGIN_LINK"/>எனது கடவுச்சொற்றொடரைப்<ph name="END_LINK"/> பயன்படுத்து. Google Payயில் உள்ள பேமெண்ட் முறைகளும் முகவரிகளும் என்க்ரிப்ட் செய்யப்படாது. Braveமில் உள்ள பிரவுசிங் பதிவுகள் ஒத்திசைக்கப்படாது.</translation>
<translation id="404323216042159951">Braveமால் உங்கள் கடவுச்சொற்களைச் சரிபார்க்க முடியாது. உங்கள் இணைய இணைப்பைச் சரிபார்க்க முயலவும்.</translation>
<translation id="5004936474632127765">புதிய Browther &amp;தாவலில் இணைப்பைத் திற</translation>
<translation id="6236643159256182256">பிரத்தியேகமாக்குதல் மற்றும் பிற நோக்கங்களுக்காக Browther உடன் பிற Browther சேவைகளை இணைக்கலாம்</translation>
<translation id="3729187154190517324">"பக்கம் மற்றும் பலவற்றைச் சேர்" பட்டனைப் பயன்படுத்தி ஒன்றுக்கும் மேற்பட்ட பக்கங்கள், ஃபைல்கள், கருவிகள் ஆகியவற்றைச் சேர்ப்பதன் மூலம் உங்கள் தேடலை மேம்படுத்தலாம்.</translation>
<translation id="1400697664933775238">Browther சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="2461315395128103158">சில பதிவிறக்கங்களை Browther ஏன் தடுக்கிறது என்பதைத் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="8058420662026104226">நீங்கள் ஏதேனும் நடவடிக்கை எடுக்க வேண்டியிருந்தால் அதுகுறித்து Browther உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="3177448557921912221">உங்கள் வாழ்க்கையின் வெவ்வேறு பகுதிகளைத் தனித்தனியாக வைத்திருக்க Browther சுயவிவரங்கள் உதவுகின்றன. இப்போது புதிய சுயவிவரத்தைச் சேருங்கள்.</translation>
<translation id="1541177876035612043">நீங்கள் பார்வையிடக்கூடிய பக்கங்களை Browther முன்கூட்டியே ஏற்றிவிடுவதால் அந்தப் பக்கங்கள் மிக விரைவாக ஏற்றப்படும்</translation>
<translation id="3810973564298564668">நிர்வகி</translation>
<translation id="1117103475254549453">சேமித்த கடவுச்சொற்களைப் பயன்படுத்த QR குறியீட்டை ஸ்கேன் செய்து, iOSஸிற்கான Braveமைப் பதிவிறக்கி உங்கள் Browther கணக்கில் உள்நுழையவும்</translation>
<translation id="8880695882192156860">Browther உதவிக்குறிப்பு: மேம்பட்ட பாதுகாப்பான பிரவுசிங்</translation>
<translation id="3846683726093018685">**சுருக்கு:** ஸ்கிரீன்ஷாட்டில் உள்ள உள்ளடக்கத்தின் முதன்மைப் பொருளையும் நோக்கத்தையும் 30 வார்த்தைகளுக்கு மிகாமல் ஒரே வாக்கியத்தில் விவரி.

          **கேள்விகளைப் பரிந்துரை:** ஸ்கிரீன்ஷாட்டை நன்றாகப் புரிந்துகொள்ள பயனர் கேட்கக்கூடிய, சிந்தனையைத் தூண்டும் 3 - 5 கேள்விகளைப் பொட்டுக்குறியிட்ட பட்டியலாக உருவாக்கு. இவற்றில் குறைந்தது ஒரு கேள்வி, காட்டப்படும் பொருள், அதன் வடிவமைப்பு அல்லது அது காட்டப்படும் இடத்தைப் பற்றி இருக்க வேண்டும்.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">மொழி தேர்ந்தெடுப்பான்</translation>
<translation id="4861846616763552424">Braveமைத் தேவைக்கேற்ப மாற்றி கட்டுப்படுத்தும். சிலவற்றை நீங்கள் கவனிக்க வேண்டும் - விவரங்களுக்கு, கிளிக் செய்யவும்.</translation>
<translation id="6126366281251241386">Browther ஐத் திறந்து, உலாவலைத் தொடங்க உங்கள் பெயரைக் கிளிக் செய்யவும்.</translation>
<translation id="3892148308691398805">உரையை நகலெடு</translation>
<translation id="3760801273210219822">இந்த Browther சுயவிவரத்தில் ஏற்கெனவே <ph name="EXISTING_USER"/> உள்நுழைந்துள்ளார். நீங்கள் உலாவுவதைத் தனிப்பட்டதாக வைத்திருக்க உங்களுக்கு ஒரு புதிய சுயவிவரத்தை Browther உருவாக்க முடியும்.</translation>
<translation id="3821553157234855663">Braveமைப் பிரத்தியேகமாக்கு</translation>
<translation id="3941890832296813527">நிறுவல் பிழை: நிறுவியின் ஃபைல் பெயர் தவறானது அல்லது ஆதரிக்கப்படவில்லை.</translation>
<translation id="6482299900191767005">Browther கடவுச்சொற்களை நகலெடுக்க முயல்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="5853011008278898603">உங்கள் Browther கணக்கில் சேமித்துள்ள கடவுச்சொற்கள், பேமெண்ட் முறைகள், முகவரிகள் ஆகியவை இந்தச் சாதனத்தில் இருந்து அகற்றப்படும். அவற்றை மீண்டும் Braveமில் பயன்படுத்த, மீண்டும் உள்நுழையவும்.</translation>
<translation id="395904275706073188">பாதுகாக்கப்பட்ட பக்கங்களை ரீட் செய்ய முடியாது. வேறு பக்கத்தை முயலவும்.</translation>
<translation id="1832973663231751701">Browther எப்படி உங்களைப் பாதுகாப்பாக வைக்கிறது என்பது பற்றித் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="4531502594774670767">முகவரிப் பட்டி அல்லது தேடல் பெட்டியில் நீங்கள் டைப் செய்யும்போது, பரிந்துரைகளைப் பெறுவதற்காக அவற்றை Browther உங்கள் நிறுவனத்தின் தேடல், AI அல்லது ஏஜெண்ட் கருவிகளுக்கு அனுப்பும்.</translation>
<translation id="300013383485253006">&amp;Browther for Testing - ஓர் அறிமுகம்</translation>
<translation id="1152920704813762236">ChromeOS - ஓர் அறிமுகம்</translation>
<translation id="8126752030994997015">நீங்கள் ஒரு தளத்தைப் பார்வையிடும்போது உங்கள் IP முகவரியை மறைக்கும் பிரைவசி சர்வர் வழியாக URLலின் கடினமான பகுதியை <ph name="BEGIN_LINK"/>Browther பாதுகாப்பான பிரவுசிங்கிற்கு<ph name="END_LINK"/> Browther அனுப்பும். தளத்தில் சந்தேகத்திற்குரிய வகையில் ஏதேனும் நிகழ்ந்தால் முழு URLகளும் பக்க உள்ளடக்கத்தின் சிறிய பகுதிகளும் அனுப்பப்படும்.</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_LINUX_OSS"/>Linux டெவெலப்மெண்ட் சூழல்<ph name="END_LINK_LINUX_OSS"/> போலவே, கூடுதல் <ph name="BEGIN_LINK_CROS_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_CROS_OSS"/> மூலம் ChromeOS உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="4022972681110646219">திரையை மொழிபெயர்</translation>
<translation id="4023601594785368013">அசல் மொழி: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">எந்த ஆப்ஸில் இருந்தும் Braveமில் இணைப்புகளைத் திறக்கலாம். அத்துடன், எளிதாக அணுகும் வகையில் செயல் பட்டியில் பிரவுசரைப் பின் செய்யலாம்.</translation>
<translation id="3437506136408403836"><ph name="BEGIN_LINK"/>தற்போதைய அமைப்புகளைப்<ph name="END_LINK"/> பற்றிய அறிக்கையை அனுப்பி, Braveஐ இன்னும் சிறந்ததாக்க உதவவும்</translation>
<translation id="4050175100176540509">முக்கியப் பாதுகாப்பு மேம்பாடுகளும், புதிய அம்சங்களும் சமீபத்திய பதிப்பில் கிடைக்கின்றன.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="2164947358785939495">உங்கள் கம்ப்யூட்டரில் உள்ள மற்றொரு நிரல் Browther இயங்கும் முறையை மாற்றும் நீட்டிப்பைச் சேர்த்துள்ளது.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Browther ஒரு நிமிடத்திற்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும். உலாவிய தரவு நீக்கப்படும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.}other{Browther # நிமிடங்களுக்குப் பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதைத் தானாக மூடிவிடும். உலாவிய தரவு நீக்கப்படும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.}}</translation>
<translation id="1535413545339990419">Browther அறிமுகம் என்ற பக்கத்திற்குச் செல்லும்</translation>
<translation id="692283249649018289">உங்கள் பிரவுசருக்குப் புதிய தோற்றத்தைக் கொடுக்க Braveமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="6375229634133804834">Braveமைப் பிரத்தியேகமாக்கு</translation>
<translation id="4148957013307229264">நிறுவுகிறது...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - நெட்வொர்க் உள்நுழைவு - Browther</translation>
<translation id="2911246138082876798">Braveக்கான சிறந்த ஆப்ஸ், கேம்கள், நீட்டிப்புகள் மற்றும் தீம்களைக் கண்டறியவும்.</translation>
<translation id="2528977475313334293">உங்களின் எல்லாக் கம்ப்யூட்டர்களிலும் இந்த நீட்டிப்பையும், மேலும் பலவற்றையும் பெற Braveமில் உள்நுழையுங்கள்</translation>
<translation id="8244267655940711467">உங்கள் பெற்றோர் தேர்வுசெய்துள்ள அமைப்புகளுடன் ஆன்லைனில் பாதுகாப்பாக இருக்க, <ph name="USER_EMAIL_ADDRESS"/> என்ற கணக்கில் ஏற்கெனவே உள்நுழைந்துள்ள Browther சுயவிவரத்திற்கு மாறுங்கள்</translation>
<translation id="4222932583846282852">ரத்துசெய்கிறது...</translation>
<translation id="4224210481850767180">நிறுவுதல் ரத்துசெய்யப்பட்டது.</translation>
<translation id="8219359042845534271">உங்கள் Browther தரவை இந்தக் கணக்குடன் இணைக்கவா?</translation>
<translation id="5520777668172961882">இயல்பான பாதுகாப்பு நிலையில் செய்வதைவிட அதிகமான தரவைத் தளங்களில் இருந்து பகுப்பாய்வு செய்வதன் மூலம் ஆபத்தான தளங்கள் (Braveளுக்கு முன்பே தெரிந்திருக்காத தளங்கள் உட்பட) பற்றி உங்களை எச்சரிக்கும். Browther வழங்கும் எச்சரிக்கைகளை நீங்கள் தவிர்க்கலாம்.</translation>
<translation id="2014920019837536689">Braveமில் இருந்து வெளியேறு</translation>
<translation id="4341512411059715879">Browther தொடர்பான உதவி பெறுக</translation>
<translation id="4281844954008187215">சேவை விதிமுறைகள்</translation>
<translation id="322492684764924424">குறிப்பிடப்படாத பிழைக் காரணமாக நிறுவல் தோல்வியடைந்தது. Browther தற்போது இயக்கத்தில் இருந்தால், அதை மூடி, பின்னர் முயலவும்.</translation>
<translation id="3813060261346666066">Braveமில் இருந்து கடவுச்சொற்களைப் பதிவிறக்குதல்</translation>
<translation id="4304713468139749426">கடவுச்சொல் நிர்வாகி</translation>
<translation id="4334241893986177674">இந்த ஸ்கிரீன்ஷாட்டைத் தேடும்</translation>
<translation id="4334294535648607276">பதிவிறக்கம் முடிந்தது.</translation>
<translation id="2177954934431828302">Windows தொடங்கும்போதே Braveமைத் தொடங்கு</translation>
<translation id="2472318668926455009">Braveமை இயல்பு பிரவுசராக அமைப்பதன் மூலம் உங்களுக்குத் தெரிந்த, பிடித்த மற்றும் நம்பகமான அம்சங்களை எளிதாக அணுகலாம். விரைவாக அணுகும் வகையில் Browther உங்கள் செயல் பட்டியில் பின் செய்யப்படும்.</translation>
<translation id="1068681683510904753">இந்தச் சாதனத்தைப் பயன்படுத்துவதற்கு முன்பு பின்வரும் சேவை விதிமுறைகளைப் படித்து ஏற்குமாறு <ph name="MANAGER"/> கோருகிறது. இவை ChromeOS விதிமுறைகளுடன் கூடுதலானவற்றைச் சேர்க்கவோ மாற்றவோ குறைக்கவோ செய்யாது.</translation>
<translation id="2897580280700805340">Browther இலிருந்து வெளியேறவா?</translation>
<translation id="4413205837991854510">படத் தேடலுக்கான ஷார்ட்கட்டை எப்போதும் காட்டு</translation>
<translation id="2454897022983434851">பின்னணியில் Braveஐ இயங்க அனுமதி</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{இதை அகற்றும்படி Browther பரிந்துரைக்கிறது. <ph name="BEGIN_LINK"/>ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK"/>}other{இவற்றை அகற்றும்படி Browther பரிந்துரைக்கிறது. <ph name="BEGIN_LINK"/>ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Browther ஐ தனிப்பயனாக்கி கட்டுப்படுத்துக</translation>
<translation id="4427306783828095590">ஃபிஷிங்கையும் மால்வேரையும் தடுக்க மேம்பட்ட பாதுகாப்பு உதவுகிறது</translation>
<translation id="4434353761996769206">நிறுவியில் பிழை: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846">Braveமை <ph name="MANAGER"/> நிர்வகிக்கிறது</translation>
<translation id="4007482010626246887">Browther சுயவிவரத்தைச் சேர்</translation>
<translation id="6888322430074420631">Browther for Testing - ஓர் அறிமுகம்</translation>
<translation id="8912436499620582668">உங்கள் Browther கணக்கில் Browther தரவைப் பயன்படுத்துவதற்கும் சேமிப்பதற்கும், உங்கள் கடவுச்சொற்றொடரை டைப் செய்யவும்.</translation>
<translation id="4493028449971051158">துவக்கப் பிழை: நிர்வாகியாக நிறுவியை இயக்குங்கள்.</translation>
<translation id="4501471624619070934">இந்த நாட்டில் அணுகல் தடைசெய்யப்பட்டுள்ளதால் நிறுவ முடியவில்லை.</translation>
<translation id="8976207309012239417">இந்த நீட்டிப்பு, தனியுரிமை நடைமுறைகளை (தரவை எப்படிச் சேகரித்துப் பயன்படுத்தும் போன்றவை) வெளியிடவில்லை. இதை அகற்றும்படி Browther பரிந்துரைக்கிறது.</translation>
<translation id="2174621824527957495">Braveமிற்கு வரவேற்கிறோம்; புதிய உலாவிச் சாளரம் திறக்கப்பட்டது</translation>
<translation id="6391148383688605718">உங்களைச் சுற்றி இருப்பவற்றை மேப் செய்வதற்கும் உங்கள் கைகளை டிராக் செய்வதற்கும் Braveமிற்கு அனுமதி தேவை</translation>
<translation id="7756445485815468244">நீங்கள் மற்றொரு Browther சுயவிவரத்தில் <ph name="USER_EMAIL_ADDRESS"/> கணக்கின் மூலம் ஏற்கெனவே உள்நுழைந்துள்ளீர்கள்</translation>
<translation id="137435413163730206">விரைவாக பிரவுஸ் செய்வதற்கும் தேடுவதற்கும் உதவும் வகையில் பக்கங்களை முன்கூட்டியே Browther ஏற்றுகிறது. <ph name="BEGIN_LINK"/>பக்கங்களை முன்கூட்டியே ஏற்றுதல் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">தீங்கு விளைவிக்கும் என்று நீங்கள் நினைக்கும் தளத்தைப் புகாரளிப்பதன் மூலம் அனைவருக்கும் ஆன்லைன் பாதுகாப்பை மேம்படுத்தலாம்.</translation>
<translation id="3266647901351304597">நீங்கள் பாதுகாப்பு உலாவல் அமைப்பை முடக்கியிருப்பதன் காரணமாக ஃபைலைச் சரிபார்க்க முடியவில்லை என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="6980208900390333646">உங்கள் மொபைலில் Browther மூலம் Google Lens பயன்படுத்திப் பாருங்கள்</translation>
<translation id="4594305310729380060">இந்தச் சாதனத்தில் உள்ள Password Managerரில்</translation>
<translation id="738228944918383850">Browther ஆப்ஸ்</translation>
<translation id="4598116752460667024">பட்டியலில் உள்ள எந்தச் செயல்பாட்டையும் தேடும்.</translation>
<translation id="4970880042055371251">ChromeOS பதிப்பு</translation>
<translation id="4482468019601425607">கிட்டத்தட்ட புதுப்பிக்கப்பட்டது! புதுப்பிப்பதை முடிக்க, Braveஐ மீண்டும் தொடங்கவும்.</translation>
<translation id="5517890123509214766">Braveமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை Browther தடுக்கும் திறனைச் சற்று குறைக்கும்</translation>
<translation id="7690070364551268156">Browther உபயோக அறிக்கைகளை நீங்கள் பகிர்ந்தாலும் நீங்கள் பார்வையிட்ட URLகள் அவற்றில் இருக்கும்</translation>
<translation id="5020487088453637212">இந்தக் கணக்கு மற்றொரு கம்ப்யூட்டரில் (<ph name="HOST_NAME"/>) மற்றொரு Browther Browther செயல்முறையால் (<ph name="PROCESS_ID"/>) பயன்படுத்தப்படுவதாகத் தோன்றுகிறது. Browther இதைப் பூட்டியுள்ளதால், இது சிதைவடையாது. இதை மற்ற செயல்முறைகள் பயன்படுத்தவில்லை என்பதில் நீங்கள் உறுதியாக இருந்தால், நீங்கள் இதை அன்லாக் செய்து Braveமை மீண்டும் துவங்கலாம்.</translation>
<translation id="4680828127924988555">நிறுவலை ரத்து செய்</translation>
<translation id="8134827615154347946">உங்களின் சில Browther தரவுகள் உங்கள் Browther கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறுவதற்கு முன் சில நிமிடங்கள் காத்திருக்கவும். இப்போதே வெளியேறினால் இந்தத் தரவு நீக்கப்படும்.</translation>
<translation id="3508712423420506333">உள்நுழைந்திருக்கும்போது உங்கள் Browther கணக்கில் உள்ள கடவுச்சொற்களையும், மேலும் பலவற்றையும் நீங்கள் Braveமில் பயன்படுத்தலாம். Browther சேவைகளுக்கான அமைப்புகளை <ph name="SHORTCUT"/> மூலம் மாற்றலாம்.</translation>
<translation id="2388739442635757494">இதற்கு முன்னர் ஒருவர் இந்தக் கம்ப்யூட்டரிலுள்ள Braveமில் <ph name="ACCOUNT_EMAIL_LAST"/> எனும் முகவரியைப் பயன்படுத்தி உள்நுழைந்திருந்தார். உங்கள் தகவலைத் தனிப்பட்டதாக வைத்திருக்க, புதிய Browther பயனரை உருவாக்கவும்.</translation>
<translation id="4724676981607797757">ஆதரிக்கப்படாத நெறிமுறைப் பிழை காரணமாக நிறுவ முடியவில்லை.</translation>
<translation id="8305313684264112434">Browther இலிருந்து வெளியேறவா?</translation>
<translation id="418155915144835101">Braveமுக்கான சிறப்புப் பாதுகாப்புப் புதுப்பிப்பு சற்றுமுன் இயக்கப்பட்டது. இப்போது Braveமை மீண்டும் தொடங்கவும், உங்கள் தாவல்களை மீண்டும் காண்பிப்போம்.</translation>
<translation id="2683970367518529374">Braveமைக் கேளுங்கள்</translation>
<translation id="5064473048847774331">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> மேலும் <ph name="COUNT"/> அனுமதிகளை Browther அகற்றிவிட்டது.</translation>
<translation id="5941343075741207533">Browther உலாவியால் உங்கள் கடவுச்சொற்களைச் சரிபார்க்க முடியவில்லை. 24 மணிநேரத்திற்குப் பிறகு மீண்டும் முயலவும் அல்லது <ph name="BEGIN_LINK"/>உங்கள் Browther கணக்கில் கடவுச்சொற்களைச் சரிபார்க்கவும்<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">இது Browther தேடலில் பயன்படுத்தப்படும் அதே பிழைதிருத்தியைப் பயன்படுத்துகிறது. உலாவியில் நீங்கள் உள்ளிடும் உரை Braveளுக்கு அனுப்பப்படும். இதை அமைப்புகளில் எப்போது வேண்டுமானாலும் மாற்றலாம்.</translation>
<translation id="4581078588976787792">கணக்கு இல்லாமல் Braveமைப் பயன்படுத்து</translation>
<translation id="5921583137589782067">mDNS ட்ராஃபிக்கை அனுமதிப்பதற்கான, Browther க்கான உள்வரும் விதி.</translation>
<translation id="6563126962881169552">&amp;Braveமைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="4918086044614829423">ஏற்கிறேன்</translation>
<translation id="4918844574251943176">படம் நகலெடுக்கப்பட்டது</translation>
<translation id="5240982928057703861">Browther பின்புல பயன்முறையில் இயங்குகிறது.</translation>
<translation id="3603134280602182991">Browther உள்நுழைவு உரையாடலை மூட இதைக் கிளிக் செய்யவும்</translation>
<translation id="6120233890602288442">Browther சுயவிவரங்களைப் பயன்படுத்தி உங்கள் Browther தொடர்பான எல்லாவற்றையும் தனித்தனியாக வைத்துக்கொள்ளலாம். நண்பர்களுக்காகவும் குடும்பத்திற்காகவும் சுயவிவரங்களை உருவாக்கலாம் அல்லது பணி, பொழுதுபோக்கு போன்றவற்றுக்கு அவற்றைத் தனித்தனியாக வைத்துக்கொள்ளலாம்.</translation>
<translation id="5722688387568011881">எதையும் விட்டுசெல்லாமல் கெஸ்ட் பயனர்கள் Browther ஐப் பயன்படுத்தலாம்.</translation>
<translation id="7786958592460743302">Braveமில் உங்கள் கணக்கு</translation>
<translation id="9114640791491590337">உங்களை Browther இல் சேர்க்கவும்</translation>
<translation id="3536391594566515053">உங்கள் பக்கங்களில் வேலை செய்யவும் நீங்கள் வழங்கும் பணிகளை நிறைவுசெய்யவும் தானியங்கு பிரவுசிங்கை Braveமில் Gemini பயன்படுத்துகிறது. <ph name="LINK_BEGIN"/>மேலும் அறிக<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">உங்கள் கைகளை டிராக் செய்ய Braveமிற்கு அனுமதி தேவை</translation>
<translation id="1627123463102858476">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> ஆகிய அனுமதிகளை Browther அகற்றிவிட்டது.</translation>
<translation id="5174969993834422967">பொதுவாக அறிவிப்புகளைத் தடுத்து விடுவீர்கள். இந்தத் தளம் உங்களுக்கு அறிவிப்புகளை வழங்க அனுமதிக்க, இடப் பட்டியின் வலது மூலையில் உள்ள அறிவிப்பு ஐகானைக் கிளிக் செய்யவும்.</translation>
<translation id="5174983315706567306">டிஸ்க்கில் போதுமான சேமிப்பிடம் இல்லை.</translation>
<translation id="7091313576354542088">Browther கணக்கிற்கு மறு அடையாளச் சரிபார்ப்பு தேவைப்படுகிறது</translation>
<translation id="9045390598305758496">சேமித்த கடவுச்சொற்கள் எதுவுமில்லை. நீங்கள் அவற்றைச் சேமிக்கும்போது Browther உலாவியால் உங்கள் கடவுச்சொற்களைச் சரிபார்க்க முடியும்.</translation>
<translation id="5686724084351858452">Browther இலிருந்து வெளியேறு</translation>
<translation id="5234764350956374838">நிராகரி</translation>
<translation id="5254739261293693943">இந்த வீடியோ பற்றிக் கேளுங்கள்</translation>
<translation id="8165028066129227692">உங்கள் மாற்றங்களைச் செயல்படுத்த, Braveமை மீண்டும் தொடங்கவும்</translation>
<translation id="5286907366254680517">கண்டறியப்பட்டது</translation>
<translation id="198210130507193824">Browther ஆப்ஸைப் பெறுங்கள்</translation>
<translation id="8472078903122489041">Browther Updater Internal Service</translation>
<translation id="5346389065299425353">பல பக்கங்கள், ஃபைல்கள், கருவிகள் ஆகியவற்றைச் சேர்ப்பதன் மூலம் உங்கள் தேடலை மேம்படுத்தலாம்</translation>
<translation id="3904682305383981098">நீங்கள் நடவடிக்கை எடுக்க சில பாதுகாப்பு தொடர்பான பரிந்துரைகளை Browther கண்டறிந்துள்ளது</translation>
<translation id="509616246140011182">பிற Browther சுயவிவரங்கள்</translation>
<translation id="8214429210535362385">நீங்கள் நிர்வகிக்கப்படும் கணக்கு மூலம் உள்நுழைகிறீர்கள், மேலும் அதன் நிர்வாகிக்கு உங்கள் Browther சுயவிவரத்தின் கட்டுப்பாட்டை வழங்குகிறீர்கள். உங்கள் ஆப்ஸ், புக்மார்க்குகள், வரலாறு, கடவுச்சொற்கள் போன்ற உங்கள் Browther தரவு மற்றும் பிற அமைப்புகள் நிரந்தரமாக <ph name="USER_NAME"/> உடன் இணைக்கப்படும். இந்தத் தரவை Browther கணக்குகளின் டாஷ்போர்டு வழியாக நீக்க முடியும், ஆனால் இந்தத் தரவை வேறொரு கணக்குடன் தொடர்புபடுத்த முடியாது. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">கூடுதல் குறியீடு: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">பிரத்தியேகமாக்குதலைப் பெற, இணையம் மற்றும் ஆப்ஸ் செயல்பாட்டில் Braveமைச் சேர்க்கவும்</translation>
<translation id="8096544113811780871">சில ஃபைல்களை Browther ஏன் தடுக்கிறது என்பதைத் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="2384387444932590174">Braveஐப் புதுப்பிக்கிறது (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">Browther உள்நுழைவை அனுமதித்தல்</translation>
<translation id="6557334704331248411">Browther இலிருந்து அகற்று</translation>
<translation id="5832041381258620673">செயல்திறனைக் குறைக்கும், ஆனால் தாக்குதல்களை Browther தடுக்கும் திறனை அதிகரிக்கும்</translation>
<translation id="3763317028635993788">உங்கள் இயல்புநிலை உலாவியாக Browther ஐ அமை</translation>
<translation id="8756552710915246172"><ph name="PAGE_TITLE"/> - Browther பீட்டா</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கத்தை இடைநிறுத்தும்படி Browther பரிந்துரைக்கிறது}other{உங்கள் பிரவுசர் செயல்படும் வேகத்தைக் குறைக்கும் பக்கங்களை இடைநிறுத்தும்படி Browther பரிந்துரைக்கிறது}}</translation>
<translation id="4423621904097888155">இந்த Linux விநியோகத்தில் Browther தற்போது ஆதரிக்கப்படுவதில்லை என்பதால் அது சரியாகச் செயல்படாமல் போகலாம்</translation>
<translation id="6201726364919996698">உங்களின் தனிப்பட்ட மற்றும் சமூக வலைத்தளக் கணக்குகளில் இந்த ஃபைல் பாதிப்பை ஏற்படுத்தலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="7679204468655335605">இந்தத் தளத்துடன் இருப்பிடத்தைப் பகிர Braveமுக்கு உங்கள் இருப்பிடத்திற்கான அணுகல் தேவை</translation>
<translation id="1163572992704966942">சமீபத்திய முறைமை புதுப்பிப்புகளை Browther நிறுவும் வரை காத்திருக்கவும்.</translation>
<translation id="5050118226119231029">Browther கடவுச்சொற்களைத் திருத்த முயல்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லை உள்ளிடவும்.</translation>
<translation id="5524890928877629608">தேடல் பகுதியின் மேல் இடது மூலை: இடது <ph name="LEFT"/>%, மேல் <ph name="TOP"/>%</translation>
<translation id="5875549039106594731">PDFகளை Braveமில் திற</translation>
<translation id="5536164441519929134">இந்தப்<ph name="LINE_BREAK"/>பக்கம் பற்றிக் கேட்கலாம்</translation>
<translation id="5579324208890605088">துவக்கப் பிழை: நிர்வாகியாக இல்லாமல் வழக்கமான பயனராக நிறுவியை இயக்குங்கள்.</translation>
