<translation id="1482759407165416070">இப்போது உங்கள் Browther கணக்குடனும், பகிரப்பட்ட கம்ப்யூட்டர்களிலும் Braveமைப் பயன்படுத்துவது எளிதானது.</translation>
<translation id="5538042432112726532">Browther ஷார்ட்கட்</translation>
<translation id="833085228901080512">இந்த ஃபைல் பொதுவாகப் பதிவிறக்கப்படுவதில்லை என்பதுடன் ஆபத்தானதாகவும் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="491120842288314439">Browther ஐ நிச்சயமாக நிறுவல் நீக்கவா?</translation>
<translation id="6375219077595103062">Password Managerருக்கு ஷார்ட்கட்டைச் சேர்க்கலாம்</translation>
<translation id="6388799252195623474">இதில் எனக்கு உதவு</translation>
<translation id="6715003312952407375">தொடர, <ph name="EMAIL"/> என்ற கணக்கில் Braveமில் உள்நுழையவும். உங்கள் நிறுவனத்தின் கொள்கைகள் இந்த பிரவுசருக்கு அமைக்கப்பட்டிருப்பதை இது உறுதிசெய்யும்.</translation>
<translation id="1897845318651970239">கம்ப்யூட்டர் ஸ்கிரீன் உள்ளே Browther உலாவி லோகோ.</translation>
<translation id="3669522483038684532">Browther ஆனது வலைப்பக்கங்கள் மற்றும் ஆப்ஸில் குறைவான வேகத்துடன் இயங்கும் வலை உலாவியாகும். இது விரைவானது, நிலையானது மற்றும் பயன்படுத்துவதற்கு எளிமையானது. Braveமில் உருவாக்கப்பட்ட மால்வேர் மற்றும் ஃபிஷிங் பாதுகாப்பு மூலம் வலையை மிகவும் பாதுகாப்பாக உலாவலாம்.</translation>
<translation id="5669767676913031391">Browther வேகமாக இயங்கும், அத்துடன் JavaScriptடைப் பயன்படுத்தும் அம்சங்கள் வடிவமைக்கப்பட்டுள்ளபடி செயல்படும்</translation>
<translation id="6436260184216827876">படத் தேடல் கிடைக்கவில்லை. பிறகு முயலவும்.</translation>
<translation id="2139300032719313227">ChromeOSஸை மீண்டும் தொடங்குங்கள்</translation>
<translation id="6110616900529884221">நீங்கள் பார்வையிடக்கூடிய கூடுதல் பக்கங்களை Browther முன்கூட்டியே ஏற்றிவிடுவதால் அந்தப் பக்கங்கள் மிக விரைவாக ஏற்றப்படும்</translation>
<translation id="1217194059001819677">விலைகளைக் கண்காணிக்கவும் ஏதேனும் தளத்தில் விலை குறைந்தால் அதுகுறித்த விழிப்பூட்டல்களைப் பெறவும் உங்கள் மொபைலில் Braveமைப் பதிவிறக்குங்கள்</translation>
<translation id="7058555680120557198">முடக்கு • இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Braveமால் சரிபார்க்க முடியவில்லை</translation>
<translation id="676533642429632127">Browther சுயவிவரங்களுக்கு வரவேற்கிறோம்</translation>
<translation id="5518682889576009702">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் Braveமைத் திறக்கும்போது, பக்கக் குழுக்களைப் பயன்படுத்தும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="6038105561107837619">Braveமில் இருந்து கணக்கை அகற்று</translation>
<translation id="2675662665675552980">Browther ஐத் தொடங்கும்போது காண்பிக்கப்படும் பக்கத்தையும் இது கட்டுப்படுத்துகிறது.</translation>
<translation id="648319183876919572">ஆபத்தான இணையதளங்கள், பதிவிறக்கங்களில் இருந்து உங்களைப் பாதுகாக்க மேம்பட்ட பாதுகாப்பு உலாவல் அம்சம் பலவற்றைச் செய்கிறது</translation>
<translation id="2930243146591999795">Browther ஐ நிறுவல் நீக்கு</translation>
<translation id="5241183382286817629">ஷார்ட்கட்கள் Braveமில் திறக்கும்</translation>
<translation id="7907014599435829661">Browther <ph name="TIMEOUT_DURATION"/> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை மூடிவிடும். உலாவிய தரவு நீக்கப்பட்டது. இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.</translation>
<translation id="2088471423667794811">புக்மார்க்குகள், இதுவரையான செயல்பாடுகள், கடவுச்சொற்கள் போன்ற Browther தகவல்கள் ஒவ்வொரு சுயவிவரத்திற்கும் தனித்தனியாக இருக்கும்</translation>
<translation id="9040334484455218184"><ph name="BEGIN_LINK"/>Browther உங்கள் தரவை எப்படித் தனிப்பட்டதாக வைத்திருக்கிறது<ph name="END_LINK"/> என்பது குறித்து மேலும் தெரிந்துகொள்ளுங்கள்</translation>
<translation id="1718697235867382480">இந்த அமைப்பில் செய்யப்படும் மாற்றங்கள் Browther மீண்டும் தொடங்கியதும் செயல்படுத்தப்படும்.</translation>
<translation id="6331317152404762758">வேறொரு Browther சுயவிவரத்தில் உள்ள கடவுச்சொற்களைப் பார்க்க அதற்கு மாறலாம்</translation>
<translation id="6097706403184348562">எழுத்துப் பிழைகளைச் சரிசெய்ய, Browther நீங்கள் உரைப் புலங்களில் உள்ளிடும் உரைகளை Braveளுக்கு அனுப்பும்</translation>
<translation id="2319647238307402812">Browther அறிவிப்பு அமைப்புகளுக்குச் செல்</translation>
<translation id="6600016381025017075">இந்தப் பக்கத்தில் எதையும் தேடலாம்</translation>
<translation id="8031938899816118394">அடுத்த முறை நீங்கள் Browther ஐ மீண்டும் தொடங்கும்போது உங்கள் மாற்றங்கள் செயல்படும்.</translation>
<translation id="7412185356697187964">Windows தொடங்கும்போதே Browther இப்போது தொடங்கப்படுவதால் நீங்கள் உடனடியாக பிரவுசிங் செய்யத் தொடங்கலாம். இதை நீங்கள் அமைப்புகளில் ஆஃப் செய்யலாம்.</translation>
<translation id="9123343592576384616">விட்ட இடத்திலிருந்து தொடரலாம்: கடந்த அமர்வில் இருந்து Browther உங்கள் பக்கங்களை மீட்டெடுத்துள்ளது. இதை இங்கு ஆஃப் செய்யலாம்:</translation>
<translation id="5847926498049048567">உங்களைச் சுற்றியுள்ள இடங்களின் 3D வரைபடத்தை உருவாக்க, Braveமிற்குக் கேமரா அணுகல் தேவை</translation>
<translation id="5532585028508811858">உங்கள் Browther கணக்கில் புக்மார்க்குகளையும் நீங்கள் சேமித்தால், Braveமில் தயாரிப்பு விலைகளைக் கண்காணிக்கலாம், விலை குறையும்போது அதற்கான அறிவிப்புகளைப் பெறலாம்</translation>
<translation id="6676384891291319759">இணையத்தை அணுகுதல்</translation>
<translation id="1363996462118479832">உள்நுழைவில் பிழை ஏற்பட்டதால் உங்கள் தரவை ChromeOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="3373239673945775810">Braveமில் இருந்து இந்த ஆப்ஸின் தரவை அகற்று</translation>
<translation id="8122759674786039814">உங்களுக்குக் காட்டப்படும் விளம்பரங்கள் மீதான கூடுதல் கட்டுப்பாட்டை Browther உங்களுக்கு வழங்குகிறது, அத்துடன் பிரத்தியேகமான விளம்பரங்களைக் காட்டும்போது தளங்கள் உங்களைப் பற்றி என்ன தெரிந்துகொள்ளலாம் என்பதையும் அது கட்டுப்படுத்துகிறது</translation>
<translation id="6277682530398500159">இந்தத் தளத்தை அணுக, Braveமிற்கு மைக்ரோஃபோன் அணுகல் தேவை</translation>
<translation id="6712881677154121168">பதிவிறக்கப் பிழை: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">உங்கள் சுயவிவரம் Browther இன் புதிய பதிப்பில் உள்ளதால், அதைப் பயன்படுத்த முடியாது.

சில அம்சங்கள் கிடைக்காமல் போகலாம். வேறு சுயவிவர கோப்பகத்தைக் குறிப்பிடுக அல்லது Browther இன் புதிய பதிப்பைப் பயன்படுத்துக.</translation>
<translation id="871671753163165892">பிரத்தியேகமாக்குதலையும் பிற அம்சங்களையும் பெற, இணையம் மற்றும் ஆப்ஸ் செயல்பாடு மற்றும் இணைக்கப்பட்ட Browther சேவைகளில் Braveமைச் சேர்க்கவும்</translation>
<translation id="5000832110229523807">உங்கள் கம்ப்யூட்டரில் ஏற்கனவே எல்லாப் பயனர்களுக்கும் Browther நிறுவப்பட்டுள்ளது.</translation>
<translation id="5204575479550973859">புக்மார்க்குகள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் எல்லாவற்றிலும் பெற Braveமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் Browther கணக்கில் இந்த புக்மார்க் சேமிக்கப்படும்.</translation>
<translation id="2874208284092283937">Braveமின் V8 என்ஜின் மூலம் தளங்கள் செயல்படும் வேகம் அதிகரிக்கும், ஆனால் தாக்குதல்களை Browther எதிர்க்கும் திறன் சற்று குறைந்து காணப்படும். இந்த அமைப்பு ஆன் செய்யப்பட்டுள்ளது.</translation>
<translation id="3268577459683869744">{count,plural, =1{உங்கள் Browther தரவுகளில் சில உங்கள் Browther கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறும் முன் சில நிமிடங்கள் காத்திருக்கவும். நீங்கள் இப்போதே வெளியேறினால் இந்தத் தரவு (1 தரவு) நீக்கப்படும்.}other{உங்கள் Browther தரவுகளில் சில உங்கள் Browther கணக்கில் இன்னமும் சேமிக்கப்படவில்லை. வெளியேறும் முன் சில நிமிடங்கள் காத்திருக்கவும். இப்போதே வெளியேறினால் இந்தத் தரவு ({count} தரவுகள்) நீக்கப்படும்.}}</translation>
<translation id="7683816018918395929">இந்த ஃபைல் ஆபத்தானதாக இருக்கக்கூடும் என்பதால் இதை ஸ்கேன் செய்யுமாறு Browther பரிந்துரைக்கிறது.</translation>
<translation id="1547295885616600893">கூடுதல் <ph name="BEGIN_LINK_CROS_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_CROS_OSS"/> மூலம் ChromeOS உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="6831043979455480757">Translate</translation>
<translation id="2142653375108595728">கடவுச்சொற்கள் பாதுகாப்பை இழக்கும்பட்சத்தில் அவற்றை Browther உங்களுக்குத் தெரியப்படுத்தும்</translation>
<translation id="684888714667046800">இணையத்துடன் இணைக்க முடியவில்லை. ஃபயர்வாலைப் பயன்படுத்தினால் ஃபைல் ஏற்புப் பட்டியலில் <ph name="PRODUCT_EXE_NAME"/> இருப்பதை உறுதிசெய்துகொள்ளவும்.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">தொடர தட்டவும்</translation>
<translation id="6862030660799253820">படத் தேடல் அம்சம் மூலம் இந்தப் படத்தைத் தேடுங்கள்</translation>
<translation id="3860339351709082396">"<ph name="EXTENSION_NAME"/>" நீட்டிப்பில் மால்வேர் இருப்பதை Browther கண்டறிந்துள்ளது</translation>
<translation id="6877155553248388166">தேடல் பகுதியின் கீழ் வலது மூலை: வலது <ph name="RIGHT"/>%, கீழ் <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">நகலெடு</translation>
<translation id="7804113502310231166">Braveமை இயல்பு பிரவுசராக அமைத்து செயல் பட்டியில் பின் செய்யுங்கள்</translation>
<translation id="3228374215117173004">&amp;Browther சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="6934579572334859869">இந்தப் படம் பற்றி படத் தேடல் அம்சத்திடம் கேளுங்கள்</translation>
<translation id="5995328366516663808">Braveமின் <ph name="BOOKMARK_LIMIT"/> புக்மார்க்குகள் என்ற வரம்பை அடைந்துவிட்டதால், உங்களின் சில புக்மார்க்குகள் இன்னும் உங்கள் Browther கணக்கில் சேமிக்கப்படவில்லை.

சில புக்மார்க்குகளை நீக்கும் வரை உங்கள் கணக்கில் புதிய புக்மார்க்குகளைச் சேமிக்க முடியாது. இப்போது வெளியேறினால், சேமிக்கப்படாத புக்மார்க்குகள் நீக்கப்படும்.</translation>
<translation id="6965382102122355670">சரி</translation>
<translation id="4533562834763015352">வலுவற்ற கடவுச்சொற்களை யூகிப்பது எளிது என்பதால் <ph name="BEGIN_LINK"/>வலிமையான கடவுச்சொற்களை உருவாக்கவும் நினைவில்கொள்ளவும்<ph name="END_LINK"/> Braveமை அனுமதியுங்கள்.</translation>
<translation id="3453763134178591239">ChromeOS விதிமுறைகள்</translation>
<translation id="5379058926689137454">இந்தத் தளத்திற்காக மைக்ரோஃபோனை அணுக Braveமுக்கு அனுமதி தேவை</translation>
<translation id="4684462982894889021">உங்கள் கணக்கில் (<ph name="ACCOUNT_EMAIL"/>) உள்ள Browther தரவைப் பயன்படுத்தவும் சேமிக்கவும் உங்கள் கடவுச்சொற்றொடரை வழங்கவும்</translation>
<translation id="7011190694940573312">ஆப்ரேட்டிங் சிஸ்டத்தின் இந்தப் பதிப்பு ஆதரிக்கப்படாததால் நிறுவ முடியவில்லை.</translation>
<translation id="7024536598735240744">தொகுக்கப்படாத பிழை: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">நிறுவல் நிறுத்தப்பட்டது.</translation>
<translation id="8257174622576051374">Braveமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="7047386856539490735">இந்த முடிவுகள் பயனுள்ளவையாக உள்ளனவா?</translation>
<translation id="1772745060691790742">Braveஐப் புதுப்பி</translation>
<translation id="4937970118065051027">ஒரு படத்திற்குப் பயனுள்ள விளக்கம் இல்லாதபட்சத்தில் Browther உங்களுக்காக அதை வழங்க முயலும். விளக்கங்களை உருவாக்குவதற்காக படங்கள் Braveளுக்கு அனுப்பப்படும்.</translation>
<translation id="1594112132009288601">Browther for Testing உலாவியைப் பிரத்தியேகமாக்கு</translation>
<translation id="5915000938288527952">மெசேஜ்கள், ஆவணங்கள் மற்றும் பிற ஆப்ஸில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Braveமைப் பயன்படுத்தலாம்</translation>
<translation id="8775664994493381735"><ph name="EXTENSION_NAME"/> நீட்டிப்பை Braveமில் இருந்து அகற்றும்</translation>
<translation id="3276648807841991013">Browther தரவு <ph name="TIMEOUT_DURATION"/> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை நீக்கிவிடும். இதில் பதிவு, தன்னிரப்பி, பதிவிறக்கங்கள் ஆகியவை அடங்கலாம்.</translation>
<translation id="4725226878394159809">இந்தத் தளத்தை அணுக, Braveமிற்கு கேமரா அணுகல் தேவை</translation>
<translation id="8931474625901592021">Braveஐத் தொடங்க முடியவில்லை. மீண்டும் முயலவும்.</translation>
<translation id="8242947409070121799">Browther உலாவியால் உங்கள் கடவுச்சொற்களைச் சரிபார்க்க முடியவில்லை. 24 மணிநேரத்திற்குப் பிறகு முயலவும்.</translation>
<translation id="1737922827960215472">எந்த நேரத்திலும் Braveமிற்கு விரைவாகச் செல்ல அதை Dockகில் வைத்திருக்கவும்</translation>
<translation id="335855266303176628">மெசேஜ்கள், ஆவணங்கள், பிற ஆப்ஸ் ஆகியவற்றில் உள்ள இணைப்புகளைக் கிளிக் செய்யும்போதெல்லாம் Browther உலாவியைப் பயன்படுத்தலாம்</translation>
<translation id="709455597778444012">செயல் நிர்வாகி - Browther</translation>
<translation id="7147140345767587643">Browther உத்தேசமாகக் கணித்துள்ள உங்கள் ஆர்வங்கள்</translation>
<translation id="7337408274890534789">உடனடியாக பிரவுசிங் செய்யத் தொடங்குங்கள்: Windows தொடங்கும்போதே Braveமை இப்போது தொடங்கலாம்.</translation>
<translation id="7274695763216404502">பின் செய்யப்பட்டது! கருவிப்பட்டியில் இருந்து படத் தேடலை மீண்டும் பயன்படுத்தலாம்</translation>
<translation id="7288567540154601580">பக்கங்களும் நீட்டிப்புகளும்</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{இதை அகற்றும்படி Browther பரிந்துரைக்கிறது}other{இவற்றை அகற்றும்படி Browther பரிந்துரைக்கிறது}}</translation>
<translation id="1527644038571473502">சிஸ்டம் ஆடியோவைப் பகிர, சிஸ்டம் அமைப்புகளைத் திறந்து Braveமிற்கு 'சிஸ்டம் ஆடியோ ரெக்கார்டிங் மட்டும்' என்பதை அனுமதியுங்கள். Braveமை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="1427913074981060872">நீங்கள் பார்க்கும் தளங்களில் உள்ள விளம்பரங்களின் செயல்திறனை அளவிட உதவக்கூடிய தகவல்களை Braveமிடம் அந்தத் தளங்கள் கோர விளம்பர அளவீடு அனுமதிக்கிறது. தளங்களுக்கிடையே முடிந்தவரை மிகவும் குறைவான தகவல்களை அனுப்பி, பலதளக் கண்காணிப்பை விளம்பர அளவீடு கட்டுப்படுத்துகிறது.</translation>
<translation id="1657652725060525338">Braveஐப் புதுப்பிக்கிறது</translation>
<translation id="884846289464870238">உங்கள் விருப்பத்தேர்வுகளின் ஃபைல் சிதைவடைந்துள்ளது அல்லது தவறானது.

உங்கள் அமைப்புகளை Browther ஆல் மீட்டெடுக்க முடியவில்லை.</translation>
<translation id="7339898014177206373">புதிய சாளரம்</translation>
<translation id="633044855886370183">உங்களின் இணையம், புக்மார்க்குகள் மற்றும் பிற Browther உருப்படிகள் இங்கே உள்ளன.</translation>
<translation id="1185960088713242527">உங்கள் கடவுச்சொற்றொடரை வைத்திருப்பவர்கள் மட்டுமே என்க்ரிப்ட் செய்யப்பட்ட உங்கள் தரவைப் படிக்க முடியும். கடவுச்சொற்றொடர் Braveளுக்கு அனுப்பப்படாது, அதை Browther சேமிக்காது. கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ <ph name="BEGIN_LINK"/>உங்கள் கணக்கில் உள்ள Browther தரவை நீக்க<ph name="END_LINK"/> வேண்டும்.</translation>
<translation id="7125151836477182110"><ph name="ALTERNATIVE_BROWSER_NAME"/> மூலம் <ph name="TARGET_URL_HOSTNAME"/> இணைப்பைப் பார்ப்பதற்கு உங்கள் சிஸ்டம் நிர்வாகி Braveமை உள்ளமைத்துள்ளார்.</translation>
<translation id="7352651011704765696">ஏதோ தவறு ஏற்பட்டது</translation>
<translation id="6638123710106659002">இனிவரும் Browther புதுப்பிப்புகளைப் பெற macOS 13 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்தக் கம்ப்யூட்டர் macOS 12 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7286289384512061761">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> ஆகிய அனுமதிகளை Browther அகற்றிவிட்டது.</translation>
<translation id="113593073175678746">இந்த நீட்டிப்பு இனி ஆதரிக்கப்படாது. அதனால், இதை அகற்றும்படி Browther பரிந்துரைக்கிறது.</translation>
<translation id="137615076640044304">விட்ட இடத்திலிருந்து தொடரலாம்: நீங்கள் ஒவ்வொரு முறை மீண்டும் தொடங்கும்போதும் Browther உங்கள் பக்கங்களை மீட்டெடுக்கிறது. இதை ஆஃப் செய்ய, இதற்குச் செல்லவும்:</translation>
<translation id="5967238175620483220">Braveமிற்குக் கடவுச்சொற்களைப் பதிவேற்றுதல்</translation>
<translation id="4719434010343478165"><ph name="PAGE_TITLE"/> - டெவெலப்பர்களுக்கான Browther</translation>
<translation id="7450541714075000668">உரை நகலெடுக்கப்பட்டது</translation>
<translation id="7766009218653304791">இந்தத் தளத்திற்காகக் கேமராவை அணுக Braveமுக்கு அனுமதி தேவை</translation>
<translation id="5844418066487488520">மைக்ரோஃபோனைப் பயன்படுத்த, Braveமிற்கு <ph name="BEGIN_LINK"/>சிஸ்டம் அமைப்புகளில்<ph name="END_LINK"/> அணுகலை வழங்குங்கள்</translation>
<translation id="8065480549334161841">இனிவரும் Browther புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புத் தேவை. இந்தக் கம்ப்யூட்டர் Windows 7 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="6299293759264950896">Braveமை மீண்டும் தொடங்கவா?</translation>
<translation id="180908550381040105">தற்போது இயக்கத்தில் உள்ள அதே பதிப்புள்ள Braveமை நிறுவ முடியாது. Braveமை மூடி, பின்னர் முயலவும்.</translation>
<translation id="7625576878150380853">நீங்கள் Braveமில் உள்நுழைந்திருக்கும் போதெல்லாம் உங்கள் Browther கணக்கில் கடவுச்சொற்களையும் இன்னும் பலவற்றையும் சேமித்துப் பயன்படுத்தலாம். <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">தளங்கள் எதிர்பார்த்தபடி செயல்படும். ஆனால், Browther சாளரங்கள் அனைத்தையும் மூடும்போது பெரும்பாலான தளங்களில் (Braveமில் உள்நுழைந்திருந்தால் உங்களின் Browther கணக்கைத் தவிர) இருந்து வெளியேறிவிடுவீர்கள்.</translation>
<translation id="7099370564362681943">{0,plural, =1{ஒரு நிமிடத்தில் Browther மீண்டும் தொடங்கும்}other{# நிமிடங்களில் Browther மீண்டும் தொடங்கும்}}</translation>
<translation id="3602613943932672197">உங்கள் தரவைப் பாதுகாக்க, நீங்கள் சமீபத்தில் பார்வையிடாத தளங்களில் உள்ள அனுமதிகளை அகற்ற Braveமை அனுமதிக்கலாம்.</translation>
<translation id="8759568213742229377">உடனடியாக உலாவத் தொடங்க Braveமைத் தானாகவே தொடங்கலாம்.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> நிறுவி</translation>
<translation id="8991800242749014880">Browther உங்கள் கேமராவையும் மைக்ரோஃபோனையும் பயன்படுத்துகிறது.</translation>
<translation id="2692328388439821508">Browther இன்னும் சிறப்படைந்துள்ளது</translation>
<translation id="4318444066563223295">Braveமில் இப்போது உங்களுக்குக் கூடுதல் அம்சங்கள் கிடைக்கும்</translation>
<translation id="7649070708921625228">உதவி</translation>
<translation id="5591287320769313116">உங்களுக்காக Browther தேடட்டும்</translation>
<translation id="7658239707568436148">ரத்து செய்</translation>
<translation id="6325482130534634729">Browther, உங்கள் இயல்புநிலை உலாவியாக இல்லை</translation>
<translation id="8185915921134219287">உங்கள் எல்லாச் சாதனங்களிலும் Braveஐ ஒத்திசைக்கலாம், தனிப்பயனாக்கலாம்</translation>
<translation id="5120421624925726813">Browther புதுப்பிப்பு</translation>
<translation id="7716950018788545737">பணிகள் முடிந்தன.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> பிரவுசருக்கு சிஸ்டம் டிரேஸிங் சேவைகளை வழங்கும். இந்தச் சேவை முடக்கப்பட்டால், பிரவுசர் உருவாக்கும் செயல்பாட்டு டிரேஸ்களில் கண்டக்ஸ்ட் சுவிட்ச், ரெடி த்ரட் நிகழ்வுகளைப் போன்ற, சிஸ்டம் முழுமைக்குமான நிகழ்வுகள் சேர்க்கப்படாது.</translation>
<translation id="6542096191573265107">வெளியேறினால், இந்தச் சாதனத்திலிருந்து நீங்கள் உலாவிய தரவு நீக்கப்படும். பின்னர் தரவை மீட்டமைக்க, Braveல் <ph name="USER_EMAIL"/> எனும் முகவரியின் மூலம் உள்நுழையவும்.</translation>
<translation id="7747138024166251722">தற்காலிக டைரக்டரியை நிறுவியால் உருவாக்க முடியவில்லை. வட்டு இடம் காலியாக உள்ளதா, மென்பொருளை நிறுவுவதற்கு தகுந்த அனுமதி உள்ளதா என்பதை சரிபார்க்கவும்.</translation>
<translation id="351575328720488268">இயல்பு Braveமிற்கு மீட்டமை</translation>
<translation id="1054170408395182418">Braveமை இயல்பு பிரவுசராக அமைத்து செயல் பட்டியில் பின் செய்யும்</translation>
<translation id="4569594230301902490">Braveமை விரைவாக்குகிறது</translation>
<translation id="5525298466557654312"><ph name="PAGE_TITLE"/> - Browther Canary</translation>
<translation id="7893465573639396635">உங்கள் இன்டர்நெட் டிராஃபிக்கிற்கான அணுகல் உள்ளவர்களுக்கு நீங்கள் பார்க்கும் தளங்களைத் தெரிந்துகொள்வதைக் கடினமாக்குகிறது. DNSஸில் (Domain Name System - டொமைன் பெயர் சிஸ்டம்) ஒரு தளத்தின் IP முகவரியைத் தேட Browther பாதுகாப்பான இணைப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7810005234485217901">எளிதாக அணுக படத் தேடலைப் பின் செய்யலாம்</translation>
<translation id="2462631024103158515">இந்தக் கணக்கின் மூலம் ஏற்கெனவே ஒரு Browther சுயவிவரம் இந்தச் சாதனத்தில் உருவாக்கப்பட்டுள்ளது</translation>
<translation id="7845233973568007926">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME"/> ஐப் பயன்படுத்துவதற்கு முன் கம்ப்யூட்டரை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="311190437086049332">Braveமைப் பிரத்தியேகமாக்கி அதற்குப் புதிய தோற்றத்தைக் கொடுக்கலாம்</translation>
<translation id="6728847658878265103">Browther சமீபத்திய பதிப்பிற்குப் புதுப்பிக்கப்படவில்லை என்பதால், புதிய அம்சங்களையும் பாதுகாப்புத் திருத்தங்களையும் தவறவிடுகிறீர்கள்.</translation>
<translation id="7872446069773932638">பதிவிறக்குகிறது... <ph name="SECONDS"/> வினாடிகள் மீதமுள்ளன</translation>
<translation id="5374532739787768601">கடவுச்சொற்றொடரை மறந்துவிட்டாலோ இந்த அமைப்பை மாற்ற விரும்பினாலோ <ph name="BEGIN_LINK"/>உங்கள் கணக்கில் உள்ள Browther தரவை நீக்குங்கள்<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">இந்தப் படம் பற்றிக் கேளுங்கள்</translation>
<translation id="9172499982238113829">Braveமை இயல்பு உலாவியாக அமை</translation>
<translation id="3313826726620159669">சாத்தியமான சூழல்களில் பாதுகாப்பற்ற இணைப்புகளை Browther தானாகவே HTTPSஸாக மேம்படுத்தும்</translation>
<translation id="3317928686912559532">Braveமில் <ph name="USER_EMAIL_ADDRESS"/> ஆக உள்நுழைந்திருந்தீர்கள். மீண்டும் உள்நுழைய அதே கணக்கைப் பயன்படுத்தவும்.</translation>
<translation id="6007009085341946457">இது Browther இன் இரண்டாம் நிலை நிறுவல் என்பதால், அதை இயல்புநிலை உலாவியாக அமைக்க முடியாது.</translation>
<translation id="8004582292198964060">உலாவி</translation>
<translation id="8010081455002666927">தானியங்குக் கண்டறிதல்</translation>
<translation id="174885789898161653">Braveமுக்கு அணுகல் கிடைத்தவுடன், இணையதளங்கள் உங்களிடம் அணுகலைக் கோர முடியும்.</translation>
<translation id="3001754454174546602">எந்த நேரத்திலும் Braveமிற்கு விரைவாகச் செல்ல செயல் பட்டியில் அதைப் பின் செய்யவும்</translation>
<translation id="80471789339884597">நிறுவியதற்கு நன்றி. <ph name="BUNDLE_NAME"/> ஐப் பயன்படுத்துவதற்கு முன் உங்கள் அனைத்து உலாவிகளையும் மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="8054112667659782652">படத் தேடலுக்கான ஷார்ட்கட்டை எப்போதும் காட்டு</translation>
<translation id="6993312779622863465">ஆப்ஸிற்காக Browther பின்புலத்தில் இயங்குவதை முடக்கு</translation>
<translation id="80790299200510644">படத் தேடல்</translation>
<translation id="8086881907087796310">குறைந்தபட்ச வன்பொருள் தேவைகளை உங்கள் கம்ப்யூட்டர் பூர்த்திசெய்யவில்லை என்பதால் நிறுவ முடியவில்லை.</translation>
<translation id="4734875482699037091"><ph name="PAGE_TITLE"/> - Browther for Testing</translation>
<translation id="543407324609820492">இந்தத் தளத்தை அணுக, Braveமிற்கு இருப்பிட அணுகல் தேவை</translation>
<translation id="1767887552863788514">அடுத்த முறை உங்கள் <ph name="DEVICE_TYPE"/> சாதனத்தில் Braveமைத் திறக்கும்போது, விலைக் கண்காணிப்பு விழிப்பூட்டல்களை ஆன் செய்யும்படி ஓர் அறிவிப்பு காட்டப்படும்.</translation>
<translation id="8118331347066725040">Lens மூலம் தேடுதல் குறித்த கருத்தை அனுப்புக</translation>
<translation id="5334309298019785904">உங்கள் டொமைனில் ஒத்திசைவு இல்லாததால் உங்கள் தரவை ChromeOSஸால் ஒத்திசைக்க முடியவில்லை.</translation>
<translation id="813913629614996137">துவக்குகிறது...</translation>
<translation id="4879101934056397619">Browther கூடுதல் சேவை விதிமுறைகள்</translation>
<translation id="4505690237431768764">இந்த ஃபைல் ஆபத்தானது என்பதால், அதை Browther தடுத்துள்ளது.</translation>
<translation id="8177472873527554730">பக்கத்தில் உள்ளடக்கத்தைக் கண்டறிய முடியவில்லை</translation>
<translation id="4720341280133158605">உங்கள் கணக்கில் (<ph name="USER_EMAIL"/>) உள்ள Browther தரவைப் பயன்படுத்தவும் சேமிக்கவும் உங்கள் கடவுச்சொற்றொடரை வழங்கவும்</translation>
<translation id="8221491193165283816">பொதுவாக அறிவிப்புகளைத் தடுத்துள்ளீர்கள். இந்தத் தளம் அறிவிப்புகளை வழங்கச் செய்ய, இங்கே கிளிக் செய்யவும்.</translation>
<translation id="1083711467946065278">கேமராவைப் பயன்படுத்த, Braveமிற்கு <ph name="BEGIN_LINK"/>சிஸ்டம் அமைப்புகளில்<ph name="END_LINK"/> அணுகலை வழங்குங்கள்</translation>
<translation id="6569785137733211804">இந்த நீட்டிப்பு எங்கிருந்து பெறப்பட்டது என்பதை Braveமால் சரிபார்க்க முடியவில்லை மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="1122818205373648656">ஒரு படத்திற்குப் பயனுள்ள விளக்கம் இல்லாதபட்சத்தில் Browther உங்களுக்காக அதை வழங்க முயலும். விளக்கங்களை உருவாக்குவதற்காக படங்கள் Braveளுக்கு அனுப்பப்படும். அமைப்புகளுக்குச் சென்று எப்போது வேண்டுமானாலும் இதை முடக்கலாம்.</translation>
<translation id="6877990294324319801">Braveமில் புதிய சுயவிவரத்தில் உள்நுழைய வேண்டுமா?</translation>
<translation id="6478811748813986578">பாதுகாப்பற்ற தளங்கள் மற்றும் பதிவிறக்கங்கள் குறித்து <ph name="BEGIN_LINK"/>Browther உங்களை எச்சரிக்கும்<ph name="END_LINK"/></translation>
<translation id="1685486387921540822">இந்தத் தளத்தை நீங்கள் சமீபத்தில் பார்க்கவில்லை. <ph name="PERMISSION"/> அனுமதியை Browther அகற்றிவிட்டது.</translation>
<translation id="8921153410460268589">நீங்கள் பார்ப்பவற்றை உங்கள் கேமரா மூலம் Browther iOS ஆப்ஸில் ஷாப்பிங் செய்யலாம், மொழிபெயர்க்கலாம், அடையாளம் காணலாம்</translation>
<translation id="8313851650939857356">துவக்கப் பிழை: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">Browther <ph name="TIMEOUT_DURATION"/> பயன்படுத்தப்படாமல் இருந்தால் உங்கள் நிறுவனம் அதை மூடிவிடும்.</translation>
<translation id="8321888067342493336">படமாகச் சேமி</translation>
<translation id="143016831128278157">உங்கள் எல்லாச் சாதனங்களிலும் Braveஐ ஒத்திசைக்க மற்றும் தனிப்பயனாக்க, உள்நுழையவும்</translation>
<translation id="4784945022248750283"><ph name="USER_EMAIL_ADDRESS"/> ஏற்கனவே Braveஐப் பயன்படுத்திக் கொண்டிருந்தது</translation>
<translation id="1288164710697017468">உங்கள் Browther கணக்கில் (<ph name="ACCOUNT_EMAIL"/>) உள்ள Browther தரவைத் தொடர்ந்து பயன்படுத்த Braveமைப் புதுப்பிக்கவும்</translation>
<translation id="8648401677359150296">இனிவரும் Browther புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்பு தேவை. இந்தக் கம்ப்யூட்டர் Windows 8 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="8362914115861174987">இதற்கு மொழிபெயர்க்கும்:</translation>
<translation id="8367705492654390392">எதை வேண்டுமானாலும் கேளுங்கள்</translation>
<translation id="5769022907892823357">கடவுச்சொற்கள் மற்றும் பலவற்றை உங்கள் சாதனங்கள் அனைத்திலும் பெற Braveமில் உள்நுழையுங்கள். நீங்கள் உள்நுழைந்த பிறகு உங்கள் Browther கணக்கில் இந்தக் கடவுச்சொல் சேமிக்கப்படும்.</translation>
<translation id="4782442810031768771">Braveமை மீண்டும் தொடங்க வேண்டும்.</translation>
<translation id="8265348385714408341">இதை அகற்றும்படி Browther பரிந்துரைக்கிறது. <ph name="BEGIN_LINK"/>ஆதரிக்கப்படும் நீட்டிப்புகள் குறித்து மேலும் தெரிந்துகொள்ளுங்கள்.<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">இந்த நீட்டிப்பின் வெளியீடு அதன் டெவெலப்பரால் நிறுத்தப்பட்டது, மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="1613655732912855341">இது நீங்கள்தான் என்பதை Browther உறுதிசெய்ய வேண்டும். அதன் பிறகே, உங்கள் Browther கணக்கில் தரவைச் சேமித்து அதை எல்லாச் சாதனங்களிலும் உங்களால் பயன்படுத்த முடியும். இப்போது வெளியேறினால் இந்தத் தரவு நீக்கப்படும்.</translation>
<translation id="9103715009358215214">{0,plural, =1{ஒரு நாளுக்குள் Braveமை மீண்டும் தொடங்கவும்}other{# நாட்களுக்குள் Braveமை மீண்டும் தொடங்கவும்}}</translation>
<translation id="8438543370129609977">படத் தேடல் அம்சத்தைப் பயன்படுத்தும்போது பக்கத் தலைப்பு, URL, PDFகள் உள்ளிட்ட உள்ளடக்கம் ஆகியவை சேவையகத்திற்கு அனுப்பப்படும். <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">Braveமில் படத் தேடல் மூலம் தேடுவது குறித்து மேலும் தெரிந்துகொள்ளலாம்</translation>
<translation id="1401757916223057494">நிறுவி காப்பகம் சிதைந்துள்ளது அல்லது தவறானது. Braveமை மீண்டும் பதிவிறக்கவும்.</translation>
<translation id="5029760494698649486">Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புகளில் மட்டுமே Browther இயங்கும்.</translation>
<translation id="7906734902028783072">விருப்பத்திற்குரியது: பிழை அறிக்கைத் தரவு, உபயோகத் தரவு ஆகியவற்றை Braveளுக்குத் தானாக அனுப்புவதன் மூலம் ChromeOS அம்சங்களையும் செயல்திறனையும் மேம்படுத்த உதவுங்கள்.</translation>
<translation id="6791756730901393492">உங்கள் Browther கணக்கில் உள்ள Browther தரவைப் பயன்படுத்துவதற்கும் சேமிப்பதற்கும் இது நீங்கள்தான் என்பதை உறுதிப்படுத்தவும்</translation>
<translation id="4879869745782826167">Braveமில் உள்நுழைவதற்கான அறிவிப்புகளைக் காட்டும்</translation>
<translation id="2967761098021401720">Browther காலாவதியானது</translation>
<translation id="7674832651694000881">Braveமை இயல்பு பிரவுசராகத் தேர்வுசெய்ததற்கு நன்றி!</translation>
<translation id="4507581730979762077">உங்கள் கடவுச்சொற்களை நீங்கள் சேமிக்கும்போது Browther உலாவியால் அவற்றைச் சரிபார்க்க முடியும்</translation>
<translation id="7205233182271132386">உங்கள் கடவுச்சொற்களில் ஒன்று பொதுவான தரவு மீறலுக்கு உட்பட்டிருப்பதாக Browther கண்டறிந்தால் அதுகுறித்து எச்சரிக்கையைப் பெறுவீர்கள்</translation>
<translation id="8555465886620020932">சேவைப் பிழை: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">எளிதாக அணுக படத் தேடலைப் பின் செய்யலாம். இதற்கு, பக்கவாட்டு பேனலின் மேற்புறத்தில் உள்ள 'பின் செய்' பட்டனைக் கிளிக் செய்யவும்.</translation>
<translation id="856656450041460113">மொழிப் பட்டியலைத் தேடும்</translation>
<translation id="75470458211269379">Browther கணக்கைப் பயன்படுத்தி நீங்கள் உள்நுழையும்போது Browther உங்கள் கடவுச்சொற்களைச் சரிபார்க்க முடியும்</translation>
<translation id="2108930010779660436">Braveமைப் பல நிறுவனங்கள் நிர்வகிக்கின்றன</translation>
<translation id="7209630341463003999">பதிப்புரிமை <ph name="YEAR"/> Browther உருவாக்குநர்கள். அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.</translation>
<translation id="8601359445272098721">புதிது! “திரையை மொழிபெயர்” என்ற பட்டனைத் தேர்ந்தெடுப்பதன் மூலம் திரையில் உள்ள வார்த்தைகளையும் படங்களையும் மொழிபெயர்க்கலாம்</translation>
<translation id="782928371899183269">Braveமைத் தொடங்குகிறது...</translation>
<translation id="8624541899164515475">அமைப்புகள், புதிய பக்கத்தில் திறக்கும்.</translation>
<translation id="5879341334716115002">Browther for Testingகை உங்கள் இயல்பு உலாவியாக அமைக்க முடியாது.</translation>
<translation id="2433912322225810055">Braveமைத் தொடங்கும்போது அல்லது ஆம்னிபாக்ஸிலிருந்து தேடலை மேற்கொள்ளும்போது காண்பிக்கப்படும் பக்கத்தையும் இது கட்டுப்படுத்துகிறது.</translation>
<translation id="4816541973978692496">இது உங்கள் Browther ஆகும்</translation>
<translation id="8712637175834984815">புரிந்தது</translation>
<translation id="9037464035997618895">Braveமில் உள்நுழைய வேண்டுமா?</translation>
<translation id="7897185368811431919">எல்லாவற்றையும் Braveமில் வைத்திருங்கள்</translation>
<translation id="8747073452963259673">தேடல் பகுதியின் கீழ் இடது மூலை: இடது <ph name="LEFT"/>%, கீழ் <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">நிறுவல் பிழை: நிறுவலைத் தடுக்கும் குழுக் கொள்கையை உங்கள் நெட்வொர்க் நிர்வாகி பயன்படுத்தியுள்ளார்: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">இந்தத் தளத்திற்காகக் கேமராவையும் மைக்ரோஃபோனையும் அணுக Braveமுக்கு அனுமதி தேவை</translation>
<translation id="8813277370772331957">பின்னர் நினைவூட்டு</translation>
<translation id="6831999464349484462">Braveமில் உள்நுழையவா?</translation>
<translation id="3698151322107951111">Braveமை இயல்பு பிரவுசராக்கி செயல் பட்டியில் பின் செய்யும்</translation>
<translation id="8826492472752484139">“Password Manager” என்பதைக் கிளிக் செய்யவும்</translation>
<translation id="6933858244219479645">ChromeOS சிஸ்டம்</translation>
<translation id="3986927308621489499">Braveமில் மெனுக்கள், அமைப்புகள், விழிப்பூட்டல்கள் மற்றும் பிற வார்த்தைகளைக் காட்ட இந்த மொழி பயன்படுத்தப்படும்.</translation>
<translation id="8862326446509486874">கம்ப்யூட்டர்-சார்ந்த நிறுவலுக்கான முறையான உரிமைகள் உங்களிடம் இல்லை. அதனால் நிர்வாகியாக மீண்டும் நிறுவலை இயக்க முயற்சி செய்க.</translation>
<translation id="5318226144018267261">Browther சுயவிவரத்தைச் சேர்</translation>
<translation id="1298790608554316415">அவ்வாறு மாற்றியிருந்தால், புதிய கடவுச்சொல்லுடன் பொருந்தும் வகையில் நீங்கள் சேமித்திருக்கும் கடவுச்சொல்லை Braveமில் திருத்தவும்.</translation>
<translation id="960933321883777733">Braveமில் உள்நுழையும்படி உங்கள் நிறுவனம் வலியுறுத்துகிறது</translation>
<translation id="948979409756947611">Browther கடவுச்சொற்களைக் காண்பிக்க முயற்சிக்கிறது. இதை அனுமதிக்க உங்கள் Windows கடவுச்சொல்லைத் தட்டச்சு செய்யவும்.</translation>
<translation id="1418854271943945136">Browther இப்போது உங்கள் இயல்பு பிரவுசராக இல்லை. Braveமை இயல்பு பிரவுசராக அமைக்கவா?</translation>
<translation id="7228667329366610727">Braveஐப் புதுப்பிக்க முடியவில்லை</translation>
<translation id="4817697255467736794">Browther Enterprise லோகோ</translation>
<translation id="3507731466523097529">உங்கள் சுயவிவரத்தைத் திறக்கும்போது ஏதோ தவறாகிவிட்டதால் Braveமைத் தொடங்க முடியவில்லை. Braveமை மீண்டும் தொடங்கவும்.</translation>
<translation id="3234473600657230663">Browther சுயவிவரங்களை நிர்வகியுங்கள்</translation>
<translation id="8953887022581653484">மால்வேரை மறைக்கக்கூடிய பிற ஃபைல்கள் இந்தக் காப்பக ஃபைலில் இருக்கலாம் என்பதால் இந்தப் பதிவிறக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="532304972436358335">பிற Browther சேவைகளில் உள்நுழையும்போது Braveமிலும் உள்நுழை</translation>
<translation id="3425998261052065067">Browther தானாக மூடப்பட்டது</translation>
<translation id="4377377022617011492">Browther காலாவதியானது</translation>
<translation id="3247296757162889864">{0,plural, =1{ஒரு மணிநேரத்திற்குள் Browther மீண்டும் தொடங்கும்}other{# மணிநேரத்திற்குள் Browther மீண்டும் தொடங்கும்}}</translation>
<translation id="9106236359747881194">தேட வார்த்தையைத் தேர்ந்தெடுக்கவும்</translation>
<translation id="5115014198092384730">இனிவரும் Browther புதுப்பிப்புகளைப் பெற Windows 10 அல்லது அதற்குப் பிந்தைய பதிப்புத் தேவை. இந்தக் கம்ப்யூட்டர் Windows 8.1 பதிப்பைப் பயன்படுத்துகிறது.</translation>
<translation id="7129101984664345614">புதிய Browther &amp;தாவலில் இணைப்பைத் திற</translation>
<translation id="911206726377975832">உங்கள் உலாவிய தரவையும் நீக்க வேண்டுமா?</translation>
<translation id="9134482777260927479">வீட்டுப்பாட உதவி</translation>
<translation id="9148058034647219655">வெளியேறு</translation>
<translation id="1734388504720121468">விட்ட இடத்திலிருந்து தொடரலாம்: நீங்கள் ஒவ்வொரு முறை மீண்டும் தொடங்கும்போதும் Browther உங்கள் பக்கங்களை மீட்டெடுக்க முடியும். இதை ஆன் செய்ய, இதற்குச் செல்லவும்:</translation>
<translation id="8633974232736772207"><ph name="TARGET_URL_HOSTNAME"/>ஐ அணுக Browther அதை மாற்று உலாவியில் திறக்கும்படி உங்கள் சிஸ்டம் நிர்வாகி உள்ளமைத்துள்ளார்.</translation>
<translation id="1122669402846843682">Browther உதவிக்குறிப்பு: Lens மூலம் தேடுங்கள்</translation>
<translation id="595330134356385835">&amp;Braveமைப் புதுப்பிக்க மீண்டும் தொடங்கு</translation>
<translation id="4659389438500978709">Browther (mDNS-In)</translation>
<translation id="6491100124044190139">Braveமில் உள்நுழைந்திருக்கும்போது மேலும் பலவற்றைப் பெறுங்கள்</translation>
<translation id="1665840797775025867">Braveமைப் பிரத்தியேகமாக்குங்கள்</translation>
<translation id="4407047432656809023">Windows XP அல்லது Windows Vista ஆகியவற்றில் Browther இனி ஆதரிக்கப்படாது என்பதால், அது சரியாகச் செயல்படாது</translation>
<translation id="945522503751344254">கருத்தை அனுப்பு</translation>
<translation id="7620348044248809366">Braveமைப் பயன்படுத்துவது யார்?</translation>
<translation id="7299962884342109067">Braveமின் உச்சபட்சப் பாதுகாப்பைப் பெறுங்கள்</translation>
<translation id="983803489796659991">புதுப்பிப்புச் சேவையகத்தில் ஆப்ஸுக்கான ஹேஷ் தரவு எதுவும் இல்லாததால் நிறுவ முடியவில்லை.</translation>
<translation id="8775461190334353148">கணக்கு இல்லாமல் Braveமைப் பயன்படுத்து</translation>
<translation id="7146761239544860058">Browther அங்கீகரிப்பாளர்கள்</translation>
<translation id="989970834842471429">படத் தேடல் அம்சத்தின் மூலம் தேட வார்த்தைகளையோ படத்தையோ தேர்ந்தெடுக்கவும்</translation>
<translation id="6616551030373607751">இருப்பிடத்தைப் பயன்படுத்த, Braveமிற்கு <ph name="BEGIN_LINK"/>சிஸ்டம் அமைப்புகளில்<ph name="END_LINK"/> அணுகலை வழங்குங்கள்</translation>
<translation id="137466361146087520">Google Chrome பீட்டா</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">குறிப்பிடப்படாத பிழை காரணமாக நிறுவல் தோல்வியடைந்தது. Braveமை மீண்டும் பதிவிறக்கம் செய்க.</translation>
<translation id="9074842261125908635">அறியப்படாத மூலங்களில் இருந்து பெறும் நீட்டிப்புகள், ஆப்ஸ், தீம்கள் ஆகியவை உங்கள் சாதனத்திற்குத் தீங்கு விளைவிக்கக்கூடும். <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> இல் இருந்து மட்டும் இவற்றை நிறுவுமாறு Browther பரிந்துரைக்கிறது</translation>
<translation id="3593119910409528681">Browther ஆன்லைன் ஸ்டோர் கொள்கையை இந்த நீட்டிப்பு மீறுகிறது, மேலும் இது பாதுகாப்பற்றதாக இருக்கக்கூடும். நீங்கள் பார்க்கும் தளங்கள் குறித்த தரவை (உங்கள் தனிப்பட்ட தகவலும் இதில் அடங்கும்) இந்த நீட்டிப்பு அணுகாமலும், மாற்றங்கள் செய்யாமலும் இருக்க இதை Braveமில் இருந்து அகற்றவும்.</translation>
<translation id="5245976396374147971">எச்சரிக்கை: நீங்கள் உலாவியவை குறித்த தகவல்களை நீட்டிப்புகள் பதிவுசெய்வதை Braveமால் தடுக்க முடியாது. மறைநிலைப் பயன்முறையில் இந்த நீட்டிப்பை முடக்க, இந்த விருப்பத்தைத் தேர்வுநீக்கவும்.</translation>
<translation id="3629539416935660172">Browther ஐப் பாதுகாப்பானதாக்க <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> இல் பட்டியலிடப்படாத சில நீட்டிப்புகளை நாங்கள் முடக்கிவிட்டோம், மேலும் அவை உங்களுக்குத் தெரியாமல் சேர்க்கப்பட்டிருக்கலாம்.</translation>
<translation id="157534302749986451">Braveஐப் பாதுகாப்பானதாக்க, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> இல் பட்டியலிடப்படாத பின்வரும் நீட்டிப்பை முடக்கியுள்ளோம், மேலும் அது உங்களுக்குத் தெரியாமல் சேர்க்கப்பட்டிருக்கலாம்.</translation>
<translation id="3031052147361385845">Browther மறை&amp;நிலை சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="5556794247782664281">Browther மறை&amp;நிலை சாளரத்தில் இணைப்பைத் திற</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{Braveமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும்.}=1{Braveமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{Braveமின் புதிய புதுப்பிப்பு உள்ளது, மீண்டும் தொடங்கும்போது அது பயன்படுத்தப்படும். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார்}=1{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{இந்தப் புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி பரிந்துரைக்கிறார். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார்}=1{புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார். உங்கள் மறைநிலை சாளரம் மீண்டும் திறக்காது.}other{புதுப்பிப்பைப் பயன்படுத்த Braveமை மீண்டும் தொடங்கும்படி உங்கள் நிர்வாகி சொல்கிறார். உங்கள் # மறைநிலை சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="8762228142105311329">{COUNT, plural, =0 {மேம்பட்ட பாதுகாப்பு, புதுப்பிப்பைச் செயல்படுத்த நீங்கள் Browther ஐ மீள்துவக்க வேண்டும்} =1 {மேம்பட்ட பாதுகாப்பு, புதுப்பிப்பைச் செயல்படுத்த நீங்கள் Browther ஐ மீள்துவக்க வேண்டும். உங்கள் தனிப்பட்ட சாளரம் மீண்டும் திறக்காது.} other {மேம்பட்ட பாதுகாப்பு, புதுப்பிப்பைச் செயல்படுத்த நீங்கள் Browther ஐ மீள்துவக்க வேண்டும். உங்கள் # தனிப்பட்ட சாளரங்கள் மீண்டும் திறக்காது.}}</translation>
<translation id="5749154344207139683">இந்த 1 நிமிடக் கருத்தாய்வை எடுப்பதன் மூலம் தனிப்பட்டது என்பதை மேம்படுத்த உதவவும்.</translation>
<translation id="6954203250660846933">முகவரிப் பட்டியிலோ தேடல் பெட்டியிலோ நீங்கள் டைப்செய்யும்போது, சிறப்பான பரிந்துரைகளைப் பெறுவதற்காக அவற்றை உங்களின் வழக்கமான தேடல் இன்ஜினுக்கு Browther அனுப்பும். இந்த அம்சம் மறைநிலைப் பயன்முறையில் முடக்கப்பட்டிருக்கும்.</translation>
<translation id="3542179014707218534">Browther மறைநிலை</translation>
<translation id="2076355018722231995">மறைநிலைப் பயன்முறையில் உலாவும்போது, பாதுகாப்பற்ற இணைப்பைப் பயன்படுத்தி ஒரு தளத்தை ஏற்றும் முன் Browther உங்களை எச்சரிக்கும்</translation>
</translationbundle>