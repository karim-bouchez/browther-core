<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1026101648481255140">Үргэлжлүүлэн суулгах</translation>
<translation id="7099479769133613710">&amp;ChromeOS-г шинэчлэхийн тулд дахин ачаална уу</translation>
<translation id="7264054672589027446">Browther танд энэ өргөтгөлийг шалгахыг зөвлөж байна</translation>
<translation id="7848219163187166649">Сайт өөрийн хуудсан дээр холбооснуудыг нууцлалтайгаар урьдчилан ачаалахыг хүсэхэд Browther Browther-н серверүүдийг ашиглана. Энэ нь таны таниулбарыг урьдчилан ачаалсан сайтаас нуух ч Browther ямар сайтуудыг урьдчилан ачаалдгийг мэдэж авна.</translation>
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна. 

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="8837164267124113709">Таны эцэг эх Browther-н "Сайт, апп болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна</translation>
<translation id="881513728707488138">Browther таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="112640046208448578">Зүйл болон газрыг таньж, текст хуулж эсвэл орчуулна. Таныг Зурган хайлтыг ашиглахад хуудасны дэлгэцийн агшныг сервер лүү илгээнэ. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther таны өгөгдмөл хөтөч</translation>
<translation id="6580138787163923852">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK"/>Browther-д нэвтэрнэ үү<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther цэсийг товшино уу</translation>
<translation id="1157985233335035034">Саяхан сонгосон хэлнүүд</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> Browther-н ажиллах зарчмыг өөрчилж болох өргөтгөл нэмсэн.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Таны Windows-н хувилбарыг дэмждэггүй тул суулгаж чадсангүй.</translation>
<translation id="8291401179516272335">Browther-ийн тухай</translation>
<translation id="1203500561924088507">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME"/>-г ашиглахаасаа өмнө хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="1232234696885483911">Таныг Зурган хайлтыг нээхэд хуудасны гарчиг, URL болон PDF зэрэг контентыг сервер лүү автоматаар илгээнэ. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Та нэвтэрсэн байхдаа Browther-д Browther Бүртгэлээсээ нууц үг болон бусад зүйлээ ашиглах боломжтой. Үүнийг өөрчлөхийн тулд “Browther дахь таны бүртгэл” рүү очно уу.</translation>
<translation id="9034321258761608912">Энэ табыг идэвхгүй үед Browther-г хурдан байлгахын тулд санах ойг чөлөөлсөн. Та энэ сайтыг идэвхгүй болохоос үргэлж хасахаар сонгох боломжтой.</translation>
<translation id="249571811018731941">Энэ файл аюултай тул Browther энэ таталтыг блоклосон</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/>-р Gmail эсвэл YouTube зэрэг Browther-н үйлчилгээнд нэвтрэх үед та тухайн бүртгэлээр Browther-д автоматаар нэвтрэх боломжтой</translation>
<translation id="1290883685122687410">Тохируулгын алдаа: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Browther-н шинэ профайлаа тохируулах</translation>
<translation id="4437862975743821367">Browther-д Bluetooth төхөөрөмжүүдийг судлахад 
 Bluetooth-н хандалт шаардлагатай. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Хэл илрүүлэх</translation>
<translation id="1206925267243987362">Browther-н санал болгосон хөтчийн тохиргоог ашиглах</translation>
<translation id="8270483548049772782">Мөн Browther-с өгөгдөл устгах (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Бэхэлсэн! Та Зурган хайлтад самбар дээрх шинэ товчоос дахин хандах боломжтой</translation>
<translation id="1356661055722410047">Шинэ! Та дэлгэц дээрх текст, зургийн аль алиныг орчуулах боломжтой</translation>
<translation id="1383876407941801731">Хайлт</translation>
<translation id="1592588950737518481">&amp;Browther-н профайлуудыг удирдах</translation>
<translation id="1404026649028693342">ХОУ-ы горимыг үргэлж харуулах</translation>
<translation id="141901961143729572">Бодол санаагаа хуваалц</translation>
<translation id="1743952081001089298">Цонхоо хуваалцахын тулд Системийн тохиргоонд Browther-д дэлгэцийн үйлдэл бичихийг зөвшөөрнө үү.</translation>
<translation id="8627385813382688019">Browther for Testing-р тусламж авах</translation>
<translation id="1497802159252041924">Суулгалтын алдаа: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Энэ хуудсыг хамгаалагдсан байна</translation>
<translation id="7252430412915798987">Browther-н таб хуваалцах</translation>
<translation id="6388429281015199562">Browther-д нэвтрэх</translation>
<translation id="1547469039832541117">Тодруулсан ажлыг дуусгана.</translation>
<translation id="1801944307203212016">Орчин тойрны тань 3D газрын зургийг үүсгэхийн тулд таны камерт хандах зөвшөөрөл Browther-д шаардлагатай</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Энэ өргөтгөлийг дэмжихээ больсон. Browther танд үүнийг хасахыг зөвлөж байна.}other{Эдгээр өргөтгөлийг дэмжихээ больсон. Browther танд эдгээрийг хасахыг зөвлөж байна.}}</translation>
<translation id="4667068923142532753">Browther-г бэхлэх</translation>
<translation id="3006560544901646947">Browther-н аюулгүй байдлын хэрэгсэл</translation>
<translation id="686052171138185761">Browther таны Нууц үгний менежерийн өгөгдлийг устгахыг хүсэж байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="8713026329083542796">Browther-н нууцлал болон аюулгүй байдлын үндсэн хяналтуудыг шалгана уу</translation>
<translation id="1640672724030957280">Татаж байна...</translation>
<translation id="1680687534629375545">Энэ хуудасны тухай Зурган хайлтаас асуу</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/>-н нэмэлт эрхээр хангадаг.</translation>
<translation id="4243382967656566037">Эдгээр онцлогийг сайжруулахад туслахын тулд Browther таны түүнтэй хийсэн харилцан үйлдлүүдийг Browther-д илгээнэ. Энэ өгөгдлийг хянагч хүмүүс уншиж, боловсруулж мөн тэмдэглэж магадгүй.</translation>
<translation id="1722488837206509557">Энэ нь танд боломжтой төхөөрөмжүүд сонгож, тэдгээр төхөөрөмжид контент үзүүлэх боломжийг олгоно.</translation>
<translation id="6820510278633522408">Browther удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="7775028004939172516">Browther навигацуудыг HTTPS болгож сайжруулахаар оролдоно</translation>
<translation id="6963959729951758069">Browther-н өгөгдлийг устгасан</translation>
<translation id="4085139922884095932">Browther-г <ph name="REMAINING_TIME"/>-н дараа дахин эхлүүлнэ</translation>
<translation id="2586248102295515296">HTTPS боломжгүй үед Browther танд сануулалгүйгээр аюултай холболт ашиглана</translation>
<translation id="3975328336074677101">Browther-ыг арын орчинд ажиллуулах</translation>
<translation id="2497443204974841650">Browther-ыг дахин суулгах</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> оролдож байна</translation>
<translation id="4553225588627299783">Та дараагийн удаа <ph name="DEVICE_TYPE"/> дээрээ Browther-г нээхдээ Browther Нууц үгний менежерийг ашиглах сануулга харна.</translation>
<translation id="1838374766361614909">Хайлтыг арилгах</translation>
<translation id="2337233040802538155">Интернэтээр үзсэн өгөгдлөө Browther Бүртгэлдээ үлдээж, зөвхөн энэ төхөөрөмжөөс устгахын тулд <ph name="BEGIN_LINK"/>Browther-с гарна уу<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Явж байх зуураа шинэ табын бүлэг нээх эсвэл үүсгэхийн тулд утсан дээрээ Browther-г татаарай.</translation>
<translation id="2063443520349987970">Та нэвтэрсэн Browther Бүртгэлүүдээ удирдах боломжтой. Таны Browther Бүртгэлүүдийг Browther хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE"/>-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN"/>Нэмэлт мэдээлэл авах<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Зурган хайлтаар хайх</translation>
<translation id="1880677175115548835">Текст сонгох</translation>
<translation id="3183933389992069620">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн Browther-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны Browther-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME"/> руу нэгдэх болно. Та энэ мэдээллийг Browther-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа Browther-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther саадгүй гүйлгэх, видеоны фреймийн хурд зэрэг арын үйл ажиллагаа болон визуал эффектийг хязгаарласнаар батарейн цэнэгийг хэмнэнэ. <ph name="BEGIN_LINK"/>Эрчим хүч хэмнэгчийн талаар нэмэлт мэдээлэл авах<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Энэ хуудасны талаар асуух</translation>
<translation id="9128006428501241840">Browther Шинэчлэгч үйлчилгээ</translation>
<translation id="6302815314157879372">Үүнийг унтрааснаар та Gmail зэрэг Browther-н сайтуудад Browther-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="1063611196035804685">Browther ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="2873360330889594383">Танай байгууллага болох <ph name="MANAGER"/> таныг Browther-д нэвтрэхийг шаардаж байна</translation>
<translation id="4035053306113201399">Шинэчлэлтийг хэрэгжүүлэхийн тулд ChromeOS-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="2861285003831382718">Файлын төрлийг ихэвчлэн татдаггүй бөгөөд энэ нь аюултай байж магадгүй тул Browther энэ таталтыг блоклосон</translation>
<translation id="1953553007165777902">Татаж байна... <ph name="MINUTE"/> минут үлдсэн</translation>
<translation id="2080160985220483492">Browther-н зөвлөгөө: Нууц үгийг хадгалаарай</translation>
<translation id="8037497710694492565">Browther нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="7395009124247513849">Browther зарим файлыг яагаад блоклодог болохыг мэдэж авна уу, шинэ табд нээгдэнэ</translation>
<translation id="762710512520170632">Таны Browther программ хангамжийг хамгийн шинэ байлгана. Хэрэв энэ үйлчилгээг идэвхгүй болгосон эсвэл зогсоосон бол таны Browther-н программ хангамж хамгийн шинэ байхгүй бөгөөд энэ нь аюулгүй байдлын гарч болзошгүй сул эмзэг байдлыг засах боломжгүй, мөн онцлогууд ажиллахгүй байж магадгүй гэсэн үг юм. Энэ үйлчилгээг ашигладаг Browther-н программ хангамж байхгүй байхад энэ үйлчилгээ өөрийгөө устгана.</translation>
<translation id="5793588180426267429">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд Browther-д <ph name="USER_EMAIL"/>-р нэвтэрнэ үү.</translation>
<translation id="2018879682492276940">Суулгаж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="6351516710581760512">Бусад нууц үгэндээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK"/>Browther-д нэвтэрнэ үү<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Тохиргоо.</translation>
<translation id="8194525816714210105">Browther-н үйлчилгээнүүдэд илүү хувийн болгосон туршлага авахын тулд Browther-н түүхийг багтаах эсэхээ сонгоно уу</translation>
<translation id="5909559127548969159">Browther-д шинэ дүр төрх өгөхийн тулд Шинэ таб хуудсан дээрх Browther-г тусгайлан өөрчлөх товчин дээр товшино уу</translation>
<translation id="2066690553719545730">ХОУ-ы горимыг үргэлж харуулах</translation>
<translation id="3283892260110318935">Файл нь хуурамч бөгөөд таны төхөөрөмжид гэнэтийн өөрчлөлт хийж магадгүй тул Browther энэ таталтыг блоклосон</translation>
<translation id="6160571936643742128">Та дараагийн удаа Browther iOS-г нээхдээ <ph name="FEATURE_NAME"/>-г туршиж үзэхийг сануулсан сануулга харна.</translation>
<translation id="8380517409933452343">Таны Browther Бүртгэлдээ хадгалсан нууц үг болон Browther-н бусад өгөгдлийг энэ төхөөрөмжөөс хасна. Тэдгээрийг Browther-д дахин ашиглахын тулд буцаж нэвтэрнэ үү.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Browther-г 1 минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}other{Browther-г # минутын турш ашиглаагүй үед танай байгууллага интернэтээр үзсэн өгөгдлийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="2126108037660393668">Татсан файлын баталгаажуулалт амжилтгүй боллоо.</translation>
<translation id="2135919691573380097">Энэ сайтыг мэдээлэх</translation>
<translation id="2137162749895930932">Орчуулах дэлгэцийг хаах</translation>
<translation id="4283559398694996391">Сайт аюулгүй холболт ашиглахгүй байгаа бөгөөд файлыг оролдсон байж магадгүй тул Browther энэ таталтыг блоклосон</translation>
<translation id="2170098639895543546">Хуудсан дээрх дурын зүйлийг сонгоно уу</translation>
<translation id="2495182092286337191">Browther-г өөрчлөх</translation>
<translation id="2174917724755363426">Суулгаж дуусаагүй байна. Та цуцлахдаа итгэлтэй байна уу?</translation>
<translation id="4877141231724140862">Browther - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Шалгалтын алдааг шинэчлэх: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Browther-с бүртгэл хасах</translation>
<translation id="1084363153644366288">iOS-т зориулсан Browther дээрх Сайжруулсан аюулгүй хөтчийг ашиглан явж байх зуур илүү аюулгүй байгаарай</translation>
<translation id="7949164640723239455">Аюултай сайт. Browther мэдэгдлүүдийг хассан.</translation>
<translation id="2236949375853147973">Миний үйл ажиллагаа</translation>
<translation id="4536403809133456417">Хаяг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Browther-д нэвтэрнэ үү. Таныг нэвтэрсний дараа энэ хаягийг Browther Бүртгэлд тань хадгална.</translation>
<translation id="5627930103267312171">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ Browther-ыг тохируулж болно.</translation>
<translation id="2283803047247799269">Зурган хайлтаар энэ табаас хайх</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther таны хөтчийг удаашруулж буй табыг түр зогсоохыг зөвлөж байна}other{Browther таны хөтчийг удаашруулж буй табуудыг түр зогсоохыг зөвлөж байна}}</translation>
<translation id="2307973900865360088">Суурилуулагчид байлгах</translation>
<translation id="5161617112768367959">URL-г Browther-д хадгалсан аюултай сайтын жагсаалттай харьцуулж шалгадаг. Хэрэв сайт таны нууц үгийг хулгайлах гэж оролдвол эсвэл таныг аюултай файл татах үед Browther нь хуудасны контентын зэрэг URL-г Аюулгүй хайлт руу мөн илгээж болзошгүй.</translation>
<translation id="4123094831918713833">Энэ үйлдэл дараахыг хийнэ:
        <ph name="LINE_BREAKS"/>
          • Browther-н зарим тохиргоо, товчлолыг шинэчилнэ
          <ph name="LINE_BREAK"/>
          • Өргөтгөлийг идэвхгүй болгоно
          <ph name="LINE_BREAK"/>
          • Күүки болон сайтын түр зуурын бусад өгөгдлийг устгана
          <ph name="LINE_BREAKS"/>
          Хавчуурга, түүх, хадгалсан нууц үгэнд нөлөөлөхгүй.</translation>
<translation id="5456070119344236353">Та эндээс Android утсандаа дугаар илгээхийн тулд хоёр төхөөрөмжийн аль алинаас нь Browther-д нэвтэрнэ үү.</translation>
<translation id="2356070529366658676">Асуух</translation>
<translation id="2359808026110333948">Цааш</translation>
<translation id="6468415397021485143">"<ph name="EXTENSION_NAME"/>" өргөтгөл таныг Browther-д нэвтрэхийг хүсэж байна</translation>
<translation id="2558600429878197587">Аппуудын хувьд Browther-г дэвсгэрт ажиллуулахыг идэвхгүй болгох</translation>
<translation id="5295781918312989856">Энэ өргөтгөлийг <ph name="USER_EMAIL_ADDRESS"/>-р ашиглахын тулд Browther-д нэвтэрнэ үү.</translation>
<translation id="8418845734693287262">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул ChromeOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Browther-н өргөтгөл хандаж байсан}=1{1 HID төхөөрөмжид нэг эсвэл түүнээс олон Browther-н өргөтгөл хандаж байна}other{# HID төхөөрөмжид нэг эсвэл түүнээс олон Browther-н өргөтгөл хандаж байна}}</translation>
<translation id="434258293817844111">Browther-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2403703063067034158">Эхлэхэд алдаа гарлаа: одоогоор тохируулгын өөр нэг инстанс ажиллаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="5458993228789433099">Дурын аппаас холбоосыг Browther-д нээж, хөтчийг ажлын хэсэгтээ хандах боломжтой байлгаарай</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther-н хэрэгслийн<ph name="END_LINK"/> тусламжтайгаар та аюулгүй үзэх болон хяналтыг гартаа байлгах боломжтой</translation>
<translation id="2451727308784734061">Нууц үгний менежерт шуурхай очихын тулд товчлолоо ашиглана уу. Та товчлолоо компьютерын үндсэн нүүр эсвэл апп байршуулагч руугаа зөөх боломжтой.</translation>
<translation id="2280315911954332435">Browther-г удахгүй хаана</translation>
<translation id="6410820860979094113">Browther-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2513154137948333830">Дахин асаах шаардлагатай: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Зурган хайлтаар текст сонгоно уу</translation>
<translation id="7892218991241200190">Browther одоо байгаа нууц үгнүүдийг солихоор оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="8976443723926188033">Файл татахын тулд Browther-д сангийн хандалт шаардлагатай</translation>
<translation id="4131374838781785973">Browther Origin-ийн туслагч</translation>
<translation id="2575822587468774919">Зурган хайлтаар хайхыг хүссэн зүйлээ сонгоно уу</translation>
<translation id="8705561858232289221">Нууц үг болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Browther-д нэвтэрнэ үү</translation>
<translation id="437162022240011372">Browther-г үргэлжлүүлэн ашиглах</translation>
<translation id="259935314519650377">Татсан суулгагчийг завсрын санах ойд хадгалж чадсангүй. Алдаа: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Систем</translation>
<translation id="2907676829052962091">Танай байгууллага таны хавчуурга, түүх, нууц үг зэрэг интернэтээр үзсэн өгөгдлийг харж, удирдах боломжтой. Энэ нь Browther-н бусад профайл дахь интернэтээр үзсэн өгөгдлийг харах боломжгүй</translation>
<translation id="1289116577679005654"><ph name="ACCOUNT_EMAIL"/> бүртгэлдээ Browther-н өгөгдлөө ашиглах, хадгалахын тулд өөрийгөө мөн болохыг баталгаажуулна уу</translation>
<translation id="7192278346779151664">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. Browther-ыг дахин татаж авна уу.</translation>
<translation id="7724398260867885339">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, Browther-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="1679595317134614424">Browther таб</translation>
<translation id="7189168846924379421">Таны аюулгүй байдлыг сайжруулахын тулд Browther таны өгөгдлийг шифрлэх болно.</translation>
<translation id="4052643592793184278">Browther Бүртгэлээ Browther-с хасахын тулд гарна уу</translation>
<translation id="7694616023994438906">Нууц үг, хавчуурга болон бусад зүйлээ бүх төхөөрөмж дээрээ авахын тулд Browther-д нэвтэрнэ үү</translation>
<translation id="2738871930057338499">Интернэтэд холбогдох боломжгүй байна. HTTP 403 хориотой. Прокси тохируулгаа шалгана уу.</translation>
<translation id="2753623023919742414">Хайхын тулд товшино уу</translation>
<translation id="9078193405195503710">Browther-г өгөгдмөл PDF үзэгчээрээ тохируулах</translation>
<translation id="2456995288904753506">Browther стандарт автоматаар бөглөх хэсгийн орхиж болзошгүй хүндрэлтэй талбаруудыг автоматаар бөглөх боломжтой</translation>
<translation id="3271730304285122987">Энэ өргөтгөл хортой программ агуулж байгаа бөгөөд аюултай байна. Үүнийг Browther-с хассанаар энэ нь цаашид таны хувийн мэдээллийг оруулаад зочилсон сайтуудын тань өгөгдлийг харах болон өөрчлөх боломжгүй болно.</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="1427337251963884503">Таны Browther</translation>
<translation id="2816462166102338036">Зурган хайлтаар энэ видеог хай</translation>
<translation id="2841525013647267359">Дараах хэлээс орчуулах</translation>
<translation id="2846251086934905009">Суулгах үед алдаа гарлаа: Суулгагч дуусгаагүй. Суулгалтыг тасалсан.</translation>
<translation id="928966105228355994">Browther-аас устгах ...</translation>
<translation id="587805782197019018">Таныг нэвтэрсэн үед Browther дээр таны аюулгүй байдлыг хангадаг бөгөөд Browther-н бусад апп дахь таны аюулгүй байдлыг сайжруулахын тулд ашиглаж болзошгүй</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="3055995278166070443">Browther-ын тухай</translation>
<translation id="2915996080311180594">Дараа дахин эхлүүлэх</translation>
<translation id="2928420929544864228">Суулгаж дууслаа.</translation>
<translation id="70453521937551896">Таны өгөгдлийг нэвтрэх үгээр тань шифрлэдэг. Browther Бүртгэлдээ Browther-н өгөгдлөө ашиглах, хадгалахын тулд нэвтрэх үгээ оруулна уу.</translation>
<translation id="2945997411976714835">Суулгах үед алдаа гарлаа: Суулгагч явцыг эхлүүлж чадсангүй.</translation>
<translation id="3188308520233701133">iOS-т зориулсан Browther-д хадгалсан нууц үгээ ашиглан сайтад илүү хурдан нэвтрээрэй</translation>
<translation id="8145318807880784886">Хавчуурга, нууц үг, тохиргоог тусад нь байлгахын тулд Browther-н шинэ профайл нэмнэ үү.</translation>
<translation id="4330268530227888227">Танай байгууллага Browther-г удирддаг</translation>
<translation id="6488090896442998436">Browther-г шинэчилсэн байна</translation>
<translation id="300557164611864786">Хэрэв сайт таны нууц үгийг хулгайлахаар оролдох эсвэл таныг аюултай файл татах үед Browther URL-г хуудасны бага зэрэг контентын хамт Аюулгүй үзэх рүү мөн илгээж болзошгүй</translation>
<translation id="2447145782593796785">Эцэг эхийнхээ сонголтуудаар онлайн орчинд илүү аюулгүй байхын тулд Browther-д нэвтэрнэ үү</translation>
<translation id="3003694935412297923">Бүх ажил</translation>
<translation id="7554113777150891030">{count,plural, =1{Зарим өгөгдлийг таны Browther Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Browther таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг (1 зүйл) устгана.}other{Зарим өгөгдлийг таны Browther Бүртгэлд хадгалж, бүх төхөөрөмж дээр тань ашиглах боломжтой болохын өмнө Browther таныг мөн болохыг баталгаажуулах шаардлагатай байна. Хэрэв та одоо гарвал энэ өгөгдлийг ({count} зүйл) устгана.}}</translation>
<translation id="5522228731050510047"><ph name="URL"/>-г Browther-д шинэ табд нээнэ үү.</translation>
<translation id="6358780591055960280">Browther таны нууц үгсийг шалгах боломжгүй байна. Дараа дахин оролдоно уу.</translation>
<translation id="1386422761453740126">Browther-д өгөгдөл нэмэх нь ...</translation>
<translation id="3038232873781883849">Суулгахыг хүлээж байна...</translation>
