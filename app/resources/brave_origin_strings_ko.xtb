<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ko">
<translation id="1026101648481255140">설치 다시 시작</translation>
<translation id="7099479769133613710">다시 실행하여 ChromeOS 업데이트</translation>
<translation id="7264054672589027446">Brave에서는 이 확장 프로그램을 검토할 것을 권장합니다.</translation>
<translation id="7848219163187166649">사이트에서 페이지에 있는 링크를 비공개로 미리 로드해 달라고 요청하면 Brave은 Browther 서버를 사용합니다. 이렇게 하면 미리 로드된 사이트에서 사용자의 신원을 숨길 수 있지만 Brave은 어떤 사이트가 미리 로드되는지 학습하게 됩니다.</translation>
<translation id="1065672644894730302">환경설정을 읽을 수 없습니다.

일부 기능을 사용할 수 없으며 환경설정의 변경사항이 저장되지 않습니다.</translation>
<translation id="8837164267124113709">부모님이 Brave의 ‘사이트, 앱, 확장 프로그램에 대한 권한’을 사용 중지했습니다</translation>
<translation id="881513728707488138">Brave에서 비밀번호를 내보내려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="112640046208448578">사물 또는 장소를 식별하고 텍스트를 복사하거나 번역합니다. 이미지 검색을 사용하면 페이지의 스크린샷이 서버로 전송됩니다. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Brave이 기본 브라우저로 설정되어 있습니다.</translation>
<translation id="6580138787163923852">암호가 정보 유출 및 다른 보안 문제로부터 안전한지 확인하려면 <ph name="BEGIN_LINK"/>Brave에 로그인<ph name="END_LINK"/>하세요.</translation>
<translation id="1089111274164380772">Browther 메뉴를 클릭합니다</translation>
<translation id="1157985233335035034">최근에 사용한 언어</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/>에서 Browther 작동에 영향을 줄 수 있는 확장 프로그램을 추가했습니다.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">지원되지 않는 Windows 버전으로 인해 설치할 수 없습니다.</translation>
<translation id="8291401179516272335">Browther 정보</translation>
<translation id="1203500561924088507">설치해 주셔서 감사합니다. <ph name="BUNDLE_NAME"/>을(를) 사용하려면 브라우저를 다시 시작해야 합니다.</translation>
<translation id="1232234696885483911">이미지 검색을 열면 페이지 제목, URL, PDF를 포함한 콘텐츠가 서버로 자동 전송됩니다. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">로그인한 상태로 Brave에서 Browther 계정의 비밀번호 등을 사용할 수 있습니다. 이 설정을 변경하려면 'Brave의 내 계정'으로 이동하세요.</translation>
<translation id="9034321258761608912">이 탭이 비활성 상태인 동안 Brave의 속도를 빠르게 유지하기 위해 메모리를 확보했습니다. 이 사이트가 비활성 상태가 되지 않도록 항상 제외할 수 있습니다.</translation>
<translation id="249571811018731941">위험한 파일이므로 Brave에서 이 다운로드를 차단했습니다.</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> 계정으로 Gmail 또는 YouTube와 같은 Browther 서비스에 로그인하면 동일한 계정으로 Brave에 자동으로 로그인할 수 있습니다.</translation>
<translation id="1290883685122687410">설정 오류: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">새 Browther 프로필 설정</translation>
<translation id="4437862975743821367">블루투스 기기를 탐색하려면 Brave에 블루투스 액세스 권한이 필요합니다. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">언어 감지</translation>
<translation id="1206925267243987362">Browther 권장 브라우저 설정 사용</translation>
<translation id="8270483548049772782">Browther(<ph name="URL"/>)에서도 데이터 삭제</translation>
<translation id="1345251407431278948">고정되었습니다. 툴바의 새 버튼에서 이미지 검색을 다시 이용할 수 있습니다</translation>
<translation id="1356661055722410047">New! 화면의 텍스트와 이미지를 모두 번역할 수 있습니다.</translation>
<translation id="1383876407941801731">검색</translation>
<translation id="1592588950737518481">Browther 프로필 관리(&amp;M)</translation>
<translation id="1404026649028693342">AI 모드 항상 표시</translation>
<translation id="141901961143729572">의견 공유</translation>
<translation id="1743952081001089298">창을 공유하려면 시스템 설정에서 Brave의 화면 녹화를 허용하세요.</translation>
<translation id="8627385813382688019">Browther for Testing 관련 지원받기</translation>
<translation id="1497802159252041924">설치 오류: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">보호된 페이지입니다.</translation>
<translation id="7252430412915798987">Browther 탭 공유</translation>
<translation id="6388429281015199562">Brave에 로그인</translation>
<translation id="1547469039832541117">강조 표시된 작업을 종료합니다.</translation>
<translation id="1801944307203212016">Brave에서 주변 3D 지도를 만들려면 카메라 액세스 권한이 필요합니다.</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{이 확장 프로그램은 더 이상 지원되지 않습니다. Brave에서는 삭제할 것을 권장합니다.}other{이 확장 프로그램은 더 이상 지원되지 않습니다. Brave에서는 삭제할 것을 권장합니다.}}</translation>
<translation id="4667068923142532753">Browther 고정</translation>
<translation id="3006560544901646947">Brave의 안전 도구</translation>
<translation id="686052171138185761">Brave에서 비밀번호 관리자 데이터를 삭제하려고 합니다. 허용하려면 Windows 비밀번호를 입력하세요.</translation>
<translation id="8713026329083542796">Brave의 주요 개인 정보 보호 및 보안 제어 기능을 검토합니다.</translation>
<translation id="1640672724030957280">다운로드 중...</translation>
<translation id="1680687534629375545">이미지 검색에 이 페이지에 관해 질문하기</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/>에 승격된 권한을 제공합니다.</translation>
<translation id="4243382967656566037">Brave은 이러한 기능을 개선하도록 사용자와의 상호작용을 Brave에 전송합니다. 검토자가 이 데이터를 읽고 처리하고 이 데이터에 주석을 달 수 있습니다.</translation>
<translation id="1722488837206509557">이렇게 하면 사용 가능한 기기 중에서 선택하고 해당 기기에 콘텐츠를 표시할 수 있습니다.</translation>
<translation id="6820510278633522408">Brave에서 곧 인터넷 사용 기록이 삭제됩니다</translation>
<translation id="7775028004939172516">Brave에서 탐색을 HTTPS로 업그레이드하려고 시도합니다</translation>
<translation id="6963959729951758069">Browther 데이터 삭제 완료</translation>
<translation id="4085139922884095932"><ph name="REMAINING_TIME"/> 후에 Browther 다시 시작</translation>
<translation id="2586248102295515296">HTTPS를 사용할 수 없는 경우, Brave에서 경고 없이 안전하지 않은 연결을 사용합니다.</translation>
<translation id="3975328336074677101">백그라운드에서 Brave을 실행</translation>
<translation id="2497443204974841650">Browther 재설치</translation>
<translation id="1724309687045787742">Brave에서 <ph name="AUTHENTICATION_PURPOSE"/>을(를) 시도하는 중입니다.</translation>
<translation id="4553225588627299783">다음번에 <ph name="DEVICE_TYPE"/>에서 Brave을 열면 Browther 비밀번호 관리자를 사용하라는 메시지가 표시됩니다.</translation>
<translation id="1838374766361614909">검색어 지우기</translation>
<translation id="2337233040802538155">인터넷 사용 기록을 이 기기에서만 삭제하고 Browther 계정에서는 유지하려면 <ph name="BEGIN_LINK"/>Brave에서 로그아웃<ph name="END_LINK"/>하세요.</translation>
<translation id="3927415701154897844">이동 중에 새 탭 그룹을 열거나 만들려면 휴대전화에 Brave을 다운로드하세요.</translation>
<translation id="2063443520349987970">로그인된 Browther 계정을 관리할 수 있습니다. Browther 계정은 Browther 브라우저, Play 스토어, Gmail 등에서 사용됩니다. 가족 구성원 등 다른 사람을 위해 계정을 추가하고 싶다면 대신 <ph name="DEVICE_TYPE"/>에 새 사용자를 추가하세요. <ph name="LINK_BEGIN"/>자세히 알아보기<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">이미지 검색으로 검색</translation>
<translation id="1880677175115548835">텍스트 선택</translation>
<translation id="3183933389992069620">관리 계정으로 로그인하고 Browther 프로필에 대한 관리자 제어권을 부여하려고 합니다. 앱, 북마크, 방문 기록, 비밀번호 및 기타 설정 등 Browther 데이터가 <ph name="USER_NAME"/> 계정에 영구적으로 연결됩니다. 이후 이 데이터를 Browther 계정 대시보드에서 삭제할 수는 있지만 다른 계정에 연결할 수는 없습니다. 기존 Browther 데이터를 유지하려면 새 프로필을 만드는 방법이 있습니다. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Brave에서 부드러운 스크롤 및 동영상 프레임 속도 같은 시각 효과와 백그라운드 활동을 제한하여 배터리 전원을 절약합니다. <ph name="BEGIN_LINK"/>에너지 절약 모드에 관해 자세히 알아보기<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">이 페이지에 대해 질문하기</translation>
<translation id="9128006428501241840">Browther 업데이터 서비스</translation>
<translation id="6302815314157879372">이 기능을 사용 중지하면 Brave에 로그인하지 않고도 Gmail 등의 Browther 사이트에 로그인할 수 있습니다.</translation>
<translation id="1063611196035804685">Brave이 응답하지 않습니다. 다시 시작하시겠습니까?</translation>
<translation id="2873360330889594383">조직(<ph name="MANAGER"/>)에서 Brave에 로그인할 것을 요구합니다</translation>
<translation id="4035053306113201399">업데이트를 적용하려면 ChromeOS를 다시 시작해야 합니다.</translation>
<translation id="2861285003831382718">일반적으로 다운로드하지 않는 파일 형식이며 위험할 가능성이 있기 때문에 Brave에서 이 다운로드를 차단했습니다.</translation>
<translation id="1953553007165777902">다운로드 중... <ph name="MINUTE"/>분 남음</translation>
<translation id="2080160985220483492">Browther 도움말: 비밀번호 저장</translation>
<translation id="8037497710694492565">Brave에서 기본 브라우저를 확인하거나 설정할 수 없습니다.</translation>
<translation id="7395009124247513849">Brave에서 일부 파일을 차단하는 이유 알아보기, 새 탭에서 열기</translation>
<translation id="762710512520170632">Browther 소프트웨어를 최신 상태로 유지합니다. 이 서비스를 사용 중지하거나 중단하면 Browther 소프트웨어가 최신 상태로 유지되지 않습니다. 즉, 발생할 수 있는 보안 취약점이 수정되지 않고 기능이 작동하지 않을 수 있습니다. 이 서비스를 사용하는 Browther 소프트웨어가 없으면 이 서비스는 자동으로 제거됩니다.</translation>
<translation id="5793588180426267429">항목 1개가 기기에서 삭제됩니다. 나중에 데이터를 가져오려면 Brave에 <ph name="USER_EMAIL"/>(으)로 로그인하세요.</translation>
<translation id="2018879682492276940">설치할 수 없습니다. 다시 시도해 보세요.</translation>
<translation id="6351516710581760512">다른 암호가 정보 유출 및 다른 보안 문제로부터 안전한지 확인하려면 <ph name="BEGIN_LINK"/>Brave에 로그인<ph name="END_LINK"/>하세요.</translation>
<translation id="2039417478970545937">설정</translation>
<translation id="8194525816714210105">보다 맞춤설정된 Browther 서비스 환경을 사용하기 위해 Browther 방문 기록을 포함할지 선택하세요.</translation>
<translation id="5909559127548969159">새 탭 페이지에서 'Browther 맞춤설정' 버튼을 클릭하여 Brave에 새로운 디자인을 적용하세요</translation>
<translation id="2066690553719545730">AI 모드 항상 표시</translation>
<translation id="3283892260110318935">사기성 파일이며 기기에 예기치 않은 변경사항이 적용될 수 있기 때문에 Brave에서 이 다운로드를 차단했습니다.</translation>
<translation id="6160571936643742128">다음번에 Browther iOS를 열면 <ph name="FEATURE_NAME"/> 기능을 사용해 보라는 메시지가 표시됩니다.</translation>
<translation id="8380517409933452343">Browther 계정에 저장된 비밀번호 및 기타 Browther 데이터가 이 기기에서 삭제됩니다. Brave에서 다시 사용하려면 다시 로그인하세요</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Brave을 1분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 탭이 열린 상태로 유지됩니다.}other{Brave을 #분 동안 사용하지 않으면 조직에서 인터넷 사용 기록을 자동으로 삭제합니다. 여기에는 방문 기록, 자동 완성, 다운로드가 포함될 수 있습니다. 탭이 열린 상태로 유지됩니다.}}</translation>
<translation id="2126108037660393668">다운로드한 파일을 확인할 수 없습니다.</translation>
<translation id="2135919691573380097">이 사이트 신고</translation>
<translation id="2137162749895930932">번역 화면 닫기</translation>
<translation id="4283559398694996391">사이트에서 보안 연결을 사용하고 있지 않으며 파일이 조작되었을 가능성이 있기 때문에 Brave에서 이 다운로드를 차단했습니다.</translation>
<translation id="2170098639895543546">페이지에서 항목 선택</translation>
<translation id="2495182092286337191">Browther 맞춤설정</translation>
<translation id="2174917724755363426">설치가 완료되지 않았습니다. 취소하시겠습니까?</translation>
<translation id="4877141231724140862">Browther - 네트워크 로그인 - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">업데이트 확인 오류: <ph name="UPDATE_CHECK_ERROR"/></translation>
<translation id="6696114732806961952">Brave에서 계정 삭제</translation>
<translation id="1084363153644366288">iOS용 Brave의 향상된 세이프 브라우징으로 이동 중에도 더 안전하게 보호하세요.</translation>
<translation id="7949164640723239455">위험한 사이트입니다. Brave에서 알림을 삭제했습니다.</translation>
<translation id="2236949375853147973">내 활동</translation>
<translation id="4536403809133456417">모든 기기에서 내 주소 등을 가져오려면 Brave에 로그인하세요. 로그인하면 이 주소가 Browther 계정에 저장됩니다</translation>
<translation id="5627930103267312171">컴퓨터를 공유하는 경우 친구와 가족이 개별적으로 탐색하고 원하는 대로 Brave을 설정할 수 있습니다.</translation>
<translation id="2283803047247799269">이미지 검색으로 이 탭 검색</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}other{브라우저 속도를 저하시키는 탭을 일시중지하는 것이 좋습니다}}</translation>
<translation id="2307973900865360088">도크에 고정</translation>
<translation id="5161617112768367959">Brave에 저장된 안전하지 않은 사이트 목록을 사용하여 URL을 검사합니다. 사이트에서 사용자의 비밀번호를 도용하려고 하거나 사용자가 유해한 파일을 다운로드하는 경우, Brave에서 페이지 콘텐츠 일부를 비롯한 URL을 세이프 브라우징 서비스에 보낼 수 있습니다.</translation>
<translation id="4123094831918713833">이 작업으로 인해 나타날 수 있는 결과는 다음과 같습니다.
          <ph name="LINE_BREAKS"/>
           • 일부 Browther 설정 및 Browther 바로가기 재설정
           <ph name="LINE_BREAK"/>
           • 확장 프로그램 사용 중지
           <ph name="LINE_BREAK"/>
           • 쿠키 및 기타 임시 사이트 데이터 삭제
            <ph name="LINE_BREAKS"/>
           북마크, 방문 기록, 저장된 비밀번호는 영향을 받지 않습니다.</translation>
<translation id="5456070119344236353">여기에서 Android 휴대전화로 번호를 전송하려면 두 기기 모두에서 Brave에 로그인하세요.</translation>
<translation id="2356070529366658676">확인</translation>
