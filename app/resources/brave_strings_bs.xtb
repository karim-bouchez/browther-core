<!DOCTYPE translationbundle>
<translationbundle lang="bs">
<translation id="1026101648481255140">Nastavi instalaciju</translation>
<translation id="7099479769133613710">Ponovo pokrenite da ažurirate &amp;ChromeOS</translation>
<translation id="7264054672589027446">Browther vam preporučuje da pregledate ovu ekstenziju</translation>
<translation id="7848219163187166649">Kada web lokacija zatraži privatno predučitavanje linkova na stranici, Browther koristi Braveove servere. Time se vaš identitet sakriva od predučitane web lokacije, ali Browther uči koje web lokacije se predučitavaju.</translation>
<translation id="5749154344207139683">Pomozite nam da poboljšamo anonimni način rada popunjavanjem 1-minutne ankete.</translation>
<translation id="1065672644894730302">Nije moguće sačuvati vaše postavke.

Neke funkcije možda neće biti dostupne i promjene postavki se neće sačuvati.</translation>
<translation id="8837164267124113709">Tvoj roditelj je isključio "Odobrenja za web lokacije, aplikacije i ekstenzije" za Browther</translation>
<translation id="881513728707488138">Browther želi izvesti vaše lozinke. Unesite svoju lozinku za Windows da to dozvolite.</translation>
<translation id="112640046208448578">Identificirajte stvari ili mjesta i kopirajte ili prevedite tekst. Kada upotrijebite pretraživanje pomoću slika, snimak ekrana stranice će se poslati na server. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther je vaš zadani preglednik</translation>
<translation id="6580138787163923852">Da provjerite jesu li vaše lozinke zaštićene od narušavanja podataka i drugih sigurnosnih problema, <ph name="BEGIN_LINK"/>prijavite se u Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Kliknite na meni Bravea</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="3673786631598474384">Partner <ph name="PARTNER_NAME"/> je dodao ekstenziju koja će možda promijeniti funkcioniranje Bravea.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Instalacija nije uspjela jer vaša verzija Windowsa nije podržana.</translation>
<translation id="8291401179516272335">O programu Browther</translation>
<translation id="1203500561924088507">Hvala što ste instalirali. Morate ponovo pokrenuti preglednik prije nego što možete koristiti <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Kada otvorite pretraživanje pomoću slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski će se poslati na server. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Dok ste prijavljeni, lozinke i drugo s Browther računa možete koristiti u Braveu. Da promijenite ovo, idite na "Vaš račun u Braveu".</translation>
<translation id="9034321258761608912">Dok je ova kartica bila neaktivna, memorija je oslobođena kako bi Browther ostao brz. Možete odabrati da uvijek izuzmete ovu web lokaciju iz neaktivnosti.</translation>
<translation id="249571811018731941">Browther je blokirao ovo preuzimanje jer je fajl opasan</translation>
<translation id="8850227089720975601">Prilikom prijave na Braveove usluge kao što su Gmail ili YouTube koristeći <ph name="USER_EMAIL"/> možete se automatski prijaviti u Browther putem istog računa</translation>
<translation id="1290883685122687410">Greška prilikom postavljanja: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Postavite novi Browther profil</translation>
<translation id="4437862975743821367">Braveu je potreban pristup Bluetoothu da istraži 
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Otkrij jezik</translation>
<translation id="1206925267243987362">Koristite preporučene postavke preglednika Browther</translation>
<translation id="8270483548049772782">Također izbriši podatke iz Bravea (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Zakačeno! Mogućnost ponovnog pristupa pretraživanju pomoću slika putem novog dugmeta na alatnoj traci</translation>
<translation id="1356661055722410047">Novo! Možete prevesti i tekst i slike s ekrana</translation>
<translation id="1383876407941801731">Traži</translation>
<translation id="1592588950737518481">&amp;Upravljajte profilima u Braveu</translation>
<translation id="1404026649028693342">Uvijek prikazuj AI način rada</translation>
<translation id="141901961143729572">Podijelite svoje misli</translation>
<translation id="1743952081001089298">Da podijelite prozor, dozvolite snimanje ekrana za Browther u Postavkama sistema.</translation>
<translation id="8627385813382688019">Potražite pomoć za Browther for Testing</translation>
<translation id="1497802159252041924">Greška prilikom instaliranja: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Stranica je zaštićena</translation>
<translation id="7252430412915798987">Dijelite Browther karticu</translation>
<translation id="6388429281015199562">Prijavite se u Browther</translation>
<translation id="1547469039832541117">Završava istaknuti zadatak.</translation>
<translation id="1801944307203212016">Braveu je potrebno odobrenje da pristupi kameri radi kreiranja 3D mape vašeg okruženja</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Ta ekstenzija više nije podržana. Browther preporučuje da je uklonite.}one{Te ekstenzije više nisu podržane. Browther preporučuje da ih uklonite.}few{Te ekstenzije više nisu podržane. Browther preporučuje da ih uklonite.}other{Te ekstenzije više nisu podržane. Browther preporučuje da ih uklonite.}}</translation>
<translation id="4667068923142532753">Zakači Browther</translation>
<translation id="3006560544901646947">Braveovi sigurnosni alati</translation>
<translation id="686052171138185761">Browther želi izbrisati vaše podatke iz Upravitelja lozinki. Unesite svoju lozinku za Windows da to dozvolite.</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{Administrator traži da ponovo pokrenete Browther radi primjene ažuriranja}=1{Administrator traži da ponovo pokrenete Browther radi primjene ažuriranja. Vaš anonimni prozor se neće ponovo otvoriti.}one{Administrator traži da ponovo pokrenete Browther radi primjene ažuriranja. Vaš # anonimni prozor se neće ponovo otvoriti.}few{Administrator traži da ponovo pokrenete Browther radi primjene ažuriranja. Vaša # anonimna prozora se neće ponovo otvoriti.}other{Administrator traži da ponovo pokrenete Browther radi primjene ažuriranja. Vaših # anonimnih prozora se neće ponovo otvoriti.}}</translation>
<translation id="8713026329083542796">Pregledajte ključne kontrole privatnosti i sigurnosti na Braveu</translation>
<translation id="1640672724030957280">Preuzimanje…</translation>
<translation id="1680687534629375545">Postavite pitanje pretraživanju pomoću slika o ovoj stranici</translation>
<translation id="1709772298389099340">Pruža dodatne ovlasti za preglednik <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Radi poboljšanja ovih funkcija Browther šalje vaše interakcije s njima Braveu. Ove podatke će možda čitati, obrađivati i komentirati osobe koje vrše pregled.</translation>
<translation id="1722488837206509557">Ovo će vam dozvoliti da odaberete jedan od dostupnih uređaja i da se na njemu prikazuje sadržaj.</translation>
<translation id="6820510278633522408">Browther će uskoro izbrisati podatke o pregledanju</translation>
<translation id="7775028004939172516">Browther će pokušati nadograditi kretanja na HTTPS</translation>
<translation id="6963959729951758069">Browther podaci su obrisani</translation>
<translation id="4085139922884095932">Browther će se ponovo pokrenuti za <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Kada HTTPS nije dostupan, Browther će koristiti nesigurnu vezu bez upozorenja</translation>
<translation id="3975328336074677101">Browther može raditi u pozadini</translation>
<translation id="3629539416935660172">Kako bi Browther bio sigurniji, onemogućili smo neke ekstenzije koje nisu navedene u <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> i koje su možda dodane bez vašeg znanja.</translation>
<translation id="2497443204974841650">Ponovo instaliraj Browther</translation>
<translation id="1724309687045787742">Browther pokušava <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Sljedeći put kada otvorite Browther na uređaju <ph name="DEVICE_TYPE"/>, vidjet ćete upit da koristite Browther upravitelj lozinki.</translation>
<translation id="1838374766361614909">Obriši pretraživanje</translation>
<translation id="2337233040802538155">Da izbrišete podatke pregledanja samo s ovog uređaja, a da ih zadržite na Browther računu, <ph name="BEGIN_LINK"/>odjavite se iz Bravea<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Preuzmite Browther na telefon da otvarate ili kreirate nove grupe kartica u pokretu.</translation>
<translation id="2063443520349987970">Možete upravljati Browther računima na koje ste prijavljeni. Vaši Browther računi se koriste za preglednik Browther, Play trgovinu, Gmail i drugo. Ako želite dodati račun za nekog drugog, kao što je član porodice, umjesto računa dodajte novu osobu na svoj uređaj <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Saznajte više<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Pretražite pomoću slika</translation>
<translation id="1880677175115548835">Odaberite tekst</translation>
<translation id="3183933389992069620">Prijavljujete se s upravljanim računom i dajete njegovom administratoru kontrolu nad svojim Browther profilom. Vaši podaci iz Bravea kao što su vaše aplikacije, oznake, historija, lozinke i druge postavke će biti trajno vezani za korisnika <ph name="USER_NAME"/>. Moći ćete izbrisati ove podatke na kontrolnoj tabli Browther računa, ali nećete moći povezati ove podatke s drugim računom. Opcionalno možete kreirati novi profil da odvojite postojeće podatke iz Bravea. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther štedi energiju baterije ograničavanjem pozadinske aktivnosti i vizuelnih efekata, poput glatkog klizanja i broja slika u sekundi videozapisa. <ph name="BEGIN_LINK"/>Saznajte više o Uštedi energije<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Pitajte o ovoj stranici</translation>
<translation id="9128006428501241840">Usluga za ažuriranje Bravea</translation>
<translation id="6302815314157879372">Isključivanjem ove postavke, možete se prijaviti na Braveove web lokacije poput Gmaila bez prijave na Browther</translation>
<translation id="1063611196035804685">Browther ne reagira. Ponovo pokrenuti sada?</translation>
<translation id="2873360330889594383">Organizacija <ph name="MANAGER"/> zahtijeva da se prijavite u Browther</translation>
<translation id="4035053306113201399">ChromeOS treba ponovo pokrenuti da se primijeni ažuriranje.</translation>
<translation id="2861285003831382718">Browther je blokirao ovo preuzimanje jer se ta vrsta fajla ne preuzima često i fajl je možda opasan</translation>
<translation id="1953553007165777902">Preuzimanje… Preostalo je <ph name="MINUTE"/> min</translation>
<translation id="2080160985220483492">Savjet za Browther: sačuvajte lozinke</translation>
<translation id="8037497710694492565">Browther ne može odrediti ili postaviti zadani preglednik</translation>
<translation id="7395009124247513849">Informacije o tome zašto Browther blokira neke fajlove; otvara se na novoj kartici</translation>
<translation id="762710512520170632">Održava softver Bravea ažurnim. Ako se ova usluga onemogući ili zaustavi, softver Bravea se neće moći održavati ažurnim, što će značiti da se sigurnosne ranjivosti koje mogu nastati neće moći riješiti i da funkcije možda neće funkcionirati. Ova usluga se sama deinstalira kada ne postoji softver Bravea koji je koristi.</translation>
<translation id="5793588180426267429">Ovim će se izbrisati jedna stavka s uređaja. Za preuzimanje podataka kasnije, prijavite se u Browther kao <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalacija nije uspjela. Pokušajte ponovo.</translation>
<translation id="6351516710581760512">Da provjerite jesu li vaše ostale lozinke zaštićene od narušavanja podataka i drugih sigurnosnih problema, <ph name="BEGIN_LINK"/>prijavite se u Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Postavke.</translation>
<translation id="8194525816714210105">Odaberite želite li uključiti historiju Bravea da dodatno personalizirate iskustva na Braveovim uslugama</translation>
<translation id="5909559127548969159">Kliknite na dugme Prilagodite Browther na stranici Nova kartica da Braveu dodijelite novi izgled</translation>
<translation id="2066690553719545730">Uvijek prikazuj AI način rada</translation>
<translation id="3283892260110318935">Browther je blokirao ovo preuzimanje jer je fajl obmanjujući i može izvršiti neočekivane izmjene na uređaju</translation>
<translation id="6160571936643742128">Vidjet ćete upit da isprobate funkciju <ph name="FEATURE_NAME"/> sljedeći put kada otvorite Browther iOS.</translation>
<translation id="8380517409933452343">Lozinke i drugi podaci Bravea koji su sačuvani na Browther računu će se ukloniti s uređaja. Da ih ponovo koristite u Braveu, prijavite se ponovo.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Organizacija automatski briše podatke o pregledanju kada se Browther ne koristi 1 minutu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Organizacija automatski briše podatke o pregledanju kada se Browther ne koristi # minutu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Organizacija automatski briše podatke o pregledanju kada se Browther ne koristi # minute. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Organizacija automatski briše podatke o pregledanju kada se Browther ne koristi # minuta. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2126108037660393668">Potvrda preuzetog fajla nije uspjela.</translation>
<translation id="2135919691573380097">Prijavite ovu web lokaciju</translation>
<translation id="2137162749895930932">Zatvaranje ekrana prevoda</translation>
<translation id="4283559398694996391">Browther je blokirao ovo preuzimanje jer web lokacija ne koristi sigurnu vezu i fajl je možda neovlašteno izmijenjen</translation>
<translation id="2170098639895543546">Odaberite bilo šta na stranici</translation>
<translation id="2495182092286337191">Prilagodite Browther</translation>
<translation id="2174917724755363426">Instalacija nije završena. Jeste li sigurni da želite otkazati?</translation>
<translation id="4877141231724140862">Browther – prijava na mrežu – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Greška provjere ažuriranja: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Ukloni račun iz Bravea</translation>
<translation id="1084363153644366288">Budite sigurniji u pokretu uz poboljšano Sigurno pregledanje u Braveu za iOS</translation>
<translation id="7949164640723239455">Opasna web lokacija. Browther je uklonio obavještenja.</translation>
<translation id="2236949375853147973">Moja aktivnost</translation>
<translation id="4536403809133456417">Da dobijate adrese i druge stavke na svim svojim uređajima, prijavite se u Browther. Ova adresa će se sačuvati na Browther račun nakon što se prijavite.</translation>
<translation id="5627930103267312171">Ako dijelite računar, prijatelji i porodica mogu odvojeno pretraživati i postaviti Browther na način koji njima odgovara.</translation>
<translation id="2283803047247799269">Pretraži ovu karticu putem pretraživanja pomoću slika</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther preporučuje da pauzirate karticu koja usporava preglednik}one{Browther preporučuje da pauzirate kartice koje usporavaju preglednik}few{Browther preporučuje da pauzirate kartice koje usporavaju preglednik}other{Browther preporučuje da pauzirate kartice koje usporavaju preglednik}}</translation>
<translation id="2307973900865360088">Zadrži na donjoj traci</translation>
<translation id="5161617112768367959">Provjerava URL-ove s listom nesigurnih web lokacija pohranjenih u Braveu. Ako web lokacija pokuša ukrasti vašu lozinku ili kada preuzimate štetan fajl, Browther može slati i URL-ove, uključujući dijelove sadržaja stranice, u Sigurno pregledanje.</translation>
<translation id="4123094831918713833">Ova radnja će:
          <ph name="LINE_BREAKS"/>
           • vratiti određene postavke i prečice Bravea na zadano
           <ph name="LINE_BREAK"/>
           • onemogućiti ekstenzije
           <ph name="LINE_BREAK"/>
           • izbrisati kolačiće i druge privremene podatke web lokacije
            <ph name="LINE_BREAKS"/>
           Ova radnja neće uticati na oznake, historiju i sačuvane lozinke.</translation>
<translation id="5456070119344236353">Da pošaljete broj s ovog uređaja na svoj Android telefon, prijavite se u Browther na oba uređaja.</translation>
<translation id="2356070529366658676">Pitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="6468415397021485143">Ekstenzija "<ph name="EXTENSION_NAME"/>" želi da se prijavite u Browther</translation>
<translation id="2558600429878197587">Onemogući pokretanje Bravea u pozadini za aplikacije</translation>
<translation id="5295781918312989856">Da koristite ekstenziju kao <ph name="USER_EMAIL_ADDRESS"/>, prijavite se u Browther.</translation>
<translation id="8418845734693287262">ChromeOS nije mogao sinhronizirati vaše podatke je su detalji za prijavu na vaš račun zastarjeli.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 uređaju s korisničkim interfejsom je pristupala jedna ili više ekstenzija za Browther}=1{1 uređaju s korisničkim interfejsom pristupa jedna ili više ekstenzija za Browther}one{# uređaju s korisničkim interfejsom pristupa jedna ili više ekstenzija za Browther}few{# uređajima s korisničkim interfejsom pristupa jedna ili više ekstenzija za Browther}other{# uređaja s korisničkim interfejsom pristupa jedna ili više ekstenzija za Browther}}</translation>
<translation id="434258293817844111">Braveu su za ovu web lokaciju potrebna odobrenja za kameru i mikrofon</translation>
<translation id="2403703063067034158">Došlo je do greške prilikom postavljanja. Trenutno se izvršava druga instanca postavljanja, Pokušajte ponovo kasnije.</translation>
<translation id="5458993228789433099">Otvarajte linkove u Braveu iz bilo koje aplikacije i držite preglednik dostupnim na traci zadataka</translation>
<translation id="1677640217693742525">Pomoću <ph name="BEGIN_LINK"/>Braveovih alata<ph name="END_LINK"/> možete pregledati sigurno i zadržati kontrolu</translation>
<translation id="2451727308784734061">Koristite prečicu da brzo pristupite Upravitelju lozinki. Možete premjestiti prečicu na početni ekran računara ili u pokretač aplikacija.</translation>
<translation id="2280315911954332435">Browther će se uskoro zatvoriti</translation>
<translation id="6410820860979094113">U Braveu</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je ponovno pokretanje: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Odaberite tekst putem pretraživanja pomoću slika</translation>
<translation id="7892218991241200190">Browther pokušava zamijeniti postojeće lozinke. Upišite lozinku za Windows da ovo dozvolite.</translation>
<translation id="8976443723926188033">Browther treba pristup pohrani zbog preuzimanja fajlova</translation>
<translation id="1973587471928846950">Browther pomagač</translation>
<translation id="2575822587468774919">Odaberite bilo šta da pretražite pomoću slika</translation>
<translation id="8705561858232289221">Da dobijate lozinke i drugo na svim svojim uređajima, prijavite se u Browther</translation>
<translation id="437162022240011372">Nastavi koristiti Browther</translation>
<translation id="259935314519650377">Keširanje preuzetog programa za instaliranje nije uspjelo. Greška: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="2907676829052962091">Vaša organizacija može vidjeti podatke o pregledanju kao što su oznake, historija i lozinke te upravljati njima. Ne može vidjeti podatke o pregledanju na drugim Browther profilima</translation>
<translation id="1289116577679005654">Potvrdite identitet da koristite i sačuvate podatke Bravea na računu <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="8762228142105311329">{COUNT,plural, =0{Napredna zaštita zahtijeva da ponovo pokrenete Browther radi primjene ažuriranja}=1{Napredna zaštita zahtijeva da ponovo pokrenete Browther radi primjene ažuriranja. Anonimni prozor se neće ponovo otvoriti.}one{Napredna zaštita zahtijeva da ponovo pokrenete Browther radi primjene ažuriranja. # anonimni prozor se neće ponovo otvoriti.}few{Napredna zaštita zahtijeva da ponovo pokrenete Browther radi primjene ažuriranja. # anonimna prozora se neće ponovo otvoriti.}other{Napredna zaštita zahtijeva da ponovo pokrenete Browther radi primjene ažuriranja. # anonimnih prozora se neće ponovo otvoriti.}}</translation>
<translation id="7192278346779151664">Tokom instaliranja se pojavila greška operativnog sistema. Ponovo preuzmite Browther.</translation>
<translation id="7724398260867885339">Ako dijelite uređaj, prijatelji i porodica mogu odvojeno pregledati i postavljati Browther na način koji njima odgovara</translation>
<translation id="1679595317134614424">Kartica Bravea</translation>
<translation id="7189168846924379421">Browther će šifrirati vaše podatke radi dodatne sigurnosti.</translation>
<translation id="4052643592793184278">Odjavite se da uklonite Browther račun iz Bravea</translation>
<translation id="7694616023994438906">Da dobijate lozinke, oznake i druge stavke na svim svojim uređajima, prijavite se u Browther</translation>
<translation id="2738871930057338499">Nije moguće povezati se s internetom. HTTP 403 je zabranjen. Provjerite konfiguraciju proksi servera.</translation>
<translation id="2753623023919742414">Kliknite da pretražite</translation>
<translation id="9078193405195503710">Postavite Browther kao zadani preglednik PDF-a</translation>
<translation id="2456995288904753506">Browther može automatski popuniti složena polja koja standardno automatsko popunjavanje može propustiti</translation>
<translation id="3271730304285122987">Ova ekstenzija sadrži zlonamjerni softver i nije sigurna. Uklonite je s Bravea kako više ne bi mogla vidjeti i mijenjati vaše podatke na web lokacijama koje posjećujete, uključujući vaše lične informacije.</translation>
<translation id="2799223571221894425">Ponovo pokreni</translation>
<translation id="1427337251963884503">Vaš Browther</translation>
<translation id="2816462166102338036">Pretražite ovaj videozapis uz pretraživanje pomoću slika</translation>
<translation id="2841525013647267359">Prevod s jezika</translation>
<translation id="2846251086934905009">Greška prilikom instaliranja: program za instaliranje nije završio. Instalacija je prekinuta.</translation>
<translation id="928966105228355994">Ukloni iz Bravea...</translation>
<translation id="587805782197019018">Štiti vas na Braveu i može se koristiti da poboljša vašu sigurnost u drugim Braveovim aplikacijama kada ste prijavljeni.</translation>
<translation id="2885378588091291677">Upravitelj zadataka</translation>
<translation id="3055995278166070443">O &amp;Braveu</translation>
<translation id="2915996080311180594">Ponovo pokreni kasnije</translation>
<translation id="2928420929544864228">Instalacija je završena.</translation>
<translation id="70453521937551896">Vaši podaci su šifrirani pristupnim izrazom. Unesite ga da koristite i sačuvate podatke Bravea na Browther računu.</translation>
<translation id="2945997411976714835">Greška prilikom instaliranja: pokretanje postupka programa za instaliranje nije uspjelo.</translation>
<translation id="3188308520233701133">Brže se prijavite na web lokacije koristeći sačuvane lozinke za Browther u iOS-u</translation>
<translation id="8145318807880784886">Dodajte novi Browther profil da odvojite oznake, lozinke i postavke.</translation>
<translation id="4330268530227888227">Vaša organizacija upravlja Braveom</translation>
<translation id="6488090896442998436">Browther je ažuriran</translation>
<translation id="300557164611864786">Ako web lokacija pokuša ukrasti vašu lozinku ili kada preuzimate štetan fajl, Browther može slati i URL-ove, uključujući dijelove sadržaja stranice, u Sigurno pregledanje</translation>
<translation id="2447145782593796785">Radi veće sigurnosti online uz roditeljeve odabire prijavi se u Browther</translation>
<translation id="3003694935412297923">Svi zadaci</translation>
<translation id="7554113777150891030">{count,plural, =1{Da se određeni podaci mogu sačuvati na Browther računu i koristiti na svim vašim uređajima, Browther mora potvrditi vaš identitet. Ako se sada odjavite, ovi podaci (1 stavka) će se izbrisati.}one{Da se određeni podaci mogu sačuvati na Browther računu i koristiti na svim vašim uređajima, Browther mora potvrditi vaš identitet. Ako se sada odjavite, ovi podaci ({count} stavka) će se izbrisati.}few{Da se određeni podaci mogu sačuvati na Browther računu i koristiti na svim vašim uređajima, Browther mora potvrditi vaš identitet. Ako se sada odjavite, ovi podaci ({count} stavke) će se izbrisati.}other{Da se određeni podaci mogu sačuvati na Browther računu i koristiti na svim vašim uređajima, Browther mora potvrditi vaš identitet. Ako se sada odjavite, ovi podaci ({count} stavki) će se izbrisati.}}</translation>
<translation id="5522228731050510047">Otvorite <ph name="URL"/> u novoj kartici u Braveu.</translation>
<translation id="6358780591055960280">Browther ne može provjeravati vaše lozinke. Pokušajte ponovo kasnije.</translation>
<translation id="1386422761453740126">Dodavanje u Browther…</translation>
<translation id="3038232873781883849">Čekanje na instalaciju...</translation>
<translation id="3045032126857188731">Jezik prevoda: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Zatvaranje dijaloškog okvira za povratne informacije</translation>
<translation id="369127628511662602">Drugi profili u Braveu</translation>
<translation id="2370255879896574713">Pomozite nam da poboljšamo Browther i šaljite Braveu izvještaje o padu aplikacija i <ph name="UMA_LINK"/></translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 USB uređaju je pristupala jedna ili više ekstenzija za Browther}=1{1 USB uređaju pristupa jedna ili više ekstenzija za Browther}one{# USB uređaju pristupa jedna ili više ekstenzija za Browther}few{# USB uređajima pristupa jedna ili više ekstenzija za Browther}other{# USB uređaja pristupa jedna ili više ekstenzija za Browther}}</translation>
<translation id="2065456480740480340">Historija Bravea</translation>
<translation id="5011660649081947055">Aplikacija za instaliranje nije uspjela dekompresirati arhivu. Ponovo preuzmite Browther.</translation>
<translation id="310459126943037700">Prekidanje zadataka nije uspjelo.</translation>
<translation id="3104828284009500087">Pretražite bilo šta na stranici</translation>
<translation id="4917564010081457061">Održavajte lozinke, oznake i historiju savršeno sinhroniziranim na svim uređajima. Ažurirajte zadani preglednik na Browther da lako pristupate funkcijama koje poznajete i volite.</translation>
<translation id="1041472930719344928">Browther koristi vaš mikrofon</translation>
<translation id="3130333203120345554">Novo pretraživanje</translation>
<translation id="3137969841538672700">Prevucite da pretražite</translation>
<translation id="5312717254055363883">Kartica koristi dodatne resurse. Da poboljšate performanse, dozvolite Braveu da je deaktivira.</translation>
<translation id="373523409348786203">Da podijelite ekran, dozvolite snimanje ekrana za Browther u Postavkama sistema</translation>
<translation id="802113445299754598">Ponovo pokreni Browther</translation>
<translation id="3161522574479303604">Svi jezici</translation>
<translation id="5556794247782664281">Otvori link u anonimnom prozoru Bravea</translation>
<translation id="4522189060330781648">Drugi program na računaru je dodao temu koja će možda promijeniti rad Bravea.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">Prilagodite novi Browther profil</translation>
<translation id="5150830326120505481">Da uklonite Browther račun iz Bravea, odjavite se iz tog preglednika na stranici Postavke</translation>
<translation id="7113660200899017820">Kasnije vas Browther može pitati želite li koristiti sačuvane informacije za automatsko popunjavanje vaših obrazaca</translation>
<translation id="4475011322243623412">Browther ne može čitati iz svog direktorija podataka niti u njega pisati:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Ponovo pokreni sada</translation>
<translation id="3536063527222598206">Nedostaju ključevi za Browther API. Neke funkcionalnosti Bravea će se onemogućiti.</translation>
<translation id="1011450868746766298">Ostavi aplikacije da rade u pozadini kada se zatvori Browther</translation>
<translation id="179611081153855734">Browther će vas upozoriti prije učitavanja bilo koje web lokacije putem nesigurne veze</translation>
<translation id="8965591964936552871">Kada zatvorite sve prozore Bravea, odjavit ćete se s većine web lokacija, osim s Browther računa ako ste prijavljeni u Browther. Da omogućite da vas web lokacije zapamte, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Zadani pretraživač je promijenjen izvan Bravea. Browther ga je vratio na zadano radi vaše zaštite.</translation>
<translation id="1170501833661894915">Prijavite se u Browther da dobijete lozinke, oznake i druge stavke na svim svojim uređajima</translation>
<translation id="3352986031709923790">gornji desni ugao područja za pretraživanje: desno <ph name="RIGHT"/>%, gore <ph name="TOP"/>%</translation>
<translation id="120745000989996104">Podaci Bravea na vašem računu</translation>
<translation id="3369405342922656244">Pretražite ovu stranicu uz pretraživanje pomoću slika</translation>
<translation id="7173761126541905083">Koristite lozinke putem Bravea na telefonu</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">Želite li se prebaciti na Browther profil?</translation>
<translation id="3412460710772753638">U Upravitelju lozinki na ovom uređaju</translation>
<translation id="4282363917570905631">Proširite poboljšano Sigurno pregledanje putem Bravea na telefonu</translation>
<translation id="986094398735583155">Personalizacija Bravea…</translation>
<translation id="3266047225484320321">Browther će vas obavijestiti kada se prijavite s ugroženom lozinkom</translation>
<translation id="3508047337876211050">Ovim će se s ovog uređaja izbrisati sljedeći broj stavki: <ph name="ITEMS_COUNT"/>. Za preuzimanje podataka kasnije prijavite se na Browther kao korisnik <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">Prečicom <ph name="SHORTCUT"/> možete prebacivati između Browther profila</translation>
<translation id="7225005776233199285">Zatvorite sve prozore Bravea i pokušajte ponovo.</translation>
<translation id="5465054931427475969">Da podijelite prozor, dozvolite snimanje ekrana za Browther u Postavkama sistema</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> je već prijavljen(a).  Da vaše pregledanje ostane odvojeno, prijavite se u Browther na vlastitom profilu kao <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">Da podijelite ekran, dozvolite snimanje ekrana za Browther u Postavkama sistema.</translation>
<translation id="3597003331831379823">Pokretanje postavljanja s dodatnim ovlastima nije uspjelo. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Prijavite se u Browther</translation>
<translation id="2492221622209669678">Podaci pregledanja ove osobe će se izbrisati s uređaja. Da oporavite podatke, prijavite se u Browther kao <ph name="USER_EMAIL"/>.</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{Dostupno je novo ažuriranje za Browther i primijenit će se čim ga ponovo pokrenete.}=1{Dostupno je novo ažuriranje za Browther i primijenit će se čim ga ponovo pokrenete. Vaš anonimni prozor se neće ponovo otvoriti.}one{Dostupno je novo ažuriranje za Browther i primijenit će se čim ga ponovo pokrenete. Vaš # anonimni prozor se neće ponovo otvoriti.}few{Dostupno je novo ažuriranje za Browther i primijenit će se čim ga ponovo pokrenete. Vaša # anonimna prozora se neće ponovo otvoriti.}other{Dostupno je novo ažuriranje za Browther i primijenit će se čim ga ponovo pokrenete. Vaših # anonimnih prozora se neće ponovo otvoriti.}}</translation>
<translation id="6793778233257855801">Da pošaljete broj s uređaja <ph name="ORIGIN"/> na svoj Android telefon, prijavite se u Browther na oba uređaja.</translation>
<translation id="3667616615096815454">Nije moguće instalirati jer aplikacija nije poznata serveru.</translation>
<translation id="5585500151754164442">Koristi moj <ph name="BEGIN_LINK"/>vlastiti pristupni izraz<ph name="END_LINK"/> za šifriranje svih podataka Bravea na Browther računu. Načini plaćanja i adrese s Google Paya se neće šifrirati. Historija pregledanja iz Bravea se neće sinhronizirati.</translation>
<translation id="404323216042159951">Browther ne može provjeravati vaše lozinke. Predlažemo da provjerite internetsku vezu.</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{Vaš administrator traži da ponovo pokrenete Browther radi primjene ovog ažuriranja}=1{Vaš administrator traži da ponovo pokrenete Browther radi primjene ovog ažuriranja. Vaš anonimni prozor se neće ponovo otvoriti.}one{Vaš administrator traži da ponovo pokrenete Browther radi primjene ovog ažuriranja. Vaš # anonimni prozor se neće ponovo otvoriti.}few{Vaš administrator traži da ponovo pokrenete Browther radi primjene ovog ažuriranja. Vaša # anonimna prozora se neće ponovo otvoriti.}other{Vaš administrator traži da ponovo pokrenete Browther radi primjene ovog ažuriranja. Vaših # anonimnih prozora se neće ponovo otvoriti.}}</translation>
<translation id="5004936474632127765">Otvori link u novoj &amp;kartici Bravea</translation>
<translation id="6236643159256182256">Povežite Browther i druge Braveove usluge radi personalizacije i u druge svrhe</translation>
<translation id="3729187154190517324">Produbljivanje pretraživanja dodavanjem više kartica, fajlova i alata putem dugmeta "Dodajte karticu i drugo".</translation>
<translation id="1400697664933775238">Upravljajte profilima u Braveu</translation>
<translation id="2461315395128103158">Saznajte zašto Browther blokira neka preuzimanja</translation>
<translation id="8058420662026104226">Browther će vas obavijestiti ako nešto budete trebali pregledati</translation>
<translation id="3177448557921912221">Browther profili vam pomažu da odvojite različite dijelove svog života. Dodajte novi profil sada.</translation>
<translation id="1541177876035612043">Browther predučitava stranice za koje postoji vjerovatnoća da ćete ih posjetiti kako bi se brže učitavale prilikom posjete</translation>
<translation id="3810973564298564668">Upravljaj</translation>
<translation id="1117103475254549453">Da koristite sačuvane lozinke, slijedite QR kôd, preuzmite Browther za iOS i prijavite se na Browther račun</translation>
<translation id="8880695882192156860">Savjet za Browther: poboljšano Sigurno pregledanje</translation>
<translation id="3846683726093018685">**Sažmi:** u jednoj rečenici od najviše 30 riječi opiši primarnu temu i svrhu sadržaja na snimku ekrana.

          **Predloži pitanja:** generiraj listu s 3–5 pitanja koja potiču na razmišljanje i koja korisnik može postaviti da bolje razumije snimak ekrana. Ova pitanja trebaju uključivati najmanje jedno pitanje koje se konkretno odnosi na vizuelni objekat, njegov dizajn ili položaj.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> – Browther</translation>
<translation id="3885770153807205175">Birač jezika</translation>
<translation id="4861846616763552424">Prilagodite i kontrolirajte Browther. Potrebna je vaša pažnja - kliknite za detalje.</translation>
<translation id="6126366281251241386">Kliknite na svoje ime da otvorite Browther i počnete pretraživati.</translation>
<translation id="3892148308691398805">Kopiraj tekst</translation>
<translation id="3760801273210219822">Račun <ph name="EXISTING_USER"/> je već prijavljen na ovom Browther profilu. Da vaše pregledanje ostane odvojeno, Browther vam može kreirati vaš lični profil.</translation>
<translation id="3593119910409528681">Ova ekstenzija krši pravila Browther Web trgovine i može biti nesigurna. Uklonite je s Bravea kako više ne bi mogla vidjeti i mijenjati vaše podatke na web lokacijama koje posjećujete, uključujući vaše lične informacije.</translation>
<translation id="3821553157234855663">P&amp;rilagodite Browther</translation>
<translation id="3941890832296813527">Greška prilikom instaliranja: naziv fajla programa za instaliranje nije važeći ili nije podržan.</translation>
<translation id="6482299900191767005">Browther pokušava kopirati lozinke. Unesite svoju lozinku za Windows da to dozvolite.</translation>
<translation id="5853011008278898603">Lozinke, načini plaćanja i adrese koje ste sačuvali na Browther računu će se ukloniti s uređaja. Da ih ponovo koristite u Braveu, prijavite se ponovo.</translation>
<translation id="395904275706073188">Zaštićene stranice se ne mogu čitati. Pokušajte s drugom stranicom.</translation>
<translation id="1832973663231751701">Saznajte kako vas Browther štiti</translation>
<translation id="4531502594774670767">Kada pišete u traci za adresu ili okviru za pretraživanje, Browther šalje ono što pišete u alate za pretraživanje, AI i agente vaše organizacije da dobijete prijedloge.</translation>
<translation id="300013383485253006">O verziji &amp;Browther for Testing</translation>
<translation id="1152920704813762236">O ChromeOS-u</translation>
<translation id="8126752030994997015">Kada posjetite web lokaciju, Browther šalje prikriveni dio URL-a <ph name="BEGIN_LINK"/>Sigurnom pregledanju na Braveu<ph name="END_LINK"/> putem servera za privatnost koji sakriva vašu IP adresu. Ako web lokacija uradi nešto sumnjivo, također se šalju potpuni URL-ovi i dijelovi sadržaja stranice.</translation>
<translation id="3703994572283698466">ChromeOS je moguć zahvaljujući dodatnom <ph name="BEGIN_LINK_CROS_OSS"/>softveru otvorenog koda<ph name="END_LINK_CROS_OSS"/>, isto kao i <ph name="BEGIN_LINK_LINUX_OSS"/>Linuxovo okruženje za razvoj<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Prevedi ekran</translation>
<translation id="4023601594785368013">Izvorni jezik: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Otvarajte linkove u Braveu iz bilo koje aplikacije. Osim toga, zakačite ga na traku zadataka da mu lako pristupate.</translation>
<translation id="3437506136408403836">Pomozite nam da poboljšamo Browther tako što ćete nam prijaviti <ph name="BEGIN_LINK"/>trenutne postavke<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">U najnovijoj verziji su dostupna važna poboljšanja sigurnosti i nove funkcije.</translation>
<translation id="4055805654398742145">Upravitelj l&amp;ozinki</translation>
<translation id="2164947358785939495">Drugi program na računaru je dodao ekstenziju koja će možda promijeniti rad Bravea.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Organizacija automatski zatvara Browther kada se ne koristi 1 minutu. Podaci o pregledanju se brišu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja.}one{Organizacija automatski zatvara Browther kada se ne koristi # minutu. Podaci o pregledanju se brišu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja.}few{Organizacija automatski zatvara Browther kada se ne koristi # minute. Podaci o pregledanju se brišu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja.}other{Organizacija automatski zatvara Browther kada se ne koristi # minuta. Podaci o pregledanju se brišu. Ovo može uključivati historiju, automatsko popunjavanje i preuzimanja.}}</translation>
<translation id="3542179014707218534">Anonimni način rada u Braveu</translation>
<translation id="1535413545339990419">Odlazak na stranicu O Braveu</translation>
<translation id="692283249649018289">Prilagodite Browther da dobijete novi izgled preglednika</translation>
<translation id="6375229634133804834">P&amp;rilagodite Browther</translation>
<translation id="4148957013307229264">Instaliranje…</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> – prijava na mrežu – Browther</translation>
<translation id="2911246138082876798">Otkrijte odlične aplikacije, igre, ekstenzije i teme za Browther.</translation>
<translation id="2528977475313334293">Da dobijete ovu ekstenziju i drugo na svim svojim računarima, prijavite se u Browther</translation>
<translation id="8244267655940711467">Radi veće sigurnosti online uz roditeljeve odabire prebaci se na Browther profil na kojem ti je već izvršena prijava putem <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Otkazuje se…</translation>
<translation id="4224210481850767180">Instalacija je otkazana.</translation>
<translation id="8219359042845534271">Povezati vaše podatke iz Bravea s ovim računom?</translation>
<translation id="5520777668172961882">Upozorava vas o opasnim web lokacijama, čak i onim za koje Browther nije ranije znao, analizirajući više podataka s web lokacija nego što se analizira standardnom zaštitom. Možete odabrati preskakanje Braveovih upozorenja.</translation>
<translation id="2014920019837536689">Odjava iz Bravea</translation>
<translation id="4341512411059715879">Potražite pomoć s Braveom</translation>
<translation id="4281844954008187215">Uslovi korištenja usluge</translation>
<translation id="322492684764924424">Instalacija nije uspjela zbog neodređene greške. Ako je Browther trenutno pokrenut, zatvorite ga i pokušajte ponovo.</translation>
