<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1026101648481255140">ઇન્સ્ટૉલેશનની પ્રક્રિયા ફરી શરૂ કરો</translation>
<translation id="7099479769133613710">&amp;ChromeOSને અપડેટ કરવા માટે, તેને ફરીથી લૉન્ચ કરો</translation>
<translation id="7264054672589027446">Browther તમને આ એક્સ્ટેન્શનનો રિવ્યૂ કરવાનો સુઝાવ આપે છે</translation>
<translation id="7848219163187166649">જ્યારે કોઈ સાઇટ તેના પેજ પર લિંક ખાનગી રીતે પહેલેથી લોડ કરવાનું પૂછે, ત્યારે Browther Browther સર્વરનો ઉપયોગ કરે છે. આ તમારી ઓળખ પહેલેથી લોડ કરેલી સાઇટથી છુપાવે છે, પણ Braveને એ જાણવા મળે છે કે કઈ સાઇટ પહેલેથી લોડ કરવામાં આવે છે.</translation>
<translation id="1065672644894730302">તમારી પસંદગીઓને વાંચી શકાતી નથી.

કેટલીક સુવિધાઓ ઉપલબ્ધ હોઈ શકે છે અને પસંદગીઓ પરના ફેરફારોને સાચવવામાં આવશે નહીં.</translation>
<translation id="8837164267124113709">તમારા માતાપિતાએ Browther માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે.\</translation>
<translation id="881513728707488138">Browther તમારા પાસવર્ડની નિકાસ કરવા માગે છે. આને મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="112640046208448578">વસ્તુઓ અથવા સ્થાનોને ઓળખો અને ટેક્સ્ટને કૉપિ કરો અથવા તેનો અનુવાદ કરો. જ્યારે તમે 'છબી વડે શોધ' સુવિધાનો ઉપયોગ કરો, ત્યારે આ પેજનો કોઈ સ્ક્રીનશૉટ સર્વરને મોકલવામાં આવે છે. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="6580138787163923852">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK"/>Braveiumમાં સાઇન ઇન કરો<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther મેનૂ પર ક્લિક કરો</translation>
<translation id="1157985233335035034">તાજેતરની ભાષાઓ</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> દ્વારા કોઈ એક્સ્ટેન્શન ઉમેરવામાં આવ્યું છે, જેને કારણે Braveની કામ કરવાની રીતમાં ફેરફાર થઈ શકે છે.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Windowsનું તમારું વર્ઝન સપોર્ટેડ ન હોવાને કારણે આ ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="8291401179516272335">Browther વિશે</translation>
<translation id="1203500561924088507">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME"/>નો ઉપયોગ કરતા પહેલાં તમારે તમારું બ્રાઉઝર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="1232234696885483911">જ્યારે તમે 'છબી વડે શોધ' સુવિધા ખોલો, ત્યારે PDFs સહિત પેજનું શીર્ષક, URL અને કન્ટેન્ટ સર્વરને ઑટોમૅટિક રીતે મોકલવામાં આવશે. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે Braveમાં તમારા Browther એકાઉન્ટમાંથી તમારા પાસવર્ડ અને બીજી ઘણી બાબતોનો ઉપયોગ કરી શકો છો. આને બદલવા માટે, “Braveમાં તમારા એકાઉન્ટ” પર જાઓ.</translation>
<translation id="9034321258761608912">જ્યારે આ ટૅબ નિષ્ક્રિય હતું, ત્યારે Braveને ઝડપી રાખવા માટે મેમરી ખાલી કરવામાં આવી હતી. તમે આ સાઇટને નિષ્ક્રિય રહેવામાંથી બાકાત રાખવાનું હંમેશા પસંદ કરી શકો છો.</translation>
<translation id="249571811018731941">Browther દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે ફાઇલ જોખમી છે</translation>
<translation id="8850227089720975601">Gmail કે YouTube જેવી Braveની સેવાઓમાં <ph name="USER_EMAIL"/> વડે સાઇન ઇન કરતી વખતે, તમે એ જ એકાઉન્ટ વડે Braveમાં ઑટોમૅટિક રીતે સાઇન ઇન કરી શકો છો</translation>
<translation id="1290883685122687410">સેટઅપ કરવામાં ભૂલ: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">તમારી નવી Browther પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="4437862975743821367">બ્લૂટૂથ ડિવાઇસ વિશે શોધખોળ કરવા Braveને બ્લૂટૂથના 
 ઍક્સેસની જરૂર છે. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">ભાષા શોધો</translation>
<translation id="1206925267243987362">Browther દ્વારા સુઝાવ આપેલા બ્રાઉઝર સેટિંગનો ઉપયોગ કરો</translation>
<translation id="8270483548049772782">Browther (<ph name="URL"/>)માંથી પણ ડેટા ડિલીટ કરો</translation>
<translation id="1345251407431278948">પિન કરેલી છે! તમે ટૂલબાર પરના નવા બટનમાંથી 'છબી વડે શોધ' સુવિધાને ફરીથી ઍક્સેસ કરી શકો છો</translation>
<translation id="1356661055722410047">નવું! તમે તમારી સ્ક્રીન પર ટેક્સ્ટ અને છબીઓનો અનુવાદ કરી શકો છો</translation>
<translation id="1383876407941801731">શોધો</translation>
<translation id="1592588950737518481">Browther પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="1404026649028693342">હંમેશાં AI મોડ બતાવો</translation>
<translation id="141901961143729572">તમારા વિચારો શેર કરો</translation>
<translation id="1743952081001089298">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Browther માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="8627385813382688019">Browther for Testing માટે સહાય મેળવો</translation>
<translation id="1497802159252041924">ઇન્સ્ટૉલ કરવામાં ભૂલ: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">આ પેજ સંરક્ષિત છે</translation>
<translation id="7252430412915798987">Browther ટૅબ શેર કરો</translation>
<translation id="6388429281015199562">Braveમાં સાઇન ઇન કરો</translation>
<translation id="1547469039832541117">હાઇલાઇટ કરેલું કાર્ય સમાપ્ત કરે છે.</translation>
<translation id="1801944307203212016">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Braveને તમારા કૅમેરાના ઍક્સેસની પરવાનગી જરૂરી છે</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{આ એક્સ્ટેન્શનને હવે સપોર્ટ કરવામાં આવતો નથી. Browther તમને તેને કાઢી નાખવાનો સુઝાવ આપે છે.}one{આ એક્સ્ટેન્શનને હવે સપોર્ટ કરવામાં આવતો નથી. Browther તમને તેને કાઢી નાખવાનો સુઝાવ આપે છે.}other{આ એક્સ્ટેન્શનને હવે સપોર્ટ કરવામાં આવતો નથી. Browther તમને તેને કાઢી નાખવાનો સુઝાવ આપે છે.}}</translation>
<translation id="4667068923142532753">Braveને પિન કરો</translation>
<translation id="3006560544901646947">Braveના સલામતી માટેના ટૂલ</translation>
<translation id="686052171138185761">Browther તમારો Password Manager ડેટા ડિલીટ કરવા માગે છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="8713026329083542796">Braveમાં પ્રાઇવસી અને સુરક્ષા સંબંધિત મુખ્ય નિયંત્રણોનો રિવ્યૂ કરો</translation>
<translation id="1640672724030957280">ડાઉનલોડ કરી રહ્યું છે...</translation>
<translation id="1680687534629375545">'છબી વડે શોધ' સુવિધા વડે આ પેજ વિશે પૂછો</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> માટે વધારેલા વિશેષાધિકારો પ્રદાન કરે છે.</translation>
<translation id="4243382967656566037">આ સુવિધાઓને બહેતર બનાવવામાં સહાય કરવા માટે, Browther તેની સાથેની તમારી ક્રિયાપ્રતિક્રિયાઓ Braveને મોકલે છે. માનવ રિવ્યૂઅર દ્વારા આ ડેટા વાંચવામાં આવી શકે છે તેમજ તેના પર પ્રક્રિયા અને ટીકાટિપ્પણી કરવામાં આવી શકે છે.</translation>
<translation id="1722488837206509557">આ તમને ઉપલબ્ધ ડિવાઇસમાંથી પસંદ કરવાની અને તેમના પર કન્ટેન્ટ બતાવવાની મંજૂરી આપશે.</translation>
<translation id="6820510278633522408">Browther ટૂંક સમયમાં જ બ્રાઉઝિંગ ડેટા ડિલીટ કરશે</translation>
<translation id="7775028004939172516">Browther નૅવિગેશનને HTTPS પર અપગ્રેડ કરવાનો પ્રયાસ કરશે</translation>
<translation id="6963959729951758069">Browther ડેટા સાફ કર્યો</translation>
<translation id="4085139922884095932">Browther <ph name="REMAINING_TIME"/>માં ફરી શરૂ થશે</translation>
<translation id="2586248102295515296">જ્યારે HTTPS ઉપલબ્ધ ન હોય, ત્યારે Browther તમને ચેતવણી આપ્યા વિના અસુરક્ષિત કનેક્શનનો ઉપયોગ કરશે</translation>
<translation id="3975328336074677101">Braveને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="2497443204974841650">Browther ફરીથી ઇન્સ્ટોલ કરો</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/>નો પ્રયાસ કરી રહ્યું છે</translation>
<translation id="4553225588627299783">આગલી વખતે જ્યારે તમે તમારા <ph name="DEVICE_TYPE"/> પર Browther ખોલો, ત્યારે તમને Browther Password Managerનો ઉપયોગ કરવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="1838374766361614909">શોધ સાફ કરો</translation>
<translation id="2337233040802538155">તમારા Browther એકાઉન્ટમાં બ્રાઉઝિંગ ડેટા રાખીને તેને માત્ર આ ડિવાઇસમાંથી ડિલીટ કરવા માટે, <ph name="BEGIN_LINK"/>Braveમાંથી સાઇન આઉટ કરો<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">મુસાફરીમાં હો ત્યારે ટૅબના નવા ગ્રૂપ ખોલવા અથવા બનાવવા માટે તમારા ફોન પર Browther ડાઉનલોડ કરો.</translation>
<translation id="2063443520349987970">તમે તમારા સાઇન ઇન કરેલા હોય એવા Browther એકાઉન્ટ મેનેજ કરી શકો છો. તમારા Browther એકાઉન્ટનો ઉપયોગ Browther બ્રાઉઝર, Play Store, Gmail અને વધુ માટે થાય છે. જો તમે કોઈ બીજા, જેમકે તમારા કુટુંબના સભ્ય માટે એકાઉન્ટ ઉમેરવા માંગતા હો, તો તેના બદલે નવી વ્યક્તિને તમારા <ph name="DEVICE_TYPE"/>માં ઉમેરો. <ph name="LINK_BEGIN"/>વધુ જાણો<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">'છબી વડે શોધ' સુવિધા વડે શોધો</translation>
<translation id="1880677175115548835">ટેક્સ્ટ પસંદ કરો</translation>
<translation id="3183933389992069620">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Browther પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો Browther ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME"/>થી જોડાયેલા રહેશે. તમે Browther એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. તમે હાલના Browther ડેટાને અલગ રાખવા માટે વૈકલ્પિક રીતે એક નવી પ્રોફાઇલ બનાવી શકો છો. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther દ્વારા સ્મૂધ સ્ક્રોલિંગ અને વીડિયોના ફ્રેમ રેટ જેવી બૅકગ્રાઉન્ડ ઍક્ટિવિટી અને વિઝ્યુઅલ ઇફેક્ટને મર્યાદિત કરીને બૅટરીના પાવરની બચત કરવામાં આવે છે. <ph name="BEGIN_LINK"/>એનર્જી સેવર વિશે વધુ જાણો<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">આ પેજ વિશે પૂછો</translation>
<translation id="9128006428501241840">Browther અપડેટર સેવા</translation>
<translation id="6302815314157879372">આને બંધ કરવાથી, તમે Braveમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Braveની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="1063611196035804685">Browther પ્રતિસાદ આપતું નથી. હવે ફરીથી લોંચ કરીએ?</translation>
<translation id="2873360330889594383">તમારી સંસ્થાના <ph name="MANAGER"/> માટે જરૂરી છે કે તમે Braveમાં સાઇન ઇન કરો</translation>
<translation id="4035053306113201399">અપડેટ લાગુ કરવા માટે ChromeOSને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="2861285003831382718">Browther દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે સામાન્ય રીતે આ પ્રકારની ફાઇલ ડાઉનલોડ કરવામાં આવતી નથી અને તે જોખમી હોઈ શકે છે</translation>
<translation id="1953553007165777902">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="MINUTE"/> મિનિટ બાકી છે</translation>
<translation id="2080160985220483492">Browther ટિપ: પાસવર્ડ સાચવો</translation>
<translation id="8037497710694492565">Browther ડિફૉલ્ટ બ્રાઉઝરને નિર્ધારિત અથવા સેટ કરી શકતું નથી</translation>
<translation id="7395009124247513849">Browther શા માટે અમુક ફાઇલો બ્લૉક કરે છે તે જાણો, નવા ટૅબમાં ખૂલે છે</translation>
<translation id="762710512520170632">તમારો Browther સૉફ્ટવેર અપ ટૂ ડેટ રાખે છે. જો આ સેવા બંધ કરવા કે રોકવામાં આવે, તો તમારો Browther સૉફ્ટવેર અપ ટૂ ડેટ રહેશે નહીં, એટલે કે ઉદ્ભવી શકે તેવા સુરક્ષા સંબંધિત જોખમોનું નિરાકરણ કરી શકાય નહીં એમ બની શકે છે અને સુવિધાઓ કાર્ય કરે નહીં એમ બની શકે છે. જ્યારે આ સેવાનો ઉપયોગ કરતો કોઈ Browther સૉફ્ટવેર ન હોય, ત્યારે તે આપમેળે જ અનઇન્સ્ટૉલ થઈ જાય છે.</translation>
<translation id="5793588180426267429">આ, 1 આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Browther માં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2018879682492276940">ઇન્સ્ટૉલ કરવામાં નિષ્ફળ રહ્યાં. કૃપા કરીને ફરી પ્રયાસ કરો.</translation>
<translation id="6351516710581760512">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા અન્ય પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK"/>Braveમાં સાઇન ઇન કરો<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">સેટિંગ.</translation>
<translation id="8194525816714210105">Braveની સેવાઓમાં વધુ મનગમતા બનાવેલા અનુભવો આપવા માટે, Browther ઇતિહાસ શામેલ કરવો કે નહીં, તે પસંદ કરો</translation>
<translation id="5909559127548969159">Braveને નવો દેખાવ આપવા માટે નવા ટૅબ પેજ પર જઈને Braveને કસ્ટમાઇઝ કરો બટન પર ક્લિક કરો</translation>
<translation id="2066690553719545730">હંમેશાં AI મોડ બતાવો</translation>
<translation id="3283892260110318935">Browther દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ ફાઇલ છેતરામણી છે અને તે તમારા ડિવાઇસમાં અનપેક્ષિત ફેરફારો કરે તેમ બની શકે છે</translation>
<translation id="6160571936643742128">તમે આગલી વખતે Browther iOS ખોલો ત્યારે તમને <ph name="FEATURE_NAME"/> અજમાવવા માટેનો પ્રૉમ્પ્ટ દેખાશે.</translation>
<translation id="8380517409933452343">તમારા Browther એકાઉન્ટમાં તમે સાચવેલા તમારા પાસવર્ડ અને Braveનો અન્ય ડેટા આ ડિવાઇસમાંથી કાઢી નાખવામાં આવશે. Braveમાં તેનો ફરીથી ઉપયોગ કરવા માટે, પાછું સાઇન ઇન કરો.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}one{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}other{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા બ્રાઉઝિંગ ડેટાને ઑટોમૅટિક રીતે ડિલીટ કરે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે. તમારા ટૅબ ખોલેલા રહેશે.}}</translation>
<translation id="2126108037660393668">ડાઉનલોડ કરેલી ફાઇલની ચકાસણી નિષ્ફળ થઈ.</translation>
<translation id="2135919691573380097">આ સાઇટની જાણ કરો</translation>
<translation id="2137162749895930932">અનુવાદ સ્ક્રીન બંધ કરો</translation>
<translation id="4283559398694996391">Browther દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે આ સાઇટ કોઈ સુરક્ષિત કનેક્શનનો ઉપયોગ કરી રહી નથી તેમજ ફાઇલ સાથે ચેડાં કરવામાં આવ્યા હોઈ શકે છે</translation>
<translation id="2170098639895543546">પેજ પર કંઈપણ પસંદ કરો</translation>
<translation id="2495182092286337191">Browther કસ્ટમાઇઝ કરો</translation>
<translation id="2174917724755363426">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ નથી. શું તમે ખરેખર રદ કરવા માગો છો?</translation>
<translation id="4877141231724140862">Browther - નેટવર્ક સાઇન ઇન - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">અપડેટ ચેક કરવામાં ભૂલ: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Braveમાંથી એકાઉન્ટ કાઢી નાખો</translation>
<translation id="1084363153644366288">iOS માટે Browther પર Safe Browsingમાં વધારેલી સુરક્ષા વડે મુસાફરીમાં વધુ સલામત રહો</translation>
<translation id="7949164640723239455">જોખમી સાઇટ. Browther દ્વારા નોટિફિકેશન કાઢી નાખવામાં આવ્યા.</translation>
<translation id="2236949375853147973">મારી ઍક્ટિવિટી</translation>
<translation id="4536403809133456417">તમારા બધા ડિવાઇસ પર તમારા ઍડ્રેસ અને બીજું ઘણું મેળવવા માટે, Braveમાં સાઇન ઇન કરો. તમે સાઇન ઇન કરો તે પછી આ ઍડ્રેસ તમારા Browther એકાઉન્ટમાં સાચવવામાં આવશે.</translation>
<translation id="5627930103267312171">જો તમે કમ્પ્યુટરને શેર કરો છો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી અને તેમને જોઇએ તેમ Browther ને સેટ કરી શકે છે.</translation>
<translation id="2283803047247799269">'છબી વડે શોધ' સુવિધા વડે આ ટૅબ શોધો</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Braveનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}one{Braveનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}other{Braveનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યાં હોય એવા ટૅબને થોભાવી દો}}</translation>
<translation id="2307973900865360088">ડૉકમાં રાખો</translation>
<translation id="5161617112768367959">URLsને Braveમાં સંગ્રહિત અસુરક્ષિત સાઇટની સૂચિ સાથે ચેક કરે છે. જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Browther પેજ કન્ટેન્ટના બિટની સાથોસાથ URLs પણ Safe Browsingને મોકલી શકે છે.</translation>
<translation id="4123094831918713833">આમ કરવાથી:
          <ph name="LINE_BREAKS"/>
           • Braveના અમુક સેટિંગ અને Browther શૉર્ટકટ રીસેટ થઈ જશે
           <ph name="LINE_BREAK"/>
           • એક્સ્ટેન્શન બંધ થઈ જશે
           <ph name="LINE_BREAK"/>
           • કુકી અને સાઇટનો અન્ય હંગામી ડેટા ડિલીટ થઈ જશે
            <ph name="LINE_BREAKS"/>
           બુકમાર્ક, ઇતિહાસ અને સાચવેલા પાસવર્ડને કોઈ અસર નહીં થાય.</translation>
<translation id="5456070119344236353">અહીંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Braveમાં સાઇન ઇન કરો.</translation>
<translation id="2356070529366658676">કહો</translation>
<translation id="2359808026110333948">આગળ વધો</translation>
<translation id="6468415397021485143">\"<ph name="EXTENSION_NAME"/>\" એક્સ્ટેન્શન ઇચ્છે છે કે તમે Braveમાં સાઇન ઇન કરો</translation>
<translation id="2558600429878197587">ઍપ માટે બૅકગ્રાઉન્ડમાં Browther ચલાવવાનું બંધ કરો</translation>
<translation id="5295781918312989856"><ph name="USER_EMAIL_ADDRESS"/> તરીકે આ એક્સ્ટેન્શનનો ઉપયોગ કરવા માટે, Braveમાં સાઇન ઇન કરો.</translation>
<translation id="8418845734693287262">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે ChromeOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 HID ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 HID ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# HID ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# HID ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="434258293817844111">આ સાઇટ માટે Braveને કૅમેરા અને માઇક્રોફોનની પરવાનગીઓની જરૂર છે</translation>
<translation id="2403703063067034158">સ્ટાર્ટઅપ દરમિયાન ભૂલ: અન્ય સેટઅપ હાલમાં ચાલી રહ્યું છે, કૃપા કરીને પછીથી પ્રયાસ કરો.</translation>
<translation id="5458993228789433099">કોઈપણ ઍપમાંથી Braveમાં લિંક ખોલો અને તમારા ટાસ્કબાર પર બ્રાઉઝરને ઍક્સેસિબલ રાખો</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Braveના ટૂલ<ph name="END_LINK"/> વડે, તમે સલામત રીતે બ્રાઉઝ કરી શકો છો તેમજ નિયંત્રણ જાળવી શકો છો</translation>
<translation id="2451727308784734061">Password Manager પર ઝડપથી જવા માટે તમારા શૉર્ટકટનો ઉપયોગ કરો. તમે તમારા શૉર્ટકટને તમારા કમ્પ્યુટરની હોમ સ્ક્રીન અથવા ઍપ લૉન્ચર પર ખસેડી શકો છો.</translation>
<translation id="2280315911954332435">Browther ટૂંક સમયમાં જ બંધ થશે</translation>
<translation id="6410820860979094113">Browther માં</translation>
<translation id="2485422356828889247">અનઇન્સ્ટૉલ કરો</translation>
<translation id="2513154137948333830">રીબૂટ કરવું આવશ્યક છે: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">'છબી વડે શોધ' સુવિધા વડે ટેક્સ્ટ પસંદ કરો</translation>
<translation id="7892218991241200190">Browther વર્તમાન પાસવર્ડ બદલવાનો પ્રયાસ કરી રહ્યું છે. આને મંજૂરી આપવા માટે Windowsનો પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="8976443723926188033">ફાઇલો ડાઉનલોડ કરવા માટે Braveને સ્ટોરેજના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="4131374838781785973">Browther Origin હેલ્પર</translation>
<translation id="2575822587468774919">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કંઈપણ પસંદ કરો</translation>
<translation id="8705561858232289221">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Braveમાં સાઇન ઇન કરો</translation>
<translation id="437162022240011372">Braveનો ઉપયોગ કરવાનું ચાલુ રાખો</translation>
<translation id="259935314519650377">ડાઉનલોડ કરેલા ઇન્સ્ટૉલરને કૅશ મેમરીમાં સાચવવામાં નિષ્ફળ રહ્યાં. ભૂલ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">સિસ્ટમ</translation>
<translation id="2907676829052962091">તમારી સંસ્થા બ્રાઉઝિંગ ડેટા જોઈ અને મેનેજ કરી શકે છે, જેમ કે તમારા બુકમાર્ક, ઇતિહાસ અને પાસવર્ડ. તે અન્ય Browther પ્રોફાઇલમાં બ્રાઉઝિંગ ડેટા જોઈ શકશે નહીં</translation>
<translation id="1289116577679005654">તમારા <ph name="ACCOUNT_EMAIL"/> એકાઉન્ટમાં Browther ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, આ તમે જ છો તેની ચકાસણી કરો</translation>
<translation id="7192278346779151664">ઇન્સ્ટૉલેશન દરમિયાન ઓપરેટિંગ સિસ્ટમ ભૂલ આવી. કૃપા કરીને ફરીથી Browther ડાઉનલોડ કરો.</translation>
<translation id="7724398260867885339">જો તમે ડિવાઇસ શેર કરતા હો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેઓ તેમને જોઈએ તે પ્રમાણે Braveનું સેટઅપ કરી શકે છે</translation>
<translation id="1679595317134614424">Browther ટૅબ</translation>
<translation id="7189168846924379421">ઉમેરેલી સુરક્ષા માટે, Browther તમારા ડેટાને એન્ક્રિપ્ટ કરશે.</translation>
<translation id="4052643592793184278">Braveમાંથી તમારા Browther એકાઉન્ટને કાઢી નાખવા માટે, સાઇન આઉટ કરો</translation>
<translation id="7694616023994438906">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ, બુકમાર્ક અને બીજું ઘણું મેળવવા માટે, Braveમાં સાઇન ઇન કરો</translation>
<translation id="2738871930057338499">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 403 પ્રતિબંધિત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="2753623023919742414">શોધવા માટે ક્લિક કરો</translation>
<translation id="9078193405195503710">Browther ને તમારા ડિફૉલ્ટ PDF વ્યૂઅર તરીકે સેટ કરો</translation>
<translation id="2456995288904753506">ઑટોમૅટિક રીતે ભરવાની સ્ટૅન્ડર્ડ સુવિધા ચૂકી શકે એવા મુશ્કેલ ફીલ્ડને Browther ઑટોમૅટિક રીતે ભરી શકે છે</translation>
<translation id="3271730304285122987">આ એક્સ્ટેન્શન માલવેર ધરાવે છે અને તે અસુરક્ષિત છે. તેને Braveમાંથી કાઢી નાખો જેથી તે હવેથી તમારી વ્યક્તિગત માહિતી સહિત તમે મુલાકાત લો તે સાઇટ પરનો તમારો ડેટા જોઈ કે બદલી શકે નહીં.</translation>
<translation id="2799223571221894425">ફરીથી લોંચ કરો</translation>
<translation id="1427337251963884503">તમારું Browther</translation>
<translation id="2816462166102338036">'છબી વડે શોધ' સુવિધા વડે આ વીડિયો શોધો</translation>
<translation id="2841525013647267359">આમાંથી અનુવાદ કરો</translation>
<translation id="2846251086934905009">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલર પૂર્ણ થયું નહીં. ઇન્સ્ટોલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="928966105228355994">Browther માંથી દૂર કરો...</translation>
<translation id="587805782197019018">તમને Browther પર સલામત રાખે છે અને જ્યારે તમે સાઇન ઇન થયા હો, ત્યારે Braveની અન્ય ઍપમાં તમારી સુરક્ષા બહેતર બનાવવામાં કદાચ ઉપયોગમાં લેવાઈ શકે છે</translation>
<translation id="2885378588091291677">કાર્ય વ્યવસ્થાપક</translation>
<translation id="3055995278166070443">&amp;Browther વિશે</translation>
<translation id="2915996080311180594">પછીથી ફરી શરૂ કરો</translation>
<translation id="2928420929544864228">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ.</translation>
<translation id="70453521937551896">તમારો ડેટા તમારા પાસફ્રેઝ વડે એન્ક્રિપ્ટ કરવામાં આવ્યો છે. તમારા Browther એકાઉન્ટમાં Browther ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, તમારો પાસફ્રેઝ દાખલ કરો.</translation>
<translation id="2945997411976714835">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની પ્રક્રિયા શરૂ થવામાં નિષ્ફળ રહી.</translation>
<translation id="3188308520233701133">iOS પર Browther માટે સાચવેલા પાસવર્ડનો ઉપયોગ કરીને સાઇટ પર વધુ ઝડપથી સાઇન ઇન કરો</translation>
<translation id="8145318807880784886">બુકમાર્ક, પાસવર્ડ અને સેટિંગ અલગ-અલગ રાખવા માટે નવી Browther પ્રોફાઇલ ઉમેરો.</translation>
<translation id="4330268530227888227">તમારી સંસ્થા Braveને મેનેજ કરે છે</translation>
<translation id="6488090896442998436">Browther અપ ટૂ ડેટ છે</translation>
<translation id="300557164611864786">જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Browther પેજ કન્ટેન્ટના બિટ સહિત URLs પણ Safe Browsingને મોકલી શકે છે</translation>
<translation id="2447145782593796785">તમારા માતાપિતાની પસંદગીઓ સાથે ઑનલાઇન વધુ સલામત રહેવા માટે, Braveમાં સાઇન ઇન કરો</translation>
<translation id="3003694935412297923">બધા કામ</translation>
<translation id="7554113777150891030">{count,plural, =1{તમારા Browther એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Browther માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા (1 આઇટમ) ડિલીટ કરવામાં આવશે.}one{તમારા Browther એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Browther માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}other{તમારા Browther એકાઉન્ટમાં કેટલોક ડેટા સાચવી શકાય અને તમારા બધા ડિવાઇસ પર તેનો ઉપયોગ કરી શકાય તે પહેલાં, Browther માટે એ તમે જ છો તેની ચકાસણી કરવી જરૂરી છે. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ({count} આઇટમ) ડિલીટ કરવામાં આવશે.}}</translation>
<translation id="5522228731050510047">Braveમાં નવા ટૅબમાં <ph name="URL"/> ખોલો.</translation>
<translation id="6358780591055960280">Browther તમારા પાસવર્ડ ચેક કરી શકતું નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="1386422761453740126">Browther માં ઉમેરી રહ્યું છે...</translation>
<translation id="3038232873781883849">ઇન્સ્ટૉલ થવાની રાહ જોઈ રહ્યાં છીએ...</translation>
<translation id="3045032126857188731">અનુવાદિત ભાષા: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">પ્રતિસાદનો સંવાદ બંધ કરો</translation>
<translation id="369127628511662602">અન્ય Browther પ્રોફાઇલ</translation>
<translation id="2370255879896574713">ક્રૅશ રિપોર્ટ અને <ph name="UMA_LINK"/> Braveને મોકલીને Browther ને વધુ સારું બનાવવામાં મદદ કરો.</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 USB ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું હતું}=1{1 USB ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}one{# USB ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યું છે}other{# USB ડિવાઇસને એક કે વધુ Browther એક્સ્ટેન્શન દ્વારા ઍક્સેસ કરવામાં આવી રહ્યાં છે}}</translation>
<translation id="2065456480740480340">Braveનો ઇતિહાસ</translation>
<translation id="5011660649081947055">ઇન્સ્ટૉલર આર્કાઇવને અનકોમ્પ્રેસ કરવામાં નિષ્ફળ. કૃપા કરીને Browther ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="310459126943037700">કામ સમાપ્ત કરવામાં નિષ્ફળ.</translation>
<translation id="3104828284009500087">પેજ પર કંઈપણ શોધો</translation>
<translation id="4917564010081457061">તમારા પાસવર્ડ, બુકમાર્ક અને ઇતિહાસને બધા ડિવાઇસ પર સંપૂર્ણ રીતે સિંક કરેલા રાખો. તમારા ડિફૉલ્ટ બ્રાઉઝરને Browther પર અપડેટ કરીને તમે જાણતા હો એવી અને તમને ગમતી હોય એવી સુવિધાઓને સરળતાથી ઍક્સેસ કરો.</translation>
<translation id="1041472930719344928">Browther તમારા માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="3130333203120345554">નવી શોધ</translation>
<translation id="3137969841538672700">શોધવા માટે ખેંચો</translation>
<translation id="5312717254055363883">આ ટૅબ વધારાના સંસાધનોનો ઉપયોગ કરી રહ્યું છે. તમારા પર્ફોર્મન્સને બહેતર બનાવવા માટે, Braveને તેને નિષ્ક્રિય કરવા દો.</translation>
<translation id="373523409348786203">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Browther માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="802113445299754598">Browther ને ફરીથી લોંચ કરો</translation>
<translation id="3161522574479303604">બધી ભાષાઓ</translation>
<translation id="4522189060330781648">તમારા કમ્પ્યૂટર પરના અન્ય પ્રોગ્રામ દ્વારા કોઈ થીમ ઉમેરવામાં આવી છે જેનાથી Braveની કામ કરવાની રીતમાં ફેરફાર થઈ શકે છે.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">તમારી નવી Browther પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="5150830326120505481">Braveમાંથી તમારા Browther એકાઉન્ટને કાઢી નાખવા માટે, સેટિંગ પેજમાં જઈને Braveમાંથી સાઇન આઉટ કરો</translation>
<translation id="7113660200899017820">પછીથી, તમે તમારા માટે ફોર્મ ઑટોમૅટિક રીતે ભરવાની સુવિધા માટે સચવાયેલી માહિતીનો ઉપયોગ કરવા માગો છો કે કેમ તે વિશે Browther તમને પૂછી શકે છે</translation>
<translation id="4475011322243623412">Browther એની ડેટા ડિરેક્ટરી વાંચી અથવા લખી શકતુંં નથી:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">હવે ફરીથી પ્રારંભ કરો</translation>
<translation id="3536063527222598206">Browther API કીઝ ખૂટે છે. Browther ની કેટલીક કાર્યક્ષમતા અક્ષમ થશે.</translation>
<translation id="1011450868746766298">જ્યારે Browther બંધ થાય ત્યારે બૅકગ્રાઉન્ડ ઍપ ચલાવવાનું ચાલુ રાખો</translation>
<translation id="179611081153855734">અસુરક્ષિત કનેક્શનનો ઉપયોગ કરીને કોઈપણ સાઇટ લોડ કરતા પહેલાં Browther તમને ચેતવણી આપશે</translation>
<translation id="8965591964936552871">જ્યારે તમે બધી Browther વિન્ડો બંધ કરશો, ત્યારે તમને મોટાભાગની સાઇટમાંથી સાઇન આઉટ કરવામાં આવશે, સિવાય કે જો તમે Braveમાં સાઇન ઇન કરેલું હોય, તો તમારા Browther એકાઉન્ટમાંથી સાઇન આઉટ કરવામાં આવશે નહીં. સાઇટને તમને યાદ રાખવાની મંજૂરી આપવા માટે, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Braveની બહારથી તમારું ડિફૉલ્ટ શોધ એન્જિન બદલવામાં આવ્યું હતું. તમારી સુરક્ષા માટે, Browther દ્વારા તેને રીસેટ કરવામાં આવ્યું છે.</translation>
<translation id="1170501833661894915">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ, બુકમાર્ક અને બીજુ ઘણું મેળવવા માટે Braveમાં સાઇન ઇન કરો</translation>
<translation id="3352986031709923790">શોધ વિસ્તારના સૌથી ઉપર જમણા ખૂણે: જમણી બાજુ <ph name="RIGHT"/>%, સૌથી ઉપર <ph name="TOP"/>%</translation>
<translation id="120745000989996104">તમારા એકાઉન્ટમાંનો Browther ડેટા</translation>
<translation id="3369405342922656244">'છબી વડે શોધ' સુવિધા વડે આ પેજ શોધો</translation>
<translation id="7173761126541905083">તમારા ફોન પર Browther વડે તમારા પાસવર્ડનો ઉપયોગ કરો</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">વર્તમાન Browther પ્રોફાઇલ પર સ્વિચ કરીએ?</translation>
<translation id="3412460710772753638">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="4282363917570905631">તમારા ફોન પર Browther વડે Safe Browsingમાં વધારેલી સુરક્ષા વિસ્તૃત કરો</translation>
<translation id="986094398735583155">Braveને તમારું બનાવી રહ્યા છીએ...</translation>
<translation id="3266047225484320321">જ્યારે તમે ચેડાં કરવામાં આવેલા પાસવર્ડ વડે સાઇન ઇન કરશો ત્યારે Browther તમને સૂચિત કરશે</translation>
<translation id="3508047337876211050">આ, <ph name="ITEMS_COUNT"/> આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Browther માં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> વડે એક Browther પ્રોફાઇલથી બીજી Browther પ્રોફાઇલ પર સ્વિચ કરી શકાય છે</translation>
<translation id="7225005776233199285">કૃપા કરીને બધી Browther વિંડોઝ બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="5465054931427475969">તમારી વિન્ડો શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Browther માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> દ્વારા પહેલેથી જ સાઇન ઇન કરવામાં આવ્યું છે.  તમારું બ્રાઉઝિંગ અલગ રાખવા માટે, તમારી પોતાની પ્રોફાઇલમાં Braveમાં <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="8133590217245064579">તમારી સ્ક્રીન શેર કરવા માટે, સિસ્ટમના સેટિંગમાં Browther માટે સ્ક્રીન રેકોર્ડિંગની મંજૂરી આપો.</translation>
<translation id="3597003331831379823">વધારેલા વિશેષાધિકારો સાથે સેટઅપ ચલાવવામાં નિષ્ફળ રહ્યાં. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Braveમાં સાઇન ઇન કરો</translation>
<translation id="2492221622209669678">આ વ્યક્તિનો બ્રાઉઝિંગ ડેટા આ ડિવાઇસમાંથી ડિલીટ કરવામાં આવશે. આ ડેટા પાછો મેળવવા માટે, Braveમાં <ph name="USER_EMAIL"/> તરીકે સાઇન ઇન કરો.</translation>
<translation id="6793778233257855801"><ph name="ORIGIN"/>માંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Braveમાં સાઇન ઇન કરો.</translation>
<translation id="3667616615096815454">ઇન્સ્ટૉલ કરી શકતા નથી, સર્વર માટે આ ઍપ્લિકેશન અજાણી છે.</translation>
<translation id="5585500151754164442">તમારા Browther એકાઉન્ટમાંનો Braveનો બધો ડેટા એન્ક્રિપ્ટ કરવા માટે તમારા <ph name="BEGIN_LINK"/>પોતાના પાસફ્રેઝ<ph name="END_LINK"/>નો ઉપયોગ કરો. Google Payમાંથી ચુકવણી પદ્ધતિઓ અને સરનામા એન્ક્રિપ્ટ કરવામાં આવશે નહીં. Braveમાંથી બ્રાઉઝિંગ ઇતિહાસ સિંક થશે નહીં.</translation>
<translation id="404323216042159951">Browther તમારા પાસવર્ડ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="5004936474632127765">નવા Browther &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="6236643159256182256">મનગમતું બનાવવા અને અન્ય હેતુઓ માટે, Browther અને Braveની અન્ય સેવાઓ લિંક કરો</translation>
<translation id="3729187154190517324">"ટૅબ અને વધુ ઉમેરો" બટનનો ઉપયોગ કરીને એકથી વધુ ટૅબ, ફાઇલો અને ટૂલ ઉમેરીને તમારી શોધને વધુ ઊંડી બનાવો.</translation>
<translation id="1400697664933775238">Browther પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="2461315395128103158">શા માટે Browther અમુક ડાઉનલોડ કરેલી ફાઇલને બ્લૉક કરે છે તે જાણો</translation>
<translation id="8058420662026104226">જો કંઈપણ માટે તમારા રિવ્યૂની જરૂર હોય, તો Browther તમને જણાવશે</translation>
<translation id="3177448557921912221">Browther પ્રોફાઇલ તમને તમારા જીવનના વિવિધ ભાગોને અલગ-અલગ રાખવામાં મદદ કરે છે. હમણાં જ નવી પ્રોફાઇલ ઉમેરો.</translation>
<translation id="1541177876035612043">તમે જે પેજની મુલાકાત લેવાની શક્યતા વધુ હોય, Browther તેને પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થઈ શકે</translation>
<translation id="3810973564298564668">મેનેજ કરો</translation>
<translation id="1117103475254549453">તમારા સાચવેલા પાસવર્ડનો ઉપયોગ કરવા માટે, QR કોડને ફૉલો કરો, iOS માટે Browther ડાઉનલોડ કરો અને તમારા Browther એકાઉન્ટમાં સાઇન ઇન કરો</translation>
<translation id="8880695882192156860">Browther ટિપ: Safe Browsingમાં વધારેલી સુરક્ષા</translation>
<translation id="3846683726093018685">**સારાંશ આપો:** 30થી ઓછા શબ્દોવાળા એક વાક્યમાં, સ્ક્રીનશૉટમાં આપેલા કન્ટેન્ટના મુખ્ય વિષય અને તેના હેતુનું વર્ણન કરો.

          **પ્રશ્નો સૂચવો:** સ્ક્રીનશૉટને બહેતર રીતે સમજવા માટે વપરાશકર્તા પૂછી શકે તેવા 3-5 વિચારપ્રેરક પ્રશ્નોની બુલેટવાળી સૂચિ જનરેટ કરો. આ પ્રશ્નોમાં ઓછામાં ઓછો એક પ્રશ્ન એવો હોવો જોઈએ કે જે ખાસ કરીને કોઈ વિઝ્યુઅલ ઑબ્જેક્ટ, તેની ડિઝાઇન કે તેના પ્લેસમેન્ટ વિશે હોય.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> - Browther Origin</translation>
<translation id="3885770153807205175">ભાષા પિકર</translation>
<translation id="4861846616763552424">Braveને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. તમારે ક્યાંક ધ્યાન આપવાની જરૂર છે - વિગતો માટે ક્લિક કરો.</translation>
<translation id="6126366281251241386">Browther ને ખોલવા માટે તમારા નામને ક્લિક કરો અને બ્રાઉઝ કરવાનું પ્રારંભ કરો.</translation>
<translation id="3892148308691398805">ટેક્સ્ટ કૉપિ કરો</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> આ Browther પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, Browther તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="3821553157234855663">તમારા Braveને કસ્ટમાઇઝ કરો</translation>
<translation id="3941890832296813527">ઇન્સ્ટૉલ કરવામાં ભૂલ: ઇન્સ્ટૉલરની ફાઇલનું નામ અમાન્ય અથવા અનસપોર્ટેડ છે.</translation>
<translation id="6482299900191767005">Browther પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="5853011008278898603">તમે તમારા Browther એકાઉન્ટમાં સાચવેલા તમારા પાસવર્ડ, ચુકવણી પદ્ધતિઓ અને સરનામા આ ડિવાઇસમાંથી કાઢી નાખવામાં આવશે. Braveમાં તેનો ફરીથી ઉપયોગ કરવા માટે, પાછું સાઇન ઇન કરો.</translation>
<translation id="395904275706073188">સંરક્ષિત પેજ વાંચી શકાતા નથી. કોઈ અલગ પેજ અજમાવી જુઓ.</translation>
<translation id="1832973663231751701">Braveની તમને સલામત રાખવાની રીત વિશે જાણો</translation>
<translation id="4531502594774670767">તમે જ્યારે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે સૂચનો મેળવવા માટે Browther તમે જે ટાઇપ કરો છો તેને તમારી સંસ્થાના શોધ, AI અને એજન્ટ ટૂલ પર મોકલે છે.</translation>
<translation id="300013383485253006">Browther for Testing વિશે</translation>
<translation id="1152920704813762236">ChromeOS વિશે</translation>
<translation id="8126752030994997015">જ્યારે તમે કોઈ સાઇટની મુલાકાત લો, ત્યારે પ્રાઇવસી સર્વર મારફતે Browther <ph name="BEGIN_LINK"/>Google Safe Browsing<ph name="END_LINK"/>ને તે સાઇટના URLનો વાંચવામાં મુશ્કેલ બનાવેલો ભાગ મોકલે છે, જે તમારા IP ઍડ્રેસને છુપાવે છે. જો સાઇટ પર કોઈ શંકાસ્પદ ઍક્ટિવિટી દેખાય, તો સંપૂર્ણ URLs અને પેજ કન્ટેન્ટના બિટ પણ મોકલવામાં આવે છે.</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_LINUX_OSS"/>Linux ડેવલપમેન્ટ એન્વાયરમેન્ટ<ph name="END_LINK_LINUX_OSS"/>ની જેમ, ChromeOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS"/>ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS"/> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="4022972681110646219">સ્ક્રીનનો અનુવાદ કરો</translation>
<translation id="4023601594785368013">મૂળ ભાષા: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">કોઈપણ ઍપમાંથી લિંકને Braveમાં ખોલો. વધુમાં, સરળ ઍક્સેસ માટે તે તમારા ટાસ્કબારમાં પિન કરવામાં આવે છે.</translation>
<translation id="3437506136408403836"><ph name="BEGIN_LINK"/>વર્તમાન સેટિંગ<ph name="END_LINK"/>ની જાણ કરીને Braveને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="4050175100176540509">નવીનતમ વર્ઝનમાં મહત્ત્વપૂર્ણ સુરક્ષા સુધારણાઓ અને નવી સુવિધાઓ ઉપલબ્ધ છે.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="2164947358785939495">તમારા કમ્પ્યૂટર પરના અન્ય પ્રોગ્રામ દ્વારા કોઈ એક્સ્ટેન્શન ઉમેરવામાં આવ્યું છે જેનાથી Braveની કામ કરવાની રીતમાં ફેરફાર થઈ શકે છે.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{જ્યારે 1 મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}one{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}other{જ્યારે # મિનિટ સુધી Braveનો ઉપયોગ કરવામાં ન આવે, ત્યારે તમારી સંસ્થા તેને ઑટોમૅટિક રીતે બંધ કરી નાખે છે. બ્રાઉઝિંગ ડેટા ડિલીટ કરવામાં આવે છે. આમાં ઇતિહાસ, ઑટોમૅટિક રીતે ભરવાની સુવિધા અને ડાઉનલોડ કરેલું કન્ટેન્ટ શામેલ હોઈ શકે છે.}}</translation>
<translation id="1535413545339990419">Browther વિશે પેજ પર જાઓ</translation>
<translation id="692283249649018289">તમારા બ્રાઉઝરને કોઈ નવો દેખાવ આપવા માટે Braveને કસ્ટમાઇઝ કરો</translation>
<translation id="6375229634133804834">તમારા Braveને કસ્ટમાઇઝ કરો</translation>
<translation id="4148957013307229264">ઇન્સ્ટોલ કરી રહ્યું છે...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - નેટવર્ક સાઇન ઇન - Browther</translation>
<translation id="2911246138082876798">Browther માટે શ્રેષ્ઠ એપ્લીકેશન્સ, રમતો, એક્સટેન્શન્સ અને થીમ્સ શોધો.</translation>
<translation id="2528977475313334293">તમારા બધા કમ્પ્યૂટર પર આ એક્સ્ટેન્શન અને અન્ય ઘણું બધું મેળવવા માટે Braveમાં સાઇન ઇન કરો</translation>
<translation id="8244267655940711467">તમારા માતાપિતાની પસંદગીઓ સાથે ઑનલાઇન વધુ સલામત રહેવા માટે, તમારી Browther પ્રોફાઇલ પર સ્વિચ કરો, જેમાં તમે પહેલેથી <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="4222932583846282852">રદ કરી રહ્યાં છીએ…</translation>
<translation id="4224210481850767180">ઇન્સ્ટૉલેશન રદ કરવામાં આવ્યું છે.</translation>
<translation id="8219359042845534271">તમારા Browther ડેટાને આ એકાઉન્ટ સાથે લિંક કરીએ?</translation>
<translation id="5520777668172961882">સાઇટ પરથી માનક સંરક્ષણ કરતા વધુ ડેટા વિશ્લેષિત કરીને, Braveને પણ પહેલાંથી જાણ ન હોય તેવી ખતરનાક સાઇટ વિશે તમને ચેતવણી આપે છે. તમે Browther ચેતવણીઓને છોડી દેવાનું પસંદ કરી શકો છો.</translation>
<translation id="2014920019837536689">Braveમાંથી સાઇન આઉટ કરો</translation>
<translation id="4341512411059715879">Browther સાથે સહાય મેળવો</translation>
<translation id="4281844954008187215">સેવાની શરતો</translation>
<translation id="322492684764924424">અમઉલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ થયું. જો Browther હાલમાં ચાલી રહ્યું હોય, તો તેને બંધ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="3813060261346666066">Braveમાંથી પાસવર્ડની નિકાસ કરો</translation>
<translation id="4304713468139749426">પાસવર્ડ મેનેજર</translation>
<translation id="4334241893986177674">આ સ્ક્રીનશૉટ શોધો</translation>
<translation id="4334294535648607276">ડાઉનલોડ પૂર્ણ.</translation>
<translation id="2177954934431828302">જ્યારે Windows શરૂ થાય, ત્યારે Browther લૉન્ચ કરો</translation>
<translation id="2472318668926455009">Braveને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરીને તમે જાણતા હો, તમને ગમતી હોય અને તમને વિશ્વાસપાત્ર હોય એવી સુવિધાઓનો સરળતાથી ઍક્સેસ મેળવો. ઝડપી ઍક્સેસ માટે Braveને તમારા ટાસ્કબાર પર પિન કરવામાં આવશે.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> માટે જરૂરી છે કે તમે આ ડિવાઇસનો ઉપયોગ કરતા પહેલાં નીચે આપેલી સેવાની શરતો વાંચો અને તેને સ્વીકારો. આ શરતો ChromeOSની શરતોમાં વધારો કરતી નથી, તેમાં ફેરફાર કરતી નથી અથવા તેને મર્યાદિત કરતી નથી.</translation>
<translation id="2897580280700805340">છતાં પણ Braveમાંથી બહાર નિકળવું છે?</translation>
<translation id="4413205837991854510">'છબી વડે શોધ' સુવિધા માટેનો શૉર્ટકટ હંમેશાં બતાવો</translation>
<translation id="2454897022983434851">Braveને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Browther તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/>}one{Browther તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/>}other{Browther તમને તેમને કાઢી નાખવાનો સુઝાવ આપે છે. <ph name="BEGIN_LINK"/>સપોર્ટેડ એક્સ્ટેન્શન વિશે વધુ જાણો<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Browther ને કસ્ટમાઇઝ અને નિયંત્રિત કરો</translation>
<translation id="4427306783828095590">વધારેલી સુરક્ષા ફિશિંગ અને માલવેરને બ્લૉક કરવામાં વધુ સહાયરૂપ થાય છે</translation>
<translation id="4434353761996769206">ઇન્સ્ટૉલરની ભૂલ <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> Braveને મેનેજ કરે છે</translation>
<translation id="4007482010626246887">Browther પ્રોફાઇલ ઉમેરો</translation>
<translation id="6888322430074420631">Browther for Testing વિશે</translation>
<translation id="8912436499620582668">તમારા Browther એકાઉન્ટમાં Braveના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, તમારો પાસફ્રેઝ દાખલ કરો</translation>
<translation id="4493028449971051158">સ્ટાર્ટઅપ દરમિયાન ભૂલ: કૃપા કરીને ઇન્સ્ટૉલરને ઍડમિનિસ્ટ્રેટર તરીકે ચલાવો.</translation>
<translation id="4501471624619070934">ઇન્સ્ટૉલેશન નિષ્ફળ ગયું કારણ કે આ દેશમાં ઍક્સેસ પ્રતિબંધિત છે.</translation>
<translation id="8976207309012239417">આ એક્સ્ટેન્શન દ્વારા તેની ડેટા એકત્રિત કરવાની અને તેનો ઉપયોગ કરવાની રીત જેવી પ્રાઇવસી પ્રૅક્ટિસ પબ્લિશ કરવામાં આવી નથી. Browther તેને કાઢી નાખવાનો સુઝાવ તમને આપે છે.</translation>
<translation id="8888202093812883067">Browther Origin પર આપનું સ્વાગત છે; નવી બ્રાઉઝર વિન્ડો ખોલી છે</translation>
<translation id="6391148383688605718">તમારી આસપાસના વિસ્તારો અને તમારા હાથને ટ્રૅક કરવા માટે, Braveને પરવાનગીની જરૂર છે</translation>
<translation id="7756445485815468244">તમે પહેલેથી Braveની અન્ય પ્રોફાઇલમાં <ph name="USER_EMAIL_ADDRESS"/> તરીકે સાઇન ઇન થયા છો</translation>
<translation id="137435413163730206">Browther દ્વારા પેજ પહેલેથી લોડ કરવામાં આવે છે, જેને કારણે બ્રાઉઝ કરવાની અને શોધવાની ક્રિયા વધુ ઝડપી બને છે. <ph name="BEGIN_LINK"/>પહેલેથી લોડ કરેલા પેજ વિશે વધુ જાણો<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">જ્યારે તમે તમને હાનિકારક લાગતી સાઇટની જાણ કરો, ત્યારે દરેક જણ માટે ઑનલાઇન સલામતી બહેતર બનાવો.</translation>
<translation id="3266647901351304597">Browther દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું કારણ કે તમે Safe Browsingની સુવિધા બંધ કરેલી છે અને ફાઇલની ચકાસણી કરી શકાતી નથી</translation>
<translation id="6980208900390333646">તમારા ફોન પર Browther વડે Google Lens અજમાવી જુઓ</translation>
<translation id="4594305310729380060">આ ડિવાઇસ પર Password Managerમાં</translation>
<translation id="5282047884678321451">Browther Origin ઍપ્લિકેશનો</translation>
<translation id="4598116752460667024">સૂચિમાંથી કોઈપણ પ્રક્રિયા શોધો.</translation>
<translation id="4970880042055371251">ChromeOSનું વર્ઝન</translation>
<translation id="4482468019601425607">અપ ટૂ ડેટ થવામાં છે! અપડેટ સમાપ્ત કરવા માટે Browther ને ફરીથી લોંચ કરો.</translation>
<translation id="5517890123509214766">Braveના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ Braveને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે</translation>
<translation id="7690070364551268156">જો તમે Braveના વપરાશના રિપોર્ટ પણ શેર કરતા હો, તો તે રિપોર્ટમાં તમે મુલાકાત લો છો તે URLs શામેલ હોય છે</translation>
<translation id="5020487088453637212">બીજા કમ્પ્યુટર (<ph name="HOST_NAME"/>) પર પ્રોફાઇલ બીજી Browther પ્રક્રિયા (<ph name="PROCESS_ID"/>) દ્વારા ઉપયોગમાં હોય એવું લાગે છે. Browther એ પ્રોફાઇલને લૉક કરી છે જેથી તે દૂષિત ન થઈ જાય. જો તમને ખાતરી છે કે કોઈ અન્ય પ્રક્રિયાઓ આ પ્રોફાઇલનો ઉપયોગ કરી રહી નથી, તો તમે પ્રોફાઇલને અનલૉક કરી અને Browther ને ફરીથી લોંચ કરી શકો છો.</translation>
<translation id="4680828127924988555">ઇન્સ્ટૉલેશનની પ્રક્રિયા રદ કરો</translation>
<translation id="8134827615154347946">Braveનો તમારો અમુક ડેટા હજી સુધી તમારા Browther એકાઉન્ટમાં સાચવવામાં આવ્યો નથી. સાઇન આઉટ કરતા પહેલાં થોડી મિનિટ રાહ જોવાનો પ્રયાસ કરી જુઓ. જો તમે હમણાં જ સાઇન આઉટ કરશો, તો આ ડેટા ડિલીટ કરવામાં આવશે.</translation>
<translation id="3508712423420506333">જ્યારે તમે સાઇન ઇન કર્યું હોય, ત્યારે તમે Braveમાં તમારા Browther એકાઉન્ટમાંથી તમારા પાસવર્ડ અને વધુનો ઉપયોગ કરી શકો છો. <ph name="SHORTCUT"/> તમારા Braveની સેવાઓના સેટિંગ બદલી શકે છે.</translation>
<translation id="2388739442635757494">કોઈએ આ કોમ્પ્યુટર પર પહેલા <ph name="ACCOUNT_EMAIL_LAST"/> તરીકે Braveમાં સાઇન ઇન કર્યું છે. તમારી માહિતી અલગ રાખવા માટે કૃપા કરીને નવો Browther વપરાશકર્તા બનાવો.</translation>
<translation id="4724676981607797757">અનસપોર્ટેડ પ્રોટોકૉલ ભૂલને કારણે ઇન્સ્ટૉલેશન નિષ્ફળ રહ્યું.</translation>
<translation id="8305313684264112434">છતાં પણ Browther બંધ કરવું છે?</translation>
<translation id="418155915144835101">Browther માટેનું એક વિશિષ્ટ સુરક્ષા અપડેટ હમણાં જ લાગુ કરવામાં આવ્યું. હવે ફરી શરૂ કરો અને અમે તમારાં ટૅબની પુનઃસ્થાપના કરીશું.</translation>
<translation id="2683970367518529374">Braveને પૂછો</translation>
<translation id="5064473048847774331">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Browther દ્વારા <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>ની અને વધુ <ph name="COUNT"/> પરવાનગી કાઢી નાખવામાં આવી.</translation>
<translation id="5941343075741207533">Browther તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરજો અથવા <ph name="BEGIN_LINK"/>તમારા Browther એકાઉન્ટમાં પાસવર્ડ ચેક કરો<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">આ પણ Brave Searchમાં જે જોડણી તપાસનારનો ઉપયોગ થાય છે તેનો જ ઉપયોગ કરે છે. તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Braveને મોકલવામાં આવે છે. તમે સેટિંગમાં આ વર્તણૂકને હંમેશાં બદલી શકો છો.</translation>
<translation id="4581078588976787792">એકાઉન્ટ વગર Braveનો ઉપયોગ કરો</translation>
<translation id="3394520491703535051">mDNS ટ્રાફિકને મંજૂરી આપવા Browther Origin માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="6563126962881169552">&amp;Browther અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="4918086044614829423">સ્વીકારો</translation>
<translation id="4918844574251943176">છબી કૉપિ કરી</translation>
<translation id="5240982928057703861">Browther બૅકગ્રાઉન્ડ મોડમાં છે.</translation>
<translation id="3603134280602182991">Braveમાં સાઇન ઇન કરવાનો સંવાદ બંધ કરવા માટે ક્લિક કરો</translation>
<translation id="6120233890602288442">Browther પ્રોફાઇલ વડે, તમે તમારી બધી વસ્તુઓ Browther પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="5722688387568011881">અતિથિઓ કંઈપણ પાછળ છોડ્યાં વિના Browther નો ઉપયોગ કરી શકે છે.</translation>
<translation id="7786958592460743302">Braveમાં તમારું એકાઉન્ટ</translation>
<translation id="9114640791491590337">સ્વયંને Browther માં ઉમેરો</translation>
<translation id="3536391594566515053">Gemini in Browther તમારા ટૅબમાં કામ કરવા માટે ઑટોમૅટિક રીતે બ્રાઉઝ કરવાની સુવિધાનો ઉપયોગ કરે છે અને તમે તેને આપેલા કાર્યો પૂર્ણ કરે છે. <ph name="LINK_BEGIN"/>વધુ જાણો<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">Braveને તમારા હાથ ટ્રૅક કરવા માટે પરવાનગીની જરૂર છે</translation>
<translation id="1627123463102858476">તમે તાજેતરમાં આ સાઇટની મુલાકાત લીધી નથી. Browther દ્વારા <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>ની પરવાનગીઓ કાઢી નાખવામાં આવી.</translation>
<translation id="5174969993834422967">તમે સામાન્ય રીતે નોટિફિકેશનને બ્લૉક કરો છો. આ સાઇટ તમને સૂચિત કરી શકે તે માટે, તમારા લોકેશન બારના જમણા ખૂણે દેખાતા નોટિફિકેશનના આઇકન પર ક્લિક કરો.</translation>
<translation id="5174983315706567306">પર્યાપ્ત ડિસ્ક સ્પેસ નથી.</translation>
<translation id="7091313576354542088">Browther એકાઉન્ટને પુન:પ્રમાણીકરણની જરૂર છે</translation>
<translation id="9045390598305758496">કોઈ સાચવેલા પાસવર્ડ નથી. જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Browther તેને ચેક કરી શકે છે.</translation>
<translation id="5686724084351858452">Braveમાંથી સાઇન આઉટ કરો</translation>
<translation id="5234764350956374838">કાઢી નાખો</translation>
<translation id="5254739261293693943">આ વીડિયો વિશે પૂછો</translation>
<translation id="8165028066129227692">તમારા ફેરફારો લાગુ કરવા માટે, Braveને ફરી લૉન્ચ કરો</translation>
<translation id="5286907366254680517">ભાળ મળી</translation>
<translation id="198210130507193824">Browther ઍપ મેળવો</translation>
<translation id="8472078903122489041">Browther અપડેટર આંતરિક સેવા</translation>
<translation id="5346389065299425353">એકથી વધુ ટૅબ, ફાઇલો અને ટૂલ ઉમેરીને તમારી શોધને વધુ ઊંડી બનાવો</translation>
<translation id="3904682305383981098">Braveને તમારા રિવ્યૂ માટે કેટલાક સલામતી સંબંધિત સુઝાવો મળ્યા છે</translation>
<translation id="509616246140011182">અન્ય Browther પ્રોફાઇલ</translation>
<translation id="8214429210535362385">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Browther પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો Browther ડેટા, જેમ કે ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME"/>થી જોડાયેલા રહેશે. તમે Browther એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">વધારાનો કોડ: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">મનગમતું બનાવવાની સુવિધા મેળવવા માટે, Braveમાં વેબ અને ઍપ ઍક્ટિવિટી ઉમેરો</translation>
<translation id="8096544113811780871">Browther શા માટે અમુક ફાઇલો બ્લૉક કરે છે, તે જાણો</translation>
<translation id="2384387444932590174">Browther અપડેટ થઈ રહ્યું છે (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">Braveમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="6557334704331248411">Browther માંથી દૂર કરો</translation>
<translation id="5832041381258620673">પર્ફોર્મન્સ ઘટાડે છે પરંતુ Braveને અટૅક સામે વધુ પ્રતિરોધક બનાવે છે</translation>
<translation id="3763317028635993788">Braveને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="862357563072119126"><ph name="PAGE_TITLE"/> - Browther Origin બીટા</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{Braveનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}one{Braveનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યું હોય એવા ટૅબને થોભાવી દો}other{Braveનો સુઝાવ છે કે તમારા બ્રાઉઝરની સ્પીડને ધીમી કરી રહ્યાં હોય એવા ટૅબને થોભાવી દો}}</translation>
<translation id="4423621904097888155">આ Linux વિતરણ સિસ્ટમ પર Browther હવે સપોર્ટ કરતું ન હોવાથી કદાચ તે યોગ્ય રીતે કાર્ય ન કરે</translation>
<translation id="6201726364919996698">Browther દ્વારા આ ડાઉનલોડ બ્લૉક કરવામાં આવ્યું છે, કારણ કે આ ફાઇલ તમારા વ્યક્તિગત અને સોશિયલ નેટવર્ક એકાઉન્ટને નુકસાન પહોંચાડી શકે છે</translation>
<translation id="7679204468655335605">Braveને આ સાઇટ સાથે તમારું સ્થાન શેર કરવા માટે તમારા સ્થાનના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="1163572992704966942">કૃપા કરીને Browther, નવીનતમ સિસ્ટમ અપડેટ્સ ઇન્સ્ટોલ કરે ત્યાં સુધી રાહ જુઓ.</translation>
<translation id="5050118226119231029">Browther પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="5524890928877629608">શોધ વિસ્તારના સૌથી ઉપર ડાબા ખૂણે: ડાબી બાજુ <ph name="LEFT"/>%, સૌથી ઉપર <ph name="TOP"/>%</translation>
<translation id="5875549039106594731">Braveમાં PDFs ખોલો</translation>
<translation id="5536164441519929134">આ ટૅબ વિશે<ph name="LINE_BREAK"/>પૂછો</translation>
<translation id="5579324208890605088">સ્ટાર્ટઅપ દરમિયાન ભૂલ: કૃપા કરીને ઇન્સ્ટૉલરને નિયમિત વપરાશકર્તા તરીકે ચલાવો, ઍડમિનિસ્ટ્રેટર તરીકે નહીં.</translation>
<translation id="202315329304302571">ડિફૉલ્ટ તરીકે Braveનો ઉપયોગ કરો અને તેને પિન કરો</translation>
<translation id="5596627076506792578">વધુ વિકલ્પો</translation>
<translation id="5605834417512968703">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કંઈપણ પસંદ કરો અથવા 'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે Escape કી દબાવો</translation>
<translation id="5618818588972826921">'છબી વડે શોધ' સુવિધા વડે શોધવા માટે કોઈપણ ટેક્સ્ટ અથવા છબી પસંદ કરો અથવા 'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે Escape દબાવો</translation>
<translation id="5823076755666406442">{0,plural, =0{Browther અપડેટ ઉપલબ્ધ છે}=1{Browther અપડેટ ઉપલબ્ધ છે}one{Browther અપડેટ # દિવસ માટે ઉપલબ્ધ છે}other{Browther અપડેટ # દિવસ માટે ઉપલબ્ધ છે}}</translation>
<translation id="8414129876440043675">જ્યારે તમે Browther બંધ કરો, ત્યારે હંમેશાં તમારા ડિવાઇસમાંથી સાઇટનો ડેટા ડિલીટ કરો</translation>
<translation id="5156991567152325333">કૃપા કરીને હવે Browther ફરી શરૂ કરો</translation>
<translation id="5710072384986281834">dev&amp;din Inc</translation>
<translation id="1536693367017293028">આ ભાષામાં Browther બતાવો</translation>
<translation id="569897634095159764">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. પ્રૉક્સી સર્વરને પ્રમાણીકરણની જરૂર છે.</translation>
<translation id="4215338057953170891">Browther પ્રોફાઇલ તમને વ્યક્તિગત બ્રાઉઝિંગ અને ઑફિસ માટેનું બ્રાઉઝિંગ અલગ-અલગ રાખવા દે છે. હમણાં જ નવી પ્રોફાઇલ ઉમેરો.</translation>
<translation id="5366435608642317052">નિષ્ક્રિય ટૅબમાંની મેમરી Browther દ્વારા ઉપયોગમાં લેવામાં આવે છે. આને કારણે Browther ટૅબ અને અન્ય ઍપને કમ્પ્યૂટરના વધુ સંસાધનો ફાળવીને પોતાને ઝડપી રાખી શકે છે. જ્યારે તમે તમારા નિષ્ક્રિય ટૅબ પર પાછા ફરો, ત્યારે તે ફરીથી ઑટોમૅટિક રીતે સક્રિય થાય છે. <ph name="BEGIN_LINK"/>મેમરી સેવર વિશે વધુ જાણો<ph name="END_LINK"/></translation>
<translation id="4941518395341035738">જો તમે તમારો પાસફ્રેઝ ભૂલી ગયા હો અથવા આ સેટિંગ બદલવા માગતા હો, તો તમારા એકાઉન્ટમાંનો Braveનો ડેટા <ph name="SETTINGS_LINK"/></translation>
<translation id="7763291835437810978">Braveને કસ્ટમાઇઝ અને તેનું નિયંત્રણ કરો. Braveને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો.</translation>
<translation id="5809516625706423866">ઇન્ટરનેટ સાથે કનેક્ટ કરી શકતા નથી. HTTP 401 અનધિકૃત. કૃપા કરીને તમારું પ્રૉક્સી કન્ફિગ્યુરેશન ચેક કરો.</translation>
<translation id="1827132270895283425">Braveના V8 એન્જિન વડે સાઇટની ગતિ વધારે છે પરંતુ Braveને અટૅક સામે થોડું ઓછું પ્રતિરોધક બનાવે છે. આ સેટિંગ બંધ છે.</translation>
<translation id="1553025851718680114">તમારા Browther એકાઉન્ટમાં Braveના ડેટાનો ઉપયોગ કરવા અને તેને સાચવવા માટે, Browther અપડેટ કરો</translation>
<translation id="5824893331272123205">આ પૅનલ લોડ કરી શકાઇ નથી, ફરી પ્રયાસ કરો</translation>
<translation id="6642862349634944253">Browther Origin માં સ્વાગત છે</translation>
<translation id="5871205389137001634">'છબી વડે શોધ' સુવિધામાંથી બહાર નીકળવા માટે ક્લિક કરો</translation>
<translation id="7586794330537887406">Braveને આ આઇટમમાં માલવેર હોવાનું જાણવા મળ્યું છે:</translation>
<translation id="1666897346518812892">Browther નિયમિત રીતે ચેક કરીને એ વાતની ખાતરી કરતું રહે છે કે તમારા બ્રાઉઝરના સેટિંગ સૌથી સલામત છે. જો કોઈ બાબતનો રિવ્યૂ કરવો જરૂરી હશે તો અમે તમને તેની જાણ કરીશું.</translation>
<translation id="5895138241574237353">પુનઃપ્રારંભ કરો</translation>
