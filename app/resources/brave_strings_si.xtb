<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="1026101648481255140">ස්ථාපනය නැවත ආරම්භ කරන්න</translation>
<translation id="7099479769133613710">&amp;ChromeOS යාවත්කාලීන කිරීමට යළි දියත් කරන්න</translation>
<translation id="7264054672589027446">Browther ඔබට මෙම දිගුව සමාලෝචනය කිරීමට නිර්දේශ කරයි</translation>
<translation id="7848219163187166649">අඩවියක් ඒවායේ පිටුවේ සබැඳි පෞද්ගලිකව පූර්ව පූරණය කිරීමට ඉල්ලා සිටින විට, Browther Browther සේවාදායක භාවිත කරයි. මෙය පූර්ව පූරණය කර ඇති අඩවියෙන් ඔබේ අනන්‍යතාව සඟවන නමුත්, Browther පූර්ව පූරණය කරනු ලබන අඩවි මොනවා දැයි ඉගෙන ගනියි.</translation>
<translation id="1065672644894730302">ඔබේ තේරීම් කියවිය නොහැක.

ඇතැම් විශේෂාංගයන් නොපැවතිය හැකි අතර තේරීම් වල සිදුකරන වෙනස්ක්ම් නොසුරැකෙනු ඇත.</translation>
<translation id="8837164267124113709">ඔබේ මාපියන් Browther සඳහා "වෙබ් අඩවි, යෙදුම්, සහ දිගු සඳහා වන අවසර" අක්‍රිය කර ඇත</translation>
<translation id="881513728707488138">Browther හට ඔබගේ මුරපද නිර්යාත කිරීමට අවශ්‍යය. මේ සඳහා අවසර දීමට ඔබගේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="112640046208448578">දේවල් හෝ ස්ථාන හඳුනාගෙන පෙළ පිටපත් කරන්න හෝ පරිවර්තනය කරන්න. ඔබ රූප සෙවීම භාවිත කරන විට, පිටුවේ තිර රුවක් සේවාදායකයට යවනු ලැබේ. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther ඔබේ පෙරනිමි බ්‍රව්සරය වේ</translation>
<translation id="6580138787163923852">ඔබගේ මුරපද දත්ත කඩ කිරීම්වලින් සහ අනෙකුත් ආරක්ෂක ගැටලුවලින් සුරක්ෂිතද යන්න පරීක්ෂා කිරීමට, <ph name="BEGIN_LINK"/>Browther වෙත පුරන්න<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther මෙනුව ක්ලික් කරන්න</translation>
<translation id="1157985233335035034">මෑත භාෂා</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> විසින් Browther ක්‍රියා කරන ආකාරය වෙනස් කළ හැකි දිගුවක් එක් කර ඇත.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">ඔබේ Windows අනුවාදය සඳහා සහය නොදක්වන නිසා ස්ථාපනය අසමත් විය.</translation>
<translation id="8291401179516272335">Browther පිළිබඳ</translation>
<translation id="1203500561924088507">ස්ථාපනය කිරීම වෙනුවෙන් ස්තුතියි. ඔබ <ph name="BUNDLE_NAME"/> භාවිත කිරීමට පෙර ඔබගේ බ්‍රවුසරය යළි ඇරඹිය යුතුය.</translation>
<translation id="1232234696885483911">ඔබ රූප සෙවීම විවෘත කරන විට, පිටුවේ මාතෘකාව, URL, සහ PDF ඇතුළු අන්තර්ගතය ස්වයංක්‍රීයව සේවාදායකය වෙත යවනු ලැබේ. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">ඔබ පුරනය වී සිටින අතරතුර, ඔබට Browther තුළ ඔබේ Browther ගිණුමෙන් ඔබේ මුරපද සහ තවත් ඒවා භාවිත කළ හැක මෙය වෙනස් කිරීමට, “Browther තුළ ඔබේ ගිණුම” වෙත යන්න.</translation>
<translation id="9034321258761608912">මෙම පටිත්ත අක්‍රියව තිබෙන අතරේ, Browther වේගවත්ව තබා ගැනීම සඳහා මතකය නිදහස් කරන ලදි. ඔබට මෙම අඩවිය අක්‍රිය වීමෙන් සැම විට බැහැර කිරීමට තෝරා ගත හැක.</translation>
<translation id="249571811018731941">ගොනුව භයානක නිසා Browther මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> සමග Gmail හෝ YouTube වැනි Browther සේවාවලට පුරන විට, ඔබට එම ගිණුමෙන්ම Browther වෙත ස්වයංක්‍රීයව පුරනය විය හැක</translation>
<translation id="1290883685122687410">පිහිටුවීමේ දෝෂයකි: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">ඔබගේ නව Browther පැතිකඩ පිහිටුවන්න</translation>
<translation id="4437862975743821367">බ්ලූටූත් උපාංග ගවේෂණය කිරීමට Browther හට බ්ලූටූත් ප්‍රවේශය අවශ්‍යයි.<ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">භාෂාව අනාවරණය කරන්න</translation>
<translation id="1206925267243987362">Browther නිර්දේශිත බ්‍රව්සර සැකසීම් භාවිතා කරන්න</translation>
<translation id="8270483548049772782">Browther වෙතින් ද දත්ත මකන්න (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">අමුණන ලදි! ඔබට මෙවලම් තීරුවේ ඇති නව බොත්තමෙන් රූප සෙවීම වෙත නැවත ප්‍රවේශ විය හැක</translation>
<translation id="1356661055722410047">අලුත්! ඔබට ඔබේ තිරයේ ඇති පෙළ සහ පින්තූර දෙකම පරිවර්තනය කළ හැක</translation>
<translation id="1383876407941801731">සොයන්න</translation>
<translation id="1592588950737518481">&amp;Browther පැතිකඩ කළමනාකරණය කරන්න</translation>
<translation id="1404026649028693342">සැම විට ම AI මාදිලිය පෙන්වන්න</translation>
<translation id="141901961143729572">ඔබේ සිතුවිලි බෙදා ගන්න</translation>
<translation id="1743952081001089298">ඔබේ කවුළුව බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ Browther සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න.</translation>
<translation id="8627385813382688019">පරීක්ෂා කිරීම සඳහා Browther සමග උදවු ලබා ගන්න</translation>
<translation id="1497802159252041924">ස්ථාපනය කිරීමේ දෝෂයක්: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">මෙම පිටුව ආරක්ෂිතයි.</translation>
<translation id="7252430412915798987">Browther පටිත්තක් බෙදා ගන්න</translation>
<translation id="6388429281015199562">Browther වෙත පිවිසෙන්න</translation>
<translation id="1547469039832541117">උද්දීපනය කළ කාර්යය නිමා කරයි.</translation>
<translation id="1801944307203212016">Browther හට ඔබේ වටපිටාවේ ත්‍රිමාන සිතියමක් සෑදීමට ඔබේ කැමරාවට ප්‍රවේශ වීමට අවසර අවශ්‍යයි</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{මෙම දිගුව තවදුරටත් සහාය නොදක්වයි. Browther ඔබ එය ඉවත් කිරීම නිර්දේශ කරයි.}one{මෙම දිගු තවදුරටත් සහාය නොදක්වයි. Browther ඔබ ඒවා ඉවත් කිරීම නිර්දේශ කරයි.}other{මෙම දිගු තවදුරටත් සහාය නොදක්වයි. Browther ඔබ ඒවා ඉවත් කිරීම නිර්දේශ කරයි.}}</translation>
<translation id="4667068923142532753">Browther අමුණන්න</translation>
<translation id="3006560544901646947">Browther හි සුරක්ෂිතතා මෙවලම්</translation>
<translation id="686052171138185761">Browther හට ඔබේ මුරපද කළමනාකරු දත්ත මැකීමට අවශ්‍යයි. මෙයට ඉඩ දීමට ඔබේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="8713026329083542796">Browther හි ප්‍රධාන පෞද්ගලිකත්ව සහ ආරක්ෂක පාලන සමාලෝචනය කරන්න</translation>
<translation id="1640672724030957280">බාගනිමින්...</translation>
<translation id="1680687534629375545">මෙම පිටුව ගැන රූප සෙවීමෙන් විමසන්න</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> සඳහා උසස් වරප්‍රසාද ලබා දෙයි.</translation>
<translation id="4243382967656566037">මෙම විශේෂාංග වැඩිදියුණු කිරීමට උදවු කිරීම සඳහා, Browther ඒවා සමග ඔබේ අන්තර්ක්‍රියා Browther වෙත යවයි. මෙම දත්ත මානව සමාලෝචකයින් විසින් කියවනු ලැබීමට, සකසනු ලැබීමට සහ විවරණ කරනු ලැබීමට හැකිය.</translation>
<translation id="1722488837206509557">මෙය ඔබට පවතින උපාංගවලින් තේරීමට සහ ඒවායේ අන්තර්ගතය පෙන්වීමට ඉඩ දෙනු ඇත.</translation>
<translation id="6820510278633522408">Browther ඉක්මනින් බ්‍රවුස් කිරීමේ දත්ත මකනු ඇත</translation>
<translation id="7775028004939172516">Browther සංචාලන HTTPS වෙත උත්ශ්‍රේණි කිරීමට උත්සාහ කරනු ඇත</translation>
<translation id="6963959729951758069">Browther දත්ත හිස් කරන ලදී</translation>
<translation id="4085139922884095932">Browther <ph name="REMAINING_TIME"/>කින් යළි ඇරඹෙනු ඇත</translation>
<translation id="2586248102295515296">HTTPS නොමැති විට, Browther ඔබට අනතුරු ඇඟවීමකින් තොරව අනාරක්ෂිත සම්බන්ධතාවයක් භාවිතා කරනු ඇත</translation>
<translation id="3975328336074677101">පසුබිමේ Browther ධාවනය වීමට ඉඩ දෙන්න</translation>
<translation id="2497443204974841650">Browther ප්‍රතිස්ථාපනය කරන්න</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> සඳහා උත්සාහ කරයි</translation>
<translation id="4553225588627299783">මීළඟ වතාවේ ඔබ ඔබේ <ph name="DEVICE_TYPE"/> මත Browther විවෘත කරන විට, Browther මුරපද කළමනාකරු භාවිත කිරීමට ප්‍රේරකයක් ඔබට පෙනෙනු ඇත.</translation>
<translation id="1838374766361614909">සෙවීම හිස් කරන්න</translation>
<translation id="2337233040802538155">එය ඔබේ Browther ගිණුම තුළ තබා ගන්නා අතර මෙම උපාංගයෙන් පමණක් බ්‍රවුස් කිරීමේ දත්ත මැකීමට, <ph name="BEGIN_LINK"/>Browther වෙතින් වරන්න<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">ගමනේ දී නව පටිති සමූහ විවෘත කිරීමට හෝ තැනීමට ඔබේ දුරකථනයට Browther බාගන්න.</translation>
<translation id="2063443520349987970">ඔබට ඔබගේ පුරන ලද Browther ගිණුම් කළමනාකරණය කළ හැකිය. ඔබගේ Browther ගිණුම් Browther බ්‍රව්සරය, Play Store, Gmail සහ තවත් දේ සඳහා භාවිත කෙරේ. ඔබට පවුලේ සාමාජිකයකු වැනි, වෙනත් යම් කෙනෙකු සඳහා ගිණුමක් එක් කිරීමට අවශ්‍ය නම්, ඒ වෙනුවට ඔබගේ <ph name="DEVICE_TYPE"/> වෙත නව පුද්ගලයකු එක් කරන්න. <ph name="LINK_BEGIN"/>තව දැන ගන්න<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">රූප සෙවීම සමග සොයන්න</translation>
<translation id="1880677175115548835">පාඨය තෝරන්න</translation>
<translation id="3183933389992069620">ඔබ කළමනාකරණය කළ ගිණුමක් වෙත සයින් ඉන් වන අතර ඔබේ Browther පැතිකඩෙහි පරිපාලක පාලනය ලබා දේ. යෙදුම්, පිටු සලකුණු, ඉතිහාසය, රහස්වචන, සහ අනෙකුත් පසුතල වැනි ඔබේ Browther දත්ත ස්ථිරවම <ph name="USER_NAME"/> වෙත බැඳෙනු ඇත. Browther sync chains Dashboard හරහා මෙම දත්ත මැකීමට ඔබට හැකි වනු ඇත, නමුත් ඔබට මෙම දත්ත වෙනත් ගිණුමක් සමඟ සම්බන්ධ කළ නොහැක. ඔබේ පවතින Browther දත්ත වෙනමම තබා ගැනීමට ඔබට විකල්ප වශයෙන් නව පැතිකඩක් සෑදිය හැකිය. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther පසුබිම් ක්‍රියාකාරකම් සහ සුමට අනුචලන සහ වීඩියෝ රාමු අනුපාත වැනි දෘශ්‍ය ප්‍රයෝග සීමා කිරීමෙන් බැටරි බලය සංරක්ෂණය කරයි. <ph name="BEGIN_LINK"/>බලශක්ති සුරැකුම පිළිබඳ තව දැන ගන්න<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">මෙම පිටුව ගැන විමසන්න</translation>
<translation id="9128006428501241840">Browther යාවත්කාලීන සේවාව</translation>
<translation id="6302815314157879372">මෙය අක්‍රිය කිරීමෙන්, ඔබට Browther වෙත පුරනය නොවී Gmail වැනි Browther වෙබ් අඩවිවලට පුරනය විය හැක.</translation>
<translation id="1063611196035804685">Browther ප්‍රතිචාර නොදක්වයි. නැවත දියත් කරන්නද?</translation>
<translation id="2873360330889594383">ඔබේ සංවිධානයට, <ph name="MANAGER"/>, ඔබ Browther වෙත පුරනය වීමට අවශ්‍යයි</translation>
<translation id="4035053306113201399">යාවත්කාලීනය යෙදීමට ChromeOS යළි ඇරඹිය යුතුය.</translation>
<translation id="2861285003831382718">ගොනු වර්ගය සාමාන්‍යයෙන් බාගත නොවන නිසා සහ එය භයානක විය හැකි නිසා Browther මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="1953553007165777902">බාගනිමින්... මිනිත්තු <ph name="MINUTE"/>ක් ඉතිරිව ඇත</translation>
<translation id="2080160985220483492">Browther ඉඟිය: මුරපද සුරකින්න</translation>
<translation id="8037497710694492565">Browther හට පෙරනිමි බ්‍රව්සරය නිර්ණය කිරීමට හෝ සැකසීමට නොහැකිය</translation>
<translation id="7395009124247513849">Browther නව පටිත්තක විවෘත වන සමහර ගොනු අවහිර කරන්නේ මන්දැයි ඉගෙන ගන්න</translation>
<translation id="762710512520170632">ඔබේ Browther මෘදුකාංගය යාවත්කාලීනව තබයි. මෙම සේවාව අබල කර ඇත්නම් හෝ නතර වුවහොත්, ඔබේ Browther මෘදුකාංගය යාවත්කාලීනව නොතිබෙනු ඇත, එනම් මතු විය හැකි ආරක්ෂක අවදානම් නිරාකරණය කළ නොහැකි අතර විශේෂාංග ක්‍රියා නොකරනු ඇත. මෙම සේවාව භාවිත කරන Browther මෘදුකාංගයක් නොමැති විට එය අස්ථාපනය වෙයි.</translation>
<translation id="5793588180426267429">මෙය මෙම උපාංගයෙන් අයිතම 1ක් මකනු ඇත. ඔබගේ දත්ත පසුව ලබා ගැනීමට, <ph name="USER_EMAIL"/> ලෙස Browther වෙත පුරන්න.</translation>
<translation id="2018879682492276940">ස්ථාපනය අසාර්ථක විය. කරුණාකර නැවත උත්සාහ කරන්න.</translation>
<translation id="6351516710581760512">ඔබගේ වෙනත් මුරපද දත්ත කඩ කිරීම්වලින් සහ අනෙකුත් ආරක්ෂක ගැටලුවලින් සුරක්ෂිතද යන්න පරීක්ෂා කිරීමට, <ph name="BEGIN_LINK"/>Browther වෙත පුරන්න<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">සැකසීම්</translation>
<translation id="8194525816714210105">Browther සේවාවල වඩාත් පුද්ගලිකකරණය කළ අත්දැකීම් සඳහා Browther ඉතිහාසය ඇතුළත් කළ යුතුද යන්න තෝරන්න</translation>
<translation id="5909559127548969159">Browther හට නව පෙනුමක් ලබා දීමට නව පටිති පිටුවේ Browther අභිරුචි කරන්න බොත්තම ක්ලික් කරන්න</translation>
<translation id="2066690553719545730">සැම විට ම AI මාදිලිය පෙන්වන්න</translation>
<translation id="3283892260110318935">ගොනුව රැවටිලිකාර සහ ඔබේ උපාංගයට අනපේක්ෂිත වෙනස්කම් සිදු කළ හැකි නිසා Browther මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="6160571936643742128">ඔබ මීළඟ වතාවේ Browther iOS විවෘත කරන විට <ph name="FEATURE_NAME"/> උත්සාහ කිරීමට ඔබට ප්‍රේරකයක් පෙනෙනු ඇත.</translation>
<translation id="8380517409933452343">ඔබ ඔබේ Browther ගිණුමේ සුරකින ලද ඔබේ මුරපද සහ අනෙකුත් Browther දත්ත මෙම උපාංගයෙන් ඉවත් කරනු ලැබේ. ඒවා නැවත Browther තුළ භාවිතා කිරීමට, නැවත පුරනය වන්න.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{1 මිනිත්තුවකට Browther භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}one{මිනිත්තු #කට Browther භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}other{මිනිත්තු #කට Browther භාවිත නොකරන විට ඔබේ සංවිධානය බ්‍රවුස් කිරීමේ දත්ත ස්වයංක්‍රීයව මකයි. මෙයට ඉතිහාසය, ස්වයං පිරවුම, සහ බාගැනීම් ඇතුළත් විය හැක. ඔබේ පටිති විවෘතව පවතියි.}}</translation>
<translation id="2126108037660393668">බාගත කළ ගොනුව සත්‍යාපනය කිරීම අසමත් විය.</translation>
<translation id="2135919691573380097">මෙම අඩවිය වාර්තා කරන්න</translation>
<translation id="2137162749895930932">පරිවර්තන තිරය වසන්න</translation>
<translation id="4283559398694996391">වෙබ් අඩවිය සුරක්ෂිත සබැඳුමක් භාවිතා නොකරන නිසා සහ ගොනුව විකෘති වී ඇති නිසා Browther මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="2170098639895543546">පිටුවෙහි ඕනෑම දෙයක් තෝරන්න</translation>
<translation id="2495182092286337191">Browther අභිරුචිකරණය කරන්න</translation>
<translation id="2174917724755363426">ස්ථාපනය සම්පූර්ණ නැත. ඔබට අවලංගු කිරීමට අවශ්‍ය බව විශ්වාසද?</translation>
<translation id="4877141231724140862">Browther - ජාල පුරනය - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">යාවත්කාලීන පරීක්ෂාවේ දෝෂය: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Browther වෙතින් ගිණුම ඉවත් කරන්න</translation>
<translation id="1084363153644366288">iOS සඳහා Browther හි ඉහළ නැංවූ සුරක්ෂිත පිරික්සුම සමග ගමනේ දී ආරක්ෂිතව සිටින්න</translation>
<translation id="7949164640723239455">භයානක අඩවිය. Browther දැනුම්දීම් ඉවත් කළා.</translation>
<translation id="2236949375853147973">මගේ ක්‍රියාකාරකම්</translation>
<translation id="4536403809133456417">ඔබේ සියලු උපාංග මත ඔබේ ලිපින සහ තවත් දේ ලබා ගැනීමට, Browther වෙත පුරන්න. ඔබ පුරනය වූ පසු මෙම ලිපිනය ඔබේ Browther ගිණුම තුළ සුරකිනු ලැබේ.</translation>
<translation id="5627930103267312171">ඔබ පරිගණකයක් හුවමාරු කරන්නේ නම්, මිතුරන්ට සහ පවුලේ අයට වෙනමම බ්‍රව්ස් කළ හැකි අතර ඔවුනට අවශ්‍ය ආකාරයට Browther සකසා ගත හැකිය.</translation>
<translation id="2283803047247799269">රූප සෙවීම සමග මෙම පටිත්ත සොයන්න</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{ඔබේ බ්‍රව්සරය මන්දගාමී කරන පටිත්ත විරාම කිරීමට Browther නිර්දේශ කරයි}one{ඔබේ බ්‍රව්සරය මන්දගාමී කරන පටිති විරාම කිරීමට Browther නිර්දේශ කරයි}other{ඔබේ බ්‍රව්සරය මන්දගාමී කරන පටිති විරාම කිරීමට Browther නිර්දේශ කරයි}}</translation>
<translation id="2307973900865360088">ඩොකයේ තබන්න</translation>
<translation id="5161617112768367959">Browther තුළ ගබඩා කර ඇති අනාරක්ෂිත වෙබ් අඩවි ලැයිස්තුවක් සමඟ URL පරීක්ෂා කරයි. අඩවියක් ඔබගේ මුරපදය සොරා ගැනීමට උත්සාහ කරන්නේ නම්, හෝ ඔබ හානිකර ගොනුවක් බාගන්නා විට, Browther පිටු අන්තර්ගතයේ කැබලි ඇතුළුව, URL සුරක්ෂිත බ්‍රවුස් කිරීම වෙත යැවීමටද හැකිය.</translation>
<translation id="4123094831918713833">මෙම ක්‍රියාව පහත දේ සිදු කරනු ඇත:
        <ph name="LINE_BREAKS"/>
          • සමහර Browther සැකසීම් Browther කෙටිමං යළි සැකසීම්
          <ph name="LINE_BREAK"/>
          • දිගු අබල කිරීම
          <ph name="LINE_BREAK"/>
          • කුකී සහ වෙනත් තාවකාලික අඩවි දත්ත මැකීම
          <ph name="LINE_BREAKS"/>
          පිටුසන්, ඉතිහාසය, සහ සුරැකි මුරපද බලපෑමට ලක් නොවනු ඇත.</translation>
<translation id="5456070119344236353">මෙහි සිට ඔබගේ Android දුරකථනයට අංකයක් යැවීමට, උපාංග දෙකෙහිම Browther වෙත පුරන්න.</translation>
<translation id="2356070529366658676">විමසන්න</translation>
<translation id="2359808026110333948">කරගෙන යන්න</translation>
<translation id="6468415397021485143">"<ph name="EXTENSION_NAME"/>" දිගුවට ඔබ Browther වෙත පුරනය වීමට අවශ්‍යයි</translation>
<translation id="2558600429878197587">යෙදුම් සඳහා පසුබිමේ Browther ධාවනය අබල කරන්න</translation>
<translation id="5295781918312989856">මෙම දිගුව <ph name="USER_EMAIL_ADDRESS"/> ලෙස භාවිතා කිරීමට, Browther වෙත පුරන්න.</translation>
<translation id="8418845734693287262">ඔබගේ ගිණුම් පිරීමේ විස්තර යල් පැන ගොස් ඇති බැවින් ChromeOS හට ඔබගේ දත්ත සමමුහුර්ත කළ නොහැකි විය.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 HID උපාංගයකට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වන ලදි}=1{1 HID උපාංගයකට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වනු ලබයි}one{HID උපාංග #කට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වනු ලබයි}other{HID උපාංග #කට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වනු ලබයි}}</translation>
<translation id="434258293817844111">මෙම අඩවිය සඳහා Browther හට මයික්‍රෆෝන සහ කැමරා අවසරය අවශ්‍යයි</translation>
<translation id="2403703063067034158">ආරම්භක දෝෂය: පිහිටුවීමේ තවත් අවස්ථාවක් දැනට ධාවනය වේ, පසුව නැවත උත්සාහ කරන්න.</translation>
<translation id="5458993228789433099">ඕනෑම යෙදුමකින් Browther හි සබැඳි විවෘත කර ඔබේ කාර්ය තීරුවේ බ්‍රව්සරයට ප්‍රවේශ විය හැකිව තබා ගන්න</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther වෙතින් මෙවලම්<ph name="END_LINK"/> සමගින්, ඔබට සුරක්ෂිතව බ්‍රවුස් කර පාලනයේ සිටිය හැක</translation>
<translation id="2451727308784734061">මුරපද කළමනාකරු වෙත ඉක්මනින් යාමට ඔබේ කෙටිමඟ භාවිතා කරන්න. ඔබට පරිගණකයේ මුල් තිරය හෝ යෙදුම් දියත්කරණය වෙත ඔබේ කෙටිමඟ ගෙන යා හැක.</translation>
<translation id="2280315911954332435">Browther ඉක්මනින් වැසෙනු ඇත</translation>
<translation id="6410820860979094113">Browther තුළ</translation>
<translation id="2485422356828889247">අස්ථාපනය</translation>
<translation id="2513154137948333830">නැවත පණ ගැන්වීමක් අවශ්‍යයි: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">රූප සෙවීම සමග පෙළ තෝරන්න</translation>
<translation id="7892218991241200190">Browther පවතින මුරපද ප්‍රතිස්ථාපනය කිරීමට උත්සාහ කරයි. මෙයට ඉඩ දීමට ඔබේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="8976443723926188033">Browther හට ගොනු බාගැනීමට ආචයන ප්‍රවේශය අවශ්‍යයි</translation>
<translation id="1973587471928846950">Browther උදව්කරු</translation>
<translation id="2575822587468774919">රූප සෙවීම සමග සෙවීමට ඕනෑම දෙයක් තෝරන්න</translation>
<translation id="8705561858232289221">ඔබේ සියලු උපාංග මත ඔබේ මුරපද සහ තවත් දේ ලබා ගැනීමට, Browther වෙත පුරන්න</translation>
<translation id="437162022240011372">Browther භාවිතා කිරීම දිගටම කරගෙන යන්න</translation>
<translation id="259935314519650377">බාගත කළ ස්ථාපකය කෑෂ් කිරීමට අසමත් විය. දෝෂය: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">පද්ධතිය</translation>
<translation id="2907676829052962091">ඔබේ සංවිධානයට ඔබේ පිටුසන්, ඉතිහාසය, සහ මුරපද වැනි බ්‍රවුස් කිරීමේ දත්ත බැලීමට සහ කළමනාකරණය කිරීමට හැක. එයට වෙනත් Browther පැතිකඩවල බ්‍රවුස් කිරීමේ දත්ත දැකිය නොහැක</translation>
<translation id="1289116577679005654">ඔබේ ගිණුමේ, <ph name="ACCOUNT_EMAIL"/> Browther දත්ත භාවිතා කර සුරැකීමට එය ඔබම බව සත්‍යාපනය කරන්න</translation>
<translation id="7192278346779151664">ස්ථාපිත කරන අතරතුර මෙහෙයුම් පද්ධති දෝෂයක් හට ගැනුණි. කරුණාකර නැවත Browther බාගන්න.</translation>
<translation id="7724398260867885339">ඔබ උපාංගයක් බෙදා ගන්නේ නම්, මිතුරන්ට සහ පවුලේ අයට වෙන්ව බ්‍රවුස් කළ හැකි අතර ඔවුනට අවශ්‍ය ආකාරයට Browther පිහිටුවිය හැකිය.</translation>
<translation id="1679595317134614424">Browther පටිත්ත</translation>
<translation id="7189168846924379421">අමතර ආරක්ෂාව සඳහා, Browther ඔබේ දත්ත සංකේතනය කරනු ඇත.</translation>
<translation id="4052643592793184278">Browther වෙතින් ඔබේ Browther ගිණුම ඉවත් කිරීමට, වරන්න</translation>
<translation id="7694616023994438906">ඔබේ සියලු උපාංග මත ඔබේ මුරපද, පිටුසන්, සහ තවත් දේ ලබා ගැනීමට, Browther වෙත පුරන්න</translation>
<translation id="2738871930057338499">අන්තර්ජාලය වෙත සම්බන්ධ වීමට නොහැකි වේ. HTTP 403 තහනම්. ඔබේ ප්‍රොක්සි වින්‍යාසය පරීක්ෂා කරන්න.</translation>
<translation id="2753623023919742414">සෙවීමට ක්ලික් කරන්න</translation>
<translation id="9078193405195503710">ඔබේ පෙරනිමි PDF දක්වනය ලෙස Browther සකසන්න</translation>
<translation id="2456995288904753506">Browther හට සම්මත ස්වයං පිරවීම මඟ හැරිය හැකි දුෂ්කර ක්ෂේත්‍ර ස්වයංව පිරවිය හැක</translation>
<translation id="3271730304285122987">මෙම දිගුවේ අනිෂ්ට මෘදුකාංග අඩංගු වන අතර එය අනාරක්ෂිත වේ. එයට ඔබේ පුද්ගලික තතු ඇතුළුව, ඔබ පිවිසෙන අඩවිවල ඔබේ දත්ත තවදුරටත් දැකීමට සහ වෙනස් කිරීමට නොහැකි වන පරිදි එය Browther වෙතින් ඉවත් කරන්න.</translation>
<translation id="2799223571221894425">නැවත දියත් කරන්න</translation>
<translation id="1427337251963884503">ඔබේ Browther</translation>
<translation id="2816462166102338036">රූප සෙවීම භාවිතයෙන් මෙම වීඩියෝව සොයන්න</translation>
<translation id="2841525013647267359">පරිවර්තනය කරන්න</translation>
<translation id="2846251086934905009">ස්ථාපන දෝෂය: ස්ථාපකය සම්පූර්ණ කර නැත. ස්ථාපනය නතර කර ඇත.</translation>
<translation id="928966105228355994">Browther වෙතින් ඉවත් කරන්න...</translation>
<translation id="587805782197019018">ඔබ පුරා සිටින විට Browther හි ඔබව ආරක්ෂිතව තබා ගන්නා අතර අනෙකුත් Browther යෙදුම් තුළ ඔබගේ ආරක්ෂාව වැඩි දියුණු කිරීමට භාවිත කළ හැකිය</translation>
<translation id="2885378588091291677">කාර්ය කළමණාකරු</translation>
<translation id="3055995278166070443">&amp;Browther පිළිබඳ</translation>
<translation id="2915996080311180594">පසුව යළි අරඹන්න</translation>
<translation id="2928420929544864228">ස්ථාපනය සම්පූර්ණයි.</translation>
<translation id="70453521937551896">ඔබේ දත්ත ඔබේ මුර-වැකිකඩ සමග සංකේතනය කර ඇත. ඔබේ Browther ගිණුමේ Browther දත්ත භාවිතා කිරීමට සහ සුරැකීමට එය ඇතුළු කරන්න.</translation>
<translation id="2945997411976714835">ස්ථාපන දෝෂය: ස්ථාපක ක්‍රියාවලිය ආරම්භ කිරීමට අසමත් විය.</translation>
<translation id="3188308520233701133">iOS හි Browther සඳහා සුරකින ලද මුරපද භාවිතයෙන් වෙබ් අඩවි වලට වේගයෙන් පුරන්න</translation>
<translation id="8145318807880784886">පිටුසන්, මුරපද සහ සැකසීම් වෙන්ව තබා ගැනීමට නව Browther පැතිකඩක් එක් කරන්න.</translation>
<translation id="4330268530227888227">ඔබේ සංවිධානය Browther කළමනාකරණය කරයි</translation>
<translation id="6488090896442998436">Browther යාවත්කාලීනයි</translation>
<translation id="300557164611864786">අඩවියක් ඔබගේ මුරපදය සොරා ගැනීමට උත්සාහ කළහොත්, හෝ ඔබ හානිකර ගොනුවක් බාගන්නා විට, Browther පිටු අන්තර්ගතයේ කැබලි ඇතුළුව, URL සුරක්ෂිත බ්‍රවුස් කිරීම වෙත යැවීමටද හැකිය</translation>
<translation id="2447145782593796785">ඔබේ මාපියන්ගේ තේරීම් සමග සබැඳිව සුරක්ෂිතව සිටීමට, Browther වෙත පුරන්න</translation>
<translation id="3003694935412297923">සියලු කාර්යයන්</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther හට ඔබේ Browther ගිණුම තුළ සමහර දත්ත සුරැකී ඔබේ සියලු ම උපාංග මත භාවිත කළ හැකි වීමට පෙර ඒ ඔබ බව සත්‍යාපනය කිරීමට අවශ්‍ය වේ. ඔබ දැන් වරන්නේ නම්, මෙම දත්ත (1 අයිතමයක්) මකනු ලැබේ.}one{Browther හට ඔබේ Browther ගිණුම තුළ සමහර දත්ත සුරැකී ඔබේ සියලු ම උපාංග මත භාවිත කළ හැකි වීමට පෙර ඒ ඔබ බව සත්‍යාපනය කිරීමට අවශ්‍ය වේ. ඔබ දැන් වරන්නේ නම්, මෙම දත්ත (අයිතම {count}ක්) මකනු ලැබේ.}other{Browther හට ඔබේ Browther ගිණුම තුළ සමහර දත්ත සුරැකී ඔබේ සියලු ම උපාංග මත භාවිත කළ හැකි වීමට පෙර ඒ ඔබ බව සත්‍යාපනය කිරීමට අවශ්‍ය වේ. ඔබ දැන් වරන්නේ නම්, මෙම දත්ත (අයිතම {count}ක්) මකනු ලැබේ.}}</translation>
<translation id="5522228731050510047">Browther තුළ නව පටිත්තක් තුළ <ph name="URL"/> විවෘත කරන්න.</translation>
<translation id="6358780591055960280">Browther හට ඔබේ මුරපද පරීක්‍ෂා කළ නොහැක. පසුව නැවත උත්සාහ කරන්න.</translation>
<translation id="1386422761453740126">Browther වෙත එක් කෙරෙමින්...</translation>
<translation id="3038232873781883849">ස්ථාපනය කිරීමට පොරොත්තුවෙන්...</translation>
<translation id="3045032126857188731">පරිවර්තිත භාෂාව: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ප්‍රතිපෝෂණ සංවාදය වසන්න</translation>
<translation id="369127628511662602">වෙනත් Browther පැතිකඩ</translation>
<translation id="2370255879896574713">බිඳ වැටුම් වාර්තා සහ <ph name="UMA_LINK"/> Browther වෙත යවමින් Browther Browther දියුණු කිරීමට සහය වන්න</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 USB උපාංගයකට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වන ලදි}=1{1 USB උපාංගයකට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වනු ලබයි}one{USB උපාංග #කට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වනු ලබයි}other{USB උපාංග #කට එක Browther දිගුවකින් හෝ වැඩි ගණනකින් ප්‍රවේශ වනු ලබයි}}</translation>
<translation id="2065456480740480340">Browther ඉතිහාසය</translation>
<translation id="5011660649081947055">ස්ථාපකය සංරක්ෂිතය සම්පීඩනය නොකිරීමට අසමත් විය. කරුණාකර නැවත Browther බාගන්න.</translation>
<translation id="310459126943037700">කාර්යය(යන්) නිමා කිරීමට අසමත් විය.</translation>
<translation id="3104828284009500087">පිටුවෙහි ඕනෑම දෙයක් සොයන්න</translation>
<translation id="4917564010081457061">ඔබේ මුරපද, පිටුසන් සහ ඉතිහාසය උපාංග හරහා පරිපූර්ණව සමමුහුර්තව තබා ගන්න. ඔබේ පෙරනිමි බ්‍රව්සරය Browther වෙත යාවත්කාලීන කිරීමෙන් ඔබ දන්නා සහ ආදරය කරන විශේෂාංග වෙත පහසුවෙන් ප්‍රවේශ වන්න.</translation>
<translation id="1041472930719344928">Browther ඔබේ මයික්‍රෆෝනය භාවිත කරයි.</translation>
<translation id="3130333203120345554">අලුත් සෙවීම</translation>
<translation id="3137969841538672700">සෙවීමට අදින්න</translation>
<translation id="5312717254055363883">මෙම පටිත්ත අමතර සම්පත් භාවිත කරයි. ඔබේ කාර්ය සාධනය වැඩි දියුණු කිරීමට, Browther හට එය අක්‍රිය කිරීමට ඉඩ දෙන්න.</translation>
<translation id="373523409348786203">ඔබේ තිරය බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ Browther සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න</translation>
<translation id="802113445299754598">Browther නැවත දියත් කරන්න</translation>
<translation id="3161522574479303604">සියලු භාෂා</translation>
<translation id="4522189060330781648">ඔබේ පරිගණකයේ ඇති වෙනත් වැඩසටහනක් තේමාවක් එක් කර ඇති අතර එයින් Browther ක්‍රියා කරන ආකරය වෙනස් විය හැක.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">ඔබගේ නව Browther පැතිකඩ අභිරුචිකරණය කරන්න</translation>
<translation id="5150830326120505481">Browther වෙතින් ඔබේ Browther ගිණුම ඉවත් කිරීමට, සැකසීම් පිටුව තුළින් Browther වෙතින් වරන්න</translation>
<translation id="7113660200899017820">පසුව, ඔබ වෙනුවෙන් පෝරම ස්වයංව පිරවීමට සුරකින ලද තතු භාවිතා කිරීමට අවශ්‍ය දැයි Browther විමසිය හැක</translation>
<translation id="4475011322243623412">Browther හට එහි දත්ත නාමාවලිය කියවීම හෝ ලිවීම කළ නොහැක:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">දැන් යළි අාරම්භ කරන්න</translation>
<translation id="3536063527222598206">Browther API යතුරු අහිමිව ඇත. Browther හි ඇතැම් ක්‍රියාකාරීත්ව අක්‍රීය වනු ඇත.</translation>
<translation id="1011450868746766298">Browther වසා ඇති විට පසුබිම් යෙදුම් ධාවනය අඛණ්ඩව කරන්න</translation>
<translation id="179611081153855734">අනාරක්ෂිත සම්බන්ධතාවයක් භාවිතයෙන් ඕනෑම අඩවියක් පූරණය කිරීමට පෙර Browther ඔබට අනතුරු අඟවනු ඇත</translation>
<translation id="8965591964936552871">ඔබ Browther වෙත පුරනය වී ඇති නම් ඔබේ Browther ගිණුම හැර, ඔබ සියලු Browther කවුළු වසා දැමූ විට ඔබ බොහෝ අඩවිවලින් වරනු ලැබේ. අඩවිවලට ඔබව මතක තබා ගැනීමට ඉඩ දීමට, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">ඔබේ පෙරනිමි සෙවීම් යන්ත්‍රය Browther වෙතින් පිටතින් වෙනස් කර ඇත. ඔබව ආරක්ෂා කිරීමට, Browther එය යළි සකසයි.</translation>
<translation id="1170501833661894915">ඔබේ සියලු උපාංගවල ඔබේ මුරපද පිටුසන් සහ තවත් දේ ලබා ගැනීමට Browther වෙත පුරන්න</translation>
<translation id="3352986031709923790">සෙවීම් ප්‍රදේශයේ ඉහළම දකුණු කෙළවර: දකුණ <ph name="RIGHT"/>%, ඉහළ <ph name="TOP"/>%</translation>
<translation id="120745000989996104">ඔබේ ගිණුමේ Browther දත්ත</translation>
<translation id="3369405342922656244">රූප සෙවීම භාවිතයෙන් මෙම පිටුව සොයන්න</translation>
<translation id="7173761126541905083">ඔබේ දුරකථනයේ Browther සමග ඔබේ මුරපද භාවිතා කරන්න</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">තිබෙන Browther පැතිකඩට මාරු වන්නද?</translation>
<translation id="3412460710772753638">මෙම උපාංගයේ මුරපද කළමනාකරු තුළ</translation>
<translation id="4282363917570905631">ඔබේ දුරකථනයේ Browther සමග ඉහළ නැංවූ සුරක්ෂිත පිරික්සුම දීර්ඝ කරන්න</translation>
<translation id="986094398735583155">Browther ඔබේ කර ගනිමින්...</translation>
<translation id="3266047225484320321">ඔබ සමථයට පත් වූ මුරපදයක් සමඟ පුරන විට Browther ඔබට දැනුම් දෙයි</translation>
<translation id="3508047337876211050">මෙය මෙම උපාංගයෙන් අයිතම <ph name="ITEMS_COUNT"/>ක් මකනු ඇත. ඔබගේ දත්ත පසුව ලබා ගැනීමට, <ph name="USER_EMAIL"/> ලෙස Browther වෙත පුරන්න.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> හට Browther පැතිකඩවල් අතර මාරු විය හැකිය</translation>
<translation id="7225005776233199285">කරුණාකර සියලු Browther කවුළු වසා නැවත උත්සාහ කරන්න.</translation>
<translation id="5465054931427475969">ඔබේ කවුළුව බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ Browther සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න.</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> දැනටමත් පුරනය වී නැත.  ඔබේ බ්‍රවුස් කිරීම වෙනම තබා ගැනීමට, <ph name="USER_EMAIL_ADDRESS"/> ලෙස ඔබේම පැතිකඩෙන් Browther හට පුරන්න.</translation>
<translation id="8133590217245064579">ඔබේ තිරය බෙදා ගැනීමට, පද්ධති සැකසීම් තුළ Browther සඳහා තිර පටිගත කිරීමට ඉඩ දෙන්න.</translation>
<translation id="3597003331831379823">උසස් වරප්‍රසාද සහිත පිහිටුවීම් ධාවනය කිරීමට අසමත් විය. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Browther වෙත පිවිසෙන්න</translation>
<translation id="2492221622209669678">මෙම පුද්ගලයාගේ බ්‍රවුස් කිරීමේ දත්ත මෙම උපාංගයෙන් මකනු ලැබේ. දත්ත ප්‍රතිසාධන කිරීමට, <ph name="USER_EMAIL"/> ලෙස Browther එකට පුරන්න.</translation>
<translation id="6793778233257855801"><ph name="ORIGIN"/> වෙතින් ඔබගේ Android දුරකථනයට අංකයක් යැවීමට, උපාංග දෙකෙහිම Browther වෙත පුරන්න.</translation>
<translation id="3667616615096815454">ස්ථාපනය කළ නොහැකි වේ, යෙදුම සේවාදායකයට නොදනී.</translation>
<translation id="5585500151754164442">ඔබේ Browther ගිණුමේ ඇති සියලු ම Browther දත්ත සංකේතනය කිරීමට <ph name="BEGIN_LINK"/>ඔබේම මුර-වැකිකඩක්<ph name="END_LINK"/> භාවිත කරන්න. Google Pay වෙතින් ගෙවීම් ක්‍රම සහ ලිපින සංකේතනය නොකෙරේ. Browther වෙතින් බ්‍රවුස් කිරීමේ ඉතිහාසය සමමුහූර්ත නොවේ.</translation>
<translation id="404323216042159951">Browther හට ඔබේ මුරපද පරීක්‍ෂා කළ නොහැක. ඔබේ අන්තර්ජාල සම්බන්ධතාව පරීක්‍ෂා කිරීමට උත්සාහ කරන්න.</translation>
<translation id="5004936474632127765">සබැඳිය නව Browther ප&amp;ටිත්තක විවෘත කරන්න</translation>
<translation id="6236643159256182256">පුද්ගලායන සහ වෙනත් අරමුණු සඳහා Browther සහ වෙනත් Browther සේවා සම්බන්‍ධ කරන්න</translation>
<translation id="3729187154190517324">"පටිත්තක් සහ තවත් දේ එක් කරන්න" බොත්තම භාවිතයෙන් බහු පටිති, ගොනු සහ මෙවලම් එක් කිරීමෙන් ඔබේ සෙවීම ගැඹුරු කරන්න.</translation>
<translation id="1400697664933775238">Browther පැතිකඩවල් කළමනා කරන්න</translation>
<translation id="2461315395128103158">Browther සමහර බාගැනීම් අවහිර කරන හේතුව ඉගෙන ගන්න</translation>
<translation id="8058420662026104226">ඕනෑම දෙයකට ඔබේ සමාලෝචනය අවශ්‍ය නම් Browther ඔබට දන්වනු ඇත</translation>
<translation id="3177448557921912221">Browther පැතිකඩ ඔබට ඔබේ ජීවිතයේ විවිධ කොටස් වෙන් කිරීමට උදවු කරයි. දැන් නව පැතිකඩක් එක් කරන්න.</translation>
<translation id="1541177876035612043">Browther ඔබ පැමිණීමට ඉඩ ඇති පිටු පූර්ව පූරණය කරන බැවින්, ඔබ ඒවාට පැමිණෙන විට ඒවා වඩාත් ඉක්මනින් පූරණය වේ</translation>
<translation id="3810973564298564668">කළමනාකරණය</translation>
<translation id="1117103475254549453">ඔබේ සුරකින ලද මුරපද භාවිත කිරීමට QR කේතය අනුගමන කර iOS සඳහා Browther බාගෙන ඔබේ Browther ගිණුමට පුරන්න</translation>
<translation id="8880695882192156860">Browther ඉඟිය: ඉහළ නැංවූ සුරක්ෂිත පිරික්සුම</translation>
<translation id="3846683726093018685">**සාරාංශගත කරන්න:** වචන 30ක් ඇතුළත තනි වාක්‍යයකින්, තිර රුවෙහි අන්තර්ගතයේ ප්‍රාථමික විෂය සහ අරමුණ විස්තර කරන්න.

          **ප්‍රශ්න යෝජනා කරන්න:** තිර රුව වඩා හොඳින් තේරුම් ගැනීම සඳහා පරිශීලකයෙකුට ඇසිය හැකි සිතුවිලි අවුස්සන ප්‍රශ්න 3-5 ක බුලටිත ලැයිස්තුවක් ජනනය කරන්න. මෙම ප්‍රශ්නවලට අවම වශයෙන් දෘශ්‍ය වස්තුවක්, එහි සැලසුම හෝ එහි පිහිටීම පිළිබඳව විශේෂිත වූ එකක්වත් ඇතුළත් විය යුතු ය.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">භාෂාව තේරීම</translation>
<translation id="4861846616763552424">Browther අභිරුචි කිරීම සහ පාලනය. යම් දෙයකට ඔබේ අවධානය අවශ්‍යයි - විස්තර සඳහා ක්ලික් කරන්න.</translation>
<translation id="6126366281251241386">Browther විවෘත කිරීමට සහ පිරික්සීම ආරම්භ කිරීමට ඔබේ නම ක්ලික් කරන්න.</translation>
<translation id="3892148308691398805">පෙළ පිටපත් කරන්න</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> දැනටමත් මෙම Browther පැතිකඩට පුරා ඇත. ඔබගේ බ්‍රවුස් කිරීම වෙනම තබා ගැනීමට, Browther හට ඔබ සඳහා ඔබගේම පැතිකඩක් තැනිය හැකිය.</translation>
<translation id="3821553157234855663">ඔබේ Browther අභිරුචි කරන්න</translation>
<translation id="3941890832296813527">ස්ථාපන දෝෂය: ස්ථාපක ගොනු නාමය වලංගු නැත හෝ සහාය නොදක්වයි.</translation>
<translation id="6482299900191767005">Browther මුරපද පිටපත් කිරීමට උත්සාහ කරයි. මීට ඉඩ දීමට ඔබේ Windows මුරපදය ටයිප් කරන්න.</translation>
<translation id="5853011008278898603">ඔබ ඔබේ Browther ගිණුමේ සුරකින ලද ඔබේ මුරපද, ගෙවීම් ක්‍රම, සහ ලිපින මෙම උපාංගයෙන් ඉවත් කරනු ලැබේ. ඒවා නැවත Browther තුළ භාවිතා කිරීමට, නැවත පුරනය වන්න.</translation>
<translation id="395904275706073188">ආරක්ෂිත පිටු කියවිය නොහැක. වෙනත් පිටුවක් උත්සාහ කරන්න.</translation>
<translation id="1832973663231751701">Browther ඔබව සුරක්ෂිතව තබන ආකාරය ඉගෙන ගන්න</translation>
<translation id="4531502594774670767">ඔබ ලිපින තීරුවේ හෝ සෙවීම් කොටුවේ ටයිප් කරන විට, යෝජනා ලබා ගැනීම සඳහා Browther ඔබ ටයිප් කරන දේ ඔබේ සංවිධානයේ සෙවීම්, AI සහ නියෝජිත මෙවලම් වෙත යවයි.</translation>
<translation id="300013383485253006">&amp;පරීක්ෂා කිරීම සඳහා Browther ගැන</translation>
<translation id="1152920704813762236">ChromeOS ගැන</translation>
<translation id="8126752030994997015">ඔබ වෙබ් අඩවියකට පිවිසෙන විට, Browther ඔබේ IP ලිපිනය සඟවන රහස්‍යතා සේවාදායකයක් හරහා URL හි අපැහැදිලි කොටසක් <ph name="BEGIN_LINK"/>Browther සුරක්ෂිත බ්‍රවුස් කිරීම<ph name="END_LINK"/> වෙත යවයි. වෙබ් අඩවියක් සැක කටයුතු දෙයක් සිදු කරන්නේ නම්, සම්පූර්ණ URL සහ පිටු අන්තර්ගතයේ බිටු ද යවයි.</translation>
<translation id="3703994572283698466">ChromeOS හට අතිරේක <ph name="BEGIN_LINK_CROS_OSS"/>විවෘත මූලාශ්‍ර මෘදුකාංග<ph name="END_LINK_CROS_OSS"/> මගින්, <ph name="BEGIN_LINK_LINUX_OSS"/>Linux සංවර්ධන පරිසරය<ph name="END_LINK_LINUX_OSS"/> ලෙස හැකියාව ලබා දී ඇත.</translation>
<translation id="4022972681110646219">තිරය පරිවර්තනය කරන්න</translation>
<translation id="4023601594785368013">මුල් භාෂාව: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">ඕනෑම යෙදුමකින් Browther හි සබැඳි විවෘත කරන්න. ඊට අමතරව පහසු ප්‍රවේශය සඳහා, එය ඔබේ කාර්ය තීරුවට අමුණනු ලැබේ.</translation>
<translation id="3437506136408403836"><ph name="BEGIN_LINK"/>වත්මන් සැකසීම්<ph name="END_LINK"/> වාර්තා කිරීමෙන් Browther වඩා යහපත් කිරීමට උදවු වන්න</translation>
<translation id="4050175100176540509">වැදගත් ආරක්ෂක වැඩිදියුණු කිරීම් සහ නව විශේෂාංග නවතම අනුවාදය තුළ ලද හැකිය.</translation>
<translation id="4055805654398742145">මුරපද කළමනාකරු</translation>
<translation id="2164947358785939495">ඔබේ පරිගණකයේ ඇති වෙනත් වැඩසටහනක් දිගුවක් එක් කර ඇති අතර එයින් Browther ක්‍රියා කරන ආකරය වෙනස් විය හැක.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{ඔබේ සංවිධානය Browther මිනිත්තු 1ක් සඳහා භාවිතා නොකරන විට ස්වයංක්‍රීයව වසයි. බ්‍රවුස් කිරීමේ දත්ත මකා ඇත. මෙයට ඉතිහාසය, ස්වයං පිරවීම, සහ බාගැනීම් ඇතුළත් විය හැක.}one{ඔබේ සංවිධානය Browther මිනිත්තු #ක් සඳහා භාවිතා නොකරන විට ස්වයංක්‍රීයව වසයි. බ්‍රවුස් කිරීමේ දත්ත මකා ඇත. මෙයට ඉතිහාසය, ස්වයං පිරවීම, සහ බාගැනීම් ඇතුළත් විය හැක.}other{ඔබේ සංවිධානය Browther මිනිත්තු #ක් සඳහා භාවිතා නොකරන විට ස්වයංක්‍රීයව වසයි. බ්‍රවුස් කිරීමේ දත්ත මකා ඇත. මෙයට ඉතිහාසය, ස්වයං පිරවීම, සහ බාගැනීම් ඇතුළත් විය හැක.}}</translation>
<translation id="1535413545339990419">Browther ගැන පිටුවට යන්න</translation>
<translation id="692283249649018289">ඔබේ බ්‍රව්සරයට නව පෙනුමක් ලබා දීමට Browther අභිරුචිකරණය කරන්න</translation>
<translation id="6375229634133804834">ඔබේ Browther අභිරුචි කරන්න</translation>
<translation id="4148957013307229264">ස්ථාපනය කරමින්...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - ජාල පුරනය - Browther</translation>
<translation id="2911246138082876798">Browther සඳහා විශිෂ්ට යෙදුම්, ක්‍රීඩා, දිගු සහ තේමා අනාවරණය කර ගන්න.</translation>
<translation id="2528977475313334293">මෙම දිගුව සහ තවත් දේ ඔබේ සියලු පරිගණකවල ලබා ගැනීමට, Browther වෙත පුරන්න</translation>
<translation id="8244267655940711467">ඔබේ මාපියන්ගේ තේරීම් සමග සබැඳිව ආරක්ෂිතව සිටීමට, ඔබ <ph name="USER_EMAIL_ADDRESS"/> ලෙස දැනටමත් පුරනය වී ඇති ඔබේ Browther පැතිකඩ වෙත මාරු වන්න</translation>
<translation id="4222932583846282852">අවලංගු කරමින්...</translation>
<translation id="4224210481850767180">ස්ථාපනය අවලංගු කර ඇත.</translation>
<translation id="8219359042845534271">මෙම ගිණුමට Browther දත්ත සම්බන්ධ කරන්නද?</translation>
<translation id="5520777668172961882">සම්මත ආරක්ෂණයට වඩා අඩවිවලින් වැඩිපුර දත්ත විශ්ලේෂණය කිරීමෙන්, Browther කලින් නොදැන සිටි ඒවා පවා, භයානක අඩවි පිළිබඳව ඔබට අනතුරු අඟවයි. ඔබට Browther අනතුරු ඇඟවීම් මඟ හැරීමට තේරිය හැක.</translation>
<translation id="2014920019837536689">Browther වෙතින් වරන්න</translation>
<translation id="4341512411059715879">Browther සමගින් උදවු ලබා ගන්න</translation>
<translation id="4281844954008187215">සේවා කොන්දේසි</translation>
<translation id="322492684764924424">අනපේකෂිත දෝෂයක් හේතුවෙන් ස්ථාපනය අසාර්ථක විය. Browther දැනටමත් ධාවනය වෙමින් පවතී නම්, එය වසා නැවත උත්සාහ කරන්න.</translation>
<translation id="3813060261346666066">Browther වෙතින් මුරපද නිර්යාත කරන්න</translation>
<translation id="4304713468139749426">මුරපද කළමනාකරු</translation>
<translation id="4334241893986177674">මෙම තිර රුව සොයන්න</translation>
<translation id="4334294535648607276">බාගැනීම සම්පූර්ණයි.</translation>
<translation id="2177954934431828302">Windows ආරම්භ වන විට Browther දියත් කරන්න</translation>
<translation id="2472318668926455009">Browther ඔබේ පෙරනිමි බ්‍රව්සරය ලෙස සැකසීමෙන් ඔබ දන්නා, ආදරය කරන සහ විශ්වාස කරන විශේෂාංග වෙත පහසු ප්‍රවේශයක් ලබා ගන්න. ඉක්මන් ප්‍රවේශය සඳහා Browther ඔබේ කාර්ය තීරුවට අමුණනු ලැබේ.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> හට ඔබ මෙම උපාංගය භාවිත කිරීමට පෙර පහත සේවා නියම කියවා පිළිගැනීමට අවශ්‍යයි. මෙම නියම ChromeOS නියම පුළුල් කිරීම, වෙනස් කිරීම හෝ සීමා කිරීම නොකරයි.</translation>
<translation id="2897580280700805340">කෙසේ වුවත් Browther වෙතින් ඉවත් වන්න ද?</translation>
<translation id="4413205837991854510">සෑම විටම රූප සෙවීම් කෙටිමඟ පෙන්වන්න</translation>
<translation id="2454897022983434851">Browther හට පසුබිම ධාවනය වීමට ඉඩ දෙන්න</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Browther ඔබ එය ඉවත් කිරීම නිර්දේශ කරයි. <ph name="BEGIN_LINK"/>සහාය දක්වන දිගු ගැන තව දැන ගන්න<ph name="END_LINK"/>}one{Browther ඔබ ඒවා ඉවත් කිරීම නිර්දේශ කරයි. <ph name="BEGIN_LINK"/>සහාය දක්වන දිගු ගැන තව දැන ගන්න<ph name="END_LINK"/>}other{Browther ඔබ ඒවා ඉවත් කිරීම නිර්දේශ කරයි. <ph name="BEGIN_LINK"/>සහාය දක්වන දිගු ගැන තව දැන ගන්න<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Browther පාලනය හා රුචිකරණය</translation>
<translation id="4427306783828095590">තතුබෑම් සහ අනිෂ්ට මෘදුකාංග අවහිර කිරීමට වැඩි දියුණු කළ ආරක්ෂාව වැඩි දෙයක් කරයි</translation>
<translation id="4434353761996769206">ස්ථාපක දෝෂය: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> Browther කළමනාකරණය කරයි</translation>
<translation id="4007482010626246887">Browther පැතිකඩ එක් කරන්න</translation>
<translation id="6888322430074420631">පරීක්ෂා කිරීම සඳහා Browther ගැන</translation>
<translation id="8912436499620582668">ඔබේ Browther ගිණුමේ Browther දත්ත භාවිතා කිරීමට සහ සුරැකීමට, ඔබේ මුර-වැකිකඩ ඇතුළු කරන්න</translation>
<translation id="4493028449971051158">ආරම්භක දෝෂය: ස්ථාපකය පරිපාලක ලෙස ධාවනය කරන්න.</translation>
<translation id="4501471624619070934">මෙම රට තුළ ප්‍රවේශය සීමා කර ඇති නිසා ස්ථාපනය අසමත් විය.</translation>
<translation id="8976207309012239417">මෙම දිගුව මෙය දත්ත රැස් කර භාවිත කරන ආකාරය වැනි පෞද්ගලිකත්ව පුරුදු ප්‍රකාශන කර නැත. Browther ඔබ එය ඉවත් කිරීම නිර්දේශ කරයි.</translation>
<translation id="2174621824527957495">Browther වෙත සාදරයෙන් පිළිගනිමු; නව බ්‍රවුසර කවුළුවක් විවෘත කරන ලදි</translation>
<translation id="6391148383688605718">ඔබේ වටපිටාව සිතියම් කිරීමට සහ ඔබේ අත් හඹා යාමට Browther හට අවසරය අවශ්‍ය ය</translation>
<translation id="7756445485815468244">ඔබ දැනටමත් තව Browther පැතිඩකක් තුළ <ph name="USER_EMAIL_ADDRESS"/> ලෙස පුරනය වී ඇත</translation>
<translation id="137435413163730206">Browther බ්‍රවුස් කිරීම සහ සෙවීම වේගවත් කරන පිටු පූර්ව පූරණය කරයි. <ph name="BEGIN_LINK"/>පිටු පූර්ව පූරණය ගැන තව දැන ගන්න<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">ඔබ හානිකර යැයි සිතන වෙබ් අඩවියක් ඔබ වාර්තා කරන විට සියලු දෙනා සඳහා සබැඳි ආරක්ෂාව වැඩි දියුණු කරන්න.</translation>
<translation id="3266647901351304597">ඔබ සුරක්ෂිත බ්‍රවුස් කිරීම ක්‍රියාවිරහිත කළ නිසා සහ ගොනුව සත්‍යාපනය කළ නොහැකි නිසා Browther මෙම බාගැනීම අවහිර කර ඇත</translation>
<translation id="6980208900390333646">ඔබේ දුරකථනයේ Browther සමග Google Lens උත්සාහ කරන්න</translation>
<translation id="4594305310729380060">මෙම උපාංගයේ මුරපද කළමනාකරු වෙත</translation>
<translation id="738228944918383850">Browther යෙදුම්</translation>
<translation id="4598116752460667024">ලැයිස්තුවෙන් ඕනෑම ක්‍රියාවලියක් සොයන්න.</translation>
<translation id="4970880042055371251">ChromeOS අනුවාදය</translation>
<translation id="4482468019601425607">බොහෝ දුරට යාවත්කාලීනයි! යාවත්කාලීනය අවසන් කිරීමට Browther යළි දියත් කරන්න.</translation>
<translation id="5517890123509214766">Browther හි V8 එන්ජිම සමග අඩවි වේගවත් කරයි, නමුත් Browther ප්‍රහාරවලට තරමක් අඩු ප්‍රතිරෝධයක් දක්වයි</translation>
<translation id="7690070364551268156">ඔබ Browther පරිශීලන වාර්තාද බෙදා ගතහොත්, එම වාර්තාවලට ඔබ පිවිසෙන URL ඇතුළත් වේ</translation>
<translation id="5020487088453637212">මෙමපැතිකඩ වෙනත් Browther ක්‍රියාවලියක් (<ph name="PROCESS_ID"/>) වෙනත් පරිගණකයක් (<ph name="HOST_NAME"/>) මට සිදු කරයි. Browther විසින් පැතිකඩ දූශිත වීම වැලැක්වීම සඳහා එය අගුළු ලා ඇත. ඔබට වෙනත් ක්‍රියාවලියක් ඔබේ පැතිකඩ භාවිත නොකරන බව විශ්වාස නම්, ඔබට පැතිකඩ අගුළු හැර Browther නැවත දියත් කළ හැක.</translation>
<translation id="4680828127924988555">ස්ථාපනය අවලංගු කරන්න</translation>
<translation id="8134827615154347946">ඔබේ Browther දත්ත සමහරක් තවම ඔබේ Browther ගිණුම තුළ සුරැකී නැත. වරන්නට පෙර විනාඩි කිහිපයක් රැඳී සිටීමට උත්සාහ කරන්න. ඔබ දැන් වරන්නේ නම් මෙම දත්ත මකනු ලැබේ.</translation>
<translation id="3508712423420506333">ඔබ පුරනය වී සිටින අතරතුර, ඔබට Browther තුළ ඔබේ Browther ගිණුමෙන් ඔබේ මුරපද සහ තවත් ඒවා භාවිත කළ හැක <ph name="SHORTCUT"/> හට ඔබේ Browther සේවා සැකසීම් වෙනස් කළ හැක.</translation>
<translation id="2388739442635757494">යම් කෙනෙක් පෙරදී මෙම පරිගණකය මත Browther වෙත <ph name="ACCOUNT_EMAIL_LAST"/> ලෙස පුරා ඇත. ඔබේ තොරතුරු වෙනම තබා ගැනීමට කරුණාකර නව Browther පරිශීලකයෙක් සාදන්න.</translation>
<translation id="4724676981607797757">සහාය නොදක්වන ප්‍රොටෝකෝල දෝෂයක් නිසා ස්ථාපනය අසමත් විය.</translation>
<translation id="8305313684264112434">කෙසේ වුවත් Browther වෙතින් ඉවත් වන්න ද?</translation>
<translation id="418155915144835101">Browther සඳහා විශේෂ ආරක්‍ෂක යාවත්කාලීනයක් දැන් යොදා ගත්තා. දැන් යළි අරඹන්න, අපි ඔබේ පටිති ප්‍රතිසාධන කරන්නම්.</translation>
<translation id="2683970367518529374">Browther වෙතින් අසන්න</translation>
<translation id="5064473048847774331">ඔබ මෑත පැමිණ නැත. Browther <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, සහ තව <ph name="COUNT"/>ක් ඉවත් කළා.</translation>
<translation id="5941343075741207533">Browther හට ඔබේ මුරපද පරීක්‍ෂා කළ නොහැක. පැය 24-කට පසු නැවත උත්සාහ කරන්න, නැති නම් <ph name="BEGIN_LINK"/>ඔබේ Browther ගිණුම තුළ මුරපද පරීක්‍ෂා කරන්න<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">මෙය Browther සෙවීම තුළ භාවිත කෙරෙන අක්‍ෂර පරීක්‍ෂකයම භාවිත කරයි. ඔබ බ්‍රවුසරය තුළ ටයිප් කරන පාඨය Browther වෙත යවනු ලැබේ. ඔබට සැම විටම මෙම හැසිරීම සැකසීම් තුළ වෙනස් කළ හැක.</translation>
<translation id="4581078588976787792">ගිණුමක් නොමැතිව Browther භාවිත කරන්න</translation>
<translation id="5921583137589782067">Browther සඳහා අභ්‍යන්තර නියෝගය mDNS තදබදය ඉඩ දීමයි.</translation>
<translation id="6563126962881169552">&amp;Browther යාවත්කාලීන කිරීමට යළි දියත් කරන්න</translation>
<translation id="4918086044614829423">පිළිගන්න</translation>
<translation id="4918844574251943176">රූපය පිටපත් කරන ලදි</translation>
<translation id="5240982928057703861">Browther පසුබිම් ප්‍රකාරය තුළ ඇත.</translation>
<translation id="3603134280602182991">Browther පුරනය වීමේ සංවාදය වැසීමට ක්ලික් කරන්න</translation>
<translation id="6120233890602288442">Browther පැතිකඩවල් සමඟ ඔබට ඔබේ සියලු Browther දේවල් වෙන් කළ හැක. මිතුරන් සහ පවුලේ අය සඳහා පැතිකඩ තනන්න, නැතහොත් රැකියාව සහ විනෝදය අතර බෙදන්න.</translation>
<translation id="5722688387568011881">අමුත්තන්ට කිසිවක් තබා යෑමෙන් තොරව Browther භාවිත කළ හැක.</translation>
<translation id="7786958592460743302">Browther හි ඔබේ ගිණුම</translation>
<translation id="9114640791491590337">ඔබව Browther වෙත එක් කරන්න</translation>
<translation id="3536391594566515053">Browther හි Gemini ඔබේ පටිතිවල වැඩ කිරීමට සහ ඔබ එයට දෙන කාර්යයන් සම්පූර්ණ කිරීමට ස්වයං බ්‍රවුස් භාවිත කරයි. <ph name="LINK_BEGIN"/>තව දැන ගන්න<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">Browther හට ඔබේ අත් නිරීක්ෂණය කිරීමට අවසරය අවශ්‍යයි</translation>
<translation id="1627123463102858476">ඔබ මෑත පැමිණ නැත. Browther <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> ඉවත් කළා.</translation>
<translation id="5174969993834422967">ඔබ සාමාන්‍යයෙන් දැනුම් දීම් අවහිර කරයි. මෙම අඩවිය ඔබට දැනුම් දීමට ඉඩ දීමට, ඔබේ ස්ථාන තීරුවේ දකුණු කෙළවරේ ඇති දැනුම්දීම් නිරූපකය ක්ලික් කරන්න.</translation>
<translation id="5174983315706567306">ප්‍රමාණවත් තැටි ඉඩක් නැත.</translation>
<translation id="7091313576354542088">Browther ගිණුමට නැවත සත්‍යාපනය අවශ්‍යයි</translation>
<translation id="9045390598305758496">සුරැකි මුරපද නැත. ඔබ ඔබේ මුරපද පරීක්‍ෂා කරන විට Browther හට ඒවා පරීක්‍ෂා කළ හැක.</translation>
<translation id="5686724084351858452">Browther වෙතින් වරන්න</translation>
<translation id="5234764350956374838">ඉවත් කරන්න</translation>
