<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1026101648481255140">Орнатуды жалғастыру</translation>
<translation id="7099479769133613710">&amp;ChromeOS жүйесін жаңарту үшін қайта іске қосу</translation>
<translation id="7264054672589027446">Browther осы кеңейтімді қарап шығуды ұсынады</translation>
<translation id="7848219163187166649">Сайт беттегі сілтемелерді құпия түрде алдын ала жүктеуді сұрағанда, Browther браузері Browther серверлерін пайдаланады. Осылайша жеке деректеріңіз алдын ала жүктелетін сайттан жасырылады, бірақ Browther алдын ала жүктелетін сайттарды біледі.</translation>
<translation id="1065672644894730302">Реттеулерді оқу мүмкін емес.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін және параметрлерге жасалған өзгертулер сақталмайды.</translation>
<translation id="8837164267124113709">Ата-анаңыз Browther браузері үшін "Сайттарға, қолданбаларға және кеңейтімдерге арналған рұқсаттар" параметрін өшірді</translation>
<translation id="881513728707488138">Browther құпия сөздерді экспорттағысы келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="112640046208448578">Заттарды не орындарды анықтауға және мәтінді көшіруге не аударуға болады. "Сурет іздеу" функциясын пайдаланғанда, беттің скриншоты серверге жіберіледі. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther әдепкі браузеріңіз болып табылады</translation>
<translation id="6580138787163923852">Құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK"/>Browther браузеріне кіріңіз<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther мәзірін басыңыз.</translation>
<translation id="1157985233335035034">Жақында таңдалған тілдер</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> кеңейтім қосты, ол Browther жұмысын өзгертуі мүмкін.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Орнатылмады, себебі сіздегі Windows нұсқасына қолдау көрсетілмейді.</translation>
<translation id="8291401179516272335">Browther туралы ақпарат</translation>
<translation id="1203500561924088507">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME"/> пайдаланбас бұрын браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="1232234696885483911">"Сурет іздеу" функциясын ашқан кезде, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге автоматты түрде жіберіледі. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Аккаунтқа кірсеңіз, Browther-нен Browther аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. Мұны өзгерту үшін "Browther-дегі аккаунтыңыз" бөліміне өтіңіз.</translation>
<translation id="9034321258761608912">Бұл қойынды әрекетсіз тұрған кезде, Browther жылдам жұмыс істеуі үшін, жад босатылды. Сіз бұл сайтты әрекетсіз тұру тізімінен әрдайым шығарып отыру опциясын таңдай аласыз.</translation>
<translation id="249571811018731941">Browther жүктеп алуды блоктады, себебі бұл файл қауіпті.</translation>
<translation id="8850227089720975601">Gmail не YouTube сияқты Browther қызметтеріне <ph name="USER_EMAIL"/> көмегімен кірген кезде, Browther-ге сол аккаунтпен автоматты түрде кіруге болады.</translation>
<translation id="1290883685122687410">Реттеу қатесі: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Жаңа Browther профилінің параметрлерін реттеу</translation>
<translation id="4437862975743821367">Bluetooth құрылғыларын табу үшін Browther-ге Bluetooth пайдалану рұқсаты қажет. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Тілді анықтау</translation>
<translation id="1206925267243987362">Browther ұсынған браузер параметрлерін пайдалану</translation>
<translation id="8270483548049772782">Деректерді Browther-нен (<ph name="URL"/>) де жою</translation>
<translation id="1345251407431278948">Бекітілді! "Сурет іздеу" функциясына құралдар тақтасындағы жаңа түймені басу арқылы қайта кіруге болады.</translation>
<translation id="1356661055722410047">Жаңалық! Енді экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="1383876407941801731">Іздеу</translation>
<translation id="1592588950737518481">&amp;Browther профильдерін басқару</translation>
<translation id="1404026649028693342">AI режимін үнемі көрсету</translation>
<translation id="141901961143729572">Ойыңызды бөлісіңіз.</translation>
<translation id="1743952081001089298">Терезені бөлісу үшін жүйе параметрлерінде Browther-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="8627385813382688019">Browther for Testing бойынша анықтама алу</translation>
<translation id="1497802159252041924">Орнату қатесі: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Бұл бет қорғалған</translation>
<translation id="7252430412915798987">Browther қойындысын бөлісу</translation>
<translation id="6388429281015199562">Browther аккаунтына кіру</translation>
<translation id="1547469039832541117">Ерекшеленген тапсырманы аяқтайды.</translation>
<translation id="1801944307203212016">Browther браузеріне айналаңыздың 3D картасын жасау үшін камераны пайдалану рұқсаты керек.</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Бұл кеңейтімге енді қолдау көрсетілмейді. Browther оны өшіруге кеңес береді.}other{Бұл кеңейтімдерге енді қолдау көрсетілмейді. Browther оларды өшіруге кеңес береді.}}</translation>
<translation id="4667068923142532753">Browther-ді бекіту</translation>
<translation id="3006560544901646947">Browther-нің қауіпсіздік құралдары</translation>
<translation id="686052171138185761">Browther браузері Password Manager-дегі деректеріңізді жоюға рұқсат сұрайды. Рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="8713026329083542796">Browther-дегі құпиялық пен қауіпсіздікті басқарудың маңызды құралдарын қарап шығыңыз.</translation>
<translation id="1640672724030957280">Жүктеп алынып жатыр…</translation>
<translation id="1680687534629375545">Сурет іздеу функциясынан осы бет жайында сұрау</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> браузеріне кеңейтілген құқықтар береді.</translation>
<translation id="4243382967656566037">Бұл функцияларды жақсарту үшін Browther оларды қолдануыңыз туралы ақпаратты Browther-ға жібереді. Бұл деректерді тексерушілер оқуы, өңдеуі және aннотация қосуы мүмкін.</translation>
<translation id="1722488837206509557">Бұл жағдайда қолжетімді құрылғылардың арасынан таңдап, оларда контент көрсетуге болады.</translation>
<translation id="6820510278633522408">Browther жақын арада браузерді пайдалану деректерін жояды</translation>
<translation id="7775028004939172516">Browther браузері навигацияларды HTTPS кеңейтіміне жаңартып көреді.</translation>
<translation id="6963959729951758069">Browther деректері жойылды</translation>
<translation id="4085139922884095932">Browther <ph name="REMAINING_TIME"/> кейін қайта қосылады</translation>
<translation id="2586248102295515296">HTTPS қолжетімді болмаған кезде, Browther сізге ескертпестен, қауіпті байланысты пайдаланады.</translation>
<translation id="3975328336074677101">Browther жүйесін фонда іске қосуға рұқсат беру</translation>
<translation id="2497443204974841650">Browther қайта орнату</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> қолданып көрейін деп жатыр</translation>
<translation id="4553225588627299783">Келесі жолы Browther-ді <ph name="DEVICE_TYPE"/> құрылғысынан ашқан кезде, Browther Password Manager-ді пайдалану туралы нұсқауды көресіз.</translation>
<translation id="1838374766361614909">Іздеуді тазарту</translation>
<translation id="2337233040802538155">Браузерді пайдалану деректерін Browther аккаунтында сақтай отырып, тек осы құрылғыдан жою үшін <ph name="BEGIN_LINK"/>Browther-де аккаунттан шығыңыз<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Жолда жаңа қойындылар тобын ашу немесе жасау үшін телефоныңызға Browther-ді жүктеп алыңыз.</translation>
<translation id="2063443520349987970">Кірген Browther аккаунттарыңызды басқара аласыз. Browther аккаунттарыңыз Browther браузері, Play Store, Gmail және тағы басқа қызметтерде пайдаланылады. Егер отбасы мүшесі сияқты әлдебіреудің аккаунтын қосқыңыз келсе, жаңа пайдаланушыны <ph name="DEVICE_TYPE"/> құрылғыңызға қосыңыз. <ph name="LINK_BEGIN"/>Толығырақ<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">"Сурет іздеу" функциясымен іздеу</translation>
<translation id="1880677175115548835">Мәтінді таңдаңыз</translation>
<translation id="3183933389992069620">Бақыланатын аккаунт арқылы кіріп, оның әкімшісіне Browther профиліңізді басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Browther деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME"/> пайдаланушысына байланыстырылады. Бұл деректерді Browther аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. Бар Browther деректерін бөлек ұстау үшін қосымша жаңа профиль жасай аласыз. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther браузері біркелкі айналдыру және бейнекадр жиілігі сияқты фондық әрекеттерді және визуалдық әсерлерді шектеу арқылы батарея қуатын үнемдейді. <ph name="BEGIN_LINK"/>Қуат үнемдеу туралы толық ақпарат<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Осы бет жайында сұрақ қойыңыз</translation>
<translation id="9128006428501241840">"Browther-ді жаңарту құралы" қызметі</translation>
<translation id="6302815314157879372">Бұл функцияны өшіріп, Browther браузеріне кірместен Gmail сияқты Browther сайттарын пайдалана беруіңізге болады</translation>
<translation id="1063611196035804685">Browther жауап бермейді. Қазір қайта іске қосасыз ба?</translation>
<translation id="2873360330889594383">Ұйымыңыз (<ph name="MANAGER"/>) Browther-ге кіруді талап етеді</translation>
<translation id="4035053306113201399">Жаңарту күшіне енуі үшін ChromeOS жүйесін өшіріп қосу керек.</translation>
<translation id="2861285003831382718">Browther жүктеп алуды блоктады, себебі бұл файл түрі әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="1953553007165777902">Жүктеп алынып жатыр… <ph name="MINUTE"/> минут қалды.</translation>
<translation id="2080160985220483492">Browther-мен жұмыс істеу бойынша кеңес: құпия сөздерді сақтаңыз</translation>
<translation id="8037497710694492565">Browther әдепкі браузерді анықтай не орната алмайды</translation>
<translation id="7395009124247513849">Неліктен Browther кейбір файлдарды блоктайтыны туралы ақпарат жаңа қойындыдан ашылады.</translation>
<translation id="762710512520170632">Browther бағдарламалық құралын жаңартып отырады. Егер бұл қызмет өшірілген немесе тоқтатылған болса, Browther бағдарламалық құралыңыз жаңартылмайды. Нәтижесінде қауіпсіздік ақауларын жою мүмкін болмай, функциялар жұмыс істемеуі мүмкін. Бұл қызмет пайдаланылатын Browther бағдарламалық құралы болмаса, өздігінен жойылады.</translation>
<translation id="5793588180426267429">Құрылғыдан 1 элемент жойылады. Деректерді кейінірек алу үшін Browther браузеріне <ph name="USER_EMAIL"/> болып кіріңіз.</translation>
<translation id="2018879682492276940">Орнатылмады. Қайталап көріңіз.</translation>
<translation id="6351516710581760512">Басқа құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK"/>Browther браузеріне кіріңіз<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Параметрлер.</translation>
<translation id="8194525816714210105">Browther қызметтерінде жекелендірілген мүмкіндіктерді пайдалану үшін Browther тарихын қосу-қоспау нұсқасын таңдаңыз.</translation>
<translation id="5909559127548969159">Browther-ге жаңа көрініс беру үшін жаңа қойынды бетіндегі "Browther-ді бейімдеу" түймесін басыңыз.</translation>
<translation id="2066690553719545730">AI режимін үнемі көрсету</translation>
<translation id="3283892260110318935">Browther жүктеп алуды блоктады, себебі бұл – алдамшы файл және ол құрылғыңызға күтпеген өзгерістер енгізуі мүмкін.</translation>
<translation id="6160571936643742128">Browther iOS браузерін келесіде ашқанда, <ph name="FEATURE_NAME"/> функциясын пайдаланып көру туралы нұсқауды көресіз.</translation>
<translation id="8380517409933452343">Browther аккаунтыңызда сақталған құпия сөздеріңіз бен Browther-дегі басқа деректеріңіз осы құрылғыдан өшіріледі. Оларды Browther-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Browther 1 минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}other{Browther # минут бойы пайдаланылмаса, ұйымыңыз браузерді пайдалану деректерін автоматты түрде жояды. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін. Қойындыларыңыз ашық болады.}}</translation>
<translation id="2126108037660393668">Жүктеп алынған файл растаудан өтпеді.</translation>
<translation id="2135919691573380097">Осы сайт туралы шағымдану</translation>
<translation id="2137162749895930932">Аударма экранын жабу</translation>
<translation id="4283559398694996391">Browther жүктеп алуды блоктады, себебі сайтта қауіпсіз байланыс пайдаланылып жатқан жоқ және файл өзгертілген болуы мүмкін.</translation>
<translation id="2170098639895543546">Беттен кез келген нәрсені таңдау</translation>
<translation id="2495182092286337191">Browther-ді реттеу</translation>
<translation id="2174917724755363426">Орнату аяқталмады. Шынымен бас тартқыңыз келе ме?</translation>
<translation id="4877141231724140862">Browther – Желіге кіру - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Жаңа нұсқаны тексеру қатесі: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Аккаунтты Browther-нен өшіру</translation>
<translation id="1084363153644366288">iOS жүйесіне арналған Browther-дегі Күшейтілген Safe Browsing деректеріңізді фондық режимде қорғауға көмектеседі.</translation>
<translation id="7949164640723239455">Сайт қауіпті. Browther хабарландыруларды өшірді.</translation>
<translation id="2236949375853147973">Әрекеттерім</translation>
<translation id="4536403809133456417">Мекенжайлар мен басқа ақпаратты барлық құрылғыдан алу үшін Browther аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл мекенжай Browther аккаунтыңызға сақталады.</translation>
<translation id="5627930103267312171">Компьютерді бөлісетін болсаңыз, достарыңыз интернетке бөлек кіріп, Browther жүйесін қалауынша орната алады.</translation>
<translation id="2283803047247799269">Бұл қойындыны сурет іздеу функциясымен іздеу</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{Browther браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="2307973900865360088">Бекітілген күйде қалдыру</translation>
<translation id="5161617112768367959">URL мекенжайларын Browther браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді. Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Browther браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="4123094831918713833">Бұл әрекет:
          <ph name="LINE_BREAKS"/>
           • кейбір Browther параметрлері мен Browther таңбашаларын бастапқы күйге қайтарады;
           <ph name="LINE_BREAK"/>
           • кеңейтімдерді өшіреді;
           <ph name="LINE_BREAK"/>
           • cookie файлдарын және сайттың басқа уақытша деректерін жояды.
            <ph name="LINE_BREAKS"/>
           Бетбелгілерге, тарихқа және сақталған құпия сөздерге ештеңе болмайды.</translation>
<translation id="5456070119344236353">Нөмірді осы жерден Android телефонына жіберу үшін екі құрылғыда да Browther браузеріне кіріңіз.</translation>
<translation id="2356070529366658676">Сұрау</translation>
<translation id="2359808026110333948">Жалғастыру</translation>
<translation id="6468415397021485143">"<ph name="EXTENSION_NAME"/>" кеңейтімін қолдану үшін Browther-ге кіруіңіз керек</translation>
<translation id="2558600429878197587">Browther-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="5295781918312989856">Бұл кеңейтімді <ph name="USER_EMAIL_ADDRESS"/> ретінде пайдалану үшін Browther-ге кіріңіз.</translation>
<translation id="8418845734693287262">ChromeOS деректеріңізді синхрондай алмады, себебі аккаунтыңызға кіру мәліметтері ескірген.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 HID құрылғысын бір немесе бірнеше Browther кеңейтімі пайдаланды}=1{1 HID құрылғысын бір немесе бірнеше Browther кеңейтімі пайдаланып жатыр}other{# HID құрылғысын бір немесе бірнеше Browther кеңейтімі пайдаланып жатыр}}</translation>
<translation id="434258293817844111">Browther бұл сайт үшін камера мен микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="2403703063067034158">Іске қосу қатесі: қазір басқа орнату процесі жүріп жатыр, әрекетті кейінірек қайталаңыз.</translation>
<translation id="5458993228789433099">Кез келген қолданбадағы сілтемелерді Browther-нен ашып, браузерді тапсырмалар жолағында қолжетімді етіп қойыңыз.</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther-дегі құралдар<ph name="END_LINK"/> көмегімен браузерді қауіпсіз қолданып, барлығын басқаруға болады.</translation>
<translation id="2451727308784734061">Password Manager қызметіне жылдам өту үшін таңбашаны пайдаланыңыз. Таңбашаны компьютердің негізгі экранына немесе қолданбаларды іске қосу тақтасына жылжытуға болады.</translation>
<translation id="2280315911954332435">Browther жақын арада жабылады</translation>
<translation id="6410820860979094113">Browther аясында</translation>
<translation id="2485422356828889247">Жою</translation>
<translation id="2513154137948333830">Өшіріп қосу қажет: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">"Сурет іздеу" функциясымен мәтінді таңдаңыз.</translation>
<translation id="7892218991241200190">Browther бұрыннан бар құпия сөздерді ауыстырғысы келеді. Бұған рұқсат беру үшін Windows құпия сөзін енгізіңіз.</translation>
<translation id="8976443723926188033">Файлдарды жүктеп алу үшін Browther браузеріне сақтау орнын пайдалану құқығы қажет</translation>
<translation id="4131374838781785973">Browther Origin Helper</translation>
<translation id="2575822587468774919">"Сурет іздеу" функциясымен іздеу керек кез келген нәрсені таңдаңыз.</translation>
<translation id="8705561858232289221">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін Browther аккаунтына кіріңіз.</translation>
<translation id="437162022240011372">Browther-ді пайдалана беру</translation>
<translation id="259935314519650377">Жүктеп алынған орнату құралы кэштелмеді. Қате: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Жүйе</translation>
<translation id="2907676829052962091">Ұйымыңыз сіздегі бетбелгілер, тарих және құпия сөздер сияқты браузерді пайдалану деректерін көріп, басқара алады. Ол басқа Browther профильдеріндегі браузерді пайдалану деректерін көре алмайды.</translation>
<translation id="1289116577679005654">Browther деректерін <ph name="ACCOUNT_EMAIL"/> аккаунтында қолдану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="7192278346779151664">Орнату барысында операциялық жүйе қатесі орын алды. Browther қайта жүктеңіз.</translation>
<translation id="7724398260867885339">Құрылғыңызды басқа адамдар да пайдаланатын болса, достарыңыз және отбасыңыздың мүшелері интернетке бөлек кіріп, Browther параметрлерін өздері қалағандай орната алады.</translation>
<translation id="1679595317134614424">Browther қойындысы</translation>
<translation id="7189168846924379421">Қосымша қауіпсіздік үшін Browther деректеріңізді шифрлайды.</translation>
<translation id="4052643592793184278">Browther-нен Browther аккаунтын өшіру үшін аккаунттан шығыңыз.</translation>
<translation id="7694616023994438906">Құпия сөздерді, бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Browther аккаунтына кіріңіз.</translation>
<translation id="2738871930057338499">Интернетке қосылу мүмкін емес. HTTP 403 бойынша тыйым салынған. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="2753623023919742414">Іздеу үшін басыңыз.</translation>
<translation id="9078193405195503710">Browther-ді әдепкі PDF көру құралы ретінде орнату</translation>
<translation id="2456995288904753506">Browther стандартты автотолтыру функциясы толтыра алмайтын қиын өрістерді автоматты түрде толтыра алады.</translation>
<translation id="3271730304285122987">Бұл кеңейтімде зиянды бағдарлама бар болғандықтан, ол қауіпті. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Browther-нан жойыңыз.</translation>
<translation id="2799223571221894425">Қайта іске қосу</translation>
<translation id="1427337251963884503">Сіздің Browther браузеріңіз</translation>
<translation id="2816462166102338036">Бұл бейнені сурет іздеу функциясымен іздеу</translation>
<translation id="2841525013647267359">Бастапқы тіл</translation>
<translation id="2846251086934905009">Орнату қатесі: орнату аяқталмады, оның орнына доғарылды.</translation>
<translation id="928966105228355994">Browther жүйесінен алып тастау…</translation>
<translation id="587805782197019018">Аккаунтқа кірген кезде, Browther браузерінде қауіпсіздігіңізді қамтамасыз етеді және басқа Browther қолданбаларында қауіпсіздік деңгейін арттыру үшін пайдаланылуы мүмкін.</translation>
<translation id="2885378588091291677">Тапсырмалар реттегіші</translation>
<translation id="3055995278166070443">&amp;Browther туралы</translation>
<translation id="2915996080311180594">Кейін қайта қосу</translation>
<translation id="2928420929544864228">Орнату аяқталды.</translation>
<translation id="70453521937551896">Деректер құпия фразаңызбен шифрланды. Browther аккаунтыңызда Browther деректерін пайдалану және сақтау үшін оны енгізіңіз.</translation>
<translation id="2945997411976714835">Орнату қатесі: орнату процесі басталмады.</translation>
<translation id="3188308520233701133">iOS жүйесіне арналған Browther-де сақталған құпия сөздер арқылы сайттарға жылдам кіріңіз.</translation>
<translation id="8145318807880784886">Бетбелгілерді, құпия сөздерді және параметрлерді бөлек сақтау үшін жаңа Browther профилін қосыңыз.</translation>
<translation id="4330268530227888227">Browther-ді ұйымыңыз басқарады</translation>
<translation id="6488090896442998436">Browther жаңартылған</translation>
<translation id="300557164611864786">Егер сайт құпия сөзіңізді ұрлағысы келсе немесе зиянды файлды жүктеп алсаңыз, Browther браузері URL мекенжайларын, сондай-ақ бет контенті бөліктерін Safe Browsing қызметіне жіберуі мүмкін.</translation>
<translation id="2447145782593796785">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін Browther-ге кіріңіз.</translation>
<translation id="3003694935412297923">Барлық тапсырма</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther браузері деректерді Browther аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Browther браузері деректерді Browther аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="5522228731050510047"><ph name="URL"/> сілтемесі Browther-дегі жаңа қойындыдан ашылады.</translation>
<translation id="6358780591055960280">Browther сіздің құпия сөздеріңізді тексере алмай жатыр. Кейінірек қайталап көріңіз.</translation>
<translation id="1386422761453740126">Browther жүйесіне қосылуда…</translation>
<translation id="3038232873781883849">Сәлден соң орнатыла бастайды…</translation>
<translation id="3045032126857188731">Аударма тілі: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">"Пікір" диалогтік терезесін жабу</translation>
<translation id="369127628511662602">Басқа Browther профильдері</translation>
<translation id="2370255879896574713">Browther компаниясына жаңылыс туралы есептер және <ph name="UMA_LINK"/> жіберу арқылы Browther жақсартуға көмектесіңіз</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 USB құрылғысын бір немесе бірнеше Browther кеңейтімі пайдаланды}=1{1 USB құрылғысын бір немесе бірнеше Browther кеңейтімі пайдаланып жатыр}other{# USB құрылғысын бір немесе бірнеше Browther кеңейтімі пайдаланып жатыр}}</translation>
<translation id="2065456480740480340">Browther тарихы</translation>
<translation id="5011660649081947055">Орнату құралы мұрағаттан шығара алмады. Browther қолданбасын қайта жүктеңіз.</translation>
<translation id="310459126943037700">Тапсырмалар аяқталмады.</translation>
<translation id="3104828284009500087">Беттегі кез келген нәрсені іздеңіз.</translation>
<translation id="4917564010081457061">Құпия сөздеріңіз, бетбелгілеріңіз және тарихыңыз құрылғыларда синхрондалады. Әдепкі браузеріңізді Browther-ге жаңартып, өзіңізге таныс және ұнайтын функцияларды оңай пайдаланыңыз.</translation>
<translation id="1041472930719344928">Browther микрофоныңызды пайдалануда.</translation>
<translation id="3130333203120345554">Жаңадан іздеу</translation>
<translation id="3137969841538672700">Іздеу үшін курсорды жүргізіңіз.</translation>
<translation id="5312717254055363883">Бұл қойынды ресурстарды көп қолданып жатыр. Өнімділікті жақсарту үшін Browther-ге оны әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="373523409348786203">Экранды бөлісу үшін жүйе параметрлерінде Browther-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="802113445299754598">Browther қолданбасын қайта іске қосу</translation>
<translation id="3161522574479303604">Барлық тіл</translation>
<translation id="4522189060330781648">Компьютеріңіздегі басқа бір бағдарлама тақырып қосты, ол Browther жұмысын өзгертуі мүмкін.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">Жаңа Browther профилін реттеңіз.</translation>
<translation id="5150830326120505481">Browther-нен Browther аккаунтын өшіру үшін Browther-нен "Параметрлер" бетінде шығыңыз.</translation>
<translation id="7113660200899017820">Кейінірек Browther сізден үлгілерді автоматты түрде толтыру үшін сақталған ақпаратты пайдалану-пайдаланбау қажеттігін сұрауы мүмкін.</translation>
<translation id="4475011322243623412">Browther өзінің деректер каталогін оқи және оған жаза алмайды:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Қазір қайта іске қосу</translation>
<translation id="3536063527222598206">Browther API пернелері жоқ. Кейбір Browther функциялары өшіріледі.</translation>
<translation id="1011450868746766298">Browther жабылғанда, фондық қолданбаларды пайдалануды жалғастыру</translation>
<translation id="179611081153855734">Browther кез келген сайтты қауіпті байланыс арқылы жүктеу алдында сізге ескертеді.</translation>
<translation id="8965591964936552871">Browther-де аккаунтқа кірген болсаңыз, барлық Browther терезесін жапқан кезде, Browther аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз. Сайттар сізді есте сақтасын десеңіз, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Әдепкі іздеу жүйесі Browther-нен тыс өзгертілді. Сізді қорғау үшін Browther оны қайта орнатты.</translation>
<translation id="1170501833661894915">Барлық құрылғыңызға құпия сөздер, бетбелгілер мен т.б. ақпаратты алу үшін Browther браузеріне кіріңіз.</translation>
<translation id="3352986031709923790">іздеу аймағының жоғарғы оң жақ бұрышы: оң жақ <ph name="RIGHT"/>%, жоғарғы жақ <ph name="TOP"/>%</translation>
<translation id="120745000989996104">Аккаунтыңыздағы Browther деректері</translation>
<translation id="3369405342922656244">Бұл бетті сурет іздеу функциясымен іздеу</translation>
<translation id="7173761126541905083">Құпия сөздерді телефондағы Browther-мен пайдаланыңыз</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">Бұрыннан бар Browther профиліне ауыстырылсын ба?</translation>
<translation id="3412460710772753638">Осы құрылғыдағы Құпия сөз менеджерінде</translation>
<translation id="4282363917570905631">Телефоныңыздағы Browther браузерімен күшейтілген Safe Browsing мүмкіндіктерін кеңейтіңіз</translation>
<translation id="986094398735583155">Browther-ді сізге бейімдеп жатырмыз...</translation>
<translation id="3266047225484320321">Ұрланған құпия сөзбен кірген кезде, Browther сізге хабарлайды.</translation>
<translation id="3508047337876211050">Құрылғыдан <ph name="ITEMS_COUNT"/> элемент жойылады. Деректерді кейінірек алу үшін Browther браузеріне <ph name="USER_EMAIL"/> болып кіріңіз.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> арқылы Browther профильдерін ауыстыруға болады.</translation>
<translation id="7225005776233199285">Барлық Browther терезелерін жауып, әрекетті қайталап көріңіз.</translation>
<translation id="5465054931427475969">Терезені бөлісу үшін жүйе параметрлерінде Browther-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> әлдеқашан кірді.  Браузерді пайдалану тарихын бөлек сақтау үшін Browther-ге <ph name="USER_EMAIL_ADDRESS"/> ретінде жеке профиліңізбен кіріңіз.</translation>
<translation id="8133590217245064579">Экранды бөлісу үшін жүйе параметрлерінде Browther-ге экран жазуға рұқсат беріңіз.</translation>
<translation id="3597003331831379823">Реттеуді кеңейтілген құқықтармен бастау мүмкін болмады. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Browther аккаунтына кіріңіз</translation>
<translation id="2492221622209669678">Бұл пайдаланушының браузерді пайдалану деректері құрылғыдан жойылады. Деректерді қалпына келтіру үшін Browther браузеріне <ph name="USER_EMAIL"/> болып кіріңіз.</translation>
<translation id="6793778233257855801">Нөмірді <ph name="ORIGIN"/> құрылғысынан Android телефонына жіберу үшін екі құрылғыда да Browther браузеріне кіріңіз.</translation>
<translation id="3667616615096815454">Орнату мүмкін болмады, себебі сервер қолданбаны анықтай алмады.</translation>
<translation id="5585500151754164442">Browther аккаунтындағы барлық Browther дерегін шифрлау үшін <ph name="BEGIN_LINK"/>жеке құпия фразаны<ph name="END_LINK"/> пайдаланыңыз. Google Pay қызметіндегі төлеу әдістері мен мекенжайлары шифрланбайды. Browther-нің браузерді қолдану тарихы синхрондалмайды.</translation>
<translation id="404323216042159951">Browther сіздің құпия сөздеріңізді тексере алмай жатыр. Интернет байланысын тексеріп көріңіз.</translation>
<translation id="5004936474632127765">Сілтемені жаңа Browther қойындысында ашу</translation>
<translation id="6236643159256182256">Жекелендіру және басқа мақсаттарды орындау үшін Browther мен басқа Browther қызметтерін байланыстырыңыз.</translation>
<translation id="3729187154190517324">"Қойынды және т.б. қосу" түймесін басып, бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="1400697664933775238">Browther профильдерін басқару</translation>
<translation id="2461315395128103158">Неліктен Browther кейбір жүктеп алынғандарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="8058420662026104226">Тексеруге қажетті нәрсе болса, Browther сізге хабар береді</translation>
<translation id="3177448557921912221">Browther профильдері ақпараттың әртүрлі бөліктерін бөлек сақтауға көмектеседі. Жаңа профильді қазір қосыңыз.</translation>
<translation id="1541177876035612043">Browther сіз кіруіңіз мүмкін беттерді алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="3810973564298564668">Басқару</translation>
<translation id="1117103475254549453">Сақталған құпия сөздерді пайдалану үшін QR кодын қолданып, iOS-ке арналған Browther браузерін жүктеп алып, Browther аккаунтына кіріңіз.</translation>
<translation id="8880695882192156860">Browther-мен жұмыс істеу бойынша кеңес: Күшейтілген Safe Browsing</translation>
<translation id="3846683726093018685">**Қысқаша мазмұндау:** скриншоттағы контенттің негізгі тақырыбы мен мақсатын 30 сөзден аспайтын бір сөйлеммен сипатта.

          **Сұрақтар ұсыну:** пайдаланушының скриншотты жете түсінуіне көмектесетін, ой тудыратын 3–5 сұрақтан тұратын таңбаланған тізім жаса. Бұл сұрақтардың кемінде біреуі нақты визуалдық нысан, оның дизайны немесе орналасуы туралы болуы керек.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> – Browther Origin</translation>
<translation id="3885770153807205175">Тіл таңдағыш</translation>
<translation id="4861846616763552424">Browther-ді реттеу және басқару. Назар аударуыңыз қажет. Толығырақ ақпарат алу үшін басыңыз.</translation>
<translation id="6126366281251241386">Browther ашу үшін атыңызды басып, шарлауды бастаңыз.</translation>
<translation id="3892148308691398805">Мәтінді көшіру</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> бұл Browther профиліне кіріп қойған. Браузерді пайдалану деректерін бөлек сақтау үшін Browther сізге жеке профиль жасай алады.</translation>
<translation id="3821553157234855663">Browther браузеріңізді бейімдеңіз</translation>
<translation id="3941890832296813527">Орнату қатесі: орнату файлының атауы жарамсыз немесе оған қолдау көрсетілмейді.</translation>
<translation id="6482299900191767005">Browther құпия сөздерді көшіргісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="5853011008278898603">Browther аккаунтыңызға сақтаған құпия сөздер, төлеу әдістері және мекенжайлар осы құрылғыдан өшіріледі. Оларды Browther-де қайта пайдалану үшін аккаунтқа қайтадан кіріңіз.</translation>
<translation id="395904275706073188">Қорғалған беттерді оқу мүмкін емес. Басқа бетті байқап көріңіз.</translation>
<translation id="1832973663231751701">Browther сізді қалай қорғайтыны туралы ақпарат алыңыз</translation>
<translation id="4531502594774670767">Мекенжай жолағына немесе іздеу өрісіне терген кезіңізде, Browther ұсыныстар алу үшін терген нәрсеңізді ұйымның іздеу жүйесіне, жасанды интеллектіге және агент құралдарына жібереді.</translation>
<translation id="300013383485253006">&amp;Browther for Testing туралы</translation>
<translation id="1152920704813762236">ChromeOS туралы</translation>
<translation id="8126752030994997015">Сайтқа кірген кезіңізде, Browther браузері URL мекенжайының обфускация жасалған бөлігін IP мекенжайыңызды жасыратын құпиялық сервері арқылы <ph name="BEGIN_LINK"/>Google Safe Browsing-ге<ph name="END_LINK"/> жібереді. Сайтта күдікті әрекеттер орындалса, толық URL мекенжайлары және беттегі контент бөліктері де жіберіледі.</translation>
<translation id="3703994572283698466">ChromeOS жүйесі де <ph name="BEGIN_LINK_LINUX_OSS"/>Linux әзірлеу ортасы<ph name="END_LINK_LINUX_OSS"/> сияқты <ph name="BEGIN_LINK_CROS_OSS"/>ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS"/> арқылы қолжетімді болады.</translation>
<translation id="4022972681110646219">Экран мазмұнын аудару</translation>
<translation id="4023601594785368013">Түпнұсқа тілі: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Кез келген қолданба сілтемесін Browther-нен ашыңыз. Оңай қол жеткізу үшін ол тапсырмалар жолағына бекітіледі.</translation>
<translation id="3437506136408403836"><ph name="BEGIN_LINK"/>Ағымдағы параметрлерді<ph name="END_LINK"/> хабарлау арқылы Browther браузерін жақсартуға көмектесіңіз</translation>
<translation id="4050175100176540509">Соңғы нұсқасында қауіпсіздік жақсартылып, жаңа мүмкіндіктер берілген.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="2164947358785939495">Компьютеріңіздегі басқа бір бағдарлама кеңейтім қосты, ол Browther жұмысын өзгертуі мүмкін.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Browther 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}other{Browther # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады. Браузерді пайдалану деректері жойылады. Оларға тарих, автотолтыру және жүктеп алынғандар кіруі мүмкін.}}</translation>
<translation id="1535413545339990419">"Browther туралы ақпарат" бетіне өту</translation>
<translation id="692283249649018289">Браузеріңізге жаңа көрініс беру үшін Browther-ді бейімдеңіз</translation>
<translation id="6375229634133804834">Browther браузеріңізді бейімдеңіз</translation>
<translation id="4148957013307229264">Орнатылуда…</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> –Желіге кіру – Browther</translation>
<translation id="2911246138082876798">Browther үшін тамаша қолданбалар, ойындар мен тақырыптарды таба аласыз.</translation>
<translation id="2528977475313334293">Осы кеңейтімді және тағы басқасын компьютерлеріңізге орнату үшін Browther аккаунтына кіріңіз.</translation>
<translation id="8244267655940711467">Ата-анаңыздың таңдауымен интернетті қауіпсіз пайдалану үшін <ph name="USER_EMAIL_ADDRESS"/> ретінде кірген Browther профиліңізге ауысыңыз.</translation>
<translation id="4222932583846282852">Бас тартылуда…</translation>
<translation id="4224210481850767180">Орнату тоқтатылды.</translation>
<translation id="8219359042845534271">Browther дерегіңізді осы аккаунтпен байланыстырасыз ба?</translation>
<translation id="5520777668172961882">Стандартты қорғанысқа қарағанда сайттардағы көбірек деректерді талдау арқылы қауіпті сайттар, тіпті Browther-ға бұрын белгісіз болған сайттар туралы ескертеді. Browther ескертулерін өткізіп жіберуді таңдауға болады.</translation>
<translation id="2014920019837536689">Browther-нен шығу</translation>
<translation id="4341512411059715879">Browther жөнінде анықтама алу</translation>
<translation id="4281844954008187215">Қызмет көрсету шарттары</translation>
<translation id="322492684764924424">Орнату анықталмаған қате себебінен сәтсіз аяқталды. Ағымда Browther жұмыс істеп тұрса, оны жауып, әрекетті қайталаңыз.</translation>
<translation id="3813060261346666066">Құпия сөздерді Browther-нен экспорттау</translation>
<translation id="4304713468139749426">Құпия сөздер реттегіші</translation>
<translation id="4334241893986177674">Осы скриншотты іздеу</translation>
<translation id="4334294535648607276">Жүктеп алынды.</translation>
<translation id="2177954934431828302">Windows жұмысын бастағанда, Browther-ді іске қосады</translation>
<translation id="2472318668926455009">Browther-ді әдепкі браузер етіп орнату арқылы өзіңіз танитын, ұнататын және сенетін функцияларды оңай пайдаланыңыз. Жылдам кіру үшін, Browther тапсырмалар жолағына бекітіледі.</translation>
<translation id="1068681683510904753">Бұл құрылғыны пайдаланбас бұрын, <ph name="MANAGER"/> домені келесі Қызмет көрсету шарттарын оқып, қабылдауыңызды талап етеді. Бұл шарттар ChromeOS Шарттарын толықтырмайды, өзгертпейді және шектемейді.</translation>
<translation id="2897580280700805340">Browther браузерінен бәрібір шығасыз ба?</translation>
<translation id="4413205837991854510">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="2454897022983434851">Browther браузеріне фондық режимде жұмыс істеуге рұқсат беру</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Browther оны өшіруге кеңес береді. <ph name="BEGIN_LINK"/>Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK"/>}other{Browther оларды өшіруге кеңес береді. <ph name="BEGIN_LINK"/>Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Browther реттеу және басқару</translation>
<translation id="4427306783828095590">Жақсартылған қорғаныс фишинг пен зиянды бағдарламаларды бөгеуде көбірек істейді.</translation>
<translation id="4434353761996769206">Орнату құралының қатесі: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846">Browther-ді <ph name="MANAGER"/> басқарады</translation>
<translation id="4007482010626246887">Browther профилін қосу</translation>
<translation id="6888322430074420631">Browther for Testing туралы</translation>
<translation id="8912436499620582668">Browther аккаунтыңызда Browther деректерін пайдалану және сақтау үшін құпия фразаңызды енгізіңіз.</translation>
<translation id="4493028449971051158">Іске қосу қатесі: орнату құралын әкімші ретінде іске қосыңыз.</translation>
<translation id="4501471624619070934">Орнату мүмкін болмады, себебі бұл елде кіруге шектеу қойылған.</translation>
<translation id="8976207309012239417">Бұл кеңейтім пайдаланушы деректерін қалай жинап, қолданатыны сияқты құпиялық шараларын жарияламаған. Browther оны өшіруге кеңес береді.</translation>
<translation id="8888202093812883067">Browther Origin браузеріне қош келдіңіз! Жаңа браузер терезесі ашылды.</translation>
<translation id="6391148383688605718">Browther-ге айналаңызды картаға түсіруге және қолыңызды бақылауға рұқсат қажет.</translation>
<translation id="7756445485815468244">Басқа Browther профилінде әлдеқашан <ph name="USER_EMAIL_ADDRESS"/> ретінде кіргенсіз.</translation>
<translation id="137435413163730206">Browther беттерді алдын ала жүктейді, осылайша браузерді пайдалану және іздеу әрекеті тез жүреді. <ph name="BEGIN_LINK"/>Беттерді алдын ала жүктеу туралы толық ақпарат<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Зиянды деп ойлаған сайт туралы шағымданғанда, онлайн қауіпсіздікті барлық пайдаланушы үшін жақсартыңыз.</translation>
<translation id="3266647901351304597">Browther жүктеп алуды блоктады, себебі Safe Browsing функциясы өшірілді және файлды растау мүмкін емес.</translation>
<translation id="6980208900390333646">Телефоныңыздағы Browther-мен Google Lens-ді пайдаланып көріңіз</translation>
<translation id="4594305310729380060">Осы құрылғыдағы Құпия сөз менеджеріне</translation>
<translation id="5282047884678321451">Browther Origin қолданбалары</translation>
<translation id="4598116752460667024">Тізімнен кез келген процесті іздейді.</translation>
<translation id="4970880042055371251">ChromeOS нұсқасы</translation>
<translation id="4482468019601425607">Сәл қалды! Жаңартуды аяқтау үшін Browther жүйесін қайта іске қосыңыз.</translation>
<translation id="5517890123509214766">Browther-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Browther-нің шабуылдарға төзімділігі сәл азаяды.</translation>
<translation id="7690070364551268156">Browther пайдалану есептерін де бөліссеңіз, бұл есептерде сіз кірген URL мекенжайлары қамтылады.</translation>
<translation id="5020487088453637212">Профиль басқа Browther процесімен (<ph name="PROCESS_ID"/>) басқа компьютерде (<ph name="HOST_NAME"/>) пайдаланылып жатыр. Бүлінбеуі үшін Browther профильді құлыптап қойды. Басқа процестер бұл профильді пайдаланып жатпаса, профильді құлыптан ашып, Browther қайта іске қосуыңызға болады.</translation>
<translation id="4680828127924988555">Орнатудан бас тарту</translation>
<translation id="8134827615154347946">Browther деректерінің кейбірі Browther аккаунтыңызға әлі сақталмаған. Шығу алдында бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="3508712423420506333">Аккаунтқа кірсеңіз, Browther-нен Browther аккаунтыңыздағы құпия сөздер мен т.б. ақпаратты пайдалана аласыз. <ph name="SHORTCUT"/> тіркесімі арқылы Browther қызметтерінің параметрлерін өзгертуге болады.</translation>
<translation id="2388739442635757494">Бұрын әлдекім осы компьютерден Browther браузеріне <ph name="ACCOUNT_EMAIL_LAST"/> болып кірген. Ақпаратты бөлек ұстау үшін жаңа Browther пайдаланушысын жасаңыз.</translation>
<translation id="4724676981607797757">Орнатылмады, себебі қолдау көрсетілмейтін протокол қатесі пайда болды.</translation>
<translation id="8305313684264112434">Browther браузерінен бәрібір шығасыз ба?</translation>
<translation id="418155915144835101">Browther браузеріне қазір ғана қауіпсіздік бойынша арнайы жаңартылған нұсқа қолданылды. Оны қазір қайта ашсаңыз, қойындылар қалпына келтіріледі.</translation>
<translation id="2683970367518529374">Browther-нен сұрау</translation>
<translation id="5064473048847774331">Жақында кірмедіңіз. Browther <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> рұқсаттарын және тағы <ph name="COUNT"/> рұқсатты өшірді.</translation>
<translation id="5941343075741207533">Browther сіздің құпия сөздеріңізді тексере алмай жатыр. 24 сағаттан кейін қайталап көріңіз немесе <ph name="BEGIN_LINK"/>құпия сөздерді Browther аккаунтынан тексеріңіз<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">Brave Search қызметіндегі емле тексеру құралы пайдаланылады. Браузерде терілген мәтін Browther-ға жіберіледі. Мұны параметрлерде өзгертуіңізге болады.</translation>
<translation id="4581078588976787792">Browther-ді аккаунтсыз қолдану</translation>
<translation id="3394520491703535051">mDNS трафигіне рұқсат беретін Browther Origin кіріс ережесі.</translation>
<translation id="6563126962881169552">&amp;Browther-ді жаңарту үшін қайта іске қосу</translation>
<translation id="4918086044614829423">Қабылдау</translation>
<translation id="4918844574251943176">Сурет көшірілді.</translation>
<translation id="5240982928057703861">Browther фондық режимде.</translation>
<translation id="3603134280602182991">Browther-ге кірудің диалогтік терезесін жабу үшін басыңыз.</translation>
<translation id="6120233890602288442">Browther профильдері арқылы Browther-дегі барлық материалыңызды бөле аласыз. Достар мен отбасыңызға арналған немесе жұмысқа не көңіл көтеруге бөлек профильдер жасаңыз.</translation>
<translation id="5722688387568011881">Қонақтар Browther қолданбасын ешқандай дерек қалдырмай пайдалана алады.</translation>
<translation id="7786958592460743302">Browther-дегі аккаунтыңыз</translation>
<translation id="9114640791491590337">Browther жүйесіне өзіңізді қосу</translation>
<translation id="3536391594566515053">Browther-дегі Gemini қойындыларыңызда істеп, сіз берген тапсырмаларды орындау үшін автоматты түрде шолу функциясын пайдаланады. <ph name="LINK_BEGIN"/>Толық ақпарат<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">Browther қолыңызды бақылауға рұқсат сұрайды.</translation>
<translation id="1627123463102858476">Жақында кірмедіңіз. Browther <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> рұқсаттарын өшірді.</translation>
<translation id="5174969993834422967">Әдетте хабарландыруларға тыйым саласыз. Бұл сайт сізге хабарландыру жіберсін десеңіз, локация жолағының оң жақ бұрышындағы хабарландыру белгішесін басыңыз.</translation>
<translation id="5174983315706567306">Диск жады жеткіліксіз.</translation>
<translation id="7091313576354542088">Browther аккаунтын қайта аутентификациялау қажет.</translation>
<translation id="9045390598305758496">Ешқандай құпия сөз сақталмаған. Құпия сөздер сақталған кезде, Browther оларды тексере алады.</translation>
<translation id="5686724084351858452">Browther жүйесінен шығу</translation>
<translation id="5234764350956374838">Жабу</translation>
<translation id="5254739261293693943">Осы бейне жайында сұрау</translation>
<translation id="8165028066129227692">Өзгерістер енуі үшін, Browther браузерін қайта қосыңыз</translation>
<translation id="5286907366254680517">Анықталды</translation>
<translation id="198210130507193824">Browther қолданбасын жүктеп алу</translation>
<translation id="8472078903122489041">"Browther-ді жаңарту құралы" ішкі қызметі</translation>
<translation id="5346389065299425353">Бірнеше қойынды, файл және құрал қосып, жан-жақты іздеңіз.</translation>
<translation id="3904682305383981098">Browther тексеруге қажетті қауіпсіздікке қатысты кейбір ұсыныстарды тапты</translation>
<translation id="509616246140011182">Басқа Browther профильдері</translation>
<translation id="8214429210535362385">Бақыланатын аккаунт арқылы кірдіңіз және оның әкімшілік бөлігін Browther профилі арқылы басқару мүмкіндігін бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты Browther деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME"/> пайдаланушысына байланыстырылады. Бұл деректерді Browther аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">Қосымша код: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">Жекелендіру үшін Browther-ді интернет пен қолданбаларды пайдалану тарихына қосыңыз.</translation>
<translation id="8096544113811780871">Неліктен Browther кейбір файлдарды блоктайтыны туралы ақпарат алыңыз</translation>
<translation id="2384387444932590174">Browther жаңартылуда (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">Browther браузеріне кіруге рұқсат ету</translation>
<translation id="6557334704331248411">Browther-нен жою</translation>
<translation id="5832041381258620673">Өнімділік азаяды, бірақ Browther шабуылдарға төзімді болады.</translation>
<translation id="3763317028635993788">Әдепкі браузер ретінде Browther қолданбасын орнату</translation>
<translation id="862357563072119126"><ph name="PAGE_TITLE"/> - Browther Origin бета нұсқасы</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{Browther браузер жұмысын баяулататын қойындыны кідіртуді ұсынады}other{Browther браузер жұмысын баяулататын қойындыларды кідіртуді ұсынады}}</translation>
<translation id="4423621904097888155">Browther дұрыс жұмыс істемеуі мүмкін, себебі оған Linux жүйесінде қолдау көрсетілмейді.</translation>
<translation id="6201726364919996698">Browther бұл файлды жүктеп алуға тыйым салды, себебі ол жеке және әлеуметтік желі аккаунттарыңызға қауіп төндіруі мүмкін</translation>
<translation id="7679204468655335605">Бұл сайтқа көрсету үшін Browther браузері орналасқан жеріңізді білуі керек</translation>
<translation id="1163572992704966942">Browther ең соңғы жүйе жаңартуларын орнатуда, күте тұрыңыз.</translation>
<translation id="5050118226119231029">Browther құпия сөздерді өзгерткісі келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="5524890928877629608">іздеу аймағының жоғарғы сол жақ бұрышы: сол жақ <ph name="LEFT"/>%, жоғарғы жақ <ph name="TOP"/>%</translation>
<translation id="5875549039106594731">PDF-терді Browther-де ашу</translation>
<translation id="5536164441519929134">Осы қойынды туралы<ph name="LINE_BREAK"/>сұраңыз</translation>
<translation id="5579324208890605088">Іске қосу қатесі: орнату құралын әкімші емес, кәдімгі пайдаланушы ретінде іске қосыңыз.</translation>
<translation id="202315329304302571">Browther-ді әдепкісінше пайдалану және бекіту</translation>
<translation id="5596627076506792578">Қосымша опциялар</translation>
<translation id="5605834417512968703">"Сурет іздеу" функциясы арқылы іздеу керек кез келген нәрсені таңдаңыз немесе бұл функциядан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="5618818588972826921">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз немесе "Сурет іздеу" функциясынан шығу үшін Escape пернесін басыңыз.</translation>
<translation id="5823076755666406442">{0,plural, =0{Browther браузерінің жаңартылған нұсқасы қолжетімді}=1{Browther браузерінің жаңартылған нұсқасы қолжетімді}other{Browther браузерінің жаңартылған нұсқасы # күннен бері қолжетімді}}</translation>
<translation id="8414129876440043675">Browther браузерін жапқан кезде құрылғыңыздан сайт деректерін үнемі жою</translation>
<translation id="5156991567152325333">Browther браузерін қайта іске қосыңыз</translation>
<translation id="5710072384986281834">Browther LLC</translation>
<translation id="1536693367017293028">Browther жүйесін осы тілде көрсету</translation>
<translation id="569897634095159764">Интернетке қосылу мүмкін емес. Прокси-сервер үшін аутентификация қажет.</translation>
<translation id="4215338057953170891">Browther профильдері жеке браузерді пайдалану тарихы мен жұмыс тарихын бөлек сақтауға мүмкіндік береді. Жаңа профильді қазір қосыңыз.</translation>
<translation id="5366435608642317052">Browther әрекетсіз қойындылардағы жадты босатады. Мұның нәтижесінде белсенді қойындылар мен басқа қолданбаларға қосымша компьютер ресурстары үлестіріліп, Browther жылдам жұмыс істейді. Әрекетсіз қойындыларды ашқанда, олар автоматты түрде қайтадан белсенді болады. <ph name="BEGIN_LINK"/>Жад үнемдегіш туралы толық ақпарат<ph name="END_LINK"/></translation>
<translation id="4941518395341035738">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, аккаунтыңыздағы Browther деректерін <ph name="SETTINGS_LINK"/>.</translation>
<translation id="7763291835437810978">Browther-ді бейімдеңіз және басқарыңыз. Browther-ді әдепкі браузер етіп орнатыңыз.</translation>
<translation id="5809516625706423866">Интернетке қосылу мүмкін емес. HTTP 401 бойынша рұқсат берілмейді. Прокси конфигурациясын тексеріңіз.</translation>
<translation id="1827132270895283425">Browther-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Browther-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр өшірулі.</translation>
<translation id="1553025851718680114">Browther аккаунтындағы Browther деректерін пайдалану және сақтау үшін Browther-ді жаңартыңыз.</translation>
<translation id="5824893331272123205">Бұл панельді жүктеу мүмкін болмады. Әрекетті қайталаңыз</translation>
<translation id="6642862349634944253">Browther Origin жүйесіне қош келдіңіз</translation>
<translation id="5871205389137001634">"Сурет іздеу" функциясынан шығу үшін басыңыз.</translation>
<translation id="7586794330537887406">Browther бұл элементтерде зиянды бағдарлама бар екенін анықтады:</translation>
<translation id="1666897346518812892">Браузеріңізде ең қауіпсіз параметрлер бар екеніне көз жеткізу үшін Browther жүйелі түрде тексереді. Пікіріңіз керек болса, сізге хабар жібереміз.</translation>
<translation id="5895138241574237353">Қайта іске қосу</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> – Желіге кіру</translation>
<translation id="5924017743176219022">Интернетке қосылып жатыр…</translation>
<translation id="5941711191222866238">Жию</translation>
<translation id="4938357262936377412">Осы бетбелгі және басқа да көптеген нәрселер барлық құрылғыңызда болуы үшін, Browther-ға кіріңіз.</translation>
<translation id="260974496993853147">Browther-ді өзіңізге сай бейімдеңіз</translation>
<translation id="5960071705175224773">Параметрлеріңізді белгісіз қолданба өзгертті</translation>
<translation id="5968400720580217226">AI режимі</translation>
<translation id="8697015289720079159">{COUNT,plural, =1{Browther 1 минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}other{Browther # минут бойы пайдаланылмаса, ұйымыңыз оны автоматты түрде жабады.}}</translation>
<translation id="5852664780493076676">Browther браузерін жаңартып, синхрондауды бастаңыз</translation>
<translation id="6003112304606738118">Жүктеп алынып жатыр… <ph name="HOURS"/> сағат қалды.</translation>
<translation id="6009821354356307391">Қосымша сұрақ қойыңыз</translation>
<translation id="6040143037577758943">Жабу</translation>
<translation id="2495504229007749358">Деректеріңізді қорғау үшін Browther-ге сіз соңғы уақытта кірмеген сайттар рұқсаттарын өшіруге рұқсат беріңіз. Хабарландырулар көрсетіле береді.</translation>
<translation id="6038969823662006832">&amp;Browther жүйесінде ашу</translation>
<translation id="6069027071882229820">Сурет түрінде көшіру</translation>
<translation id="6606690217326148454"><ph name="EXTENSION_NAME"/> кеңейтімі Browther браузеріне енгізілді</translation>
<translation id="6037324269860323082">Browther браузерін реттеңіз және басқарыңыз. Жаңартылған нұсқа қолжетімді.</translation>
<translation id="3695768481578778794">Қосулы • Browther бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="4401885752362736126">Browther-дегі аккаунтыңыз</translation>
<translation id="4310817187912076496">Кеңейтімге Browther құралдар тақтасында сайтқа кіру сұрауларын көрсетуге рұқсат беру</translation>
<translation id="4602490888173698813"><ph name="FILE_NAME"/> қауіпті болғандықтан, Browther оны бөгеді.</translation>
<translation id="5139243417751674628">Browther жақын арада жабылып, деректерді жояды</translation>
<translation id="4696750309605389299">Осы жерде Browther профильдерін ауыстыра аласыз.</translation>
<translation id="7475001351099358916">Егер cookie файлдарына рұқсат берсеңіз, Browther оларды алдын ала жүктеу кезінде пайдалануы мүмкін.</translation>
<translation id="6165508094623778733">Толық ақпарат</translation>
<translation id="5975099973700540482">Аккаунттағы Browther деректерін тазалау</translation>
<translation id="6800151735486681860">Бұл файл қауіпті болуы мүмкін.<ph name="LINE_BREAK"/>Құпия сөзді көрсетсеңіз, Browther бұл жүктеп алу әрекетін тексере алады. Файл туралы ақпарат Google Safe Browsing қызметіне жіберіледі, бірақ файл контенті мен құпия сөз құрылғыңызда қалады.</translation>
<translation id="6182736845697986886">Орнатылмады, себебі жаңарту серверінде ішкі қате пайда болды.</translation>
<translation id="48832130233362517"><ph name="TARGET_DEVICE_NAME"/> құрылғысындағы Browther браузеріне кіргеніңізді тексеріп, қайта жіберіп көріңіз.</translation>
<translation id="8868210753005945522">Компьютеріңіздегі басқа бір бағдарлама қолданба қосты, ол Browther жұмысын өзгертуі мүмкін.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">Бұл компьютерде жаңа Browther нұсқасы бұрыннан бар. Бағдарламалық жасақтама жұмыс істемесе, Browther жойып, әрекетті қайталап көріңіз.</translation>
<translation id="9222998061982994203">{0,plural, =0{Browther браузері қазір қайта іске қосылады}=1{Browther браузері 1 секундтан кейін қайта іске қосылады}other{Browther браузері # секундтан кейін қайта іске қосылады}}</translation>
<translation id="6239161312595354541">Сурет іздеу функциясынан осы бейне жайында сұрау</translation>
<translation id="1755464917870815989">Browther файлдарды жүктеп алу үшін жадты пайдалануға рұқсат сұрайды.</translation>
<translation id="304681001513922736">URL мекенжайларын Browther браузерінде сақталған қауіпсіз емес сайттар тізімімен салыстырып тексереді.</translation>
<translation id="7785903492969539081">Әдепкі браузер ретінде Browther орнату</translation>
<translation id="3987833816263696343">Browther жүйесінен шығасыз ба?</translation>
<translation id="4723540739671534529">Бұл қойындылар тым көп ресурстар қолданып жатыр. Өнімділікті жақсарту үшін Browther-ге оларды әрекетсіз қылуға рұқсат беріңіз.</translation>
<translation id="6540151687468239291">Browther профилін реттеу</translation>
<translation id="770793114032605647">Browther профиліне ат қойыңыз</translation>
<translation id="385867753870250529">Кеңейтімді қолдану үшін Browther-ге кіруіңіз керек</translation>
<translation id="2022337046348377650"><ph name="FILE_NAME"/> қауіпті болуы мүмкін болғандықтан, Browther оны бөгеді.</translation>
<translation id="45270956603278068">Browther камераңызды пайдалануда.</translation>
<translation id="6327105987658262776">Ешқандай жаңарту жоқ.</translation>
<translation id="673633752219771459">Browther браузерінде басқа операция орындалуда. Әрекетті кейінірек қайталаңыз.</translation>
<translation id="1482759407165416070">Енді Browther қолданбасын Browther аккаунтымен және ортақ компьютерлерде пайдалану жеңілірек.</translation>
<translation id="5538042432112726532">Browther пернелер тіркесімі</translation>
<translation id="833085228901080512">Browther жүктеп алуды блоктады, себебі бұл файл әдетте жүктеп алынбайды және ол қауіпті болуы мүмкін.</translation>
<translation id="491120842288314439">Browther жою қажет пе?</translation>
<translation id="6375219077595103062">Password Manager таңбашасын қосу</translation>
<translation id="6388799252195623474">осы бетке қатысты көмек қажет</translation>
<translation id="6715003312952407375">Жалғастыру үшін Browther-ге <ph name="EMAIL"/> аккаунтымен кіріңіз. Осылайша ұйым саясаттары сақталады.</translation>
<translation id="1897845318651970239">Компьютер экранындағы Browther логотипі.</translation>
<translation id="4702069255970029302">Browther Origin — веб-беттер мен қолданбаларды өте жылдам ашатын веб-браузер. Ол жылдам, тұрақты және пайдалануға оңай. Browther Origin жүйесіне ендірілген зиянды бағдарлама және фишинг қорғанысымен интернетті уайымсыз пайдалана беруіңізге болады.</translation>
<translation id="5669767676913031391">Browther жылдам істейді. JavaScript қолданатын функциялар тиісті түрде істеуі керек.</translation>
<translation id="6436260184216827876">"Сурет іздеу" функциясы істемейді. Кейінірек қайталап көріңіз.</translation>
<translation id="2139300032719313227">ChromeOS жүйесін өшіріп қосу</translation>
<translation id="6110616900529884221">Browther сіз кіруіңіз мүмкін көбірек бетті алдын ала жүктейді, сонда оларға кірген кезіңізде, тезірек жүктеледі.</translation>
<translation id="1217194059001819677">Бағаларды бақылау және кез келген сайтта баға түскен кезде, хабарландырулар алу үшін телефоныңызға Browther-ді жүктеп алыңыз.</translation>
<translation id="7058555680120557198">Өшірулі • Browther бұл кеңейтімнің қайдан келгенін анықтай алмайды.</translation>
<translation id="676533642429632127">Browther профильдеріне қош келдіңіз!</translation>
<translation id="5518682889576009702">Келесі жолы Browther-ді <ph name="DEVICE_TYPE"/> құрылғысынан ашқан кезде, қойындылар топтарын пайдалану туралы нұсқауды көресіз.</translation>
<translation id="6038105561107837619">Аккаунтты Browther-нен өшіру</translation>
<translation id="2675662665675552980">Сонымен қатар Browther іске қосылғанда қайсы бет көрсетілуін бақылайды.</translation>
<translation id="648319183876919572">Күшейтілген Safe Browsing-нің қауіпті веб-сайттар мен файлдардан қорғау қабілеті жоғарырақ.</translation>
<translation id="2930243146591999795">Browther жою</translation>
<translation id="5241183382286817629">Пернелер тіркесімдері Browther-нен ашылады.</translation>
<translation id="7907014599435829661">Ұйымыңыз Browther-ді <ph name="TIMEOUT_DURATION"/> бойы пайдаланбаған кезде жабады. Браузерді пайдалану деректері жойылды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="2088471423667794811">Әр профильде бетбелгілер, тарих, құпия сөздер және тағы басқа Browther ақпараты бар.</translation>
<translation id="9040334484455218184"><ph name="BEGIN_LINK"/>Browther-нің деректеріңізді құпия сақтау жолы<ph name="END_LINK"/> туралы толық ақпарат</translation>
<translation id="1718697235867382480">Бұл параметрге енгізілген өзгерістер Browther өшіп қосылғаннан кейін күшіне енеді.</translation>
<translation id="6331317152404762758">Басқа Browther профиліндегі құпия сөздерді көру үшін ауысуға болады</translation>
<translation id="6097706403184348562">Емле қателерін түзету үшін Browther браузері мәтін жолына терілген сөздерді Browther-ға жібереді</translation>
<translation id="2319647238307402812">Browther хабарландыру параметрлері бөліміне өту</translation>
<translation id="6600016381025017075">Бұл беттен кез келген нәрсені іздеңіз.</translation>
<translation id="8031938899816118394">Өзгертулеріңіз Browther келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="7412185356697187964">Windows жұмысын бастаған кезде, Browther іске қосылады, сондықтан браузерді бірден пайдалануға болады. Оны параметрлерден өшіруге болады.</translation>
<translation id="9123343592576384616">Тоқтаған жерден жалғастырыңыз: Browther соңғы сеанстағы қойындыларды қалпына келтірді. Мұны келесі бөлімде өшіруге болады:</translation>
<translation id="5847926498049048567">Browther айналаңыздың 3D картасын жасау үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="5532585028508811858">Бетбелгілерді Browther аккаунтыңызда да сақтасаңыз, Browther-дe өнім бағаларын бақылап, баға төмендеген кезде, хабарландыру аласыз.</translation>
<translation id="6676384891291319759">Интернетке кіру</translation>
<translation id="1363996462118479832">Кіру кезіндегі қате себебінен ChromeOS деректеріңізді синхрондай алмады.</translation>
<translation id="3373239673945775810">Browther-нен бұл қолданба деректерін өшіру</translation>
<translation id="8122759674786039814">Browther қандай жарнама көрсетілетінін басқаруыңызға мүмкіндік береді және қандай сайттар жекелендірілген жарнамалар көрсеткен кезде, сізден ақпарат алатынын шектейді.</translation>
<translation id="6277682530398500159">Browther бұл сайт үшін микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="6712881677154121168">Жүктеп алу қатесі: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">Профиліңізді пайдалану мүмкін емес, себебі ол жаңарақ Browther нұсқасынан.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін. Басқа профиль каталогін көрсетіңіз немесе жаңарақ Browther нұсқасын пайдаланыңыз.</translation>
<translation id="871671753163165892">Жекелендіру мен басқа функцияларды алу үшін Browther-ді интернет пен қолданбаларды пайдалану тарихы мен байланысқан Browther қызметтеріне қосыңыз.</translation>
<translation id="5000832110229523807">Browther компьютердегі барлық пайдаланушылар үшін әлдеқашан орнатылған.</translation>
<translation id="5204575479550973859">Бетбелгілер мен басқа ақпаратты барлық құрылғыдан алу үшін Browther аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл бетбелгі Browther аккаунтыңызға сақталады.</translation>
<translation id="2874208284092283937">Browther-нің V8 жүйесімен сайттар жылдам жұмыс істейді, бірақ Browther-нің шабуылдарға төзімділігі сәл азаяды. Бұл параметр қосулы.</translation>
<translation id="3268577459683869744">{count,plural, =1{Browther деректерінің кейбірі Browther аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер (1 элемент) жойылады.}other{Browther деректерінің кейбірі Browther аккаунтыңызда әлі сақталмаған. Шықпай тұрып, бірнеше минут күтіп көріңіз. Қазір шықсаңыз, бұл деректер ({count} элемент) жойылады.}}</translation>
<translation id="7683816018918395929">Browther бұл файлды сканерлеуді ұсынады, себебі ол қауіпті болуы мүмкін.</translation>
<translation id="1547295885616600893">ChromeOS қосымша <ph name="BEGIN_LINK_CROS_OSS"/>ашық кодты бағдарламалық құрал<ph name="END_LINK_CROS_OSS"/> арқылы қолжетімді болады.</translation>
<translation id="6831043979455480757">Аудару</translation>
<translation id="2142653375108595728">Құпия сөздеріңіз ұрланған жағдайда, Browther бұл туралы хабарлайды.</translation>
<translation id="684888714667046800">Интернетке қосылу мүмкін емес. Брандмауэр пайдалансаңыз, <ph name="PRODUCT_EXE_NAME"/> өнімінің рұқсат тізімінде екеніне көз жеткізіңіз.</translation>
<translation id="7333549743055076502">Browther – <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">Жалғастыру үшін Tab пернесін басыңыз.</translation>
<translation id="6862030660799253820">Бұл суретті сурет іздеу функциясымен іздеу</translation>
<translation id="3860339351709082396">Browther "<ph name="EXTENSION_NAME"/>" кеңейтімінде зиянды бағдарлама бар екенін анықтады.</translation>
<translation id="6877155553248388166">іздеу аймағының төменгі оң жақ бұрышы: оң жақ <ph name="RIGHT"/>%, төменгі жақ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">Көшіру</translation>
<translation id="7804113502310231166">Browther-ді әдепкі браузер ретінде орнатып, тапсырмалар жолағына бекітіңіз.</translation>
<translation id="3228374215117173004">&amp;Browther профильдерін басқару</translation>
<translation id="6934579572334859869">Сурет іздеу функциясынан осы сурет жайында сұрау</translation>
<translation id="5995328366516663808">Browther-нің <ph name="BOOKMARK_LIMIT"/> бетбелгі шегіне жеттіңіз, сондықтан кейбір бетбелгілер Browther аккаунтыңызға әлі сақталмады.

Кейбір бетбелгілерді жоймайынша, аккаунтыңызға жаңа бетбелгілерді сақтау мүмкін емес. Аккаунттан қазір шықсаңыз, сақталмаған бетбелгілер жойылады.</translation>
<translation id="6965382102122355670">Жарайды</translation>
<translation id="4533562834763015352">Құпия сөзіңіз оңай болса, оны табу да оңай. Browther браузеріне <ph name="BEGIN_LINK"/>күрделі құпия сөздер жасауға және сақтауға<ph name="END_LINK"/> мүмкіндік беріңіз.</translation>
<translation id="3453763134178591239">ChromeOS шарттары</translation>
<translation id="5379058926689137454">Browther браузеріне бұл сайтта микрофонды пайдалану үшін рұқсат керек</translation>
<translation id="4684462982894889021">Browther деректерін <ph name="ACCOUNT_EMAIL"/> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="7011190694940573312">Орнатылмады, себебі операциялық жүйенің бұл нұсқасына қолдау көрсетілмейді.</translation>
<translation id="7024536598735240744">Пакеттен шығару қатесі: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">Орнату тоқтап қалды.</translation>
<translation id="8257174622576051374">Browther браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="7047386856539490735">Бұл нәтижелер пайдалы ма?</translation>
<translation id="1772745060691790742">Browther жаңарту</translation>
<translation id="4937970118065051027">Егер суреттің пайдалы сипаттамасы болмаса, Browther оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Browther-ға жіберіледі.</translation>
<translation id="1594112132009288601">Browther for Testing қызметін бейімдеу</translation>
<translation id="5915000938288527952">Хабарлардағы, құжаттардағы және басқа қолданбалардағы сілтемелерді басып, Browther браузерін кез келген уақытта пайдалана аласыз.</translation>
<translation id="8775664994493381735">Browther-нен <ph name="EXTENSION_NAME"/> кеңейтімін жою</translation>
<translation id="3276648807841991013">Ұйымыңыз Browther деректерін <ph name="TIMEOUT_DURATION"/> бойы пайдаланбаған кезде жояды. Оларға тарих, автотолтыру мәліметтері және жүктеп алынғандар кіруі мүмкін.</translation>
<translation id="4725226878394159809">Browther бұл сайт үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="8931474625901592021">Browther браузері қосылмады. Қайталап көріңіз.</translation>
<translation id="8242947409070121799">Browther сіздің құпия сөздеріңізді тексере алмай жатыр. 24 сағаттан кейін қайталап көріңіз.</translation>
<translation id="1737922827960215472">Browther-ді кез келген уақытта жылдам ашу үшін бекітілген күйде қалдырыңыз</translation>
<translation id="335855266303176628">Хабарларда, құжаттарда және басқа қолданбаларда сілтемелерді басып, Browther браузерін кез келген уақытта пайдаланыңыз.</translation>
<translation id="709455597778444012">Тапсырмалар реттегіші – Browther</translation>
<translation id="7147140345767587643">Browther болжамымен анықталған қызығушылықтарыңыз</translation>
<translation id="7337408274890534789">Браузерден шолуды жылдам бастау: Windows жұмысын бастағанда, Browther іске қосылады.</translation>
<translation id="7274695763216404502">Бекітілді! "Сурет іздеу" функциясын құралдар тақтасынан қайтадан пайдаланыңыз.</translation>
<translation id="7288567540154601580">Қойындылар мен кеңейтімдер</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{Browther мұны өшіруге кеңес береді.}other{Browther бұларды өшіруге кеңес береді.}}</translation>
<translation id="1527644038571473502">Жүйе дыбысын бөлісу үшін жүйе параметрлерін ашып, Browther үшін "Тек жүйе дыбысын жазу" опциясына рұқсат беріңіз. Содан кейін Browther-ді қайта іске қосуыңыз қажет.</translation>
<translation id="1427913074981060872">Жарнама өлшеу функциясы сіз кіретін сайттарға өз жарнамаларының өнімділігін өлшеуге көмектесетін ақпаратты Browther браузерінен сұратуға мүмкіндік береді. Сайттар бір-біріне барынша аз ақпарат жіберетіндіктен, сайтаралық бақылау шектеледі.</translation>
<translation id="1657652725060525338">Browther браузерін жаңарту</translation>
<translation id="884846289464870238">Реттеулер файлы бұзылған немесе жарамсыз.

Browther параметрлеріңізді қалпына келтіре алмайды.</translation>
<translation id="7339898014177206373">Жаңа терезе</translation>
<translation id="633044855886370183">Мұнда веб-беттер, бетбелгілер және басқа Browther материалдары тұрады.</translation>
<translation id="1185960088713242527">Құпия фразасы бар адам ғана шифрланған деректеріңізді оқи алады. Құпия фраза Browther компаниясына жіберілмейді немесе ол құпия фразаңызды сақтамайды. Құпия фразаны ұмытып қалсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK"/>аккаунттағы Browther деректерін жою<ph name="END_LINK"/> қажет.</translation>
<translation id="7125151836477182110">Жүйе әкімшісі Browther браузерін <ph name="TARGET_URL_HOSTNAME"/> бетіне кіргенде <ph name="ALTERNATIVE_BROWSER_NAME"/> браузері ашылатын етіп конфигурациялады.</translation>
<translation id="7352651011704765696">Бірнәрсе дұрыс емес</translation>
<translation id="6638123710106659002">Browther-нің жаңа нұсқаларын алып тұру үшін macOS 13 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде macOS 12 нұсқасы орнатылған.</translation>
<translation id="7286289384512061761">Жақында кірмедіңіз. Browther <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> рұқсаттарын өшірді.</translation>
<translation id="113593073175678746">Бұл кеңейтімге енді қолдау көрсетілмейді. Browther оны өшіруге кеңес береді.</translation>
<translation id="137615076640044304">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Browther қойындыларды қалпына келтіреді. Мұны өшіру үшін келесі бөлімге өтіңіз:</translation>
<translation id="5967238175620483220">Құпия сөздерді Browther-ге экспорттау</translation>
<translation id="4935019315986703336"><ph name="PAGE_TITLE"/> - Browther Origin әзірлеуші нұсқасы</translation>
<translation id="7450541714075000668">Мәтін көшірмесі жасалды</translation>
<translation id="7766009218653304791">Browther браузеріне бұл сайтта камераны пайдалану үшін рұқсат керек</translation>
<translation id="5844418066487488520">Микрофонды пайдалану үшін <ph name="BEGIN_LINK"/>жүйе параметрлерінде<ph name="END_LINK"/> Browther-ге рұқсат беріңіз.</translation>
<translation id="8065480549334161841">Browther-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 7 нұсқасы орнатылған.</translation>
<translation id="6299293759264950896">Browther қайта іске қосылсын ба?</translation>
<translation id="180908550381040105">Ашылып тұрғанмен бірдей Browther нұсқасын орнату мүмкін емес. Browther қолданбасын жауып, әрекетті қайталаңыз.</translation>
<translation id="7625576878150380853">Browther аккаунтына кірген болсаңыз, Browther аккаунтында құпия сөздер мен т.б. деректі сақтауға және пайдалануға болады. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">Сайттар ойдағыдай жұмыс істеуі керек. Browther-де аккаунтқа кірген болсаңыз, барлық Browther терезесін жапқан кезде, Browther аккаунтын қоспағанда, сайттардың көпшілігінен шығарыласыз.</translation>
<translation id="7099370564362681943">{0,plural, =1{Browther браузері 1 минуттан кейін қайта іске қосылады}other{Browther браузері # минуттан кейін қайта іске қосылады}}</translation>
<translation id="3602613943932672197">Деректеріңізді қорғау үшін Browther-ге сіз соңғы уақытта кірмеген сайттардың рұқсаттарын өшіруге рұқсат беріңіз.</translation>
<translation id="8759568213742229377">Браузерді жылдам пайдалану үшін Browther-ді автоматты түрде іске қосады.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> орнату құралы</translation>
<translation id="8991800242749014880">Browther камераңыз бен микрофоныңызды пайдалануда.</translation>
<translation id="2692328388439821508">Browther жақсара түсті</translation>
<translation id="4318444066563223295">Енді Browther-дегі функциялар көбейді.</translation>
<translation id="7649070708921625228">Анықтама</translation>
<translation id="5591287320769313116">Browther сіздің орныңызға браузерді шола алады</translation>
<translation id="7658239707568436148">Бас тарту</translation>
<translation id="6325482130534634729">Browther әдепкі браузеріңіз емес</translation>
<translation id="8185915921134219287">Browther браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіріңіз</translation>
<translation id="5120421624925726813">Browther жаңарту</translation>
<translation id="7716950018788545737">Тапсырмалар аяқталды.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> браузеріне арналған жүйені трассалау қызметтерін ұсынады. Қызмет өшірілсе, браузер жасаған өнімділік трассалары контекст ауыстыру және дайын ағын оқиғалары сияқты жалпы жүйелік оқиғаларды қамтымайды.</translation>
<translation id="6542096191573265107">Шолу деректері бұл құрылғыдан жойылады. Деректерді кейінірек алу үшін Browther жүйесіне <ph name="USER_EMAIL"/> болып кіріңіз.</translation>
<translation id="7747138024166251722">Орнату құралы уақытша каталогті жасай алмады. Дисктегі бос орынды және бағдарламалық жасақтама рұқсатын тексеріңіз.</translation>
<translation id="351575328720488268">Browther-ді әдепкі күйге қайтару</translation>
<translation id="1054170408395182418">Browther-ді әдепкі браузер етіп орнатып, тапсырмалар жолағына бекітіңіз</translation>
<translation id="4569594230301902490">Browther жылдамдығын арттырыңыз</translation>
<translation id="8041924294044943913"><ph name="PAGE_TITLE"/> - Browther Origin Canary</translation>
<translation id="7893465573639396635">Интернет трафигіңізді пайдалана алатын адамдар қандай сайттарға кіретініңізді көрмейтіндей етіңіз. Browther браузері DNS жүйесіндегі сайттың IP мекенжайын іздеу үшін қауіпсіз байланысты пайдаланады.</translation>
<translation id="7810005234485217901">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады.</translation>
<translation id="2462631024103158515">Осы құрылғыда бұл аккаунтқа Browther профилі тіркеліп қойған.</translation>
<translation id="7845233973568007926">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME"/> пайдаланбас бұрын компьютерді өшіріп қосуыңыз керек.</translation>
<translation id="311190437086049332">Browther-ге жаңа көрініс беру үшін оны бейімдеңіз.</translation>
<translation id="6728847658878265103">Browther браузерінің ең соңғы нұсқасы орнатылмады, сондықтан жаңа мүмкіндіктер мен қауіпсіздікке қатысты түзетілген функцияларды пайдалана алмайсыз.</translation>
<translation id="7872446069773932638">Жүктеп алынып жатыр… <ph name="SECONDS"/> секунд қалды.</translation>
<translation id="5374532739787768601">Құпия фразаны ұмытып қалған болсаңыз немесе осы параметрді өзгерту керек болса, <ph name="BEGIN_LINK"/>аккаунтыңыздағы Browther деректерін жойыңыз<ph name="END_LINK"/>.</translation>
<translation id="7877212753140190672">Осы сурет жайында сұрау</translation>
<translation id="9172499982238113829">Browther-ді әдепкі браузер етіп орнату</translation>
<translation id="3313826726620159669">Мүмкін болса, Browther қауіпті байланыстарды HTTPS кеңейтіміне автоматты түрде жаңартады.</translation>
<translation id="3317928686912559532">Browther жүйесіне <ph name="USER_EMAIL_ADDRESS"/> ретінде кірдіңіз. Қайта кіру үшін бірдей аккаунтты пайдаланыңыз.</translation>
<translation id="6007009085341946457">Бұл – Browther браузерінің қайта орнатылған нұсқасы және әдепкі браузер бола алмайды.</translation>
<translation id="8004582292198964060">Браузер</translation>
<translation id="8010081455002666927">Автоанықтау</translation>
<translation id="174885789898161653">Browther браузерінің кіру рұқсаты болса, веб-сайттар сізден кіру рұқсатын сұрайды.</translation>
<translation id="3001754454174546602">Browther-ді кез келген уақытта жылдам ашу үшін тапсырмалар жолағына бекітіңіз</translation>
<translation id="80471789339884597">Орнатқаныңыз үшін рақмет. <ph name="BUNDLE_NAME"/> пайдаланбас бұрын барлық браузерді жауып, қайта ашуыңыз керек.</translation>
<translation id="8054112667659782652">"Сурет іздеу" жылдам пәрменін үнемі көрсету</translation>
<translation id="6993312779622863465">Browther-нің қолданбаларда фондық режимде жұмыс істеу мүмкіндігін өшіру</translation>
<translation id="80790299200510644">Сурет іздеу</translation>
<translation id="8086881907087796310">Орнатылмады, себебі компьютер минималды жабдық талаптарына жауап бермейді.</translation>
<translation id="3217614128548917842"><ph name="PAGE_TITLE"/> – Browther Origin for Testing</translation>
<translation id="543407324609820492">Browther бұл сайт үшін локацияны пайдалануға рұқсат сұрайды.</translation>
<translation id="1767887552863788514">Келесі жолы Browther-ді <ph name="DEVICE_TYPE"/> құрылғысынан ашқан кезде, баға бақылау хабарландыруларын қосу туралы нұсқауды көресіз.</translation>
<translation id="8118331347066725040">Lens-бен іздеуге қатысты пікіріңізді жазыңыз.</translation>
<translation id="5334309298019785904">ChromeOS деректеріңізді синхрондай алмады, себебі синхрондау функциясы доменіңіз үшін қолжетімді емес.</translation>
<translation id="813913629614996137">Дайындауда…</translation>
<translation id="4879101934056397619">Browther Қосымша қызмет көрсету шарттары</translation>
<translation id="4505690237431768764">Бұл файл қауіпті болғандықтан, Browther оны бөгеді.</translation>
<translation id="8177472873527554730">Беттен ештеңе табылмады.</translation>
<translation id="4720341280133158605">Browther деректерін <ph name="USER_EMAIL"/> аккаунтында қолдану және сақтау үшін құпия фразаны енгізіңіз.</translation>
<translation id="8221491193165283816">Әдетте хабарландыруларға тыйым саласыз. Осы сайттың сізге хабарландыру жіберуіне рұқсат ету үшін осы жерді басыңыз.</translation>
<translation id="1083711467946065278">Камераны пайдалану үшін <ph name="BEGIN_LINK"/>жүйе параметрлерінде<ph name="END_LINK"/> Browther-ге рұқсат беріңіз.</translation>
<translation id="6569785137733211804">Browther бұл кеңейтімнің қайдан келгенін анықтай алмайды. Ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Browther-нан жойыңыз.</translation>
<translation id="1122818205373648656">Егер суреттің пайдалы сипаттамасы болмаса, Browther оны өзі ұсынып көреді. Сипаттамалар жасау үшін суреттер Browther-ға жіберіледі. Бұл функцияны кез келген уақытта параметрлерден өшіріп қоюға болады.</translation>
<translation id="6877990294324319801">Browther-ге жаңа профильмен кіру қажет пе?</translation>
<translation id="6478811748813986578"><ph name="BEGIN_LINK"/>Browther сізге<ph name="END_LINK"/> қауіпті сайттар мен жүктеп алу әрекеттері туралы ескертеді</translation>
<translation id="1685486387921540822">Жақында кірмедіңіз. Browther <ph name="PERMISSION"/> рұқсатын өшірді.</translation>
<translation id="8921153410460268589">Browther iOS қолданбасында камера көмегімен нәрселерді сатып алуға, аударуға және анықтауға болады.</translation>
<translation id="8313851650939857356">Іске қосу қатесі: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">Ұйымыңыз Browther-ді <ph name="TIMEOUT_DURATION"/> бойы пайдаланбаған кезде жабады.</translation>
<translation id="8321888067342493336">Сурет түрінде сақтау</translation>
<translation id="143016831128278157">Browther браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіру үшін аккаунтыңызға кіріңіз</translation>
<translation id="4784945022248750283"><ph name="USER_EMAIL_ADDRESS"/> бұрын Browther браузерін пайдаланған</translation>
<translation id="1288164710697017468">Browther деректерін Browther аккаунтында (<ph name="ACCOUNT_EMAIL"/>) әрі қарай пайдалану үшін Browther-ді жаңартыңыз.</translation>
<translation id="8648401677359150296">Browther-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8 нұсқасы орнатылған.</translation>
<translation id="8362914115861174987">Аударма тілі:</translation>
<translation id="8367705492654390392">Кез келген нәрсе сұраңыз</translation>
<translation id="5769022907892823357">Құпия сөздер мен басқа ақпаратты барлық құрылғыдан алу үшін Browther аккаунтына кіріңіз. Аккаунтқа кіргеннен кейін, бұл құпия сөз Browther аккаунтыңызға сақталады.</translation>
<translation id="4782442810031768771">Содан кейін Browther-ді өшіріп қосуыңыз қажет.</translation>
<translation id="8265348385714408341">Browther оны өшіруге кеңес береді. <ph name="BEGIN_LINK"/>Қолдау көрсетілетін кеңейтімдер туралы толық ақпарат алыңыз.<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">Бұл кеңейтімді әзірлеушісі жариялаудан бас тартқан, сондықтан ол қауіпті болуы мүмкін. Сіз кірген сайттардағы деректеріңізді, оның ішінде жеке ақпаратыңызды бұдан былай көрмеуі және өзгерте алмауы үшін, оны Browther-нан жойыңыз.</translation>
<translation id="1613655732912855341">Browther браузері деректерді Browther аккаунтыңызға сақтау және барлық құрылғыңызда пайдалануға рұқсат беру үшін жеке басыңызды растауы қажет. Қазір шықсаңыз, бұл деректер жойылады.</translation>
<translation id="9103715009358215214">{0,plural, =1{Browther браузерін бір күннің ішінде қайта іске қосыңыз}other{Browther браузерін # күннің ішінде қайта іске қосыңыз}}</translation>
<translation id="8438543370129609977">Сурет іздеу функциясын пайдалансаңыз, бет атауы, URL мекенжайы және контенті, соның ішінде PDF файлдары серверге жіберіледі. <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">Browther-де сурет іздеу функциясымен іздеу туралы толық ақпарат</translation>
<translation id="1401757916223057494">Орнатқыш мұрағаты бүлінген немесе жарамсыз. Browther қайтадан жүктеңіз.</translation>
<translation id="5029760494698649486">Browther браузері Windows 10 жүйесін не одан кейінгі нұсқасын қажет етеді.</translation>
<translation id="7906734902028783072">Міндетті емес: диагностика және пайдалану туралы деректі Browther-ға автоматты түрде жіберу арқылы ChromeOS функциялары мен жұмыс өнімділігін жақсартуға көмектесіңіз.</translation>
<translation id="6791756730901393492">Browther аккаунтында Browther деректерін пайдалану және сақтау үшін жеке басыңызды растаңыз.</translation>
<translation id="4879869745782826167">Browther-ге кіру нұсқауларын көрсетеді</translation>
<translation id="2967761098021401720">Browther ескірген</translation>
<translation id="7674832651694000881">Browther-ді әдепкі браузер етіп таңдағаныңызға рақмет!</translation>
<translation id="4507581730979762077">Құпия сөздер сақталған кезде, Browther оларды тексере алады.</translation>
<translation id="7205233182271132386">Browther құпия сөздеріңіздің бірін баршаға ашық қолды болған деректерден тапса, ескерту алыңыз.</translation>
<translation id="8555465886620020932">Қызмет қатесі: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">"Сурет іздеу" функциясына оңай кіру үшін оны бекітуге болады. Ол үшін бүйірлік панельдің жоғарғы жағындағы "Бекіту" түймесін басыңыз.</translation>
<translation id="856656450041460113">Тілдер тізімін іздеу</translation>
<translation id="75470458211269379">Browther аккаунтыңызбен кіргенде, Browther сіздің құпия сөздеріңізді тексере алады.</translation>
<translation id="2108930010779660436">Browther-ді бірнеше ұйым басқарады</translation>
<translation id="7209630341463003999">Copyright © <ph name="YEAR"/> Browther Software Inc. Барлық құқықтар қорғалған.</translation>
<translation id="8601359445272098721">Жаңалық! Енді "экранды аудару" түймесін басу арқылы экрандағы мәтін мен суреттерді де аудара аласыз.</translation>
<translation id="782928371899183269">Browther іске қосылуда…</translation>
<translation id="8624541899164515475">Параметрлер, жаңа қойындыда ашылады.</translation>
<translation id="5879341334716115002">Browther for Testing браузерін әдепкі браузер қылу мүмкін емес.</translation>
<translation id="2433912322225810055">Сонымен қатар ол Browther іске қосқаныңызда немесе Omnibox ішінен іздегеніңізде қайсы бет көрсетілетінін бақылайды.</translation>
<translation id="4816541973978692496">Сізге арналған Browther.</translation>
<translation id="8712637175834984815">Түсінікті</translation>
<translation id="9037464035997618895">Browther-ге кіру қажет пе?</translation>
<translation id="7897185368811431919">Барлығын Browther-де сақтаңыз</translation>
<translation id="8747073452963259673">іздеу аймағының төменгі сол жақ бұрышы: сол жақ <ph name="LEFT"/>%, төменгі жақ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">Орнату қатесі: желі әкімшісі орнатуға рұқсат бермейтін топтық саясатты қолданды: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">Browther браузеріне бұл сайтта камераны және микрофонды пайдалану үшін рұқсат керек</translation>
<translation id="8813277370772331957">Кейінірек еске салу</translation>
<translation id="6831999464349484462">Browther-ге кіру қажет пе?</translation>
<translation id="3698151322107951111">Browther-ді әдепкі браузер қылу және тапсырмалар жолағына бекіту</translation>
<translation id="8826492472752484139">"Password Manager" түймесін басыңыз.</translation>
<translation id="6933858244219479645">ChromeOS жүйесі</translation>
<translation id="3986927308621489499">Бұл тіл Browther-де мәзірлерді, параметрлерді, ескертулерді және басқа мәтінді көрсету үшін пайдаланылады.</translation>
<translation id="8862326446509486874">Жүйе деңгейінде орнату үшін тиісті құқықтарыңыз жоқ. Әкімші ретінде орнату құралын қайта іске қосып көріңіз.</translation>
<translation id="5318226144018267261">Browther профилін қосу</translation>
<translation id="1298790608554316415">Егер өзгертсеңіз, Browther браузерінде сақталған құпия сөзді де жаңасына өзгертіңіз.</translation>
<translation id="960933321883777733">Ұйымыңыз Browther-ге кіруді талап етеді</translation>
<translation id="948979409756947611">Browther құпия сөздерді көрсетуге әрекет етуде. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="1418854271943945136">Browther енді әдепкі браузеріңіз емес. Оны әдепкі браузер ретінде орнату қажет пе?</translation>
<translation id="7228667329366610727">Browther браузерін жаңарту мүмкін емес</translation>
<translation id="4817697255467736794">Browther Enterprise логотипі</translation>
<translation id="3507731466523097529">Профиліңізді ашу кезінде бірдеңе дұрыс болмағандықтан, Browther-ді іске қосу мүмкін емес. Browther-ді қайта іске қосып көріңіз.</translation>
<translation id="3234473600657230663">Browther профильдерін басқару</translation>
<translation id="8953887022581653484">Browther бұл мұрағаттау файлын жүктеп алуға тыйым салды, себебі онда зиянды бағдарламаны жасыруы мүмкін басқа файлдар бар</translation>
<translation id="532304972436358335">Басқа Browther қызметтеріне кірген кезде, Browther-ге де кіресіз</translation>
<translation id="3425998261052065067">Browther автоматты түрде жабылған</translation>
<translation id="4377377022617011492">Browther ескірген</translation>
<translation id="3247296757162889864">{0,plural, =1{Browther браузері бір сағаттан кейін қайта іске қосылады}other{Browther браузері # сағаттан кейін қайта іске қосылады}}</translation>
<translation id="9106236359747881194">Іздеу үшін мәтін таңдаңыз.</translation>
<translation id="5115014198092384730">Browther-нің жаңа нұсқаларын алып тұру үшін Windows 10 не одан кейінгі операциялық жүйе керек болады. Бұл компьютерде Windows 8.1 нұсқасы орнатылған.</translation>
<translation id="7129101984664345614">Сілтемені жаңа Browther қойындысында ашу</translation>
<translation id="911206726377975832">Сонымен қатар шолу деректеріңізді жоясыз ба?</translation>
<translation id="9134482777260927479">Үй тапсырмасын орындауға көмектесу</translation>
<translation id="9148058034647219655">Шығу</translation>
<translation id="1734388504720121468">Тоқтаған жерден жалғастырыңыз: өшіріп қосқан сайын, Browther қойындыларды қалпына келтіре алады. Мұны қосу үшін келесі бөлімге өтіңіз:</translation>
<translation id="8633974232736772207">Жүйе әкімшісі Browther браузерін <ph name="TARGET_URL_HOSTNAME"/> сілтемесіне қосымша браузер арқылы кіре алатындай етіп конфигурациялады.</translation>
<translation id="1122669402846843682">Browther кеңесі: Lens арқылы іздеңіз</translation>
<translation id="595330134356385835">&amp;Browther-ді жаңарту үшін қайта іске қосу</translation>
<translation id="2556178781950124146">Browther Origin (mDNS-In)</translation>
<translation id="6491100124044190139">Browther аккаунтына кіріп, көп функцияны қолданыңыз</translation>
<translation id="1665840797775025867">Browther браузерін өз талғамыңызға сай реттеңіз</translation>
<translation id="4407047432656809023">Browther дұрыс жұмыс істемеуі мүмкін, себебі оған Windows XP не Windows Vista жүйелерінде қолдау көрсетілмейді</translation>
<translation id="945522503751344254">Пікір жіберу</translation>
<translation id="7620348044248809366">Browther-ді кім пайдаланып жатыр?</translation>
<translation id="7299962884342109067">Browther браузерінің ең күшті қорғанысын қолданыңыз</translation>
<translation id="983803489796659991">Орнатылмады, себебі жаңарту серверінде қолданбаға арналған хештеу деректері жоқ.</translation>
<translation id="8775461190334353148">Browther-ді аккаунтсыз қолдану</translation>
<translation id="7146761239544860058">Browther Software Inc</translation>
<translation id="989970834842471429">"Сурет іздеу" функциясымен іздеу керек кез келген мәтінді не суретті таңдаңыз.</translation>
<translation id="6616551030373607751">Локацияны пайдалану үшін <ph name="BEGIN_LINK"/>жүйе параметрлерінде<ph name="END_LINK"/> Browther-ге рұқсат беріңіз.</translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">Орнату анықталмаған қате себебінен сәтсіз аяқталды. Browther браузерін қайта жүктеңіз.</translation>
<translation id="9074842261125908635">Белгісіз көздерден алынған кеңейтімдер, қолданбалар және тақырыптар құрылғыңызға зиян келтіруі мүмкін. Browther оларды тек <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> орнатуды ұсынады.</translation>
<translation id="3593119910409528681">Бұл кеңейтім Web Store саясатын бұзады және қауіпті болуы мүмкін. Оны Browther браузерінен алып тастап, сіз кірген сайттардағы деректер мен жеке ақпаратыңызды көре алмайтындай өзгертіңіз.</translation>
<translation id="5245976396374147971">Ескерту: Browther кеңейтімдердің қарап шығу тарихыңызды жазуға жол бермейді. Жеке режимде бұл кеңейтімді өшіру үшін осы опцияны таңдамаңыз.</translation>
<translation id="3629539416935660172">Browther браузерінің қауіпсіздігін арттыру үшін біз <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> тізіміне кірмейтін және сіздің біліміңізсіз қосылған кейбір кеңейтімдерді өшірдік.</translation>
<translation id="157534302749986451">Browther браузерінің қауіпсіздігін арттыру үшін біз <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> тізіміне кірмейтін және сіздің біліміңізсіз қосылған келесі кеңейтімді өшірдік.</translation>
