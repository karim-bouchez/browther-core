<translation id="7977787072794666032">‏ممکن ہے کہ Browther ٹھیک طریقے سے کام نہ کرے کیونکہ یہ اب Windows XP یا Windows Vista پر تعاون یافتہ نہیں ہے</translation>
<translation id="945522503751344254">تاثرات بھیجیں</translation>
<translation id="4484434718272972655">‏Browther کون استعمال کر رہا ہے؟</translation>
<translation id="7173394303099002355">‏Browther کی مضبوط ترین سیکیورٹی حاصل کریں</translation>
<translation id="983803489796659991">انسٹالیشن ناکام ہو گئی کیونکہ اپ ڈیٹ سرور کے پاس ایپلیکیشن کے لیے کوئی ہیش ڈیٹا نہیں ہے۔</translation>
<translation id="8435446479956716379">‏اکاؤنٹ کے بغیر Browther استعمال کریں</translation>
<translation id="8992261409816268381">‏Browther مصنّفین</translation>
<translation id="989970834842471429">تصاویر کا استعمال کر کے تلاش کے ساتھ تلاش کرنے کیلئے کوئی بھی ٹیکسٹ یا تصویر منتخب کریں</translation>
<translation id="3146636448190445245">‏اپنے مقام کا استعمال کرنے کے لیے، <ph name="BEGIN_LINK"/>سسٹم کی ترتیبات<ph name="END_LINK"/> میں Browther کو رسائی فراہم کریں</translation>
<translation id="137466361146087520">‏Google Chrome بی ٹا</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="6283840329609797763">‏غیر متعین خرابی کی وجہ سے انسٹالیشن ناکام ہوگیا۔ براہ کرم Browther دوبارہ ڈاؤن لوڈ کریں۔</translation>
</translationbundle>