<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="1026101648481255140">Nastavi instalaciju</translation>
<translation id="7099479769133613710">Ponovo pokreni da bi se &amp;Chrome OS ažurirao</translation>
<translation id="7264054672589027446">Browther preporučuje da pregledate ovaj dodatak</translation>
<translation id="7848219163187166649">Kada sajt zatraži da privatno predučitava linkove na stranici, Browther koristi Browther servere. Na taj način se vaš identitet krije od predučitanog sajta, ali Browther saznaje koji sajtovi su unapred učitani.</translation>
<translation id="1065672644894730302">Podešavanja ne mogu da se pročitaju.

Neke funkcije su možda nedostupne i promene podešavanja neće biti sačuvane.</translation>
<translation id="8837164267124113709">Roditelj je isključio Dozvole za sajtove, aplikacije i dodatke za Browther</translation>
<translation id="881513728707488138">Browther želi da izveze lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="112640046208448578">Identifikujte stvari ili mesta i kopirajte ili prevodite tekst. Kada koristite pretragu slika, snimak ekrana stranice se šalje na server. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther je podrazumevani pregledač</translation>
<translation id="6580138787163923852">Da biste proverili da li su lozinke bezbedne od upada u podatke i drugih bezbednosnih problema, <ph name="BEGIN_LINK"/>prijavite se u Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Kliknite na Browther meni</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> je dodao dodatak koji može da promeni način na koji Browther funkcioniše.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Instalacija nije uspela jer vaša verzija Windows-a nije podržana.</translation>
<translation id="8291401179516272335">O Browther-u</translation>
<translation id="1203500561924088507">Hvala vam na instalaciji. Potrebno je da restartujete pregledač pre nego što počnete da koristite <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Kada otvorite pretragu slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski se šalju na server. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Dok ste prijavljeni, možete da koristite lozinke i drugo sa Browther naloga u Browther-u. Da biste to promenili, idite na Nalog u Browther-u.</translation>
<translation id="9034321258761608912">Dok je ova kartica bila neaktivna, memorija je oslobođena da bi Browther bio brz. Možete da odaberete da uvek izuzmete ovaj sajt iz neaktivnosti.</translation>
<translation id="249571811018731941">Browther je blokirao ovo preuzimanje jer je ovaj fajl opasan</translation>
<translation id="8850227089720975601">Kada se prijavljujete u Browther usluge kao što su Gmail ili YouTube pomoću naloga <ph name="USER_EMAIL"/>, možete automatski da se prijavite u Browther pomoću istog naloga</translation>
<translation id="1290883685122687410">Greška pri podešavanju: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Podesite nov Browther profil</translation>
<translation id="4437862975743821367">Browther zahteva pristup Bluetooth-u da bi istraživao 
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Otkriveni jezik</translation>
<translation id="1206925267243987362">Koristite preporučena podešavanja pregledača Browther</translation>
<translation id="8270483548049772782">Izbriši i podatke iz Browther-a (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Zakačeno je. Možete ponovo da pristupite pretrazi slika pomoću novog dugmeta na traci s alatkama</translation>
<translation id="1356661055722410047">Novo. Možete da prevodite i tekst i slike na ekranu</translation>
<translation id="1383876407941801731">Pretraži</translation>
<translation id="1592588950737518481">&amp;Upravljajte Browther profilima</translation>
<translation id="1404026649028693342">Uvek prikazuj AI režim</translation>
<translation id="141901961143729572">Delite razmišljanja</translation>
<translation id="1743952081001089298">Da biste delili prozor, dozvolite snimanje ekrana za Browther u podešavanjima sistema.</translation>
<translation id="8627385813382688019">Potražite pomoć za verziju Browther for Testing</translation>
<translation id="1497802159252041924">Greška pri instalaciji: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Ova stranica je zaštićena</translation>
<translation id="7252430412915798987">Delite Browther karticu</translation>
<translation id="6388429281015199562">Prijavi me u Browther</translation>
<translation id="1547469039832541117">Završava istaknuti zadatak.</translation>
<translation id="1801944307203212016">Browther traži dozvolu da pristupi kameri da bi napravio 3D mapu okruženja</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Ovaj dodatak više nije podržan. Browther preporučuje da ga uklonite.}one{Ovi dodaci više nisu podržani. Browther preporučuje da ih uklonite.}few{Ovi dodaci više nisu podržani. Browther preporučuje da ih uklonite.}other{Ovi dodaci više nisu podržani. Browther preporučuje da ih uklonite.}}</translation>
<translation id="4667068923142532753">Zakači Browther</translation>
<translation id="3006560544901646947">Browther alatke za bezbednost</translation>
<translation id="686052171138185761">Browther želi da izbriše podatke Menadžera lozinki. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="8713026329083542796">Pregledajte ključne kontrole privatnosti i bezbednosti u Browther-u</translation>
<translation id="1640672724030957280">Preuzimanje...</translation>
<translation id="1680687534629375545">Postavite pitanje pretrazi slika o ovoj stranici</translation>
<translation id="1709772298389099340">Pruža pune privilegije za <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Da bi poboljšao ove funkcije, Browther Browther-u šalje vaše interakcije sa njima. Osobe koje pregledaju mogu da čitaju, obrađuju i komentarišu ove podatke.</translation>
<translation id="1722488837206509557">To će vam omogućiti da birate sa dostupnih uređaja i da prikazujete sadržaj na njima.</translation>
<translation id="6820510278633522408">Browther će uskoro izbrisati podatke pregledanja</translation>
<translation id="7775028004939172516">Browther će probati da nadogradi navigacije na HTTPS</translation>
<translation id="6963959729951758069">Browther podaci su obrisani</translation>
<translation id="4085139922884095932">Browther će se restartovati za <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Kada HTTPS nije dostupan, Browther će koristiti nebezbednu vezu bez upozorenja</translation>
<translation id="3975328336074677101">Neka Browther radi u pozadini</translation>
<translation id="2497443204974841650">Ponovo instaliraj Browther</translation>
<translation id="1724309687045787742">Browther pokušava da <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Sledeći put kada otvorite Browther na uređaju <ph name="DEVICE_TYPE"/>, videćete upit da koristite Browther menadžer lozinki.</translation>
<translation id="1838374766361614909">Obrišite pretragu</translation>
<translation id="2337233040802538155">Da biste izbrisali podatke pregledanja samo sa ovog uređaja, ali ne i sa Browther naloga, <ph name="BEGIN_LINK"/>odjavite se iz Browther-a<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Preuzmite Browther na telefon da biste u pokretu otvarali ili pravili nove grupe kartica.</translation>
<translation id="2063443520349987970">Možete da upravljate Browther nalozima na koje ste prijavljeni. Browther nalozi se koriste za Browther pregledač, Play prodavnicu, Gmail i drugo. Ako želite da dodate nalog za nekog drugog, npr. člana porodice, umesto toga dodajte novu osobu na svoj uređaj <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Saznajte više<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Pretražuj pomoću pretrage slika</translation>
<translation id="1880677175115548835">Izaberite tekst</translation>
<translation id="3183933389992069620">Prijavljujete se pomoću naloga kojim se upravlja i dajete njegovom administratoru kontrolu nad Browther profilom. Browther podaci, kao što su aplikacije, obeleživači, istorija, lozinke i druga podešavanja, biće trajno povezani sa nalogom <ph name="USER_NAME"/>. Moći ćete da izbrišete te podatke preko Kontrolne table Browther naloga, ali nećete moći da ih povežete sa nekim drugim nalogom. Možete opcionalno da napravite novi profil da bi postojeći Browther podaci ostali odvojeni. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther štedi bateriju tako što ograničava aktivnosti u pozadini i vizuelne efekte, kao što je glatko skrolovanje i brzine kadrova videa. <ph name="BEGIN_LINK"/>Saznajte više o Uštedi energije<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Postavite pitanje o ovoj stranici</translation>
<translation id="9128006428501241840">Usluga ažuriranja Browther-a</translation>
<translation id="6302815314157879372">Kada to uključite, možete da se prijavljujete na Browther sajtove, kao što je Gmail, ali se ne prijavljujete u Browther</translation>
<translation id="1063611196035804685">Browther ne reaguje. Želite li da ga odmah ponovo pokrenete?</translation>
<translation id="2873360330889594383">Vaša organizacija, <ph name="MANAGER"/>, zahteva da se prijavite u Browther</translation>
<translation id="4035053306113201399">Treba da restartujete Chrome OS da biste primenili ažuriranje.</translation>
<translation id="2861285003831382718">Browther je blokirao ovo preuzimanje jer se ovaj tip fajl ne preuzima često i može da bude opasan</translation>
<translation id="1953553007165777902">Preuzima se... Još <ph name="MINUTE"/> min</translation>
<translation id="2080160985220483492">Napomena za Browther: Sačuvajte lozinke</translation>
<translation id="8037497710694492565">Browther ne može da odredi ni da podesi podrazumevani pregledač</translation>
<translation id="7395009124247513849">Saznajte zašto Browther blokira neke fajlove, otvara se na novoj kartici</translation>
<translation id="762710512520170632">Ažurira Browther softver. Ako je ova usluga onemogućena ili zaustavljena, Browther softver neće biti ažuriran, što znači da neće biti moguće otkloniti bezbednosne propuste koji mogu da nastanu i da funkcije možda neće raditi. Ova usluga se deinstalira kada je ne koristi nijedan Browther softver.</translation>
<translation id="5793588180426267429">Ovim ćete izbrisati 1 stavku sa ovog uređaja. Da biste kasnije vratili podatke, prijavite se u Browther kao <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalacija nije uspela. Probajte ponovo.</translation>
<translation id="6351516710581760512">Da biste proverili da li su ostale lozinke bezbedne od upada u podatke i drugih bezbednosnih problema, <ph name="BEGIN_LINK"/>prijavite se u Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Podešavanja.</translation>
<translation id="8194525816714210105">Odaberite da li ćete uvrstiti istoriju Browther-a radi personalizovanijih doživljaja u Browther uslugama</translation>
<translation id="5909559127548969159">Kliknite na dugme Prilagodi Browther na stranici nove kartice da biste Browther-u dali nov izgled</translation>
<translation id="2066690553719545730">Uvek prikazuj AI režim</translation>
<translation id="3283892260110318935">Browther je blokirao ovo preuzimanje jer je ovaj fajl obmanjujući i može da izvrši neočekivane promene na uređaj</translation>
<translation id="6160571936643742128">Sledeći put kada otvorite Browther iOS, videćete upit da isprobate <ph name="FEATURE_NAME"/>.</translation>
<translation id="8380517409933452343">Lozinke i drugi Browther podaci koje ste sačuvali na Browther nalogu biće uklonjeni sa ovog uređaja. Da biste ih ponovo koristili u Browther-u, ponovo se prijavite.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Organizacija automatski briše podatke pregledanja kada se Browther ne koristi 1 minut. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Organizacija automatski briše podatke pregledanja kada se Browther ne koristi # minut. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Organizacija automatski briše podatke pregledanja kada se Browther ne koristi # minuta. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Organizacija automatski briše podatke pregledanja kada se Browther ne koristi # minuta. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2126108037660393668">Verifikacija preuzetog fajla nije uspela.</translation>
<translation id="2135919691573380097">Prijavite ovaj sajt</translation>
<translation id="2137162749895930932">Zatvorite ekran za prevođenje</translation>
<translation id="4283559398694996391">Browther je blokirao ovo preuzimanje jer ovaj sajt ne koristi bezbednu vezu, pa je fajl možda neovlašćeno menjan</translation>
<translation id="2170098639895543546">Izaberite bilo šta na stranici</translation>
<translation id="2495182092286337191">Prilagodite Browther</translation>
<translation id="2174917724755363426">Instalacija nije dovršena. Želite stvarno da je otkažete?</translation>
<translation id="4877141231724140862">Browther – prijavljivanje na mrežu – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Greška sa proverom ažuriranja: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Ukloni nalog iz Browther-a</translation>
<translation id="1084363153644366288">Budite bezbedniji u pokretu uz poboljšano bezbedno pregledanje u Browther-u za iOS</translation>
<translation id="7949164640723239455">Opasan sajt. Browther je uklonio obaveštenja.</translation>
<translation id="2236949375853147973">Moje aktivnosti</translation>
<translation id="4536403809133456417">Da bi vam adrese i drugi sadržaj bili dostupni na svim uređajima, prijavite se u Browther. Ova adresa će biti sačuvana na Browther nalogu kada se prijavite.</translation>
<translation id="5627930103267312171">Ako delite računar, prijatelji i porodica mogu zasebno da pregledaju i da podese Browther baš onako kako žele.</translation>
<translation id="2283803047247799269">Pretraži ovu karticu pomoću pretrage slika</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther preporučuje da pauzirate karticu koja usporava pregledač}one{Browther preporučuje da pauzirate kartice koje usporavaju pregledač}few{Browther preporučuje da pauzirate kartice koje usporavaju pregledač}other{Browther preporučuje da pauzirate kartice koje usporavaju pregledač}}</translation>
<translation id="2307973900865360088">Zadrži na traci</translation>
<translation id="5161617112768367959">Proverava URL-ove sa listom nebezbednih sajtova koji se čuvaju u Browther-u. Ako neki sajt pokuša da ukrade vašu lozinku ili probate da preuzmete štetnu datoteku, Browther može da pošalje URL-ove, uključujući delove sadržaja stranice, u Bezbedno pregledanje.</translation>
<translation id="4123094831918713833">Ovom radnjom:
          <ph name="LINE_BREAKS"/>
           • resetujete neka Browther podešavanja i Browther prečice
           <ph name="LINE_BREAK"/>
           • onemogućavate dodatke
           <ph name="LINE_BREAK"/>
           • brišete kolačiće i druge privremene podatke o sajtovima
            <ph name="LINE_BREAKS"/>
           Ovo se neće odraziti na obeleživače, istoriju i sačuvane lozinke.</translation>
<translation id="5456070119344236353">Da biste poslali broj sa ovog uređaja na Android telefon, prijavite se u Browther na oba uređaja.</translation>
<translation id="2356070529366658676">Pitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="6468415397021485143">Dodatak <ph name="EXTENSION_NAME"/> želi da se prijavite u Browther</translation>
<translation id="2558600429878197587">Onemogući Browther koji radi u pozadini za aplikacije</translation>
<translation id="5295781918312989856">Da biste koristili ovaj dodatak kao <ph name="USER_EMAIL_ADDRESS"/>, prijavite se u Browther.</translation>
<translation id="8418845734693287262">Chrome OS ne može da sinhronizuje podatke zato što su podaci za prijavljivanje na nalog zastareli.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{Jedan ili više dodataka za Browther su pristupali 1 HID uređaju}=1{Jedan ili više dodataka za Browther pristupaju 1 HID uređaju}one{Jedan ili više dodataka za Browther pristupaju # HID uređaju}few{Jedan ili više dodataka za Browther pristupaju HID uređajima (#)}other{Jedan ili više dodataka za Browther pristupaju HID uređajima (#)}}</translation>
<translation id="434258293817844111">Browther-u su potrebne dozvole za kameru i mikrofon za ovaj sajt</translation>
<translation id="2403703063067034158">Greška pri pokretanju: Trenutno je pokrenuta druga instanca podešavanja. Probajte ponovo kasnije.</translation>
<translation id="5458993228789433099">Otvarajte linkove u Browther-u iz bilo koje aplikacije i omogućite pristup pregledaču na traci zadataka</translation>
<translation id="1677640217693742525">Pomoću <ph name="BEGIN_LINK"/>Browther alatki<ph name="END_LINK"/> možete bezbedno da pregledate i zadržite kontrolu</translation>
<translation id="2451727308784734061">Koristite prečicu da biste brzo pristupali Menadžeru lozinki. Prečicu možete da premestite na početni ekran računara ili u pokretač aplikacija.</translation>
<translation id="2280315911954332435">Browther će se uskoro zatvoriti</translation>
<translation id="6410820860979094113">U Browther-u</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je restartovanje: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Izaberite tekst pomoću pretrage slika</translation>
<translation id="7892218991241200190">Browther pokušava da zameni postojeće lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="8976443723926188033">Browther traži pristup memorijskom prostoru da bi preuzimao datoteke</translation>
<translation id="4131374838781785973">Browther Origin pomagač</translation>
<translation id="2575822587468774919">Izaberite bilo šta za pretragu pomoću pretrage slika</translation>
<translation id="8705561858232289221">Da bi vam lozinke i drugi sadržaj bili dostupni na svim uređajima, prijavite se u Browther</translation>
<translation id="437162022240011372">Nastavi sa korišćenjem Browther-a</translation>
<translation id="259935314519650377">Keširanje preuzetog instalacionog programa nije uspelo. Greška: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="2907676829052962091">Organizacija može da vidi podatke pregledanja, poput obeleživača, istorije i lozinki, i da upravlja njima. Ne može da vidi podatke pregledanja na drugim Browther profilima</translation>
<translation id="1289116577679005654">Potvrdite identitet da biste koristili i sačuvali Browther podatke na nalogu, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7192278346779151664">Tokom instalacije je došlo do greške u operativnom sistemu. Preuzmite Browther ponovo.</translation>
<translation id="7724398260867885339">Ako delite uređaj, prijatelji i porodica mogu zasebno da pregledaju i da podese Browther baš onako kako žele</translation>
<translation id="1679595317134614424">Kartica Browther</translation>
<translation id="7189168846924379421">Browther će šifrovati podatke radi dodatne sigurnosti.</translation>
<translation id="4052643592793184278">Da biste uklonili Browther nalog iz Browther-a, odjavite se</translation>
<translation id="7694616023994438906">Da bi vam lozinke, obeleživači i drugi sadržaj bili dostupni na svim uređajima, prijavite se u Browther</translation>
<translation id="2738871930057338499">Povezivanje sa internetom nije uspelo. Zabranjen je pristup (HTTP 403). Proverite konfiguraciju proksija.</translation>
<translation id="2753623023919742414">Kliknite da biste pretražili</translation>
<translation id="9078193405195503710">Podesite Browther kao podrazumevani PDF pregledač</translation>
<translation id="2456995288904753506">Browther može automatski da popunjava teška polja koja standardno automatsko popunjavanje možda neće popuniti</translation>
<translation id="3271730304285122987">Ovaj dodatak sadrži malver i nije bezbedan. Uklonite ga iz Browther-a da više ne bi mogao da vidi i menja podatke na sajtovima koje posećujete, uključujući lične podatke.</translation>
<translation id="2799223571221894425">Ponovo pokreni</translation>
<translation id="1427337251963884503">Vaš Browther</translation>
<translation id="2816462166102338036">Pretražite ovaj video pomoću pretrage slika</translation>
<translation id="2841525013647267359">Prevedite sa jezika</translation>
<translation id="2846251086934905009">Greška pri instalaciji: Program za instalaciju nije završio instalaciju. Instalacija je otkazana.</translation>
<translation id="928966105228355994">Ukloni iz Browther-a...</translation>
<translation id="587805782197019018">Štiti vas u Browther-u i može da se koristi za poboljšanje bezbednosti u drugim Browther aplikacijama kada ste prijavljeni.</translation>
<translation id="2885378588091291677">Menadžer zadataka</translation>
<translation id="3055995278166070443">O &amp;Browther-u</translation>
<translation id="2915996080311180594">Restartuj kasnije</translation>
<translation id="2928420929544864228">Instalacija je dovršena.</translation>
<translation id="70453521937551896">Podaci se šifruju pomoću pristupne fraze. Unesite je da biste koristili i sačuvali Browther podatke na Browther nalogu.</translation>
<translation id="2945997411976714835">Greška pri instalaciji: Proces instalacije nije uspeo.</translation>
<translation id="3188308520233701133">Brže se prijavljujte na sajtove pomoću sačuvanih lozinki za Browther na iOS-u</translation>
<translation id="8145318807880784886">Dodajte nov Browther profil da biste razdvojili obeleživače, lozinke i podešavanja.</translation>
<translation id="4330268530227888227">Organizacija upravlja Browther-om</translation>
<translation id="6488090896442998436">Browther je ažuriran</translation>
<translation id="300557164611864786">Ako neki sajt pokuša da ukrade vašu lozinku ili probate da preuzmete štetni fajl, Browther može da pošalje URL-ove, uključujući delove sadržaja stranice, u Bezbedno pregledanje</translation>
<translation id="2447145782593796785">Ako želiš veću bezbednost onlajn uz izbore roditelja, prijavi se u Browther</translation>
<translation id="3003694935412297923">Svi zadaci</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther mora da verifikuje da ste to vi da bi neki podaci mogli da se sačuvaju na Browther nalogu i koriste na svim uređajima. Ako se odjavite odmah, ovi podaci (1 stavka) će se izbrisati.}one{Browther mora da verifikuje da ste to vi da bi neki podaci mogli da se sačuvaju na Browther nalogu i koriste na svim uređajima. Ako se odjavite odmah, ovi podaci ({count} stavka) će se izbrisati.}few{Browther mora da verifikuje da ste to vi da bi neki podaci mogli da se sačuvaju na Browther nalogu i koriste na svim uređajima. Ako se odjavite odmah, ovi podaci ({count} stavke) će se izbrisati.}other{Browther mora da verifikuje da ste to vi da bi neki podaci mogli da se sačuvaju na Browther nalogu i koriste na svim uređajima. Ako se odjavite odmah, ovi podaci ({count} stavki) će se izbrisati.}}</translation>
<translation id="5522228731050510047">Otvorite <ph name="URL"/> na novoj kartici u Browther-u.</translation>
<translation id="6358780591055960280">Browther ne može da vam proverava lozinke. Probajte ponovo kasnije.</translation>
<translation id="1386422761453740126">Dodavanje u Browther...</translation>
<translation id="3038232873781883849">Čeka se instaliranje...</translation>
<translation id="3045032126857188731">Jezik prevoda: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Zatvorite dijalog povratnih informacija</translation>
<translation id="369127628511662602">Drugi Browther profili</translation>
<translation id="2370255879896574713">Pomozite nam da poboljšamo Browther tako što ćete Browther-u slati izveštaje o otkazivanju i <ph name="UMA_LINK"/></translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{Jedan ili više dodataka za Browther su pristupali 1 USB uređaju}=1{Jedan ili više dodataka za Browther pristupaju 1 USB uređaju}one{Jedan ili više dodataka za Browther pristupaju # USB uređaju}few{Jedan ili više dodataka za Browther pristupaju USB uređajima (#)}other{Jedan ili više dodataka za Browther pristupaju USB uređajima (#)}}</translation>
<translation id="2065456480740480340">Istorija Browther-a</translation>
<translation id="5011660649081947055">Program za instalaciju nije uspeo da dekomprimuje arhivu. Preuzmite Browther ponovo.</translation>
<translation id="310459126943037700">Završavanje zadataka nije uspelo.</translation>
<translation id="3104828284009500087">Pretražite bilo šta na stranici</translation>
<translation id="4917564010081457061">Sinhronizujte lozinke, obeleživače i istoriju na svim uređajima. Ažurirajte podrazumevani pregledač na Browther da biste lako pristupali funkcijama koje znate i volite.</translation>
<translation id="1041472930719344928">Browther koristi mikrofon.</translation>
<translation id="3130333203120345554">Nova pretraga</translation>
<translation id="3137969841538672700">Prevucite da biste pretražili</translation>
<translation id="5312717254055363883">Ova kartica koristi dodatne resurse. Da biste poboljšali performanse, dozvolite Browther-u da ih učini neaktivnim.</translation>
<translation id="373523409348786203">Da biste delili ekran, dozvolite snimanje ekrana za Browther u podešavanjima sistema</translation>
<translation id="802113445299754598">Ponovo pokreni Browther</translation>
<translation id="3161522574479303604">Svi jezici</translation>
<translation id="4522189060330781648">Drugi program na računaru je dodao temu koja može da promeni način na koji Browther funkcioniše.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">Prilagodite novi Browther profil</translation>
<translation id="5150830326120505481">Da biste uklonili Browther nalog iz Browther-a, odjavite se iz Browther-a na stranici Podešavanja</translation>
<translation id="7113660200899017820">Browther može kasnije da vas pita da li želite da koristite sačuvane informacije za automatsko popunjavanje obrazaca</translation>
<translation id="4475011322243623412">Browther ne može da čita podatke iz direktorijuma sa podacima niti da ih upisuje u njega:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Restartuj odmah</translation>
<translation id="3536063527222598206">Nedostaju šifre za Browther API. Neke funkcije Browther-a će biti onemogućene.</translation>
<translation id="1011450868746766298">Nastavi sa pokretanjem aplikacija u pozadini kada se Browther zatvori</translation>
<translation id="179611081153855734">Browther će vas upozoriti pre učitavanja bilo kog sajta pomoću nebezbedne veze</translation>
<translation id="8965591964936552871">Bićete odjavljeni sa većine sajtova kada zatvorite sve Browther prozore, osim sa Browther naloga ako ste prijavljeni u Browther. Da biste dozvolili sajtovima da vas pamte, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Podrazumevani pretraživač je promenjen izvan Browther-a. Browther ga je resetovao radi vaše zaštite.</translation>
<translation id="1170501833661894915">Prijavite se u Browther da bi vam lozinke, obeleživači i drugi podaci bili dostupni na svim uređajima</translation>
<translation id="3352986031709923790">gornji desni ugao oblasti pretrage: udesno <ph name="RIGHT"/>%, nagore <ph name="TOP"/>%</translation>
<translation id="120745000989996104">Browther podaci na nalogu</translation>
<translation id="3369405342922656244">Pretražite ovu stranicu pomoću pretrage slika</translation>
<translation id="7173761126541905083">Koristite lozinke uz Browther na telefonu</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="5266583242423616945">Želite da pređete na postojeći Browther profil?</translation>
<translation id="3412460710772753638">U Menadžeru lozinki na ovom uređaju</translation>
<translation id="4282363917570905631">Produžite poboljšano bezbedno pregledanje uz Browther na telefonu</translation>
<translation id="986094398735583155">Prilagođavamo Browther…</translation>
<translation id="3266047225484320321">Browther će vas obavestiti kada se prijavite pomoću ugrožene lozinke</translation>
<translation id="3508047337876211050">Ovim ćete izbrisati <ph name="ITEMS_COUNT"/> stavke(i) sa ovog uređaja. Da biste kasnije vratili podatke, prijavite se u Browther kao <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">Pomoću prečice <ph name="SHORTCUT"/> možete da prelazite sa jednog Browther profila na drugi</translation>
<translation id="7225005776233199285">Zatvorite sve Browther prozore i pokušajte ponovo.</translation>
<translation id="5465054931427475969">Da biste delili prozor, dozvolite snimanje ekrana za Browther u podešavanjima sistema</translation>
<translation id="6905469223518185641">Korisnik <ph name="EXISTING_USER"/> je već prijavljen.  Da bi vam pregledanje bilo razdvojeno, prijavite se u Browther preko svog profila kao <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">Da biste delili ekran, dozvolite snimanje ekrana za Browther u podešavanjima sistema.</translation>
<translation id="3597003331831379823">Pokretanje podešavanja sa punim privilegijama nije uspelo. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Prijavite se u Browther</translation>
<translation id="2492221622209669678">Podaci pregledanja ove osobe će biti izbrisani sa ovog uređaja. Da biste vratili podatke, prijavite se u Browther kao <ph name="USER_EMAIL"/>.</translation>
<translation id="6793778233257855801">Da biste poslali broj sa <ph name="ORIGIN"/> na Android telefon, prijavite se u Browther na oba uređaja.</translation>
<translation id="3667616615096815454">Instaliranje nije uspelo, aplikacije je nepoznata serveru.</translation>
<translation id="5585500151754164442">Koristite <ph name="BEGIN_LINK"/>sopstvenu pristupnu frazu<ph name="END_LINK"/> da biste šifrovali sve Browther podatke na Browther nalogu. Načini plaćanja i adrese iz Google Pay-a se neće šifrovati. Istorija pregledanja iz Browther-a se neće sinhronizovati.</translation>
<translation id="404323216042159951">Browther ne može da vam proverava lozinke. Proverite internet vezu.</translation>
<translation id="5004936474632127765">Otvori link u novoj Browther &amp;kartici</translation>
<translation id="6236643159256182256">Povežite Browther i druge Browther usluge radi personalizacije i drugih svrha</translation>
<translation id="3729187154190517324">Produbite pretragu dodavanjem više kartica, fajlova i alatki pomoću dugmeta Dodaj karticu i drugo.</translation>
<translation id="1400697664933775238">Upravljaj Browther profilima</translation>
<translation id="2461315395128103158">Saznajte zašto Browther blokira neka preuzimanja</translation>
<translation id="8058420662026104226">Browther će vas obavestiti ako treba da pregledate nešto</translation>
<translation id="3177448557921912221">Browther profili vam pomažu da razdvojite različite delove života. Dodajte nov profil.</translation>
<translation id="1541177876035612043">Browther predučitava stranice koje ćete verovatno posetiti, kako bi se brže učitavale kada ih posetite</translation>
<translation id="3810973564298564668">Upravljaj</translation>
<translation id="1117103475254549453">Da biste koristili sačuvane lozinke, pratite QR kôd, preuzmite Browther za iOS i prijavite se na Browther nalog</translation>
<translation id="8880695882192156860">Napomena za Browther: Poboljšano bezbedno pregledanje</translation>
<translation id="3846683726093018685">**Rezimirajte:** U jednoj rečenici sa manje od 30 reči opišite primarni predmet i svrhu sadržaja na snimku ekrana.

          **Predložite pitanja:** Generišite listu sa 3 do 5 pitanja koja podstiču na razmišljanje i koja korisnik može da postavi da bi bolje razumeo snimak ekrana. Ova pitanja treba da obuhvataju bar jedno koje se konkretno odnosi na vizuelni objekat, njegov dizajn ili položaj.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> – Browther Origin</translation>
<translation id="3885770153807205175">Birač jezika</translation>
<translation id="4861846616763552424">Prilagodite i kontrolišite Browther. Treba da obratite pažnju na nešto – kliknite za više detalja.</translation>
<translation id="6126366281251241386">Kliknite na ime da biste otvorili Browther i počnite da pregledate.</translation>
<translation id="3892148308691398805">Kopiraj tekst</translation>
<translation id="3760801273210219822">Korisnik <ph name="EXISTING_USER"/> je već prijavljen na ovaj Browther profil. Da bi vam pregledanje bilo razdvojeno, Browther može da napravi zaseban profil za vas.</translation>
<translation id="3821553157234855663">P&amp;rilagodite Browther</translation>
<translation id="3941890832296813527">Greška pri instalaciji: Naziv fajla programa za instalaciju je nevažeći ili nije podržan.</translation>
<translation id="6482299900191767005">Browther pokušava da kopira lozinke. Unesite lozinku za Windows da biste to omogućili.</translation>
<translation id="5853011008278898603">Lozinke, načini plaćanja i adrese koje ste sačuvali na Browther nalogu biće uklonjeni sa ovog uređaja. Da biste ih ponovo koristili u Browther-u, ponovo se prijavite.</translation>
<translation id="395904275706073188">Zaštićene stranice ne mogu da se čitaju. Probajte sa drugom stranicom.</translation>
<translation id="1832973663231751701">Saznajte kako vas Browther štiti</translation>
<translation id="4531502594774670767">Kada unosite tekst u traku za adresu ili u okvir za pretragu, Browther šalje ono što unosite u alatke za pretragu, veštačku inteligenciju i agenta organizacije da biste dobijali predloge.</translation>
<translation id="300013383485253006">O verziji Browther for Testing</translation>
<translation id="1152920704813762236">O Chrome OS-u</translation>
<translation id="8126752030994997015">Kada odete na sajt, Browther šalje maskirani deo URL-a <ph name="BEGIN_LINK"/>Browther bezbednom pregledanju<ph name="END_LINK"/> preko servera za privatnost koji krije IP adresu. Ako sajt radi nešto sumnjivo, šalju se i kompletni URL-ovi i delovi sadržaja stranice.</translation>
<translation id="3703994572283698466">Chrome OS je omogućen zahvaljujući dodatnom <ph name="BEGIN_LINK_CROS_OSS"/>softveru sa otvorenim kodom<ph name="END_LINK_CROS_OSS"/>, kao što je <ph name="BEGIN_LINK_LINUX_OSS"/>Linux okruženje za programiranje<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Prevedi ekran</translation>
<translation id="4023601594785368013">Izvorni jezik: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Otvarajte linkove u Browther-u iz bilo koje aplikacije. Radi lakšeg pristupa zakačite ga na traku zadataka.</translation>
<translation id="3437506136408403836">Pomozite da poboljšamo Browther tako što ćete poslati izveštaj o <ph name="BEGIN_LINK"/>aktuelnim podešavanjima<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Važna bezbednosna poboljšanja i nove funkcije su dostupni u najnovijoj verziji.</translation>
<translation id="4055805654398742145">Menadžer lozinki</translation>
<translation id="2164947358785939495">Drugi program na računaru je dodao dodatak koji može da promeni način na koji Browther funkcioniše.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Organizacija automatski zatvara Browther kada se ne koristi 1 minut. Podaci pregledanja se brišu. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja.}one{Organizacija automatski zatvara Browther kada se ne koristi # minut. Podaci pregledanja se brišu. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja.}few{Organizacija automatski zatvara Browther kada se ne koristi # minuta. Podaci pregledanja se brišu. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja.}other{Organizacija automatski zatvara Browther kada se ne koristi # minuta. Podaci pregledanja se brišu. To može da obuhvata istoriju, automatsko popunjavanje i preuzimanja.}}</translation>
<translation id="1535413545339990419">Idite na stranicu O Browther-u</translation>
<translation id="692283249649018289">Prilagodite Browther da biste prešli na nov izgled pregledača</translation>
<translation id="6375229634133804834">P&amp;rilagodite Browther</translation>
<translation id="4148957013307229264">Instaliranje...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> – prijavljivanje na mrežu – Browther</translation>
<translation id="2911246138082876798">Otkrijte odlične aplikacije, igre, dodatke i teme za Browther.</translation>
<translation id="2528977475313334293">Da bi vam ovaj dodatak i drugi sadržaj bili dostupni na svim računarima, prijavite se u Browther</translation>
<translation id="8244267655940711467">Ako želiš veću bezbednost onlajn uz izbore roditelja, pređi na svoj Browther profil na kom si već prijavljen/a kao <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Otkazuje se...</translation>
<translation id="4224210481850767180">Instalacija je otkazana.</translation>
<translation id="8219359042845534271">Želite li da povežete Browther podatke sa ovim nalogom?</translation>
<translation id="5520777668172961882">Upozorava vas na opasne sajtove, čak i na one za koje Browther ranije nije znao, analizirajući više podataka sa sajtova nego standardna zaštita. Možete da odaberete da preskočite upozorenja Browther-a.</translation>
<translation id="2014920019837536689">Odjavi me iz Browther-a</translation>
<translation id="4341512411059715879">Pronađite pomoć za Browther</translation>
<translation id="4281844954008187215">Uslovi korišćenja usluge</translation>
<translation id="322492684764924424">Instalacija nije uspela zbog neodređene greške. Ako je Browther trenutno otvoren, zatvorite ga i pokušajte ponovo.</translation>
<translation id="3813060261346666066">Izvezite lozinke iz Browther-a</translation>
<translation id="4304713468139749426">Menadžer lozinki</translation>
<translation id="4334241893986177674">Pretražite ovaj snimak ekrana</translation>
<translation id="4334294535648607276">Preuzimanje je dovršeno.</translation>
<translation id="2177954934431828302">Pokreni Browther kada se Windows pokrene</translation>
<translation id="2472318668926455009">Podesite Browther kao podrazumevani pregledač da biste lako pristupali funkcijama koje znate, volite i kojima verujete. Browther će biti zakačen na traku zadataka radi brzog pristupa.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> zahteva da pročitate i prihvatite sledeće Uslove korišćenja usluge pre korišćenja ovog uređaja. Ovi uslovi ne proširuju, menjaju niti ograničavaju Uslove za Chrome OS.</translation>
<translation id="2897580280700805340">Želite li ipak da zatvorite Browther?</translation>
<translation id="4413205837991854510">Uvek prikazuj prečicu za pretragu slika</translation>
<translation id="2454897022983434851">Neka Browther radi u pozadini</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Browther preporučuje da ga uklonite. <ph name="BEGIN_LINK"/>Saznajte više o podržanim dodacima<ph name="END_LINK"/>}one{Browther preporučuje da ih uklonite. <ph name="BEGIN_LINK"/>Saznajte više o podržanim dodacima<ph name="END_LINK"/>}few{Browther preporučuje da ih uklonite. <ph name="BEGIN_LINK"/>Saznajte više o podržanim dodacima<ph name="END_LINK"/>}other{Browther preporučuje da ih uklonite. <ph name="BEGIN_LINK"/>Saznajte više o podržanim dodacima<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Prilagodite i kontrolišite Browther</translation>
<translation id="4427306783828095590">Poboljšana zaštita nudi više mogućnosti za blokiranje „pecanja“ i malvera</translation>
<translation id="4434353761996769206">Greška programa za instalaciju: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> upravlja Browther-om</translation>
<translation id="4007482010626246887">Dodaj Browther profil</translation>
<translation id="6888322430074420631">O verziji Browther for Testing</translation>
<translation id="8912436499620582668">Da biste koristili i čuvali Browther podatke na Browther nalogu, unesite pristupnu frazu</translation>
<translation id="4493028449971051158">Greška pri pokretanju: pokrenite program za instalaciju kao administrator.</translation>
<translation id="4501471624619070934">Instalacija nije uspela jer je pristup u ovoj zemlji ograničen.</translation>
<translation id="8976207309012239417">Ovaj dodatak nije objavio prakse privatnosti, na primer, kako prikuplja i koristi podatke. Browther preporučuje da ga uklonite.</translation>
<translation id="8888202093812883067">Dobro došli u Browther Origin; otvoren je novi prozor pregledača</translation>
<translation id="6391148383688605718">Browther-u treba dozvola za mapiranje okruženja i praćenje ruku</translation>
<translation id="7756445485815468244">Već ste prijavljeni kao <ph name="USER_EMAIL_ADDRESS"/> na drugom Browther profilu</translation>
<translation id="137435413163730206">Browther predučitava stranice, što ubrzava pregledanje i pretraživanje. <ph name="BEGIN_LINK"/>Saznajte više o predučitavanju stranica<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Prijavite sajt za koji mislite da je štetan da biste poboljšali onlajn bezbednost za svakoga.</translation>
<translation id="3266647901351304597">Browther je blokirao ovo preuzimanje jer ste isključili Bezbedno pregledanje, pa fajl ne može da se verifikuje</translation>
<translation id="6980208900390333646">Isprobajte Browther objektiv uz Browther na telefonu</translation>
<translation id="4594305310729380060">U Menadžer lozinki na ovom uređaju</translation>
<translation id="5282047884678321451">Browther Origin aplikacije</translation>
<translation id="4598116752460667024">Potražite bilo koji proces sa liste.</translation>
<translation id="4970880042055371251">Verzija Chrome OS-a</translation>
<translation id="4482468019601425607">Ažuriranje je skoro gotovo! Ponovo pokrenite Browther da biste dovršili ažuriranje.</translation>
<translation id="5517890123509214766">Ubrzava sajtove uz Browther mehanizam V8, ali čini Browther malo manje otpornim na napade</translation>
<translation id="7690070364551268156">Ako delite i Browther izveštaje o korišćenju, ti izveštaji obuhvataju URL-ove koje posećujete</translation>
<translation id="5020487088453637212">Izgleda da se profil koristi u nekom drugom Browther procesu (<ph name="PROCESS_ID"/>) na nekom drugom računaru (<ph name="HOST_NAME"/>). Browther je zaključao profil da ne bi bio oštećen. Ako ste sigurni da nijedan drugi proces ne koristi ovaj profil, možete da otključate profil i ponovo pokrenete Browther.</translation>
