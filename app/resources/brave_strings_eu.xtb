<translation id="6388429281015199562">Hasi saioa Browther-en</translation>
<translation id="1547469039832541117">Nabarmendutako zeregina amaitzen du.</translation>
<translation id="1801944307203212016">Browther-ek kamera erabiltzeko baimena behar du, ingurunearen hiru dimentsioko mapa bat sortzeko</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Luzapena ez da onartzen jada. Kentzea gomendatzen dizu Browther-ek.}other{Luzapen hauek ez dira onartzen jada. Kentzea gomendatzen dizu Browther-ek.}}</translation>
<translation id="4667068923142532753">Ainguratu Browther</translation>
<translation id="3006560544901646947">Browther-en segurtasun-tresnak</translation>
<translation id="686052171138185761">Browther-ek Pasahitz-kudeatzailea zerbitzuan dauzkazun datuak ezabatu behar ditu. Horretarako baimena emateko, idatzi Windows-eko pasahitza.</translation>
<translation id="8713026329083542796">Berrikusi pribatutasuna eta segurtasuna kontrolatzeko aukera garrantzitsuenak Browther-en</translation>
<translation id="1640672724030957280">Deskargatzen…</translation>
<translation id="1680687534629375545">Egin orri honi buruzko galdera bat irudi-bilaketari</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> arakatzailerako gehiegizko baimenak ematen ditu.</translation>
<translation id="4243382967656566037">Eginbide hauek hobetzen laguntzeko, Browther-ek haiekin dituzun interakzioak bidaltzen dizkio Browther-ri. Baliteke informazio hori gizakia den berrikusle batek irakurtzea, prozesatzea eta hari buruzko oharpenak egitea.</translation>
<translation id="1722488837206509557">Erabilgarri dauden gailuen artean hautatu ahal izango duzu, eta haietan edukia bistaratu.</translation>
<translation id="6820510278633522408">Browther-ek arakatze-datuak ezabatuko ditu laster</translation>
<translation id="7775028004939172516">Browther nabigazioetan HTTPS protokoloa ezartzen saiatuko da</translation>
<translation id="6963959729951758069">Garbitu dira Browther datuak</translation>
<translation id="4085139922884095932"><ph name="REMAINING_TIME"/> barru berrabiaraziko da Browther</translation>
<translation id="2586248102295515296">HTTPS erabilgarri ez dagoenean, Browther-ek konexio ez-seguru bat erabiliko du abisatu gabe</translation>
<translation id="3975328336074677101">Onartu Browther atzeko planoan abiaraztea</translation>
<translation id="2497443204974841650">Instalatu berriro Browther</translation>
<translation id="1724309687045787742">Browther-ek <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783"><ph name="DEVICE_TYPE"/> gailuan Browther irekitzen duzun hurrengo aldian, Browther-ren Pasahitz-kudeatzailea erabiltzeko eskatuko zaizu.</translation>
<translation id="1838374766361614909">Garbitu bilaketa</translation>
<translation id="2337233040802538155">Zure arakatze-datuak gailu honetatik soilik ezabatzeko, baina haiek Browther-ko kontuan mantentzeko, <ph name="BEGIN_LINK"/>amaitu saioa Browther-en<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Deskargatu Browther telefonoan, fitxa taldeak edonoiz eta edonon ireki edo sortu ahal izateko.</translation>
<translation id="2063443520349987970">Saioa hasita daukaten Browther-ko kontuak kudea ditzakezu. Browther-ko kontuak Browther arakatzaile, Google Play Store, Gmail eta abarrerako erabiltzen dira. Kontu bat beste norbaitentzat gehitu nahi baduzu (adibidez, familiako kide batentzat), gehitu beste pertsona bat <ph name="DEVICE_TYPE"/> gailuan. <ph name="LINK_BEGIN"/>Lortu informazio gehiago<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Bilatu irudi-bilaketaren bidez</translation>
<translation id="1880677175115548835">Hautatu testua</translation>
<translation id="3183933389992069620">Kontu kudeatu batekin hasten ari zara saioa eta kontuaren administratzaileari zure Browther profila kontrolatzeko ahalmena ematera zoaz. Browther aplikazioan dituzun datuak, esaterako, aplikazioak, laster-markak, historia, pasahitzak eta beste ezarpen batzuk betiko lotuko zaizkio <ph name="USER_NAME"/> erabiltzaileari. Browther-ko kontuetako Panelaren bidez ezabatu ahalko dituzu datu horiek, baina ezingo dituzu beste kontu batekin lotu. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther-ek bateria aurrezten du atzeko planoko jarduerak eta ikusizko efektuak mugatuta (esaterako, gora eta behera modu leunean egiteko aukera eta bideoen irudi-abiadurak). <ph name="BEGIN_LINK"/>Lortu energia-aurreztaileari buruzko informazio gehiago<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Egin orri honi buruzko galdera bat</translation>
<translation id="9128006428501241840">Browther eguneratzeko zerbitzua</translation>
<translation id="6302815314157879372">Aukera hau desaktibatzen baduzu, Browther-ren webguneetan saioa hasi ahalko duzu (adibidez, Gmail-en) Browther-en saioa hasi beharrik gabe</translation>
<translation id="1063611196035804685">Browther-ek ez du eranzuten. Berrabiarazi nahi duzu?</translation>
<translation id="2873360330889594383">Browther-en saioa hasteko eskatzen dizu zure erakundeak (<ph name="MANAGER"/>)</translation>
<translation id="4035053306113201399">Eguneratzea aplikatzeko, berrabiarazi egin behar da Chrome OS.</translation>
<translation id="2861285003831382718">Browther-ek deskarga hau blokeatu du, fitxategi mota normalean deskargatzen ez delako eta agian arriskutsua delako</translation>
<translation id="1953553007165777902">Deskargatzen… <ph name="MINUTE"/> minutu geratzen dira.</translation>
<translation id="2080160985220483492">Browther-erako aholkua: gorde pasahitzak</translation>
<translation id="8037497710694492565">Browther-ek ezin du ezarri edo zehaztu arakatzaile lehenetsia</translation>
<translation id="7395009124247513849">Ikusi zergatik blokeatzen dituen Browther-ek fitxategi batzuk, beste fitxa batean irekiko da</translation>
<translation id="762710512520170632">Browther-en softwarea eguneratuta mantentzen du. Zerbitzu hau desgaitzen edo gelditzen bada, Browther-en softwarea ez da eguneratuta mantenduko; beraz, agertzen diren segurtasun-ahultasunak ezin izango dira konpondu eta eginbideek agian ez dute funtzionatuko. Zerbitzu hau erabiltzen duen Browther-en softwarerik ez badago, automatikoki desinstalatuko da.</translation>
<translation id="5793588180426267429">Gailuko elementu bat ezabatuko da. Geroago datuak eskuratu nahi izanez gero, hasi saioa Browther-en <ph name="USER_EMAIL"/> gisa.</translation>
<translation id="2018879682492276940">Ezin izan da instalatu. Saiatu berriro.</translation>
<translation id="6351516710581760512">Gainerako pasahitzak datuen isilpekotasunaren urratzeen eta beste segurtasun-arazoen aurka babestuta dauden egiaztatzeko, <ph name="BEGIN_LINK"/>hasi saioa Browther-en<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Ezarpenak.</translation>
<translation id="8194525816714210105">Aukeratu ea Browther-eko historia kontuan hartu nahi duzun ala ez Browther-ren zerbitzuak modu pertsonalizatuago batean erabiltzeko</translation>
<translation id="5909559127548969159">Browther-i itxura berri bat emateko, sakatu fitxa berriaren orriko "Pertsonalizatu Browther" botoia</translation>
<translation id="2066690553719545730">Erakutsi beti AA modua</translation>
<translation id="3283892260110318935">Browther-ek deskarga hau blokeatu du, fitxategia engainagarria delako eta agian espero ez dituzun aldaketak egingo dituelako gailuan</translation>
<translation id="6160571936643742128"><ph name="FEATURE_NAME"/> probatzeko eskatuko zaizu iOS-erako Browther irekitzen duzun hurrengo aldian.</translation>
<translation id="8380517409933452343">Browther-ko kontuan gordetako pasahitzak eta Browther-eko beste datuak gailu honetatik kenduko dira. Browther-en haiek berriro ere erabiltzeko, hasi saioa berriro.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Erakundeak automatikoki ezabatuko ditu arakatze-datuak Browther minutu batez erabiltzen ez bada. Arakatze-datuetan, historia, automatikoki betetako datuak eta deskargak daude. Fitxak irekita mantenduko dira.}other{Erakundeak automatikoki ezabatuko ditu arakatze-datuak Browther # minutuz erabiltzen ez bada. Arakatze-datuetan, historia, automatikoki betetako datuak eta deskargak daude. Fitxak irekita mantenduko dira.}}</translation>
<translation id="2126108037660393668">Deskargatutako fitxategia ezin izan da egiaztatu.</translation>
<translation id="2135919691573380097">Salatu webgunea</translation>
<translation id="2137162749895930932">Itxi itzultzeko pantaila</translation>
<translation id="4283559398694996391">Browther-ek deskarga hau blokeatu du, webgunearen konexioa segurua ez delako eta agian fitxategia manipulatu delako</translation>
<translation id="2170098639895543546">Hautatu orriko edozein gauza</translation>
<translation id="2495182092286337191">Pertsonalizatu Browther</translation>
<translation id="2174917724755363426">Ez da osatu instalazioa. Ziur bertan behera utzi nahi duzula?</translation>
<translation id="4877141231724140862">Browther - Hasi saioa sarean - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Eguneratzearen egiaztapenaren errorea: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Kendu kontua Browther-etik</translation>
<translation id="1084363153644366288">Egon seguruago edonoiz eta edonon iOS-erako Browther-eko arakatze seguru hobetuarekin</translation>
<translation id="7949164640723239455">Webgune arriskutsua. Browther-ek jakinarazpenak erabiltzeko baimena kendu dio.</translation>
<translation id="2236949375853147973">Nire jarduerak</translation>
<translation id="4536403809133456417">Helbideak eta bestelako datuak zure gailu guztietan gordeta edukitzeko, hasi saioa Browther-en. Saioa hasi ondoren, helbide hau zure Browther-ko kontuan gordeko da.</translation>
<translation id="5627930103267312171">Ordenagailua partekatzen baduzu, lagunek eta familiako kideek euren kontuak erabilita ibil daitezke Interneten, nahi duten moduan.</translation>
<translation id="2283803047247799269">Bilatu fitxa honetan irudi-bilaketarekin</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Arakatzailea mantsotzen duen fitxa pausatzea gomendatzen du Browther-ek}other{Arakatzailea mantsotzen duten fitxak pausatzea gomendatzen du Browther-ek}}</translation>
<translation id="2307973900865360088">Mantendu Dock-ean</translation>
<translation id="5161617112768367959">URLak Browther-en gordetako webgune ez-seguruen zerrendan dauden ala ez egiaztatzen du. Webguneren bat pasahitza lapurtzen saiatzen bada, edo fitxategi kaltegarriren bat deskargatzen baduzu, baliteke Browther-ek URLak ere bidaltzea (orriko edukiaren zati batzuk barne) Arakatze segurua eginbideari.</translation>
<translation id="4123094831918713833">Ekintza honen bidez, hauek egingo dira:
          <ph name="LINE_BREAKS"/>
           • Browther-en ezarpen eta lasterbide batzuk berrezarri.
           <ph name="LINE_BREAK"/>
           • Luzapenak desgaitu.
           <ph name="LINE_BREAK"/>
           • Cookieak eta webguneetako bestelako aldi baterako datuak ezabatu.
            <ph name="LINE_BREAKS"/>
           Ekintzak ez die eragingo laster-markei, historiari eta gordetako pasahitzei.</translation>
<translation id="5456070119344236353">Zenbaki bat hemendik Android-eko telefonora bidaltzeko, hasi Browther-eko saioa bi gailuetan.</translation>
<translation id="2356070529366658676">Galdetu</translation>
<translation id="2359808026110333948">Egin aurrera</translation>
<translation id="6468415397021485143">"<ph name="EXTENSION_NAME"/>" luzapenak Browther-en saioa has dezazun behar du</translation>
<translation id="2558600429878197587">Desgaitu Browther atzeko planoan exekutatzea aplikazioetarako</translation>
<translation id="5295781918312989856">Luzapen hau <ph name="USER_EMAIL_ADDRESS"/> gisa erabiltzeko, hasi saioa Browther-en.</translation>
<translation id="8418845734693287262">Chrome OS-k ezin izan ditu sinkronizatu zure datuak, kontuan saioa hasteko xehetasunak zaharkituta daudelako.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{Browther-erako luzapen bat edo gehiago giza interfazeko gailu bat erabiltzen ari ziren}=1{Browther-erako luzapen bat edo gehiago giza interfazeko gailu bat erabiltzen ari dira}other{Browther-erako luzapen bat edo gehiago giza interfazeko # gailu erabiltzen ari dira}}</translation>
<translation id="434258293817844111">Browther-ek kamera eta mikrofonoa erabiltzeko baimenak behar ditu webgune honetan</translation>
<translation id="2403703063067034158">Abiarazte-errorea: konfigurazioaren beste instantzia bat exekutatzen ari da. Saiatu berriro geroago.</translation>
<translation id="5458993228789433099">Ireki edozein aplikaziotako estekak Browther-en eta mantendu arakatzailea eskura zereginen barran</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther-en tresnekin<ph name="END_LINK"/>, segurtasunez araka dezakezu, eta dena kontrolpean eduki</translation>
<translation id="2451727308784734061">Erabili lasterbidea Pasahitz-kudeatzailea zerbitzura azkar joateko. Lasterbidea ordenagailuaren orri nagusira edo aplikazioak exekutatzeko tresnara eraman dezakezu.</translation>
<translation id="2280315911954332435">Browther itxi egingo da laster</translation>
<translation id="6410820860979094113">Browther-en</translation>
<translation id="2485422356828889247">Desinstalatu</translation>
<translation id="2513154137948333830">Berrabiarazi egin behar da: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Hautatu testua irudi-bilaketaren bidez</translation>
<translation id="7892218991241200190">Lehendik dauden pasahitzak ordezten saiatzen ari da Browther. Horretarako baimena emateko, idatzi Windows-eko pasahitza.</translation>
<translation id="8976443723926188033">Browther-ek fitxategiak deskargatzearren memorian sartzeko baimena behar du</translation>
<translation id="1973587471928846950">Browther laguntzailea</translation>
<translation id="2575822587468774919">Hautatu edozer, irudi-bilaketarekin bilatzeko</translation>
<translation id="8705561858232289221">Pasahitzak eta bestelako datuak zure gailu guztietan gordeta edukitzeko, hasi saioa Browther-en</translation>
<translation id="437162022240011372">Jarraitu Browther erabiltzen</translation>
<translation id="259935314519650377">Ezin izan da gorde cachean deskargatutako instalatzailea. Errorea: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistema</translation>
<translation id="2907676829052962091">Erakundeak zure arakatze-datuak ikusi eta kudea ditzake, hala nola laster-markak, historia eta pasahitzak. Ezin ditu ikusi Browther-eko beste profiletako arakatze-datuak.</translation>
<translation id="1289116577679005654">Browther-eko datuak zure kontuan (<ph name="ACCOUNT_EMAIL"/>) erabiltzeko eta gordetzeko, egiaztatu zeu zarela</translation>
<translation id="7192278346779151664">Sistema-eragilean errore bat gertatu da instalatu bitartean. Deskargatu Browther berriro.</translation>
<translation id="7724398260867885339">Gailu bat partekatzen baduzu, lagunak eta familiako kideak beren kontuak erabilita ibil daitezke Interneten, eta Browther nahi duten moduan konfiguratu</translation>
<translation id="1679595317134614424">Browther fitxa</translation>
<translation id="7189168846924379421">Segurtasun gehiago izateko, Browther-ek datuak enkriptatuko ditu.</translation>
<translation id="4052643592793184278">Zure Browther-ko kontua Browther-etik kentzeko, amaitu saioa</translation>
<translation id="7694616023994438906">Pasahitzak, laster-markak eta bestelako datuak zure gailu guztietan gordeta edukitzeko, hasi saioa Browther-en</translation>
<translation id="2738871930057338499">Ezin da konektatu Internetera. HTTP 403 (debekatuta). Egiaztatu proxyaren konfigurazioa.</translation>
<translation id="2753623023919742414">Sakatu bilatzeko</translation>
<translation id="9078193405195503710">Ezarri Browther PDFen ikustaile lehenetsi gisa</translation>
<translation id="2456995288904753506">Betetze automatiko estandarrak agian betetzen ez dituen eremu zailak bete ditzake automatikoki Browther-ek</translation>
<translation id="3271730304285122987">Luzapenak malwarea dauka, eta ez da segurua. Ken ezazu Browther-etik, bisitatzen dituzun webguneetan zure datuak ikusi eta aldatu ezin izan ditzan, informazio pertsonala barne.</translation>
<translation id="2799223571221894425">Abiarazi berriro</translation>
<translation id="1427337251963884503">Zure Browther</translation>
<translation id="2816462166102338036">Egin bilaketak bideo honetan irudi-bilaketarekin</translation>
<translation id="2841525013647267359">Itzuli hizkuntza honetatik</translation>
<translation id="2846251086934905009">Instalazio-errorea: instalatzailea ez da osatu. Instalazioa bertan behera utzi da.</translation>
<translation id="928966105228355994">Kendu Browther-etik…</translation>
<translation id="587805782197019018">Babestuta mantentzen zaitu Browther-en, eta segurtasuna hobetzeko erabil daiteke Browther-ren beste aplikazio batzuetan saioa hasita daukazunean</translation>
<translation id="2885378588091291677">Zereginen kudeatzailea</translation>
<translation id="3055995278166070443">&amp;Browther arakatzaileari buruz</translation>
<translation id="2915996080311180594">Berrabiarazi geroago</translation>
<translation id="2928420929544864228">Instalatu da.</translation>
<translation id="70453521937551896">Datuak pasaesaldiarekin enkriptatuta daude. Browther-eko datuak Browther-ko kontuan gordetzeko eta erabiltzeko, idatz ezazu.</translation>
<translation id="2945997411976714835">Instalazio-errorea: instalatzailearen prozesua ezin izan da hasi.</translation>
<translation id="3188308520233701133">Hasi saioa bizkorrago webguneetan iOS-erako Browther-en gordetako pasahitzak erabilita</translation>
<translation id="8145318807880784886">Gehitu Browther-eko beste profil bat laster-markak, pasahitzak eta ezarpenak bereizita edukitzeko.</translation>
<translation id="4330268530227888227">Zure erakundeak kudeatzen du Browther</translation>
<translation id="6488090896442998436">Eguneratuta dago Browther</translation>
<translation id="300557164611864786">Webguneren bat pasahitza lapurtzen saiatzen bada edo fitxategi kaltegarriren bat deskargatzen baduzu, baliteke Browther-ek URLak ere bidaltzea (orriko edukiaren zati batzuk barne) Arakatze segurua eginbideari.</translation>
<translation id="2447145782593796785">Gurasoen aukerekin sarean seguruago egoteko, hasi saioa Browther-en</translation>
<translation id="3003694935412297923">Zeregin guztiak</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther-ek zeu zarela egiaztatu behar du datu batzuk zure Browther-ko kontuan gorde, eta gailu guztietan erabili ahal izan baino lehen. Orain amaitzen baduzu saioa, datu horiek (elementu bat) ezabatuko dira.}other{Browther-ek zeu zarela egiaztatu behar du datu batzuk zure Browther-ko kontuan gorde, eta gailu guztietan erabili ahal izan baino lehen. Orain amaitzen baduzu saioa, datu horiek ({count} elementu) ezabatuko dira.}}</translation>
<translation id="5522228731050510047">Ireki <ph name="URL"/> Browther-eko fitxa berri batean.</translation>
<translation id="6358780591055960280">Browther-ek ezin ditu egiaztatu pasahitzak. Saiatu geroago.</translation>
<translation id="1386422761453740126">Browther-era gehitzen…</translation>
<translation id="3038232873781883849">Instalatzeko zain…</translation>
<translation id="3045032126857188731">Xede-hizkuntza: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Itxi oharrak bidaltzeko leihoa</translation>
<translation id="369127628511662602">Browther-eko beste profilak</translation>
<translation id="2370255879896574713">Lagundu Browther hobetzen hutsegite-txostenak eta <ph name="UMA_LINK"/> Browther-ra bidalita</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{Browther-erako luzapen bat edo gehiago USB bidezko gailu bat erabiltzen ari ziren}=1{Browther-erako luzapen bat edo gehiago USB bidezko gailu bat erabiltzen ari dira}other{Browther-erako luzapen bat edo gehiago USB bidezko # gailu erabiltzen ari dira}}</translation>
<translation id="2065456480740480340">Browther-eko historia</translation>
<translation id="5011660649081947055">Instalatzaileak ezin izan du artxiboa deskonprimitu. Deskargatu berriro Browther.</translation>
<translation id="310459126943037700">Ezin izan dira amaitu zereginak.</translation>
<translation id="3104828284009500087">Bilatu orriko edozein gauza</translation>
<translation id="4917564010081457061">Mantendu pasahitzak, laster-markak eta historia gailuen artean ezin hobeto sinkronizatuta. Atzitu erraz eginbide ezagun eta gogokoak Browther arakatzaile lehenetsi bihurtuta.</translation>
<translation id="1041472930719344928">Browther zure mikrofonoa erabiltzen ari da.</translation>
<translation id="3130333203120345554">Bilaketa berria</translation>
<translation id="3137969841538672700">Arrastatu bilatzeko</translation>
<translation id="5312717254055363883">Fitxa honek baliabide gehiago erabiltzen ditu. Errendimendua hobetzeko, eman fitxa inaktibo ezartzeko baimena Browther-i.</translation>
<translation id="373523409348786203">Pantaila partekatzeko, eman pantaila grabatzeko baimena Browther-i sistemaren ezarpenetan</translation>
<translation id="802113445299754598">Berrabiarazi Browther</translation>
<translation id="3161522574479303604">Hizkuntza guztiak</translation>
<translation id="4522189060330781648">Ordenagailuko beste programa batek Browther-en funtzionamenduari agian eragingo dion gai bat gehitu du.

<ph name="EXTENSION_NAME"/>.</translation>
<translation id="2604272613984010799">Pertsonalizatu Browther-eko profil berria</translation>
<translation id="5150830326120505481">Zure Browther-ko kontua Browther-etik kentzeko, amaitu Browther-eko saioa Ezarpenak orrian</translation>
<translation id="7113660200899017820">Aurrerago, gordetako informazioa inprimakiak automatikoki betetzeko erabili nahi duzun ala ez galdetu ahal izango dizu Browther-ek</translation>
<translation id="4475011322243623412">Browther-ek ezin du irakurri bere datu-direktorioa eta ezin du idatzi bertan:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Berrabiarazi orain</translation>
<translation id="3536063527222598206">Browther APIko gakoak falta dira. Browther-en funtzionalitate batzuk desgaitu egingo dira.</translation>
<translation id="1011450868746766298">Mantendu atzeko planoko aplikazioak abian Browther ixten denean</translation>
<translation id="179611081153855734">Browther-ek abisatu egingo dizu webgune bat konexio ez-seguru batekin kargatu aurretik</translation>
<translation id="8965591964936552871">Browther-eko leiho guztiak ixtean, webgune gehienetako saioa amaituko da Browther-ko kontuarena izan ezik, baldin eta Browther-en saioa hasita badaukazu. Webguneek gogora zaitzaten, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Bilatzaile lehenetsia Browther-etik kanpo aldatu da. Zu babesteko, Browther-ek berrezarri egin du.</translation>
<translation id="1170501833661894915">Pasahitzak, laster-markak eta abar gailu guztietan eskura izateko, hasi saioa Browther-en</translation>
<translation id="3352986031709923790">bilaketa-eremuaren goiko eskuineko ertza: % <ph name="RIGHT"/> eskuinean, % <ph name="TOP"/> goian</translation>
<translation id="120745000989996104">Kontuan dauden Browther-eko datuak</translation>
<translation id="3369405342922656244">Egin bilaketak orri honetan irudi-bilaketarekin</translation>
<translation id="7173761126541905083">Erabili pasahitzak telefonoan Browther-ekin</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="5266583242423616945">Lehendik dagoen Browther-eko profil batera aldatu nahi duzu?</translation>
<translation id="3412460710772753638">Gailuko Pasahitz-kudeatzailea zerbitzuan</translation>
<translation id="4282363917570905631">Hedatu Arakatze seguru hobetua telefonoan Browther-ekin</translation>
<translation id="986094398735583155">Browther pertsonalizatzen…</translation>
<translation id="3266047225484320321">Arriskuan dagoen pasahitz batekin hasten baduzu saioa, jakinarazi egingo dizu Browther-ek</translation>
<translation id="3508047337876211050">Gailuko <ph name="ITEMS_COUNT"/> elementu ezabatuko dira. Geroago datuak eskuratu nahi izanez gero, hasi saioa Browther-en <ph name="USER_EMAIL"/> gisa.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> da Browther-eko profil batetik bestera aldatzeko lasterbidea</translation>
<translation id="7225005776233199285">Itxi Browther leiho guztiak eta saiatu berriro.</translation>
<translation id="5465054931427475969">Leihoa partekatzeko, eman pantaila grabatzeko baimena Browther-i sistemaren ezarpenetan</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> erabiltzaileak hasita dauka saioa jada.  Arakatze-jarduerak bereizita edukitzeko, hasi saioa Browther-en zeure profilarekin (<ph name="USER_EMAIL_ADDRESS"/>).</translation>
<translation id="8133590217245064579">Pantaila partekatzeko, eman pantaila grabatzeko baimena Browther-i sistemaren ezarpenetan.</translation>
<translation id="3597003331831379823">Ezin izan da exekutatu konfigurazioa gehiegizko baimenekin. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Hasi saioa Browther-en</translation>
<translation id="2492221622209669678">Pertsona honen arakatze-datuak gailutik ezabatuko dira. Datuak berreskuratzeko, hasi saioa Browther-en <ph name="USER_EMAIL"/> gisa.</translation>
<translation id="6793778233257855801">Zenbaki bat <ph name="ORIGIN"/> webgunetik Android-eko telefonora bidaltzeko, hasi Browther-eko saioa bi gailuetan.</translation>
<translation id="3667616615096815454">Ezin da instalatu, zerbitzariak ez duelako ezagutzen aplikazioa.</translation>
<translation id="5585500151754164442">Erabili <ph name="BEGIN_LINK"/>zeure pasaesaldia<ph name="END_LINK"/> Browther-ko kontuko Browther-eko datu guztiak enkriptatzeko. Google Pay-ko ordainketa-metodoak eta helbideak ez dira enkriptatuko. Browther-eko arakatze-historia ez da sinkronizatuko.</translation>
<translation id="404323216042159951">Browther-ek ezin ditu egiaztatu pasahitzak. Egiaztatu Internetera konektatuta zaudela.</translation>
<translation id="5004936474632127765">Ireki esteka Browther-eko beste &amp;fitxa batean</translation>
<translation id="6236643159256182256">Lotu Browther eta Browther-ren beste zerbitzuak pertsonalizaziorako eta bestelako helburu batzuetarako</translation>
<translation id="3729187154190517324">Sakondu bilaketan fitxa, fitxategi eta tresna bat baino gehiago gehituta "Gehitu fitxa bat eta gauza gehiago" botoiaren bidez.</translation>
<translation id="1400697664933775238">Kudeatu Browther-eko profilak</translation>
<translation id="2461315395128103158">Ikusi zergatik blokeatzen dituen Browther-ek deskarga batzuk</translation>
<translation id="8058420662026104226">Browther-ek jakinaraziko dizu ezerk zure berrikuspena behar badu</translation>
<translation id="3177448557921912221">Browther-eko profilekin, bizitzako alderdi desberdinak bereiz ditzakezu. Gehitu beste profil bat.</translation>
<translation id="1541177876035612043">Ziurrenik bisitatuko dituzun orriak aurrez kargatzen ditu Browther-ek, bisitatzen dituzunean bizkorrago karga daitezen</translation>
<translation id="3810973564298564668">Kudeatu</translation>
<translation id="1117103475254549453">Gordetako pasahitzak erabiltzeko, jarraitu QR kodeari, deskargatu iOS-erako Browther eta hasi saioa Browther-ko kontuan</translation>
<translation id="8880695882192156860">Browther-erako aholkua: arakatze seguru hobetua</translation>
<translation id="3846683726093018685">**Laburbildu:** 30 hitz baino gutxiagoko esaldi bakar batean, azaldu pantaila-argazkiko edukiaren gai nagusia eta xedea.

          **Iradoki galderak:** sortu pentsarazten duten 3-5 galdera dituen zerrenda buletdun bat, erabiltzaile batek pantaila-argazkia hobeki ulertzeko galdetuko lituzkeenak. Galdera horietako batek gutxienez objektu bisual bati buruzkoa izan behar du, edo haren diseinuari edo kokapenari buruzkoa.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">Hizkuntza-hautatzailea</translation>
<translation id="4861846616763552424">Pertsonalizatu eta kontrolatu Browther. Zure arreta behar duen zerbait dago. Sakatu informazio gehiago ikusteko.</translation>
<translation id="6126366281251241386">Browther irekitzeko eta arakatzen hasteko, egin klik zure izenean.</translation>
<translation id="3892148308691398805">Kopiatu testua</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> erabiltzaileak Browther-eko profil honetan hasi du saioa dagoeneko. Arakatze-datuak bereizita edukitzeko, Browther-ek profil bat sor dezake zuretzat.</translation>
<translation id="3821553157234855663">Pertsonalizat&amp;u Browther</translation>
<translation id="3941890832296813527">Instalazio-errorea: instalatzailearen fitxategi-izenak ez du balio edo ez da onartzen.</translation>
<translation id="6482299900191767005">Pasahitzak kopiatzen saiatzen ari da Browther. Hori baimentzeko, idatzi Windows-eko pasahitza.</translation>
<translation id="5853011008278898603">Browther-ko kontuan gorde dituzun pasahitzak, ordainketa-metodoak eta helbideak gailutik kenduko dira. Browther-en haiek berriro ere erabiltzeko, hasi saioa berriro.</translation>
<translation id="395904275706073188">Babestutako orriak ezin dira irakurri. Probatu beste orri batekin.</translation>
<translation id="1832973663231751701">Lortu Browther-ek zu babesteko duen moduari buruzko informazio gehiago</translation>
<translation id="4531502594774670767">Helbide-barran edo bilaketa-koadroan zerbait idazten duzunean, Browther-ek erakundearen bilaketa- eta agente-tresnetara, eta AA bidezkoetara bidaltzen du idatzitakoa, iradokizunak lortzeko.</translation>
<translation id="300013383485253006">Browther for Testing-i buruz</translation>
<translation id="1152920704813762236">Chrome OS-ri buruz</translation>
<translation id="8126752030994997015">Webgune bat bisitatzen duzunean, Browther-ek URLaren zati nahasi bat bidaltzen dio <ph name="BEGIN_LINK"/>Browther-ren Arakatze segurua<ph name="END_LINK"/> eginbideari, zure IP helbidea ezkutatzen duen pribatutasun-zerbitzari baten bidez. Webgune batek susmagarria den zerbait egiten badu, URL osoak eta orriaren edukiaren zati batzuk ere bidaltzen dira.</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_CROS_OSS"/>Kode irekiko software<ph name="END_LINK_CROS_OSS"/> gehigarriari esker da posible Chrome OS; adibidez, <ph name="BEGIN_LINK_LINUX_OSS"/>Linux-eko garapen-ingurunea<ph name="END_LINK_LINUX_OSS"/> erabiltzen da.</translation>
<translation id="4022972681110646219">Itzuli pantaila</translation>
<translation id="4023601594785368013">Jatorrizko hizkuntza: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Ireki estekak Browther-en edozein aplikaziotatik. Gainera, errazago atzitzeko, zereginen barran ainguratuko da.</translation>
<translation id="3437506136408403836">Lagundu Browther hobetzen <ph name="BEGIN_LINK"/>oraingo ezarpenen<ph name="END_LINK"/> berri emanda</translation>
<translation id="4050175100176540509">Segurtasun-hobekuntza garrantzitsuak eta eginbide berriak dituzu erabilgarri azken bertsioan.</translation>
<translation id="4055805654398742145">Pasahitz-kudeatzailea</translation>
<translation id="2164947358785939495">Ordenagailuko beste programa batek Browther-en funtzionamenduari agian eragingo dion luzapen bat gehitu du.

<ph name="EXTENSION_NAME"/>.</translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Erakundeak automatikoki itxiko du Browther minutu batez erabiltzen ez bada. Arakatze-datuak ezabatuko dira. Arakatze-datuetan, historia, automatikoki betetako datuak eta deskargak daude.}other{Erakundeak automatikoki itxiko du Browther # minutuz erabiltzen ez bada. Arakatze-datuak ezabatuko dira. Arakatze-datuetan, historia, automatikoki betetako datuak eta deskargak daude.}}</translation>
<translation id="1535413545339990419">Joan "Browther arakatzaileari buruz" orrira</translation>
<translation id="692283249649018289">Arakatzaileari itxura berria emateko, pertsonalizatu Browther</translation>
<translation id="6375229634133804834">Pertsonalizat&amp;u Browther</translation>
<translation id="4148957013307229264">Instalatzen…</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - Hasi saioa sarean - Browther</translation>
<translation id="2911246138082876798">Ezagutu Browther-erako aplikazio, joko, luzapen eta gai bikainak.</translation>
<translation id="2528977475313334293">Luzapen hori eta gauza gehiago ordenagailu guztietan lortzeko, hasi saioa Browther-en</translation>
<translation id="8244267655940711467">Gurasoen aukerekin sarean seguruago egoteko, aldatu zure Browther-eko profilera, bertan <ph name="USER_EMAIL_ADDRESS"/> gisa saioa hasita baitaukazu jada</translation>
<translation id="4222932583846282852">Bertan behera uzten…</translation>
<translation id="4224210481850767180">Bertan behera utzi da instalazioa.</translation>
<translation id="8219359042845534271">Browther datuak kontu honekin lotu nahi dituzu?</translation>
<translation id="5520777668172961882">Webgune arriskutsuen berri ematen dizu, Browther-k ezagutzen ez zituenak barne, webguneetan babes estandarrak baino datu gehiago aztertuz. Browther-en abisuak saltatzea aukera dezakezu.</translation>
<translation id="2014920019837536689">Amaitu Browther-eko saioa</translation>
<translation id="4341512411059715879">Lortu Browther erabiltzeko laguntza</translation>
<translation id="4281844954008187215">Zerbitzu-baldintzak</translation>
<translation id="322492684764924424">Instalazioak huts egin du zehaztu gabeko errore batengatik. Browther abian bada, itxi eta ireki berriro.</translation>
<translation id="3813060261346666066">Esportatu pasahitzak Browther-etik</translation>
<translation id="4304713468139749426">Pasahitz-kudeatzailea</translation>
<translation id="4334241893986177674">Bilatu pantaila-argazki honetan</translation>
<translation id="4334294535648607276">Deskargatu da.</translation>
<translation id="2177954934431828302">Exekutatu Browther Windows abiaraztean</translation>
<translation id="2472318668926455009">Atzitu erraz eginbide ezagun, gogoko eta fidagarriak Browther arakatzaile lehenetsi bihurtuta. Browther zereginen barran ainguratuko da, hura bizkor atzitzeko.</translation>
<translation id="1068681683510904753">Gailua erabili aurretik, <ph name="MANAGER"/> kudeatzaileak jarraian azalduko diren Zerbitzu-baldintzak irakurtzeko eta onartzeko eskatzen dizu. Baldintzok ez dituzte hedatuko, aldatuko edo mugatuko Chrome OS-ren Baldintzak.</translation>
<translation id="2897580280700805340">Browther-etik irten nahi duzu hala ere?</translation>
<translation id="4413205837991854510">Erakutsi beti irudi-bilaketaren lasterbidea</translation>
<translation id="2454897022983434851">Onartu Browther atzeko planoan abiaraztea</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Kentzea gomendatzen dizu Browther-ek. <ph name="BEGIN_LINK"/>Lortu onartzen diren luzapenei buruzko informazio gehiago<ph name="END_LINK"/>}other{Kentzea gomendatzen dizu Browther-ek. <ph name="BEGIN_LINK"/>Lortu onartzen diren luzapenei buruzko informazio gehiago<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Pertsonalizatu eta kontrolatu Browther</translation>
<translation id="4427306783828095590">Babes handiagoa eskaintzen du phishingaren eta malwarearen aurka</translation>
<translation id="4434353761996769206">Instalatzailearen errorea: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> erabiltzaileak kudeatzen du Browther</translation>
<translation id="4007482010626246887">Gehitu Browther-eko profil bat</translation>
<translation id="6888322430074420631">Browther for Testing-i buruz</translation>
<translation id="8912436499620582668">Browther-eko datuak Browther-ko kontuan gordetzeko eta erabiltzeko, idatzi pasaesaldia</translation>
<translation id="4493028449971051158">Abiarazte-errorea: exekutatu instalatzailea administratzaile gisa.</translation>
<translation id="4501471624619070934">Ezin izan da instalatu, herrialde honetan sarbidea murriztuta dagoelako.</translation>
<translation id="8976207309012239417">Luzapen honek ez du argitaratu pribatutasun-jardunbiderik (adibidez, datuak biltzeko eta erabiltzeko duen moduari buruz). Kentzea gomendatzen dizu Browther-ek.</translation>
<translation id="2174621824527957495">Ongi etorri Browther-era; beste leiho bat ireki da arakatzailean</translation>
<translation id="6391148383688605718">Browther-ek zure inguruaren mapa bat sortzeko eta zure eskuen jarraipena egiteko baimenak behar ditu</translation>
<translation id="7756445485815468244">Jadanik hasita daukazu saioa <ph name="USER_EMAIL_ADDRESS"/> gisa Browther-eko beste profil batean</translation>
<translation id="137435413163730206">Browther-ek orriak aurrez kargatzen ditu, bizkorrago arakatu eta bila dezazun. <ph name="BEGIN_LINK"/>Lortu aurrez kargatutako orriei buruzko informazio gehiago<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Salatu kaltegarriak direla uste duzun webguneak sareko segurtasuna guztientzat hobetzeko.</translation>
<translation id="3266647901351304597">Browther-ek deskarga hau blokeatu du, Arakatze segurua desaktibatu duzulako eta fitxategia egiaztatu ezin delako</translation>
<translation id="6980208900390333646">Probatu Google Lens telefonoan Browther-ekin</translation>
<translation id="4594305310729380060">Gailuko Pasahitz-kudeatzailea zerbitzuan</translation>
<translation id="738228944918383850">Browther aplikazioak</translation>
<translation id="4598116752460667024">Bilatu zerrendako edozein prozesu.</translation>
<translation id="4970880042055371251">Chrome OS-ren bertsioa</translation>
