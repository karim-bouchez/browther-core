<translation id="7009295044271335553">&amp;Spravovať profily prehliadača Browther</translation>
<translation id="1404026649028693342">Vždy zobrazovať režim AI</translation>
<translation id="141901961143729572">Zdieľajte svoje názory</translation>
<translation id="3880714039086599943">Ak chcete zdieľať okno, povoľte prehliadaču Browther nahrávať obrazovku v nastaveniach systému.</translation>
