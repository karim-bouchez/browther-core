<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="1026101648481255140">Qalisa Kabusha Ukufaka</translation>
<translation id="7099479769133613710">Qalisa kabusha ukuze ubuyekeze i-&amp;ChromeOS</translation>
<translation id="7264054672589027446">I-Browther incoma ukuthi ubuyekeze lesi sandiso</translation>
<translation id="7848219163187166649">Lapho isayithi icela ukulayisha kusengaphambili ngasese amalinki ekhasini layo, i-Browther isebenzisa amaseva e-Browther. Lokhu kufihla ubuwena kusayithi elayishwe ngaphambilini, kodwa i-Browther ifunda ukuthi yimaphi amasayithi alayishwa ngaphambilini.</translation>
<translation id="5749154344207139683">Sisize sithuthukise i-Incognito ngokuthatha le nhlolovo yomzuzu o-1.</translation>
<translation id="1065672644894730302">Okuncamelayo kwakho akukwazi ukufundwa.

Ezinye izici kungenzeka zingabi khona futhi izinguquko kokuncamelayo ngeke zize zilondolozwe.</translation>
<translation id="8837164267124113709">Umzali wakho uvale "Izimvume zamasayithi, ama-app, nezandiso" ze-Browther</translation>
<translation id="881513728707488138">I-Browther ifuna ukuthumela amaphasiwedi akho. Thayipha iphasiwedi yakho ye-Windows ukuze uvumele lokhu.</translation>
<translation id="112640046208448578">Thola izinto noma izindawo bese ukopisha noma uhumusha umbhalo. Lapho usebenzisa Usesho Lomfanekiso, isithombe-sikrini sekhasi sithunyelwa eseveni. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">I-Browther iyisiphequluli sakho esizenzakalelayo</translation>
<translation id="6580138787163923852">Ukuze uhlole uma ngabe amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nakwezinye izinkinga zokuvikela, <ph name="BEGIN_LINK"/>ngena ngemvume ku-Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Chofoza imenyu ye-Browther</translation>
<translation id="1157985233335035034">Izilimi zakamuva</translation>
<translation id="3673786631598474384">U-<ph name="PARTNER_NAME"/> wengeze isandiso esingaguqula indlela iBrave esebenza ngayo.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Ukufaka kwehlulekile ngoba uhlobo lweWindows yakho alusekelwa.</translation>
<translation id="8291401179516272335">Mayelana ne-Browther</translation>
<translation id="1203500561924088507">Siyabonga ngokufaka. Kufanele uqale kabusha ibhrawuza yakho ngaphambi kokusebenzisa i-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Uma uvula Usesho Lomfanekiso, isihloko sekhasi, i-URL, nekhontenti, okuhlanganisa ama-PDF, kuzothunyelwa ngokuzenzekelayo kuseva. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Ngenkathi ungene ngemvume, ungasebenzisa amaphasiwedi akho nokuningi ngeBrave sync chain yakho kuBrave. Ukuze ushintshe lokhu, iya kokuthi “I-akhawunti yakho kuBrave”.</translation>
<translation id="9034321258761608912">Ngenkathi le thebhu ingasebenzi, inkumbulo iye yenzelwa isikhala ukugcina i-Browther ishesha. Ungakhetha ukungahlanganisi le sayithi ekutheni ibe engasebenzi.</translation>
<translation id="249571811018731941">I-Browther ivimbele lokhu kudawunilodwa ngoba ifayela liyingozi</translation>
<translation id="8850227089720975601">Uma ungena ngemvume kumasevisi eBrave efana neGmail noma iYouTube nge-<ph name="USER_EMAIL"/>, ungangena ngemvume ngokuzenzakalela kuBrave nge-akhawunti efanayo</translation>
<translation id="1290883685122687410">Iphutha lesethaphu: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Setha iphrofayela yakho entsha ye-Browther</translation>
<translation id="4437862975743821367">I-Browther idinga ukufinyelela i-Bluetooth ukuze ihlole amadivayisi we-Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Thola ulimi</translation>
<translation id="1206925267243987362">Sebenzisa amasethingi ebhrawuza anconywayo eBrave</translation>
<translation id="8270483548049772782">Futhi sula idatha ku-Browther (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Kuphiniwe! Ungafinyelela futhi Usesho Lomfanekiso ngenkinobho entsha kubha yamathuluzi</translation>
<translation id="1356661055722410047">Okusha! Ungahumusha kokubili umbhalo nezithombe esikrinini sakho</translation>
<translation id="1383876407941801731">Sesha</translation>
<translation id="1592588950737518481">&amp;Lawula Amaphrofayela eBrave</translation>
<translation id="1404026649028693342">Bonisa njalo Imodi ye-AI</translation>
<translation id="141901961143729572">Yabelana ngemicabango yakho</translation>
<translation id="1743952081001089298">Ukuze wabelane ngewindi lakho, vumela ukurekhodwa kwesikrini kweBrave Kumasethingi Ohlelo.</translation>
<translation id="8627385813382688019">Thola usizo nge-Browther Yokuhlola</translation>
<translation id="1497802159252041924">Iphutha lokufaka <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Leli khasi livikelwe</translation>
<translation id="7252430412915798987">Yabelana ngethebhu ye-Browther</translation>
<translation id="6388429281015199562">Ngena ngemvume kuBrave</translation>
<translation id="1547469039832541117">Ivala umsebenzi ogqanyisiwe.</translation>
<translation id="1801944307203212016">I-Browther idinga imvume yokufinyelela kwikhamera yakho ukudala imephu engu-3D yendawo yakho ekuzungezile</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Lesi sandiso asisasekelwa. IBrave incoma ukuthi usisuse.}one{Lezi zandiso azisasekelwa. IBrave incoma ukuthi uzisuse.}other{Lezi zandiso azisasekelwa. IBrave incoma ukuthi uzisuse.}}</translation>
<translation id="4667068923142532753">Phina iBrave</translation>
<translation id="3006560544901646947">Amathuluzi okuphepha e-Browther</translation>
<translation id="686052171138185761">IBrave ifuna ukusula idatha Yesiphathi sakho Sephasiwedi. Thayipha iphasiwedi yakho yeWindows ukuze uvumele lokhu.</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{Umlawuli wakho udinga ukuthi uqalise kabusha i-Browther ukuze kusetshenziswe isibuyekezo}=1{Umlawuli wakho udinga ukuthi uqalise kabusha i-Browther ukuze kusetshenziswe isibuyekezo. Iwindi lakho le-Incognito ngeke liphinde livuleke.}one{Umlawuli wakho udinga ukuthi uqalise kabusha i-Browther ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}other{Umlawuli wakho udinga ukuthi uqalise kabusha i-Browther ukuze kusetshenziswe isibuyekezo. Amawindi akho angu-# e-Incognito ngeke aze aphinde avuleke.}}</translation>
<translation id="8713026329083542796">Buyekeza izilawuli eziyinhloko zobumfihlo nokuvikeleka ku-Browther</translation>
<translation id="1640672724030957280">Iyadawuniloda...</translation>
<translation id="1680687534629375545">Buza Ukusesha Ngezithombe ngaleli khasi</translation>
<translation id="1709772298389099340">Inikeza amalungelo aphakeme e-<ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Ukusiza ukuthuthukisa lezi zici, i-Browther ithumela ukusebenzisana kwakho nazo ku-Browther. Le datha ingase ifundwe, icutshungulwe, futhi ichazwe ababuyekezi abangabantu.</translation>
<translation id="1722488837206509557">Lokhu kuzokuvumela ukuthi ukhethe emadivayisini atholakalayo futhi ubonise okuqukethwe kuwo.</translation>
<translation id="6820510278633522408">I-Browther izosula idatha yokubhrawuza maduze</translation>
<translation id="7775028004939172516">I-Browther izozama ukuthuthukisa ukufuna ukuya ku-HTTPS</translation>
<translation id="6963959729951758069">Idatha ye-Browther esuliwe</translation>
<translation id="4085139922884095932">I-Browther izoqala kabusha emizuzwaneni engu-<ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Uma i-HTTPS ingatholakali, i-Browther izosebenzisa uxhumo olungavikelekile ngaphandle kokukuxwayisa</translation>
<translation id="3975328336074677101">Vumela i-Browther ukuthi isebenze ngemuva</translation>
<translation id="3629539416935660172">Ukuze senze i-Browther ivikeleke, sikhubaze ezinye izandiso ezingafakwanga kuhlu lwe-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> futhi okungenzeka zingezwe ngaphandle kolwazi lakho.</translation>
<translation id="2497443204974841650">Phinda ufake i-Browther</translation>
<translation id="1724309687045787742">I-Browther izama uku-<ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Ngokuzayo uma uvula iBrave ku-<ph name="DEVICE_TYPE"/> yakho, uzobona umyalelo wokusebenzisa Umphathi Wephasiwedi YeBrave.</translation>
<translation id="1838374766361614909">Sula usesho</translation>
<translation id="2337233040802538155">Ukuze usule idatha yopheqululo kule divayisi kuphela, kuyilapho uyigcina ku-Browther sync chain yakho, <ph name="BEGIN_LINK"/>phuma ngemvume ku-Browther<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Dawuniloda iBrave efonini yakho ukuze uvule noma usungule amaqembu ethebhu amasha usendleleni.</translation>
<translation id="2063443520349987970">Ungaphatha ama-akhawunti we-Browther wakho angene ngemvume. Ama-akhawunti wakho we-Browther asetshenziselwe i-browser ye-Browther, i-Play Store, i-Gmail, nokuningi. Uma ufuna ukungeza i-akhawunti yomuntu othile, njengelungu lomndeni, engeza umuntu omusha ku-<ph name="DEVICE_TYPE"/> yakho kunalokho. <ph name="LINK_BEGIN"/>Funda kabanzi<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Sesha Ngosesho Lomfanekiso</translation>
<translation id="1880677175115548835">Khetha umbhalo</translation>
<translation id="3183933389992069620">Ungena ngemvume nge-akhawunti ephethwe futhi unikezele ukuqondiswa kokulawulwa kwayo ngaphezulu kwephrofayela yakho ye-Browther. Idatha yakho ye-Browther, efana nezinhlelo zakho zokusebenza, amabhukhimakhi, umlando, amaphasiwedi, nezinye izilungiselelo zizoboshelwa unaphakade ku-<ph name="USER_NAME"/>. Uzokwazi ukususa le datha nge-Ideshibhodi yama-Akhawunti we-Browther, kodwa ngeke uze ukwazi ukuhlobanisa le datha nenye i-akhawunti. Ungadala ngokukhetha iphrofayela entsha ukuze ugcine idatha yakho ekhona ye-Browther ihlukile. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">IBrave igcina amandla ebhethri ngokukhawulela umsebenzi ongemuva nemiphumela yokubuka, njengokuskrola okubushelelezi namazinga ohlaka lwevidiyo. <ph name="BEGIN_LINK"/>Funda kabanzi mayelana Nesongi Samandla<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Buza mayelana naleli khasi</translation>
<translation id="9128006428501241840">Isevisi Yesibuyekezi SeBrave</translation>
<translation id="6302815314157879372">Ngokuvala lokhu, ungangena ngemvume kumasayithi e-Browther njenge-Gmail ngaphandle kokungena ngemvume ku-Browther</translation>
<translation id="1063611196035804685">I-Browther ayiphenduli. Qalisa kabusha manje?</translation>
<translation id="2873360330889594383">Inhlangano yakho, ebizwa <ph name="MANAGER"/>, ifuna ungene ngemvume kuBrave</translation>
<translation id="4035053306113201399">I-ChromeOS idinga ukuphinda iqaliswe ukuze kusetshenziswe isibuyekezo.</translation>
<translation id="2861285003831382718">I-Browther ivimbele lokhu kudawunilodwa ngoba uhlobo lwefayela alivamile ukudawunilodwa futhi lingase libe yingozi</translation>
<translation id="1953553007165777902">Iyadawuniloda... Kusele imizuzu engu-<ph name="MINUTE"/></translation>
<translation id="2080160985220483492">Ithiphu yeBrave: Londoloza Amaphasiwedi</translation>
<translation id="8037497710694492565">I-Browther ayikwazi ukunquma noma isethe isiphequluli esizenzakalelayo</translation>
<translation id="7395009124247513849">Funda ukuthi kungani i-Browther ivimba amanye amafayela, ivula kuthebhu entsha</translation>
<translation id="762710512520170632">Kugcina isofthiwe yakho yeBrave ingeyakamuva. Uma le sevisi ikhutshaziswe noma imisiwe, isofthiwe yakho yeBrave ngeke igcinwe ingeyakamuva, okusho ukuthi ukungavikeleki okungase kuphakame akukwazi ukulungiswa futhi izakhi zingase zingasebenzi. Le sevisi iyazikhipha uma ingekho isofthiwe yeBrave eyisebenzisayo.</translation>
<translation id="5793588180426267429">Lokhu kuzosusa into engu-1 kusuka kule divayisi. Ukuze usebenzise futhi idatha yakho ngokuhamba kwesikhathi, ngena ngemvume ku-Browther njengo-<ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Ukufakwa kwehlulekile. Sicela uzame futhi.</translation>
<translation id="6351516710581760512">Ukuze uhlole uma ngabe amanye amaphasiwedi akho aphephile yini kusukela ekuphulweni kwedatha nezinye izinkinga zokuvikela, <ph name="BEGIN_LINK"/>ngena ngemvume ku-Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Amasethingi.</translation>
<translation id="8194525816714210105">Khetha ukuthi ufake phakathi umlando we-Browther ukuze uthole umuzwa womuntu siqu kumasevisi e-Browther</translation>
<translation id="5909559127548969159">Chofoza inkinobho ethi Vumelanisa IBrave Nomuntu Ngamunye Ekhasini Lethebhu Entsha ukuze unikeze iBrave ukubukeka okusha</translation>
<translation id="2066690553719545730">Bonisa Njalo Imodi ye-AI</translation>
<translation id="3283892260110318935">I-Browther ivimbele lokhu kudawuniloda ngoba ifayela liyakhohlisa futhi lingase lenze izinguquko ezingalindelekile kudivayisi yakho</translation>
<translation id="6160571936643742128">Uzobona umyalelo wokuzama okuthi <ph name="FEATURE_NAME"/> ngesikhathi esilandelayo lapho uvula iBrave iOS.</translation>
<translation id="8380517409933452343">Amaphasiwedi akho kanye nenye idatha yeBrave oyilondoloze kuBrave sync chain yakho izosuswa kule divayisi. Ukuze uphinde uzisebenzise kuBrave, ngena ngemvume futhi.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Browther ingasetshenziswanga umzuzu o-1. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}one{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Browther ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}other{Inhlangano yakho isula idatha yokubhrawuza ngokuzenzekelayo uma i-Browther ingasetshenziswanga imizuzu engu-#. Lokhu kungase kuhlanganise umlando, ukugcwalisa okuzenzakalelayo, nokudawuniloda. Amathebhu akho azohlala evulekile.}}</translation>
<translation id="2126108037660393668">Ifayela elidawunilodiwe aliphumelelanga lapho liqinisekiswa.</translation>
<translation id="2135919691573380097">Bika le sayithi</translation>
