<translation id="4493028449971051158">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ನಿರ್ವಾಹಕರಾಗಿ ರನ್ ಮಾಡಿ.</translation>
<translation id="4501471624619070934">ಈ ರಾಷ್ಟ್ರದಲ್ಲಿ ಆ್ಯಕ್ಸೆಸ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿರುವುದರ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="8976207309012239417">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಡೇಟಾವನ್ನು ಹೇಗೆ ಸಂಗ್ರಹಿಸುತ್ತದೆ ಮತ್ತು ಬಳಸುತ್ತದೆ ಎಂಬಂತಹ ಗೌಪ್ಯತೆಯ ರೂಢಿಗಳನ್ನು ಪ್ರಕಟಿಸಿಲ್ಲ. ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="2174621824527957495">Browther ಗೆ ಸುಸ್ವಾಗತ; ಹೊಸ ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಹೊಸ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗಿದೆ</translation>
<translation id="6391148383688605718">ನಿಮ್ಮ ಸುತ್ತಲಿನ ಪರಿಸರವನ್ನು ನಕ್ಷೆ ಮಾಡಲು ಮತ್ತು ನಿಮ್ಮ ಕೈಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು Browther ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="7756445485815468244">ನೀವು ಈಗಾಗಲೇ ಮತ್ತೊಂದು Browther ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ಮೂಲಕ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ</translation>
<translation id="137435413163730206">Browther, ಪುಟಗಳನ್ನು ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ಬ್ರೌಸಿಂಗ್ ಹಾಗೂ ಹುಡುಕಾಟ ವೇಗವಾಗುತ್ತದೆ. <ph name="BEGIN_LINK"/> ಪ್ರಿಲೋಡ್‌ ಪುಟಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">ನೀವು ಹಾನಿಕಾರಕವೆಂದು ಭಾವಿಸುವ ಸೈಟ್ ಕುರಿತು ನೀವು ವರದಿ ಮಾಡಿದಾಗ ಎಲ್ಲರಿಗೂ ಆನ್‌ಲೈನ್ ಸುರಕ್ಷತೆಯನ್ನು ಸುಧಾರಿಸಿ.</translation>
<translation id="3266647901351304597">ನೀವು ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಫೀಚರ್‌ ಅನ್ನು ಆಫ್ ಮಾಡಿರುವುದರಿಂದ ಮತ್ತು ಈ ಫೈಲ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗದ ಕಾರಣ Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="6980208900390333646">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ Browther ಮೂಲಕ Google Lens ಅನ್ನು ಬಳಸಿ ನೋಡಿ</translation>
<translation id="4594305310729380060">ಈ ಸಾಧನದಲ್ಲಿನ Password Manager ಗೆ</translation>
<translation id="738228944918383850">Browther ಅಪ್ಲಿಕೇಶನ್‌ಗಳು</translation>
<translation id="4598116752460667024">ಪಟ್ಟಿಯಿಂದ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಾಗಿ ಹುಡುಕಿ.</translation>
<translation id="4970880042055371251">ChromeOS ಆವೃತ್ತಿ</translation>
<translation id="4482468019601425607">ಬಹುಪಾಲು ನವೀಕೃತವಾಗಿದೆ! ಅಪ್‌ಡೇಟ್ ಮಾಡುವುದನ್ನು ಮುಗಿಸಲು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="5517890123509214766">Browther ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ Browther ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ</translation>
<translation id="7690070364551268156">ನೀವು Browther ಬಳಕೆಯ ವರದಿಗಳನ್ನು ಸಹ ಹಂಚಿಕೊಂಡರೆ, ಆ ವರದಿಗಳು ನೀವು ಭೇಟಿ ನೀಡುವ URL ಗಳನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="5020487088453637212">ಮತ್ತೊಂದು ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ (<ph name="HOST_NAME"/>) ಇನ್ನೊಂದು Browther ಪ್ರಕ್ರಿಯೆಯ (<ph name="PROCESS_ID"/>) ಮೂಲಕ ಪ್ರೊಫೈಲ್ ಬಳಕೆಯಲ್ಲಿರುವಂತೆ ತೋರುತ್ತಿದೆ. ಪ್ರೊಫೈಲ್ ದೋಷಪೂರಿತಗೊಳ್ಳದಂತೆ ಅದನ್ನು Browther ಲಾಕ್ ಮಾಡಿದೆ. ಇತರ ಯಾವುದೇ ಪ್ರಕ್ರಿಯೆಗಳು ಈ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸುತ್ತಿಲ್ಲವೆಂದು ನಿಮಗೆ ಖಚಿತವಾಗಿದ್ದರೆ, ನೀವು ಪ್ರೊಫೈಲ್ ಅನ್ನು ಅನ್‌ಲಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="4680828127924988555">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ರದ್ದುಮಾಡಿ</translation>
<translation id="8134827615154347946">ನಿಮ್ಮ ಕೆಲವು Browther ಡೇಟಾವನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಉಳಿಸಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="3508712423420506333">ನೀವು ಸೈನ್ ಇನ್ ಆಗಿರುವಾಗ, Browther ನಲ್ಲಿ ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿನ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟನ್ನು ನೀವು ಬಳಸಬಹುದು. <ph name="SHORTCUT"/> ನಿಮ್ಮ Browther ಸೇವೆಗಳ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="2388739442635757494">ಈ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿ <ph name="ACCOUNT_EMAIL_LAST"/> ನಂತೆ Browther ಗೆ ಯಾರೋ ಈ ಹಿಂದೆಯೇ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಮಾಹಿತಿಯನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ಹೊಸ Browther ಬಳಕೆದಾರರನ್ನು ರಚಿಸಿ.</translation>
<translation id="4724676981607797757">ಬೆಂಬಲವಿಲ್ಲದ ಪ್ರೊಟೊಕಾಲ್ ದೋಷದಿಂದಾಗಿ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="8305313684264112434">ಹೇಗಿದ್ದರೂ Browther ಅನ್ನು ಮುಚ್ಚುವುದೇ?</translation>
<translation id="418155915144835101">Browther ಗೆ ವಿಶೇಷ ಸುರಕ್ಷತೆಯ ಅಪ್‌ಡೇಟ್‌‌ ಅನ್ನು ಈಗ ತಾನೇ ಅನ್ವಯಿಸಲಾಗಿದೆ. ಇದೀಗ ಮರುಪ್ರಾರಂಭಿಸಿ ಮತ್ತು ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ನಾವು ಮರುಸ್ಥಾಪಿಸುತ್ತೇವೆ.</translation>
<translation id="2683970367518529374">Browther ಅನ್ನು ಕೇಳಿ</translation>
<translation id="5064473048847774331">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, ಮತ್ತು ಇನ್ನೂ <ph name="COUNT"/> ಅನ್ನು Browther ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="5941343075741207533">Browther ಗೆ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. 24 ಗಂಟೆಗಳ ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ ಅಥವಾ <ph name="BEGIN_LINK"/>ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಿ<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">ಇದು Browther ಹುಡುಕಾಟದಲ್ಲಿ ಬಳಸಲಾದ ಅದೇ ಕಾಗುಣಿತ ಪರೀಕ್ಷೆಯನ್ನು ಬಳಸುತ್ತದೆ. ನೀವು ಬ್ರೌಸರ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡುವ ಪಠ್ಯವನ್ನು Browther ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನೀವು ಈ ವರ್ತನೆಯನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು.</translation>
<translation id="4581078588976787792">Browther ಅನ್ನು ಖಾತೆಯಿಲ್ಲದೆಯೇ ಬಳಸಿ</translation>
<translation id="5921583137589782067">mDNS ಟ್ರಾಫಿಕ್‌ಗೆ ಅನುಮತಿಸುವ ನಿಟ್ಟಿನಲ್ಲಿ Browther ಗೆ ಒಳಬರುವ ನಿಯಮ.</translation>
<translation id="6563126962881169552">&amp;Browther ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4918086044614829423">ಸಮ್ಮತಿಸು</translation>
<translation id="4918844574251943176">ಚಿತ್ರವನ್ನು ಕಾಪಿ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="5240982928057703861">Browther ಹಿನ್ನೆಲೆ ಮೋಡ್‌ನಲ್ಲಿದೆ.</translation>
<translation id="3603134280602182991">Browther ಸೈನ್ ಇನ್ ಡೈಲಾಗ್ ಅನ್ನು ಮುಚ್ಚಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6120233890602288442">Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು Browther ಗೆ ಸಂಬಂಧಿಸಿದ ನಿಮ್ಮ ಎಲ್ಲಾ ಸಂಗತಿಗಳನ್ನು ನೀವು ಪ್ರತ್ಯೇಕವಾಗಿಸಬಹುದು. ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರಿಗಾಗಿ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ರಚಿಸಿ ಅಥವಾ ಕೆಲಸ ಮತ್ತು ಮೋಜಿನ ವಿಷಯಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿಸಿ.</translation>
<translation id="5722688387568011881">ಅತಿಥಿಗಳು ಏನನ್ನೂ ಉಳಿಸದೆಯೇ Browther ಬಳಸಬಹುದು.</translation>
<translation id="7786958592460743302">Browther ನಲ್ಲಿನ ನಿಮ್ಮ ಖಾತೆ</translation>
<translation id="9114640791491590337">ನೀವಾಗಿಯೇ Browther ಗೆ ಸೇರಿಕೊಳ್ಳಿ</translation>
<translation id="3536391594566515053">Browther ನಲ್ಲಿ Gemini ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸಲು ಮತ್ತು ನೀವು ಅದಕ್ಕೆ ನೀಡುವ ಕಾರ್ಯಗಳನ್ನು ಪೂರ್ಣಗೊಳಿಸಲು ಆಟೋ ಬ್ರೌಸ್ ಅನ್ನು ಬಳಸುತ್ತದೆ. <ph name="LINK_BEGIN"/>ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">ನಿಮ್ಮ ಹ್ಯಾಂಡ್‌ಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು Browther ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="1627123463102858476">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> ಅನ್ನು Browther ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="5174969993834422967">ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತೀರಿ. ನಿಮಗೆ ಸೂಚನೆ ನೀಡಲು ಈ ಸೈಟ್‌ಗೆ ಅನುಮತಿಸುವುದಕ್ಕಾಗಿ, ನಿಮ್ಮ ಸ್ಥಳ ಪಟ್ಟಿಯ ಬಲ ಮೂಲೆಯಲ್ಲಿರುವ ನೋಟಿಫಿಕೇಶನ್ ಐಕಾನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="5174983315706567306">ಸಾಕಷ್ಟು ಡಿಸ್ಕ್ ಸ್ಪೇಸ್ ಇಲ್ಲ.</translation>
<translation id="7091313576354542088">Browther ಖಾತೆಗೆ ಸಂಬಂಧಿಸಿದಂತೆ ಮರು-ದೃಢೀಕರಣದ ಅಗತ್ಯವಿದೆ</translation>
<translation id="9045390598305758496">ಯಾವುದೇ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಉಳಿಸಿಲ್ಲ. ನೀವು ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಉಳಿಸಿದಾಗ, Browther ಅವುಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು.</translation>
<translation id="5686724084351858452">Browther ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="5234764350956374838">ವಜಾಗೊಳಿಸಿ</translation>
<translation id="5254739261293693943">ಈ ವೀಡಿಯೊದ ಕುರಿತು ಕೇಳಿ</translation>
<translation id="8165028066129227692">ನಿಮ್ಮ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲು, Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="5286907366254680517">ಪತ್ತೆಹಚ್ಚಲಾಗಿದೆ</translation>
<translation id="198210130507193824">Browther ಆ್ಯಪ್ ಅನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="8472078903122489041">Browther ಅಪ್‌ಡೇಟರ್ ಆಂತರಿಕ ಸೇವೆ</translation>
<translation id="5346389065299425353">ಹಲವಾರು ಟ್ಯಾಬ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಟೂಲ್‌ಗಳನ್ನು ಸೇರಿಸುವ ಮೂಲಕ ನಿಮ್ಮ ಹುಡುಕಾಟವನ್ನು ಇನ್ನಷ್ಟು ಆಳವಾಗಿಸಿ</translation>
<translation id="3904682305383981098">Browther ನಿಮ್ಮ ಪರಿಶೀಲನೆಗಾಗಿ ಕೆಲವು ಸುರಕ್ಷತೆಯ ಶಿಫಾರಸುಗಳನ್ನು ಕಂಡುಕೊಂಡಿದೆ</translation>
<translation id="509616246140011182">ಇತರ Browther ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="8214429210535362385">ನೀವು ನಿರ್ವಹಿಸಲಾದ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತಿರುವಿರಿ ಮತ್ತು ನಿಮ್ಮ Browther ಪ್ರೊಫೈಲ್ ಮೂಲಕ ಅದರ ನಿರ್ವಾಹಕ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತಿರುವಿರಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಹಾಗೂ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ನಿಮ್ಮ Browther ಡೇಟಾವನ್ನು <ph name="USER_NAME"/> ಅವರಿಗೆ ಶಾಶ್ವತವಾಗಿ ಬಂಧಿಸಲಾಗುತ್ತದೆ. Browther ಖಾತೆಗಳ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಮೂಲಕ ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯ, ಆದರೆ ಬೇರೊಂದು ಖಾತೆಯೊಂದಿಗೆ ಈ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">ಹೆಚ್ಚುವರಿ ಕೋಡ್: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">ವೈಯಕ್ತೀಕರಣವನ್ನು ಪಡೆಯಲು, ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆಯಲ್ಲಿ Browther ಅನ್ನು ಸೇರಿಸಿ</translation>
