<translation id="5968400720580217226">AI ಮೋಡ್</translation>
<translation id="8697015289720079159">{COUNT,plural, =1{Browther ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ.}one{Browther ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ.}other{Browther ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಅದನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚುತ್ತದೆ.}}</translation>
<translation id="5852664780493076676">ಸಿಂಕ್ ಪ್ರಾರಂಭಿಸಲು Browther ಅಪ್‌ಡೇಟ್ ಮಾಡಿ</translation>
<translation id="6003112304606738118">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="HOURS"/> ಗಂಟೆ(ಗಳು) ಬಾಕಿಯಿವೆ.</translation>
<translation id="6009821354356307391">ಫಾಲೋ ಅಪ್‌ಗಾಗಿ ಕೇಳಿ</translation>
<translation id="6040143037577758943">ಮುಚ್ಚಿರಿ</translation>
<translation id="2495504229007749358">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು, ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡದ ಸೈಟ್‌ಗಳಿಂದ ಅನುಮತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಲು Browther ಗೆ ಅನುಮತಿಸಿ. ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ನಿಲ್ಲಿಸುವುದಿಲ್ಲ.</translation>
<translation id="6038969823662006832">&amp;Browther ನಲ್ಲಿ ತೆರೆಯಿರಿ</translation>
<translation id="6069027071882229820">ಚಿತ್ರದ ರೂಪದಲ್ಲಿ ಕಾಪಿ ಮಾಡಿ</translation>
<translation id="6606690217326148454">Browther ಗೆ <ph name="EXTENSION_NAME"/> ಅನ್ನು ಸೇರಿಸಲಾಗಿದೆ</translation>
<translation id="6037324269860323082">Browther ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ. ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ.</translation>
<translation id="3695768481578778794">ಆನ್ • ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು Browther ಗೆ ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="4401885752362736126">Browther ನಲ್ಲಿನ ನಿಮ್ಮ ಖಾತೆ</translation>
<translation id="4310817187912076496">Browther ಪರಿಕರಪಟ್ಟಿಯಲ್ಲಿ ಆ್ಯಕ್ಸೆಸ್ ವಿನಂತಿಗಳನ್ನು ತೋರಿಸಲು ವಿಸ್ತರಣೆಯನ್ನು ಅನುಮತಿಸಿ</translation>
<translation id="4602490888173698813"><ph name="FILE_NAME"/> ಅಪಾಯಕಾರಿಯಾಗಿದೆ, ಹಾಗಾಗಿ Browther ಅದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="5139243417751674628">Browther ಶೀಘ್ರದಲ್ಲೇ ಮುಚ್ಚಲ್ಪಡುತ್ತದೆ ಮತ್ತು ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
<translation id="4696750309605389299">ನೀವು ಇಲ್ಲಿ Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಬಹುದು</translation>
<translation id="7475001351099358916">ನೀವು ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸಿದರೆ, ಪ್ರಿಲೋಡ್ ಮಾಡುವಾಗ Browther ಅವುಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="6165508094623778733">ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="5975099973700540482">ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ Browther ಡೇಟಾವನ್ನು ತೆರವುಗೊಳಿಸಿ</translation>
<translation id="6800151735486681860">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಬಹುದು<ph name="LINE_BREAK"/>ನೀವು ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಒದಗಿಸಿದರೆ Browther ನಿಮಗಾಗಿ ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ಪರಿಶೀಲಿಸಬಹುದು. ಫೈಲ್ ಕುರಿತು ಮಾಹಿತಿಯನ್ನು Google Safe Browsing ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ, ಆದರೆ ಫೈಲ್‌ನ ವಿಷಯಗಳು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಉಳಿಯುತ್ತದೆ.</translation>
<translation id="6182736845697986886">ಅಪ್‌ಡೇಟ್ ಸರ್ವರ್ ಆಂತರಿಕ ದೋಷದಿಂದಾಗಿ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="48832130233362517">ನಿಮ್ಮ <ph name="TARGET_DEVICE_NAME"/> ನಲ್ಲಿ ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದೀರಿ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ ಮತ್ತು ನಂತರ ಪುನಃ ಕಳುಹಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8868210753005945522">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿನ ಮತ್ತೊಂದು ಪ್ರೋಗ್ರಾಂ Browther ಕಾರ್ಯನಿರ್ವಹಿಸುವ ವಿಧಾನವನ್ನು ಬದಲಿಸಬಹುದಾದ ಆ್ಯಪ್ ಒಂದನ್ನು ಸೇರಿಸಿದೆ.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">ಈ ಕಂಪ್ಯೂಟರ್ Browther ನ ಇತ್ತೀಚಿನ ಹೆಚ್ಚಿನ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿದೆ. ಸಾಫ್ಟ್‌ವೇರ್ ಕಾರ್ಯನಿರ್ವಹಿಸದಿದ್ದರೆ, ದಯವಿಟ್ಟು Browther ಅನ್ನು ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="9222998061982994203">{0,plural, =0{ಇದೀಗ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}=1{1 ಸೆಕೆಂಡಿನಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ಸೆಕೆಂಡುಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ಸೆಕೆಂಡುಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="6239161312595354541">ಈ ವೀಡಿಯೊದ ಕುರಿತು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಕೇಳಿ</translation>
<translation id="1755464917870815989">ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು Browther ಗೆ ಸಂಗ್ರಹಣೆಯ ಪ್ರವೇಶದ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="304681001513922736">Browther ನಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಮಾಡಲಾಗಿರುವ ಅಸುರಕ್ಷಿತ ಸೈಟ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ, URL ಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ</translation>
<translation id="7785903492969539081">Browther ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಮಾಡಿ</translation>
<translation id="3987833816263696343">Browther ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಬೇಕೆ?</translation>
<translation id="4723540739671534529">ಈ ಟ್ಯಾಬ್‌ಗಳು ಹೆಚ್ಚುವರಿ ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತಿವೆ. ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು, ಅವುಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು Browther ಅನ್ನು ಅನುಮತಿಸಿ.</translation>
<translation id="6540151687468239291">ನಿಮ್ಮ Browther ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="770793114032605647">ನಿಮ್ಮ Browther ಪ್ರೊಫೈಲ್ ಅನ್ನು ಹೆಸರಿಸಿ</translation>
<translation id="385867753870250529">Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ನಿಮ್ಮನ್ನು ಕೇಳುತ್ತದೆ</translation>
<translation id="2022337046348377650"><ph name="FILE_NAME"/> ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಹಾಗಾಗಿ Browther ಅದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="45270956603278068">Browther ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="6327105987658262776">ಯಾವುದೇ ಅಪ್‌ಡೇಟ್‌‌ ಲಭ್ಯವಿಲ್ಲ.</translation>
<translation id="673633752219771459">Browther ನಲ್ಲಿ ಬೇರೆ ಕಾರ್ಯಾಚರಣೆಯು ಪ್ರಗತಿಯಲ್ಲಿದೆ. ದಯವಿಟ್ಟು ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="1482759407165416070">ನಿಮ್ಮ Browther ಖಾತೆಯ ಮೂಲಕ ಮತ್ತು ಹಂಚಿದ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ Browther ಬಳಕೆಯು ಇದೀಗ ತುಂಬಾ ಸುಲಭವಾಗಿದೆ.</translation>
<translation id="5538042432112726532">Browther ಶಾರ್ಟ್‌ಕಟ್</translation>
<translation id="833085228901080512">ಈ ಫೈಲ್ ಅನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
<translation id="491120842288314439">Browther ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನೀವು ಖಚಿತವಾಗಿ ಬಯಸುವಿರಾ?</translation>
<translation id="6375219077595103062">Password Manager ಗೆ ಶಾರ್ಟ್‌ಕಟ್ ಸೇರಿಸಿ</translation>
<translation id="6388799252195623474">ಈ ಕುರಿತು ನನಗೆ ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="6715003312952407375">ಮುಂದುವರಿಯಲು, Browther ಗೆ <ph name="EMAIL"/> ಎಂಬುದಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ. ಇದು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ನೀತಿಗಳನ್ನು ನೀವು ಪಡೆದುಕೊಂಡಿದ್ದೀರಿ ಎಂದು ಖಚಿತಪಡಿಸುತ್ತದೆ.</translation>
<translation id="1897845318651970239">ಕಂಪ್ಯೂಟರ್ ಸ್ಕ್ರೀನ್‌ನೊಳಗೆ Browther ಲೋಗೋ.</translation>
<translation id="3669522483038684532">Browther ಒಂದು ವೆಬ್ ಬ್ರೌಸರ್ ಆಗಿದ್ದು ವೆಬ್‌ಪುಟಗಳನ್ನು ಮತ್ತು ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ವೇಗದೊಂದಿಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ. ಇದು ವೇಗವಾದ, ಸ್ಥಿರವಾದ, ಮತ್ತು ಬಳಸಲು ಸುಲಭವಾಗಿದೆ. ಮಾಲ್‌ವೇರ್‌ನೊಂದಿಗೆ ಹೆಚ್ಚು ಸುರಕ್ಷಿತವಾಗಿ ಹಾಗೂ Browther ನಲ್ಲಿ ವಿನ್ಯಾಸಗೊಳಿಸಲಾದ ಫಿಶಿಂಗ್ ಸುರಕ್ಷೆಯೊಂದಿಗೆ ವೆಬ್ ಅನ್ನು ಬ್ರೌಸ್ ಮಾಡಿ.</translation>
<translation id="5669767676913031391">Browther ವೇಗವಾಗಿ ರನ್ ಆಗುತ್ತದೆ ಮತ್ತು JavaScript ಅನ್ನು ಬಳಸುವ ಫೀಚರ್‌ಗಳು, ವಿನ್ಯಾಸಗೊಳಿಸಿದಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸಬೇಕು</translation>
<translation id="6436260184216827876">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಲಭ್ಯವಿಲ್ಲ. ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="2139300032719313227">ChromeOS ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="6110616900529884221">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಇನ್ನೂ ಹೆಚ್ಚಿನ ಪುಟಗಳನ್ನು Browther ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="1217194059001819677">ದರಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಮತ್ತು ಯಾವುದೇ ಸೈಟ್‌ನಲ್ಲಿ ದರ ಇಳಿಕೆಯಾದಾಗ ಅಲರ್ಟ್‌ಗಳನ್ನು ಪಡೆಯಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Browther ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ</translation>
<translation id="7058555680120557198">ಆಫ್ • ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು Browther ಗೆ ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="676533642429632127">Browther ಪ್ರೊಫೈಲ್‌ಗಳಿಗೆ ಸುಸ್ವಾಗತ</translation>
<translation id="5518682889576009702">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ ನೀವು Browther ಅನ್ನು ತೆರೆದಾಗ, ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="6038105561107837619">Browther ನಿಂದ ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="2675662665675552980">ನೀವು Browther ಪ್ರಾರಂಭಿಸಿದಾಗ ತೋರಿಸಬೇಕಾದ ಪುಟವನ್ನು ಕೂಡಾ ಇದು ನಿಯಂತ್ರಿಸುತ್ತದೆ.</translation>
<translation id="648319183876919572">ಅಪಾಯಕಾರಿ ವೆಬ್‌ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ವಿರುದ್ಧ ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಲು ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಹೆಚ್ಚಿನ ಸಹಾಯ ಮಾಡುತ್ತದೆ</translation>
<translation id="2930243146591999795">Browther ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿ</translation>
<translation id="5241183382286817629">Browther ನಲ್ಲಿ ಶಾರ್ಟ್‌ಕಟ್‌ಗಳು ತೆರೆದಿರುತ್ತವೆ</translation>
<translation id="7907014599435829661">Browther ಅನ್ನು <ph name="TIMEOUT_DURATION"/> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ. ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗಿದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.</translation>
<translation id="2088471423667794811">ಪ್ರತಿಯೊಂದು ಪ್ರೊಫೈಲ್ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟವುಗಳಂತಹ ತನ್ನ ಸ್ವಂತ Browther ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="9040334484455218184"><ph name="BEGIN_LINK"/>Browther ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಹೇಗೆ ಖಾಸಗಿಯಾಗಿ ಇರಿಸುತ್ತದೆ<ph name="END_LINK"/> ಎಂಬುದರ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="1718697235867382480">Browther ಮರುಪ್ರಾರಂಭಗೊಂಡ ನಂತರ ಈ ಸೆಟ್ಟಿಂಗ್‌ಗೆ ಬದಲಾವಣೆಗಳನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="6331317152404762758">ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ವೀಕ್ಷಿಸಲು ನೀವು ಇನ್ನೊಂದು Browther ಪ್ರೊಫೈಲ್‌ಗೆ ಬದಲಾಯಿಸಬಹುದು</translation>
<translation id="6097706403184348562">ಕಾಗುಣಿತ ದೋಷಗಳನ್ನು ಸರಿಪಡಿಸಲು, ನೀವು ಪಠ್ಯ ಕ್ಷೇತ್ರಗಳಲ್ಲಿ ಟೈಪ್ ಮಾಡುವ ಪಠ್ಯವನ್ನು Browther, Browther ಗೆ ಕಳುಹಿಸುತ್ತದೆ</translation>
<translation id="2319647238307402812">Browther ನೋಟಿಫಿಕೇಶನ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಿಗೆ ಹೋಗಿ</translation>
<translation id="6600016381025017075">ಈ ಪುಟದಲ್ಲಿ ಯಾವುದನ್ನಾದರೂ ಹುಡುಕಿ</translation>
<translation id="8031938899816118394">ನೀವು ಮುಂದಿನ ಬಾರಿ Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="7412185356697187964">Windows ಪ್ರಾರಂಭವಾದಾಗ Browther ಈಗ ಪ್ರಾರಂಭವಾಗುತ್ತದೆ, ಆದ್ದರಿಂದ ನೀವು ತಕ್ಷಣವೇ ಬ್ರೌಸ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಬಹುದು. ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಇದನ್ನು ಆಫ್ ಮಾಡಬಹುದು.</translation>
<translation id="9123343592576384616">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಯಿರಿ: Browther ನಿಮ್ಮ ಕೊನೆಯ ಸೆಶನ್‌ನಿಂದ ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಿದೆ. ನೀವು ಇದನ್ನು ಇದರಲ್ಲಿ ಆಫ್ ಮಾಡಬಹುದು</translation>
<translation id="5847926498049048567">ನಿಮ್ಮ ಸುತ್ತಮುತ್ತಲಿನ ಪ್ರದೇಶದ 3D ನಕ್ಷೆಯನ್ನು ರಚಿಸಲು Browther ಗೆ ಕ್ಯಾಮರಾ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="5532585028508811858">ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸಹ ನೀವು ಸೇವ್ ಮಾಡಿದರೆ, ನೀವು Browther ನಲ್ಲಿ ಉತ್ಪನ್ನದ ಬೆಲೆಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು ಬೆಲೆ ಕಡಿಮೆಯಾದಾಗ ಸೂಚನೆ ಪಡೆಯಬಹುದು</translation>
<translation id="6676384891291319759">ಇಂಟರ್ನೆಟ್ ಅನ್ನು ಪ್ರವೇಶಿಸಿ</translation>
<translation id="1363996462118479832">ಸೈನ್ ಇನ್ ಮಾಡುವಾಗ ದೋಷವಿರುವ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="3373239673945775810">Browther ನಿಂದ ಈ ಆ್ಯಪ್‌ನ ಡೇಟಾವನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="8122759674786039814">ನೀವು ನೋಡುವ ಜಾಹೀರಾತುಗಳ ಮೇಲೆ Browther ನಿಮಗೆ ಹೆಚ್ಚಿನ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತದೆ ಮತ್ತು ಸೈಟ್‌ಗಳಲ್ಲಿ ನೀವು ವೈಯಕ್ತೀಕರಿಸಿದ ಜಾಹೀರಾತುಗಳನ್ನು ನೋಡಿದಾಗ ನಿಮ್ಮ ಕುರಿತು ಯಾವ ಸೈಟ್‌ಗಳು ತಿಳಿಯಬಹುದು ಎಂಬುದನ್ನು ಮಿತಿಗೊಳಿಸುತ್ತದೆ</translation>
<translation id="6277682530398500159">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Browther ಗೆ ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="6712881677154121168">ಡೌನ್‌ಲೋಡ್ ದೋಷ: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">Browther ನ ಹೊಸ ಆವೃತ್ತಿಯಾಗಿರುವುದರಿಂದ ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ. ಕೆಲವೊಂದು ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿಲ್ಲದಿರಬಹುದು. ದಯವಿಟ್ಟು ಬೇರೆ ಒಂದು ಪೊಫೈಲ್ ಡೈರೆಕ್ಟರಿ ಅನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಿ ಅಥವಾ Browther ನ ಹೊಸ ಆವೃತ್ತಿಯನ್ನು ಬಳಸಿ.</translation>
<translation id="871671753163165892">ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಇತರ ಫೀಚರ್‌ಗಳನ್ನು ಪಡೆಯಲು, ವೆಬ್ ಮತ್ತು ಆ್ಯಪ್ ಚಟುವಟಿಕೆ ಹಾಗೂ ಲಿಂಕ್ ಮಾಡಲಾದ Browther ಸೇವೆಗಳಲ್ಲಿ Browther ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="5000832110229523807">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿನ ಎಲ್ಲ ಬಳಕೆದಾರರಿಗೆ ಈಗಾಗಲೇ Browther ಸ್ಥಾಪಿತವಾಗಿದೆ.</translation>
<translation id="5204575479550973859">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ಬುಕ್‌ಮಾರ್ಕ್ ಅನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="2874208284092283937">Browther ನ V8 ಇಂಜಿನ್‌ ಮೂಲಕ ಸೈಟ್‌ಗಳನ್ನು ವೇಗಗೊಳಿಸುತ್ತದೆ, ಆದರೆ Browther ದಾಳಿಗಳ ವಿರುದ್ದ ಸ್ವಲ್ಪ ಕಡಿಮೆ ಪ್ರತಿರಕ್ಷಣೆ ಮಾಡುತ್ತದೆ. ಈ ಸೆಟ್ಟಿಂಗ್ ಆನ್ ಆಗಿದೆ.</translation>
<translation id="3268577459683869744">{count,plural, =1{ನಿಮ್ಮ ಕೆಲವು Browther ಡೇಟಾವನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು (1 ಐಟಂ) ಅಳಿಸಲಾಗುತ್ತದೆ.}one{ನಿಮ್ಮ ಕೆಲವು Browther ಡೇಟಾವನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}other{ನಿಮ್ಮ ಕೆಲವು Browther ಡೇಟಾವನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಇನ್ನೂ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ. ಸೈನ್ ಔಟ್ ಮಾಡುವ ಮೊದಲು ಕೆಲವು ನಿಮಿಷ ಕಾಯಲು ಪ್ರಯತ್ನಿಸಿ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}}</translation>
<translation id="7683816018918395929">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು, ಆದ್ದರಿಂದ ಇದನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಬೇಕೆಂದು Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="1547295885616600893">ಹೆಚ್ಚುವರಿ <ph name="BEGIN_LINK_CROS_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_CROS_OSS"/> ನಿಂದ ChromeOS ಮಾಡಲು ಸಾಧ್ಯ.</translation>
<translation id="6831043979455480757">Translate</translation>
<translation id="2142653375108595728">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಎಂದಾದರೂ ಹ್ಯಾಕ್‌ ಆಗಿವೆಯೇ ಎಂಬುದನ್ನು Browther ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="684888714667046800">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ನೀವು ಫೈರ್‌ವಾಲ್ ಅನ್ನು ಬಳಸುತ್ತಿದ್ದರೆ, <ph name="PRODUCT_EXE_NAME"/> ಅನುಮತಿ ಪಟ್ಟಿಯಲ್ಲಿ ಇದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">ಮುಂದುವರಿಸಲು ಟ್ಯಾಬ್ ಅನ್ನು ಒತ್ತಿರಿ</translation>
<translation id="6862030660799253820">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಬಳಸಿಕೊಂಡು ಈ ಚಿತ್ರವನ್ನು ಹುಡುಕಿ</translation>
<translation id="3860339351709082396">"<ph name="EXTENSION_NAME"/>" ನಲ್ಲಿ ಮಾಲ್‌ವೇರ್ ಇರುವುದನ್ನು Browther ಪತ್ತೆಹಚ್ಚಿದೆ</translation>
<translation id="6877155553248388166">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಕೆಳಗಿನ ಬಲ ಮೂಲೆ: ಬಲಕ್ಕೆ <ph name="RIGHT"/>%, ಕೆಳಕ್ಕೆ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">ನಕಲಿಸು</translation>
<translation id="7804113502310231166">Browther ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="3228374215117173004">&amp;Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="6934579572334859869">ಈ ಚಿತ್ರದ ಕುರಿತು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಕೇಳಿ</translation>
<translation id="5995328366516663808">ನೀವು Browther ನ <ph name="BOOKMARK_LIMIT"/> ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳ ಮಿತಿಯನ್ನು ತಲುಪಿದ್ದೀರಿ, ಆದ್ದರಿಂದ ನಿಮ್ಮ ಕೆಲವು ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಇನ್ನೂ ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗಿಲ್ಲ.

ನೀವು ಕೆಲವು ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಅಳಿಸುವವರೆಗೆ ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ ಹೊಸ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಸೇವ್ ಮಾಡದ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="6965382102122355670">ಸರಿ</translation>
<translation id="4533562834763015352">ದುರ್ಬಲ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸುಲಭವಾಗಿ ಊಹಿಸಬಹುದು. Browther <ph name="BEGIN_LINK"/>ನಿಮಗಾಗಿ ಸದೃಢ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ರಚಿಸಲು ಮತ್ತು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಲು<ph name="END_LINK"/> ಅವಕಾಶ ಮಾಡಿಕೊಡಿ.</translation>
<translation id="3453763134178591239">ChromeOS ನಿಯಮಗಳು</translation>
<translation id="5379058926689137454">ಈ ಸೈಟ್‌ಗಾಗಿ ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್‌ಗೆ ಪ್ರವೇಶಿಸಲು Browther ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="4684462982894889021">ನಿಮ್ಮ ಖಾತೆ <ph name="ACCOUNT_EMAIL"/> ನಲ್ಲಿ Browther ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="7011190694940573312">ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂನ ಈ ಆವೃತ್ತಿಯನ್ನು ಬೆಂಬಲಿಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="7024536598735240744">ಅನ್‌ಪ್ಯಾಕ್ ದೋಷ: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ನಿಲ್ಲಿಸಲಾಗಿದೆ.</translation>
<translation id="8257174622576051374">ನಿಮ್ಮ ಸ್ವಂತ Browther ಅನ್ನು ರಚಿಸಿ</translation>
<translation id="7047386856539490735">ಈ ಫಲಿತಾಂಶಗಳು ಉಪಯುಕ್ತವಾಗಿವೆಯೇ?</translation>
<translation id="1772745060691790742">Browther ಅಪ್‌ಡೇಟ್‌ ಮಾಡಿ</translation>
<translation id="4937970118065051027">ಚಿತ್ರದಲ್ಲಿ ಉಪಯುಕ್ತ ವಿವರಣೆಯು ಇಲ್ಲದಿದ್ದರೆ, Browther ನಿಮಗಾಗಿ ಒಂದು ವಿವರಣೆಯನ್ನು ಒದಗಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ವಿವರಣೆಗಳನ್ನು ರಚಿಸಲು, ಚಿತ್ರಗಳನ್ನು Browther ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="1594112132009288601">Browther for Testing ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="5915000938288527952">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ Browther ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="8775664994493381735">Browther ನಿಂದ <ph name="EXTENSION_NAME"/> ಅನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="3276648807841991013">Browther ಅನ್ನು <ph name="TIMEOUT_DURATION"/> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದರ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು.</translation>
<translation id="4725226878394159809">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Browther ಗೆ ಕ್ಯಾಮರಾ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="8931474625901592021">Browther ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="8242947409070121799">Browther ಗೆ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. 24 ಗಂಟೆಗಳ ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="1737922827960215472">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ತ್ವರಿತವಾಗಿ ಪಡೆಯಲು Browther ಅನ್ನು ನಿಮ್ಮ ಡಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="335855266303176628">ಸಂದೇಶಗಳು, ಡಾಕ್ಯುಮೆಂಟ್‌ಗಳು ಮತ್ತು ಇತರ ಆ್ಯಪ್‌ಗಳಲ್ಲಿನ ಲಿಂಕ್‌ಗಳನ್ನು ನೀವು ಕ್ಲಿಕ್ ಮಾಡುವಾಗ, ಯಾವಾಗ ಬೇಕಾದರೂ Browther ಅನ್ನು ಬಳಸಿ</translation>
<translation id="709455597778444012">ಕಾರ್ಯನಿರ್ವಾಹಕ - Browther</translation>
<translation id="7147140345767587643">Browther ಅಂದಾಜು ಮಾಡಿರುವ ಪ್ರಕಾರ ನಿಮ್ಮ ಆಸಕ್ತಿಗಳು</translation>
<translation id="7337408274890534789">ತಕ್ಷಣವೇ ಬ್ರೌಸ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿ: Windows ಪ್ರಾರಂಭವಾದಾಗ Browther ಈಗ ಪ್ರಾರಂಭಿಸಬಹುದು.</translation>
<translation id="7274695763216404502">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಿಂದ ಮತ್ತೊಮ್ಮೆ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ</translation>
<translation id="7288567540154601580">ಟ್ಯಾಬ್‌ಗಳು ಮತ್ತು ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="1527644038571473502">ಸಿಸ್ಟಂ ಆಡಿಯೊವನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು Browther ಗಾಗಿ 'ಸಿಸ್ಟಂ ಆಡಿಯೊ ರೆಕಾರ್ಡಿಂಗ್ ಮಾತ್ರ' ಎಂಬುದನ್ನು ಅನುಮತಿಸಿ. ನಂತರ ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="1427913074981060872">ತಮ್ಮ ಜಾಹೀರಾತುಗಳ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಮಾಪನ ಮಾಡಲು ನೆರವಾಗುವಂತಹ ಮಾಹಿತಿಯನ್ನು Browther ನಿಂದ ವಿನಂತಿಸಿಕೊಳ್ಳಲು ಜಾಹೀರಾತು ಮಾಪನವು ಸೈಟ್‌ಗಳಿಗೆ ಅನುಮತಿಸುತ್ತದೆ. ಸೈಟ್‌ಗಳ ನಡುವೆ ಸಾಧ್ಯವಾದಷ್ಟು ಕಡಿಮೆ ಮಾಹಿತಿಯನ್ನು ವರ್ಗಾಯಿಸುವ ಮೂಲಕ ಕ್ರಾಸ್-ಸೈಟ್ ಟ್ರ್ಯಾಕಿಂಗ್ ಅನ್ನು ಜಾಹೀರಾತು ಮಾಪನ ನಿರ್ಬಂಧಿಸುತ್ತದೆ.</translation>
<translation id="1657652725060525338">Browther ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲಾಗುತ್ತಿದೆ</translation>
<translation id="884846289464870238">ನಿಮ್ಮ ಪ್ರಾಶಸ್ತ್ಯಗಳ ಫೈಲ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಅಮಾನ್ಯವಾಗಿದೆ. ನಿಮ್ಮ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮರುಪಡೆದುಕೊಳ್ಳುವಲ್ಲಿ Browther ವಿಫಲಗೊಂಡಿದೆ.</translation>
<translation id="7339898014177206373">ಹೊಸ ವಿಂಡೊ</translation>
<translation id="633044855886370183">ನಿಮ್ಮ ವೆಬ್, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತರ Browther ಸಂಗತಿಗಳು ಇಲ್ಲಿ ಲೈವ್ ಆಗುತ್ತವೆ.</translation>
<translation id="1185960088713242527">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಹೊಂದಿರುವವರು ಮಾತ್ರ ನಿಮ್ಮ ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಿದ ಡೇಟಾವನ್ನು ಓದಬಹುದು. ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು Browther ಗೆ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಅದನ್ನು Browther ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ. ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನೀವು ಮರೆತರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, ನೀವು <ph name="BEGIN_LINK"/>ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ Browther ಡೇಟಾವನ್ನು ಅಳಿಸಬೇಕಾಗುತ್ತದೆ<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110"><ph name="TARGET_URL_HOSTNAME"/> ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಪಡೆಯುವುದಕ್ಕಾಗಿ <ph name="ALTERNATIVE_BROWSER_NAME"/> ಅನ್ನು ತೆರೆಯಲು, ನಿಮ್ಮ ಸಿಸ್ಟಂ ನಿರ್ವಾಹಕರು Browther ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ್ದಾರೆ.</translation>
<translation id="7352651011704765696">ಯಾವುದೋ ತಪ್ಪು ಸಂಭವಿಸಿದೆ</translation>
<translation id="6638123710106659002">ಭವಿಷ್ಯದ Browther ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನಿಮಗೆ macOS 13 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಗಳ ಅಗತ್ಯವಿದೆ. ಈ ಕಂಪ್ಯೂಟರ್ macOS 12 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="7286289384512061761">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> ಅನ್ನು Browther ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="113593073175678746">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಇನ್ನು ಮುಂದೆ ಬೆಂಬಲಿಸುವುದಿಲ್ಲ. ಬದಲಾಗಿ ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.</translation>
<translation id="137615076640044304">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಸಿ: ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗಲೆಲ್ಲಾ Browther ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸುತ್ತದೆ. ಇದನ್ನು ಆಫ್ ಮಾಡಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ</translation>
<translation id="5967238175620483220">Browther ಗೆ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಇಂಪೋರ್ಟ್ ಮಾಡಿ</translation>
<translation id="4719434010343478165"><ph name="PAGE_TITLE"/> - Browther Dev</translation>
<translation id="7450541714075000668">ಪಠ್ಯವನ್ನು ಕಾಪಿ ಮಾಡಲಾಗಿದೆ</translation>
<translation id="7766009218653304791">ಈ ಸೈಟ್‌ಗಾಗಿ ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಪ್ರವೇಶಿಸಲು Browther ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="5844418066487488520">ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್ ಬಳಸಲು, <ph name="BEGIN_LINK"/>ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> Browther ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="8065480549334161841">ಭವಿಷ್ಯದ Browther ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 7 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="6299293759264950896">Browther ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆ?</translation>
<translation id="180908550381040105">ಪ್ರಸ್ತುತ ಚಾಲನೆಯಲ್ಲಿರುವ Browther ನ ಅದೇ ಆವೃತ್ತಿಯನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. ದಯವಿಟ್ಟು Browther ಅನ್ನು ಮುಚ್ಚಿರಿ ಮತ್ತು ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="7625576878150380853">ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗಲೆಲ್ಲಾ ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಸೇವ್ ಮಾಡುತ್ತೀರಿ ಮತ್ತು ಬಳಸುತ್ತೀರಿ. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">ಸೈಟ್‌ಗಳು ನಿರೀಕ್ಷೆಯಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ. ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಆಗಿದ್ದರೆ, ಎಲ್ಲಾ Browther ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚುವುದರಿಂದ ನಿಮ್ಮ Browther ಖಾತೆಯನ್ನು ಹೊರತುಪಡಿಸಿ ಹೆಚ್ಚಿನ ಸೈಟ್‌ಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="7099370564362681943">{0,plural, =1{1 ನಿಮಿಷದಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ನಿಮಿಷಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ನಿಮಿಷಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="3602613943932672197">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು, ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡದ ಸೈಟ್‌ಗಳಿಂದ ಅನುಮತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಲು Browther ಗೆ ಅವಕಾಶ ನೀಡಿ.</translation>
<translation id="8759568213742229377">ತಕ್ಷಣವೇ ಬ್ರೌಸಿಂಗ್ ಪ್ರಾರಂಭಿಸಲು Browther ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಪ್ರಾರಂಭಿಸಿ.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ಇನ್‌ಸ್ಟಾಲರ್‌‌</translation>
<translation id="8991800242749014880">Browther ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೋಫೋನ್ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="2692328388439821508">Browther ಇದೀಗ ಉತ್ತಮಗೊಂಡಿದೆ</translation>
<translation id="4318444066563223295">ಈಗ ನೀವು Browther ನಲ್ಲಿ ಇನ್ನಷ್ಟು ಫೀಚರ್‌ಗಳನ್ನು ಹೊಂದಿದ್ದೀರಿ</translation>
<translation id="7649070708921625228">ಸಹಾಯ</translation>
<translation id="5591287320769313116">ನಿಮ್ಮ ಪರವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಲು Browther ಗೆ ಅವಕಾಶ ನೀಡಿ</translation>
<translation id="7658239707568436148">ರದ್ದುಮಾಡಿ</translation>
<translation id="6325482130534634729">Browther ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅಲ್ಲ</translation>
<translation id="8185915921134219287">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ Browther ಅನ್ನು ಸಿಂಕ್ ಮಾಡಿ ಮತ್ತು ವೈಯಕ್ತೀಕರಿಸಿ</translation>
<translation id="5120421624925726813">Browther ಅಪ್‌ಡೇಟ್</translation>
<translation id="7716950018788545737">ಕಾರ್ಯ(ಗಳು) ಮುಗಿದಿದೆ.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> ಗಾಗಿ ಸಿಸ್ಟಮ್‌ ಟ್ರೇಸಿಂಗ್‌ ಸೇವೆಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ. ಈ ಸೇವೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ, ಬ್ರೌಸರ್‌ನಿಂದ ರಚಿಸಲಾದ ಪರ್ಫಾರ್ಮೆನ್ಸ್‌ ಟ್ರೇಸ್‌ಗಳು ಕಂಟೆಕ್ಸ್‌ಟ್‌ ಸ್ವಿಚ್‌ ಮತ್ತು ಸಿದ್ಧ ಥ್ರೆಡ್ ಈವೆಂಟ್‌ಗಳಂತಹ ಸಿಸ್ಟಮ್-ವೈಡ್‌ ಈವೆಂಟ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರುವುದಿಲ್ಲ.</translation>
<translation id="6542096191573265107">ಈ ಸಾಧನದಿಂದ ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL"/> ನಂತೆ Browther ಗೆ ಸೈನ್‌ ಇನ್ ಮಾಡಿ.</translation>
<translation id="7747138024166251722">ಇನ್‌ಸ್ಟಾಲರ್‌‌‌ಗೆ ತಾತ್ಕಾಲಿಕ ಡೈರೆಕ್ಟರಿಯನ್ನು ರಚಿಸಲಾಗಲಿಲ್ಲ. ಸಾಫ್ಟ್‌ವೇರ್ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಮುಕ್ತ ಡಿಸ್ಕ್ ಜಾಗ ಮತ್ತು ಅನುಮತಿಗಾಗಿ ದಯವಿಟ್ಟು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="351575328720488268">ಡೀಫಾಲ್ಟ್ Browther ಗೆ ರೀಸೆಟ್ ಮಾಡಿ</translation>
<translation id="1054170408395182418">Browther ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ ಮತ್ತು ಅದನ್ನು ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="4569594230301902490">Browther ಅನ್ನು ವೇಗಗೊಳಿಸಿ</translation>
<translation id="5525298466557654312"><ph name="PAGE_TITLE"/> - Browther Canary</translation>
<translation id="7893465573639396635">ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಟ್ರಾಫಿಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಹೊಂದಿರುವ ಜನರಿಗೆ ನೀವು ಯಾವ ಸೈಟ್‌ಗಳಿಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಲು ಕಷ್ಟವಾಗುವಂತೆ ಮಾಡಿ. DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವೊಂದನ್ನು ಹುಡುಕಲು Browther ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಒಂದನ್ನು ಬಳಸುತ್ತದೆ.</translation>
<translation id="7810005234485217901">ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಪಿನ್ ಮಾಡಬಹುದು</translation>
<translation id="2462631024103158515">ಈ ಸಾಧನದಲ್ಲಿ ಈ ಖಾತೆಯೊಂದಿಗಿನ Browther ಪ್ರೊಫೈಲ್ ಈಗಾಗಲೇ ಅಸ್ತಿತ್ವದಲ್ಲಿದೆ</translation>
<translation id="7845233973568007926">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME"/> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನೀವು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="311190437086049332">Browther ಗೆ ಹೊಸ ಲುಕ್ ನೀಡಲು ಅದನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="6728847658878265103">Browther ಗೆ ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ, ಈ ಮೂಲಕ ನೀವು ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಭದ್ರತೆ ಸರಿಪಡಿಸುವಿಕೆಗಳನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಿರಬಹುದು.</translation>
<translation id="7872446069773932638">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="SECONDS"/> ಸೆಕೆಂಡ್(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ.</translation>
<translation id="5374532739787768601">ನೀವು ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ಮರೆತಿದ್ದರೆ ಅಥವಾ ಈ ಸೆಟ್ಟಿಂಗ್ ಅನ್ನು ಬದಲಾಯಿಸಲು ಬಯಸಿದರೆ, <ph name="BEGIN_LINK"/>ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿರುವ Browther ಡೇಟಾವನ್ನು ಅಳಿಸಿ<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">ಈ ಚಿತ್ರದ ಕುರಿತು ಕೇಳಿ</translation>
<translation id="9172499982238113829">Browther ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಆಗಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="3313826726620159669">ಸಾಧ್ಯವಾದಾಗ, Browther ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡುತ್ತದೆ</translation>
<translation id="3317928686912559532"><ph name="USER_EMAIL_ADDRESS"/> ನಂತೆ Browther ಅನ್ನು ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿರುವಿರಿ. ದಯವಿಟ್ಟು ಮತ್ತೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಅದೇ ಖಾತೆಯನ್ನು ಬಳಸಿ.</translation>
<translation id="6007009085341946457">ಇದು Browther ನ ದ್ವಿತೀಯ ಸ್ಥಾಪನೆಯಾಗಿದೆ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="8004582292198964060">ಬ್ರೌಸರ್</translation>
<translation id="8010081455002666927">ಸ್ವಯಂ ಪತ್ತೆಮಾಡುವಿಕೆ</translation>
<translation id="174885789898161653">Browther ಒಮ್ಮೆ ಪ್ರವೇಶವನ್ನು ಪಡೆದ ಬಳಿಕ, ಪ್ರವೇಶಕ್ಕಾಗಿ ನಿಮ್ಮನ್ನು ಕೇಳಲು ವೆಬ್‍ಸೈಟ್‍ಗಳಿಗೆ ಸಾಧ್ಯವಾಗುತ್ತದೆ.</translation>
<translation id="3001754454174546602">ಯಾವುದೇ ಸಮಯದಲ್ಲಿ ತ್ವರಿತವಾಗಿ ಪಡೆಯಲು Browther ಅನ್ನು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="80471789339884597">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME"/> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನಿಮ್ಮ ಎಲ್ಲಾ ಬ್ರೌಸರ್ ಅನ್ನು ಮರು ಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="8054112667659782652">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್‌ನ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಯಾವಾಗಲೂ ತೋರಿಸಿ</translation>
<translation id="6993312779622863465">ಆ್ಯಪ್‌ಗಳಿಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ Browther ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="80790299200510644">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ</translation>
<translation id="8086881907087796310">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್ ಕನಿಷ್ಠ ಹಾರ್ಡ್‌ವೇರ್ ಅಗತ್ಯತೆಗಳನ್ನು ಪೂರೈಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="4734875482699037091"><ph name="PAGE_TITLE"/> - Browther for Testing</translation>
<translation id="543407324609820492">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Browther ಗೆ ಸ್ಥಳ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="1767887552863788514">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ ನೀವು Browther ಅನ್ನು ತೆರೆದಾಗ, ದರ ಟ್ರ್ಯಾಕಿಂಗ್ ಅಲರ್ಟ್‌ಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="8118331347066725040">Lens ಬಳಸಿಕೊಂಡು ಹುಡುಕಲು ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="5334309298019785904">ನಿಮ್ಮ ಡೊಮೇನ್‌ನಲ್ಲಿ ಸಿಂಕ್ ಮಾಡುವ ಸೌಲಭ್ಯವಿಲ್ಲದ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ.</translation>
<translation id="813913629614996137">ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="4879101934056397619">Browther ಹೆಚ್ಚುವರಿ ಸೇವಾ ನಿಯಮಗಳು</translation>
<translation id="4505690237431768764">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿದೆ, ಹೀಗಾಗಿ Browther ಇದನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ.</translation>
<translation id="8177472873527554730">ಪುಟದಲ್ಲಿ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಹುಡುಕಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ</translation>
<translation id="4720341280133158605">ನಿಮ್ಮ ಖಾತೆ <ph name="USER_EMAIL"/> ನಲ್ಲಿ Browther ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ</translation>
<translation id="8221491193165283816">ನೀವು ಸಾಮಾನ್ಯವಾಗಿ ಅಧಿಸೂಚನೆಗಳನ್ನು ನಿರ್ಬಂಧಿಸುತ್ತೀರಿ. ನಿಮಗೆ ಸೂಚನೆ ನೀಡಲು ಈ ಸೈಟ್‌ಗೆ ಅನುಮತಿಸುವುದಕ್ಕಾಗಿ, ಇಲ್ಲಿ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="1083711467946065278">ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಲು, <ph name="BEGIN_LINK"/>ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> Browther ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="6569785137733211804">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಎಲ್ಲಿಂದ ಬರುತ್ತದೆ ಎಂಬುದನ್ನು ದೃಢೀಕರಿಸಲು Browther ಗೆ ಸಾಧ್ಯವಿಲ್ಲ ಮತ್ತು ಇದು ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದು. Browther ನಿಂದ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="1122818205373648656">ಚಿತ್ರದಲ್ಲಿ ಉಪಯುಕ್ತ ವಿವರಣೆಯು ಇಲ್ಲದಿದ್ದರೆ, Browther ನಿಮಗಾಗಿ ಒಂದು ವಿವರಣೆಯನ್ನು ಒದಗಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತದೆ. ವಿವರಣೆಗಳನ್ನು ರಚಿಸಲು, ಚಿತ್ರಗಳನ್ನು Browther ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಇದನ್ನು ನೀವು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಯಾವಾಗ ಬೇಕಾದರೂ ಆಫ್ ಮಾಡಬಹುದು.</translation>
<translation id="6877990294324319801">ಹೊಸ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ Browther ಗೆ ಸೈನ್‌ ಇನ್‌ ಮಾಡಬೇಕೆ?</translation>
<translation id="6478811748813986578">ಸುರಕ್ಷಿತವಲ್ಲದ ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ಕುರಿತು <ph name="BEGIN_LINK"/>Browther ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ<ph name="END_LINK"/></translation>
<translation id="1685486387921540822">ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡಿಲ್ಲ. <ph name="PERMISSION"/> ಅನ್ನು Browther ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="8921153410460268589">Browther iOS ಆ್ಯಪ್ ಮೂಲಕ, ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಬಳಸಿಕೊಂಡು ನಿಮ್ಮ ಕಣ್ಣಿಗೆ ಬೀಳುವ ವಸ್ತುಗಳನ್ನು ಶಾಪಿಂಗ್ ಮಾಡಿ, ಪಠ್ಯಗಳನ್ನು ಅನುವಾದಿಸಿ ಹಾಗೂ ಸುತ್ತಮುತ್ತಲಿನ ವಿಷಯಗಳನ್ನು ಗುರುತಿಸಿ</translation>
<translation id="8313851650939857356">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">Browther ಅನ್ನು <ph name="TIMEOUT_DURATION"/> ಅವಧಿಯವರೆಗೆ ಬಳಸದಿದ್ದರೆ ನಿಮ್ಮ ಸಂಸ್ಥೆ ಅದನ್ನು ಮುಚ್ಚುತ್ತದೆ.</translation>
<translation id="8321888067342493336">ಚಿತ್ರದ ರೂಪದಲ್ಲಿ ಸೇವ್ ಮಾಡಿ</translation>
<translation id="143016831128278157">ನಿಮ್ಮ ಸಾಧನಗಳಲ್ಲಿ Browther ಅನ್ನು ಸಿಂಕ್ ಮಾಡಲು ಮತ್ತು ವೈಯಕ್ತೀಕರಿಸಲು ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="4784945022248750283"><ph name="USER_EMAIL_ADDRESS"/> ಅವರು ಮೊದಲಿನಿಂದಲೆ Browther ಬಳಸುತ್ತಿದ್ದರು</translation>
<translation id="1288164710697017468">ನಿಮ್ಮ Browther ಖಾತೆ <ph name="ACCOUNT_EMAIL"/> ನಲ್ಲಿ Browther ಡೇಟಾ ಬಳಸುವುದನ್ನು ಮುಂದುವರಿಸಲು Browther ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಿ</translation>
<translation id="8648401677359150296">ಭವಿಷ್ಯದ Browther ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 8 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="8362914115861174987">ಈ ಭಾಷೆಗೆ ಅನುವಾದಿಸಿ</translation>
<translation id="8367705492654390392">ಏನನ್ನಾದರೂ ಕೇಳಿ</translation>
<translation id="5769022907892823357">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಉಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="4782442810031768771">ನಂತರ ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="8265348385714408341">ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಬೆಂಬಲಿತ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">ಈ ವಿಸ್ತರಣೆಯನ್ನು ಅದರ ಡೆವಲಪರ್‌ನಿಂದ ಪ್ರಕಟಣೆಯನ್ನು ರದ್ದುಮಾಡಿದೆ ಮತ್ತು ಸುರಕ್ಷಿತ ಆಗಿಲ್ಲದಿರಬಹುದು. Browther ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="1613655732912855341">ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Browther ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="9103715009358215214">{0,plural, =1{ಒಂದು ದಿನದ ಒಳಗೆ Browther ಮರುಪ್ರಾರಂಭಿಸಿ}one{# ದಿನಗಳ ಒಳಗೆ Browther ಮರುಪ್ರಾರಂಭಿಸಿ}other{# ದಿನಗಳ ಒಳಗೆ Browther ಮರುಪ್ರಾರಂಭಿಸಿ}}</translation>
<translation id="8438543370129609977">ನೀವು ಇಮೇಜ್‌ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ.<ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">Browther ನಲ್ಲಿ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟದ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ</translation>
<translation id="1401757916223057494">ಸ್ಥಾಪಕ ಆರ್ಕೈವ್ ದೋಷಪೂರಿತವಾಗಿದೆ ಅಥವಾ ಅಮಾನ್ಯವಾಗಿದೆ. ದಯವಿಟ್ಟು Browther ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="5029760494698649486">Browther ಗೆ Windows 10 ಅಥವಾ ಹೆಚ್ಚಿನ ಆವೃತ್ತಿಯ ಅಗತ್ಯವಿದೆ.</translation>
<translation id="7906734902028783072">ಐಚ್ಛಿಕ: ಡಯಗ್ನೊಸ್ಟಿಕ್ ಮತ್ತು ಬಳಕೆಯ ಡೇಟಾವನ್ನು Browther ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕಳುಹಿಸುವ ಮೂಲಕ ChromeOS ವೈಶಿಷ್ಟ್ಯಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="6791756730901393492">ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ Browther ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸಿ</translation>
<translation id="4879869745782826167">Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಪ್ರಾಂಪ್ಟ್ ಅನ್ನು ತೋರಿಸುತ್ತದೆ</translation>
<translation id="2967761098021401720">Browther ನ ಅವಧಿ ಮುಗಿದಿದೆ</translation>
<translation id="7674832651694000881">Browther ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಆಯ್ಕೆ ಮಾಡಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು!</translation>
<translation id="4507581730979762077">ನೀವು ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಿದಾಗ, Browther ಅವುಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು</translation>
<translation id="7205233182271132386">ಸಾರ್ವಜನಿಕ ಡೇಟಾ ಉಲ್ಲಂಘನೆಯಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳಲ್ಲಿ ಒಂದು Browther ಗೆ ಕಂಡುಬಂದರೆ ಎಚ್ಚರಿಕೆ ಪಡೆಯಿರಿ</translation>
<translation id="8555465886620020932">ಸೇವಾ ದೋಷ: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">ಸುಲಭ ಆ್ಯಕ್ಸೆಸ್‌ಗಾಗಿ ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಪಿನ್ ಮಾಡಬಹುದು; ಸೈಡ್ ಪ್ಯಾನಲ್‌ನ ಮೇಲ್ಭಾಗದಲ್ಲಿರುವ ಪಿನ್ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="856656450041460113">ಭಾಷೆಯ ಪಟ್ಟಿಯನ್ನು ಹುಡುಕಿ</translation>
<translation id="75470458211269379">ನೀವು Browther ಖಾತೆಯ ಮೂಲಕ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, Browther ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಬಲ್ಲದು</translation>
<translation id="2108930010779660436">ಬಹು ಸಂಸ್ಥೆಗಳು Browther ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತವೆ</translation>
<translation id="7209630341463003999">ಹಕ್ಕುಸ್ವಾಮ್ಯ <ph name="YEAR"/> Browther ಲೇಖಕರು. ಎಲ್ಲಾ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.</translation>
<translation id="8601359445272098721">ಹೊಸತು! "ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಅನುವಾದಿಸಿ" ಎಂಬ ಬಟನ್‌ ಅನ್ನು ಆಯ್ಕೆ ಮಾಡುವ ಮೂಲಕ ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ನಲ್ಲಿ ನೀವು ಪಠ್ಯ ಮತ್ತು ಚಿತ್ರಗಳನ್ನು ಅನುವಾದಿಸಬಹುದು</translation>
<translation id="782928371899183269">Browther ಅನ್ನು ಪ್ರಾರಂಭಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="8624541899164515475">ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ.</translation>
<translation id="5879341334716115002">Browther for Testing ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="2433912322225810055">ನೀವು Browther ಪ್ರಾರಂಭಿಸಿದಾಗ ಅಥವಾ ಓಮ್ನಿಬಾಕ್ಸ್‌ನಿಂದ ಹುಡುಕಿದಾಗ ತೋರಿಸಬೇಕಾದ ಪುಟವನ್ನು ಕೂಡಾ ಇದು ನಿಯಂತ್ರಿಸುತ್ತದೆ.</translation>
<translation id="4816541973978692496">ಇದು ನಿಮ್ಮ Browther</translation>
<translation id="8712637175834984815">ಅರ್ಥವಾಯಿತು</translation>
<translation id="9037464035997618895">Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="7897185368811431919">ಎಲ್ಲವನ್ನೂ Browther ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="8747073452963259673">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಕೆಳಗಿನ ಎಡ ಮೂಲೆ: ಎಡಕ್ಕೆ <ph name="LEFT"/>%, ಕೆಳಕ್ಕೆ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ನಿಮ್ಮ ನೆಟ್‌ವರ್ಕ್ ನಿರ್ವಾಹಕರು ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ತಡೆಯುವ ಗುಂಪು ನೀತಿಯನ್ನು ಅನ್ವಯಿಸಿದ್ದಾರೆ: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">ಈ ಸೈಟ್‌ಗಾಗಿ ನಿಮ್ಮ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೊಫೋನ್‌ಗೆ ಪ್ರವೇಶಿಸಲು Browther ಗೆ ಅನುಮತಿಯ ಅಗತ್ಯವಿದೆ</translation>
<translation id="8813277370772331957">ನಂತರ ನನಗೆ ಜ್ಞಾಪಿಸಿ</translation>
<translation id="6831999464349484462">Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="3698151322107951111">Browther ಅನ್ನು ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿ ಮಾಡಿ ಮತ್ತು ಟಾಸ್ಕ್‌ಬಾರ್‌ಗೆ ಪಿನ್ ಮಾಡಿ</translation>
<translation id="8826492472752484139">“Password Manager” ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="6933858244219479645">ChromeOS ಸಿಸ್ಟಂ</translation>
<translation id="3986927308621489499">Browther ನಲ್ಲಿ ಮೆನುಗಳು, ಸೆಟ್ಟಿಂಗ್‌ಗಳು, ಎಚ್ಚರಿಕೆಗಳು ಮತ್ತು ಇತರ ಪಠ್ಯವನ್ನು ಪ್ರದರ್ಶಿಸಲು ಈ ಭಾಷೆಯನ್ನು ಬಳಸಲಾಗುತ್ತದೆ</translation>
<translation id="8862326446509486874">ಸಿಸ್ಟಂ ಮಟ್ಟದ ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನೀವು ಸರಿಯಾದ ಹಕ್ಕುಗಳನ್ನು ಹೊಂದಿಲ್ಲ. ನಿರ್ವಾಹಕರಂತೆ ಮತ್ತೆ ಇನ್‌ಸ್ಟಾಲರ್ ಅನ್ನು ರನ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5318226144018267261">Browther ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="1298790608554316415">ಹಾಗಿದ್ದರೆ, Browther ನಲ್ಲಿ ನಿಮ್ಮ ಸೇವ್ ಮಾಡಿದ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಎಡಿಟ್ ಮಾಡಿ, ಇದರಿಂದಾಗಿ ಅದು ನಿಮ್ಮ ಹೊಸ ಪಾಸ್‌ವರ್ಡ್‌ಗೆ ಹೊಂದಾಣಿಕೆಯಾಗುತ್ತದೆ.</translation>
<translation id="960933321883777733">ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆಗೆ ಅಗತ್ಯವಿದೆ</translation>
<translation id="948979409756947611">Browther ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪ್ರದರ್ಶಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="1418854271943945136">Browther ಇನ್ನು ಮುಂದೆ ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿರುವುದಿಲ್ಲ. Browther ಅನ್ನು ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಮಾಡಬೇಕೆ?</translation>
<translation id="7228667329366610727">Browther ಅನ್ನು ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ</translation>
<translation id="4817697255467736794">Browther Enterprise ಲೋಗೋ</translation>
<translation id="3507731466523097529">ನಿಮ್ಮ ಪ್ರೊಫೈಲ್ ಅನ್ನು ತೆರೆಯುವಾಗ ಏನೋ ತಪ್ಪಾಗಿರುವ ಕಾರಣ Browther ಅನ್ನು ಪ್ರಾರಂಭಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ. Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಲು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="3234473600657230663">Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="8953887022581653484">Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಏಕೆಂದರೆ ಆರ್ಕೈವ್ ಫೈಲ್ ಮಾಲ್‌ವೇರ್ ಅನ್ನು ಮರೆಮಾಡಬಹುದಾದ ಇತರ ಫೈಲ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿದೆ</translation>
<translation id="532304972436358335">ನೀವು ಇತರ Browther ಸೇವೆಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3425998261052065067">Browther ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಚ್ಚಲಾಗಿದೆ</translation>
<translation id="4377377022617011492">Browther ನ ಅವಧಿ ಮುಗಿದಿದೆ</translation>
<translation id="3247296757162889864">{0,plural, =1{ಒಂದು ಗಂಟೆಯಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}one{# ಗಂಟೆಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}other{# ಗಂಟೆಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ}}</translation>
<translation id="9106236359747881194">ಹುಡುಕಲು ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="5115014198092384730">ಭವಿಷ್ಯದ Browther ಅಪ್‌ಡೇಟ್‌ಗಳನ್ನು ಪಡೆಯಲು, ನೀವು Windows 10 ಅಥವಾ ಅದರ ನಂತರದ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರಬೇಕಾಗುತ್ತದೆ. ಈ ಕಂಪ್ಯೂಟರ್ ಪ್ರಸ್ತುತ Windows 8.1 ಅನ್ನು ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="7129101984664345614">ಹೊಸ Browther &amp;ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="911206726377975832">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಸಹ ಅಳಿಸುವುದೇ?</translation>
<translation id="9134482777260927479">ಹೋಮ್‌ವರ್ಕ್ ಸಹಾಯ</translation>
<translation id="9148058034647219655">ನಿರ್ಗಮಿಸಿ</translation>
<translation id="1734388504720121468">ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಮುಂದುವರಿಸಿ: ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗಲೆಲ್ಲಾ Browther ನಿಮ್ಮ ಟ್ಯಾಬ್‌ಗಳನ್ನು ಮರುಸ್ಥಾಪಿಸಬಹುದು. ಇದನ್ನು ಆನ್ ಮಾಡಲು, ಇಲ್ಲಿಗೆ ಹೋಗಿ</translation>
<translation id="8633974232736772207"><ph name="TARGET_URL_HOSTNAME"/> ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು ಒಂದು ಪರ್ಯಾಯ ಬ್ರೌಸರ್ ತೆರೆಯುವಂತೆ ನಿಮ್ಮ ಸಿಸ್ಟಂ ನಿರ್ವಾಹಕರು Browther ಅನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿದ್ದಾರೆ.</translation>
<translation id="1122669402846843682">Browther ಸಲಹೆ: Lens ಮೂಲಕ ಹುಡುಕಿ</translation>
<translation id="595330134356385835">&amp;Browther ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="4659389438500978709">Browther (mDNS-In)</translation>
<translation id="6491100124044190139">ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="1665840797775025867">ನಿಮ್ಮ ಸ್ವಂತ Browther ಅನ್ನು ರಚಿಸಿ</translation>
<translation id="4407047432656809023">Windows XP ಅಥವಾ Windows Vista ದಲ್ಲಿ Browther ಗೆ ಈಗ ಬೆಂಬಲವಿಲ್ಲದೇ ಇರುವುದರಿಂದ ಅದು ಸರಿಯಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು</translation>
<translation id="945522503751344254">ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಕಳುಹಿಸಿ</translation>
<translation id="7620348044248809366">Browther ಅನ್ನು ಯಾರು ಬಳಸುತ್ತಿದ್ದಾರೆ?</translation>
<translation id="7299962884342109067">Browther ನ ಪ್ರಬಲ ಭದ್ರತೆಯನ್ನು ಪಡೆಯಿರಿ</translation>
<translation id="983803489796659991">ಅಪ್‌ಡೇಟ್ ಸರ್ವರ್, ಅಪ್ಲಿಕೇಶನ್‌ಗಾಗಿ ಯಾವುದೇ ಹ್ಯಾಶ್ ಡೇಟಾವನ್ನು ಹೊಂದಿಲ್ಲದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="8775461190334353148">Browther ಅನ್ನು ಖಾತೆಯಿಲ್ಲದೆಯೇ ಬಳಸಿ</translation>
<translation id="7146761239544860058">Browther ಲೇಖಕರು</translation>
<translation id="989970834842471429">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಬಳಸಿ ಹುಡುಕಲು ಯಾವುದೇ ಪಠ್ಯ ಅಥವಾ ಚಿತ್ರವನ್ನು ಆಯ್ಕೆ ಮಾಡಿ</translation>
<translation id="6616551030373607751">ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಬಳಸಲು, <ph name="BEGIN_LINK"/>ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ<ph name="END_LINK"/> Browther ಆ್ಯಕ್ಸೆಸ್‌ ಅನ್ನು ನೀಡಿ</translation>
<translation id="137466361146087520">Google Chrome ಬೀಟಾ</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">ಅನಿರ್ದಿಷ್ಟ ದೋಷದಿಂದಾಗಿ ಸ್ಥಾಪನೆ ವಿಫಲವಾಗಿದೆ. ದಯವಿಟ್ಟು ಮತ್ತೊಮ್ಮೆ Browther ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="9074842261125908635">ಅಜ್ಞಾತ ಮೂಲಗಳಿಂದ ವಿಸ್ತರಣೆಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ಥೀಮ್‌ಗಳು ನಿಮ್ಮ ಸಾಧನವನ್ನು ಹಾನಿಗೊಳಿಸಬಹುದು. <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>ನಿಂದ ಮಾತ್ರ ಅವುಗಳನ್ನು ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ</translation>
<translation id="3593119910409528681">ಈ ವಿಸ್ತರಣೆಯು ವೆಬ್ ಸ್ಟೋರ್ ನೀತಿಯನ್ನು ಉಲ್ಲಂಘಿಸುತ್ತಿರುವುದರಿಂದ ಅಸುರಕ್ಷಿತವಾಗಿರಬಹುದು. Braveನಿಂದ ಅದನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಸೇರಿದಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್ ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ನೋಡಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ.</translation>
<translation id="5245976396374147971">ಎಚ್ಚರಿಕೆ: ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್‌ ಇತಿಹಾಸದಲ್ಲಿ ರೆಕಾರ್ಡಿಂಗ್‌ನಿಂದ ವಿಸ್ತರಣೆಗಳನ್ನು ತಡೆಯುವುದಿಲ್ಲ. ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿ ವಿಸ್ತರಣೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು ಈ ಆಯ್ಕೆಯನ್ನು ಆರಿಸಬೇಡಿ.</translation>
<translation id="3629539416935660172">Browther  ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ನಲ್ಲಿ ನಾವು ಪಟ್ಟಿ ಮಾಡಲಾದ ಕೆಲವು ವಿಸ್ತರಣೆಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಿರಬಹುದು.</translation>
<translation id="157534302749986451">Browther ಅನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸಲು, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ನಲ್ಲಿ ಪಟ್ಟಿ ಮಾಡದಿರುವ ಕೆಳಗಿನ ವಿಸ್ತರಣೆಯನ್ನು ನಾವು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದ್ದೇವೆ ಮತ್ತು ಇದು ನಿಮ್ಮ ಗಮನಕ್ಕೆ ಬಾರದೇ ಸೇರಿಸಲಾಗಿರಬಹುದು.</translation>
<translation id="3031052147361385845">Browther ಅ&amp;ದೃಶ್ಯ ವಿಂಡೋದಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="5556794247782664281">Browther ಅ&amp;ದೃಶ್ಯ ವಿಂಡೋದಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{Browther ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ.}=1{Browther ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{Browther ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{Browther ಗಾಗಿ ಹೊಸತೊಂದು ಅಪ್‌ಡೇಟ್ ಲಭ್ಯವಿದೆ ಮತ್ತು ನೀವು ಮರುಪ್ರಾರಂಭಿಸಿದ ಕೂಡಲೇ ಅದನ್ನು ಅನ್ವಯಿಸಲಾಗುತ್ತದೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ}=1{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಈ ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ವಿನಂತಿಸಿಕೊಂಡಿದ್ದಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ}=1{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ ಅಜ್ಞಾತ ವಿಂಡೋವನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}one{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}other{ಅಪ್‌ಡೇಟ್‌ ಅನ್ವಯಿಸಲು ನೀವು Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕೆಂದು ನಿಮ್ಮ ನಿರ್ವಾಹಕರು ಬಯಸುತ್ತಾರೆ. ನಿಮ್ಮ # ಅಜ್ಞಾತ ವಿಂಡೋಗಳನ್ನು ತೆರೆಯಲಾಗುವುದಿಲ್ಲ.}}</translation>
<translation id="8762228142105311329">{COUNT, plural, =0 {ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು Browther ಅನ್ನು ಪುನರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ Advanced Protection ಗೆ} =1 {ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು Browther ಅನ್ನು ಪುನರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ Advanced Protection ಗೆ. ನಿಮ್ಮ ಖಾಸಗಿ ವಿಂಡೋ ಪುನರಾರಂಭವಾಗಲ್ಲ.} other {ಅಪ್‌ಡೇಟ್ ಅನ್ನು ಅನ್ವಯಿಸಲು Browther ಅನ್ನು ಪುನರಾರಂಭಿಸುವ ಅಗತ್ಯವಿದೆ Advanced Protection ಗೆ. ನಿಮ್ಮ # ಖಾಸಗಿ ವಿಂಡೋಗಳು ಪುನರಾರಂಭವಾಗಲ್ಲ.}}</translation>
<translation id="5749154344207139683">ಈ 1 ನಿಮಿಷದ ಸಮೀಕ್ಷೆಯಲ್ಲಿ ಭಾಗವಹಿಸುವ ಮೂಲಕ ಖಾಸಗಿಯನ್ನು ಸುಧಾರಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡಿ.</translation>
<translation id="6954203250660846933">ನೀವು ವಿಳಾಸ ಬಾರ್ ಅಥವಾ ಹುಡುಕಾಟ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಉತ್ತಮ ಸಲಹೆಗಳನ್ನು ಪಡೆಯುವುದಕ್ಕಾಗಿ ನೀವು ಟೈಪ್ ಮಾಡುವುದನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಹುಡುಕಾಟ ಇಂಜಿನ್‌ಗೆ Browther ಕಳುಹಿಸುತ್ತದೆ. ಇದು ಖಾಸಗಿ ಎಂಬಲ್ಲಿ ಆಫ್ ಆಗಿದೆ.</translation>
<translation id="3542179014707218534">Browther ಖಾಸಗಿ</translation>
<translation id="2076355018722231995">ಖಾಸಗಿ ಮೋಡ್‌ನಲ್ಲಿ ಬ್ರೌಸಿಂಗ್ ಮಾಡುವಾಗ, ಅಸುರಕ್ಷಿತ ಸಂಪರ್ಕವನ್ನು ಬಳಸಿಕೊಂಡು ಸೈಟ್ ಅನ್ನು ಲೋಡ್ ಮಾಡುವುದಕ್ಕೂ ಮೊದಲು Browther ನಿಮ್ಮನ್ನು ಎಚ್ಚರಿಸುತ್ತದೆ</translation>
</translationbundle>