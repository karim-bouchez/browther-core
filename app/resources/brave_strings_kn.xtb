<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="1026101648481255140">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ಪುನರಾರಂಭಿಸಿ</translation>
<translation id="7099479769133613710">&amp;ChromeOS ಅಪ್‌ಡೇಟ್ ಮಾಡಲು ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="7264054672589027446">ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಲು Browther ನಿಮಗೆ ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ</translation>
<translation id="7848219163187166649">ತಮ್ಮ ಪುಟದಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ಖಾಸಗಿಯಾಗಿ ಪ್ರಿಲೋಡ್ ಮಾಡಲು ಸೈಟ್ ಕೇಳಿದಾಗ, Browther, Browther ಸರ್ವರ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಇದು ಪ್ರಿಲೋಡ್ ಮಾಡಿದ ಸೈಟ್‌ನಿಂದ ನಿಮ್ಮ ಗುರುತನ್ನು ಮರೆಮಾಡುತ್ತದೆ, ಆದರೆ ಯಾವ ಸೈಟ್‌ಗಳು ಪ್ರಿಲೋಡ್ ಆಗುತ್ತವೆ ಎಂಬುದನ್ನು Browther ತಿಳಿಯುತ್ತದೆ.</translation>
<translation id="1065672644894730302">ನಿಮ್ಮ ಪ್ರಾಶಸ್ತ್ಯಗಳನ್ನು ರೀಡ್‌ ಮಾಡಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ಅಲ್ಲದೇ, ಕೆಲವು ವೈಶಿಷ್ಟ್ಯಗಳು ಲಭ್ಯವಿಲ್ಲದಿರಬಹುದು ಮತ್ತು ಪ್ರಾಶಸ್ತ್ಯಗಳಲ್ಲಿ ಮಾಡಿದ ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಲಾಗುವುದಿಲ್ಲ.</translation>
<translation id="8837164267124113709">ನಿಮ್ಮ ಪೋಷಕರು Browther ನಲ್ಲಿ "ಸೈಟ್‌ಗಳು, ಆ್ಯಪ್‌ಗಳು ಮತ್ತು ವಿಸ್ತರಣೆಗಳಿಗಾಗಿ ಅನುಮತಿಗಳನ್ನು" ಆಫ್ ಮಾಡಿದ್ದಾರೆ</translation>
<translation id="881513728707488138">Browther ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ರಫ್ತು ಮಾಡಲು ಬಯಸುತ್ತದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="112640046208448578">ವಸ್ತುಗಳನ್ನು ಅಥವಾ ಸ್ಥಳಗಳನ್ನು ಗುರುತಿಸಿ ಮತ್ತು ಪಠ್ಯವನ್ನು ಕಾಪಿ ಮಾಡಿ ಅಥವಾ ಅನುವಾದಿಸಿ. ನೀವು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಬಳಸಿದಾಗ, ಪುಟದ ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ ಅನ್ನು ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿದೆ.</translation>
<translation id="6580138787163923852">ನಿಮ್ಮ ಇತರ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಡೇಟಾ ಉಲ್ಲಂಘನೆ ಮತ್ತು ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳಿಂದ ಸುರಕ್ಷಿತವಾಗಿವೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲು, <ph name="BEGIN_LINK"/>Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther ಮೆನು ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="1157985233335035034">ಇತ್ತೀಚಿನ ಭಾಷೆಗಳು</translation>
<translation id="3673786631598474384">Browther ಕಾರ್ಯನಿರ್ವಹಿಸುವ ವಿಧಾನವನ್ನು ಬದಲಿಸಬಹುದಾದ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಒಂದನ್ನು <ph name="PARTNER_NAME"/> ಸೇರಿಸಿದೆ.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">ನಿಮ್ಮ Windows ಆವೃತ್ತಿಯನ್ನು ಬೆಂಬಲಿಸದ ಕಾರಣ ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="8291401179516272335">Browther ಕುರಿತು</translation>
<translation id="1203500561924088507">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. <ph name="BUNDLE_NAME"/> ಅನ್ನು ಬಳಸುವ ಮೊದಲು ನೀವು ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕು.</translation>
<translation id="1232234696885483911">ನೀವು ಇಮೇಜ್‌ ಹುಡುಕಾಟವನ್ನು ತೆರೆದಾಗ, PDF ಗಳನ್ನು ಒಳಗೊಂಡಂತೆ ಪುಟದ ಶೀರ್ಷಿಕೆ, URL ಮತ್ತು ಕಂಟೆಂಟ್‌ ಅನ್ನು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸರ್ವರ್‌ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">ನೀವು ಸೈನ್ ಇನ್ ಆಗಿರುವಾಗ, Browther ನಲ್ಲಿ ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿನ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಹಾಗೂ ಇನ್ನಷ್ಟನ್ನು ನೀವು ಬಳಸಬಹುದು. ಇದನ್ನು ಬದಲಾಯಿಸಲು, "Browther ನಲ್ಲಿ ನಿಮ್ಮ ಖಾತೆ" ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ.</translation>
<translation id="9034321258761608912">ಈ ಟ್ಯಾಬ್ ನಿಷ್ಕ್ರಿಯವಾಗಿದ್ದಾಗ, Browther ವೇಗವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸಲು ಮೆಮೊರಿಯನ್ನು ಮುಕ್ತಗೊಳಿಸಿದೆ. ಈ ಸೈಟ್ ಅನ್ನು ನಿಷ್ಕ್ರಿಯವಾಗಿರದಂತೆ ಎಲ್ಲಾ ಸಮಯದಲ್ಲೂ ಹೊರಗಿಡಲು ನೀವು ಆಯ್ಕೆ ಮಾಡಬಹುದು.</translation>
<translation id="249571811018731941">ಈ ಫೈಲ್ ಅಪಾಯಕಾರಿಯಾಗಿರುವ ಕಾರಣ Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> ಬಳಸಿಕೊಂಡು Gmail ಅಥವಾ YouTube ನಂತಹ Browther ಸೇವೆಗಳಿಗೆ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದರೆ, ನೀವು ಅದೇ ಖಾತೆಯೊಂದಿಗೆ Browther ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="1290883685122687410">ಸೆಟಪ್ ದೋಷ: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">ನಿಮ್ಮ ಹೊಸ Browther ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="4437862975743821367">ಬ್ಲೂಟೂತ್ ಸಾಧನಗಳನ್ನು
ಎಕ್ಸ್‌ಪ್ಲೋರ್ ಮಾಡಲು Browther ಗೆ ಬ್ಲೂಟೂತ್ ಆ್ಯಕ್ಸೆಸ್‌ನ ಅಗತ್ಯವಿದೆ. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">ಭಾಷೆಯನ್ನು ಪತ್ತೆ ಮಾಡಿ</translation>
<translation id="1206925267243987362">Browther ಶಿಫಾರಸು ಮಾಡಿದ ಬ್ರೌಸರ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="8270483548049772782">Browther (<ph name="URL"/>) ನಿಂದ ಡೇಟಾವನ್ನು ಸಹ ಅಳಿಸಿ</translation>
<translation id="1345251407431278948">ಪಿನ್ ಮಾಡಲಾಗಿದೆ! ಟೂಲ್‌ಬಾರ್‌ನಲ್ಲಿರುವ ಹೊಸ ಬಟನ್‌ನಿಂದ ನೀವು ಮತ್ತೊಮ್ಮೆ ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಬಹುದು</translation>
<translation id="1356661055722410047">ಹೊಸತು! ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಮೇಲೆ ನೀವು ಪಠ್ಯ ಮತ್ತು ಚಿತ್ರಗಳೆರಡನ್ನೂ ಅನುವಾದಿಸಬಹುದು</translation>
<translation id="1383876407941801731">ಹುಡುಕಿ</translation>
<translation id="1592588950737518481">&amp;Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="1404026649028693342">ಯಾವಾಗಲೂ AI ಮೋಡ್ ಅನ್ನು ತೋರಿಸಿ</translation>
<translation id="141901961143729572">ನಿಮ್ಮ ವಿಚಾರಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="1743952081001089298">ನಿಮ್ಮ ವಿಂಡೋ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Browther ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ.</translation>
<translation id="8627385813382688019">Browther for Testing ನ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="1497802159252041924">ಇನ್‌ಸ್ಟಾಲ್ ದೋಷ: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ಈ ಪುಟವನ್ನು ರಕ್ಷಿಸಲಾಗಿದೆ</translation>
<translation id="7252430412915798987">Browther ಟ್ಯಾಬ್ ಹಂಚಿಕೊಳ್ಳಿ</translation>
<translation id="6388429281015199562">Browther ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="1547469039832541117">ಹೈಲೈಟ್ ಮಾಡಿದ ಕಾರ್ಯವನ್ನು ಕೊನೆಗೊಳಿಸುತ್ತದೆ.</translation>
<translation id="1801944307203212016">ನಿಮ್ಮ ಸುತ್ತಮುತ್ತಲಿನ ಪರಿಸರದ 3D ನಕ್ಷೆಯನ್ನು ರಚಿಸುವುದಕ್ಕಾಗಿ ನಿಮ್ಮ ಕ್ಯಾಮರಾವನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲು Browther ಗೆ ಅನುಮತಿ ಬೇಕಾಗಿದೆ</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಇನ್ನು ಮುಂದೆ ಬೆಂಬಲಿಸುವುದಿಲ್ಲ. ನೀವು ಅದನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.}one{ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಇನ್ನು ಮುಂದೆ ಬೆಂಬಲಿಸುವುದಿಲ್ಲ. ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.}other{ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳು ಇನ್ನು ಮುಂದೆ ಬೆಂಬಲಿಸುವುದಿಲ್ಲ. ನೀವು ಅವುಗಳನ್ನು ತೆಗೆದುಹಾಕುವಂತೆ Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ.}}</translation>
<translation id="4667068923142532753">Browther ಅನ್ನು ಪಿನ್ ಮಾಡಿ</translation>
<translation id="3006560544901646947">Browther ನ ಸುರಕ್ಷತೆ ಟೂಲ್‌ಗಳು</translation>
<translation id="686052171138185761">Browther ನಿಮ್ಮ Password Manager ಡೇಟಾವನ್ನು ಅಳಿಸಲು ಬಯಸುತ್ತದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="8713026329083542796">Browther ನಲ್ಲಿ ಪ್ರಮುಖ ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತಾ ನಿಯಂತ್ರಣಗಳನ್ನು ಪರಿಶೀಲಿಸಿ</translation>
<translation id="1640672724030957280">ಡೌನ್‌ಲೋಡ್ ಆಗುತ್ತಿದೆ...</translation>
<translation id="1680687534629375545">ಈ ಪುಟದ ಕುರಿತು ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟವನ್ನು ಕೇಳಿ</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> ಗಾಗಿ ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಅನ್ನು ಒದಗಿಸುತ್ತದೆ.</translation>
<translation id="4243382967656566037">ಈ ಫೀಚರ್‌ಗಳನ್ನು ಸುಧಾರಿಸುವುದಕ್ಕೆ ಸಹಾಯ ಮಾಡಲು, Browther ಜೊತೆಗಿನ ನಿಮ್ಮ ಸಂವಾದಗಳನ್ನು Browther ಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಈ ಡೇಟಾವನ್ನು ಮಾನವ ರಿವ್ಯೂವರ್‌ಗಳು ಓದಬಹುದು, ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಬಹುದು ಮತ್ತು ಟಿಪ್ಪಣಿ ಮಾಡಬಹುದು.</translation>
<translation id="1722488837206509557">ಲಭ್ಯವಿರುವ ಸಾಧನಗಳಿಂದ ಆಯ್ಕೆ ಮಾಡಲು ಮತ್ತು ಅವುಗಳಲ್ಲಿ ಕಂಟೆಂಟ್‌ ಅನ್ನು ಪ್ರದರ್ಶಿಸಲು ಇದು ನಿಮಗೆ ಅನುಮತಿಸುತ್ತದೆ.</translation>
<translation id="6820510278633522408">Browther ಶೀಘ್ರದಲ್ಲೇ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ</translation>
<translation id="7775028004939172516">ನ್ಯಾವಿಗೇಶನ್‌ಗಳನ್ನು HTTPS ಗೆ ಅಪ್‌ಗ್ರೇಡ್ ಮಾಡಲು Browther ಪ್ರಯತ್ನಿಸುತ್ತದೆ</translation>
<translation id="6963959729951758069">Browther ಡೇಟಾ ತೆರವುಗೊಳಿಸಲಾಗಿದೆ</translation>
<translation id="4085139922884095932"><ph name="REMAINING_TIME"/> ಸೆಕೆಂಡ್‌ಗಳಲ್ಲಿ Browther ಮರುಪ್ರಾರಂಭಗೊಳ್ಳುತ್ತದೆ</translation>
<translation id="2586248102295515296">HTTPS ಲಭ್ಯವಿಲ್ಲದಿದ್ದಾಗ, Browther ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡದೆ ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತದೆ</translation>
<translation id="3975328336074677101">Browther ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಚಾಲನೆಗೊಳ್ಳಲು ಅನುಮತಿಸಿ</translation>
<translation id="2497443204974841650">Browther ಅನ್ನು ಮರುಸ್ಥಾಪಿಸು</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> ಅನ್ನು ಮಾಡಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ</translation>
<translation id="4553225588627299783">ಮುಂದಿನ ಬಾರಿ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ನಲ್ಲಿ ನೀವು Browther ಅನ್ನು ತೆರೆದಾಗ, Browther Password Manager ಅನ್ನು ಬಳಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="1838374766361614909">ಹುಡುಕಾಟ ತೆರವುಗೊಳಿಸಿ</translation>
<translation id="2337233040802538155">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು Browther ಖಾತೆಯಲ್ಲಿ ಇರಿಸಿಕೊಂಡು, ಅದನ್ನು ಈ ಸಾಧನದಿಂದ ಮಾತ್ರ ಅಳಿಸಲು, <ph name="BEGIN_LINK"/>Browther ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗ ಹೊಸ ಟ್ಯಾಬ್ ಗುಂಪುಗಳನ್ನು ತೆರೆಯಲು ಅಥವಾ ರಚಿಸಲು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ Browther ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="2063443520349987970">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ Browther ಖಾತೆಗಳನ್ನು ನೀವು ನಿರ್ವಹಿಸಬಹುದು. ನಿಮ್ಮ Browther ಖಾತೆಗಳನ್ನು Browther ಬ್ರೌಸರ್, Play Store ‌‌, Gmail ಹಾಗೂ ಮುಂತಾದವುಗಳಲ್ಲಿ ಬಳಸಲಾಗುತ್ತದೆ. ಕುಟುಂಬದ ಸದಸ್ಯರಂತಹ ಬೇರೊಬ್ಬರಿಗೆ ನೀವು ಖಾತೆಯನ್ನು ಸೇರಿಸಲು ಬಯಸಿದರೆ, ಬದಲಿಗೆ ನಿಮ್ಮ <ph name="DEVICE_TYPE"/> ಗೆ ಹೊಸ ವ್ಯಕ್ತಿಯನ್ನು ಸೇರಿಸಿ. <ph name="LINK_BEGIN"/>ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಿ</translation>
<translation id="1880677175115548835">ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="3183933389992069620">ನೀವು ನಿರ್ವಹಿಸಲಾದ ಖಾತೆಯೊಂದಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡುತ್ತಿರುವಿರಿ ಮತ್ತು ನಿಮ್ಮ Browther ಪ್ರೊಫೈಲ್ ಮೂಲಕ ಅದರ ನಿರ್ವಾಹಕ ನಿಯಂತ್ರಣವನ್ನು ನೀಡುತ್ತಿರುವಿರಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಹಾಗೂ ಇತರ ಸೆಟ್ಟಿಂಗ್‌ಗಳಂತಹ ನಿಮ್ಮ Browther ಡೇಟಾವನ್ನು <ph name="USER_NAME"/> ಅವರಿಗೆ ಶಾಶ್ವತವಾಗಿ ಬಂಧಿಸಲಾಗುತ್ತದೆ. Browther ಖಾತೆಗಳ ಡ್ಯಾಶ್‌ಬೋರ್ಡ್ ಮೂಲಕ ಈ ಡೇಟಾವನ್ನು ಅಳಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯ, ಆದರೆ ಬೇರೊಂದು ಖಾತೆಯೊಂದಿಗೆ ಈ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸಲು ನಿಮಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ. ನಿಮ್ಮ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ Browther ಡೇಟಾವನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿ ಇರಿಸಿಕೊಳ್ಳಲು ನೀವು ಐಚ್ಛಿಕವಾಗಿ ಹೊಸ ಪ್ರೊಫೈಲ್ ಅನ್ನು ರಚಿಸಬಹುದು. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">ಹಿನ್ನೆಲೆ ಚಟುವಟಿಕೆ ಮತ್ತು ಮೃದುವಾಗಿ ಸ್ಕ್ರೋಲ್ ಮಾಡುವುದು ಹಾಗೂ ವೀಡಿಯೊ ಫ್ರೇಮ್ ರೇಟ್‌ಗಳಂತಹ ವಿಷುವಲ್ ಎಫೆಕ್ಟ್‌ಗಳನ್ನು ಮಿತಿಗೊಳಿಸುವ ಮೂಲಕ ಬ್ಯಾಟರಿ ಪವರ್ ಅನ್ನು Browther ಸಂರಕ್ಷಿಸುತ್ತದೆ. <ph name="BEGIN_LINK"/>ಎನರ್ಜಿ ಸೇವರ್‌ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">ಈ ಪುಟದ ವಿವರವನ್ನು ಕೇಳಿ</translation>
<translation id="9128006428501241840">Browther ಅಪ್‌ಡೇಟರ್ ಸೇವೆ</translation>
<translation id="6302815314157879372">ಇದನ್ನು ಆಫ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡದೆಯೇ Gmail ನಂತಹ Browther ಸೈಟ್‌ಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="1063611196035804685">Browther ಸ್ಪಂದಿಸುತ್ತಿಲ್ಲ. ಇದೀಗ ಮರುಪ್ರಾರಂಭಿಸುವುದೇ?</translation>
<translation id="2873360330889594383">ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡುವುದು ನಿಮ್ಮ ಸಂಸ್ಥೆ, <ph name="MANAGER"/> ಗೆ ಅಗತ್ಯವಿದೆ</translation>
<translation id="4035053306113201399">ಅಪ್‌ಡೇಟ್ ಅನ್ವಯಿಸಲು ChromeOS ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಬೇಕಾಗುತ್ತದೆ.</translation>
<translation id="2861285003831382718">ಈ ಫೈಲ್ ಪ್ರಕಾರವನ್ನು ಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡದ ಕಾರಣ Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ ಹಾಗೂ ಇದು ಅಪಾಯಕಾರಿಯಾಗಿರಬಹುದು</translation>
<translation id="1953553007165777902">ಡೌನ್‌ಲೋಡ್‌ ಮಾಡಲಾಗುತ್ತಿದೆ… <ph name="MINUTE"/> ನಿಮಿಷ(ಗಳು) ಬಾಕಿ ಉಳಿದಿವೆ</translation>
<translation id="2080160985220483492">Browther ಸಲಹೆ: ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಿ</translation>
<translation id="8037497710694492565">ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು ನಿರ್ಧರಿಸಲು ಅಥವಾ ಹೊಂದಿಸಲು Browther ಗೆ ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ</translation>
<translation id="7395009124247513849">Browther ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ, ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ</translation>
<translation id="762710512520170632">ನಿಮ್ಮ Browther ಸಾಫ್ಟ್‌ವೇರ್ ಅನ್ನು ಅಪ್ ಟು ಡೇಟ್ ಆಗಿರಿಸುತ್ತದೆ. ಈ ಸೇವೆಯನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ ಅಥವಾ ಸ್ಥಗಿತಗೊಳಿಸಿದರೆ, ನಿಮ್ಮ Browther ಸಾಫ್ಟ್‌‌ವೇರ್ ಅನ್ನು ಅಪ್ ಟು ಡೇಟ್ ಆಗಿರಿಸಲಾಗುವುದಿಲ್ಲ, ಅದರರ್ಥ ಸಂಭವಿಸಬಹುದಾದ ಭದ್ರತಾ ದೌರ್ಬಲ್ಯಗಳನ್ನು ಸರಿಪಡಿಸಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ ಮತ್ತು ಫೀಚರ್‌ಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸದೇ ಇರಬಹುದು. ಈ ಸೇವೆಯನ್ನು ಯಾವುದೇ Browther ಸಾಫ್ಟ್‌ವೇರ್ ಬಳಸದೇ ಇದ್ದಾಗ ಅದು ತಾನಾಗಿಯೇ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಆಗುತ್ತದೆ.</translation>
<translation id="5793588180426267429">ಈ ಸಾಧನದಿಂದ 1 ಐಟಂ ಅನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL"/> ನಂತೆ Browther ಗೆ ಸೈನ್‌ಇನ್ ಮಾಡಿ.</translation>
<translation id="2018879682492276940">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ವಿಫಲವಾಗಿದೆ. ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="6351516710581760512">ನಿಮ್ಮ ಇತರ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಡೇಟಾ ಉಲ್ಲಂಘನೆ ಮತ್ತು ಇತರ ಭದ್ರತಾ ಸಮಸ್ಯೆಗಳಿಂದ ಸುರಕ್ಷಿತವಾಗಿವೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸಲು, <ph name="BEGIN_LINK"/>Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">ಸೆಟ್ಟಿಂಗ್‌ಗಳು.</translation>
<translation id="8194525816714210105">Browther ಸೇವೆಗಳಲ್ಲಿ ಹೆಚ್ಚು ವೈಯಕ್ತೀಕರಿಸಿದ ಅನುಭವಗಳಿಗಾಗಿ Browther ಇತಿಹಾಸವನ್ನು ಸೇರಿಸಬೇಕೆ ಬೇಡವೇ ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="5909559127548969159">Browther ಗೆ ಹೊಸ ಲುಕ್ ನೀಡಲು, ಹೊಸ ಟ್ಯಾಬ್ ಎಂಬ ಪುಟದಲ್ಲಿ Browther ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಎಂಬ ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="2066690553719545730">ಯಾವಾಗಲೂ AI ಮೋಡ್ ಅನ್ನು ತೋರಿಸಿ</translation>
<translation id="3283892260110318935">ಈ ಫೈಲ್ ಮೋಸದಾಯಕವಾಗಿದೆ ಮತ್ತು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ಅನಿರೀಕ್ಷಿತ ಬದಲಾವಣೆಗಳನ್ನು ಮಾಡಬಹುದಾದ ಕಾರಣದಿಂದ Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="6160571936643742128">ನೀವು ಮುಂದಿನ ಬಾರಿ Browther iOS ಅನ್ನು ತೆರೆದಾಗ <ph name="FEATURE_NAME"/> ಅನ್ನು ಪ್ರಯತ್ನಿಸಲು ನಿಮಗೆ ಪ್ರಾಂಪ್ಟ್ ಕಾಣಿಸುತ್ತದೆ.</translation>
<translation id="8380517409933452343">ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ನೀವು ಸೇವ್ ಮಾಡಿರುವ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಇತರ Browther ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. Browther ನಲ್ಲಿ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬಳಸಲು, ಮರಳಿ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Browther ಅನ್ನು 1 ನಿಮಿಷದ ಕಾಲ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}one{Browther ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}other{Browther ಅನ್ನು # ನಿಮಿಷಗಳವರೆಗೆ ಬಳಸದಿದ್ದಾಗ ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ. ಇದು ಇತಿಹಾಸ, ಆಟೋಫಿಲ್ ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಒಳಗೊಂಡಿರಬಹುದು. ನಿಮ್ಮ ಟ್ಯಾಬ್ ತೆರೆದೇ ಇರುತ್ತದೆ.}}</translation>
<translation id="2126108037660393668">ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಫೈಲ್‌ನ ಪರಿಶೀಲನೆ ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="2135919691573380097">ಈ ಸೈಟ್ ಕುರಿತು ವರದಿ ಮಾಡಿ</translation>
<translation id="2137162749895930932">ಅನುವಾದದ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಮುಚ್ಚಿರಿ</translation>
<translation id="4283559398694996391">ಈ ಸೈಟ್ ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸುತ್ತಿಲ್ಲ ಮತ್ತು ಫೈಲ್ ಅನ್ನು ಟ್ಯಾಂಪರ್ ಮಾಡಿರಬಹುದಾದ ಕಾರಣದಿಂದ Browther ಈ ಡೌನ್‌ಲೋಡ್ ಅನ್ನು ನಿರ್ಬಂಧಿಸಿದೆ</translation>
<translation id="2170098639895543546">ಪುಟದಲ್ಲಿ ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="2495182092286337191">Browther ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="2174917724755363426">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ನೀವು ಖಂಡಿತವಾಗಿಯೂ ರದ್ದುಮಾಡಲು ಬಯಸುವಿರಾ?</translation>
<translation id="4877141231724140862">Browther - ನೆಟ್‌ವರ್ಕ್ ಸೈನ್ ಇನ್ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">ಅಪ್‌ಡೇಟ್‌‌ ಪರಿಶೀಲನೆ ದೋಷ: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Browther ನಿಂದ ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಿ</translation>
<translation id="1084363153644366288">iOS ಗಾಗಿ Browther ನಲ್ಲಿ ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ನೊಂದಿಗೆ ಪ್ರಯಾಣದಲ್ಲಿರುವಾಗಲೂ ಸುರಕ್ಷಿತವಾಗಿರಿ</translation>
<translation id="7949164640723239455">ಅಪಾಯಕಾರಿ ಸೈಟ್. Browther ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ತೆಗೆದುಹಾಕಿದೆ.</translation>
<translation id="2236949375853147973">ನನ್ನ ಚಟುವಟಿಕೆ</translation>
<translation id="4536403809133456417">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ವಿಳಾಸಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ. ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದ ನಂತರ ಈ ವಿಳಾಸವನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಸೇವ್ ಮಾಡಲಾಗುತ್ತದೆ.</translation>
<translation id="5627930103267312171">ನೀವು ಕಂಪ್ಯೂಟರ್ ಅನ್ನು ಹಂಚಿಕೊಂಡರೆ, ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು Browther ಅನ್ನು ಅವರಿಗೆ ಬೇಕಾದಂತೆ ಹೊಂದಿಸಿಕೊಳ್ಳಬಹುದು.</translation>
<translation id="2283803047247799269">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಎಂಬ ಫೀಚರ್ ಬಳಸಿಕೊಂಡು ಈ ಟ್ಯಾಬ್ ಅನ್ನು ಹುಡುಕಿ</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್ ಅನ್ನು ವಿರಾಮಗೊಳಿಸಲು Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}one{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}other{ನಿಮ್ಮ ಬ್ರೌಸರ್ ಅನ್ನು ನಿಧಾನಗೊಳಿಸುವ ಟ್ಯಾಬ್‌ಗಳನ್ನು ವಿರಾಮಗೊಳಿಸಲು Browther ಶಿಫಾರಸು ಮಾಡುತ್ತದೆ}}</translation>
<translation id="2307973900865360088">ಡಾಕ್‌ನಲ್ಲಿ ಇರಿಸಿ</translation>
<translation id="5161617112768367959">Browther ನಲ್ಲಿ ಸಂಗ್ರಹಣೆ ಮಾಡಲಾಗಿರುವ ಅಸುರಕ್ಷಿತ ಸೈಟ್‌ಗಳ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ, URL ಗಳನ್ನು ಪರಿಶೀಲಿಸುತ್ತದೆ. ಯಾವುದಾದರೂ ಸೈಟ್, ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಕದಿಯಲು ಪ್ರಯತ್ನಿಸಿದರೆ ಅಥವಾ ನೀವು ಹಾನಿಕಾರಕ ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಪುಟದ ಕಂಟೆಂಟ್‌ನ ತುಣುಕುಗಳನ್ನು ಒಳಗೊಂಡ URL ಗಳನ್ನು ಸಹ Browther, ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ಗೆ ಕಳುಹಿಸಬಹುದು.</translation>
<translation id="4123094831918713833">ಈ ಕ್ರಿಯೆಯು:
          <ph name="LINE_BREAKS"/>
           • ಕೆಲವು Browther ಸೆಟ್ಟಿಂಗ್‌ಗಳು ಹಾಗೂ Browther ಶಾರ್ಟ್‌ಕಟ್‌ಗಳನ್ನು ರೀಸೆಟ್ ಮಾಡುತ್ತದೆ
           <ph name="LINE_BREAK"/>
           • ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ
           <ph name="LINE_BREAK"/>
           • ಕುಕೀಗಳು ಮತ್ತು ಇತರ ತಾತ್ಕಾಲಿಕ ಸೈಟ್ ಡೇಟಾವನ್ನು ಅಳಿಸುತ್ತದೆ
            <ph name="LINE_BREAKS"/>
           ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಸೇವ್ ಮಾಡಿದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳ ಮೇಲೆ ಇದು ಪರಿಣಾಮ ಬೀರುವುದಿಲ್ಲ.</translation>
<translation id="5456070119344236353">ಇಲ್ಲಿಂದ ನಿಮ್ಮ Android ಫೋನ್‌ಗೆ ಸಂಖ್ಯೆಯನ್ನು ಕಳುಹಿಸಲು, ಎರಡೂ ಸಾಧನಗಳಲ್ಲಿ Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="2356070529366658676">ಕೇಳಿ</translation>
<translation id="2359808026110333948">ಮುಂದುವರೆಸಿ</translation>
<translation id="6468415397021485143">"<ph name="EXTENSION_NAME"/>" ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ನಿಮ್ಮ Browther ಖಾತೆಯ ಮೂಲಕ ಬಳಸುವುದಕ್ಕಾಗಿ ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬೇಕಿದೆ</translation>
<translation id="2558600429878197587">ಆ್ಯಪ್‌ಗಳಿಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ರನ್ ಆಗುತ್ತಿರುವ Browther ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿ</translation>
<translation id="5295781918312989856"><ph name="USER_EMAIL_ADDRESS"/> ಮೂಲಕ ಈ ಎಕ್ಸ್‌ಟೆನ್ಶನ್ ಅನ್ನು ಬಳಸಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="8418845734693287262">ನಿಮ್ಮ ಖಾತೆಯ ಸೈನ್ ಇನ್ ವಿವರಗಳು ತೀರಾ ಹಳೆಯದಾಗಿರುವ ಕಾರಣ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಸಿಂಕ್ ಮಾಡಲು ChromeOS ಗೆ ಸಾಧ್ಯವಾಗಲಿಲ್ಲ.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{1 HID ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}=1{1 HID ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}one{# HID ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}other{# HID ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}}</translation>
<translation id="434258293817844111">ಈ ಸೈಟ್‌ಗೆ ಸಂಬಂಧಿಸಿದಂತೆ Browther ಗೆ ಕ್ಯಾಮರಾ ಮತ್ತು ಮೈಕ್ರೊಫೋನ್ ಅನುಮತಿಗಳ ಅಗತ್ಯವಿದೆ</translation>
<translation id="2403703063067034158">ಸ್ಟಾರ್ಟ್‌ಅಪ್ ದೋಷ: ಸೆಟಪ್‌ನ ಮತ್ತೊಂದು ನಿದರ್ಶನ ಪ್ರಸ್ತುತ ರನ್ ಆಗುತ್ತಿದೆ, ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5458993228789433099">ಯಾವುದೇ ಆ್ಯಪ್‌ನಿಂದ Browther ನಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ ಮತ್ತು ನಿಮ್ಮ ಟಾಸ್ಕ್‌ಬಾರ್‌ನಲ್ಲಿ ಬ್ರೌಸರ್ ಅನ್ನು ಆ್ಯಕ್ಸೆಸ್ ಮಾಡುವ ಹಾಗೆ ಇರಿಸಿ</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther ನಲ್ಲಿನ ಟೂಲ್‌ಗಳ<ph name="END_LINK"/> ಮೂಲಕ ನೀವು ಸುರಕ್ಷಿತವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು ನಿಯಂತ್ರಣದಲ್ಲಿರಬಹುದು</translation>
<translation id="2451727308784734061">Password Manager ಗೆ ತ್ವರಿತವಾಗಿ ಹೋಗಲು ನಿಮ್ಮ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ಬಳಸಿ. ನಿಮ್ಮ ಶಾರ್ಟ್‌ಕಟ್ ಅನ್ನು ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನ ಹೋಮ್‌ ಸ್ಕ್ರೀನ್ ಅಥವಾ ಆ್ಯಪ್ ಲಾಂಚರ್‌ಗೆ ನೀವು ಸರಿಸಬಹುದು.</translation>
<translation id="2280315911954332435">Browther ಶೀಘ್ರದಲ್ಲೇ ಮುಚ್ಚಲ್ಪಡುತ್ತದೆ</translation>
<translation id="6410820860979094113">Browther ನಲ್ಲಿ</translation>
<translation id="2485422356828889247">ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್</translation>
<translation id="2513154137948333830">ರೀಬೂಟ್ ಮಾಡುವ ಅಗತ್ಯವಿದೆ: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಪಠ್ಯವನ್ನು ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="7892218991241200190">ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು Browther ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="8976443723926188033">ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು Browther ಗೆ ಸಂಗ್ರಹಣೆಯನ್ನು ಪ್ರವೇಶಿಸುವ ಅಗತ್ಯವಿದೆ</translation>
<translation id="1973587471928846950">Browther ಸಹಾಯಕ</translation>
<translation id="2575822587468774919">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಫೀಚರ್ ಬಳಸಿ ಹುಡುಕಲು ಏನನ್ನಾದರೂ ಆಯ್ಕೆಮಾಡಿ</translation>
<translation id="8705561858232289221">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="437162022240011372">Browther ಬಳಸಿಕೊಂಡು ಮುಂದುವರಿಯಿರಿ</translation>
<translation id="259935314519650377">ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಅನ್ನು ಕ್ಯಾಷ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ. ದೋಷ: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">ಸಿಸ್ಟಂ</translation>
<translation id="2907676829052962091">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಇತಿಹಾಸ ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್‌ಗಳಂತಹ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ನೋಡಬಹುದು ಮತ್ತು ನಿರ್ವಹಿಸಬಹುದು. ಅದಕ್ಕೆ ಇತರ Browther ಪ್ರೊಫೈಲ್‌ಗಳಲ್ಲಿ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ನೋಡಲು ಸಾಧ್ಯವಾಗುವುದಿಲ್ಲ</translation>
<translation id="1289116577679005654">ನಿಮ್ಮ ಖಾತೆ <ph name="ACCOUNT_EMAIL"/> ನಲ್ಲಿ Browther ಡೇಟಾವನ್ನು ಸೇವ್ ಮಾಡಲು ಮತ್ತು ಬಳಸಲು ಇದು ನೀವೇ ಎಂಬುದನ್ನು ದೃಢೀಕರಿಸಿ</translation>
<translation id="7192278346779151664">ಸ್ಥಾಪಿಸುತ್ತಿರುವಾಗ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಂ ದೋಷ ಸಂಭವಿಸಿದೆ. ದಯವಿಟ್ಟು Browther ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="7724398260867885339">ನೀವು ಸಾಧನವನ್ನು ಹಂಚಿಕೊಂಡರೆ, ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರು ಪ್ರತ್ಯೇಕವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು Browther ಅನ್ನು ಅವರಿಗೆ ಬೇಕಾದಂತೆ ಸೆಟಪ್ ಮಾಡಬಹುದು</translation>
<translation id="1679595317134614424">Browther ಟ್ಯಾಬ್</translation>
<translation id="7189168846924379421">ಹೆಚ್ಚುವರಿ ಭದ್ರತೆಗಾಗಿ, Browther ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡುತ್ತದೆ.</translation>
<translation id="4052643592793184278">Browther ನಿಂದ ನಿಮ್ಮ Browther ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೈನ್ ಔಟ್ ಮಾಡಿ</translation>
<translation id="7694616023994438906">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತ್ಯಾದಿಗಳನ್ನು ಪಡೆಯಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="2738871930057338499">ಇಂಟರ್ನೆಟ್‌ಗೆ ಕನೆಕ್ಟ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ. HTTP 403 ನಿಷೇಧಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಪ್ರಾಕ್ಸಿ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ.</translation>
<translation id="2753623023919742414">ಹುಡುಕಲು ಕ್ಲಿಕ್ ಮಾಡಿ</translation>
<translation id="9078193405195503710">Browther ಅನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ PDF ವೀಕ್ಷಕವನ್ನಾಗಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="2456995288904753506">ಪ್ರಮಾಣಿತ ಆಟೋಫಿಲ್ ಮಿಸ್ ಮಾಡಬಹುದಾದ ಕಷ್ಟಕರವಾದ ಫೀಲ್ಡ್‌ಗಳನ್ನು Browther ಆಟೋಫಿಲ್ ಮಾಡಬಲ್ಲದು</translation>
<translation id="3271730304285122987">ಈ ವಿಸ್ತರಣೆಯು ಮಾಲ್‌ವೇರ್ ಅನ್ನು ಹೊಂದಿದೆ ಮತ್ತು ಸುರಕ್ಷಿತವಾಗಿಲ್ಲ. Browther ನಿಂದ ವಿಸ್ತರಣೆಯನ್ನು ತೆಗೆದುಹಾಕಿ ಇದರಿಂದ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಒಳಗೊಂಡಂತೆ ನೀವು ಭೇಟಿ ನೀಡುವ ಸೈಟ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಇನ್ನು ಮುಂದೆ ವೀಕ್ಷಿಸಲು ಮತ್ತು ಬದಲಾಯಿಸಲು ಸಾಧ್ಯವಿಲ್ಲ.</translation>
<translation id="2799223571221894425">ಮರುಪ್ರಾರಂಭಿಸು</translation>
<translation id="1427337251963884503">ನಿಮ್ಮ Browther</translation>
<translation id="2816462166102338036">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟ ಬಳಸಿಕೊಂಡು ಈ ವೀಡಿಯೊವನ್ನು ಹುಡುಕಿ</translation>
<translation id="2841525013647267359">ಈ ಭಾಷೆಯಿಂದ ಅನುವಾದಿಸಿ</translation>
<translation id="2846251086934905009">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಪೂರ್ಣಗೊಂಡಿಲ್ಲ. ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಅನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="928966105228355994">Browther ನಿಂದ ತೆಗೆದುಹಾಕಿ...</translation>
<translation id="587805782197019018">ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, Browther ನಲ್ಲಿ ನಿಮ್ಮನ್ನು ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಮತ್ತು ಇತರ Browther ಆ್ಯಪ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ಸುರಕ್ಷತೆಯನ್ನು ಸುಧಾರಿಸಲು ಬಳಸಬಹುದು</translation>
<translation id="2885378588091291677">ಕಾರ್ಯ ನಿರ್ವಾಹಕ</translation>
<translation id="3055995278166070443">&amp;Browther ಕುರಿತು</translation>
<translation id="2915996080311180594">ನಂತರ ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="2928420929544864228">ಇನ್‌ಸ್ಟಾಲೇಶನ್ ಪೂರ್ಣಗೊಂಡಿದೆ.</translation>
<translation id="70453521937551896">ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಮೂಲಕ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗಿದೆ. ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ Browther ಡೇಟಾವನ್ನು ಬಳಸಲು ಮತ್ತು ಸೇವ್‌ ಮಾಡಲು, ನಿಮ್ಮ ಪಾಸ್‌ಫ್ರೇಸ್ ಅನ್ನು ನಮೂದಿಸಿ.</translation>
<translation id="2945997411976714835">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಪ್ರಕ್ರಿಯೆಯು ಪ್ರಾರಂಭಿಸಲು ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="3188308520233701133">iOS ನಲ್ಲಿ Browther ಗಾಗಿ ಸೇವ್ ಮಾಡಲಾದ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಸೈಟ್‌ಗಳಿಗೆ ವೇಗವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="8145318807880784886">ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು, ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು ಹೊಸ Browther ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ.</translation>
<translation id="4330268530227888227">ನಿಮ್ಮ ಸಂಸ್ಥೆಯು Browther ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ</translation>
<translation id="6488090896442998436">Browther ಅಪ್‌ ಟು ಡೇಟ್‌ ಆಗಿದೆ</translation>
<translation id="300557164611864786">ಯಾವುದಾದರೂ ಸೈಟ್ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಕದಿಯಲು ಪ್ರಯತ್ನಿಸಿದರೆ ಅಥವಾ ನೀವು ಹಾನಿಕಾರಕ ಫೈಲ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದಾಗ, ಪುಟದ ವಿಷಯದ ತುಣುಕುಗಳನ್ನು ಒಳಗೊಂಡ URL ಗಳನ್ನು ಸಹ Browther, ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌ಗೆ ಕಳುಹಿಸುತ್ತದೆ</translation>
<translation id="2447145782593796785">ನಿಮ್ಮ ಪೋಷಕರ ಆಯ್ಕೆಗಳೊಂದಿಗೆ ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಸುರಕ್ಷಿತವಾಗಿರಲು, Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3003694935412297923">ಎಲ್ಲಾ ಕಾರ್ಯಗಳು</translation>
<translation id="7554113777150891030">{count,plural, =1{ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Browther ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾವನ್ನು (1 ಐಟಂ) ಅಳಿಸಲಾಗುತ್ತದೆ.}one{ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Browther ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}other{ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ಕೆಲವು ಡೇಟಾವನ್ನು ಸೇವ್‌ ಮಾಡುವ ಮತ್ತು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಬಳಸುವ ಮೊದಲು Browther ಇದು ನೀವೇ ಎಂದು ದೃಢೀಕರಿಸುವ ಅಗತ್ಯವಿದೆ. ನೀವು ಈಗ ಸೈನ್ ಔಟ್ ಮಾಡಿದರೆ, ಈ ಡೇಟಾ ({count} ಐಟಂಗಳನ್ನು) ಅಳಿಸಲಾಗುತ್ತದೆ.}}</translation>
<translation id="5522228731050510047">Browther ನಲ್ಲಿ <ph name="URL"/> ಅನ್ನು ಹೊಸ ಟ್ಯಾಬ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ.</translation>
<translation id="6358780591055960280">Browther ಗೆ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ನಂತರ ಪುನಃ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="1386422761453740126">Browther ಗೆ ಸೇರಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3038232873781883849">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ನಿರೀಕ್ಷಿಸಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3045032126857188731">ಅನುವಾದಿಸಿದ ಭಾಷೆ: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ಫೀಡ್‌ಬ್ಯಾಕ್ ಡೈಲಾಗ್ ಅನ್ನು ಮುಚ್ಚಿ</translation>
<translation id="369127628511662602">ಇತರ Browther ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="2370255879896574713">Browther ಗೆ ಕ್ರ್ಯಾಶ್ ವರದಿಗಳನ್ನು ಮತ್ತು <ph name="UMA_LINK"/> ಕಳುಹಿಸುವುದರಿಂದ Browther ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 USB ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}=1{1 USB ಸಾಧನವನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}one{# USB ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}other{# USB ಸಾಧನಗಳನ್ನು ಒಂದು ಅಥವಾ ಹೆಚ್ಚಿನ Browther ಎಕ್ಸ್‌ಟೆನ್ಶನ್‌ಗಳ ಮೂಲಕ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಲಾಗುತ್ತಿದೆ}}</translation>
<translation id="2065456480740480340">Browther ಇತಿಹಾಸ</translation>
<translation id="5011660649081947055">ಆರ್ಕೈವ್ ಅನ್ನು ಸಂಕ್ಷೇಪ ಮಾಡದಿರಲು ಸ್ಥಾಪಕ ವಿಫಲಗೊಂಡಿದೆ. ದಯವಿಟ್ಟು Browther ಅನ್ನು ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ.</translation>
<translation id="310459126943037700">ಕಾರ್ಯವನ್ನು(ಗಳು) ಅಂತ್ಯಗೊಳಿಸಲು ವಿಫಲವಾಗಿದೆ.</translation>
<translation id="3104828284009500087">ಪುಟದಲ್ಲಿ ಏನನ್ನಾದರೂ ಹುಡುಕಿ</translation>
<translation id="4917564010081457061">ಸಾಧನಗಳಾದ್ಯಂತ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇತಿಹಾಸವನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಿಂಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಅನ್ನು Browther ಗೆ ಅಪ್‌ಡೇಟ್ ಮಾಡುವ ಮೂಲಕ ನಿಮಗೆ ತಿಳಿದಿರುವ ಮತ್ತು ಇಷ್ಟಪಡುವ ಫೀಚರ್‌ಗಳನ್ನು ಸುಲಭವಾಗಿ ಆ್ಯಕ್ಸೆಸ್ ಮಾಡಿ.</translation>
<translation id="1041472930719344928">Browther ನಿಮ್ಮ ಮೈಕ್ರೋಫೋನ್ ಬಳಸುತ್ತಿದೆ.</translation>
<translation id="3130333203120345554">ಹೊಸ ಹುಡುಕಾಟ</translation>
<translation id="3137969841538672700">ಹುಡುಕಲು ಡ್ರ್ಯಾಗ್ ಮಾಡಿ</translation>
<translation id="5312717254055363883">ಈ ಟ್ಯಾಬ್ ಇನ್ನಷ್ಟು ಮಾಹಿತಿಯ ಮೂಲಗಳನ್ನು ಬಳಸುತ್ತಿದೆ. ನಿಮ್ಮ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು, ಅದನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು Browther ಅನ್ನು ಅನುಮತಿಸಿ.</translation>
<translation id="373523409348786203">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Browther ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ</translation>
<translation id="802113445299754598">Browther ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3161522574479303604">ಎಲ್ಲಾ ಭಾಷೆಗಳು</translation>
<translation id="4522189060330781648">ನಿಮ್ಮ ಕಂಪ್ಯೂಟರ್‌ನಲ್ಲಿನ ಮತ್ತೊಂದು ಪ್ರೋಗ್ರಾಂ Browther ಕಾರ್ಯನಿರ್ವಹಿಸುವ ವಿಧಾನವನ್ನು ಬದಲಿಸಬಹುದಾದ ಥೀಮ್ ಒಂದನ್ನು ಸೇರಿಸಿದೆ.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">ನಿಮ್ಮ ಹೊಸ Browther ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="5150830326120505481">Browther ನಿಂದ ನಿಮ್ಮ Browther ಖಾತೆಯನ್ನು ತೆಗೆದುಹಾಕಲು, ಸೆಟ್ಟಿಂಗ್‌ಗಳ ಪುಟದಲ್ಲಿ Browther ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ</translation>
<translation id="7113660200899017820">ನಂತರ, ನಿಮಗಾಗಿ ಫಾರ್ಮ್‌ಗಳನ್ನು ಆಟೋಫಿಲ್ ಮಾಡಲು, ಸೇವ್ ಮಾಡಿದ ಮಾಹಿತಿಯನ್ನು ಬಳಸಲು ನೀವು ಬಯಸುತ್ತೀರಾ ಎಂದು Browther ಕೇಳಬಹುದು</translation>
<translation id="4475011322243623412">Browther ಗೆ ಇದರ ಡೇಟಾ ಡೈರೆಕ್ಟರಿಯನ್ನು ಓದಲಾಗುವುದಿಲ್ಲ ಮತ್ತು ಬರೆಯಲಾಗುವುದಿಲ್ಲ: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">ಈಗ ಮರುಪ್ರಾರಂಭಿಸಿ</translation>
<translation id="3536063527222598206">Browther API ಕೀಗಳು ಕಾಣೆಯಾಗಿವೆ. Browther ನ ಕೆಲವು ಕಾರ್ಯವಿಧಾನಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲಾಗುತ್ತದೆ.</translation>
<translation id="1011450868746766298">Browther ಮುಚ್ಚಿದಾಗ ರನ್‌ ಆಗುತ್ತಿರುವ ಹಿನ್ನೆಲೆ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮುಂದುವರಿಸು</translation>
<translation id="179611081153855734">ಅಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಯಾವುದೇ ಸೈಟ್ ಅನ್ನು ಲೋಡ್ ಮಾಡುವ ಮೊದಲು Browther ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ</translation>
<translation id="8965591964936552871">ನೀವು Browther ಗೆ ಸೈನ್ ಇನ್ ಆಗಿದ್ದರೆ, ನಿಮ್ಮ Browther ಖಾತೆಯನ್ನು ಹೊರತುಪಡಿಸಿ ಎಲ್ಲಾ Browther ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚುವುದರಿಂದ ಹೆಚ್ಚಿನ ಸೈಟ್‌ಗಳಿಂದ ನಿಮ್ಮನ್ನು ಸೈನ್ ಔಟ್ ಮಾಡಲಾಗುತ್ತದೆ. ಸೈಟ್‌ಗಳು ನಿಮ್ಮನ್ನು ನೆನಪಿಟ್ಟುಕೊಳ್ಳಲು ಅವಕಾಶ ಮಾಡಿಕೊಡಲು, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಸರ್ಚ್ ಎಂಜಿನ್ ಅನ್ನು Browther ನ ಹೊರಗಿನಿಂದ ಬದಲಾಯಿಸಲಾಗಿದೆ. ನಿಮ್ಮನ್ನು ರಕ್ಷಿಸಲು, Browther ಅದನ್ನು ರೀಸೆಟ್ ಮಾಡಿದೆ.</translation>
<translation id="1170501833661894915">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳು ಮತ್ತು ಇನ್ನೂ ಹೆಚ್ಚಿನದನ್ನು ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ಪಡೆದುಕೊಳ್ಳಲು Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="3352986031709923790">ಹುಡುಕಾಟ ಪ್ರದೇಶದ ಮೇಲಿನ ಬಲ ಮೂಲೆ: ಬಲಕ್ಕೆ <ph name="RIGHT"/>%, ಮೇಲಕ್ಕೆ <ph name="TOP"/>%</translation>
<translation id="120745000989996104">ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿ Browther ಡೇಟಾ</translation>
<translation id="3369405342922656244">ಚಿತ್ರದ ಮೂಲಕ ಹುಡುಕಾಟದ ಬಳಸಿಕೊಂಡು ಈ ಪುಟವನ್ನು ಹುಡುಕಿ</translation>
<translation id="7173761126541905083">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ Browther ಮೂಲಕ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಿ</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">ಈಗಿರುವ Browther ಪ್ರೊಫೈಲ್‌ಗೆ ಬದಲಿಸಬೇಕೆ?</translation>
<translation id="3412460710772753638">ಈ ಸಾಧನದಲ್ಲಿನ Password Manager ನಲ್ಲಿ</translation>
<translation id="4282363917570905631">ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿನ Browther ಮೂಲಕ ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ವಿಸ್ತರಿಸಿ</translation>
<translation id="986094398735583155">Browther ಅನ್ನು ನಿಮ್ಮದಾಗಿಸಿಕೊಳ್ಳಲಾಗುತ್ತಿದೆ...</translation>
<translation id="3266047225484320321">ಅಪಾಯಕ್ಕೀಡಾದ ಪಾಸ್‌ವರ್ಡ್ ಬಳಸಿ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ, Browther ನಿಮಗೆ ಸೂಚನೆ ನೀಡುತ್ತದೆ</translation>
<translation id="3508047337876211050">ಈ ಸಾಧನದಿಂದ <ph name="ITEMS_COUNT"/> ಐಟಂಗಳನ್ನು ಇದು ಅಳಿಸುತ್ತದೆ. ನಂತರ ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮರುಪಡೆಯಲು, <ph name="USER_EMAIL"/> ನಂತೆ Browther ಗೆ ಸೈನ್‌ಇನ್ ಮಾಡಿ.</translation>
<translation id="7772248897860792723">Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬದಲಾಯಿಸಲು <ph name="SHORTCUT"/> ಅನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="7225005776233199285">ದಯವಿಟ್ಟು ಎಲ್ಲಾ Browther ವಿಂಡೋಗಳನ್ನು ಮುಚ್ಚಿರಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="5465054931427475969">ನಿಮ್ಮ ವಿಂಡೋ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Browther ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> ಅನ್ನು ಈಗಾಗಲೇ ಸೈನ್ ಇನ್ ಮಾಡಲಾಗಿದೆ.  ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, ನಿಮ್ಮ ಸ್ವಂತ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ <ph name="USER_EMAIL_ADDRESS"/> ನಂತೆ Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="8133590217245064579">ನಿಮ್ಮ ಸ್ಕ್ರೀನ್‌ ಅನ್ನು ಹಂಚಿಕೊಳ್ಳಲು, ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Browther ಗೆ ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಮಾಡಲು ಅನುಮತಿಸಿ.</translation>
<translation id="3597003331831379823">ಎಲಿವೇಟೆಡ್ ಪ್ರಿವಿಲೇಜಸ್ ಮೂಲಕ ಸೆಟಪ್ ಅನ್ನು ರನ್ ಮಾಡಲು ವಿಫಲವಾಗಿದೆ. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Browther ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="2492221622209669678">ಈ ವ್ಯಕ್ತಿಯ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ಅಳಿಸಲಾಗುತ್ತದೆ. ಡೇಟಾವನ್ನು ಪುನಃ ಪಡೆದುಕೊಳ್ಳಲು, Browther ನಲ್ಲಿ <ph name="USER_EMAIL"/> ಎಂದು ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="6793778233257855801"><ph name="ORIGIN"/> ನಿಂದ ನಿಮ್ಮ Android ಫೋನ್‌ಗೆ ಸಂಖ್ಯೆಯನ್ನು ಕಳುಹಿಸಲು, ಎರಡೂ ಸಾಧನಗಳಲ್ಲಿ Browther ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="3667616615096815454">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಲು ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ, ಅಪ್ಲಿಕೇಶನ್ ಸರ್ವರ್‌ಗೆ ತಿಳಿದಿಲ್ಲ.</translation>
<translation id="5585500151754164442">ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿರುವ ಎಲ್ಲಾ Browther ಡೇಟಾವನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲು ನಿಮ್ಮ <ph name="BEGIN_LINK"/>ಸ್ವಂತ ಪಾಸ್‌ಫ್ರೇಸ್<ph name="END_LINK"/> ಬಳಸಿ. Google Pay ನಲ್ಲಿನ ಪಾವತಿ ವಿಧಾನಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಎನ್‌ಕ್ರಿಪ್ಟ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ. Browther ನ ಬ್ರೌಸಿಂಗ್ ಇತಿಹಾಸವು ಸಿಂಕ್ ಆಗುವುದಿಲ್ಲ.</translation>
<translation id="404323216042159951">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಪರಿಶೀಲಿಸಲು Browther ಗೆ ಸಾಧ್ಯವಾಗುತ್ತಿಲ್ಲ. ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ನೋಡಿ.</translation>
<translation id="5004936474632127765">ಹೊಸ Browther &amp;ಟ್ಯಾಬ್‌ನಲ್ಲಿ ಲಿಂಕ್ ತೆರೆಯಿರಿ</translation>
<translation id="6236643159256182256">ವೈಯಕ್ತೀಕರಣ ಮತ್ತು ಇತರ ಉದ್ದೇಶಗಳಿಗಾಗಿ Browther ಮತ್ತು ಇತರ Browther ಸೇವೆಗಳನ್ನು ಲಿಂಕ್ ಮಾಡಿ</translation>
<translation id="3729187154190517324">"ಟ್ಯಾಬ್ ಮತ್ತು ಇನ್ನಷ್ಟು ಸೇರಿಸಿ" ಬಟನ್ ಅನ್ನು ಬಳಸಿಕೊಂಡು ಬಹು ಟ್ಯಾಬ್‌ಗಳು, ಫೈಲ್‌ಗಳು ಮತ್ತು ಟೂಲ್‌ಗಳನ್ನು ಸೇರಿಸುವ ಮೂಲಕ ನಿಮ್ಮ ಹುಡುಕಾಟವನ್ನು ಇನ್ನಷ್ಟು ಆಳವಾಗಿಸಿ.</translation>
<translation id="1400697664933775238">Browther ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="2461315395128103158">Browther ಕೆಲವು ಡೌನ್‌ಲೋಡ್‌ಗಳನ್ನು ಏಕೆ ನಿರ್ಬಂಧಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="8058420662026104226">ನಿಮ್ಮ ಪರಿಶೀಲನೆಗೆ ಏನಾದರೂ ಅಗತ್ಯವಿದ್ದರೆ Browther ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="3177448557921912221">Browther ಪ್ರೊಫೈಲ್‌ಗಳು ನಿಮ್ಮ ಜೀವನದ ವಿವಿಧ ಅಂಶಗಳನ್ನು ಪ್ರತ್ಯೇಕಿಸಲು ನಿಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತವೆ. ಈಗಲೇ ಹೊಸ ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ.</translation>
<translation id="1541177876035612043">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಪುಟಗಳನ್ನು Browther ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="3810973564298564668">ನಿರ್ವಹಿಸಿ</translation>
<translation id="1117103475254549453">ನೀವು ಸೇವ್ ಮಾಡಿರುವ ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಬಳಸಲು, QR ಕೋಡ್ ಅನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಿ, Browther iOS ಆ್ಯಪ್ ಅನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಮತ್ತು ನಿಮ್ಮ Browther ಖಾತೆಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="8880695882192156860">Browther ಸಲಹೆ: ವರ್ಧಿತ ಸುರಕ್ಷಿತ ಬ್ರೌಸಿಂಗ್‌</translation>
<translation id="3846683726093018685">**ಸಾರಾಂಶಗೊಳಿಸಿ:** 30 ಪದಗಳ ಒಳಗೆ ಒಂದೇ ವಾಕ್ಯದಲ್ಲಿ, ಸ್ಕ್ರೀನ್‌ಶಾಟ್‌ನಲ್ಲಿರುವ ಕಂಟೆಂಟ್‌ನ ಪ್ರಾಥಮಿಕ ವಿಷಯ ಮತ್ತು ಉದ್ದೇಶವನ್ನು ವಿವರಿಸಿ.

          **ಪ್ರಶ್ನೆಗಳನ್ನು ಸೂಚಿಸಿ:** ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ಅನ್ನು ಚೆನ್ನಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಬಳಕೆದಾರರು ಕೇಳಬಹುದಾದ 3-5 ಚಿಂತನೆಗೆ ಒರೆ ಹಚ್ಚುವ ಪ್ರಶ್ನೆಗಳ ಬುಲೆಟ್ ಪಟ್ಟಿಯನ್ನು ರಚಿಸಿ. ಈ ಪ್ರಶ್ನೆಗಳು ವಿಷುವಲ್‌ ಆಬ್ಜೆಕ್ಟ್, ಅದರ ವಿನ್ಯಾಸ ಅಥವಾ ಅದರ ಪ್ಲೇಸ್‌ಮೆಂಟ್‌‌ನ ಬಗ್ಗೆ ನಿರ್ದಿಷ್ಟವಾಗಿ ಇವುಗಳಲ್ಲಿ ಕನಿಷ್ಠ ಒಂದನ್ನಾದರೂ ಒಳಗೊಂಡಿರಬೇಕು.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">ಭಾಷಾ ಪಿಕರ್‌</translation>
<translation id="4861846616763552424">Browther ಕಸ್ಟಮೈಸ್ ಮಾಡಿ ಮತ್ತು ನಿಯಂತ್ರಿಸಿ. ನೀವು ಕೆಲವು ಸಂಗತಿಗಳ ಕುರಿತು ಗಮನಹರಿಸಬೇಕಿದೆ - ವಿವರಗಳಿಗಾಗಿ ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="6126366281251241386">Browther ತೆರೆಯಲು ಮತ್ತು ಬ್ರೌಸ್ ಮಾಡುವುದನ್ನು ಪ್ರಾರಂಭಿಸಲು ನಿಮ್ಮ ಹೆಸರನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ.</translation>
<translation id="3892148308691398805">ಪಠ್ಯ ಕಾಪಿ ಮಾಡಿ</translation>
<translation id="3760801273210219822">ಈ Browther ಪ್ರೊಫೈಲ್‌ಗೆ ಈಗಾಗಲೇ <ph name="EXISTING_USER"/> ಅವರು ಸೈನ್ ಇನ್ ಮಾಡಿದ್ದಾರೆ. ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಅನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿರಿಸಲು, Browther ನಿಮಗಾಗಿ ನಿಮ್ಮ ಸ್ವಂತ ಪ್ರೊಫೈಲ್ ಅನ್ನು ರಚಿಸಬಹುದು.</translation>
<translation id="3821553157234855663">ನಿಮ್ಮ Browther ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="3941890832296813527">ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವಾಗ ದೋಷ: ಇನ್‌ಸ್ಟಾಲರ್‌‌ ಫೈಲ್ ಹೆಸರು ಅಮಾನ್ಯವಾಗಿದೆ ಅಥವಾ ಬೆಂಬಲಿತವಾಗಿಲ್ಲ.</translation>
<translation id="6482299900191767005">Browther, ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ನಕಲಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ. ಇದನ್ನು ಅನುಮತಿಸಲು ನಿಮ್ಮ Windows ಪಾಸ್‌ವರ್ಡ್‌ ಅನ್ನು ಟೈಪ್ ಮಾಡಿ.</translation>
<translation id="5853011008278898603">ನಿಮ್ಮ Browther ಖಾತೆಯಲ್ಲಿ ನೀವು ಸೇವ್ ಮಾಡದ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು, ಪಾವತಿ ವಿಧಾನಗಳು ಮತ್ತು ವಿಳಾಸಗಳನ್ನು ಈ ಸಾಧನದಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. Browther ನಲ್ಲಿ ಅವುಗಳನ್ನು ಮತ್ತೆ ಬಳಸಲು, ಮರಳಿ ಸೈನ್ ಇನ್ ಮಾಡಿ.</translation>
<translation id="395904275706073188">ಸಂರಕ್ಷಿತ ಪುಟಗಳನ್ನು ಓದಲಾಗುವುದಿಲ್ಲ. ಬೇರೆ ಪುಟವನ್ನು ಪ್ರಯತ್ನಿಸಿ.</translation>
<translation id="1832973663231751701">Browther ನಿಮ್ಮನ್ನು ಹೇಗೆ ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="4531502594774670767">ನೀವು ವಿಳಾಸ ಪಟ್ಟಿ ಅಥವಾ ಸರ್ಚ್ ಬಾಕ್ಸ್‌ನಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಸಲಹೆಗಳನ್ನು ಪಡೆಯಲು Browther ನೀವು ಟೈಪ್ ಮಾಡುವುದನ್ನು ನಿಮ್ಮ ಸಂಸ್ಥೆಯ ಹುಡುಕಾಟ, AI ಮತ್ತು ಏಜೆಂಟ್ ಟೂಲ್‌ಗಳಿಗೆ ಕಳುಹಿಸುತ್ತದೆ.</translation>
<translation id="300013383485253006">Browther for Testing ಕುರಿತು</translation>
