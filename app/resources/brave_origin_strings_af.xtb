<translation id="6181263681651521876">{COUNT,plural, =0{Jou administrateur vra dat jy Browther herbegin om hierdie opdatering toe te pas}=1{Jou administrateur vra dat jy Browther herbegin om hierdie opdatering toe te pas. Jou incognitovenster sal nie weer oopgemaak word nie.}other{Jou administrateur vra dat jy Browther herbegin om hierdie opdatering toe te pas. Jou # incognitovensters sal nie weer oopgemaak word nie.}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{Jou administrateur vereis dat jy Browther herbegin om 'n opdatering toe te pas}=1{Jou administrateur vereis dat jy Browther herbegin om 'n opdatering toe te pas. Jou incognitovenster sal nie weer oopgemaak word nie.}other{Jou administrateur vereis dat jy Browther herbegin om 'n opdatering toe te pas. Jou # incognitovensters sal nie weer oopgemaak word nie.}}</translation>
<translation id="8762228142105311329">{COUNT, plural, =0 {Gevorderde Beskerming vereis dat jy Browther moet herbegin om 'n opdatering toe te pas} =1 {Gevorderde Beskerming vereis dat jy Browther moet herbegin om 'n opdatering toe te pas. Jou Private venster sal nie weer oopmaak nie.} other {Gevorderde Beskerming vereis dat jy Browther moet herbegin om 'n opdatering toe te pas. Jou # Private vensters sal nie weer oopmaak nie.}}</translation>
<translation id="5749154344207139683">Help ons om Incognito te verbeter deur hierdie 1-minuutopname te voltooi.</translation>
<translation id="6954203250660846933">Wanneer jy iets in die adresbalk of soekkassie tik, stuur Browther wat jy tik na jou versteksoekenjin toe om beter voorstelle te kry. Dit is af in Incognito.</translation>
<translation id="3542179014707218534">Browther Incognito</translation>
<translation id="2076355018722231995">Browther sal jou waarsku voordat ’n werf met ’n onveilige verbinding gelaai word wanneer jy in Incognitomodus blaai</translation>
</translationbundle>