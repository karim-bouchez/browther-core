<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="1026101648481255140">Rifillo instalimin</translation>
<translation id="7099479769133613710">Nise sërish për të përditësuar ChromeOS</translation>
<translation id="7264054672589027446">Browther rekomandon që ta rinovosh këtë shtesë</translation>
<translation id="7848219163187166649">Kur një sajt kërkon të ngarkojë paraprakisht lidhje në mënyrë private në faqen e tij, Browther përdor serverët e Browther. Kjo e fsheh identitetin tënd nga sajti i ngarkuar paraprakisht, por Browther mëson se çfarë sajtesh ngarkohen paraprakisht.</translation>
<translation id="1065672644894730302">Preferencat e tua nuk mund të lexohen.

Disa funksione mund të mos ofrohen dhe ndryshimet në preferenca nuk do të ruhen.</translation>
<translation id="8837164267124113709">Prindi yt ka çaktivizuar "Lejet për sajtet, aplikacionet dhe shtesat" për Browther</translation>
<translation id="881513728707488138">Browther dëshiron të eksportojë fjalëkalimet e tua. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="112640046208448578">Identifiko gjërat ose vendet dhe kopjo ose përkthe tekstin. Kur përdor "Kërkimin nëpërmjet imazheve", një pamje ekrani e faqes dërgohet te serveri. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther është shfletuesi yt i parazgjedhur</translation>
<translation id="6580138787163923852">Për të kontrolluar nëse fjalëkalimet e tua janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK"/>identifikohu në Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Kliko te menyja e Browther</translation>
<translation id="1157985233335035034">Gjuhët e fundit</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> ka shtuar një shtesë që mund të ndryshojë mënyrën se si funksionon Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Instalimi dështoi pasi versioni yt i Windows nuk mbështetet.</translation>
<translation id="8291401179516272335">Rreth Browther</translation>
<translation id="1203500561924088507">Faleminderit që e instalove. Duhet të rinisësh shfletuesin përpara se të përdorësh <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Kur hap "Kërkimin e imazheve", titulli i faqes, URL-ja dhe përmbajtja, duke përfshirë skedarët PDF, do të dërgohen automatikisht te serveri. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Kur je i identifikuar, mund të përdorësh fjalëkalimet dhe më shumë nga "Llogaria jote e Browther" në Browther. Për ta ndryshuar këtë, shko te "Llogaria jote në Browther".</translation>
<translation id="9034321258761608912">Kur kjo skedë ishte joaktive, memoria u lirua që Browther të vazhdojë të jetë i shpejtë. Mund të zgjedhësh që ta përjashtosh gjithmonë këtë sajt nga caktimi si joaktiv.</translation>
<translation id="249571811018731941">Browther e bllokoi këtë shkarkim sepse skedari është i rrezikshëm</translation>
<translation id="8850227089720975601">Kur identifikohesh me <ph name="USER_EMAIL"/> në shërbimet e Browther, si p.sh. Gmail ose YouTube, mund të identifikohesh automatikisht në Browther me të njëjtën llogari</translation>
<translation id="1290883685122687410">Gabim në konfigurim: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Konfiguro profilin tënd të ri të Browther</translation>
<translation id="4437862975743821367">Browther ka nevojë për qasje te Bluetooth-i për të eksploruar pajisjet me Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Zbulo gjuhën</translation>
<translation id="1206925267243987362">Përdor cilësimet e rekomanduara të shfletuesit Browther</translation>
<translation id="8270483548049772782">Fshi po ashtu të dhënat nga Browther (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">U gozhdua! Mund të qasesh përsëri te "Kërkimi nëpërmjet imazheve" nga butoni i ri në shiritin e veglave</translation>
<translation id="1356661055722410047">E re! Mund të përkthesh tekstet dhe imazhet në ekranin tënd</translation>
<translation id="1383876407941801731">Kërko</translation>
<translation id="1592588950737518481">&amp;Menaxho profilet e Browther</translation>
<translation id="1404026649028693342">Shfaq gjithmonë "Modalitetin e IA-së"</translation>
<translation id="141901961143729572">Ndaj mendimet e tua</translation>
<translation id="1743952081001089298">Për të ndarë dritaren tënde, lejo regjistrimin e ekranit për Browther te "Cilësimet e sistemit".</translation>
<translation id="8627385813382688019">Merr ndihmë për Browther for Testing</translation>
<translation id="1497802159252041924">Gabim gjatë instalimit: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Kjo faqe është e mbrojtur</translation>
<translation id="7252430412915798987">Ndaj një skedë të Browther</translation>
<translation id="6388429281015199562">Identifikohu në Browther</translation>
<translation id="1547469039832541117">Përfundon detyrën e theksuar.</translation>
<translation id="1801944307203212016">Browther ka nevojë për leje për t'u qasur te kamera jote për të krijuar një hartë 3D të ambientit tënd rrethues</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Kjo shtesë nuk mbështetet më. Browther rekomandon që ta heqësh atë.}other{Këto shtesa nuk mbështeten më. Browther rekomandon që t'i heqësh ato.}}</translation>
<translation id="4667068923142532753">Gozhdo Browther</translation>
<translation id="3006560544901646947">Veglat e sigurisë të Browther</translation>
<translation id="686052171138185761">Browther dëshiron të fshijë të dhënat e tua të "Menaxherit të fjalëkalimeve". Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="8713026329083542796">Shqyrto kontrollet kryesore të sigurisë dhe privatësisë në Browther</translation>
<translation id="1640672724030957280">Po shkarkohet...</translation>
<translation id="1680687534629375545">Pyet "Kërkimin e imazheve" për këtë faqe</translation>
<translation id="1709772298389099340">Ofron privilegje të larta për <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Për të ndihmuar në përmirësimin e këtyre veçorive, Browther i dërgon Browther ndërveprimet e tua me të. Këto të dhëna mund të lexohen, të përpunohen dhe të shënohen nga shqyrtues njerëzorë.</translation>
<translation id="1722488837206509557">Kjo do të të lejojë që të zgjedhësh nga pajisjet e disponueshme dhe të shfaqësh përmbajtjet në to.</translation>
<translation id="6820510278633522408">Browther do t'i fshijë së shpejti të dhënat e shfletimit</translation>
<translation id="7775028004939172516">Browther do të përpiqet t'i përmirësojë navigimet në HTTPS</translation>
<translation id="6963959729951758069">Të dhënat e Browther u pastruan</translation>
<translation id="4085139922884095932">Browther do të riniset pas <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Kur HTTPS nuk ofrohet, Browther do të përdorë një lidhje të pasigurt pa të të paralajmëruar</translation>
<translation id="3975328336074677101">Lejo që Browther të ekzekutohet në sfond</translation>
<translation id="2497443204974841650">Instalo përsëri Browther</translation>
<translation id="1724309687045787742">Browther po përpiqet <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Herën tjetër që të hapësh Browther në <ph name="DEVICE_TYPE"/>, do të shikosh një kërkesë për të përdorur "Menaxherin e fjalëkalimeve të Browther".</translation>
<translation id="1838374766361614909">Fshi kërkimin</translation>
<translation id="2337233040802538155">Për t'i fshirë të dhënat e shfletimit vetëm nga kjo pajisje, ndërkohë që i mban ato në "Llogarinë tënde të Browther", <ph name="BEGIN_LINK"/>dil nga llogaria në Browther<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Shkarko Browther në telefon për të hapur ose krijuar grupe të reja skedash kur je në lëvizje.</translation>
<translation id="2063443520349987970">Mund t'i menaxhosh "Llogaritë e Browther" ku je identifikuar. "Llogaritë e tua të Browther" përdoren për shfletuesin Browther, Play Store, Gmail etj. Nëse do të shtosh një llogari për dikë tjetër, si p.sh. anëtar të familjes, shto më mirë një person të ri te <ph name="DEVICE_TYPE"/> yt. <ph name="LINK_BEGIN"/>Mëso më shumë<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Kërko me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="1880677175115548835">Përzgjidh tekstin</translation>
<translation id="3183933389992069620">Po identifikohesh me një llogari të menaxhuar dhe po i jep administratorit të saj kontrollin mbi profilin tënd të Browther. Të dhënat e tua të Browther, si aplikacionet, faqeshënuesit, historiku, fjalëkalimet dhe cilësimet e tjera do të bëhen të lidhura përgjithmonë me <ph name="USER_NAME"/>. Do të mund t'i fshish këto të dhëna nëpërmjet "Panelit të llogarive të Browther", por nuk do të mund t'i lidhësh këto të dhëna me një llogari tjetër. Mund të krijosh si opsion një profil të ri për t'i mbajtur më vete të dhënat ekzistuese të Browther. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther kursen energjinë e baterisë duke kufizuar aktivitetin në sfond dhe efektet vizuale, si p.sh. lëvizjen e butë dhe shpejtësitë e kuadrove të videove. <ph name="BEGIN_LINK"/>Mëso më shumë për "Kursyesin e energjisë"<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Pyet rreth kësaj faqeje</translation>
<translation id="9128006428501241840">Browther Updater Service</translation>
<translation id="6302815314157879372">Duke çaktivizuar këtë, mund të identifikohesh në sajtet e Browther si Gmail pa u identifikuar në Browther</translation>
<translation id="1063611196035804685">Browther nuk përgjigjet. Dëshiron ta hapësh sërish tani?</translation>
<translation id="2873360330889594383">Organizata jote, <ph name="MANAGER"/>, kërkon që të identifikohesh në Browther</translation>
<translation id="4035053306113201399">ChromeOS ka nevojë të riniset për të zbatuar përditësimin.</translation>
<translation id="2861285003831382718">Browther e bllokoi këtë shkarkim sepse lloji i skedarit nuk është shkarkuar zakonisht dhe mund të jetë i rrezikshëm</translation>
<translation id="1953553007165777902">Po shkarkohet... Kanë mbetur edhe <ph name="MINUTE"/> minuta</translation>
<translation id="2080160985220483492">Këshillë për Browther: Ruaj fjalëkalimet</translation>
<translation id="8037497710694492565">Browther nuk mund të përcaktojë ose caktojë shfletuesin e parazgjedhur</translation>
<translation id="7395009124247513849">Mëso se pse Browther i bllokon disa skedarë, hapet në një skedë të re</translation>
<translation id="762710512520170632">E mban të përditësuar softuerin e Browther. Nëse ky shërbim çaktivizohet ose ndalohet, softueri yt i Browther nuk do të mbahet i përditësuar, që do të thotë se dobësitë e sigurisë që mund të lindin nuk mund të rregullohen dhe veçoritë mund të mos funksionojnë. Ky shërbim çinstalohet vetë kur nuk ka një softuer të Browther që e përdor atë.</translation>
<translation id="5793588180426267429">Kjo do të fshijë 1 artikull nga kjo pajisje. Për t'i marrë më vonë të dhënat, identifikohu te Browther si <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instalimi nuk u krye. Provo përsëri.</translation>
<translation id="6351516710581760512">Për të kontrolluar nëse fjalëkalimet e tjera janë të sigurta nga nxjerrjet e paautorizuara të të dhënave dhe probleme të tjera të sigurisë, <ph name="BEGIN_LINK"/>identifikohu në Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Cilësimet.</translation>
<translation id="8194525816714210105">Zgjidh nëse do ta përfshish historikun e Browther për përvoja më të personalizuara në shërbimet e Browther</translation>
<translation id="5909559127548969159">Kliko te butoni "Personalizo Browther" në faqen e skedës së re për t'i dhënë Browther një pamje të re</translation>
<translation id="2066690553719545730">Shfaq gjithmonë "Modalitetin e IA-së"</translation>
<translation id="3283892260110318935">Browther e bllokoi këtë shkarkim sepse skedari është mashtrues dhe mund të bëjë ndryshime të papritura në pajisjen tënde</translation>
<translation id="6160571936643742128">Do të shikosh një kërkesë për të provuar <ph name="FEATURE_NAME"/> herën tjetër kur të hapësh Browther për iOS.</translation>
<translation id="8380517409933452343">Fjalëkalimet e tua dhe të dhënat e tjera të Browther që ke ruajtur në "Llogarinë tënde të Browther" do të hiqen nga kjo pajisje. Për t'i përdorur përsëri në Browther, identifikohu përsëri.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Browther nuk përdoret për 1 minutë. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}other{Organizata jote i fshin automatikisht të dhënat e shfletimit kur Browther nuk përdoret për # minuta. Kjo mund të përfshijë historikun, plotësimin automatik dhe shkarkimet. Skedat e tua do të qëndrojnë të hapura.}}</translation>
<translation id="2126108037660393668">Skedari i shkarkuar nuk u verifikua.</translation>
<translation id="2135919691573380097">Raportoje këtë sajt</translation>
<translation id="2137162749895930932">Mbyll ekranin e përkthimit</translation>
<translation id="4283559398694996391">Browther e bllokoi këtë shkarkim sepse sajti nuk po përdor një lidhje të sigurt dhe mund të ketë pasur ndërhyrje te skedari</translation>
<translation id="2170098639895543546">Zgjidh çdo gjë në faqe</translation>
<translation id="2495182092286337191">Personalizo Browther</translation>
<translation id="2174917724755363426">Instalimi nuk përfundoi. E konfirmon që dëshiron ta anulosh?</translation>
<translation id="4877141231724140862">Browther - identifikimi në rrjet - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Gabim në kontrollin e përditësimeve: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Hiqe llogarinë nga Browther</translation>
<translation id="1084363153644366288">Qëndro më i sigurt në lëvizje me "Shfletimin e sigurt të përmirësuar" në Browther për iOS</translation>
<translation id="7949164640723239455">Sajt i rrezikshëm. Browther ka hequr njoftimet.</translation>
<translation id="2236949375853147973">Aktiviteti im</translation>
<translation id="4536403809133456417">Për të marrë adresat etj. në të gjitha pajisjet e tua, identifikohu në Browther. Kjo adresë do të ruhet në "Llogarinë tënde të Browther" pasi të identifikohesh.</translation>
<translation id="5627930103267312171">Nëse e ndan një kompjuter, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë Browther pikërisht ashtu si dëshirojnë.</translation>
<translation id="2283803047247799269">Kërko në këtë skedë me "Kërkimin e imazheve"</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther rekomandon vendosjen në pauzë të skedës që ngadalëson shfletuesin}other{Browther rekomandon vendosjen në pauzë të skedave që ngadalësojnë shfletuesin}}</translation>
<translation id="2307973900865360088">Mbaje në "Stacion"</translation>
<translation id="5161617112768367959">Kontrollon URL-të kundrejt një liste sajtesh të pasigurta të ruajtur në Browther. Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Browther mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqes, te "Shfletimi i sigurt".</translation>
<translation id="4123094831918713833">Ky veprim:
        <ph name="LINE_BREAKS"/>
          • Do të rivendosë disa cilësime të Browther dhe shkurtoret e Browther
          <ph name="LINE_BREAK"/>
          • Do të çaktivizojë shtesat
          <ph name="LINE_BREAK"/>
          • Do të fshijë kukit dhe të dhënat e tjera të përkohshme të sajtit
          <ph name="LINE_BREAKS"/>
          Faqeshënuesit, historiku dhe fjalëkalimet e ruajtura nuk do të preken.</translation>
<translation id="5456070119344236353">Për të dërguar një numër nga këtu te telefoni yt Android, identifikohu në Browther në të dyja pajisjet.</translation>
<translation id="2356070529366658676">Pyet</translation>
<translation id="2359808026110333948">Vazhdo</translation>
<translation id="6468415397021485143">Shtesa "<ph name="EXTENSION_NAME"/>" kërkon që të identifikohesh në Browther</translation>
<translation id="2558600429878197587">Çaktivizo ekzekutimin e Browther në sfond për aplikacionet</translation>
<translation id="5295781918312989856">Për ta përdorur këtë shtesë si <ph name="USER_EMAIL_ADDRESS"/>, identifikohu në Browther.</translation>
<translation id="8418845734693287262">ChromeOS nuk mund t'i sinkronizonte të dhënat e tua sepse detajet e identifikimit të llogarisë janë të papërditësuara.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{Një ose disa shtesa të Browther kanë pasur qasje në 1 pajisje HID}=1{Një ose disa shtesa të Browther kanë qasje në 1 pajisje HID}other{Një ose disa shtesa të Browther kanë qasje në # pajisje HID}}</translation>
<translation id="434258293817844111">Browther ka nevojë për lejet e kamerës dhe të mikrofonit për këtë sajt</translation>
<translation id="2403703063067034158">Gabim në nisje: aktualisht po ekzekutohet një shembull tjetër i konfigurimit; provo përsëri më vonë.</translation>
<translation id="5458993228789433099">Hap lidhjet në Browther nga çdo aplikacion dhe mbaje shfletuesin të qasshëm në shiritin e detyrave</translation>
<translation id="1677640217693742525">Me <ph name="BEGIN_LINK"/>veglat nga Browther<ph name="END_LINK"/>, mund të shfletosh në mënyrë të sigurt dhe të qëndrosh në kontroll</translation>
<translation id="2451727308784734061">Përdor shkurtoren tënde për të shkuar me shpejtësi te "Menaxheri i fjalëkalimeve". Mund ta zhvendosësh shkurtoren tënde tek ekrani bazë i kompjuterit ose te nisësi i aplikacionit.</translation>
<translation id="2280315911954332435">Browther do të mbyllet së shpejti</translation>
<translation id="6410820860979094113">Në Browther</translation>
<translation id="2485422356828889247">Çinstalo</translation>
<translation id="2513154137948333830">Nevojitet rindezja: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Zgjidh tekstin nga "Kërkimi nëpërmjet imazheve"</translation>
<translation id="7892218991241200190">Browther po përpiqet të zëvendësojë fjalëkalimet ekzistuese. Shkruaj fjalëkalimin tënd të Windows për ta lejuar këtë.</translation>
<translation id="8976443723926188033">Browther ka nevojë për qasje te hapësira ruajtëse për të shkarkuar skedarë</translation>
<translation id="4131374838781785973">Ndihmuesi i Browther Origin</translation>
<translation id="2575822587468774919">Zgjidh çdo gjë për të kërkuar me "Kërkimin nëpërmjet imazheve"</translation>
<translation id="8705561858232289221">Për të marrë fjalëkalimet etj. në të gjitha pajisjet e tua, identifikohu në Browther</translation>
<translation id="437162022240011372">Vazhdo të përdorësh Browther</translation>
<translation id="259935314519650377">Instaluesi i shkarkuar nuk u ruajt te memoria specifike. Gabim: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistemi</translation>
<translation id="2907676829052962091">Organizata jote mund të shikojë dhe të menaxhojë të dhënat e shfletimit, si p.sh. faqeshënuesit, historikun dhe fjalëkalimet e tua. Ajo nuk mund të shikojë të dhënat e shfletimit në profilet e tjera të Browther</translation>
<translation id="1289116577679005654">Verifiko që je ti për të përdorur dhe ruajtur të dhënat e Browther në llogarinë tënde <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7192278346779151664">Ndodhi një gabim në sistemin operativ gjatë instalimit. Shkarko përsëri Browther.</translation>
<translation id="7724398260867885339">Nëse e ndan një pajisje, miqtë dhe familja mund të shfletojnë veçmas dhe ta konfigurojnë Browther pikërisht ashtu si dëshirojnë</translation>
<translation id="1679595317134614424">Skeda Browther</translation>
<translation id="7189168846924379421">Për më shumë siguri, Browther do t'i enkriptojë të dhënat e tua.</translation>
<translation id="4052643592793184278">Për ta hequr "Llogarinë tënde të Browther" nga Browther, dil nga llogaria</translation>
<translation id="7694616023994438906">Për të marrë fjalëkalimet, faqeshënuesit etj. në të gjitha pajisjet e tua, identifikohu në Browther</translation>
<translation id="2738871930057338499">Lidhja me internetin nuk mund të kryhej. HTTP 403 (E ndaluar). Kontrollo konfigurimin e proxy-t.</translation>
<translation id="2753623023919742414">Kliko për të kërkuar</translation>
<translation id="9078193405195503710">Cakto Browther si shikuesin e parazgjedhur të skedarëve PDF</translation>
<translation id="2456995288904753506">Browther mund të plotësojë automatikisht fushat e vështira që mund të mos mbulohen nga plotësimi automatik standard</translation>
<translation id="3271730304285122987">Kjo shtesë përmban softuerë keqdashës dhe nuk është e sigurt. Hiqe atë nga Browther që të mos arrijë të shikojë dhe të ndryshojë më të dhënat e tua në sajtin që viziton ti, duke përfshirë informacionet e tua personale.</translation>
<translation id="2799223571221894425">Nis sërish</translation>
<translation id="1427337251963884503">Shfletuesi yt Browther</translation>
<translation id="2816462166102338036">Kërkoje këtë video me "Kërkimin e imazheve"</translation>
<translation id="2841525013647267359">Përkthe nga</translation>
<translation id="2846251086934905009">Gabim gjatë instalimit: Instaluesi nuk përfundoi. Instalimi është ndërprerë.</translation>
<translation id="928966105228355994">Hiqe nga Browther...</translation>
<translation id="587805782197019018">Të mban të sigurt në Browther dhe mund të përdoret për të përmirësuar sigurinë tënde në aplikacionet e tjera të Browther kur je identifikuar</translation>
<translation id="2885378588091291677">Menaxheri i detyrave</translation>
<translation id="3055995278166070443">Rreth &amp;Browther</translation>
<translation id="2915996080311180594">Rinise më vonë</translation>
<translation id="2928420929544864228">Instalimi përfundoi.</translation>
<translation id="70453521937551896">Të dhënat e tua janë të enkriptuara me frazën tënde të kalimit. Fute atë për të përdorur dhe ruajtur të dhënat e Browther në "Llogarinë tënde të Browther".</translation>
<translation id="2945997411976714835">Gabim gjatë instalimit: Nisja e procesit të instaluesit dështoi.</translation>
<translation id="3188308520233701133">Identifikohu më shpejt në sajte duke përdorur fjalëkalimet e ruajtura për Browther në iOS</translation>
<translation id="8145318807880784886">Shto një profil të ri të Browther për t'i mbajtur të veçuar faqeshënuesit, fjalëkalimet dhe cilësimet.</translation>
<translation id="4330268530227888227">Organizata jote menaxhon Browther</translation>
<translation id="6488090896442998436">Browther është i përditësuar</translation>
<translation id="300557164611864786">Nëse një sajt përpiqet të vjedhë fjalëkalimin tënd ose kur shkarkon një skedar të dëmshëm, Browther mund t'i dërgojë gjithashtu URL-të, duke përfshirë pjesë të përmbajtjes së faqeve, te "Shfletimi i sigurt".</translation>
<translation id="2447145782593796785">Për të qëndruar më i sigurt online me zgjedhjet e prindit tënd, identifikohu në Browther</translation>
<translation id="3003694935412297923">Të gjitha detyrat</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther duhet të verifikojë që je ti përpara se të mund të ruhen disa të dhëna në "Llogarinë tënde të Browther" dhe të përdoren në të gjitha pajisjet e tua. Nëse del tani, këto të dhëna (1 artikull) do të fshihen.}other{Browther duhet të verifikojë që je ti përpara se të mund të ruhen disa të dhëna në "Llogarinë tënde të Browther" dhe të përdoren në të gjitha pajisjet e tua. Nëse del tani, këto të dhëna ({count} artikuj) do të fshihen.}}</translation>
<translation id="5522228731050510047">Hap <ph name="URL"/> në një skedë të re në Browther.</translation>
<translation id="6358780591055960280">Browther nuk mund t'i kontrollojë fjalëkalimet e tua. Provo përsëri më vonë.</translation>
