<translation id="8762228142105311329">{COUNT, plural,
              =0 {Perlindungan Tingkat Lanjut mengharuskan Anda menjalankan ulang Browther untuk menerapkan pembaruan}
              =1 {Perlindungan Tingkat Lanjut mengharuskan Anda menjalankan ulang Browther untuk menerapkan pembaruan. Jendela Pribadi Anda tidak akan terbuka kembali.}
