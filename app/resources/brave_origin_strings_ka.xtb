<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1026101648481255140">ინსტალაციის გაგრძელება</translation>
<translation id="7099479769133613710">ხელახლა გაშვება &amp;ChromeOS-ის გასაახლებლად</translation>
<translation id="7264054672589027446">Browther გირჩევთ, შეამოწმოთ ეს გაფართოება</translation>
<translation id="7848219163187166649">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Browther გამოიყენებს Browther-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Browther-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="8837164267124113709">თქვენმა მშობელმა გამორთო „ნებართვები საიტებისთვის, აპებისა და გაფართოებებისთვის“ Browther-ისთვის</translation>
<translation id="881513728707488138">Browther ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="112640046208448578">მოახდინეთ საგნების თუ ადგილების იდენტიფიცირება, დააკოპირეთ ან თარგმნეთ ტექსტი. სურათების ძიების გამოყენებისას გვერდის ეკრანის ანაბეჭდი იგზავნება სერვერზე. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="6580138787163923852"><ph name="BEGIN_LINK"/>შედით Browther-ში<ph name="END_LINK"/>, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1089111274164380772">დაწკაპუნებით აირჩიეთ Browther-ის მენიუ</translation>
<translation id="1157985233335035034">ბოლოდროინდელი ენები</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/>-მა დაამატა გაფართოება, რომელმაც შეიძლება შეცვალოს Browther-ის მუშაობის პრინციპი.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">ინსტალაცია ვერ მოხერხდა, რადგან Windows-ის თქვენი ვერსია არ არის მხარდაჭერილი.</translation>
<translation id="8291401179516272335">Browther-ის შესახებ</translation>
<translation id="1203500561924088507">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="1232234696885483911">სურათების ძიების გახსნისას გვერდის სათაური, URL და კონტენტი, PDF-ების ჩათვლით, ავტომატურად გაიგზავნება სერვერზე. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">როცა შესული ხართ, Browther-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Browther ანგარიშიდან. ამ პარამეტრის შესაცვლელად გახსენით „თქვენი ანგარიში Browther-ში“.</translation>
<translation id="9034321258761608912">სანამ ეს ჩანართი უმოქმედო იყო, Browther-ის სისწრაფის შესანარჩუნებლად მეხსიერება გათავისუფლდა. სურვილისამებრ, შეგიძლიათ აირჩიოთ, რომ ეს საიტი ყოველთვის გამოირიცხოს უმოქმედოთა რიგებიდან.</translation>
<translation id="249571811018731941">Browther-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი სახიფათოა</translation>
<translation id="8850227089720975601">Browther სერვისებში, მაგალითად, Gmail-სა თუ YouTube-ში <ph name="USER_EMAIL"/>-ით შესვლისას შეგიძლიათ Browther-შიც იმავე ანგარიშით შეხვიდეთ</translation>
<translation id="1290883685122687410">დაყენების შეცდომა: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">შექმენით ახალი Browther პროფილი</translation>
<translation id="4437862975743821367">Browther საჭიროებს Bluetooth-ს, რომ აღმოაჩინოს 
 Bluetooth მოწყობილობები. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">ენის ამოცნობა</translation>
<translation id="1206925267243987362">გამოიყენეთ Browther-ის ბრაუზერის რეკომენდებული პარამეტრები</translation>
<translation id="8270483548049772782">ასევე, წაიშალოს მონაცემები Browther-იდან (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">ჩამაგრებულია! სურათების ძიებაზე წვდომა შეგიძლიათ ხელსაწყოთა ზოლში ღილაკით „ახალი“</translation>
<translation id="1356661055722410047">სიახლე! თქვენს ეკრანზე შეგიძლიათ, თარგმნოთ ტექსტი და სურათები</translation>
<translation id="1383876407941801731">ძიება</translation>
<translation id="1592588950737518481">Browther პროფილების &amp;მართვა</translation>
<translation id="1404026649028693342">AI რეჟიმის ყოველთვის ჩვენება</translation>
<translation id="141901961143729572">გაგვიზიარეთ თქვენი მოსაზრებები</translation>
<translation id="1743952081001089298">თქვენი ფანჯრის გასაზიარებლად დაუშვით ეკრანის ჩაწერა Browther-ისთვის სისტემის პარამეტრებში.</translation>
<translation id="8627385813382688019">დახმარების მიღება Browther for Testing-თან დაკავშირებით</translation>
<translation id="1497802159252041924">შეცდომა ინსტალაციისას: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ეს გვერდი დაცულია</translation>
<translation id="7252430412915798987">Browther ჩანართის გაზიარება</translation>
<translation id="6388429281015199562">Browther-ში შესვლა</translation>
<translation id="1547469039832541117">დაასრულებს მონიშნულ ამოცანას.</translation>
<translation id="1801944307203212016">Browther საჭიროებს თქვენს კამერაზე წვდომის ნებართვას, თქვენი გარემოს 3-განზომილებიანი რუკის შექმნა რომ შეძლოს</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{ეს გაფართოება აღარ არის მხარდაჭერილი. Browther გირჩევთ მის ამოშლას.}other{ეს გაფართოებები აღარ არის მხარდაჭერილი. Browther გირჩევთ, ამოშალოთ ისინი.}}</translation>
<translation id="4667068923142532753">Browther-ის ჩამაგრება</translation>
<translation id="3006560544901646947">Browther-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="686052171138185761">Browther-ს სურს თქვენი პაროლების მმართველის მონაცემების წაშლა. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="8713026329083542796">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Browther-ში</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1680687534629375545">სურათების ძიებისთვის ამ გვერდის შესახებ შეკითხვა</translation>
<translation id="1709772298389099340">უზრუნველყოფს მაღალ პრივილეგიებს <ph name="BROWSER_NAME"/>-ისთვის.</translation>
<translation id="4243382967656566037">ამ ფუნქციების გაუმჯობესების მიზნით, თქვენს მათთან ურთიერთქმედებას Browther გაუგზავნის Browther-ს. აღნიშნული მონაცემების წაკითხვა, დამუშავება და ანოტირება, შესაძლოა, განხორციელდეს ადამიანი მიმომხილველების მიერ.</translation>
<translation id="1722488837206509557">ამის საშუალებით თქვენ აირჩევთ ხელმისაწვდომი მოწყობილობებიდან და მათზე კონტენტს აჩვენებთ.</translation>
<translation id="6820510278633522408">Browther მალე წაშლის დათვალიერების მონაცემებს</translation>
<translation id="7775028004939172516">Browther შეეცდება, გადაიტანოს ნავიგაცია HTTPS-ზე</translation>
<translation id="6963959729951758069">Browther-ის მონაცემები გასუფთავდა</translation>
<translation id="4085139922884095932">Browther გაეშვება <ph name="REMAINING_TIME"/>-ში</translation>
<translation id="2586248102295515296">როცა HTTPS მიუწვდომელია, Browther გამოიყენებს დაუცველ კავშირს თქვენი გაფრთხილების გარეშე</translation>
<translation id="3975328336074677101">დავრთოთ ნება Browther-ს გაშვებული იყოს ფონურ რეჟიმში</translation>
<translation id="2497443204974841650">Browther-ის ხელახალი ინსტალაცია</translation>
<translation id="1724309687045787742">Browther ცდილობს შემდეგს: <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">შემდეგ ჯერზე, როცა გახსნით Browther-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას Browther პაროლების მმართველის გამოყენების შესახებ.</translation>
<translation id="1838374766361614909">ძიების გასუფთავება</translation>
<translation id="2337233040802538155">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Browther ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK"/>გამოდით Browther-იდან<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">ჩამოტვირთეთ Browther თქვენს ტელეფონში, რომ გახსნათ ან შექმნათ ჩანართების ახალი ჯგუფები გზიდან.</translation>
<translation id="2063443520349987970">შეგიძლიათ მართოთ თქვენი სისტემაში შესული Browther ანგარიშები. თქვენი Browther ანგარიშები გამოიყენება Browther ბრაუზერისთვის, Play Store-ისთვის, Gmail-ისთვის და სხვა პროდუქტებისთვის. თუ სხვისი, მაგალითად, ოჯახის წევრის, ანგარიშის დამატება გსურთ, სანაცვლოდ დაამატეთ ახალი პიროვნება თქვენს <ph name="DEVICE_TYPE"/>-ს. <ph name="LINK_BEGIN"/>შეიტყვეთ მეტი<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">სურათების ძიებით მოძიება</translation>
<translation id="1880677175115548835">ტექსტის არჩევა</translation>
<translation id="3183933389992069620">თქვენ შედიხართ სისტემაში მართული ანგარიშით და ამით აძლევთ ადმინისტრატორს კონტროლს თქვენს Browther-ის პროფილზე. თქვენი Browther-ის მონაცემები, როგორიცაა პროგრამები, სანიშნეები, ისტორია, პაროლები და სხვა პარამეტრები სამუდამოდ მიემაგრება <ph name="USER_NAME"/>-ს. თქვენ შეძლებთ ამ მონაცემების წაშლას Browther ანგარიშების საინფორმაციო დაფის მეშვეობით, თუმცა ამ მონაცემების დაკავშირებას სხვა ანგარიშთან ვერ შეძლებთ. სურვილისამებრ, შეგიძლიათ შექმნათ ახალი პროფილი, არსებული Browther-ის მონაცემების ცალკე შესანახად. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther დაზოგავს ბატარეის მუხტს ვიზუალური ეფექტებისა (მაგალითად, ლივლივა გადაადგილებისა და ვიდეოკადრების სიხშირის) და ფონური აქტივობის შეზღუდვის გზით. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი ენერგიის დამზოგის შესახებ<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">იკითხეთ ამ გვერდის შესახებ</translation>
<translation id="9128006428501241840">Browther-ის განმაახლებელი სერვისი</translation>
<translation id="6302815314157879372">ამ პარამეტრის გამორთვის შემთხვევაში, Browther-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Browther-ში შესვლის გარეშე</translation>
<translation id="1063611196035804685">Browther არ პასუხობს. გავუშვათ ხელახლა?</translation>
<translation id="2873360330889594383">თქვენი ორგანიზაცია, <ph name="MANAGER"/>, მოითხოვს, რომ Browther-ში შეხვიდეთ</translation>
<translation id="4035053306113201399">განახლების მისასადაგებლად ChromeOS უნდა გადაიტვირთოს.</translation>
<translation id="2861285003831382718">Browther-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ამ ტიპის ფაილს, როგორც წესი, არ ტვირთავენ ხოლმე და ის, შესაძლოა, სახიფათო იყოს</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE"/> წუთი</translation>
<translation id="2080160985220483492">Browther მინიშნება: პაროლების შენახვა</translation>
<translation id="8037497710694492565">Browther ნაგულისხმევ ბრაუზერს ვერ საზღვრავს, ან ვერ აყენებს</translation>
<translation id="7395009124247513849">შეიტყვეთ, რატომ ბლოკავს Browther ზოგიერთ ფაილს, გაიხსნება ახალ ჩანართში</translation>
<translation id="762710512520170632">იზრუნებს, რომ თქვენი Browther-ის პროგრამული უზრუნველყოფა განახლებული იყოს. თუ ეს სერვისი გაითიშება ან შეჩერდება, Browther-ის პროგრამული უზრუნველყოფა აღარ განახლდება, რაც იმას ნიშნავს, რომ უსაფრთხოებასთან დაკავშირებული პოტენციური საფრთხეების აღმოფხვრა აღარ მოხდება და ფუნქციებმა შეიძლება არ იმუშაოს. ეს სერვისი დეინსტალირდება, როცა მისით მოსარგებლე Browther-ის პროგრამული უზრუნველყოფა არ არსებობს.</translation>
<translation id="5793588180426267429">ეს მოქმედება წაშლის 1 ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Browther-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="6351516710581760512"><ph name="BEGIN_LINK"/>შედით Browther-ში<ph name="END_LINK"/>, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს სხვა პაროლებს.</translation>
<translation id="2039417478970545937">პარამეტრები.</translation>
<translation id="8194525816714210105">აირჩიეთ, დაერთოს თუ არა Browther ისტორია, Browther სერვისებში უფრო პერსონალიზებული ფუნქციებით რომ ისარგებლოთ</translation>
<translation id="5909559127548969159">დააწკაპუნეთ ღილაკზე „Browther-ის მორგება“ ახალი ჩანართის გვერდზე, რათა Browther-ს ახალი იერი შესძინოთ</translation>
<translation id="2066690553719545730">AI რეჟიმის ყოველთვის ჩვენება</translation>
<translation id="3283892260110318935">Browther-მა დაბლოკა ეს ჩამოტვირთვა, რადგან ეს ფაილი შეცდომაში შემყვანია და მას შეუძლია მოულოდნელი ცვლილებების განხორციელება თქვენს მოწყობილობაზე</translation>
<translation id="6160571936643742128">Browther iOS-ის მომდევნო ჯერზე გახსნისას ნახავთ მოთხოვნას <ph name="FEATURE_NAME"/>-ის ცდის შესახებ.</translation>
<translation id="8380517409933452343">თქვენი პაროლები და Browther-ის სხვა მონაცემები, რომლებიც შენახულია თქვენს Browther ანგარიშში, ამოიშლება ამ მოწყობილობიდან. Browther-ში რომ ისინი ხელახლა გამოიყენოთ, საჭიროა ანგარიშში შესვლა.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Browther არ გამოიყენება 1 წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}other{თქვენი ორგანიზაცია ავტომატურად შლის დათვალიერების მონაცემებს, როცა Browther არ გამოიყენება # წუთის განმავლობაში. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს. თქვენი ჩანართები გახსნილი დარჩება.}}</translation>
