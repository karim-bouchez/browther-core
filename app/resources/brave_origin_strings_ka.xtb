<translation id="4434353761996769206">ინსტალატორის შეცდომა: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> მართავს Browther-ს</translation>
<translation id="4007482010626246887">Browther პროფილის დამატება</translation>
<translation id="6888322430074420631">Browther for Testing-ის შესახებ</translation>
<translation id="8912436499620582668">თქვენს Browther ანგარიშში Browther-ის მონაცემები რომ გამოიყენოთ და შეინახოთ, შეიყვანეთ თქვენი საიდუმლო ფრაზა</translation>
<translation id="4493028449971051158">გაშვების შეცდომა: ინსტალატორი გაუშვით, როგორც ადმინისტრატორმა.</translation>
<translation id="4501471624619070934">ინსტალაცია ვერ მოხერხდა, რადგან წვდომა შეზღუდულია ამ ქვეყანაში</translation>
<translation id="8976207309012239417">ამ გაფართოებას არ გამოუქვეყნებია კონფიდენციალური ინფორმაციის გამოყენების პრაქტიკა, მაგალითად, მონაცემების შეგროვებისა და გამოყენების წესები. Browther გირჩევთ მის ამოშლას.</translation>
<translation id="8888202093812883067">მოგესალმებით Browther Origin-ში; გახსნილია ბრაუზერის ახალი ფანჯარა</translation>
<translation id="6391148383688605718">თქვენი გარემოს მოსანიშნად და თქვენი ხელებისთვის თვალის მიდევნებისთვის Browther საჭრიროებს ნებართვას</translation>
<translation id="7756445485815468244">თქვენ უკვე შესული ხართ Browther-ის სხვა პროფილში როგორც <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="137435413163730206">Browther წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK"/>შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">გააძლიერეთ ონლაინ უსაფრთხოება ყველასთვის, როცა მოხსენებას გაგზავნით საიტის შესახებ, რომელიც, თქვენი აზრით, საზიანოა.</translation>
<translation id="3266647901351304597">Browther-მა დაბლოკა ეს ჩამოტვირთვა, რადგან Safe Browsing გამორთეთ და ფაილის შემოწმება ვერ ხერხდება</translation>
<translation id="6980208900390333646">ცადეთ Google Lens Browther-ით თქვენს ტელეფონში</translation>
<translation id="4594305310729380060">პაროლების მმართველში ამ მოწყობილობაზე</translation>
<translation id="5282047884678321451">Browther Origin პროგრამები</translation>
<translation id="4598116752460667024">სიიდან ნებისმიერი პროცესის მოძიება.</translation>
<translation id="4970880042055371251">ChromeOS-ის ვერსია</translation>
<translation id="4482468019601425607">განახლება თითქმის მზად არის! დასასრულებლად, ხელახლა გაუშვით Browther.</translation>
<translation id="5517890123509214766">აჩქარებს Browther-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Browther ოდნავ ნაკლებად უძლებს შეტევებს</translation>
<translation id="7690070364551268156">თუ Browther-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="5020487088453637212">როგორც ჩანს, პროფილი გამოიყენება სხვა Browther პროცესის მიერ (<ph name="PROCESS_ID"/>) სხვა კომპიუტერში (<ph name="HOST_NAME"/>). Browther-მა დაბლოკა პროფილი, რათა არ დაზიანდეს. თუ დარწმუნებული ხართ, რომ სხვა პროცესები არ იყენებენ ამ პროფილს, შეგიძლიათ განბლოკოთ პროფილი და ხელახლა გაუშვათ Browther.</translation>
<translation id="4680828127924988555">ინსტალაციის გაუქმება</translation>
<translation id="8134827615154347946">თქვენი Browther-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Browther ანგარიშში. სისტემიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში, აღნიშნული მონაცემები წაიშლება.</translation>
<translation id="3508712423420506333">როცა შესული ხართ, Browther-ში შეგიძლიათ გამოიყენოთ თქვენი პაროლები და სხვა კონტენტი თქვენი Browther ანგარიშიდან. <ph name="SHORTCUT"/> შეცვლის თქვენი Browther სერვისების პარამეტრებს.</translation>
<translation id="2388739442635757494">Browther-ში უკვე განხორციელდა შესვლა ამ კომპიუტერიდან, როგორც <ph name="ACCOUNT_EMAIL_LAST"/>. გთხოვთ, შექმნათ Browther-ის ახალი მომხმარებელი თქვენი ინფორმაციის ცალკე შესანახად.</translation>
<translation id="4724676981607797757">ინსტალაცია ვერ მოხერხდა მხარდაუჭერელი პროტოკოლის შეცდომის გამო.</translation>
<translation id="8305313684264112434">მაინც გსურთ Browther-იდან გასვლა?</translation>
<translation id="418155915144835101">Browther-ს ეს-ესაა მიესადაგა უსაფრთხოების საგანგებო განახლება. გადატვირთეთ ის ახლავე (თქვენი ჩანართები აღდგება).</translation>
<translation id="2683970367518529374">ჰკითხეთ Browther-ს</translation>
<translation id="5064473048847774331">ბოლო დროს არ ყოფილხართ. Browther-მა ამოშალა <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> და კიდევ <ph name="COUNT"/>.</translation>
<translation id="5941343075741207533">Browther ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში ან <ph name="BEGIN_LINK"/>შეამოწმეთ პაროლები თქვენს Browther ანგარიშში<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">ეს ფუნქცია იყენებს მართლწერის იმ შემმოწმებელს, რომელიც გამოიყენება Brave Search-ში. ბრაუზერში თქვენ მიერ აკრეფილი ტექსტი ეგზავნება Browther-ს. ამ ქცევის შეცვლა ნებისმიერ დროს შეგიძლიათ პარამეტრებიდან.</translation>
<translation id="4581078588976787792">Browther-ის გამოყენება ანგარიშის გარეშე</translation>
