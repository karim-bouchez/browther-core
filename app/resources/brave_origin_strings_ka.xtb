<translation id="6715003312952407375">გასაგრძელებლად შედით Browther-ში ანგარიშით <ph name="EMAIL"/>. ამგვარად თქვენს ხელთ იქნება თქვენი ორგანიზაციის დებულებები.</translation>
<translation id="1897845318651970239">Browther-ის ლოგო კომპიუტერის ეკრანზე.</translation>
<translation id="4702069255970029302">Browther Origin არის ვებ ბრაუზერი, რომელიც ვებგვერდებს და აპლიკაციებს ელვისებური სისწრაფით ხსნის. ის არის სწრაფი, სტაბილური და გამოსაყენებლად მარტივი. დაათვალიერეთ ვები უფრო უსაფრთხოდ Browther Origin-ში ჩაშენებული საზიანო პროგრამული უზრუნველყოფისა და თაღლითობისგან დაცვის საშუალებით.</translation>
<translation id="5669767676913031391">Browther უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს</translation>
<translation id="6436260184216827876">სურათების ძიება მიუწვდომელია. ცადეთ მოგვიანებით.</translation>
<translation id="2139300032719313227">გადატვირთეთ ChromeOS</translation>
<translation id="6110616900529884221">Browther წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="1217194059001819677">ჩამოტვირთეთ Browther თქვენს ტელეფონში, რომ თვალი ადევნოთ ფასებს და მიიღოთ გაფრთხილებები, როცა რომელიმე საიტზე ფასი დაიკლებს</translation>
<translation id="7058555680120557198">გამორთული • Browther ვერ ადასტურებს ამ გაფართოების წარმომავლობას</translation>
<translation id="676533642429632127">მოგესალმებათ Browther პროფილები</translation>
<translation id="5518682889576009702">შემდეგ ჯერზე, როცა გახსნით Browther-ს თქვენს <ph name="DEVICE_TYPE"/>-ში, დაინახავთ მოთხოვნას ჩანართების ჯგუფების გამოყენების შესახებ.</translation>
<translation id="6038105561107837619">ანგარიშის ამოშლა Browther-იდან</translation>
<translation id="2675662665675552980">იგი ასევე აკონტროლებს, თუ რომელი გვერდი გამოჩნდება Browther-ის გაშვებისას.</translation>
<translation id="648319183876919572">გაძლიერებული Safe Browsing მეტად გიცავთ სახიფათო ვებსაიტებისა და ჩამოტვირთვებისგან</translation>
<translation id="2930243146591999795">Browther-ის დეინსტალაცია</translation>
<translation id="5241183382286817629">მალსახმობები იხსნება Browther-ში</translation>
<translation id="7907014599435829661">თქვენი ორგანიზაცია ხურავს Browther-ს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. დათვალიერების მონაცემები წაიშალა. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="2088471423667794811">თითოეულ პროფილში ინახება საკუთარი Browther ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="9040334484455218184">შეიტყვეთ მეტი იმის შესახებ, თუ <ph name="BEGIN_LINK"/>როგორ ინარჩუნებს Browther თქვენი მონაცემების კონფიდენციალურობას<ph name="END_LINK"/></translation>
<translation id="1718697235867382480">ამ პარამეტრის ცვლილება ამოქმედდება Browther-ის გადატვირთვისთანავე.</translation>
<translation id="6331317152404762758">ახლა შეგიძლიათ გადართვა, პაროლები სხვა Browther პროფილიდან რომ ნახოთ</translation>
<translation id="6097706403184348562">მართლწერის შეცდომების გასასწორებლად, Browther თქვენ მიერ ტექსტის ველში აკრეფილ ტექსტებს Browther-ს უგზავნის</translation>
<translation id="2319647238307402812">Browther-ის შეტყობინების პარამეტრებზე გადასვლა</translation>
<translation id="6600016381025017075">მოძებნეთ ნებისმიერი რამ ამ გვერდზე</translation>
<translation id="8031938899816118394">თქვენი ცვლილებები გააქტიურდება Browther-ის შემდეგი გაშვებისას.</translation>
<translation id="7412185356697187964">Browther ახლა Windows-ის ჩართვისას გაეშვება, რათა დათვალიერება მომენტალურად დაიწყოთ. ამის გამორთვა პარამეტრებიდან შეგიძლიათ.</translation>
<translation id="9123343592576384616">გააგრძელეთ იქიდან, სადაც გაჩერდით: Browther-მა აღადგინა ჩანართები თქვენი ბოლო სესიიდან. ამის გამორთვა შეგიძლიათ აქ:</translation>
<translation id="5847926498049048567">თქვენი შემოგარენის 3-განზომილებიანი რუკის შესაქმნელად Browther საჭიროებს მეხსიერებაზე წვდომის ნებართვას</translation>
<translation id="5532585028508811858">თუ თქვენს სანიშნეებს Browther ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Browther-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="6676384891291319759">წვდომა ინტერნეტზე</translation>
<translation id="1363996462118479832">ChromeOS-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="3373239673945775810">ამ აპის მონაცემების Browther-იდან ამოშლა</translation>
<translation id="8122759674786039814">Browther გაძლევთ მეტ კონტროლს თქვენთვის ხილულ რეკლამაზე. ის, ასევე, ზღუდავს იმას, თუ რომელ საიტებს შეუძლია თქვენ შესახებ ინფორმაციის მიღება, როცა მათ მიერ თქვენთვის ნაჩვენებია პერსონალიზებული რეკლამა.</translation>
<translation id="6277682530398500159">Browther საჭიროებს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="6712881677154121168">შეცდომა ჩამოტვირთვისას: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="2972046656127603037">თქვენი პროფილის გამოყენება შეუძლებელია, რადგან ის Browther-ის უახლესი ვერსიიდანაა.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს. გთხოვთ მიუთითოთ სხვადასხვა პროფილის დირექტორია ან გამოიყენეთ Browther-ის ახალი ვერსია.</translation>
<translation id="871671753163165892">პერსონალიზაციის და სხვა ფუნქციებით რომ ისარგებლოთ, დაურთეთ Browther როგორც ვებსა და აპებში აქტივობას, ისე მიბმულ Browther სერვისებს</translation>
<translation id="5000832110229523807">Browther უკვე დაინსტალირებულია თქვენი კომპიუტერის ყველა მომხმარებლისთვის.</translation>
<translation id="5204575479550973859">შედით Browther-ში, რომ მიიღოთ სანიშნეები და სხვა მონაცემები თქვენს ყველა მოწყობილობაზე. შესვლის შემდეგ ეს სანიშნე შეინახება თქვენს Browther ანგარიშში.</translation>
<translation id="2874208284092283937">აჩქარებს Browther-ის V8 მექანიზმის მქონე საიტების მუშაობას, მაგრამ Browther ოდნავ ნაკლებად უძლებს შეტევებს. ეს პარამეტრი ჩართულია.</translation>
<translation id="3268577459683869744">{count,plural, =1{თქვენი Browther-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Browther ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები (1 ერთეული) წაიშლება.}other{თქვენი Browther-ის ზოგიერთი მონაცემი ჯერ არ შენახულა თქვენს Browther ანგარიშში. ანგარიშიდან გასვლამდე მოითმინეთ რამდენიმე წუთი. ახლა გასვლის შემთხვევაში აღნიშნული მონაცემები ({count} ერთეული) წაიშლება.}}</translation>
<translation id="7683816018918395929">Browther გირჩევთ, დაასკანიროთ ეს ფაილი, რადგან ის შეიძლება სახიფათო იყოს.</translation>
<translation id="1547295885616600893">ChromeOS-ს უზრუნველყოფს დამატებითი <ph name="BEGIN_LINK_CROS_OSS"/>ღია წყაროს პროგრამული უზრუნველყოფა<ph name="END_LINK_CROS_OSS"/>.</translation>
<translation id="6831043979455480757">თარგმნა</translation>
<translation id="2142653375108595728">Browther გაცნობებთ, თუ თქვენს პაროლებს ვინმე გატეხავს</translation>
<translation id="684888714667046800">ინტერნეტთან დაკავშირება ვერ ხერხდება. თუ ქსელის დაცვას იყენებთ, დარწმუნდით, რომ <ph name="PRODUCT_EXE_NAME"/> დაშვებულთა სიაშია.</translation>
<translation id="7333549743055076502">Browther — <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">შეეხეთ გასაგრძელებლად</translation>
<translation id="6862030660799253820">სურათების ძიების მეშვეობით ამ სურათის ძიება</translation>
<translation id="3860339351709082396">Browther-მა აღმოაჩინა, რომ „<ph name="EXTENSION_NAME"/>“ შეიცავს მავნე პროგრამას</translation>
<translation id="6877155553248388166">ძიების არეალის ქვედა მარჯვენა კუთხე: მარჯვნივ <ph name="RIGHT"/>%, ქვემოთ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">კოპირება</translation>
<translation id="7804113502310231166">დააყენეთ Browther ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის თქვენს ამოცანათა ზოლში</translation>
<translation id="3228374215117173004">Browther პროფილების &amp;მართვა</translation>
<translation id="6934579572334859869">სურათების ძიებისთვის ამ სურათის შესახებ შეკითხვა</translation>
<translation id="5995328366516663808">თქვენ მიაღწიეთ Browther-ის <ph name="BOOKMARK_LIMIT"/> სანიშნის ლიმიტს, ამიტომ თქვენი ზოგიერთი სანიშნე ჯერ არ შენახულა თქვენს Browther ანგარიშში.

ახალი სანიშნეების შენახვა თქვენს ანგარიშში ვერ მოხერხდება, სანამ რამდენიმეს არ წაშლით. ახლა გასვლის შემთხვევაში შეუნახავი სანიშნები წაიშლება.</translation>
<translation id="6965382102122355670">კარგი</translation>
<translation id="4533562834763015352">სუსტი პაროლები ადვილი გამოსაცნობია, ამიტომ მიეცით საშუალება Browther-ს, <ph name="BEGIN_LINK"/>თქვენთვის შექმნას და დაიმახსოვროს ძლიერი პაროლები<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">ChromeOS პირობები</translation>
<translation id="5379058926689137454">Browther საჭიროებს თქვენს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="4684462982894889021">შეიყვანეთ თქვენი საიდუმლო ფრაზა, რომ გამოიყენოთ და შეინახოთ Browther-ის მონაცემები თქვენს ანგარიშში, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7011190694940573312">ინსტალაცია ვერ მოხერხდა, რადგან ოპერაციული სისტემის ეს ვერსია მხარდაჭერილი არ არის.</translation>
<translation id="7024536598735240744">შეცდომა ამოღებისას: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ინსტალაცია შეწყდა.</translation>
<translation id="8257174622576051374">მოირგეთ Browther</translation>
<translation id="7047386856539490735">გამოგადგათ ეს შედეგები?</translation>
<translation id="1772745060691790742">განაახლეთ Browther</translation>
<translation id="4937970118065051027">თუ სურათს არ ექნება სასარგებლო აღწერილობა, Browther შეეცდება მის უზრუნველყოფას. აღწერილობების შესაქმნელად სურათები იგზავნება Browther-ში.</translation>
<translation id="1594112132009288601">Browther for Testing-ის მორგება</translation>
<translation id="5915000938288527952">შეგიძლიათ გამოიყენოთ Browther, როცა შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე აწკაპუნებთ.</translation>
<translation id="8775664994493381735">ამოშალეთ <ph name="EXTENSION_NAME"/> Browther-იდან</translation>
<translation id="3276648807841991013">თქვენი ორგანიზაცია შლის Browther-ის მონაცემებს, როცა ის <ph name="TIMEOUT_DURATION"/> არ გამოიყენება. აღნიშნული, შესაძლოა, მოიცავდეს ისტორიას, ავტომატური შევსების მონაცემებსა და ჩამოტვირთვებს.</translation>
<translation id="4725226878394159809">Browther საჭიროებს კამერზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="8931474625901592021">Browther-ის გაშვება ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="8242947409070121799">Browther ვერ ახერხებს პაროლების შემოწმებას. ცადეთ 24 საათში.</translation>
<translation id="1737922827960215472">დატოვეთ Browther თქვენს სამაგრში, რომ მისი გახსნა ნებისმიერ დროს სწრაფად შეძლოთ</translation>
<translation id="335855266303176628">გამოიყენეთ Browther შეტყობინებებში, დოკუმენტებსა და სხვა აპებში არსებულ ბმულებზე ყოველი დაწკაპუნებისას.</translation>
<translation id="709455597778444012">დავალებათა მენეჯერი - Browther</translation>
<translation id="7147140345767587643">Browther-ის მიერ პროგნოზირებული თქვენი ინტერესები</translation>
<translation id="7337408274890534789">მომენტალურად დაიწყეთ დათვალიერება: Browther-ის გაშვება ახლა Windows-ის ჩართვისთანავე არის შესაძლებელი.</translation>
<translation id="7274695763216404502">ჩამაგრებულია! ისევ გამოიყენეთ სურათების ძიება ხელსაწყოთა ზოლიდან</translation>
<translation id="7288567540154601580">ჩანართები და გაფართოებები</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{Browther გირჩევთ, ამოშალოთ ის}other{Browther გირჩევთ, ამოშალოთ ისინი}}</translation>
<translation id="1527644038571473502">სისტემის აუდიოს გასაზიარებლად გახსენით სისტემის პარამეტრები და დაუშვით „მხოლოდ სისტემის აუდიოს ჩაწერა“ Browther-ისთვის. დაგჭირდებათ Browther-ის გადატვირთვა.</translation>
<translation id="1427913074981060872">რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Browther-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="1657652725060525338">მიმდინარეობს Browther-ის განახლება</translation>
<translation id="884846289464870238">თქვენი გამორჩეული ფაილი დაზიანებულია ან არასწორია.

Browther ვერ შეძლებს თქვენი პარამეტრების აღდგენას.</translation>
<translation id="7339898014177206373">ახალი ფანჯარა</translation>
<translation id="633044855886370183">თქვენი ვები, სანიშნეები და Browther-ის სხვა მასალა არის აქ.</translation>
<translation id="1185960088713242527">თქვენი დაშიფრული მონაცემების წაკითხვა შეუძლია მხოლოდ მას, ვინც თქვენი საიდუმლო ფრაზა იცის. საიდუმლო ფრაზა არ იგზავნება Browther-ში და არ ინახება მის მიერ. თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK"/>თქვენს ანგარიშში Browther მონაცემების<ph name="END_LINK"/> წაშლა მოგიწევთ.</translation>
<translation id="7125151836477182110">თქვენი სისტემის ადმინისტრატორმა მოახდინა Browther-ის კონფიგურაცია იმგვარად, რომ <ph name="TARGET_URL_HOSTNAME"/>-ზე წვდომისთვის საჭიროა <ph name="ALTERNATIVE_BROWSER_NAME"/>-ის გახსნა.</translation>
<translation id="7352651011704765696">რაღაც არასწორად წარიმართა</translation>
<translation id="6638123710106659002">მომავალში Browther-ის განახლებების მისაღებად დაგჭირდებათ macOS 13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 12-ს.</translation>
<translation id="7286289384512061761">ბოლო დროს არ ყოფილხართ. Browther-მა ამოშალა <ph name="PERMISSION_1"/> და <ph name="PERMISSION_2"/>.</translation>
<translation id="113593073175678746">ეს გაფართოება აღარ არის მხარდაჭერილი. Browther გირჩევთ მის ამოშლას.</translation>
<translation id="137615076640044304">გააგრძელეთ იქიდან, სადაც გაჩერდით: Browther აღადგენს თქვენს ჩანართებს ყოველი გადატვირთვის შემდეგ. ამის გამოსართავად გადადით</translation>
<translation id="5967238175620483220">Browther-ში პაროლების იმპორტი</translation>
<translation id="4935019315986703336"><ph name="PAGE_TITLE"/> — Browther Origin Dev</translation>
<translation id="7450541714075000668">ტექსტი დაკოპირდა</translation>
<translation id="7766009218653304791">Browther საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="5844418066487488520">თქვენი მიკროფონი რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK"/>სისტემის პარამეტრები<ph name="END_LINK"/> და მიანიჭეთ Browther-ს წვდომა</translation>
<translation id="8065480549334161841">Browther-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 7-ს.</translation>
<translation id="6299293759264950896">გსურთ Browther-ის ხელახლა გაშვება?</translation>
<translation id="180908550381040105">შეუძლებელია იმავე Browther-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Browther და ხელახლა სცადეთ.</translation>
<translation id="7625576878150380853">თქვენ შეინახავთ და გამოიყენეთ პაროლებსა და სხვა მონაცემებს Browther ანგარიშში, როცა Browther-ში შეხვალთ. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">საიტები, სავარაუდოდ, არ იმუშავებს მოლოდინისამებრ. Browther-ის ყველა ფანჯრის დახურვისას სისტემიდან გამოხვალთ საიტების უმეტესობაზე, გამონაკლისია თქვენი Browther ანგარიში, თუ მასში შესული ხართ Browther-იდან.</translation>
<translation id="7099370564362681943">{0,plural, =1{Browther ხელახლა გაეშვება 1 წუთში}other{Browther ხელახლა გაეშვება # წუთში}}</translation>
<translation id="3602613943932672197">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Browther-ს გაუუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ.</translation>
<translation id="8759568213742229377">გაუშვით Browther ავტომატურად, რომ მომენტალურად დაიწყოთ დათვალიერება.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ინსტალატორი</translation>
<translation id="8991800242749014880">Browther იყენებს თქვენს კამერას და მიკროფონს.</translation>
<translation id="2692328388439821508">Browther გაუმჯობესდა</translation>
<translation id="4318444066563223295">ახლა თქვენთვის ხელმისაწვდომია მეტი ფუნქცია Browther-ში</translation>
<translation id="7649070708921625228">დახმარება</translation>
<translation id="5591287320769313116">ნება დართეთ Browther-ს, დაათვალიეროს თქვენთვის</translation>
<translation id="7658239707568436148">გაუქმება</translation>
<translation id="6325482130534634729">Browther არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="8185915921134219287">მოახდინეთ Browther-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="5120421624925726813">Browther-ის განახლება</translation>
<translation id="7716950018788545737">ამოცანა(ები) დასრულდა.</translation>
<translation id="77283119132245232">უზრუნველყოფს სისტემის კონტროლის სერვისს <ph name="BROWSER_NAME"/>-ისთვის. თუ ეს სერვისი გათიშულია, ბრაუზერის მიერ შექმნილი ეფექტურობის ჩანაწერები არ მიიღებს მონაწილეობას სისტემის დონის მოვლენებში, როგორიცაა კონტექსტის გადართვა თუ მზა ნაკადების მოვლენები.</translation>
<translation id="6542096191573265107">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Browther-ში, როგორც <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">ინსტალერმა ვერ შექმნა დროებითი დირექტორია. გთხოვთ, გადაამოწმოთ დისკზე თავისუფალი სივრცე და პროგრამული უზრუნველყოფის დაყენების ნებართვა.</translation>
<translation id="351575328720488268">ნაგულისხმევ Browther-ზე გადაყენება</translation>
<translation id="1054170408395182418">დააყენეთ Browther ნაგულისხმევ ბრაუზერად და ჩაამაგრეთ ის ამოცანათა ზოლში</translation>
<translation id="4569594230301902490">ააჩქარეთ Browther-ის მუშაობა</translation>
<translation id="8041924294044943913"><ph name="PAGE_TITLE"/> — Browther Origin Canary</translation>
<translation id="7893465573639396635">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Browther იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="7810005234485217901">შეგიძლიათ, ჩაამაგროთ სურათების ძიება მასზე მარტივად წვდომისთვის</translation>
<translation id="2462631024103158515">Browther პროფილი ამ ანგარიშით უკვე არსებობს ამ მოწყობილობაზე</translation>
<translation id="7845233973568007926">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი კომპიუტერი უნდა გადატვირთოთ.</translation>
<translation id="311190437086049332">მოირგეთ Browther, რათა მას ახალი იერი შესძინოთ</translation>
<translation id="6728847658878265103">Browther ვერ განახლდა უახლეს ვერსიაზე, რომელსაც დამატებულ აქვს ახალი ფუნქციები და უსაფრთხოების სისტემის შესწორებები.</translation>
<translation id="7872446069773932638">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="SECONDS"/> წამი</translation>
<translation id="5374532739787768601">თუ საიდუმლო ფრაზა დაგავიწყდათ ან ამ პარამეტრის შეცვლა გსურთ, <ph name="BEGIN_LINK"/>წაშალეთ თქვენს ანგარიშში Browther მონაცემები<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">შეკითხვა ამ სურათის შესახებ</translation>
<translation id="9172499982238113829">Browther-ის დაყენება ნაგულისხმევად</translation>
<translation id="3313826726620159669">Browther ავტომატურად განაახლებს HTTPS-თან დაუცველ კავშირებს, როცა ეს შესაძლებელი იქნება</translation>
<translation id="3317928686912559532">თქვენ შესული ხართ Browther-ში როგორც <ph name="USER_EMAIL_ADDRESS"/>. გთხოვთ გამოიყენოთ იგივე ანგარიში ხელახლა შესვლისას.</translation>
<translation id="6007009085341946457">ეს Browther-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="8004582292198964060">ბრაუზერი</translation>
<translation id="8010081455002666927">ავტომატური ამოცნობა</translation>
<translation id="174885789898161653">Browther-ისთვის წვდომის მინიჭების შემდეგ ცალკეული ვებსაიტები შეძლებს თქვენგან წვდომის მოთხოვნას.</translation>
<translation id="3001754454174546602">ჩაამაგრეთ Browther ამოცანათა ზოლში, რომ ნებისმიერ დროს გამოიყენოთ ის</translation>
<translation id="80471789339884597">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME"/>-ის გამოყენებამდე თქვენი ყველა ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="8054112667659782652">სურათების ძიების მალსახმობის ყოველთვის ჩვენება</translation>
