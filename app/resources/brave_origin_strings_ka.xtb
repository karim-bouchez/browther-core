<translation id="6491100124044190139">მიიღეთ წვდომა მეტ მონაცემზე Browther-ში შესვლით</translation>
<translation id="1665840797775025867">მოირგეთ Browther</translation>
<translation id="4407047432656809023">Browther-მა შეიძლება არასწორად იმუშაოს, რადგან ის აღარ არის მხარდაჭერილი Windows XP-სა და Windows Vista-ზე</translation>
<translation id="945522503751344254">შეფასების გაგზავნა</translation>
<translation id="7620348044248809366">ვინ იყენებს Browther-ს?</translation>
<translation id="7299962884342109067">ისარგებლეთ Browther-ის უსაფრთხოების ყველაზე ძლიერი ფუნქციებით</translation>
<translation id="983803489796659991">ინსტალაცია ვერ მოხერხდა, რადგან განახლების სერვერს არ აქვს ამ აპლიკაციის ჰეშ-მონაცემები.</translation>
<translation id="8775461190334353148">Browther-ის გამოყენება ანგარიშის გარეშე</translation>
<translation id="7146761239544860058">Browther-ის ავტორები</translation>
<translation id="989970834842471429">მონიშნეთ ნებისმიერი ტექსტი თუ სურათი, რისი მოძებნაც გსურთ სურათების ძიებით</translation>
<translation id="6616551030373607751">თქვენი მდებარეობა რომ გამოიყენოთ, გახსენით <ph name="BEGIN_LINK"/>სისტემის პარამეტრები<ph name="END_LINK"/> და მიანიჭეთ Browther-ს წვდომა</translation>
<translation id="137466361146087520">Google Chrome Beta</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">ინსტალაცია ვერ განხორციელდა გაურკვეველი შეცდომის გამო. ხელახლა ჩამოტვირთეთ Browther.</translation>
<translation id="9074842261125908635">გაურკვეველი წყაროების გაფართოებებმა, აპლიკაციებმა და დიზაინმა შესაძლოა დააზიანოს თქვენი მოწყობილობა. Browther გირჩევთ დააყენოთ ისინი მხოლოდ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>-დან;</translation>
<translation id="3593119910409528681">ეს გაფართოება ეწინააღმდეგება ვებ-მაღაზიის პოლიტიკას და შესაძლოა იყოს უსაფრთხოების რისკი. უმჯობესია წაშალოთ Browther-დან, რათა აღარ ჰქონდეს წვდომა თქვენს მონაცემებზე, საიტებზე, რომლებსაც სტუმრობთ, და ასევე პირად ინფორმაციაზეც.</translation>
<translation id="5245976396374147971">გაფრთხილება: Browther ვერ აკონტროლებს გაფართოების მიერ თქვენი ბრაუზინგის ისტორიის შენახვას. პირად რეჟიმში მისი გამოყენების შეზღუდვისთვის გამორთეთ აღნიშნული პარამეტრი.</translation>
<translation id="3629539416935660172">Browther-ის უსაფრთხოების გასაუმჯობესებლად გამორთულია ზოგიერთი გაფართოება, რომელიც არ არის მითითებული <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>-ში და შესაძლოა თქვენი ნებართვის გარეშე იყოს დამატებული.</translation>
<translation id="157534302749986451">Browther-ის უსაფრთხოების გასაუმჯობესებლად გამორთულია ზოგიერთი გაფართოება, რომელიც არ არის მითითებული <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>-ში და შესაძლოა თქვენი ნებართვის გარეშე იყოს დამატებული.</translation>
