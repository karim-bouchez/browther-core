<translation id="6239161312595354541">इमेज शोध ला या व्हिडिओबद्दल विचारा</translation>
<translation id="1755464917870815989">Browther ला फाइल डाउनलोड करण्यासाठी स्टोरेज अ‍ॅक्सेस करण्याची परवानगी आवश्यक आहे</translation>
<translation id="304681001513922736">Browther मध्ये स्टोअर केलेल्या असुरक्षित साइटच्या सूचीसह URLs तपासते</translation>
<translation id="7785903492969539081">Browther ला डीफॉल्‍ट ब्राउझर बनवा</translation>
<translation id="3987833816263696343">Browther मधून साइन आउट करायचे?</translation>
<translation id="4723540739671534529">हे टॅब अतिरिक्त स्रोत वापरत आहेत. तुमच्या परफॉर्मन्समध्ये सुधारणा करण्यासाठी, Browther ला ते इनॅक्टिव्ह करू द्या.</translation>
<translation id="6540151687468239291">तुमची Browther प्रोफाइल कस्टमाइझ करा</translation>
<translation id="770793114032605647">तुमच्या Browther प्रोफाइलला नाव द्या</translation>
<translation id="385867753870250529">एक्स्टेंशनसाठी तुम्हाला Browther मध्ये साइन इन करावे लागेल</translation>
<translation id="2022337046348377650"><ph name="FILE_NAME"/> धोकादायक असू शकते, त्यामुळे Browther ने ती ब्लॉक केली आहे.</translation>
<translation id="45270956603278068">Browther तुमचा कॅमेरा वापरत आहे.</translation>
<translation id="6327105987658262776">कोणतेही अपडेट उपलब्ध नाही.</translation>
<translation id="673633752219771459">Browther वर दुसरे ऑपरेशन प्रगतीपथावर आहे. कृपया नंतर पुन्हा प्रयत्न करा.</translation>
<translation id="1482759407165416070">आता आपल्या Browther खात्यावर आणि शेअर केलेल्या संगणकांवर Browther वापरणे अधिक सुलभ आहे.</translation>
<translation id="5538042432112726532">Browther शॉर्टकट</translation>
<translation id="833085228901080512">फाइल सामान्यतः डाउनलोड केली जात नसल्याने Browther ने हे डाउनलोड ब्लॉक केले आहे आणि ती धोकादायक असू शकते</translation>
<translation id="491120842288314439">तुम्हाला खात्री आहे की तुम्ही Browther अनइंस्टॉल करू इच्‍छिता?</translation>
<translation id="6375219077595103062">Password Manager मध्ये शॉर्टकट जोडा</translation>
<translation id="6388799252195623474">यामध्ये माझी मदत करा</translation>
<translation id="6715003312952407375">पुढे सुरू ठेवण्यासाठी, <ph name="EMAIL"/> म्हणून Browther मध्ये साइन इन करा. यामुळे तुम्ही तुमच्या संस्थेची धोरणे वाचल्याची खात्री होते.</translation>
<translation id="1897845318651970239">कॉंप्युटर स्क्रीनवरील Browther लोगो.</translation>
<translation id="3669522483038684532">Browther हे एक वेबब्राउझर असून ते वेबपेज आणि अ‍ॅप्स अतिशय वेगात चालवते. हे वापरण्यास जलद, स्थिर आणि सोपे आहे. Browther मध्ये तयार करण्यासाठी मालवेअर आणि फिशिंग संरक्षणासह वेब अधिक सुरक्षितपणे ब्राउझ करा.</translation>
<translation id="5669767676913031391">Browther अधिक जलद रन होते आणि JavaScript वापरणारी वैशिष्ट्ये डिझाइन केल्यानुसार काम करतात</translation>
<translation id="6436260184216827876">इमेज शोध उपलब्ध नाही. नंतर पुन्हा प्रयत्न करा.</translation>
<translation id="2139300032719313227">ChromeOS रीस्टार्ट करा</translation>
<translation id="6110616900529884221">Browther तुम्ही भेट देण्याची शक्यता असलेली आणखी पेज प्रीलोड करते, जेणेकरून तुम्ही त्यांना भेट देता, तेव्हा ती अधिक जलद लोड होतात</translation>
<translation id="1217194059001819677">किमतीचा माग ठेवण्यासाठी आणि कोणत्याही साइटवर किमतीतील घट झाल्यावर अलर्ट मिळवण्यासाठी तुमच्या फोनवर Browther डाउनलोड करा</translation>
<translation id="7058555680120557198">बंद आहे • हे एक्स्टेंशन कुठून आले त्याची Browther ला पडताळणी करता आली नाही</translation>
<translation id="676533642429632127">Browther प्रोफाइलमध्ये स्वागत आहे</translation>
<translation id="5518682889576009702">तुम्ही पुढील वेळी तुमच्या <ph name="DEVICE_TYPE"/> वर Browther उघडल्यावर, तुम्हाला टॅब गट वापरण्यासाठी प्रॉम्प्ट दिसेल.</translation>
<translation id="6038105561107837619">Browther मधून खाते काढून टाका</translation>
<translation id="2675662665675552980">तुम्ही Browther सुरू करता तेव्हा कोणते पेज दाखवावे हेदेखील ते नियंत्रित करते.</translation>
<translation id="648319183876919572">वर्धित सुरक्षित ब्राउझिंग धोकादायक वेबसाइट आणि डाउनलोडपासून तुमचे संरक्षण करण्यासाठी बरेच काही करते</translation>
<translation id="2930243146591999795">Browther अनइंस्टॉल करा</translation>
<translation id="5241183382286817629">शॉर्टकट हे Browther मध्ये उघडतात</translation>
<translation id="7907014599435829661"><ph name="TIMEOUT_DURATION"/> कालावधीसाठी Browther वापरले जात नाही, तेव्हा तुमची संस्था ते बंद करते. ब्राउझिंग डेटा हटवला गेला. यात इतिहास, ऑटोफिल आणि डाउनलोड यांचा समावेश असू शकतो.</translation>
<translation id="2088471423667794811">प्रत्येक प्रोफाइलमध्ये तिची स्वतःची Browther माहिती असते जसे की, बुकमार्क, इतिहास, पासवर्ड आणि आणखी बरेच काही</translation>
<translation id="9040334484455218184"><ph name="BEGIN_LINK"/>Browther तुमचा डेटा खाजगी कसा ठेवते<ph name="END_LINK"/> याविषयी अधिक जाणून घ्या</translation>
<translation id="1718697235867382480">Browther रीस्टार्ट झाल्यावर, या सेटिंगमधील बदल लागू केले जातील.</translation>
<translation id="6331317152404762758">तुम्ही दुसऱ्या Browther प्रोफाइलवरील पासवर्ड पाहण्यासाठी स्विच करू शकता</translation>
<translation id="6097706403184348562">शब्दलेखनाच्या चुकांमध्ये सुधारणा करण्यासाठी Browther तुम्ही मजकूर भागामध्ये टाइप केलेला मजकूर Browther ला पाठवते</translation>
<translation id="2319647238307402812">Browther च्या सूचना सेटिंग्जमध्ये जा</translation>
<translation id="6600016381025017075">या पेजवरील कोणतीही गोष्ट शोधा</translation>
<translation id="8031938899816118394">तुम्ही पुढल्या वेळी Browther रीलाँच कराल तोपर्यंत तुमचे बदल प्रभावी होतील.</translation>
<translation id="7412185356697187964">Windows सुरू होते, तेव्हा आता Browther लाँच होते, जेणेकरून तुम्ही ब्राउझ करणे तात्काळ सुरू करू शकता. तुम्ही हे सेटिंग्जमध्ये बंद करू शकता.</translation>
<translation id="9123343592576384616">तुम्ही सोडले होते तिथून पुढे सुरू ठेवा: तुमच्या शेवटच्या सेशनमधून Browther ने तुमचे टॅब रिस्टोअर केले. तुम्ही हे यामध्ये बंद करू शकता</translation>
<translation id="5847926498049048567">तुमच्या आसपासचा 3D नकाशा तयार करण्यासाठी Browther ला तुमच्या कॅमेराची परवानगी आवश्यक आहे</translation>
<translation id="5532585028508811858">तुम्ही तुमच्या Browther खाते मध्ये बुकमार्कदेखील सेव्ह केले असल्यास, तुम्ही Browther उत्पादनाच्या किमती ट्रॅक करू शकता आणि किंमत कमी झाल्यावर सूचना मिळवू शकता</translation>
<translation id="6676384891291319759">इंटरनेट ॲक्सेस करा</translation>
<translation id="1363996462118479832">साइन इन करताना एरर आल्यामुळे, ChromeOS ला तुमचा डेटा सिंक करता आला नाही.</translation>
<translation id="3373239673945775810">Browther वरून या ॲपचा डेटा काढून टाका</translation>
<translation id="8122759674786039814">Browther हे तुम्हाला तुम्ही पाहता त्या जाहिरातींवर अधिक नियंत्रण देते आणि साइट तुम्हाला पर्सनलाइझ केलेल्या जाहिराती दाखवतात, तेव्हा त्यांना तुमच्याबद्दल कोणती माहिती मिळू शकते हे मर्यादित करते</translation>
<translation id="6277682530398500159">Browther ला या साइटसाठी मायक्रोफोनची परवानगी आवश्यक आहे</translation>
<translation id="6712881677154121168">डाउनलोडशी संबंधित एरर: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">तुमची प्रोफाइल वापरली जाऊ शकत नाही, कारण ती Browther च्‍या नवीनतम आवृत्तीमधील आहे.

काही वैशिष्‍ट्ये उपलब्ध नसू शकतील. कृपया एक भिन्न प्रोफाइल डिरेक्टरी नमूद करा किंवा Browther ची नवीन आवृत्ती वापरा.</translation>
<translation id="871671753163165892">पर्सनलायझेशन व इतर वैशिष्ट्ये मिळवण्यासाठी, वेब आणि अ‍ॅप अ‍ॅक्टिव्हिटी व लिंक केलेल्या Browther सेवांमध्ये Browther चा समावेश करा</translation>
<translation id="5000832110229523807">तुमच्या कॉंप्युटरवर सर्व वापरकर्त्यांसाठी आधीच Browther इंस्टॉल केले आहे.</translation>
<translation id="5204575479550973859">तुमच्या सर्व डिव्हाइसवर तुमचे बुकमार्क आणि आणखी बरेच काही मिळवण्यासाठी, Browther मध्ये साइन इन करा. तुम्ही साइन इन केल्यावर हा बुकमार्क तुमच्या Browther खाते मध्ये सेव्ह केला जाईल.</translation>
<translation id="2874208284092283937">Browther चे V8 इंजीन साइटचा वेग वाढवते, पण त्यामुळे Browther ची हल्ले रोखण्याची क्षमता किंचित कमी होते. हे सेटिंग सुरू आहे.</translation>
<translation id="3268577459683869744">{count,plural, =1{तुमचा काही Browther डेटा अद्याप तुमच्या Browther खाते मध्ये सेव्ह केला गेलेला नाही. साइन आउट करण्यापूर्वी काही मिनिटे प्रतीक्षा करून पहा. तुम्ही आताच साइन आउट केल्यास, हा डेटा (१ आयटम) हटवला जाईल.}other{तुमचा काही Browther डेटा अद्याप तुमच्या Browther खाते मध्ये सेव्ह केला गेलेला नाही. साइन आउट करण्यापूर्वी काही मिनिटे प्रतीक्षा करून पहा. तुम्ही आता साइन आउट केल्यास, हा डेटा ({count} आयटम) हटवला जाईल.}}</translation>
<translation id="7683816018918395929">Browther हे ही फाइल स्कॅन करण्याची शिफारस करते, कारण ती धोकादायक असू शकते.</translation>
<translation id="1547295885616600893">ChromeOS हे अतिरिक्त <ph name="BEGIN_LINK_CROS_OSS"/>मुक्त स्रोत सॉफ्टवेअर<ph name="END_LINK_CROS_OSS"/> याद्वारे तयार करण्यात आले आहे.</translation>
<translation id="6831043979455480757">भाषांतर करा</translation>
<translation id="2142653375108595728">तुमचे पासवर्ड कधीही धोक्यात असल्यास, Browther तुम्हाला कळवते</translation>
<translation id="684888714667046800">इंटरनेटशी कनेक्ट करता आले नाही. तुम्ही फायरवॉल वापरल्यास, कृपया <ph name="PRODUCT_EXE_NAME"/> अनुमती सूचीमध्ये असल्याची खात्री करा.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">पुढे सुरू ठेवण्यासाठी टॅब करा</translation>
<translation id="6862030660799253820">इमेज शोध वापरून ही इमेज शोधा</translation>
<translation id="3860339351709082396">Browther ला "<ph name="EXTENSION_NAME"/>" मध्ये मालवेअरचा समावेश असल्याचे आढळले</translation>
<translation id="6877155553248388166">शोध क्षेत्राच्या तळाशी उजवा कोपरा: उजवीकडे <ph name="RIGHT"/>%, तळाशी <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">कॉपी करा</translation>
<translation id="7804113502310231166">Browther ला तुमचा डीफॉल्ट ब्राउझर म्हणून सेट करा आणि तुमच्या टास्कबारमध्ये तो पिन करा</translation>
<translation id="3228374215117173004">Browther प्रोफाइल व्यवस्थापित करा</translation>
<translation id="6934579572334859869">इमेज शोध ला इमेजविषयी माहिती विचारा</translation>
<translation id="5995328366516663808">तुम्ही Browther ची <ph name="BOOKMARK_LIMIT"/> बुकमार्कची मर्यादा गाठली आहे, त्यामुळे तुमचे काही बुकमार्क अद्याप तुमच्या Browther खाते मध्ये सेव्ह केलेले नाहीत.

तुम्ही काही बुकमार्क हटवत नाही, तोपर्यंत तुमच्या खात्यामध्ये नवीन बुकमार्क सेव्ह केले जाऊ शकत नाहीत. तुम्ही आता साइन आउट केल्यास, सेव्ह न केलेले बुकमार्क हटवले जातील.</translation>
<translation id="6965382102122355670">ठीक आहे</translation>
<translation id="4533562834763015352">कमकुवत पासवर्ड ओळखणे सोपे असते. Browther ला <ph name="BEGIN_LINK"/>तुमच्यासाठी क्लिष्ट पासवर्ड तयार करून लक्षात ठेवू द्या<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">ChromeOS अटी</translation>
<translation id="5379058926689137454">या साइटसाठी Browther ला तुमचा मायक्रोफोन ॲक्सेस करण्याची परवानगी हवी आहे</translation>
<translation id="4684462982894889021">तुमच्या <ph name="ACCOUNT_EMAIL"/> खात्यामध्ये Browther डेटा वापरण्यासाठी आणि सेव्ह करण्यासाठी तुमचा पासफ्रेझ एंटर करा</translation>
<translation id="7011190694940573312">इंस्टॉलेशन यशस्वी झाले नाही, कारण ऑपरेटिंग सिस्टीमच्या या आवृत्तीला सपोर्ट नाही.</translation>
<translation id="7024536598735240744">उघडण्याशी संबंधित एरर: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">इंस्टॉलेशन थांबवले</translation>
<translation id="8257174622576051374">Browther ला तुमचे हक्काचे ठिकाण बनवा</translation>
<translation id="7047386856539490735">हे परिणाम उपयुक्त आहेत का?</translation>
<translation id="1772745060691790742">Browther अपडेट करा</translation>
<translation id="4937970118065051027">इमेजचे उपयोगी वर्णन नसल्यास, Browther तुमच्यासाठी ते देण्याचा प्रयत्न करेल. वर्णने तयार करण्यासाठी, इमेज Browther ला पाठवल्या जातात.</translation>
<translation id="1594112132009288601">Browther for Testing कस्टमाइझ करा</translation>
<translation id="5915000938288527952">तुम्ही मेसेज, दस्तऐवज आणि इतर अ‍ॅप्स यांमधील लिंकवर कधीही क्लिक कराल, तेव्हा Browther वापरू शकता</translation>
<translation id="8775664994493381735">Browther मधून <ph name="EXTENSION_NAME"/> काढून टाका</translation>
<translation id="3276648807841991013"><ph name="TIMEOUT_DURATION"/> कालावधीसाठी Browther डेटा वापरला जात नाही, तेव्हा तुमची संस्था तो हटवते. यात इतिहास, ऑटोफिल आणि डाउनलोड यांचा समावेश असू शकतो.</translation>
<translation id="4725226878394159809">Browther ला या साइटसाठी कॅमेराची परवानगी आवश्यक आहे</translation>
<translation id="8931474625901592021">Browther लाँच करता आले नाही. पुन्हा प्रयत्न करा.</translation>
<translation id="8242947409070121799">Browther तुमचे पासवर्ड तपासू शकत नाही. २४ तासांनंतर पुन्हा प्रयत्न करा.</translation>
<translation id="1737922827960215472">Browther कधीही झटपट मिळवण्यासाठी ते तुमच्या डॉक मध्ये ठेवा</translation>
<translation id="335855266303176628">तुम्ही मेसेज, दस्तऐवज आणि इतर अ‍ॅप्समधील लिंकवर क्लिक करता, तेव्हा Browther कधीही वापरा</translation>
<translation id="709455597778444012">टास्क मॅनेजर- Browther</translation>
<translation id="7147140345767587643">Browther च्या अंदाजानुसार तुमची स्वारस्ये</translation>
<translation id="7337408274890534789">ब्राउझ करणे तात्काळ सुरू करा: Windows सुरू होते, तेव्हा आता Browther लाँच होऊ शकते.</translation>
<translation id="7274695763216404502">पिन केले आहे! टूलबारमधून इमेज शोध पुन्हा वापरा</translation>
<translation id="7288567540154601580">टॅब आणि एक्स्टेंशन</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{तुम्ही ते काढून टाकावे अशी Browther शिफारस करते}other{तुम्ही ती काढून टाकावीत अशी Browther शिफारस करते}}</translation>
<translation id="1527644038571473502">सिस्टीम ऑडिओ शेअर करण्यासाठी, सिस्टीम सेटिंग्ज उघडा आणि Browther साठी 'फक्त सिस्टीम ऑडिओ रेकॉर्डिंग' ला अनुमती द्या. तुम्हाला त्यानंतर Browther रीस्टार्ट करावे लागेल.</translation>
<translation id="1427913074981060872">जाहिरात मापन हे तुम्ही भेट देत असलेल्या साइटना Browther कडे माहितीची विनंती करण्यास अनुमती देते, जे साइटला तिच्या जाहिरातींचा परफॉर्मन्स मोजण्यात मदत करते. जाहिरात मापन हे साइटदरम्यान शक्य तितकी कमी माहिती ट्रान्सफर करून क्रॉस-साइट ट्रॅकिंग प्रतिबंधित करते.</translation>
<translation id="1657652725060525338">Browther अपडेट होत आहे</translation>
<translation id="884846289464870238">तुमची प्राधान्ये फाइल दूषित किंवा चुकीची आहे.

Browther तुमची सेटिंग्ज रिकव्हर करू शकत नाही.</translation>
<translation id="7339898014177206373">नवीन विंडो</translation>
<translation id="633044855886370183">तुमचे वेब, बुकमार्क आणि अन्य Browther आशय येथे थेट आहे.</translation>
<translation id="1185960088713242527">फक्त तुमचा पासफ्रेझ असलेली कोणतीही व्यक्ती तुमचा एन्क्रिप्ट केलेला डेटा वाचू शकते. पासफ्रेझ Browther कडे पाठवला किंवा त्याद्वारे स्टोअर केलेला नाही. तुम्ही तुमचा पासफ्रेझ विसरल्यास किंवा तुम्हाला हे सेटिंग बदलायचे असल्यास, तुम्हाला <ph name="BEGIN_LINK"/>तुमच्या खात्यामधील Browther डेटा हटवणे<ph name="END_LINK"/> हे करावे लागेल.</translation>
<translation id="7125151836477182110">तुमच्या सिस्टीम अ‍ॅडमिनिस्ट्रेटरने <ph name="TARGET_URL_HOSTNAME"/> अ‍ॅक्सेस करण्यासाठी <ph name="ALTERNATIVE_BROWSER_NAME"/> उघडण्याकरिता Browther कॉन्फिगर केले आहे.</translation>
<translation id="7352651011704765696">काहीतरी चूक झाली</translation>
<translation id="6638123710106659002">भविष्यातील Browther अपडेट मिळवण्यासाठी, तुमच्याकडे macOS 13 किंवा त्यापुढील आवृत्ती असणे आवश्यक आहे. हा काँप्युटर macOS 12 वापरत आहे.</translation>
<translation id="7286289384512061761">तुम्ही अलीकडे भेट दिलेली नाही. Browther ने <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> परवानग्या काढून टाकल्या आहेत.</translation>
<translation id="113593073175678746">या एक्स्टेंशनला यापुढे सपोर्ट नाही. त्याऐवजी तुम्ही ते काढून टाकावे अशी Browther शिफारस करते.</translation>
<translation id="137615076640044304">तुम्ही सोडले होते तिथून पुढे सुरू ठेवा: तुम्ही रीस्टार्ट करता, तेव्हा प्रत्येक वेळी Browther तुमचे टॅब रिस्टोअर करते. हे बंद करण्यासाठी, यावर जा</translation>
<translation id="5967238175620483220">Browther वर पासवर्ड इंपोर्ट करा</translation>
<translation id="4719434010343478165"><ph name="PAGE_TITLE"/> - Browther डेव्हलपर</translation>
<translation id="7450541714075000668">मजकूर कॉपी केला</translation>
<translation id="7766009218653304791">या साइटसाठी Browther ला तुमचा कॅमेरा ॲक्सेस करण्याची परवानगी हवी आहे</translation>
<translation id="5844418066487488520">तुमचा मायक्रोफोन वापरण्यासाठी, Browther ला <ph name="BEGIN_LINK"/>सिस्टीम सेटिंग्ज<ph name="END_LINK"/> मध्ये अ‍ॅक्सेस द्या</translation>
<translation id="8065480549334161841">भविष्यातील Browther अपडेट मिळवण्यासाठी, तुमच्याकडे Windows 10 किंवा त्यापुढील आवृत्ती असणे आवश्यक आहे. हा कॉंप्युटर Windows 7 वापरत आहे.</translation>
<translation id="6299293759264950896">Browther पुन्हा लाँच करायचे का?</translation>
<translation id="180908550381040105">सध्‍या सुरू असलेल्‍या सारख्याच Browther आवृत्तीची स्‍थापना होऊ शकत नाही. कृपया Browther बंद करा आणि पुन्‍हा प्रयत्‍न करा.</translation>
<translation id="7625576878150380853">तुम्ही Browther मध्ये साइन इन केलेले असताना, तुमचे Browther खाते यामध्ये तुमचे पासवर्ड सेव्ह करू व वापरू शकता आणि आणखी बरेच काही करू शकता. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">साइट कदाचित अपेक्षेप्रमाणे काम करतील. तुम्ही Browther वर साइन इन केले असल्यास, सर्व Browther विंडो बंद केल्यावर तुमचे Browther खाते वगळता तुम्हाला बहुतांश साइटवरून साइन आउट केले जाईल.</translation>
<translation id="7099370564362681943">{0,plural, =1{Browther एका मिनिटामध्ये पुन्हा लॉंच होईल}other{Browther # मिनिटांमध्ये पुन्हा लाँच होईल}}</translation>
<translation id="3602613943932672197">तुमच्या डेटाचे संरक्षण करण्यासाठी, तुम्ही अलीकडील भेट न दिलेल्या साइटवरील परवानग्या Browther ला काढून टाकू द्या.</translation>
<translation id="8759568213742229377">ब्राउझ करणे तात्काळ सुरू करण्यासाठी Browther आपोआप लाँच करा.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> इंस्टॉलर</translation>
<translation id="8991800242749014880">Browther तुमचा कॅमेरा आणि मायक्रोफोन वापरत आहे.</translation>
<translation id="2692328388439821508">Browther आता उत्कृष्ट झाले आहे</translation>
<translation id="4318444066563223295">तुमच्याकडे आता Browther मध्ये आणखी वैशिष्ट्ये उपलब्ध आहेत</translation>
<translation id="7649070708921625228">मदत</translation>
<translation id="5591287320769313116">Browther ला तुमच्यासाठी ब्राउझ करू द्या</translation>
<translation id="7658239707568436148">रद्द करा</translation>
<translation id="6325482130534634729">Browther तुमचा डीफॉल्ट ब्राउझर नाही</translation>
<translation id="8185915921134219287">तुमच्या डिव्हाइसवर Browther सिंक आणि पर्सनलाइझ करा</translation>
<translation id="5120421624925726813">Browther शी संबंधित अपडेट</translation>
<translation id="7716950018788545737">टास्क संपले आहे (संपली आहेत).</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> साठी सिस्टीम ट्रेसिंगची सेवा पुरवते. ही सेवा बंद केली असल्यास, ब्राउझरद्वारे तयार केलेल्या परफॉर्मन्स ट्रेसमध्ये आशय स्विच आणि तयार थ्रेड इव्हेंट यांसारख्या संपूर्ण सिस्टीममधील इव्हेंटचा समावेश होणार नाही.</translation>
<translation id="6542096191573265107">हे या डिव्‍हाइस मधून तुमचा ब्राउझिंग डेटा हटवेल. नंतर तुमचा डेटा पुनर्प्राप्त करण्‍यासाठी, Browther मध्ये <ph name="USER_EMAIL"/> म्हणून साइन इन करा.</translation>
<translation id="7747138024166251722">इन्स्टॉलर तात्पुरती डिरेक्टरी तयार करू शकत नाही. कृपया सॉफ्टवेअर इंस्टॉल करण्यासाठी रिक्त डिस्क स्थान आणि परवानगी पहा.</translation>
<translation id="351575328720488268">डीफॉल्ट Browther वर रीसेट करा</translation>
<translation id="1054170408395182418">Browther ला डीफॉल्ट म्हणून सेट करा आणि ते टास्कबारवर पिन करा</translation>
<translation id="4569594230301902490">Browther ला आणखी जलद बनवा</translation>
<translation id="5525298466557654312"><ph name="PAGE_TITLE"/> - Browther कॅनरी</translation>
<translation id="7893465573639396635">तुमच्या इंटरनेट ट्रॅफिकचा ॲक्सेस असलेल्या लोकांसाठी तुम्ही कोणत्या साइटला भेट देता हे पाहणे कठीण करा. DNS (डोमेन नेम सिस्टीम) मध्ये साइटचा आयपी अ‍ॅड्रेस शोधण्यासाठी Browther सुरक्षित कनेक्शन वापरते.</translation>
<translation id="7810005234485217901">सोप्या अ‍ॅक्सेससाठी तुम्ही इमेज शोध पिन करू शकता</translation>
<translation id="2462631024103158515">या खात्यासह असलेली Browther प्रोफाइल आधीपासून या डिव्हाइसवर अस्तित्वात आहे</translation>
<translation id="7845233973568007926">इंस्टॉल केल्याबद्दल धन्यवाद. तुम्ही <ph name="BUNDLE_NAME"/> वापरण्यापूर्वी तुमचा कॉंप्युटर रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="311190437086049332">Browther ला नवीन लुक देण्यासाठी ते कस्टमाइझ करा</translation>
<translation id="6728847658878265103">Browther नवीनतम आवृत्तीवर अपडेट होऊ शकले नाही, त्यामुळे तुम्ही नवीन वैशिष्ट्ये आणि सुरक्षितता निराकरणे गमावत आहात.</translation>
<translation id="7872446069773932638">डाउनलोड करत आहे... <ph name="SECONDS"/> सेकंद शिल्लक आहे(आहेत)</translation>
<translation id="5374532739787768601">तुम्ही तुमचा पासफ्रेझ विसरल्यास किंवा हे सेटिंग बदलायचे असल्यास, <ph name="BEGIN_LINK"/>तुमच्या खात्यामधील Browther डेटा हटवणे<ph name="END_LINK"/> हे करा</translation>
<translation id="7877212753140190672">इमेजविषयी माहिती विचारा</translation>
<translation id="9172499982238113829">Browther तुमचा डीफॉल्ट म्हणून सेट करा</translation>
<translation id="3313826726620159669">Browther हे शक्य असेल तेव्हा असुरक्षित कनेक्शन HTTPS वर आपोआप अपग्रेड करते</translation>
<translation id="3317928686912559532">तुम्ही <ph name="USER_EMAIL_ADDRESS"/> या रुपात Browther मध्ये साइन इन केले होते. कृपया पुन्हा साइन इन करण्यासाठी समान खाते वापरा.</translation>
<translation id="6007009085341946457">ही Browther ची दुय्यम स्थापना असून त्यास तुमचा डीफॉल्ट ब्राउझर बनवू शकत नाही.</translation>
<translation id="8004582292198964060">ब्राउझर</translation>
<translation id="8010081455002666927">ऑटो-डिटेक्ट करा</translation>
<translation id="174885789898161653">एकदा का Browther ला ॲक्सेस मिळाला की, वेबसाइट तुम्हाला ॲक्सेससाठी विचारू शकतील.</translation>
<translation id="3001754454174546602">Browther कधीही झटपट अ‍ॅक्सेस करण्यासाठी, ते तुमच्या टास्कबारमध्ये पिन करा</translation>
<translation id="80471789339884597">इंस्टॉल केल्याबद्दल धन्यवाद. तुम्ही <ph name="BUNDLE_NAME"/> वापरण्यापूर्वी तुमचे सर्व ब्राउझर रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="8054112667659782652">इमेज शोध शॉर्टकट नेहमी दाखवा</translation>
<translation id="6993312779622863465">अ‍ॅप्ससाठी बॅकग्राउंडमध्ये रन होणारे Browther बंद करा</translation>
<translation id="80790299200510644">इमेज शोध</translation>
<translation id="8086881907087796310">इंस्टॉलेशन यशस्वी झाले नाही, कारण तुमचा कॉंप्युटर हा हार्डवेअरच्या किमान आवश्यकतांची पूर्तता करत नाही.</translation>
<translation id="4734875482699037091"><ph name="PAGE_TITLE"/> - Browther for Testing</translation>
<translation id="543407324609820492">Browther ला या साइटसाठी स्थानाशी संबंधित परवानगी आवश्यक आहे</translation>
<translation id="1767887552863788514">तुम्ही पुढील वेळी तुमच्या <ph name="DEVICE_TYPE"/> वर Browther उघडल्यावर, तुम्हाला किमतीचा माग ठेवण्याशी संबंधित अलर्ट सुरू करण्यासाठी प्रॉम्प्ट दिसेल.</translation>
<translation id="8118331347066725040">Lens वापरून शोधण्यासंबंधित फीडबॅक पाठवा</translation>
<translation id="5334309298019785904">तुमच्या डोमेनसाठी सिंक करणे उपलब्ध नसल्यामुळे, ChromeOS ला तुमचा डेटा सिंक करता आला नाही.</translation>
<translation id="813913629614996137">सुरू करत आहे…</translation>
<translation id="4879101934056397619">Browther अतिरिक्त सेवा अटी</translation>
<translation id="4505690237431768764">ही फाइल धोकादायक आहे, त्यामुळे Browther ने ब्लॉक केली आहे.</translation>
<translation id="8177472873527554730">पेजमध्ये आशय शोधू शकत नाही</translation>
