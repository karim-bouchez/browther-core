<translation id="2456995288904753506">Browther साधारण ऑटोफिलमध्ये न भरली जाणारी अवघड फील्ड ऑटोफिल करू शकते</translation>
<translation id="3271730304285122987">या एक्स्टेंशनमध्ये मालवेअर आहे आणि ते असुरक्षित आहे. ते Browther वरून काढून टाका, जेणेकरून ते तुमच्या वैयक्तिक माहितीच्या समावेशासह तुम्ही भेट देत असलेल्या साइटवरील तुमचा डेटा आता पाहू आणि बदलू शकत नाही.</translation>
<translation id="2799223571221894425">पुन्हा लाँच करा</translation>
<translation id="1427337251963884503">तुमचा Browther</translation>
<translation id="2816462166102338036">इमेज शोध वापरून हा व्हिडिओ शोधा</translation>
<translation id="2841525013647267359">यामधून भाषांतर करा</translation>
<translation id="2846251086934905009">इंस्टॉलसंबंधित एरर: इंस्टॉलर पूर्ण झाले नाही. इंस्टॉलेशन रद्द केले गेले आहे.</translation>
<translation id="928966105228355994">Browther मधून काढून टाका...</translation>
<translation id="587805782197019018">तुम्ही साइन इन केलेले असते तेव्हा, तुम्हाला Browther वर सुरक्षित ठेवतो आणि इतर Browther अ‍ॅप्सवरील तुमच्या सुरक्षेमध्ये सुधारणा करण्यासाठी वापरला जाऊ शकतो</translation>
<translation id="2885378588091291677">टास्क मॅनेजर</translation>
<translation id="3055995278166070443">&amp;Browther बद्दल</translation>
<translation id="2915996080311180594">नंतर रीस्टार्ट करा</translation>
<translation id="2928420929544864228">इंस्टॉलेशन पूर्ण झाले.</translation>
<translation id="70453521937551896">तुमचा डेटा हा तुमचा पासफ्रेझ वापरून एन्क्रिप्ट केलेला आहे. तुमच्या Browther खाते मधील Browther डेटा वापरण्यासाठी आणि सेव्ह करण्यासाठी तो एंटर करा.</translation>
<translation id="2945997411976714835">इंस्टॉलसंबंधित एरर: इंस्टॉलर प्रक्रिया सुरू झाली नाही.</translation>
<translation id="3188308520233701133">iOS वर Browther साठी सेव्ह केलेले पासवर्ड वापरून साइटवर अधिक जलद साइन इन करा</translation>
<translation id="8145318807880784886">बुकमार्क, पासवर्ड आणि सेटिंग्ज या गोष्टी वेगवेगळ्या ठेवण्यासाठी नवीन Browther प्रोफाइल जोडा.</translation>
<translation id="4330268530227888227">तुमची संस्था Browther व्यवस्थापित करते</translation>
<translation id="6488090896442998436">Browther अद्ययावत आहे</translation>
<translation id="300557164611864786">साइटने तुमचा पासवर्ड चोरण्याचा प्रयत्न केल्यास किंवा तुम्ही हानिकारक फाइल डाउनलोड केल्यास, Browther कदाचित पेज आशयाच्या भागांसह, URLs देखील सुरक्षित ब्राउझिंग ला पाठवेल</translation>
<translation id="2447145782593796785">तुमच्या पालकांच्या निवडींसह ऑनलाइन सुरक्षित राहण्यासाठी, Browther मध्ये साइन इन करा</translation>
<translation id="3003694935412297923">सर्व टास्क</translation>
<translation id="7554113777150891030">{count,plural, =1{तुमच्या Browther खाते मध्ये काही डेटा सेव्ह करता येण्यापूर्वी आणि तो तुमच्या सर्व डिव्हाइसवर वापरता येण्यापूर्वी, Browther ला ते तुम्हीच असल्याची पडताळणी करावी लागेल. तुम्ही आताच साइन आउट केल्यास, हा डेटा (१ आयटम) हटवला जाईल.}other{तुमच्या Browther खाते मध्ये काही डेटा सेव्ह करता येण्यापूर्वी आणि तो तुमच्या सर्व डिव्हाइसवर वापरता येण्यापूर्वी, Browther ला ते तुम्हीच असल्याची पडताळणी करावी लागेल. तुम्ही आता साइन आउट केल्यास, हा डेटा ({count} आयटम) हटवला जाईल.}}</translation>
