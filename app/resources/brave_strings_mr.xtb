<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mr">
<translation id="1026101648481255140">इंस्टॉलेशन पुन्‍हा सुरू करा</translation>
<translation id="7099479769133613710">&amp;ChromeOS अपडेट करण्यासाठी पुन्हा लाँच करा</translation>
<translation id="7264054672589027446">Browther हे तुम्हाला या एक्स्टेंशनचे पुनरावलोकन करण्याची शिफारस करते</translation>
<translation id="7848219163187166649">साइटने त्यांच्या पेजवरील लिंक खाजगीरीत्या प्रीलोड करण्यास सांगितल्यास, Browther हे Browther सर्व्हर वापरते. हे प्रीलोड केलेल्या साइटपासून तुमची ओळख लपवते, पण कोणत्या साइट प्रीलोड केल्या जातात हे Browther ला समजते.</translation>
<translation id="1065672644894730302">तुमची प्राधान्ये वाचता आली नाहीत.
काही वैशिष्‍ट्ये अनुपलब्ध असू शकतात आणि प्राधान्यांमधील बदल सेव्ह केले जाणार नाहीत.</translation>
<translation id="8837164267124113709">तुमच्या पालकांनी Browther साठी "साइट, अ‍ॅप्स आणि एक्स्टेंशनकरिता परवानग्या" बंद केल्या आहेत</translation>
<translation id="881513728707488138">Browther ला तुमचे पासवर्ड निर्यात करायचे आहेत. हे करू देण्यासाठी तुमचा Windows पासवर्ड टाइप करा.</translation>
<translation id="112640046208448578">गोष्टी किंवा ठिकाणे ओळखा आणि मजकूर कॉपी अथवा भाषांतरित करा. तुम्ही इमेज शोध वापरता, तेव्हा पेजचा स्क्रीनशॉट सर्व्हरला पाठवला जातो. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther तुमचा डीफॉल्ट ब्राउझर आहे</translation>
<translation id="6580138787163923852">तुमचे पासवर्ड डेटा भंग आणि इतर सुरक्षा समस्यांपासून सुरक्षित आहेत हे तपासण्यासाठी, <ph name="BEGIN_LINK"/>Browther मध्ये साइन इन करा<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther मेनूवर क्लिक करा</translation>
<translation id="1157985233335035034">अलीकडील भाषा</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> ने असे एक्स्टेंशन जोडले आहे, ज्यामुळे Browther ची काम करण्याची पद्धत बदलू शकते.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">तुमच्या Windows च्या आवृत्तीला सपोर्ट नसल्यामुळे इंस्टॉलेशन करता आले नाही.</translation>
<translation id="8291401179516272335">Browther बद्दल</translation>
<translation id="1203500561924088507">इंस्टॉल केल्याबद्दल धन्यवाद. तुम्ही <ph name="BUNDLE_NAME"/> वापरण्यापूर्वी तुमचा ब्राउझर रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="1232234696885483911">तुम्ही इमेज शोध उघडता, तेव्हा PDFs सह पेजचे शीर्षक, URL आणि आशय आपोआप सर्व्हरला पाठवला जाईल. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">तुम्ही साइन इन केलेले असताना, Browther मध्ये तुमच्या Browther खाते मधून तुमचे पासवर्ड आणि आणखी बऱ्याच गोष्टी वापरू शकता. हे बदलण्यासाठी, “Browther मधील तुमचे खाते” वर जा.</translation>
<translation id="9034321258761608912">हा टॅब इनॅक्टिव्ह असताना, Browther ला जलद ठेवण्यासाठी मेमरी मोकळी करण्यात आली होती. ही साइट इनॅक्टिव्ह राहण्यापासून नेहमी वगळली जावी असे तुम्ही निवडू शकता.</translation>
<translation id="249571811018731941">फाइल धोकादायक असल्याने Browther ने हे डाउनलोड ब्लॉक केले आहे</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> वापरून Gmail किंवा YouTube सारख्या Browther सेवांमध्ये साइन इन करताना, तुम्ही तेच खाते वापरून Browther मध्ये आपोआप साइन इन करू शकता</translation>
<translation id="1290883685122687410">सेटअप एरर: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">तुमची नवीन Browther प्रोफाइल सेट करा</translation>
<translation id="4437862975743821367">ब्लूटूथ डिव्हाइस एक्सप्लोर करण्यासाठी Browther ला 
 ब्लूटूथ चा ॲक्सेस हवा आहे. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">भाषा डिटेक्ट करा</translation>
<translation id="1206925267243987362">Browther ची शिफारस केलेली ब्राउझर सेटिंग्ज वापरा</translation>
<translation id="8270483548049772782">तसेच Browther मधून डेटा हटवा (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">पिन केले आहे! तुम्ही टूलबारवरील नवीन बटण वापरून इमेज शोध पुन्हा अ‍ॅक्सेस करू शकता</translation>
<translation id="1356661055722410047">नवीन! तुम्ही तुमच्या स्क्रीनवरील मजकूर आणि इमेज दोन्हींचे भाषांतर करू शकता</translation>
<translation id="1383876407941801731">शोधा</translation>
<translation id="1592588950737518481">Browther प्रोफाइल व्यवस्थापित करा</translation>
<translation id="1404026649028693342">AI मोड नेहमी दाखवा</translation>
<translation id="141901961143729572">तुमचे विचार शेअर करा</translation>
<translation id="1743952081001089298">तुमची विंडो शेअर करण्यासाठी, सिस्टीम सेटिंग्ज मध्ये Browther साठी स्क्रीन रेकॉर्डिंगला अनुमती द्या.</translation>
<translation id="8627385813382688019">Browther for Testing शी संबंधित मदत मिळवा</translation>
<translation id="1497802159252041924">इंस्टॉलसंबंधित एरर: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">हे पेज सुरक्षित आहे</translation>
<translation id="7252430412915798987">Browther टॅब शेअर करा</translation>
<translation id="6388429281015199562">Browther मध्ये साइन इन करा</translation>
<translation id="1547469039832541117">हायलाइट केलेली टास्क संपवते.</translation>
<translation id="1801944307203212016">तुमच्या आसपासचा 3D नकाशा तयार करण्यासाठी Browther ला तुमचा कॅमेरा अ‍ॅक्सेस करण्याची परवानगी हवी आहे</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{या एक्स्टेंशनला यापुढे सपोर्ट नाही. तुम्ही ते काढून टाकावे अशी शिफारस Browther करते.}other{या एक्स्टेंशनना यापुढे सपोर्ट नाही. तुम्ही ती काढून टाकावी अशी शिफारस Browther करते.}}</translation>
<translation id="4667068923142532753">Browther पिन करा</translation>
<translation id="3006560544901646947">Browther ची सुरक्षितता टूल</translation>
<translation id="686052171138185761">Browther ला तुमचा Password Manager डेटा हटवायचा आहे. याला अनुमती देण्यासाठी तुमचा Windows पासवर्ड टाइप करा.</translation>
<translation id="8713026329083542796">Browther मधील महत्त्वाच्या गोपनीयता आणि सुरक्षा नियंत्रणांचे पुनरावलोकन करा</translation>
<translation id="1640672724030957280">डाऊनलोड करीत आहे...</translation>
<translation id="1680687534629375545">इमेज शोध ला या पेजबद्दल विचारा</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> साठी वाढीव विशेषाधिकार देते.</translation>
<translation id="4243382967656566037">ही वैशिष्ट्ये सुधारण्यात मदत करण्यासाठी, Browther त्याच्यासोबतचे तुमचे संवाद Browther कडे पाठवते. हा डेटा मानवी परीक्षणकर्त्यांद्वारे वाचला जाऊ शकतो, त्यावर प्रक्रिया केली जाऊ शकते आणि त्यावर भाष्य केले जाऊ शकते.</translation>
<translation id="1722488837206509557">यामुळे तुम्हाला उपलब्ध डिव्हाइसमधून निवडता येईल आणि आशय दाखवता येईल.</translation>
<translation id="6820510278633522408">Browther लवकरच ब्राउझिंग डेटा हटवेल</translation>
<translation id="7775028004939172516">Browther हे नेव्हिगेशन HTTPS वर अपग्रेड करण्याचा प्रयत्न करेल</translation>
<translation id="6963959729951758069">Browther डेटा साफ करण्यात आला</translation>
<translation id="4085139922884095932"><ph name="REMAINING_TIME"/> मध्ये Browther रीस्टार्ट होईल</translation>
<translation id="2586248102295515296">HTTPS उपलब्ध नसल्यास, Browther तुम्हाला चेतावणी न देता असुरक्षित कनेक्शन वापरेल</translation>
<translation id="3975328336074677101">Browther बॅकग्राउंडमध्ये सुरू द्या</translation>
<translation id="2497443204974841650">Browther पुनर्स्थापित करा</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> याचा प्रयत्न करत आहे</translation>
<translation id="4553225588627299783">तुम्ही पुढील वेळी तुमच्या <ph name="DEVICE_TYPE"/> वर Browther उघडल्यावर, तुम्हाला Browther Password Manager वापरण्यासाठी प्रॉम्प्ट दिसेल.</translation>
<translation id="1838374766361614909">शोध साफ करा</translation>
<translation id="2337233040802538155">तुमच्या Browther खाते मध्ये ब्राउझिंग डेटा राखून ठेवून, तो फक्त या डिव्हाइसवरून हटवण्यासाठी, <ph name="BEGIN_LINK"/>Browther मधून साइन आउट करणे<ph name="END_LINK"/> हे करा.</translation>
<translation id="3927415701154897844">फिरतीवर असताना नवीन टॅब गट उघडण्यासाठी किंवा तयार करण्यासाठी तुमच्या फोनवर Browther डाउनलोड करा.</translation>
<translation id="2063443520349987970">तुम्ही तुमची साइन इन केलेली Browther खाती व्यवस्थापित करू शकता. तुमची Browther खाती Browther ब्राउझर, Play Store, Gmail आणि बर्‍याच गोष्टींसाठी वापरली जातात. तुम्हाला कुटुंब सदस्यासारख्या इतर कोणासाठी खाते जोडायचे असल्यास, त्याऐवजी तुमच्या <ph name="DEVICE_TYPE"/> वर नवीन व्यक्ती जोडा. <ph name="LINK_BEGIN"/>अधिक जाणून घ्या<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">इमेज शोध वापरून शोधा</translation>
<translation id="1880677175115548835">मजकूर निवडा</translation>
<translation id="3183933389992069620">तुम्ही एका व्यवस्थापित खात्यासह साइन इन करत आहात आणि तुमच्या Browther प्रोफाइलवर त्याच्या ॲडमिनिस्ट्रेटरला नियंत्रण देत आहात. तुमचा Browther डेटा, जसे की तुमचे अ‍ॅप्स, बुकमार्क, इतिहास, पासवर्ड आणि अन्य सेटिंग्ज <ph name="USER_NAME"/> वर कायमच्या बद्ध होतील. तुम्ही Browther खाती डॅशबोर्डद्वारे हा डेटा हटवण्यात सक्षम व्हाल, परंतु तुम्ही दुसर्‍या खात्यासह हा डेटा संबद्ध करण्यात सक्षम असणार नाही. तुम्ही तुमचा विद्यमान Browther डेटा वेगळी ठेवण्यासाठी एक नवीन पर्यायी प्रोफाइल तयार करू शकता. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther हे स्मूथ स्क्रोलिंग आणि व्हिडिओ फ्रेम रेटसारखी बॅकग्राउंड अ‍ॅक्टिव्हिटी व व्हिज्युअल इफेक्ट मर्यादित करून बॅटरी पॉवरची बचत करते. <ph name="BEGIN_LINK"/>एनर्जी सेव्हर बद्दल अधिक जाणून घ्या<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">या पेजबद्दल विचारा</translation>
<translation id="9128006428501241840">Browther Updater सेवा</translation>
<translation id="6302815314157879372">हे बंद करून, तुम्ही Browther वर साइन इन न करता Gmail सारख्या Browther साइटवर साइन इन करू शकता</translation>
<translation id="1063611196035804685">Browther असंवादी आहे. आता पुन्‍हा लाँच करायचे?</translation>
<translation id="2873360330889594383">तुमची संस्थेच्या <ph name="MANAGER"/> नुसार तुम्ही Browther मध्ये साइन इन करणे आवश्यक आहे</translation>
<translation id="4035053306113201399">अपडेट लागू करण्यासाठी ChromeOS रीस्टार्ट करणे आवश्यक आहे.</translation>
<translation id="2861285003831382718">फाइल प्रकार सामान्यतः डाउनलोड केला जात नसल्याने Browther ने हे डाउनलोड ब्लॉक केले आहे आणि तो धोकादायक असू शकतो</translation>
<translation id="1953553007165777902">डाउनलोड करत आहे... <ph name="MINUTE"/> मिनिट(मिनिटे) शिल्‍लक आहे(आहेत)</translation>
<translation id="2080160985220483492">Browther टीप: पासवर्ड सेव्ह करा</translation>
<translation id="8037497710694492565">Browther डीफॉल्ट ब्राउझर निर्धारित किंवा सेट करू शकत नाही</translation>
<translation id="7395009124247513849">Browther काही फाइल का ब्लॉक करते हे जाणून घ्या, नवीन टॅबमध्ये उघडते</translation>
<translation id="762710512520170632">तुमचे Browther सॉफ्टवेअर अप टू डेट ठेवते. ही सेवा बंद केली गेल्यास किंवा थांबवली गेल्यास, तुमचे Browther सॉफ्टवेअर अप टू डेट ठेवले जाणार नाही, म्हणजेच उद्भवू शकणाऱ्या धोक्यांचे निराकरण केले जाऊ शकणार नाही आणि वैशिष्ट्ये कदाचित काम करणार नाहीत. कोणतेही Browther सॉफ्टवेअर ही सेवा वापरत नसल्यास, ती स्वतःला अनइंस्टॉल करते.</translation>
<translation id="5793588180426267429">हे या डिव्‍हाइसमधून १ आयटम हटवेल. नंतर तुमचा डेटा पुनर्प्राप्त करण्‍यासाठी, Browther मध्ये <ph name="USER_EMAIL"/> म्हणून साइन इन करा.</translation>
<translation id="2018879682492276940">इंस्टॉलेशन करता आले नाही. कृपया पुन्हा प्रयत्न करा.</translation>
<translation id="6351516710581760512">तुमचे इतर पासवर्ड डेटा भंग आणि इतर सुरक्षा समस्यांपासून सुरक्षित आहेत हे तपासण्यासाठी, <ph name="BEGIN_LINK"/>Browther मध्ये साइन इन करा<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">सेटिंग्ज.</translation>
<translation id="8194525816714210105">Browther सेवांमध्ये आणखी पर्सनलाइझ केलेल्या अनुभवासाठी Browther इतिहासाचा समावेश करायचा की नाही हे ठरवा</translation>
<translation id="5909559127548969159">Browther ला नवीन लुक देण्यासाठी नवीन टॅब पेज वर Browther कस्टमाइझ करा बटणावर क्लिक करा</translation>
<translation id="2066690553719545730">AI मोड नेहमी दाखवा</translation>
<translation id="3283892260110318935">फाइल फसवी असल्याने Browther ने हे डाउनलोड ब्लॉक केले आहे आणि ती तुमच्या डिव्हाइसमध्ये अनपेक्षित बदल करू शकते</translation>
<translation id="6160571936643742128">तुम्ही पुढील वेळी Browther iOS उघडल्यावर, तुम्हाला <ph name="FEATURE_NAME"/> वापरून पाहण्यासाठी प्रॉम्प्ट दिसेल.</translation>
<translation id="8380517409933452343">तुम्ही तुमच्या Browther खाते मध्ये सेव्ह केलेले तुमचे पासवर्ड आणि इतर Browther डेटा या डिव्हाइसवरून काढून टाकला जाईल. त्या गोष्टी Browther मध्ये पुन्हा वापरण्यासाठी, पुन्हा साइन इन करा.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Browther १ मिनिटासाठी वापरले जात नाही, तेव्हा तुमची संस्था आपोआप ब्राउझिंग डेटा हटवते. यात इतिहास, ऑटोफिल आणि डाउनलोड यांचा समावेश असू शकतो. तुमचे टॅब खुले राहतील.}other{Browther # मिनिटांसाठी वापरले जात नाही, तेव्हा तुमची संस्था आपोआप ब्राउझिंग डेटा हटवते. यात इतिहास, ऑटोफिल आणि डाउनलोड यांचा समावेश असू शकतो. तुमचे टॅब खुले राहतील.}}</translation>
<translation id="2126108037660393668">डाउनलोड झालेल्या फाइलची पडताळणी करता आली नाही.</translation>
