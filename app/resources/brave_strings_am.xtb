<translation id="3550129882823305293">Browther ውስጥ በምስል ፍለጋ ስለመፈለግ የበለጠ ይወቁ</translation>
<translation id="1401757916223057494">የጫኚው መዝገብ ተበላሽቷል ወይም ትክክል አይደለም። እባክዎ Braveን እንደገና ያውርዱ።</translation>
<translation id="5029760494698649486">Browther Windows 10 ወይም ከዚያ በላይ ያስፈልገዋል።</translation>
<translation id="7906734902028783072">ከተፈለገ፦ የምርመራ እና የአጠቃቀም ውሂብ ወደ Browther በራስ-ሰር በመላክ የChromeOS ባህሪያትን እና አፈጻጸምን እንዲሻሻል ያግዙ።</translation>
<translation id="6791756730901393492">Browther መለያዎ ውስጥ የBrave ውሂብን ለመጠቀም እና ለማስቀመጥ እርስዎ መሆንዎን ያረጋግጡ</translation>
<translation id="4879869745782826167">ወደ Browther ለመግባት ጥያቄዎችን ያሳያል</translation>
<translation id="2967761098021401720">Browther ጊዜው አልፎበታል</translation>
<translation id="7674832651694000881">Braveን እንደ ነባሪ አሳሽዎ ስለመረጡ እናመሰግናለን!</translation>
<translation id="4507581730979762077">እርስዎ የይለፍ ቃላትዎን ሲያስቀምጧቸው Browther መፈተሽ ይችላል</translation>
<translation id="7205233182271132386">Browther ከይለፍ ቃሎችዎ ውስጥ አንዱን በይፋዊ የውሂብ ጥሰት ውስጥ ካገኘ ማስጠንቀቂያ ያግኙ</translation>
