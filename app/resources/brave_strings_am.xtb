<translation id="8242947409070121799">Browther የእርስዎን የይለፍ ቃላት መፈተሽ አይችልም። ከ24 ሰዓቶች በኋላ እንደገና ይሞክሩ።</translation>
<translation id="1737922827960215472">በማንኛውም ጊዜ Braveን በቀላሉ ማግኘት እንዲችሉ በእርስዎ መትከያ ውስጥ ያቆዩት</translation>
<translation id="335855266303176628">በመልዕክቶች፣ ሰነዶች እና ሌሎች መተግበሪያዎች ውስጥ አገናኞች ላይ ጠቅ በሚያደርጉበት ማንኛውም ጊዜ Browther ይጠቀሙ</translation>
<translation id="709455597778444012">ተግባር መሪ - Browther</translation>
<translation id="7147140345767587643">በBrave የተገመቱ የእርስዎ ዝንባሌዎች</translation>
<translation id="7337408274890534789">በቅጽበት ማሰስ ይጀምሩ፦ አሁን Windows ሲጀምር Browther መጀመር ይችላል።</translation>
<translation id="7274695763216404502">ፒን ተደርጓል! ከመሣሪያ አሞሌው እንደገና የምስል ፍለጋ ይጠቀሙ</translation>
<translation id="7288567540154601580">ትሮች እና ቅጥያዎች</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{Browther እንዲያስወግዱት ይመክራል}one{Browther እንዲያስወግዱት ይመክራል}other{Browther እንዲያስወግዷቸው ይመክራል}}</translation>
<translation id="1527644038571473502">የሥርዓት ኦዲዮን ለማጋራት የሥርዓት ቅንብሮችን ይክፈቱ እና ለBrave «የሥርዓት የኦዲዮ ቀረጻ ብቻ» ይፍቀዱ። ከዚያ Braveን እንደገና ማስጀመር ይኖርብዎታል።</translation>
<translation id="1427913074981060872">የማስታወቂያ ልኬት እርስዎ የሚጎበኟቸው ጣቢያዎች የማስታወቂያዎቻቸውን አፈጻጸም የሚለካው ጣቢያ የሚያግዘውን መረጃ ከBrave እንዲጠይቁ ያስችላቸዋል። የማስታወቂያ ልኬት በተቻለ መጠን ትንሽ መረጃን በጣቢያዎች መካከል በማስተላለፍ የጣቢያ ተሻጋሪ ክትትልን ይገድባል።</translation>
<translation id="1657652725060525338">Braveን በማዘመን ላይ...</translation>
<translation id="884846289464870238">የምርጫዎች ፋይልዎ የተበላሸ ወይም ልክ ያልሆነ ነው።

Browther ቅንብሮችዎን ማስመለስ አልቻለም።</translation>
<translation id="7339898014177206373">አዲሰ መስኮት</translation>
<translation id="633044855886370183">የእርስዎ ድር፣ ዕልባቶች እና ሌሎች የBrave ነገሮች እዚህ ይኖራሉ።</translation>
<translation id="1185960088713242527">የእርስዎን የተመሰጠረ ውሂብ ማንበብ የሚችለው የይለፍ ሐረግዎ ያለው ሰው ብቻ ነው። የይለፍ ሐረጉ ወደ Browther አይላክም ወይም በBrave አይከማችም። የእርስዎን የይለፍ ሐረግ ከረሱ ወይም ይህን ቅንብር መለወጥ ከፈለጉ <ph name="BEGIN_LINK"/>በመለያዎ ውስጥ ያለውን Browther ውሂብ መሰረዝ<ph name="END_LINK"/> ይኖርብዎታል።</translation>
<translation id="7125151836477182110">የእርስዎ ስርዓት አስተዳዳሪ Browther <ph name="TARGET_URL_HOSTNAME"/>ን ለመድረስ <ph name="ALTERNATIVE_BROWSER_NAME"/>ን እንዲከፍት አዋቅሮታል።</translation>
<translation id="7352651011704765696">የሆነ ችግር ተፈጥሯል</translation>
<translation id="6638123710106659002">የወደፊት የBrave ዝማኔዎችን ለማግኘት macOS 13 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር macOS 12 እየተጠቀመ ነው።</translation>
<translation id="7286289384512061761">በቅርብ ጊዜ አልጎበኙም። Browther <ph name="PERMISSION_1"/>፣ <ph name="PERMISSION_2"/>ን አስወግዷል።</translation>
<translation id="113593073175678746">ይህ ቅጥያ ከአሁን በኋላ አይደገፍም። Browther እንዲያስወግዱት ይመክራል።</translation>
<translation id="137615076640044304">ካቆሙበት ይቀጥሉ፦ Browther እንደገና በጀመሩ ቁጥር የእርስዎን ትሮች ወደነበሩበት ይመልሳል። ይህን ለማጥፋት ወደሚከተለው ይሂዱ</translation>
<translation id="5967238175620483220">የይለፍ ቃላትን ወደ Browther ያምጡ</translation>
<translation id="4719434010343478165"><ph name="PAGE_TITLE"/> - Browther ግንባታ</translation>
<translation id="7450541714075000668">ጽሁፍ ገልብጧል</translation>
<translation id="7766009218653304791">Browther ለዚህ ጣቢያ የእርስዎን ካሜራ ለመድረስ ፈቃድ ያስፈልገዋል</translation>
<translation id="5844418066487488520">ማይክሮፎንዎን ለመጠቀም <ph name="BEGIN_LINK"/>የሥርዓት ቅንብሮች<ph name="END_LINK"/> ውስጥ ለBrave መዳረሻ ይስጡ</translation>
<translation id="8065480549334161841">የወደፊት የBrave ዝማኔዎችን ለማግኘት Windows 10 ወይም ከዚያ በላይ ያስፈልግዎታል። ይህ ኮምፒውተር Windows 7ን እየተጠቀመ ነው።</translation>
<translation id="6299293759264950896">Browther ዳግም ይጀመር?</translation>
<translation id="180908550381040105">እየሄደ ያለውን ተመሳሳዩን የBrave ስሪት መጫን አይቻልም። እባክዎ Braveን ይዝጉና እንደገና ይሞክሩ።</translation>
<translation id="7625576878150380853">ወደ Browther በመለያ በሚገቡበት በማንኛውም ጊዜ በእርስዎ Browther መለያ ውስጥ የይለፍ ቃላት እና ሌሎችንም እናስቀምጣለን እና እንጠቀማለን። <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">ጣቢያዎች እንደተጠበቀው መስራታቸው አይቀርም። ከBrave መለያዎ በስተቀር በ Browther ውስጥ ገብተው ከሆነ፣ ሁሉንም የBrave መስኮቶች ሲዘጉ ከአብዛኞቹ ጣቢያዎች ይወጣሉ።</translation>
<translation id="7099370564362681943">{0,plural, =1{Browther በ1 ደቂቃ ውስጥ ዳግም ይጀመራል}one{Browther በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}other{Browther በ# ደቂቃዎች ውስጥ ዳግም ይጀመራል}}</translation>
<translation id="3602613943932672197">ውሂብዎን ለመጠበቅ Browther እርስዎ በቅርቡ ካልጎበኟቸው ጣቢያዎች ላይ ፈቃዶችን እንዲያስወግድ ይፍቀዱ።</translation>
<translation id="8759568213742229377">በቅጽበት ማሰስ ለመጀመር Braveን በራስ-ሰር አስጀምር።</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ጫኝ</translation>
<translation id="8991800242749014880">Browther ካሜራዎን እና ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="2692328388439821508">Browther አሁን ይበልጥ ተሻሽሏል</translation>
<translation id="4318444066563223295">አሁን Browther ውስጥ የሚገኙ ተጨማሪ ባህሪያት አሉዎት</translation>
<translation id="7649070708921625228">እገዛ</translation>
<translation id="5591287320769313116">Browther ለእርስዎ እንዲያስስ ይፍቀዱ</translation>
<translation id="7658239707568436148">ይቅር</translation>
<translation id="6325482130534634729">Browther ነባሪ አሳሽዎ አይደለም</translation>
<translation id="8185915921134219287">በመላ መሣሪያዎችዎ ላይ Braveን ያሳምሩ እና ግላዊነት ያላብሱ</translation>
<translation id="5120421624925726813">Browther ዝማኔ</translation>
<translation id="7716950018788545737">ተግባር(ራት) አልቋል(አልቀዋል)።</translation>
<translation id="77283119132245232">ለ<ph name="BROWSER_NAME"/> የሥርዓት ክትትል አገልግሎቶች ያቀርባል። ይህ አገልግሎት ከተሰናከለ በአሳሹ የተፈጠሩ የአፈጻጸም መከታተያዎች እንደ የዓውድ መቀያየሪያ እና ዝግጁ ተከታታይ ክስተቶች ያሉ ሥርዓት አቀፍ ክስተቶችን አያካትቱም።</translation>
<translation id="6542096191573265107">ይሄ የአሰሳ ውሂብዎን ከዚህ መሣሪያ ይሰርዘዋል። ውሂብዎን በኋላ ላይ ሰርስረው ለማውጣት እንደ <ph name="USER_EMAIL"/> ሆነው ወደ Browther ይግቡ።</translation>
<translation id="7747138024166251722">ጫኝው ጊዜያዊ ማውጫ መፍጠር አልቻለም። እባክዎ ነፃ የዲስክ ቦታ እና ሶፍትዌር የመጫን ፍቃድ እንዳለ ይፈትሹ።</translation>
<translation id="351575328720488268">ወደ ነባሪ Browther ዳግም አስጀምር</translation>
<translation id="1054170408395182418">Braveን እንደ ነባሪ ያቀናብሩ እና የተግባር አሞሌው ላይ ይሰኩት</translation>
<translation id="4569594230301902490">Braveን የበለጠ ፈጣን ያድርጉት</translation>
<translation id="5525298466557654312"><ph name="PAGE_TITLE"/> - Browther Canary</translation>
<translation id="7893465573639396635">የበይነመረብ ትራፊክዎ መዳረሻ ላላቸው ሰዎች እርስዎ የትኞቹን ጣቢያዎች እንደሚጎበኙ ማየት ያክብዱባቸው። Browther የጣቢያውን አይ ፒ አድራሻ በዲኤንኤስ (የጎራ ስም ሥርዓት) ውስጥ ለመፈለግ የተመሰጠረ ግንኙነትን ይጠቀማል።</translation>
<translation id="7810005234485217901">በቀላሉ ለመድረስ የምስል ፍለጋን ፒን ማድረግ ይችላሉ</translation>
<translation id="2462631024103158515">ይህን መለያ ያለው አንድ የBrave መገለጫ አስቀድሞ በዚህ መሣሪያ ላይ አለ</translation>
<translation id="7845233973568007926">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME"/>ን ከመጠቀምዎ በፊት ኮምፒውተርዎን እንደገና ማስጀመር አለብዎት።</translation>
<translation id="311190437086049332">Braveን አዲስ መልክ ለመስጠት ያብጁት</translation>
<translation id="6728847658878265103">Browther ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ጥገናዎች እያመለጡዎት ናቸው። Braveን ማዘመን አለብዎት።</translation>
<translation id="7872446069773932638">በማውረድ ላይ... <ph name="SECONDS"/> ሰከንድ(ዶች) ይቀራሉ</translation>
