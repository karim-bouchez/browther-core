<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{1 የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነበር}=1{1 የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}one{# የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}other{# የUSB መሣሪያ በአንድ ወይም ከዚያ በላይ በሆኑ የBrave ቅጥያዎች እየተደረሰባቸው ነው}}</translation>
<translation id="2065456480740480340">Browther ታሪክ</translation>
<translation id="5011660649081947055">ጫኚው መዝገቡን መበተን አልቻለም። እባክዎ Braveን እንደገና ያውርዱት።</translation>
<translation id="310459126943037700">ተግባር(ራት)ን ማብቃት አልተሳካም።</translation>
<translation id="3104828284009500087">በገጽ ላይ ማንኛውንም ነገር ይፈልጉ</translation>
<translation id="4917564010081457061">የይለፍ ቃልዎን፣ ዕልባቶችዎን እና ታሪክዎን በመላው መሣሪያዎችዎ ላይ በትክክል ሠምረው እንዲቆዩ ያድርጉ። ነባሪ አሳሽዎን ወደ Browther በማዘመን በቀላሉ የሚያውቋቸውን እና የሚወዷቸውን ባህሪያት ይድረሱ።</translation>
<translation id="1041472930719344928">Browther ማይክሮፎንዎን እየተጠቀመ ነው።</translation>
<translation id="3130333203120345554">አዲስ ፍለጋ</translation>
<translation id="3137969841538672700">ለመፈለግ ይጎትቱ</translation>
<translation id="5312717254055363883">ይህ ትር ተጨማሪ ንብረቶችን እየተጠቀመ ነው። አፈጻጸምዎን ለማሻሻል Browther እንዲያቦዝነው ይፍቀዱ።</translation>
<translation id="373523409348786203">ማያ ገፅዎን ለማጋራት በሥርዓት ቅንብሮች ውስጥ ለBrave የማያ ገፅ መቅረጽን ይፍቀዱ</translation>
<translation id="802113445299754598">Braveን ዳግም አስጀምር</translation>
<translation id="3161522574479303604">ሁሉም ቋንቋዎች</translation>
<translation id="4522189060330781648">በኮምፒውተርዎ ላይ ያለ ሌላ ፕሮግራም Browther የሚሠራበትን መንገድ ሊለውጥ የሚችል አንድ ገጽታ አክሏል።

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">አዲሱን የBrave መገለጫዎን ያብጁ</translation>
<translation id="5150830326120505481">የBrave መለያዎን ከBrave ለማስወገድ በቅንብሮች ገጽ ውስጥ ከBrave ዘግተው ይውጡ</translation>
<translation id="7113660200899017820">በኋላ ላይ Browther ለእርስዎ ቅጾችን በራስ-ለመሙላት የተቀመጠ መረጃ መጠቅም እንደሚፈልጉ ይጠይቃል</translation>
<translation id="4475011322243623412">Browther የውሂብ አቃፊው ላይ ማንበብ እና መጻፍ አይችልም፦

