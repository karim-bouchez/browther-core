<translation id="8010081455002666927">በራስ-አግኝ</translation>
<translation id="174885789898161653">አንዴ Browther መዳረሻ ከኖረው በኋላ ድር ጣቢያዎች እርስዎን መዳረሻ መጠየቅ ይችላሉ።</translation>
<translation id="3001754454174546602">በማንኛውም ጊዜ በፍጥነት ወደ Browther ለመሄድ ፒን ያድርጉት</translation>
<translation id="80471789339884597">ሰለተጫኑ እናመሰግናለን። <ph name="BUNDLE_NAME"/>ን ከመጠቀምዎ በፊት ሁሉንም አሳሾችዎን እንደገና ማስጀመር አለብዎት።</translation>
