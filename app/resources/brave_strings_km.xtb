<translation id="648319183876919572">ការរុករក​ដោយសុវត្ថិភាពបន្ថែម​ធ្វើបានកាន់តែច្រើនក្នុងការការពារអ្នកពី​ការទាញយក និងគេហទំព័រ​គ្រោះថ្នាក់</translation>
<translation id="2930243146591999795">លុបការតំឡើង Browther</translation>
<translation id="5241183382286817629">ផ្លូវកាត់​បើក​នៅក្នុង Browther</translation>
<translation id="7907014599435829661">ស្ថាប័ន​របស់អ្នក​បិទ Browther នៅពេលដែល​មិនប្រើប្រាស់វា​រយៈពេល <ph name="TIMEOUT_DURATION"/>។ ទិន្នន័យរុករក​ត្រូវបាន​លុប។ ទិន្នន័យ​នេះ​អាច​រួមមាន​ប្រវត្តិ ការ​បំពេញស្វ័យប្រវត្តិ និង​ការទាញ​យក។</translation>
<translation id="2088471423667794811">កម្រងព័ត៌មាននីមួយៗមានព័ត៌មាន Browther របស់វាផ្ទាល់ដូចជា ចំណាំ ប្រវត្តិ ពាក្យ​សម្ងាត់ និងអ្វីៗជាច្រើនទៀត</translation>
<translation id="9040334484455218184">ស្វែងយល់​បន្ថែម​អំពី<ph name="BEGIN_LINK"/>របៀបដែល Browther រក្សាទិន្នន័យ​របស់អ្នក​ជាលក្ខណៈ​ឯកជន<ph name="END_LINK"/></translation>
<translation id="1718697235867382480">ការផ្លាស់ប្ដូរ​ចំពោះ​ការកំណត់នេះ​នឹង​ត្រូវបាន​អនុវត្ត​បន្ទាប់ពី Browther ចាប់ផ្ដើម​ឡើងវិញ។</translation>
<translation id="6331317152404762758">អ្នកអាចប្ដូរ ដើម្បីមើល​ពាក្យសម្ងាត់​ពីកម្រងព័ត៌មាន Browther ផ្សេងទៀត</translation>
<translation id="6097706403184348562">ដើម្បី​កែ​កំហុសអក្ខរាវិរុទ្ធ​, Browther ផ្ញើ​អក្សរ​ដែលអ្នក​វាយបញ្ចូល​នៅក្នុង​កន្លែង​បញ្ចូលអក្សរ​ទៅ Browther</translation>
<translation id="2319647238307402812">ចូលទៅ​កាន់ការ​កំណត់​ការជូន​ដំណឹង Browther</translation>
<translation id="6600016381025017075">ស្វែងរកអ្វីមួយនៅលើទំព័រនេះ</translation>
<translation id="8031938899816118394">ការផ្លាស់ប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលបើកដំណើរការ Browther ឡើងវិញពេលក្រោយ។</translation>
<translation id="7412185356697187964">ឥឡូវនេះ Browther ចាប់ផ្ដើម នៅពេល Windows ចាប់ផ្ដើម ដូច្នេះអ្នកអាចចាប់ផ្ដើមរុករកភ្លាមៗ។ អ្នកអាចបិទលក្ខណៈនេះ​បាននៅក្នុងការកំណត់។</translation>
<translation id="9123343592576384616">បន្តពី​ចំណុច​ដែលអ្នក​បានឈប់៖ Browther បានស្ដារ​ផ្ទាំង​របស់អ្នក​ពីវគ្គ​ចុងក្រោយ​របស់អ្នក។ អ្នកអាច​បិទមុខងារនេះ​បាននៅក្នុង</translation>
<translation id="5847926498049048567">Browther ត្រូវការ​ការអនុញ្ញាត​កាមេរ៉ា ដើម្បីបង្កើត​ផែនទី 3D នៃមជ្ឈដ្ឋានជុំវិញ​របស់អ្នក</translation>
<translation id="5532585028508811858">ប្រសិនបើអ្នកក៏រក្សាទុកចំណាំរបស់អ្នកនៅក្នុងគណនី Browther របស់អ្នក នោះអ្នកអាចតាមដានតម្លៃផលិតផលនៅក្នុង Browther និងទទួលបានការជូនដំណឹងនៅពេលមានការធ្លាក់ថ្លៃ</translation>
<translation id="6676384891291319759">ចូលប្រើអ៊ីនធឺណិត</translation>
<translation id="1363996462118479832">ChromeOS មិនអាចធ្វើ​សមកាលកម្មទិន្នន័យរបស់អ្នកបានទេ ដោយសារមានបញ្ហាក្នុងការចូលគណនី។</translation>
<translation id="3373239673945775810">ដក​ទិន្នន័យ​កម្មវិធីនេះ​ចេញពី Browther</translation>
<translation id="8122759674786039814">Browther ផ្ដល់ឱ្យអ្នកនូវការគ្រប់គ្រងបន្ថែមលើការផ្សាយពាណិជ្ជកម្មដែលអ្នកមើលឃើញ និងដាក់កំហិតលើគេហទំព័រដែលអាចស្វែងយល់អំពីអ្នក នៅពេលដែលគេហទំព័រទាំងនោះបង្ហាញការផ្សាយពាណិជ្ជកម្មដែលមានលក្ខណៈផ្ទាល់ខ្លួនដល់អ្នក</translation>
<translation id="6277682530398500159">Browther ត្រូវការ​ការអនុញ្ញាត​មីក្រូហ្វូន​សម្រាប់​គេហទំព័រនេះ</translation>
<translation id="6712881677154121168">បញ្ហា​ក្នុងការទាញយក៖ <ph name="DOWNLOAD_ERROR"/>។</translation>
<translation id="2972046656127603037">ទម្រង់របស់អ្នកមិនអាចត្រូវបានប្រើទេ ពីព្រោះវាមកពីកំណែ Browther ថ្មីជាងនេះ។

លក្ខណៈពិសេសមួយចំនួនអាចប្រហែលជាមិនមានទេ។.សូមបញ្ជាក់ពីថតឯកសារទម្រង់ផ្សេងទៀត ឬប្រើកំណែ Browther ថ្មីជាងនេះ។</translation>
<translation id="871671753163165892">ដើម្បីទទួលបានការកំណត់​ឱ្យមានលក្ខណៈផ្ទាល់ខ្លួន និងមុខងារផ្សេងទៀត សូមរួមបញ្ចូល Browther នៅក្នុងសកម្មភាពកម្មវិធី និងគេហទំព័រ និងសេវាកម្ម Browther ដែលបានភ្ជាប់</translation>
<translation id="5000832110229523807">Browther ត្រូវបានដំឡើងរួចហើយសម្រាប់អ្នកប្រើទាំងអស់នៅលើកុំព្យូទ័ររបស់អ្នក។</translation>
<translation id="5204575479550973859">ដើម្បី​ទទួលបាន​ចំណាំ​របស់អ្នក និង​អ្វីៗជាច្រើនទៀត​នៅលើ​ឧបករណ៍​ទាំងអស់​របស់អ្នក សូម​ចូលគណនី Browther។ ចំណាំ​នេះនឹង​ត្រូវបាន​រក្សាទុក​នៅក្នុង​គណនី Browther របស់អ្នក បន្ទាប់ពី​អ្នកចូល​គណនី។</translation>
<translation id="2874208284092283937">បង្កើន​ល្បឿន​គេហទំព័រ​ដោយប្រើ​ម៉ាស៊ីន V8 របស់ Browther ប៉ុន្តែ​ធ្វើឱ្យ Browther មិនសូវធន់នឹង​ការវាយប្រហារ​បន្តិច។ ការកំណត់​នេះ​ត្រូវ​បានបើក។</translation>
<translation id="3268577459683869744">{count,plural, =1{ទិន្នន័យ Browther មួយចំនួន​របស់អ្នក​មិនទាន់​ត្រូវបាន​រក្សាទុក​នៅក្នុង​គណនី Browther របស់អ្នក​ទេ។ សូម​សាកល្បង​រង់ចាំ​បន្តិច មុនពេល​ចេញពី​គណនី។ ប្រសិនបើអ្នក​ចេញពីគណនី​ឥឡូវនេះ ទិន្នន័យនេះ (ធាតុ 1) នឹងត្រូវបាន​លុប។}other{ទិន្នន័យ Browther មួយចំនួន​របស់អ្នក​មិនទាន់​ត្រូវបាន​រក្សាទុក​នៅក្នុង​គណនី Browther របស់អ្នក​ទេ។ សូម​សាកល្បង​រង់ចាំ​បន្តិច មុនពេល​ចេញពី​គណនី។ ប្រសិនបើអ្នក​ចេញពីគណនី​ឥឡូវនេះ (ធាតុ {count}) នឹងត្រូវបាន​លុប។}}</translation>
<translation id="7683816018918395929">Browther ណែនាំឱ្យស្កេនឯកសារនេះ ដោយសារវាអាចបង្កគ្រោះថ្នាក់។</translation>
