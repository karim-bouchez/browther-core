<translation id="4555500675737067970">{COUNT,plural, =0{មានកំណែថ្មី​សម្រាប់ Browther ​ហើយ ហើយកំណែថ្មីនេះ​នឹង​ប្រើភ្លាមៗ ​បន្ទាប់ពី​អ្នកចាប់ផ្ដើម​ឡើងវិញ។}=1{មានកំណែថ្មី​សម្រាប់ Browther ​ហើយ ហើយកំណែថ្មីនេះ​នឹង​ប្រើភ្លាមៗ ​បន្ទាប់ពី​អ្នកចាប់ផ្ដើម​ឡើងវិញ។ ផ្ទាំងឯកជនរបស់អ្នក​នឹង​មិនបើកឡើងវិញទេ។}other{មានកំណែថ្មី​សម្រាប់ Browther ​ហើយ ហើយកំណែថ្មីនេះ​នឹង​ប្រើភ្លាមៗ ​បន្ទាប់ពី​អ្នកចាប់ផ្ដើម​ឡើងវិញ។ ផ្ទាំងឯកជន # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Browther ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មីនេះ}=1{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Browther ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មីនេះ។ ផ្ទាំងឯកជនរបស់អ្នក​នឹង​មិនបើកឡើងវិញទេ។}other{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Browther ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មីនេះ។ ផ្ទាំងឯកជន # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{អ្នក​គ្រប់គ្រង​របស់អ្នក​តម្រូវឱ្យអ្នក​ចាប់ផ្ដើម Browther ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មី}=1{អ្នក​គ្រប់គ្រង​របស់អ្នក​តម្រូវឱ្យអ្នក​ចាប់ផ្ដើម Browther ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មី។ ផ្ទាំងឯកជនរបស់អ្នក​នឹង​មិនបើកឡើងវិញទេ។}other{អ្នក​គ្រប់គ្រង​របស់អ្នក​តម្រូវឱ្យអ្នក​ចាប់ផ្ដើម Browther ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មី។ ផ្ទាំងឯកជន # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="8762228142105311329">{COUNT, plural,
              =0 {Advanced Protection requires that you relaunch Browther to apply an update}
              =1 {Advanced Protection requires that you relaunch Browther to apply an update. Your Private window won't reopen.}
              other {Advanced Protection requires that you relaunch Browther to apply an update. Your # Private windows won't reopen.}}</translation>
<translation id="5749154344207139683">ជួយយើងកែលម្អឯកជនដោយការស្ទង់មតិ 1 នាទីនេះ។</translation>
<translation id="6954203250660846933">នៅពេលអ្នកវាយក្នុងបារទីតាំងឬប្រអប់ស្វែងរក Browther នឹងផ្ញើអ្វីដែលអ្នកវាយទៅម៉ាស៊ីនស្វែងរកលំនាំដើមរបស់អ្នកដើម្បីទទួលបានការណែនាំល្អប្រសើរជាងមុន។ នេះត្រូវបានបិទក្នុងផ្នែកឯកជន។</translation>
<translation id="3542179014707218534">Browther Private</translation>
<translation id="2076355018722231995">នៅពេលរុករកក្នុងរបៀបឯកជន Browther នឹងព្រមានអ្នកមុនពេលផ្ទុកវេបសាយដែលប្រើការតភ្ជាប់មិនមានសុវត្ថិភាព</translation>
</translationbundle>