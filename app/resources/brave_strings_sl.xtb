<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sl">
<translation id="1026101648481255140">Nadaljuj namestitev</translation>
<translation id="7099479769133613710">Znova zaženite, če želite posodobiti &amp;Chrome OS</translation>
<translation id="7264054672589027446">Browther priporoča, da pregledate to razširitev</translation>
<translation id="7848219163187166649">Ko spletno mesto zahteva zasebno vnaprejšnje nalaganje povezav na svoji strani, Browther uporabi Googlove strežnike. S tem je vaša identiteta skrita pred vnaprej naloženim mestom, vendar Browther izve, katera spletna mesta se vnaprej nalagajo.</translation>
<translation id="1065672644894730302">Nastavitev ni mogoče prebrati.

Nekatere funkcije morda niso na voljo in spremembe nastavitev ne bodo shranjene.</translation>
<translation id="8837164267124113709">Tvoj starš je izklopil »Dovoljenja za spletna mesta, aplikacije in razširitve« za Browther</translation>
<translation id="881513728707488138">Browther želi izvoziti gesla. Če želite omogočiti to, vnesite geslo za Windows.</translation>
<translation id="112640046208448578">Določite stvari ali mesta in kopirajte ali prevedite besedilo. Če uporabljate slikovno iskanje, se posnetek zaslona strani pošlje strežniku. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther je privzeti brskalnik</translation>
<translation id="6580138787163923852">Če želite preveriti, ali so gesla varna pred podatkovnimi kršitvami in drugimi varnostnimi težavami, <ph name="BEGIN_LINK"/>se prijavite v Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Kliknite Braveov meni</translation>
<translation id="1157985233335035034">Nedavni jeziki</translation>
<translation id="3673786631598474384">Partner <ph name="PARTNER_NAME"/> je dodal razširitev, ki lahko morda spremeni način delovanja Bravea.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Namestitev ni uspela, ker vaša različica sistema Windows ni podprta.</translation>
<translation id="8291401179516272335">O Braveu</translation>
<translation id="1203500561924088507">Hvala, ker ste se odločili za namestitev. Preden uporabite <ph name="BUNDLE_NAME"/>, morate znova zagnati brskalnik.</translation>
<translation id="1232234696885483911">Ko odprete slikovno iskanje, se naslov strani, URL in vsebina, vključno z datotekami PDF, samodejno pošljejo v strežnik. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Ko ste prijavljeni, lahko v Braveu uporabljate svoja gesla in drugo iz računa Browther. Če želite to spremeniti, odprite »Vaš račun v Braveu«.</translation>
<translation id="9034321258761608912">Ko je bil ta zavihek neaktiven, je bil pomnilnik sproščen, da je bil Browther še naprej hiter. Izberete lahko, da to spletno mesto ni nikoli neaktivno.</translation>
<translation id="249571811018731941">Browther je blokiral ta prenos, ker je datoteka nevarna</translation>
<translation id="8850227089720975601">Pri prijavi v Googlove storitve, kot je Gmail ali YouTube, z računom <ph name="USER_EMAIL"/> se lahko z istim računom samodejno prijavite v Browther</translation>
<translation id="1290883685122687410">Napaka pri nastavitvi: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Nastavitev novega profila v Braveu</translation>
<translation id="4437862975743821367">Browther potrebuje dostop do Bluetootha za raziskovanje 
 naprav Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Zaznaj jezik</translation>
<translation id="1206925267243987362">Uporaba priporočenih nastavitev brskalnika Browther</translation>
<translation id="8270483548049772782">Iz Bravea izbriši tudi podatke (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Pripeto. Do slikovnega iskanja lahko znova dostopate z novim gumbom v orodni vrstici.</translation>
<translation id="1356661055722410047">Novo! Prevedete lahko besedilo in slike na zaslonu.</translation>
<translation id="1383876407941801731">Išči</translation>
<translation id="1592588950737518481">&amp;Upravljanje profilov v Braveu</translation>
<translation id="1404026649028693342">Vedno pokaži način umetne inteligence</translation>
<translation id="141901961143729572">Povejte svoje mnenje</translation>
<translation id="1743952081001089298">Če želite deliti okno, v sistemskih nastavitvah omogočite snemanje zaslona za Browther.</translation>
<translation id="8627385813382688019">Pomoč za Browther for Testing</translation>
<translation id="1497802159252041924">Napaka pri namestitvi: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Ta stran je zaščitena</translation>
<translation id="7252430412915798987">Deljenje zavihka v Braveu</translation>
<translation id="6388429281015199562">Prijava v Browther</translation>
<translation id="1547469039832541117">Konča označeno opravilo.</translation>
<translation id="1801944307203212016">Browther potrebuje dovoljenje za dostop do fotoaparata zaradi ustvarjanja tridimenzionalnega zemljevida okolice.</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Ta razširitev ni več podprta. Browther priporoča, da jo odstranite.}one{Te razširitve niso več podprte. Browther priporoča, da jih odstranite.}two{Te razširitve niso več podprte. Browther priporoča, da jih odstranite.}few{Te razširitve niso več podprte. Browther priporoča, da jih odstranite.}other{Te razširitve niso več podprte. Browther priporoča, da jih odstranite.}}</translation>
<translation id="4667068923142532753">Pripni Browther</translation>
<translation id="3006560544901646947">Varnostna orodja v Braveu</translation>
<translation id="686052171138185761">Browther želi izbrisati podatke upravitelja gesel. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="8713026329083542796">Oglejte si ključne kontrolnike zasebnosti in varnosti v Braveu.</translation>
<translation id="1640672724030957280">Prenos ...</translation>
<translation id="1680687534629375545">Vprašajte slikovno iskanje o tej strani</translation>
<translation id="1709772298389099340">Zagotovi povečane pravice za brskalnik <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Zaradi izboljšanja teh funkcij Browther vaše interakcije z njimi pošilja Googlu. Pregledovalci lahko te podatke pregledajo, obdelajo in označijo.</translation>
<translation id="1722488837206509557">Tako boste lahko izbirali med razpoložljivimi napravami in v njih prikazali vsebino.</translation>
<translation id="6820510278633522408">Browther bo kmalu izbrisal podatke brskanja</translation>
<translation id="7775028004939172516">Browther bo poskusil nadgraditi pomikanje na HTTPS</translation>
<translation id="6963959729951758069">Podatki Bravea so izbrisani</translation>
<translation id="4085139922884095932">Browther se bo znova zagnal čez toliko časa: <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Če HTTPS ni na voljo, Browther uporabi povezavo, ki ni varna, ne da bi vas opozoril</translation>
<translation id="3975328336074677101">Naj se Browther izvaja v ozadju</translation>
<translation id="2497443204974841650">Vnovična namestitev Bravea</translation>
<translation id="1724309687045787742">Browther poskuša <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Ko boste naslednjič odprli Browther v napravi <ph name="DEVICE_TYPE"/>, bo prikazan poziv za uporabo Googlovega upravitelja gesel.</translation>
<translation id="1838374766361614909">Čiščenje iskanja</translation>
<translation id="2337233040802538155">Če želite izbrisati podatke brskanja samo iz te naprave, v računu Browther pa jih želite ohraniti, <ph name="BEGIN_LINK"/>se odjavite iz Bravea<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Prenesite Browther v telefon, da boste lahko na poti odpirali ali ustvarjali nove skupine zavihkov.</translation>
<translation id="2063443520349987970">Upravljate lahko račune Browther, v katere ste prijavljeni. Računi Browther se uporabljajo za brskalnik Browther, Trgovino Play, Gmail in drugo. Če želite dodati račun za nekoga drugega, na primer družinskega člana, v napravo <ph name="DEVICE_TYPE"/> dodajte novo osebo. <ph name="LINK_BEGIN"/>Več o tem<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Iskanje s slikovnim iskanjem</translation>
<translation id="1880677175115548835">Izbira besedila</translation>
<translation id="3183933389992069620">Prijavljate se z upravljanim računom in s tem njegovemu skrbniku omogočate nadzor vašega profila v Braveu. Vaši podatki v Braveu, kot so aplikacije, zaznamki, zgodovina, gesla in druge nastavitve, bodo postali trajno povezani z uporabnikom <ph name="USER_NAME"/>. Te podatke boste lahko izbrisali na nadzorni plošči za Browther Račune, vendar jih ne boste mogli povezati z drugim računom. Če želite, lahko ustvarite nov profil, da bodo obstoječi podatki v Braveu ostali ločeni. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther varčuje z energijo baterije tako, da omeji dejavnost v ozadju in vizualne učinke, kot sta tekoče pomikanje in število sličic v sekundi pri videoposnetkih. <ph name="BEGIN_LINK"/>Preberite več o varčevanju z energijo<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Vprašajte o tej strani</translation>
<translation id="9128006428501241840">Braveova storitev za posodabljanje</translation>
<translation id="6302815314157879372">Če to izklopite, se lahko prijavite na Googlovih spletnih mestih, kot je Gmail, ne da bi se morali prijaviti v Browther</translation>
<translation id="1063611196035804685">Browther se ne odziva. Ga želite znova zagnati?</translation>
<translation id="2873360330889594383">Vaša organizacija (<ph name="MANAGER"/>) zahteva, da se prijavite v Browther</translation>
<translation id="4035053306113201399">Če želite uveljaviti posodobitev, morate znova zagnati Chrome OS.</translation>
<translation id="2861285003831382718">Browther je blokiral ta prenos, ker se vrsta datoteke ne prenaša pogosto in je morda nevarna</translation>
<translation id="1953553007165777902">Prenašanje … Še <ph name="MINUTE"/> min.</translation>
<translation id="2080160985220483492">Nasvet za Browther: Shranite gesla</translation>
<translation id="8037497710694492565">Browther ne more določiti ali nastaviti privzetega brskalnika</translation>
<translation id="7395009124247513849">Preberite, zakaj Browther blokira nekatere datoteke, odpre se na novem zavihku</translation>
<translation id="762710512520170632">Poskrbi, da je programska oprema Bravea posodobljena. Če je ta storitev onemogočena ali ustavljena, programska oprema Bravea ne bo posodobljena, kar pomeni, da varnostnih ranljivosti, ki se lahko pojavijo, ni mogoče odpraviti in funkcije morda ne delujejo. Ta storitev se samodejno odstrani, če ni programske opreme Bravea, ki bi jo uporabljala.</translation>
<translation id="5793588180426267429">S tem bo iz te naprave izbrisan 1 element. Če želite pozneje prenesti podatke, se v Browther prijavite kot <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Namestitev ni uspela. Poskusite znova.</translation>
<translation id="6351516710581760512">Če želite preveriti, ali so druga gesla varna pred podatkovnimi kršitvami in drugimi varnostnimi težavami, <ph name="BEGIN_LINK"/>se prijavite v Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Nastavitve.</translation>
<translation id="8194525816714210105">Izberite, ali želite, da je zaradi osebno bolj prilagojenih izkušenj v Googlovih storitvah vključena zgodovina v Braveu.</translation>
<translation id="5909559127548969159">Kliknite gumb za prilagajanje Bravea na novem zavihku s povezavami, da bo Browther videti drugače</translation>
<translation id="2066690553719545730">Vedno pokaži način umetne inteligence</translation>
<translation id="3283892260110318935">Browther je blokiral ta prenos, ker je datoteka zavajajoča in v napravi morda izvaja nepričakovane spremembe</translation>
<translation id="6160571936643742128">Ko boste naslednjič odprli Browther za iOS, bo prikazan poziv, da preizkusite funkcijo <ph name="FEATURE_NAME"/>.</translation>
<translation id="8380517409933452343">Gesla in drugi podatki v Braveu, ki ste jih shranili v računu Browther, bodo odstranjeni iz te naprave. Če jih želite znova uporabljati v Braveu, se znova prijavite.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate 1 minuto. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}one{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minuto. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}two{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minuti. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}few{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minute. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}other{Organizacija samodejno izbriše podatke brskanja, če Bravea ne uporabljate # minut. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose. Zavihki bodo ostali odprti.}}</translation>
<translation id="2126108037660393668">Napaka pri preverjanju prenesene datoteke.</translation>
<translation id="2135919691573380097">Prijava tega spletnega mesta</translation>
<translation id="2137162749895930932">Zapiranje zaslona za prevajanje</translation>
<translation id="4283559398694996391">Browther je blokiral ta prenos, ker spletno mesto ne uporablja varne povezave in so v datoteko morda posegali</translation>
<translation id="2170098639895543546">Izberite kar koli na strani</translation>
<translation id="2495182092286337191">Prilagodi Browther</translation>
<translation id="2174917724755363426">Namestitev še ni končana. Ali ste prepričani, da jo želite preklicati?</translation>
<translation id="4877141231724140862">Browther – Prijava v omrežje – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Napaka pri preverjanju posodobitev: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Odstranitev računa iz Bravea</translation>
<translation id="1084363153644366288">Ostanite varnejši na poti z izboljšanim varnim brskanjem v Braveu za iOS</translation>
<translation id="7949164640723239455">Nevarno spletno mesto. Browther je odstranil dovoljenje za obvestila.</translation>
<translation id="2236949375853147973">Moja dejavnost</translation>
<translation id="4536403809133456417">Če želite dostopati do naslovov in drugega v vseh napravah, se prijavite v Browther. Ta naslov bo po prijavi shranjen v računu Browther.</translation>
<translation id="5627930103267312171">Če računalnik souporabljate z drugimi, lahko prijatelji in sorodniki ločeno brskajo ter nastavijo Browther tako, kot ga želijo.</translation>
<translation id="2283803047247799269">Iščite po tem zavihku s slikovnim iskanjem</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther priporoča, da začasno zaustavite zavihek, ki upočasnjuje brskalnik}one{Browther priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}two{Browther priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}few{Browther priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}other{Browther priporoča, da začasno zaustavite zavihke, ki upočasnjujejo brskalnik}}</translation>
<translation id="2307973900865360088">Obdrži v vrstici Dock</translation>
<translation id="5161617112768367959">Preveri URL-je, tako da jih primerja s seznamom spletnih mest, ki niso varna, shranjenim v Braveu. Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko Browther prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="4123094831918713833">S tem dejanjem se bo zgodilo to:
          <ph name="LINE_BREAKS"/>
           • Ponastavljene bodo nekatere nastavitve v Braveu in bližnjice za Browther.
           <ph name="LINE_BREAK"/>
           • Onemogočene bodo razširitve.
           <ph name="LINE_BREAK"/>
           • Izbrisani bodo piškotki in drugi začasni podatki spletnih mest.
            <ph name="LINE_BREAKS"/>
           To ne bo vplivalo na zaznamke, zgodovino in shranjena gesla.</translation>
<translation id="5456070119344236353">Če želite poslati telefonsko številko od tukaj v telefon Android, se prijavite v Browther v obeh napravah.</translation>
<translation id="2356070529366658676">Vprašaj</translation>
<translation id="2359808026110333948">Naprej</translation>
<translation id="6468415397021485143">Razširitev »<ph name="EXTENSION_NAME"/>« želi, da se prijavite v Browther</translation>
<translation id="2558600429878197587">Onemogoči Browther, ki se izvaja v ozadju za aplikacije</translation>
<translation id="5295781918312989856">Če želite to razširitev uporabljati kot <ph name="USER_EMAIL_ADDRESS"/>, se prijavite v Browther.</translation>
<translation id="8418845734693287262">Chrome OS ni mogel sinhronizirati podatkov, ker so podatki za prijavo v račun zastareli.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{Najmanj ena razširitev za Browther je dostopala do 1 naprave HID}=1{Najmanj ena razširitev za Browther dostopa do 1 naprave HID}one{Najmanj ena razširitev za Browther dostopa do # naprave HID}two{Najmanj ena razširitev za Browther dostopa do # naprav HID}few{Najmanj ena razširitev za Browther dostopa do # naprav HID}other{Najmanj ena razširitev za Browther dostopa do # naprav HID}}</translation>
<translation id="434258293817844111">Browther potrebuje dovoljenje za fotoaparat in mikrofon za to spletno mesto.</translation>
<translation id="2403703063067034158">Napaka pri zagonu: Trenutno se izvaja še en primer nastavitve. Poskusite znova pozneje.</translation>
<translation id="5458993228789433099">Povezave iz poljubne aplikacije odprite v Braveu in poskrbite, da bo brskalnik dostopen v opravilni vrstici</translation>
<translation id="1677640217693742525">Z <ph name="BEGIN_LINK"/>orodji iz Bravea<ph name="END_LINK"/> lahko varno brskate in imate nadzor</translation>
<translation id="2451727308784734061">Z bližnjico lahko hitro odprete Upravitelja gesel. Bližnjico lahko premaknete na začetni zaslon računalnika ali v zaganjalnik aplikacij.</translation>
<translation id="2280315911954332435">Browther se bo kmalu zaprl</translation>
<translation id="6410820860979094113">V Braveu</translation>
<translation id="2485422356828889247">Odmeščanje</translation>
<translation id="2513154137948333830">Potreben je vnovičen zagon: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Izberite besedilo s slikovnim iskanjem</translation>
<translation id="7892218991241200190">Browther poskuša zamenjati obstoječa gesla. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="8976443723926188033">Browther potrebuje za prenos datotek dostop do shrambe</translation>
<translation id="1973587471928846950">Pomoč za Browther</translation>
<translation id="2575822587468774919">Izberite kar koli za iskanje s slikovnim iskanjem</translation>
<translation id="8705561858232289221">Če želite dostopati do gesel in drugega v vseh napravah, se prijavite v Browther</translation>
<translation id="437162022240011372">Še naprej uporabljaj Browther</translation>
<translation id="259935314519650377">Prenesenega namestitvenega programa ni bilo mogoče predpomniti. Napaka: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sistem</translation>
<translation id="2907676829052962091">Vaša organizacija si lahko ogleda in upravlja podatke brskanja, na primer zaznamke, zgodovino in gesla. V drugih profilih v Braveu si ne more ogledati podatkov brskanja.</translation>
<translation id="1289116577679005654">Potrdite, da ste to vi, če želite podatke iz Bravea uporabljati in shranjevati v računu, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7192278346779151664">Napaka v operacijskem sistemu med namestitvijo. Znova prenesite Browther.</translation>
<translation id="7724398260867885339">Če napravo souporabljate z drugimi, lahko prijatelji in sorodniki ločeno brskajo ter nastavijo Browther tako, kot ga želijo.</translation>
<translation id="1679595317134614424">Zavihek v Braveu</translation>
<translation id="7189168846924379421">Zaradi večje varnosti bo Browther šifriral vaše podatke.</translation>
<translation id="4052643592793184278">Če želite račun Browther odstraniti iz Bravea, se odjavite</translation>
<translation id="7694616023994438906">Če želite dostopati do gesel, zaznamkov in drugega v vseh napravah, se prijavite v Browther</translation>
<translation id="2738871930057338499">Internetne povezave ni mogoče vzpostaviti. Koda napake HTTP je »403 Forbidden«. Preverite konfiguracijo strežnika proxy configuration.</translation>
<translation id="2753623023919742414">Kliknite, če želite iskati</translation>
<translation id="9078193405195503710">Nastavite Browther kot privzeti pregledovalnik PDF-jev</translation>
<translation id="2456995288904753506">Browther lahko samodejno izpolni zahtevna polja, ki jih standardno samodejno izpolnjevanje morda ne zazna</translation>
<translation id="3271730304285122987">Ta razširitev vsebuje zlonamerno programsko opremo in ni varna. Odstranite jo iz Bravea, da si ne bo mogla več ogledati vaših podatkov na obiskanih spletnih mestih, vključno z osebnimi podatki, in jih spreminjati.</translation>
<translation id="2799223571221894425">Vnovičen zagon</translation>
<translation id="1427337251963884503">Vaš Browther</translation>
<translation id="2816462166102338036">Iščite ta videoposnetek s slikovnim iskanjem</translation>
<translation id="2841525013647267359">Prevedi iz jezika</translation>
<translation id="2846251086934905009">Napaka pri namestitvi: Namestitveni program se ni dokončal. Namestitev je bila prekinjena.</translation>
<translation id="928966105228355994">Odstranitev iz Bravea ...</translation>
<translation id="587805782197019018">Skrbi za vašo varnost v Braveu in ga je mogoče uporabiti za okrepitev varnosti v drugih Googlovih aplikacijah, ko ste prijavljeni.</translation>
<translation id="2885378588091291677">Upravitelj opravil</translation>
<translation id="3055995278166070443">O &amp;Braveu</translation>
<translation id="2915996080311180594">Znova zaženi pozneje</translation>
<translation id="2928420929544864228">Namestitev je dokončana.</translation>
<translation id="70453521937551896">Podatki so šifrirani z vašim geslom. Vnesite ga, če želite podatke iz Bravea uporabljati in shranjevati v računu Browther.</translation>
<translation id="2945997411976714835">Napaka pri namestitvi: Proces namestitvenega programa se ni zagnal.</translation>
<translation id="3188308520233701133">Hitreje se prijavite na spletnih mestih z uporabo shranjenih gesel za Browther v sistemu iOS</translation>
<translation id="8145318807880784886">Dodajte nov profil v Braveu, da bodo zaznamki, gesla in nastavitve ločeni.</translation>
<translation id="4330268530227888227">Browther upravlja vaša organizacija</translation>
<translation id="6488090896442998436">Browther je posodobljen</translation>
<translation id="300557164611864786">Če vam spletno mesto poskusi ukrasti geslo ali če prenašate škodljivo datoteko, lahko Browther prav tako pošlje URL-je, vključno z delčki vsebine strani, Varnemu brskanju.</translation>
<translation id="2447145782593796785">Zaradi večje varnosti v spletu s starševimi izbirami se prijavi v Browther</translation>
<translation id="3003694935412297923">Vsa opravila</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Browther in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki (1 element) izbrisani.}one{Browther mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Browther in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} element) izbrisani.}two{Browther mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Browther in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementa) izbrisani.}few{Browther mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Browther in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementi) izbrisani.}other{Browther mora preveriti vašo identiteto, preden bo mogoče nekatere podatke shraniti v račun Browther in jih uporabiti v vseh vaših napravah. Če se odjavite zdaj, bodo ti podatki ({count} elementov) izbrisani.}}</translation>
<translation id="5522228731050510047">Odprite <ph name="URL"/> na novem zavihku v Braveu.</translation>
<translation id="6358780591055960280">Browther ne more preveriti gesel. Poskusite pozneje.</translation>
<translation id="1386422761453740126">Dodajanje v Browther ...</translation>
<translation id="3038232873781883849">Čakanje na namestitev …</translation>
<translation id="3045032126857188731">Jezik prevoda: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Zapiranje pogovornega okna za povratne informacije</translation>
<translation id="369127628511662602">Drugi profili v Braveu</translation>
<translation id="2370255879896574713">Pomagajte izboljšati Browther – Googlu pošiljajte poročila o zrušitvah in ta dokument: <ph name="UMA_LINK"/>.</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{Najmanj ena razširitev za Browther je dostopala do 1 naprave USB}=1{Najmanj ena razširitev za Browther dostopa do 1 naprave USB}one{Najmanj ena razširitev za Browther dostopa do # naprave USB}two{Najmanj ena razširitev za Browther dostopa do # naprav USB}few{Najmanj ena razširitev za Browther dostopa do # naprav USB}other{Najmanj ena razširitev za Browther dostopa do # naprav USB}}</translation>
<translation id="2065456480740480340">Zgodovina v Braveu</translation>
<translation id="5011660649081947055">Namestitvenemu programu ni uspelo razširiti arhiva. Znova prenesite Browther.</translation>
<translation id="310459126943037700">Opravil ni bilo mogoče končati.</translation>
<translation id="3104828284009500087">Iščite kar koli na strani</translation>
<translation id="4917564010081457061">Poskrbite, da so gesla, zaznamki in zgodovina popolnoma sinhronizirani v vseh napravah. Posodobite privzeti brskalnik na Browther in preprosto dostopajte do funkcij, ki jih poznate in so vam všeč.</translation>
<translation id="1041472930719344928">Browther uporablja vaš mikrofon.</translation>
<translation id="3130333203120345554">Novo iskanje</translation>
<translation id="3137969841538672700">Povlecite, če želite iskati</translation>
<translation id="5312717254055363883">Ta zavihek uporablja dodatna sredstva. Če želite izboljšati učinkovitost delovanja, pustite Braveu, da ga spremeni v neaktivnega.</translation>
<translation id="373523409348786203">Če želite deliti zaslon, v sistemskih nastavitvah omogočite snemanje zaslona za Browther.</translation>
<translation id="802113445299754598">Znova zaženite Browther</translation>
<translation id="3161522574479303604">Vsi jeziki</translation>
<translation id="4522189060330781648">Drug program v računalniku je dodal temo, ki lahko morda spremeni način delovanja Bravea.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">Prilagajanje novega profila v Braveu</translation>
<translation id="5150830326120505481">Če želite račun Browther odstraniti iz Bravea, se na strani z nastavitvami odjavite iz Bravea</translation>
<translation id="7113660200899017820">Browther vas lahko pozneje vpraša, ali želite uporabiti shranjene podatke za samodejno izpolnjevanje obrazcev</translation>
<translation id="4475011322243623412">Browther ne more brati svojega imenika s podatki ali pisati vanj:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Znova zaženi</translation>
<translation id="3536063527222598206">Manjkajo ključi za Browther API. Nekatere funkcije Bravea bodo onemogočene.</translation>
<translation id="1011450868746766298">Nadaljuj izvajanje aplikacij v ozadju, ko je Browther zaprt</translation>
<translation id="179611081153855734">Browther vas bo opozoril pred nalaganjem katerega koli spletnega mesta prek povezave, ki ni varna</translation>
<translation id="8965591964936552871">Ko zaprete vsa Braveova okna, boste odjavljeni z večine spletnih mest z izjemo računa Browther, če ste prijavljeni v Browther. Če želite, da si vas spletna mesta zapomnijo, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Privzeti iskalnik je bil spremenjen zunaj Bravea. Browther ga je ponastavil zaradi vaše zaščite.</translation>
<translation id="1170501833661894915">Prijavite se v Browther, če želite dostopati do gesel, zaznamkov in drugega v vseh napravah</translation>
<translation id="3352986031709923790">zgornji desni kot območja za iskanje: desno <ph name="RIGHT"/> %, zgoraj <ph name="TOP"/> %</translation>
<translation id="120745000989996104">Podatki v Braveu v vašem računu</translation>
<translation id="3369405342922656244">Iščite po tej strani s slikovnim iskanjem</translation>
<translation id="7173761126541905083">Uporabljajte gesla s Braveom v telefonu</translation>
<translation id="2645435784669275700">Chrome OS</translation>
<translation id="5266583242423616945">Želite preklopiti na obstoječi profil v Braveu?</translation>
<translation id="3412460710772753638">V Upravitelju gesel v tej napravi</translation>
<translation id="4282363917570905631">Razširite izboljšano varno brskanje s Braveom v telefonu</translation>
<translation id="986094398735583155">Browther prilagajamo vam …</translation>
<translation id="3266047225484320321">Browther vas bo obvestil, če se prijavite z ogroženim geslom</translation>
<translation id="3508047337876211050">S tem bo iz te naprave izbrisanih več elementov (<ph name="ITEMS_COUNT"/>). Če želite pozneje prenesti podatke, se v Browther prijavite kot <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">Bližnjica <ph name="SHORTCUT"/> omogoča preklop med profili v Braveu</translation>
<translation id="7225005776233199285">Zaprite vsa okna Bravea in poskusite znova.</translation>
<translation id="5465054931427475969">Če želite deliti okno, v sistemskih nastavitvah omogočite snemanje zaslona za Browther.</translation>
<translation id="6905469223518185641">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen.  Če želite ločiti brskanje, se v Braveu prijavite v svoj profil kot <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">Če želite deliti zaslon, v sistemskih nastavitvah omogočite snemanje zaslona za Browther.</translation>
<translation id="3597003331831379823">Nastavitve s povečanimi pravicami ni bilo mogoče izvesti. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Prijava v Browther</translation>
<translation id="2492221622209669678">Podatki brskanja te osebe bodo izbrisani iz te naprave. Če želite podatke obnoviti, se prijavite v Browther kot <ph name="USER_EMAIL"/>.</translation>
<translation id="6793778233257855801">Če želite telefonsko številko iz <ph name="ORIGIN"/> poslati v telefon Android, se prijavite v Browther v obeh napravah.</translation>
<translation id="3667616615096815454">Namestitev ni mogoča, ker strežnik ne pozna aplikacije.</translation>
<translation id="5585500151754164442">Za šifriranje vseh podatkov v Braveu v računu Browther uporabite <ph name="BEGIN_LINK"/>svoje geslo<ph name="END_LINK"/>. Plačilna sredstva in naslovi iz Googla Pay ne bodo šifrirani. Zgodovina brskanja v Braveu se ne bo sinhronizirala.</translation>
<translation id="404323216042159951">Browther ne more preveriti gesel. Poskusite preveriti internetno povezavo.</translation>
<translation id="5004936474632127765">Odpiranje povezave na novem &amp;zavihku v Braveu</translation>
<translation id="6236643159256182256">Povežite Browther in druge Googlove storitve za osebno prilagajanje in druge namene</translation>
<translation id="3729187154190517324">Poglobite iskanje tako, da dodate več zavihkov, datotek in orodij z gumbom »Dodajte zavihek in drugo«.</translation>
<translation id="1400697664933775238">Upravljanje profilov v Braveu</translation>
<translation id="2461315395128103158">Preberite, zakaj Browther blokira nekatere prenose</translation>
<translation id="8058420662026104226">Browther vas bo obvestil, če boste morali kaj pregledati</translation>
<translation id="3177448557921912221">Profili v Braveu vam pomagajo ločiti različne dele življenja. Dodajte nov profil.</translation>
<translation id="1541177876035612043">Browther vnaprej naloži strani, ki jih boste verjetno obiskali, da se ob obisku naložijo še hitreje</translation>
<translation id="3810973564298564668">Upravljaj</translation>
<translation id="1117103475254549453">Če želite uporabljati shranjena gesla, uporabite kodo QR, prenesite Browther za iOS in se prijavite v račun Browther</translation>
<translation id="8880695882192156860">Nasvet za Browther: Izboljšano varno brskanje</translation>
<translation id="3846683726093018685">**Povzemi:** V enem stavku z največ 30 besedami opiši glavni predmet in namen vsebine na posnetku zaslona.

          **Predlagaj vprašanja:** Generiraj označen seznam s 3–5 vprašanji, ki spodbujajo razmišljanje in jih lahko uporabnik zastavi za boljše razumevanje posnetka zaslona. Ta vprašanja morajo vključevati vsaj eno, ki se nanaša posebej na vizualni predmet, njegovo obliko ali njegovo umestitev.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> – Browther</translation>
<translation id="3885770153807205175">Izbirnik jezika</translation>
<translation id="4861846616763552424">Prilagajanje in nadziranje Bravea. Nekaj morate preveriti – kliknite za podrobnosti.</translation>
<translation id="6126366281251241386">Kliknite ime, da odprete Browther in začnete brskati.</translation>
<translation id="3892148308691398805">Kopiraj besedilo</translation>
<translation id="3760801273210219822">Uporabnik <ph name="EXISTING_USER"/> je že prijavljen v ta profil v Braveu. Če želite ločiti brskanje, lahko Browther za vas ustvari nov profil.</translation>
<translation id="3821553157234855663">P&amp;rilagodite Browther</translation>
<translation id="3941890832296813527">Napaka pri namestitvi: Ime datoteke namestitvenega programa je neveljavno ali ni podprto.</translation>
<translation id="6482299900191767005">Browther poskuša kopirati gesla. Če želite to omogočiti, vnesite geslo za Windows.</translation>
<translation id="5853011008278898603">Gesla, plačilna sredstva in naslovi, ki ste jih shranili v računu Browther, bodo odstranjeni iz te naprave. Če jih želite znova uporabljati v Braveu, se vnovič prijavite.</translation>
<translation id="395904275706073188">Zaščitenih strani ni mogoče prebrati. Poskusite z drugo stranjo.</translation>
<translation id="1832973663231751701">Preberite, kako vas Browther varuje</translation>
<translation id="4531502594774670767">Ko vnašate v naslovno vrstico ali iskalno polje, Browther vaše vnose pošlje v orodja za iskanje, orodja z umetno inteligenco in agentska orodja organizacije zaradi prejemanja predlogov.</translation>
<translation id="300013383485253006">O različici &amp;Browther for Testing</translation>
<translation id="1152920704813762236">O sistemu Chrome OS</translation>
<translation id="8126752030994997015">Ko obišete spletno mesto, Browther prek strežnika za zasebnost, ki skrije vaš naslov IP, <ph name="BEGIN_LINK"/>Browther Varnemu brskanju<ph name="END_LINK"/> pošlje zakriti del URL-jev. Če spletno mesto naredi kaj sumljivega, se pošljejo tudi celotni URL-ji in delčki vsebine strani.</translation>
<translation id="3703994572283698466">Chrome OS omogoča dodatna <ph name="BEGIN_LINK_CROS_OSS"/>odprtokodna programska oprema<ph name="END_LINK_CROS_OSS"/>, enako kot <ph name="BEGIN_LINK_LINUX_OSS"/>razvojno okolje Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Prevedi zaslon</translation>
<translation id="4023601594785368013">Izvirni jezik: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Povezave iz poljubne aplikacije odprite v Braveu, ki bo pripet v opravilno vrstico, da boste lažje dostopali do njega.</translation>
<translation id="3437506136408403836">Pomagajte izboljšati Browther s poročanjem o <ph name="BEGIN_LINK"/>trenutnih nastavitvah<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">V najnovejši različici so na voljo pomembne varnostne izboljšave in nove funkcije.</translation>
<translation id="4055805654398742145">Upravitelj g&amp;esel</translation>
<translation id="2164947358785939495">Drug program v računalniku je dodal razširitev, ki lahko morda spremeni način delovanja Bravea.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Organizacija samodejno zapre Browther, če ga ne uporabljate 1 minuto. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}one{Organizacija samodejno zapre Browther, če ga ne uporabljate # minuto. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}two{Organizacija samodejno zapre Browther, če ga ne uporabljate # minuti. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}few{Organizacija samodejno zapre Browther, če ga ne uporabljate # minute. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}other{Organizacija samodejno zapre Browther, če ga ne uporabljate # minut. Podatki brskanja so izbrisani. To lahko vključuje zgodovino, samodejno izpolnjevanje in prenose.}}</translation>
<translation id="1535413545339990419">Odprite stran »O Braveu«</translation>
<translation id="692283249649018289">Prilagodite Browther, da bo brskalnik videti drugače</translation>
<translation id="6375229634133804834">P&amp;rilagodite Browther</translation>
<translation id="4148957013307229264">Nameščanje ...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> – Prijava v omrežje – Browther</translation>
<translation id="2911246138082876798">Odkrijte zanimive aplikacije, igre, razširitve in teme za Browther.</translation>
<translation id="2528977475313334293">Če želite dostopati do te razširitve in drugega v vseh računalnikih, se prijavite v Browther</translation>
<translation id="8244267655940711467">Zaradi večje varnosti v spletu s starševimi izbirami preklopi na svoj profil v Braveu, kjer si že prijavljen(-a) kot <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="4222932583846282852">Preklic …</translation>
<translation id="4224210481850767180">Namestitev je preklicana.</translation>
<translation id="8219359042845534271">Želite svoje podatke v Braveu povezati s tem računom?</translation>
<translation id="5520777668172961882">Opozori vas o nevarnih spletnih mestih, celo tistih, za katere Browther prej ni vedel, in sicer tako, da analizira več podatkov s spletnih mest kot standardna zaščita. Izberete lahko, da preskočite opozorila za Browther.</translation>
<translation id="2014920019837536689">Odjava iz Bravea</translation>
<translation id="4341512411059715879">Pomoč za Browther</translation>
<translation id="4281844954008187215">Pogoji storitve</translation>
<translation id="322492684764924424">Namestitev ni bila izvedena zaradi nedoločene napake. Če se Browther trenutno izvaja, ga zaprite in poskusite znova.</translation>
<translation id="3813060261346666066">Izvoz gesel iz Bravea</translation>
<translation id="4304713468139749426">Upravitelj gesel</translation>
<translation id="4334241893986177674">Iskanje po tem posnetku zaslona</translation>
<translation id="4334294535648607276">Prenos končan.</translation>
<translation id="2177954934431828302">Zaženi Browther, ko se zažene Windows</translation>
<translation id="2472318668926455009">Nastavite Browther kot privzeti brskalnik in si zagotovite preprost dostop do funkcij, ki jih poznate, so vam všeč in jim zaupate. Browther bo pripet v opravilno vrstico za hitri dostop.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> zahteva, da preberete in sprejmete pogoje storitve, preden začnete uporabljati napravo. Ti pogoji ne dopolnjujejo, spreminjajo ali omejujejo pogojev za Chrome OS.</translation>
<translation id="2897580280700805340">Želite vseeno zapreti Browther?</translation>
<translation id="4413205837991854510">Vedno pokaži bližnjico za slikovno iskanje</translation>
<translation id="2454897022983434851">Naj se Browther izvaja v ozadju</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Browther priporoča, da jo odstranite. <ph name="BEGIN_LINK"/>Preberite več o podprtih razširitvah.<ph name="END_LINK"/>}one{Browther priporoča, da jih odstranite. <ph name="BEGIN_LINK"/>Preberite več o podprtih razširitvah.<ph name="END_LINK"/>}two{Browther priporoča, da jih odstranite. <ph name="BEGIN_LINK"/>Preberite več o podprtih razširitvah.<ph name="END_LINK"/>}few{Browther priporoča, da jih odstranite. <ph name="BEGIN_LINK"/>Preberite več o podprtih razširitvah.<ph name="END_LINK"/>}other{Browther priporoča, da jih odstranite. <ph name="BEGIN_LINK"/>Preberite več o podprtih razširitvah.<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Prilagajanje in nadziranje Bravea</translation>
<translation id="4427306783828095590">Izboljšana zaščita učinkoviteje blokira lažno predstavljanje in zlonamerno programsko opremo.</translation>
<translation id="4434353761996769206">Napaka namestitvenega programa: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> upravlja Browther</translation>
<translation id="4007482010626246887">Dodaj profil v Braveu</translation>
<translation id="6888322430074420631">O različici Browther for Testing</translation>
<translation id="8912436499620582668">Če želite podatke iz Bravea uporabljati in shranjevati v računu Browther, vnesite geslo</translation>
<translation id="4493028449971051158">Napaka pri zagonu: Zaženite namestitveni program kot skrbnik.</translation>
<translation id="4501471624619070934">Namestitev ni bila uspešna, ker je dostop v tej državi omejen.</translation>
<translation id="8976207309012239417">Ta razširitev še ni objavila postopkov zagotavljanja zasebnosti, na primer kako zbira in uporablja podatke. Browther priporoča, da jo odstranite.</translation>
