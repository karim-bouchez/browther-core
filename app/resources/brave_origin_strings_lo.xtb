<translation id="878572486461146056">ຂໍ້ຜິດພາດໃນການຕິດຕັ້ງ: ຜູ້ເບິ່ງແຍງລະບົບເຄືອຂ່າຍຂອງທ່ານໃຊ້ນະໂຍບາຍລະດັບກຸ່ມເຊິ່ງປ້ອງກັນການຕິດຕັ້ງ: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">Browther ຕ້ອງການການອະນຸຍາດເພື່ອເຂົ້າເຖິງກ້ອງຖ່າຍຮູບ ແລະ ໄມໂຄຣໂຟນຂອງທ່ານສຳລັບເວັບໄຊນີ້</translation>
<translation id="8813277370772331957">ແຈ້ງເຕືອນຂ້ອຍໃນພາຍຫຼັງ</translation>
<translation id="6831999464349484462">ເຂົ້າສູ່ລະບົບ Browther ບໍ?</translation>
<translation id="3698151322107951111">ຕັ້ງ Browther ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນ ແລະ ປັກໝຸດໄວ້ຢູ່ແຖບໜ້າວຽກ</translation>
<translation id="8826492472752484139">ຄລິກ “ຕົວຈັດການລະຫັດຜ່ານ”</translation>
<translation id="6933858244219479645">ລະບົບ ChromeOS</translation>
<translation id="3986927308621489499">ລະບົບຈະໃຊ້ພາສານີ້ເພື່ອສະແດງເມນູ, ການຕັ້ງຄ່າ, ແຈ້ງເຕືອນ ແລະ ຂໍ້ຄວາມອື່ນໆໃນ Browther</translation>
<translation id="8862326446509486874">ທ່ານບໍ່ມີສິດທິທີ່ເໝາະສົມສໍາລັບຕິດຕັ້ງ​ໃນລະດັບລະບົບ. ລອງແລ່ນຕົວຕິດຕັ້ງນີ້ອີກ​ໃນ​ຖານະ​ເປັນ​ຜູ້ຄວບຄຸມ.</translation>
<translation id="5318226144018267261">ເພີ່ມໂປຣໄຟລ໌ Browther</translation>
<translation id="1298790608554316415">ຖ້າເປັນເຊັ່ນນັ້ນ, ກະລຸນາແກ້ໄຂລະຫັດຜ່ານທີ່ບັນທຶກໄວ້ຂອງທ່ານໃນ Browther ເພື່ອໃຫ້ມັນກົງກັບລະຫັດຜ່ານໃໝ່ຂອງທ່ານ.</translation>
<translation id="960933321883777733">ອົງກອນຂອງທ່ານກຳນົດໃຫ້ທ່ານເຂົ້າສູ່ລະບົບ Browther</translation>
<translation id="948979409756947611">Browther ກໍາລັງພະຍາຍາມສະແດງລະຫັດຜ່ານ. ພິມລະຫັດຜ່ານ Windows ຂອງທ່ານ ເພື່ອອະນຸຍາດອັນນີ້.</translation>
<translation id="1418854271943945136">Browther ບໍ່ແມ່ນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນຂອງທ່ານອີກຕໍ່ໄປ. ຕັ້ງຄ່າ Browther ເປັນໂປຣແກຣມທ່ອງເວັບເລີ່ມຕົ້ນບໍ?</translation>
<translation id="7228667329366610727">ບໍ່ສາມາດອັບເດດ Browther ໄດ້</translation>
<translation id="4817697255467736794">ໂລໂກ້ Browther Enterprise</translation>
<translation id="3507731466523097529">ບໍ່ສາມາດເລີ່ມ Browther ໄດ້ເນື່ອງຈາກມີບາງຢ່າງຜິດພາດເກີດຂຶ້ນເມື່ອເປີດໂປຣໄຟລ໌ຂອງທ່ານ. ລອງຣີສະຕາດ Browther.</translation>
<translation id="3234473600657230663">ຈັດການໂປຣໄຟລ໌ Browther</translation>
<translation id="8953887022581653484">Browther ບລັອກການດາວໂຫຼດນີ້ເພາະວ່າໄຟລ໌ທີ່ເກັບໄວ້ໃນແຟ້ມມີໄຟລ໌ອື່ນໆທີ່ອາດຈະເຊື່ອງເມົາແວໄວ້</translation>
<translation id="532304972436358335">ເຂົ້າສູ່ລະບົບ Browther ເມື່ອທ່ານເຂົ້າສູ່ລະບົບບໍລິການອື່ນໆຂອງ Browther</translation>
