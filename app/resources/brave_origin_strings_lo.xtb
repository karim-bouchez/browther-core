<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">ການ​ຕິດ​ຕັ້ງ​ບໍ່​ສໍາ​ເລັດ ​ເນື່ອງ​ຈາກ​ຄວາມຜິດພາດທີ່ບໍ່ໄດ້ລະບຸ​. ກະ​ລຸ​ນາ​ດາວ​ໂຫລດ Browther ອີກ​.</translation>
<translation id="9074842261125908635">ສ່ວນຂະຫຍາຍ, ແອັບ, ແລະຫົວຂໍ້ທີ່ມາຈາກແຫຼ່ງທີ່ບໍ່ຮູ້ຈັກອັນຕະລາຍຕໍ່ອຸປະກອນຂອງທ່ານ. Browther ແນະນຳໃຫ້ຕິດຕັ້ງສ່ວນຂະຫຍາຍເຫລົ່ານີ້ບໍຂໍ້ມູນຈາກ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="3593119910409528681">ສ່ວນຂະຫຍາຍອັນນີ້ລະເມີດນະໂຍບາຍຂອງ Web Store ແລະອາດຈະບໍ່ປອດໄພ. ລົບອອກຈາກ Browther ເພື່ອຫລຸດເວລາທີ່ມັນເຫັນແລະແບບບໍ່ຂໍງທ່ານຢາກ</translation>
<translation id="5245976396374147971">ເຕືອນ: Browther ບໍ່ສາມາດປ້ອງກັນສ່ວນຂະຫຍາຍຈາກການບັນທຶກປະຫວັດການເບິ່ງເລົາຂອງທ່ານ. ເພື່ອປິ່ນຈບສ່ວນຂະຫຍາຍນີ້ໃນຮູບແບບສ່ວນຕົນ, ຍົກເລີກໂຕເນີ້ນີ້.</translation>
<translation id="3629539416935660172">ເພື່ອໃຫ້ Browther ປອດໄພຂຶ້ນ, ພວກເຮົາໄດ້ປິດສ່ວນຂະຫຍາຍທີ່ບໍ່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ແລະ ອາດທີ່ຈະຖືກເພີ່ມໂຕເຂົ້າໄປບໍ່ທັນມີການຮັກສາຄວາມບໍ່ສາມາດ.</translation>
<translation id="157534302749986451">ເພື່ອທຳໃຫ້ Browther ປອດໄພຂຶ້ນ, ພວກເຮົາໄດ້ປິດສ່ວນຂະຫຍາຍນີ້ທີ່ບໍ່ຢູ່ໃນ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> ແລະ ອາດທີ່ຈະຖືກເພີ່ມໂຕເຂົ້າໄປບໍ່ແມ່ນໃນ.</translation>
<translation id="3031052147361385845">ເປີດລິ້ງໃນ Browther &amp;ໜ້າສ່ວນຕົວ</translation>
<translation id="5556794247782664281">ເປີດລິ້ງໃນ Browther &amp;ໜ້າສ່ວນຕົວ</translation>
<translation id="4555500675737067970">{COUNT, plural, =0 {ມີການອັບເດດໃຫ່ມຈອງ Browther ກຳລັງຄວາມເຂົ້າໄດ້ແລ້ວ ແລະ ຈະຖືກນຳເອົານໄປໃຊ້່ເປັນເລັດໃນທັນທີ.} =1 {ມີການອັບເດດໃຫມ່ຈາກ Browther ມີໃຫ້ແລ້ວ ແລະ ຈະຖືກເອົາໃຊ້ເມື່ອທ່ານເປີດໃຫມ່. ຫ້ອງສ່ວນຕົວບໍ່ສາມາດເປີດເຂົ້າໃໝ່ໄດ້.} other {ມີການອັບເດດເລີຍ Browther ມີໃຫ້ແລ້ວ ແລະ ຈະປິເພື່ິງມື້ນີ້ນີ້ເລື່ອນ Great เวลา. # ຫ້ອງສ່ວນຕົວບໍ່ຈະສວນໃດເມື່ອທ່ານເປີດໃຫມ່.}}</translation>
<translation id="6181263681651521876">{COUNT, plural, =0 {ຜູ້ບໍລິຫານຂອງທ່ານຂໍໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ} =1 {ຜູ້ບໍລິຫານຂອງທ່ານຂໍໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວຂອງທ່ານຈະບໍ່ເປີດຄືນ.} other {ຜູ້ບໍລິຫານຂອງທ່ານຂໍໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວ # ຂອງທ່ານຈະບໍ່ເປີດຄືນ.}}</translation>
<translation id="1341091418019636353">{COUNT, plural, =0 {ຜູ້ບໍລິຫານຂອງທ່ານກໍ່າລະບຸໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ} =1 {ຜູ້ບໍລິຫານຂອງທ່ານກໍ່າລະບຸໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວຂອງທ່ານຈະບໍ່ເປີດຄືນ.} other {ຜູ້ບໍລິຫານຂອງທ່ານກໍ່າລະບຸໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວ # ຂອງທ່ານຈະບໍ່ເປີດຄືນ.}}</translation>
<translation id="8762228142105311329">{COUNT, plural, =0 {ການປົກປ້ອງຂັ້ນສູງກໍ່າລະບຸໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດນີ້ເຂົ້າໃຊ້ງານ} =1 {ການປົກປ້ອງຂັ້ນສູງກໍ່າລະບຸໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວຂອງທ່ານຈະບໍ່ເປີດຄືນ.} other {ການປົກປ້ອງຂັ້ນສູງກໍ່າລະບຸໃຫ້ທ່ານເປີດ Browther ໃໝ່ເພື່ອໃຫ້ການອັບເດດເຂົ້າໃຊ້ງານ. ໜ້າຕ່າງສ່ວນຕົວ # ຂອງທ່ານຈະບໍ່ເປີດຄືນ.}}</translation>
<translation id="5749154344207139683">ຊ່ວຍໃຫ້ສັນທະນານັກດວນໃ່ເຄືອນນອນໄລຈຳນຍາສອນປີນາທ</translation>
<translation id="6954203250660846933">ເມື່ອທ່ານພິມຢູ່ໃນບີນທີ່ທິດສຳລະທີ່ຢູ່ຕ່ຳຂອງທ່ານ, Browther ຈະສົ່ງມູນທີ່ທ່ານພີລາຍນັ້ປານທເຮັບໃຫ້ທິດສຳລະທີ່ຕັ້ງໂຂມາດເພື້ອໃຫ້ລາຍໄດ້ດີ. ໃຊ້ງານໄດ້.</translation>
<translation id="3542179014707218534">ແທການ Browther Private</translation>
<translation id="2076355018722231995">ເມື່ອເຊີມມູນໃນເ້ບສ່ວນຕົວ, Browther ຈະກາຍຫຼືວາເຕືອນກ່ຽວກັນໃກ້ເປັນໃນພຽງໃກ້</translation>
</translationbundle>