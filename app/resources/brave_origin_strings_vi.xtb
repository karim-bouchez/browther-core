<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="1026101648481255140">Tiếp tục cài đặt</translation>
<translation id="7099479769133613710">Chạy lại để cập nhật &amp;ChromeOS</translation>
<translation id="7264054672589027446">Browther khuyên bạn nên xem xét tiện ích này</translation>
<translation id="7848219163187166649">Khi một trang web yêu cầu tải trước các đường liên kết trên trang ở chế độ riêng tư, Browther sẽ sử dụng các máy chủ của Browther. Điều này giúp ẩn danh tính của bạn khỏi trang web được tải trước, nhưng Browther sẽ biết những trang web được tải trước.</translation>
<translation id="1065672644894730302">Không thể đọc tùy chọn của bạn. Một số tính năng có thể không khả dụng và các thay đổi đối với tùy chọn sẽ không được lưu.</translation>
<translation id="8837164267124113709">Cha mẹ bạn đã tắt tuỳ chọn "Quyền của các trang web, ứng dụng và tiện ích" đối với Browther</translation>
<translation id="881513728707488138">Browther muốn xuất các mật khẩu của bạn. Hãy nhập mật khẩu Windows để cho phép thực hiện việc này.</translation>
<translation id="112640046208448578">Xác định đồ vật hoặc địa điểm, sao chép hoặc dịch văn bản. Khi bạn sử dụng tính năng Tìm kiếm hình ảnh, ảnh chụp màn hình trang sẽ được gửi đến máy chủ. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther là trình duyệt mặc định của bạn</translation>
<translation id="6580138787163923852">Để kiểm tra xem mật khẩu của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK"/>đăng nhập vào Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Nhấp vào trình đơn Browther</translation>
<translation id="1157985233335035034">Ngôn ngữ gần đây</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> đã thêm một tiện ích có thể thay đổi cách Browther hoạt động.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Không cài đặt được vì phiên bản Windows bạn đang sử dụng chưa được hỗ trợ.</translation>
<translation id="8291401179516272335">Giới thiệu về Browther</translation>
<translation id="1203500561924088507">Cảm ơn bạn đã cài đặt. Bạn phải khởi động lại trình duyệt trước khi sử dụng <ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">Khi bạn mở tính năng Tìm kiếm hình ảnh, thì tiêu đề, URL và nội dung của trang, bao gồm cả tệp PDF, sẽ được tự động gửi đến máy chủ. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Browther của mình trong Browther. Để thay đổi chế độ cài đặt này, hãy chuyển đến phần "Tài khoản của bạn trong Browther".</translation>
<translation id="9034321258761608912">Mặc dù thẻ này không hoạt động nhưng bộ nhớ đã được giải phóng để giúp Browther luôn hoạt động nhanh. Bạn có thể chọn luôn loại trừ trang web này khỏi trạng thái không hoạt động.</translation>
<translation id="249571811018731941">Browther đã chặn tệp tải xuống này vì đây là tệp nguy hiểm</translation>
<translation id="8850227089720975601">Khi đăng nhập vào các dịch vụ của Browther như Gmail hoặc YouTube bằng <ph name="USER_EMAIL"/>, bạn có thể tự động được đăng nhập vào Browther bằng cùng một tài khoản</translation>
<translation id="1290883685122687410">Lỗi thiết lập: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Thiết lập hồ sơ Browther mới</translation>
<translation id="4437862975743821367">Browther cần có quyền truy cập Bluetooth để tìm 
 các thiết bị Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">Phát hiện ngôn ngữ</translation>
<translation id="1206925267243987362">Sử dụng các chế độ cài đặt của trình duyệt được Browther đề xuất</translation>
<translation id="8270483548049772782">Cũng xoá dữ liệu khỏi Browther (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Đã ghim! Bạn có thể nhấn vào nút mới trên thanh công cụ để truy cập lại vào tính năng Tìm kiếm hình ảnh</translation>
<translation id="1356661055722410047">Mới! Bạn có thể dịch cả văn bản và hình ảnh trên màn hình</translation>
<translation id="1383876407941801731">Tìm kiếm</translation>
<translation id="1592588950737518481">&amp;Quản lý hồ sơ trên Browther</translation>
<translation id="1404026649028693342">Luôn hiện Chế độ AI</translation>
<translation id="141901961143729572">Chia sẻ suy nghĩ của bạn</translation>
<translation id="1743952081001089298">Để chia sẻ cửa sổ, hãy cho phép Browther ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="8627385813382688019">Nhận trợ giúp về Browther for Testing</translation>
<translation id="1497802159252041924">Lỗi cài đặt: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Trang này được bảo vệ</translation>
<translation id="7252430412915798987">Chia sẻ một thẻ Browther</translation>
<translation id="6388429281015199562">Đăng nhập vào Browther</translation>
<translation id="1547469039832541117">Kết thúc tác vụ được làm nổi bật.</translation>
<translation id="1801944307203212016">Browther cần có quyền sử dụng camera để tạo bản đồ 3D khu vực xung quanh bạn</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{Tiện ích này không còn được hỗ trợ nữa. Browther khuyên bạn nên xoá tiện ích này.}other{Các tiện ích này không còn được hỗ trợ nữa. Browther khuyên bạn nên xoá các tiện ích này.}}</translation>
<translation id="4667068923142532753">Ghim Browther</translation>
<translation id="3006560544901646947">Công cụ đảm bảo an toàn của Browther</translation>
<translation id="686052171138185761">Browther muốn xoá dữ liệu của bạn trong Trình quản lý mật khẩu. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="8713026329083542796">Xem các chế độ kiểm soát quan trọng đối với quyền riêng tư và tính bảo mật trong Browther</translation>
<translation id="1640672724030957280">Đang tải xuống...</translation>
<translation id="1680687534629375545">Hỏi tính năng Tìm kiếm hình ảnh về trang này</translation>
<translation id="1709772298389099340">Cung cấp đặc quyền cấp cao cho <ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">Browther sẽ gửi cho Browther thông tin về hoạt động tương tác của bạn với những tính năng này để giúp cải thiện tính năng. Nhân viên đánh giá có thể đọc, xử lý và chú thích dữ liệu này.</translation>
<translation id="1722488837206509557">Thao tác này sẽ cho phép bạn chọn trong số các thiết bị có sẵn và hiển thị nội dung trên các thiết bị đó.</translation>
<translation id="6820510278633522408">Browther sắp xoá dữ liệu duyệt web</translation>
<translation id="7775028004939172516">Browther sẽ cố gắng nâng các hình thức chuyển hướng lên giao thức HTTPS</translation>
<translation id="6963959729951758069">Đã xóa dữ liệu Browther</translation>
<translation id="4085139922884095932">Browther sẽ khởi động lại sau <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">Khi không có giao thức HTTPS, Browther sẽ sử dụng kết nối không an toàn mà không cảnh báo bạn</translation>
<translation id="3975328336074677101">Cho phép Browther chạy dưới nền</translation>
<translation id="2497443204974841650">Cài đặt lại Browther</translation>
<translation id="1724309687045787742">Browther đang cố gắng <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">Lần tới, khi mở Browther trên <ph name="DEVICE_TYPE"/>, bạn sẽ thấy lời nhắc sử dụng Trình quản lý mật khẩu của Browther.</translation>
<translation id="1838374766361614909">Xóa tìm kiếm</translation>
<translation id="2337233040802538155">Để xoá dữ liệu duyệt web chỉ trên thiết bị này mà không xoá trong Tài khoản Browther, hãy <ph name="BEGIN_LINK"/>đăng xuất khỏi Browther<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">Tải Browther xuống điện thoại để mở hoặc tạo nhóm thẻ mới trong khi di chuyển.</translation>
<translation id="2063443520349987970">Bạn có thể quản lý các Tài khoản Browther đã đăng nhập của mình. Tài khoản Browther của bạn được sử dụng cho trình duyệt Browther, Cửa hàng Play, Gmail, v.v. Nếu bạn muốn thêm tài khoản cho người khác, chẳng hạn như thành viên gia đình, hãy thêm người dùng mới trên chiếc <ph name="DEVICE_TYPE"/> của bạn. <ph name="LINK_BEGIN"/>Tìm hiểu thêm<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Tìm kiếm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="1880677175115548835">Chọn văn bản</translation>
<translation id="3183933389992069620">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình Browther của bạn. Dữ liệu Browther của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME"/>. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Browther nhưng không thể liên kết dữ liệu này với tài khoản khác. Bạn có thể tùy chọn tạo cấu hình mới để giữ cho dữ liệu Browther hiện có của bạn riêng biệt. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther sẽ tiết kiệm pin bằng cách hạn chế hoạt động trong nền và hiệu ứng hình ảnh, chẳng hạn như hiệu ứng cuộn mượt mà và tốc độ khung hình của video. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về Trình tiết kiệm pin<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Hỏi về trang này</translation>
<translation id="9128006428501241840">Dịch vụ Trình cập nhật Browther</translation>
<translation id="6302815314157879372">Bằng việc tắt tính năng này, bạn có thể đăng nhập vào các trang web của Browther, chẳng hạn như Gmail mà không cần đăng nhập vào Browther</translation>
<translation id="1063611196035804685">Browther không phản hồi. Chạy lại ngay bây giờ?</translation>
<translation id="2873360330889594383">Tổ chức <ph name="MANAGER"/> của bạn yêu cầu bạn đăng nhập vào Browther</translation>
<translation id="4035053306113201399">ChromeOS cần được khởi động lại để áp dụng bản cập nhật.</translation>
<translation id="2861285003831382718">Browther đã chặn tệp tải xuống này vì loại tệp này ít được tải xuống và có thể nguy hiểm</translation>
<translation id="1953553007165777902">Đang tải xuống... Còn <ph name="MINUTE"/> phút</translation>
<translation id="2080160985220483492">Mẹo khi dùng Browther: Lưu mật khẩu</translation>
<translation id="8037497710694492565">Browther không thể xác định hoặc đặt trình duyệt mặc định</translation>
<translation id="7395009124247513849">Tìm hiểu lý do Browther chặn một số tệp, mở trong thẻ mới</translation>
<translation id="762710512520170632">Dịch vụ này giúp cập nhật phần mềm Browther của bạn. Nếu dịch vụ này bị vô hiệu hoá hoặc bị dừng, phần mềm Browther của bạn sẽ không được cập nhật. Điều này có nghĩa là lỗ hổng bảo mật phát sinh sẽ không thể khắc phục được và các tính năng có thể không hoạt động. Dịch vụ này sẽ tự gỡ cài đặt khi không được phần mềm Browther nào dùng.</translation>
<translation id="5793588180426267429">Thao tác này sẽ xóa 1 mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Browther dưới dạng <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Không cài đặt được. Vui lòng thử lại.</translation>
<translation id="6351516710581760512">Để kiểm tra xem các mật khẩu khác của bạn có bị ảnh hưởng bởi các vụ rò rỉ dữ liệu và sự cố bảo mật khác hay không, hãy <ph name="BEGIN_LINK"/>đăng nhập vào Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Cài đặt.</translation>
<translation id="8194525816714210105">Chọn xem có bao gồm nhật ký duyệt web trên Browther hay không để mang lại trải nghiệm phù hợp hơn trong các dịch vụ của Browther</translation>
<translation id="5909559127548969159">Nhấp vào nút Tuỳ chỉnh Browther trên trang Thẻ mới để mang lại giao diện mới cho Browther</translation>
<translation id="2066690553719545730">Luôn hiện Chế độ AI</translation>
<translation id="3283892260110318935">Browther đã chặn tệp tải xuống này vì tệp này chứa nội dung lừa đảo và có thể thực hiện các thay đổi không mong muốn đối với thiết bị của bạn</translation>
<translation id="6160571936643742128">Lần tới, khi mở Browther iOS, bạn sẽ thấy lời nhắc dùng thử <ph name="FEATURE_NAME"/>.</translation>
<translation id="8380517409933452343">Mật khẩu và các dữ liệu khác trên Browther mà bạn đã lưu trong Tài khoản Browther của mình sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong Browther, hãy đăng nhập lại.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau 1 phút bạn không dùng đến Browther. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}other{Tổ chức của bạn sẽ tự động xoá dữ liệu duyệt web sau # phút bạn không dùng đến Browther. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống. Các thẻ sẽ vẫn mở.}}</translation>
<translation id="2126108037660393668">Không xác minh được tệp tải xuống.</translation>
<translation id="2135919691573380097">Báo cáo trang web này</translation>
<translation id="2137162749895930932">Đóng màn hình dịch</translation>
<translation id="4283559398694996391">Browther đã chặn tệp tải xuống này vì trang web không sử dụng kết nối an toàn và tệp có thể đã bị can thiệp</translation>
<translation id="2170098639895543546">Chọn nội dung bất kỳ trên trang</translation>
<translation id="2495182092286337191">Tùy chỉnh Browther</translation>
<translation id="2174917724755363426">Chưa cài đặt xong. Bạn có chắc chắn muốn huỷ không?</translation>
<translation id="4877141231724140862">Browther – Đăng nhập vào mạng – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Lỗi khi kiểm tra bản cập nhật: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Xoá tài khoản khỏi Browther</translation>
<translation id="1084363153644366288">An toàn hơn khi di chuyển nhờ tính năng Duyệt web an toàn có tăng cường bảo vệ trên Browther cho iOS</translation>
<translation id="7949164640723239455">Đây là trang web nguy hiểm. Browther đã xoá quyền thông báo.</translation>
<translation id="2236949375853147973">Hoạt động của tôi</translation>
<translation id="4536403809133456417">Để sử dụng địa chỉ và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Browther. Địa chỉ này sẽ được lưu trong Tài khoản Browther của bạn sau khi bạn đăng nhập.</translation>
<translation id="5627930103267312171">Nếu bạn chia sẻ máy tính, bạn bè và gia đình có thể duyệt web một cách riêng biệt và thiết lập Browther theo ý của họ.</translation>
<translation id="2283803047247799269">Tìm kiếm thẻ này bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{Browther đề xuất tạm dừng thẻ làm chậm trình duyệt của bạn}other{Browther đề xuất tạm dừng các thẻ làm chậm trình duyệt của bạn}}</translation>
<translation id="2307973900865360088">Ghim vào thanh Dock</translation>
<translation id="5161617112768367959">Kiểm tra đối chiếu các URL với danh sách trang web không an toàn được lưu trữ trong Browther. Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Browther cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang.</translation>
<translation id="4123094831918713833">Hành động này sẽ:
          <ph name="LINE_BREAKS"/>
           • Đặt lại một số chế độ cài đặt Browther và lối tắt Browther
           <ph name="LINE_BREAK"/>
           • Tắt các tiện ích
           <ph name="LINE_BREAK"/>
           • Xoá cookie và dữ liệu trang web tạm thời khác
            <ph name="LINE_BREAKS"/>
           Dấu trang, nhật ký và mật khẩu đã lưu sẽ không bị ảnh hưởng.</translation>
<translation id="5456070119344236353">Để gửi số điện thoại từ thiết bị này đến điện thoại Android của bạn, hãy đăng nhập vào Browther trên cả hai thiết bị.</translation>
<translation id="2356070529366658676">Yêu cầu</translation>
<translation id="2359808026110333948">Tiếp tục</translation>
<translation id="6468415397021485143">Tiện ích "<ph name="EXTENSION_NAME"/>" muốn bạn đăng nhập vào Browther</translation>
<translation id="2558600429878197587">Tắt Browther đối với các ứng dụng chạy trong nền</translation>
<translation id="5295781918312989856">Để sử dụng tiện ích này bằng tài khoản <ph name="USER_EMAIL_ADDRESS"/>, hãy đăng nhập vào Browther.</translation>
<translation id="8418845734693287262">ChromeOS không thể đồng bộ hoá dữ liệu của bạn vì thông tin đăng nhập vào tài khoản của bạn đã lỗi thời.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích Browther đã truy cập vào 1 thiết bị HID}=1{Một hoặc nhiều tiện ích Browther đang truy cập vào 1 thiết bị HID}other{Một hoặc nhiều tiện ích Browther đang truy cập vào # thiết bị HID}}</translation>
<translation id="434258293817844111">Browther cần có quyền truy cập máy ảnh và micrô đối với trang web này</translation>
<translation id="2403703063067034158">Lỗi khi khởi động: một phiên bản thiết lập khác đang chạy, vui lòng thử lại sau.</translation>
<translation id="5458993228789433099">Mở đường liên kết trong Browther từ ứng dụng bất kỳ và giữ cho trình duyệt luôn xuất hiện trên thanh tác vụ</translation>
<translation id="1677640217693742525">Với <ph name="BEGIN_LINK"/>các công cụ của Browther<ph name="END_LINK"/>, bạn có thể duyệt web an toàn và luôn nắm quyền kiểm soát</translation>
<translation id="2451727308784734061">Sử dụng lối tắt để nhanh chóng truy cập vào Trình quản lý mật khẩu. Bạn có thể di chuyển lối tắt đến màn hình chính hoặc trình chạy ứng dụng của máy tính.</translation>
<translation id="2280315911954332435">Browther sắp đóng</translation>
<translation id="6410820860979094113">Trong Browther</translation>
<translation id="2485422356828889247">Gỡ cài đặt</translation>
<translation id="2513154137948333830">Yêu cầu khởi động lại: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Chọn văn bản bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="7892218991241200190">Browther đang cố gắng thay thế các mật khẩu hiện tại. Nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="8976443723926188033">Browther cần quyền truy cập vào bộ nhớ để tải tệp xuống</translation>
<translation id="4131374838781785973">Trình trợ giúp của Browther Origin</translation>
<translation id="2575822587468774919">Chọn nội dung bạn muốn tìm bằng tính năng Tìm kiếm hình ảnh</translation>
<translation id="8705561858232289221">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Browther</translation>
<translation id="437162022240011372">Tiếp tục sử dụng Browther</translation>
<translation id="259935314519650377">Không thể lưu trình cài đặt đã tải xuống vào bộ nhớ đệm. Lỗi: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Hệ thống</translation>
<translation id="2907676829052962091">Tổ chức của bạn có thể xem và quản lý dữ liệu duyệt web (chẳng hạn như dấu trang, nhật ký và mật khẩu). Tổ chức không thể xem dữ liệu duyệt web trong các hồ sơ Browther khác</translation>
<translation id="1289116577679005654">Xác minh danh tính của bạn để sử dụng và lưu dữ liệu Browther trong tài khoản <ph name="ACCOUNT_EMAIL"/> của bạn</translation>
<translation id="7192278346779151664">Đã xảy ra lỗi hệ điều hành khi cài đặt. Hãy tải xuống Browther lại lần nữa.</translation>
<translation id="7724398260867885339">Nếu các bạn dùng chung một thiết bị, thì bạn bè và gia đình có thể duyệt web một cách riêng biệt cũng như thiết lập Browther theo ý muốn</translation>
<translation id="1679595317134614424">Thẻ Browther</translation>
<translation id="7189168846924379421">Để bảo mật hơn, Browther sẽ mã hóa dữ liệu của bạn.</translation>
<translation id="4052643592793184278">Để xoá Tài khoản Browther của bạn khỏi Browther, hãy đăng xuất</translation>
<translation id="7694616023994438906">Để sử dụng mật khẩu, dấu trang và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Browther</translation>
<translation id="2738871930057338499">Không thể kết nối với Internet. HTTP 403 bị cấm. Vui lòng kiểm tra cấu hình proxy.</translation>
<translation id="2753623023919742414">Nhấp để tìm</translation>
<translation id="9078193405195503710">Đặt Browther làm trình xem PDF mặc định</translation>
<translation id="2456995288904753506">Browther có thể tự động điền những trường khó mà tính năng tự động điền tiêu chuẩn có thể bỏ sót</translation>
<translation id="3271730304285122987">Tiện ích này chứa phần mềm độc hại và không an toàn. Hãy xoá khỏi Browther để tiện ích này không thể xem và thay đổi dữ liệu của bạn (bao gồm cả thông tin cá nhân) trên các trang web bạn truy cập nữa.</translation>
<translation id="2799223571221894425">Chạy lại</translation>
<translation id="1427337251963884503">Browther của bạn</translation>
<translation id="2816462166102338036">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm video này</translation>
<translation id="2841525013647267359">Dịch từ</translation>
<translation id="2846251086934905009">Lỗi cài đặt: Chưa hoàn tất trình cài đặt. Hoạt động cài đặt đã bị huỷ.</translation>
<translation id="928966105228355994">Xóa khỏi Browther...</translation>
<translation id="587805782197019018">Giúp bạn an toàn trên Browther và có thể dùng để cải thiện mức độ bảo mật cho bạn trong các ứng dụng khác của Browther sau khi đăng nhập</translation>
<translation id="2885378588091291677">Trình quản lý tác vụ</translation>
<translation id="3055995278166070443">Giới thiệu về &amp;Browther</translation>
<translation id="2915996080311180594">Khởi động lại sau</translation>
<translation id="2928420929544864228">Đã cài đặt xong.</translation>
<translation id="70453521937551896">Dữ liệu của bạn được mã hoá bằng cụm mật khẩu. Nhập cụm mật khẩu để sử dụng và lưu dữ liệu trên Browther vào Tài khoản Browther của bạn.</translation>
<translation id="2945997411976714835">Lỗi cài đặt: Trình cài đặt không thể bắt đầu quá trình.</translation>
<translation id="3188308520233701133">Đăng nhập vào các trang web nhanh hơn bằng mật khẩu đã lưu cho Browther trên iOS</translation>
<translation id="8145318807880784886">Thêm một hồ sơ Browther mới để tách biệt dấu trang, mật khẩu và chế độ cài đặt.</translation>
<translation id="4330268530227888227">Tổ chức bạn quản lý Browther</translation>
<translation id="6488090896442998436">Browther đã được cập nhật</translation>
<translation id="300557164611864786">Nếu một trang web cố ăn cắp mật khẩu của bạn hoặc nếu bạn tải một tệp gây hại xuống, thì Browther cũng có thể gửi các URL đến tính năng Duyệt web an toàn, bao gồm cả các đoạn nội dung trên trang</translation>
<translation id="2447145782593796785">Đăng nhập vào Browther để an toàn hơn trên mạng nhờ các lựa chọn của cha mẹ bạn</translation>
<translation id="3003694935412297923">Tất cả tác vụ</translation>
<translation id="7554113777150891030">{count,plural, =1{Browther cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Browther và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này (1 mục) sẽ bị xoá.}other{Browther cần xác minh danh tính của bạn thì mới có thể lưu một số dữ liệu vào Tài khoản Browther và cho phép bạn sử dụng dữ liệu đó trên tất cả các thiết bị. Nếu bạn đăng xuất ngay, dữ liệu này ({count}) sẽ bị xoá.}}</translation>
<translation id="5522228731050510047">Mở <ph name="URL"/> trong một thẻ mới trên Browther.</translation>
<translation id="6358780591055960280">Browther không thể kiểm tra mật khẩu của bạn. Hãy thử lại sau.</translation>
<translation id="1386422761453740126">Đang thêm vào Browther...</translation>
<translation id="3038232873781883849">Đang chờ cài đặt...</translation>
<translation id="3045032126857188731">Ngôn ngữ dịch: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">Đóng hộp thoại phản hồi</translation>
<translation id="369127628511662602">Các hồ sơ khác trên Browther</translation>
<translation id="2370255879896574713">Giúp cải thiện Browther bằng cách gửi báo cáo sự cố và <ph name="UMA_LINK"/> tới Browther</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{Một hoặc nhiều tiện ích Browther đã truy cập vào 1 thiết bị USB}=1{Một hoặc nhiều tiện ích Browther đang truy cập vào 1 thiết bị USB}other{Một hoặc nhiều tiện ích Browther đang truy cập vào # thiết bị USB}}</translation>
<translation id="2065456480740480340">Nhật ký duyệt web trên Browther</translation>
<translation id="5011660649081947055">Trình cài đặt không thể giải nén tệp lưu trữ. Hãy tải xuống Browther lại lần nữa.</translation>
<translation id="310459126943037700">Chưa thể kết thúc nhiệm vụ.</translation>
<translation id="3104828284009500087">Tìm nội dung bất kỳ trên trang</translation>
<translation id="4917564010081457061">Đồng bộ hoá hoàn toàn mật khẩu, dấu trang và nhật ký trên các thiết bị. Dễ dàng sử dụng các tính năng bạn quen thuộc và yêu thích bằng cách cập nhật trình duyệt mặc định thành Browther.</translation>
<translation id="1041472930719344928">Browther đang sử dụng micrô của bạn.</translation>
<translation id="3130333203120345554">Lượt tìm kiếm mới</translation>
<translation id="3137969841538672700">Kéo để tìm</translation>
<translation id="5312717254055363883">Thẻ này đang sử dụng thêm tài nguyên. Để cải thiện hiệu suất, hãy cho phép Browther dừng hoạt động của thẻ này.</translation>
<translation id="373523409348786203">Để chia sẻ màn hình, hãy cho phép Browther ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="802113445299754598">Chạy lại Browther</translation>
<translation id="3161522574479303604">Tất cả ngôn ngữ</translation>
<translation id="4522189060330781648">Một chương trình khác trên máy tính của bạn đã thêm một chủ đề có thể thay đổi cách Browther hoạt động.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">Tùy chỉnh hồ sơ mới của bạn trên Browther</translation>
<translation id="5150830326120505481">Để xoá Tài khoản Browther của bạn khỏi Browther, hãy vào trang Cài đặt rồi đăng xuất khỏi Browther</translation>
<translation id="7113660200899017820">Sau đó, Browther có thể hỏi xem bạn có muốn sử dụng thông tin đã lưu để tự động điền vào biểu mẫu hay không</translation>
<translation id="4475011322243623412">Browther không thể đọc và ghi vào thư mục dữ liệu:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">Khởi động lại Ngay bây giờ</translation>
<translation id="3536063527222598206">Khóa API của Browther bị thiếu. Một số chức năng của Browther sẽ bị tắt.</translation>
<translation id="1011450868746766298">Tiếp tục chạy các ứng dụng dưới nền khi Browther bị đóng</translation>
<translation id="179611081153855734">Browther sẽ cảnh báo bạn trước khi tải trang web bằng kết nối không an toàn</translation>
<translation id="8965591964936552871">Khi đóng tất cả các cửa sổ Browther, bạn sẽ bị đăng xuất khỏi hầu hết các trang web, ngoại trừ Tài khoản Browther nếu bạn đã đăng nhập vào Browther. Để cho phép trang web ghi nhớ bạn, hãy <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Công cụ tìm kiếm mặc định của bạn đã bị thay đổi từ bên ngoài Browther. Để bảo vệ bạn, Browther đã đặt lại công cụ này.</translation>
<translation id="1170501833661894915">Đăng nhập vào Browther để có thể sử dụng mật khẩu, dấu trang và nhiều dữ liệu khác trên tất cả các thiết bị của bạn</translation>
<translation id="3352986031709923790">góc trên cùng bên phải của khu vực tìm kiếm: <ph name="RIGHT"/>% từ bên phải sang, <ph name="TOP"/>% từ trên cùng xuống</translation>
<translation id="120745000989996104">Dữ liệu Browther trong tài khoản của bạn</translation>
<translation id="3369405342922656244">Sử dụng tính năng Tìm kiếm hình ảnh để tìm kiếm trên trang này</translation>
<translation id="7173761126541905083">Sử dụng mật khẩu của bạn với Browther trên điện thoại</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">Chuyển sang hồ sơ hiện có trên Browther?</translation>
<translation id="3412460710772753638">Trong Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="4282363917570905631">Mở rộng phạm vi của tính năng Duyệt web an toàn có tăng cường bảo vệ với Browther trên điện thoại</translation>
<translation id="986094398735583155">Đang tuỳ chỉnh Browther cho phù hợp với bạn...</translation>
<translation id="3266047225484320321">Browther sẽ thông báo cho bạn khi bạn đăng nhập bằng mật khẩu bị lộ</translation>
<translation id="3508047337876211050">Thao tác này sẽ xóa <ph name="ITEMS_COUNT"/> mục khỏi thiết bị này. Để truy xuất dữ liệu của bạn sau, hãy đăng nhập vào Browther dưới dạng <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">Phím tắt <ph name="SHORTCUT"/> có thể giúp chuyển đổi giữa các hồ sơ trên Browther</translation>
<translation id="7225005776233199285">Hãy đóng tất cả cửa sổ Browther và thử lại.</translation>
<translation id="5465054931427475969">Để chia sẻ cửa sổ, hãy cho phép Browther ghi màn hình trong phần Cài đặt hệ thống</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/> đã đăng nhập.  Để tách biệt hoạt động duyệt web của bạn, hãy đăng nhập vào Browther bằng hồ sơ của riêng bạn qua địa chỉ <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">Để chia sẻ màn hình, hãy cho phép Browther ghi màn hình trong phần Cài đặt hệ thống.</translation>
<translation id="3597003331831379823">Không thể chạy quy trình thiết lập bằng đặc quyền cấp cao. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Đăng nhập vào Browther</translation>
<translation id="2492221622209669678">Dữ liệu duyệt web của người này sẽ bị xóa khỏi thiết bị này. Để khôi phục dữ liệu, hãy đăng nhập vào Browther bằng <ph name="USER_EMAIL"/>.</translation>
<translation id="6793778233257855801">Để gửi số điện thoại từ <ph name="ORIGIN"/> đến điện thoại Android của bạn, hãy đăng nhập vào Browther trên cả hai thiết bị.</translation>
<translation id="3667616615096815454">Không thể cài đặt, máy chủ không xác định được ứng dụng.</translation>
<translation id="5585500151754164442">Sử dụng <ph name="BEGIN_LINK"/>cụm mật khẩu của riêng bạn<ph name="END_LINK"/> để mã hoá tất cả dữ liệu Browther trong Tài khoản Browther Các địa chỉ và phương thức thanh toán từ Google Pay sẽ không được mã hoá. Nhật ký duyệt web trên Browther sẽ không đồng bộ hoá.</translation>
<translation id="404323216042159951">Browther không thể kiểm tra mật khẩu của bạn. Hãy thử kiểm tra kết nối Internet.</translation>
<translation id="5004936474632127765">Mở đường liên kết trong thẻ mới của Browther</translation>
<translation id="6236643159256182256">Liên kết Browther và các dịch vụ khác của Browther cho mục đích cá nhân hoá và các mục đích khác</translation>
<translation id="3729187154190517324">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ bằng nút "Thêm một thẻ và các nội dung khác".</translation>
<translation id="1400697664933775238">Quản lý hồ sơ trên Browther</translation>
<translation id="2461315395128103158">Tìm hiểu lý do Browther chặn một số nội dung tải xuống</translation>
<translation id="8058420662026104226">Browther sẽ thông báo cho bạn nếu có vấn đề cần bạn xem xét</translation>
<translation id="3177448557921912221">Các hồ sơ trên Browther giúp bạn tách biệt các khía cạnh khác nhau trong cuộc sống. Thêm hồ sơ mới ngay.</translation>
<translation id="1541177876035612043">Browther tải trước các trang mà bạn có thể sẽ truy cập để các trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="3810973564298564668">Quản lý</translation>
<translation id="1117103475254549453">Để sử dụng mật khẩu bạn đã lưu, hãy quét mã QR, tải Browther dành cho iOS xuống rồi đăng nhập vào Tài khoản Browther của bạn</translation>
<translation id="8880695882192156860">Mẹo khi dùng Browther: Duyệt web an toàn có tăng cường bảo vệ</translation>
<translation id="3846683726093018685">**Tóm tắt:** Hãy mô tả chủ đề và mục đích chính của nội dung trong ảnh chụp màn hình này bằng một câu dưới 30 từ.

          **Đề xuất câu hỏi:** Tạo một danh sách có dấu đầu dòng gồm 3 đến 5 câu hỏi gợi mở mà người dùng có thể đặt ra để hiểu rõ hơn về ảnh chụp màn hình này. Danh sách này phải có ít nhất một câu hỏi cụ thể về một đối tượng trực quan trong ảnh và thiết kế hoặc vị trí của đối tượng đó.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> - Browther Origin</translation>
<translation id="3885770153807205175">Bộ chọn ngôn ngữ</translation>
<translation id="4861846616763552424">Tùy chỉnh và kiểm soát Browther. Bạn cần lưu ý - nhấp để xem thông tin chi tiết.</translation>
<translation id="6126366281251241386">Nhấp vào tên của bạn để mở Browther và bắt đầu duyệt web.</translation>
<translation id="3892148308691398805">Sao chép văn bản</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> đã đăng nhập vào hồ sơ này trên Browther. Để tách biệt hoạt động duyệt web của bạn, Browther có thể tạo hồ sơ riêng cho bạn.</translation>
<translation id="3821553157234855663">Tuỳ chỉnh Browther</translation>
<translation id="3941890832296813527">Lỗi cài đặt: Tên tệp của trình cài đặt không hợp lệ hoặc không được hỗ trợ.</translation>
<translation id="6482299900191767005">Browther đang cố gắng sao chép mật khẩu. Hãy nhập mật khẩu Windows của bạn để cho phép việc này.</translation>
<translation id="5853011008278898603">Mật khẩu, phương thức thanh toán và địa chỉ mà bạn đã lưu trong Tài khoản Browther sẽ bị xoá khỏi thiết bị này. Để tiếp tục sử dụng các dữ liệu đó trong Browther, hãy đăng nhập lại.</translation>
<translation id="395904275706073188">Không thể đọc các trang được bảo vệ. Hãy thử đọc một trang khác.</translation>
<translation id="1832973663231751701">Tìm hiểu cách Browther bảo vệ bạn</translation>
<translation id="4531502594774670767">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Browther sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm, AI và công cụ hỗ trợ của tổ chức bạn để đưa ra đề xuất.</translation>
<translation id="300013383485253006">Giới thiệu về &amp;Browther for Testing</translation>
<translation id="1152920704813762236">Giới thiệu về ChromeOS</translation>
<translation id="8126752030994997015">Khi bạn truy cập vào một trang web, Browther sẽ gửi một phần URL đã làm rối mã nguồn cho tính năng <ph name="BEGIN_LINK"/>Duyệt web An toàn của Browther<ph name="END_LINK"/> thông qua một máy chủ đảm bảo quyền riêng tư giúp ẩn địa chỉ IP của bạn. Nếu một trang web có hành vi đáng ngờ, Browther cũng sẽ gửi URL đầy đủ và các đoạn nội dung trên trang cho Browther.</translation>
<translation id="3703994572283698466">ChromeOS có thể hoạt động được là nhờ <ph name="BEGIN_LINK_CROS_OSS"/>phần mềm nguồn mở<ph name="END_LINK_CROS_OSS"/> bổ sung, tương tự như <ph name="BEGIN_LINK_LINUX_OSS"/>môi trường phát triển Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">Dịch màn hình</translation>
<translation id="4023601594785368013">Ngôn ngữ gốc: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">Mở đường liên kết trong Browther từ ứng dụng bất kỳ. Ngoài ra, Browther sẽ được ghim vào thanh tác vụ để bạn dễ dàng truy cập.</translation>
<translation id="3437506136408403836">Giúp cải thiện Browther bằng cách báo cáo <ph name="BEGIN_LINK"/>cài đặt hiện tại<ph name="END_LINK"/></translation>
<translation id="4050175100176540509">Cải thiện bảo mật quan trọng và tính năng mới có trong phiên bản mới nhất.</translation>
<translation id="4055805654398742145">Trình quản lý mật khẩu</translation>
<translation id="2164947358785939495">Một chương trình khác trên máy tính của bạn đã thêm một tiện ích có thể thay đổi cách Browther hoạt động.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Tổ chức sẽ tự động đóng Browther sau 1 phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}other{Tổ chức sẽ tự động đóng Browther sau # phút bạn không dùng đến. Dữ liệu duyệt web sẽ bị xoá. Dữ liệu này có thể bao gồm nhật ký, nội dung tự động điền và tệp đã tải xuống.}}</translation>
<translation id="1535413545339990419">Chuyển đến trang Giới thiệu về Browther</translation>
<translation id="692283249649018289">Tuỳ chỉnh Browther để mang lại giao diện mới cho trình duyệt</translation>
<translation id="6375229634133804834">Tuỳ chỉnh Browther</translation>
<translation id="4148957013307229264">Đang cài đặt...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> – Đăng nhập vào mạng – Browther</translation>
<translation id="2911246138082876798">Khám phá các ứng dụng, trò chơi, tiện ích và chủ đề tuyệt vời cho Browther.</translation>
<translation id="2528977475313334293">Để sử dụng tiện ích này và các tiện ích khác trên tất cả máy tính của bạn, hãy đăng nhập vào Browther</translation>
<translation id="8244267655940711467">Để giúp bạn an toàn hơn trên mạng với các lựa chọn của cha mẹ, hãy chuyển sang hồ sơ Browther mà bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">Đang hủy...</translation>
<translation id="4224210481850767180">Quá trình cài đặt đã bị huỷ.</translation>
<translation id="8219359042845534271">Bạn muốn liên kết dữ liệu Browther của bạn với tài khoản này?</translation>
<translation id="5520777668172961882">Cảnh báo cho bạn về các trang web nguy hiểm, kể cả trang web mà Browther chưa từng biết, bằng cách phân tích nhiều dữ liệu trên các trang web hơn so với chế độ bảo vệ tiêu chuẩn. Bạn có thể chọn bỏ qua cảnh báo của Browther.</translation>
<translation id="2014920019837536689">Đăng xuất khỏi Browther</translation>
<translation id="4341512411059715879">Nhận trợ giúp về Browther</translation>
<translation id="4281844954008187215">Điều khoản dịch vụ</translation>
<translation id="322492684764924424">Không thể cài đặt do lỗi chưa xác định. Nếu Browther hiện đang chạy, hãy đóng Browther và thử lại.</translation>
<translation id="3813060261346666066">Xuất mật khẩu từ Browther</translation>
<translation id="4304713468139749426">Trình quản lý mật khẩu</translation>
<translation id="4334241893986177674">Tìm kiếm thông tin trên ảnh chụp màn hình này</translation>
<translation id="4334294535648607276">Quá trình tải xuống hoàn tất.</translation>
<translation id="2177954934431828302">Khởi chạy Browther khi Windows khởi động</translation>
<translation id="2472318668926455009">Dễ dàng sử dụng các tính năng mà bạn biết, yêu thích và tin tưởng bằng cách đặt Browther làm trình duyệt mặc định. Browther sẽ được ghim vào thanh tác vụ để bạn truy cập nhanh.</translation>
<translation id="1068681683510904753"><ph name="MANAGER"/> yêu cầu bạn phải đọc và chấp nhận Điều khoản dịch vụ sau đây trước khi sử dụng thiết bị này. Những điều khoản này không mở rộng, sửa đổi hay giới hạn Điều khoản của ChromeOS.</translation>
<translation id="2897580280700805340">Bạn vẫn muốn thoát khỏi Browther?</translation>
<translation id="4413205837991854510">Luôn hiện lối tắt Tìm kiếm hình ảnh</translation>
<translation id="2454897022983434851">Cho phép Browther chạy trong nền</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{Browther khuyên bạn nên loại bỏ tiện ích này. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK"/>}other{Browther khuyên bạn nên loại bỏ các tiện ích này. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về các tiện ích được hỗ trợ<ph name="END_LINK"/>.}}</translation>
<translation id="4276381981942009836">Tùy chỉnh và điều khiển Browther</translation>
<translation id="4427306783828095590">Chế độ bảo vệ tăng cường giúp chặn phần mềm độc hại và hành vi lừa đảo hiệu quả hơn</translation>
<translation id="4434353761996769206">Lỗi trình cài đặt: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/> quản lý Browther</translation>
<translation id="4007482010626246887">Thêm hồ sơ Browther</translation>
<translation id="6888322430074420631">Giới thiệu về Browther for Testing</translation>
<translation id="8912436499620582668">Để sử dụng và lưu dữ liệu Browther trong Tài khoản Browther, hãy nhập cụm mật khẩu của bạn</translation>
<translation id="4493028449971051158">Lỗi khi khởi động: vui lòng chạy trình cài đặt với tư cách quản trị viên.</translation>
<translation id="4501471624619070934">Không cài đặt được do quyền truy cập bị giới hạn tại quốc gia này.</translation>
<translation id="8976207309012239417">Tiện ích này chưa công bố các phương thức bảo vệ quyền riêng tư, chẳng hạn như cách tiện ích thu thập và sử dụng dữ liệu. Browther khuyên bạn nên xoá tiện ích này.</translation>
<translation id="8888202093812883067">Chào mừng bạn đến với Browther Origin. Cửa sổ trình duyệt mới đã mở ra</translation>
<translation id="6391148383688605718">Browther cần có quyền tạo bản đồ về các khu vực xung quanh và theo dõi tay bạn</translation>
<translation id="7756445485815468244">Bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS"/> trong một hồ sơ Browther khác</translation>
<translation id="137435413163730206">Browther tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn. <ph name="BEGIN_LINK"/>Tìm hiểu thêm về tính năng tải trước trang<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">Cải thiện mức độ an toàn trên mạng cho mọi người khi bạn báo cáo một trang web mà bạn cho là có hại.</translation>
<translation id="3266647901351304597">Browther đã chặn tệp tải xuống này do không thể xác minh tệp (vì bạn đã tắt tính năng Duyệt web an toàn)</translation>
<translation id="6980208900390333646">Dùng thử Browther Ống kính với Browther trên điện thoại</translation>
<translation id="4594305310729380060">Vào Trình quản lý mật khẩu trên thiết bị này</translation>
<translation id="5282047884678321451">Ứng dụng Browther Origin</translation>
<translation id="4598116752460667024">Tìm quy trình bất kỳ trong danh sách.</translation>
<translation id="4970880042055371251">Phiên bản ChromeOS</translation>
<translation id="4482468019601425607">Gần được cập nhật! Hãy khởi chạy lại Browther để hoàn tất cập nhật.</translation>
<translation id="5517890123509214766">Tăng tốc độ tải trang web bằng công cụ V8 của Browther nhưng làm giảm khả năng chống lại các cuộc tấn công của Browther</translation>
<translation id="7690070364551268156">Nếu bạn cũng chia sẻ báo cáo sử dụng của Browther, thì các báo cáo đó sẽ bao gồm cả những URL bạn truy cập</translation>
<translation id="5020487088453637212">Dường như cấu hình này đang được quy trình Browther khác (<ph name="PROCESS_ID"/>) trên máy tính khác (<ph name="HOST_NAME"/>) sử dụng. Browther đã khóa cấu hình này để cấu hình không bị lỗi. Nếu bạn chắc chắn không có quy trình nào khác đang sử dụng cấu hình này, bạn có thể mở khóa cấu hình và chạy lại Browther.</translation>
<translation id="4680828127924988555">Huỷ cài đặt</translation>
<translation id="8134827615154347946">Một số dữ liệu Browther của bạn chưa được lưu vào Tài khoản Browther. Hãy đợi một vài phút trước khi đăng xuất. Nếu bạn đăng xuất ngay, dữ liệu này sẽ bị xoá.</translation>
<translation id="3508712423420506333">Khi đăng nhập, bạn có thể sử dụng mật khẩu và nhiều nội dung khác từ Tài khoản Browther của mình trong Browther. <ph name="SHORTCUT"/> có thể thay đổi chế độ cài đặt cho các dịch vụ của Browther mà bạn sử dụng.</translation>
<translation id="2388739442635757494">Ai đó trước đây đã đăng nhập vào Browther trên máy tính này bằng <ph name="ACCOUNT_EMAIL_LAST"/>. Vui lòng tạo người dùng Browther mới để giữ riêng biệt thông tin của bạn.</translation>
<translation id="4724676981607797757">Không cài đặt được do lỗi giao thức không được hỗ trợ.</translation>
<translation id="8305313684264112434">Bạn vẫn muốn thoát khỏi Browther?</translation>
<translation id="418155915144835101">Browther vừa áp dụng một bản cập nhật bảo mật đặc biệt. Vui lòng khởi động lại ngay bây giờ và chúng tôi sẽ khôi phục các thẻ của bạn.</translation>
<translation id="2683970367518529374">Hỏi Browther</translation>
<translation id="5064473048847774331">Gần đây bạn không truy cập trang web này. Browther đã xoá <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> và <ph name="COUNT"/> quyền khác.</translation>
<translation id="5941343075741207533">Browther không thể kiểm tra mật khẩu của bạn. Hãy thử lại sau 24 giờ hoặc <ph name="BEGIN_LINK"/>kiểm tra các mật khẩu trong Tài khoản Browther của bạn<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">Dịch vụ này sử dụng cùng một trình kiểm tra chính tả dùng trong Browther Tìm kiếm. Thông tin bạn nhập vào trình duyệt sẽ được gửi tới Browther. Bạn luôn có thể thay đổi hành động này trong phần cài đặt.</translation>
<translation id="4581078588976787792">Dùng Browther mà không cần tài khoản</translation>
<translation id="3394520491703535051">Quy tắc kết nối để Browther Origin cho phép lưu lượng truy cập mDNS.</translation>
<translation id="6563126962881169552">Chạy lại để cập nhật &amp;Browther</translation>
<translation id="4918086044614829423">Chấp nhận</translation>
<translation id="4918844574251943176">Đã sao chép hình ảnh</translation>
<translation id="5240982928057703861">Browther đang chạy trong nền.</translation>
<translation id="3603134280602182991">Nhấp để đóng hộp thoại đăng nhập vào Browther</translation>
<translation id="6120233890602288442">Với các hồ sơ trên Browther, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Hãy tạo hồ sơ cho bạn bè và gia đình hoặc phân tách nội dung công việc với nội dung giải trí.</translation>
<translation id="5722688387568011881">Khách có thể sử dụng Browther mà không phải thoát khỏi bất cứ nội dung nào.</translation>
<translation id="7786958592460743302">Tài khoản của bạn trong Browther</translation>
<translation id="9114640791491590337">Thêm chính bạn vào Browther</translation>
<translation id="3536391594566515053">Gemini trong Browther sử dụng tính năng tự động duyệt web để hoạt động trong các thẻ của bạn và hoàn thành những nhiệm vụ bạn giao. <ph name="LINK_BEGIN"/>Tìm hiểu thêm<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">Browther cần có quyền theo dõi cử chỉ tay của bạn</translation>
<translation id="1627123463102858476">Gần đây bạn không truy cập trang web này. Browther đã xoá <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>.</translation>
<translation id="5174969993834422967">Bạn thường chặn các thông báo. Để trang web này có thể gửi thông báo cho bạn, hãy nhấp vào biểu tượng thông báo ở góc bên phải của thanh vị trí.</translation>
<translation id="5174983315706567306">Dung lượng ổ đĩa không đủ.</translation>
<translation id="7091313576354542088">Tài khoản Browther cần được xác thực lại</translation>
<translation id="9045390598305758496">Bạn chưa lưu mật khẩu nào. Browther có thể kiểm tra các mật khẩu của bạn khi bạn lưu các mật khẩu đó.</translation>
<translation id="5686724084351858452">Đăng xuất khỏi Browther</translation>
<translation id="5234764350956374838">Bỏ qua</translation>
<translation id="5254739261293693943">Hỏi về video này</translation>
<translation id="8165028066129227692">Để áp dụng các mục thay đổi của bạn, hãy chạy lại Browther</translation>
<translation id="5286907366254680517">Đã phát hiện</translation>
<translation id="198210130507193824">Tải ứng dụng Browther</translation>
<translation id="8472078903122489041">Browther Updater Internal Service</translation>
<translation id="5346389065299425353">Mở rộng phạm vi tìm kiếm bằng cách thêm nhiều thẻ, tệp và công cụ</translation>
<translation id="3904682305383981098">Browther có một số ý kiến đề xuất về sự an toàn cần bạn xem xét</translation>
<translation id="509616246140011182">Các hồ sơ khác trên Browther</translation>
<translation id="8214429210535362385">Bạn đang đăng nhập bằng tài khoản được quản lý và cấp cho quản trị viên của tài khoản quyền kiểm soát cấu hình Browther của bạn. Dữ liệu Browther của bạn, chẳng hạn như ứng dụng, dấu trang, lịch sử, mật khẩu và các cài đặt khác sẽ vĩnh viễn được liên kết với <ph name="USER_NAME"/>. Bạn có thể xóa dữ liệu này thông qua Trang tổng quan của tài khoản Browther nhưng không thể liên kết dữ liệu này với tài khoản khác. <ph name="LEARN_MORE"/></translation>
