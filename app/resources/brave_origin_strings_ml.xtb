<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="1026101648481255140">ഇൻസ്റ്റാൾ ചെയ്യൽ പുനരാരംഭിക്കുക</translation>
<translation id="7099479769133613710">&amp;ChromeOS അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="7264054672589027446">ഈ വിപുലീകരണം അവലോകനം ചെയ്യണമെന്ന് Browther നിർദ്ദേശിക്കുന്നു</translation>
<translation id="7848219163187166649">ഒരു സൈറ്റ് അതിലെ പേജിലെ ലിങ്കുകൾ സ്വകാര്യമായി മുൻകൂട്ടി ലോഡ് ചെയ്യാൻ ആവശ്യപ്പെടുമ്പോൾ Browther, Browther സെർവറുകൾ ഉപയോഗിക്കുന്നു. മുൻകൂട്ടി ലോഡ് ചെയ്ത സൈറ്റിൽ നിന്ന് ഇത് നിങ്ങളുടെ ഐഡന്റിറ്റി മറയ്ക്കുന്നു, എന്നാൽ ഏതൊക്കെ സൈറ്റുകളാണ് മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നതെന്ന് Browther മനസ്സിലാക്കുന്നു.</translation>
<translation id="1065672644894730302">നിങ്ങളുടെ മുൻഗണനകൾ വായിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമല്ലായിരിക്കാം ഒപ്പം മുൻഗണനകളിലേക്കുള്ള മാറ്റങ്ങൾ സംരക്ഷിക്കപ്പെടുന്നതുമല്ല.</translation>
<translation id="8837164267124113709">നിങ്ങളുടെ രക്ഷിതാവ് Browther-നുള്ള "സൈറ്റുകൾക്കും ആപ്പുകൾക്കും വിപുലീകരണങ്ങൾക്കുമുള്ള അനുമതികൾ" ഓഫാക്കി</translation>
<translation id="881513728707488138">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എക്‌സ്‌പോർട്ട് ചെയ്യാൻ Browther ആഗ്രഹിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="112640046208448578">വസ്തുക്കളോ സ്ഥലങ്ങളോ കണ്ടെത്തൂ, ടെക്‌സ്റ്റ് വിവർത്തനം ചെയ്യുകയോ പകർത്തുകയോ ചെയ്യൂ. നിങ്ങൾ ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിക്കുമ്പോൾ, പേജിന്റെ ഒരു സ്ക്രീൻഷോട്ട് സെർവറിലേക്ക് അയയ്ക്കും. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാണ്</translation>
<translation id="6580138787163923852">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK"/>Browther-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther മെനുവിൽ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="1157985233335035034">അടുത്തിടെ ഉപയോഗിച്ച ഭാഷകൾ</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/>, Browther പ്രവർത്തിക്കുന്ന രീതി മാറ്റിയേക്കാവുന്ന ഒരു വിപുലീകരണം ചേർത്തു.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">നിങ്ങളുടെ Windows പതിപ്പിന് പിന്തുണയില്ലാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="8291401179516272335">Browther-ത്തിനെക്കുറിച്ച്</translation>
<translation id="1203500561924088507">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ ബ്രൗസർ റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="1232234696885483911">നിങ്ങൾ ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ തുറക്കുമ്പോൾ, പേജിന്റെ പേരും URL-ലും PDF-കൾ ഉൾപ്പെടെയുള്ള ഉള്ളടക്കവും സെർവറിലേക്ക് സ്വയമേവ അയയ്ക്കും. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിരിക്കുമ്പോൾ, Browther-ൽ നിങ്ങളുടെ Browther sync chain-ൽ നിന്നുള്ള പാസ്‌വേഡുകളും മറ്റും ഉപയോഗിക്കാനാകും. ഇത് മാറ്റാൻ, “Browther-ലെ നിങ്ങളുടെ അക്കൗണ്ട്” എന്നതിലേക്ക് പോകുക.</translation>
<translation id="9034321258761608912">ഈ ടാബ് നിഷ്ക്രിയമായിരുന്നപ്പോൾ, Browther വേഗത്തിൽ നിലനിർത്താൻ മെമ്മറിയിൽ ഇടമുണ്ടാക്കി. ഈ സൈറ്റ് എല്ലായ്‌പ്പോഴും നിഷ്‌ക്രിയമായിരിക്കുന്നതിൽ നിന്ന് ഒഴിവാക്കാൻ നിങ്ങൾക്ക് തിരഞ്ഞെടുക്കാം.</translation>
<translation id="249571811018731941">ഫയൽ അപകടകരമായതിനാൽ Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> ഉപയോഗിച്ച് Gmail അല്ലെങ്കിൽ Youtube പോലുള്ള Browther സേവനങ്ങളിലേക്ക് സൈൻ ഇൻ ചെയ്യുമ്പോൾ, അതേ അക്കൗണ്ട് ഉപയോഗിച്ച് നിങ്ങൾക്ക് Browther-ലേക്കും സ്വയമേവ സൈൻ ഇൻ ചെയ്യാം</translation>
<translation id="1290883685122687410">സജ്ജീകരണത്തിലെ പിശക്: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">നിങ്ങളുടെ പുതിയ Browther പ്രൊഫൈൽ സജ്ജീകരിക്കുക</translation>
<translation id="4437862975743821367">Bluetooth ഉപകരണങ്ങൾ 
 അടുത്തറിയാൻ Browther-ന് Bluetooth ആക്‌സസ് ആവശ്യമാണ്. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">ഭാഷ കണ്ടെത്തുക</translation>
<translation id="1206925267243987362">Browther നിർദ്ദേശിക്കുന്ന ബ്രൗസർ ക്രമീകരണം ഉപയോഗിക്കുക</translation>
<translation id="8270483548049772782">Browther-ൽ നിന്നുള്ള ഡാറ്റയും ഇല്ലാതാക്കുക (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">പിൻ ചെയ്‌തു! ടൂൾബാറിലെ പുതിയ ബട്ടൺ വഴി നിങ്ങൾക്ക് ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ വീണ്ടും ആക്സസ് ചെയ്യാനാകും</translation>
<translation id="1356661055722410047">പുതിയത്! നിങ്ങളുടെ സ്ക്രീനിലെ ടെക്സ്റ്റും ചിത്രങ്ങളും നിങ്ങൾക്ക് വിവർത്തനം ചെയ്യാം</translation>
<translation id="1383876407941801731">തിരയുക</translation>
<translation id="1592588950737518481">&amp;Browther പ്രൊഫൈലുകൾ മാനേജ് ചെയ്യുക</translation>
<translation id="1404026649028693342">എല്ലായ്‌പ്പോഴും AI മോഡ് കാണിക്കുക</translation>
<translation id="141901961143729572">നിങ്ങളുടെ ചിന്തകൾ പങ്കിടുക</translation>
<translation id="1743952081001089298">നിങ്ങളുടെ വിൻഡോ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ Browther-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക.</translation>
<translation id="8627385813382688019">Browther for Testing-മായി ബന്ധപ്പെട്ട സഹായം നേടൂ</translation>
<translation id="1497802159252041924">ഇൻസ്‌റ്റാൾ ചെയ്യലിൽ പിശക്: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ഈ പേജ് പരിരക്ഷിതമാണ്</translation>
<translation id="7252430412915798987">ഒരു Browther ടാബ് പങ്കിടുക</translation>
<translation id="6388429281015199562">Browther-ൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="1547469039832541117">ഹൈലൈറ്റ് ചെയ്ത ടാസ്‌ക് അവസാനിപ്പിക്കുന്നു.</translation>
<translation id="1801944307203212016">നിങ്ങളുടെ ചുറ്റുപാടിന്റെ 3D മാപ്പ് സൃഷ്ടിക്കുന്നതിന് നിങ്ങളുടെ ക്യാമറ ആക്സസ് ചെയ്യാൻ Browther-ന് നിങ്ങളുടെ അനുമതി ആവശ്യമാണ്</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{ഈ വിപുലീകരണത്തിന് ഇനി പിന്തുണയില്ല. നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് Browther നിർദ്ദേശിക്കുന്നു.}other{ഈ വിപുലീകരണങ്ങൾക്ക് ഇനി പിന്തുണയില്ല. നിങ്ങൾ അവ നീക്കം ചെയ്യാൻ Browther നിർദ്ദേശിക്കുന്നു.}}</translation>
<translation id="4667068923142532753">Browther പിൻ ചെയ്യുക</translation>
<translation id="3006560544901646947">Browther-ന്റെ സുരക്ഷാ ടൂളുകൾ</translation>
<translation id="686052171138185761">നിങ്ങളുടെ Password Manager ഡാറ്റ ഇല്ലാതാക്കാൻ Browther താൽപ്പര്യപ്പെടുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് ടൈപ്പ് ചെയ്യുക.</translation>
<translation id="8713026329083542796">Browther-ലെ പ്രധാന സ്വകാര്യതാ, സുരക്ഷാ നിയന്ത്രണങ്ങൾ അവലോകനം ചെയ്യുക</translation>
<translation id="1640672724030957280">ഡൗൺലോഡുചെയ്യുന്നു...</translation>
<translation id="1680687534629375545">ഈ പേജിനെ കുറിച്ച് ചിത്രമുപയോഗിച്ചുള്ള തിരയലിനോട് ചോദിക്കുക</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> എന്നതിനുള്ള കൂടിയ അവകാശങ്ങൾ നൽകുന്നു.</translation>
<translation id="4243382967656566037">ഈ ഫീച്ചറുകൾ മെച്ചപ്പെടുത്താൻ സഹായിക്കുന്നതിന്, Browther-മായി നിങ്ങൾ നടത്തുന്ന ഇടപഴകലുകൾ അത് Browther-ലേക്ക് അയയ്ക്കുന്നു. അവലോകനം ചെയ്യുന്നവർ ഈ ഡാറ്റ വായിക്കുകയും പ്രോസസ് ചെയ്യുകയും വ്യാഖ്യാനിക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="1722488837206509557">ലഭ്യമായ ഉപകരണങ്ങളിൽ നിന്ന് തിരഞ്ഞെടുക്കാനും അവയിൽ ഉള്ളടക്കം പ്രദർശിപ്പിക്കാനും ഇത് നിങ്ങളെ അനുവദിക്കും.</translation>
<translation id="6820510278633522408">Browther ഉടൻ തന്നെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും</translation>
<translation id="7775028004939172516">നാവിഗേഷനുകൾ HTTPS-ലേക്ക് അപ്‌ഗ്രേഡ് ചെയ്യാൻ Browther ശ്രമിക്കും</translation>
<translation id="6963959729951758069">Browther ഡാറ്റ മായ്‌‌ച്ചു</translation>
<translation id="4085139922884095932"><ph name="REMAINING_TIME"/>-നുള്ളിൽ Browther റീസ്റ്റാർട്ട് ചെയ്യും</translation>
<translation id="2586248102295515296">HTTPS ലഭ്യമല്ലാത്തപ്പോൾ, നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകാതെ Browther ഒരു സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിക്കും</translation>
<translation id="3975328336074677101">Browther-ത്തെ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കാൻ അനുവദിക്കുക</translation>
<translation id="2497443204974841650">Browther വീണ്ടും ഇൻസ്‌റ്റാളുചെയ്യുക</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> എന്നതിനുവേണ്ടി ശ്രമിക്കുന്നു</translation>
<translation id="4553225588627299783">അടുത്ത തവണ <ph name="DEVICE_TYPE"/> എന്നതിൽ Browther തുറക്കുമ്പോൾ, Browther Password Manager ഉപയോഗിക്കാനുള്ള ഒരു പ്രോംപ്റ്റ് നിങ്ങൾ കാണും.</translation>
<translation id="1838374766361614909">തിരയൽ മായ്ക്കുക</translation>
<translation id="2337233040802538155">നിങ്ങളുടെ Browther sync chain-ൽ ബ്രൗസിംഗ് ഡാറ്റ നിലനിർത്തിക്കൊണ്ട് ഈ ഉപകരണത്തിൽ നിന്ന് മാത്രം അത് ഇല്ലാതാക്കാൻ, <ph name="BEGIN_LINK"/>Browther-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">എവിടെയായിരുന്നാലും ടാബ് ഗ്രൂപ്പുകൾ തുറക്കാനോ പുതിയ ടാബ് ഗ്രൂപ്പുകൾ സൃഷ്ടിക്കാനോ നിങ്ങളുടെ ഫോണിൽ Browther ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="2063443520349987970">സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്ന Browther അക്കൗണ്ടുകൾ നിങ്ങൾക്ക് മാനേജ് ചെയ്യാം. Browther ബ്രൗസർ, Play Store, Gmail എന്നിവയ്ക്കും മറ്റുമായി നിങ്ങളുടെ Browther അക്കൗണ്ടുകൾ ഉപയോഗിക്കുന്നു. കുടുംബാംഗത്തെ പോലുള്ള മറ്റാർക്കെങ്കിലും വേണ്ടി ഒരു അക്കൗണ്ട് ചേർക്കണമെങ്കിൽ, പകരം നിങ്ങളുടെ <ph name="DEVICE_TYPE"/> എന്നതിലേക്ക് പുതിയൊരു വ്യക്തിയെ ചേർക്കുക. <ph name="LINK_BEGIN"/>കൂടുതലറിയുക<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് തിരയുക</translation>
<translation id="1880677175115548835">ടെക്‌സ്‌റ്റ് തിരഞ്ഞെടുക്കുക</translation>
<translation id="3183933389992069620">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിന് നിങ്ങളുടെ Browther പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള Browther ഡാറ്റ <ph name="USER_NAME"/> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. Browther അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാനാകുമെങ്കിലും, ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. നിങ്ങളുടെ നിലവിലെ Browther ഡാറ്റ പ്രത്യേകമായി സൂക്ഷിക്കുന്നതിന് നിങ്ങൾക്ക് ഒരു പുതിയ പ്രൊഫൈൽ ഓപ്‌ഷണലായി സൃഷ്‌ടിക്കാനാകും. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">പശ്ചാത്തല ആക്റ്റിവിറ്റിയും സ്‌മൂത്ത് സ്ക്രോളിംഗ്, വീഡിയോ ഫ്രെയിം റേറ്റുകൾ എന്നിവ പോലുള്ള വിഷ്വൽ ഇഫക്റ്റുകളും പരിമിതപ്പെടുത്തി Browther ബാറ്ററി പവർ ലാഭിക്കുന്നു. <ph name="BEGIN_LINK"/>എനർജി സേവറിനെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">ഈ പേജിനെ കുറിച്ച് ചോദിക്കുക</translation>
<translation id="9128006428501241840">Browther അപ്ഡേറ്റർ സേവനം</translation>
<translation id="6302815314157879372">ഇത് ഓഫാക്കുന്നതിലൂടെ, Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യാതെ തന്നെ Gmail പോലുള്ള Browther സൈറ്റുകളിൽ നിങ്ങൾക്ക് സൈൻ ഇൻ ചെയ്യാനാവും</translation>
<translation id="1063611196035804685">Browther പ്രതികരിക്കുന്നില്ല. ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കണോ?</translation>
<translation id="2873360330889594383">നിങ്ങളുടെ സ്ഥാപനം, <ph name="MANAGER"/>, Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="4035053306113201399">അപ്ഡേറ്റ് ബാധകമാക്കാൻ ChromeOS റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="2861285003831382718">ഈ ഫയൽ തരം സാധാരണയായി ഡൗൺലോഡ് ചെയ്യാത്തതിനാലും ഇത് അപകടകരമായേക്കാം എന്നതിനാലും Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="1953553007165777902">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="MINUTE"/> മിനിറ്റ് ശേഷിക്കുന്നു</translation>
<translation id="2080160985220483492">Browther നുറുങ്ങ്: പാസ്‌വേഡുകൾ സംരക്ഷിക്കൂ</translation>
<translation id="8037497710694492565">Browther-ത്തിന് ഡിഫോൾട്ട് ബ്രൗസർ നിർണ്ണയിക്കാനോ സജ്ജമാക്കാനോ കഴിയില്ല</translation>
<translation id="7395009124247513849">ചില ഫയലുകൾ പുതിയ ടാബിൽ തുറക്കുന്നത് Browther ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="762710512520170632">നിങ്ങളുടെ Browther സോഫ്റ്റ്‌വെയർ അപ് ടു ഡേറ്റായി നിലനിർത്തുന്നു. ഈ സേവനം പ്രവർത്തനരഹിതമാക്കുകയോ നിർത്തുകയോ ചെയ്‌താൽ, നിങ്ങളുടെ Browther സോഫ്റ്റ്‌വെയർ അപ് ടു ഡേറ്റായി നിലനിർത്തില്ല, അതായത്, സുരക്ഷാ പ്രശ്നങ്ങൾ സംഭവിക്കുകയാണെങ്കിൽ അവ പരിഹരിക്കാനാകില്ല, ഫീച്ചറുകൾ പ്രവർത്തിക്കാനും സാധ്യതയില്ല. Browther സോഫ്റ്റ്‌വെയർ ഉപയോഗിക്കാത്തപ്പോൾ, ഈ സേവനം സ്വയം അൺഇൻസ്റ്റാൾ ചെയ്യുന്നു.</translation>
<translation id="5793588180426267429">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും ഒരിനം ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി Browther-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2018879682492276940">ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="6351516710581760512">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ മറ്റ് പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK"/>Browther-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">ക്രമീകരണം.</translation>
<translation id="8194525816714210105">Browther സേവനങ്ങളിൽ കൂടുതൽ വ്യക്തിപരമാക്കിയ അനുഭവം ലഭ്യമാകാൻ Browther ചരിത്രം ഉൾപ്പെടുത്തണോ എന്ന് തിരഞ്ഞെടുക്കുക</translation>
<translation id="5909559127548969159">Browther-ന് പുതിയ രൂപം നൽകാൻ പുതിയ ടാബ് പേജിലെ 'Browther ഇഷ്ടാനുസൃതമാക്കുക' ബട്ടൺ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="2066690553719545730">എല്ലായ്‌പ്പോഴും AI മോഡ് കാണിക്കുക</translation>
<translation id="3283892260110318935">ഫയൽ വഞ്ചനാപരമായതിനാലും നിങ്ങളുടെ ഉപകരണത്തിൽ അപ്രതീക്ഷിത മാറ്റങ്ങൾ വരുത്തിയേക്കാം എന്നതിനാലും Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="6160571936643742128">അടുത്ത തവണ Browther iOS തുറക്കുമ്പോൾ <ph name="FEATURE_NAME"/> പരീക്ഷിച്ച് നോക്കാനുള്ള ഒരു പ്രോംപ്റ്റ് നിങ്ങൾ കാണും.</translation>
<translation id="8380517409933452343">നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിച്ചിട്ടുള്ള പാസ്‌വേഡുകളും മറ്റ് Browther ഡാറ്റയും ഈ ഉപകരണത്തിൽ നിന്ന് നീക്കം ചെയ്യും. Browther-ൽ അവ വീണ്ടും ഉപയോഗിക്കാൻ, വീണ്ടും സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{ഒരു മിനിറ്റ് Browther ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും. നിങ്ങളുടെ ടാബുകൾ ഓണാക്കിയ നിലയിൽ തുടരും.}other{# മിനിറ്റ് Browther ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും. നിങ്ങളുടെ ടാബുകൾ ഓണാക്കിയ നിലയിൽ തുടരും.}}</translation>
<translation id="2126108037660393668">ഡൗൺലോഡ് ചെയ്ത ഫയൽ പരിശോധിച്ചുറപ്പിക്കാനായില്ല.</translation>
<translation id="2135919691573380097">ഈ സൈറ്റ് റിപ്പോർട്ട് ചെയ്യുക</translation>
<translation id="2137162749895930932">വിവർത്തന സ്ക്രീൻ അടയ്ക്കുക</translation>
<translation id="4283559398694996391">സൈറ്റ് സുരക്ഷിത കണക്ഷൻ ഉപയോഗിക്കാത്തതിനാലും ഫയലിൽ തകരാർ സംഭവിച്ചിട്ടുണ്ടാകാം എന്നതിനാലും Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="2170098639895543546">പേജിലുള്ള എന്തെങ്കിലും തിരഞ്ഞെടുക്കുക</translation>
<translation id="2495182092286337191">Browther ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="2174917724755363426">ഇൻസ്റ്റാൾ ചെയ്യൽ പൂർത്തിയായിട്ടില്ല. റദ്ദാക്കണമെന്ന് ഉറപ്പാണോ?</translation>
<translation id="4877141231724140862">Browther - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">അപ്ഡേറ്റ് പരിശോധനയിലെ പിശക്: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Browther-ൽ നിന്ന് അക്കൗണ്ട് നീക്കം ചെയ്യുക</translation>
<translation id="1084363153644366288">iOS-നുള്ള Browther-ലെ മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് ഉപയോഗിച്ച് എവിടെയായിരുന്നാലും സുരക്ഷിതരായിരിക്കുക</translation>
<translation id="7949164640723239455">അപകടകരമായ സൈറ്റ്. അറിയിപ്പുകൾ Browther നീക്കം ചെയ്തു.</translation>
<translation id="2236949375853147973">എന്റെ ആക്റ്റിവിറ്റി</translation>
<translation id="4536403809133456417">വിലാസങ്ങളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. സൈൻ ഇൻ ചെയ്‌തുകഴിഞ്ഞാൽ ഈ വിലാസം നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിക്കും.</translation>
<translation id="5627930103267312171">നിങ്ങളൊരു കമ്പ്യൂട്ടർ പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് ആവശ്യമുള്ള രീതിയിൽ Browther സജ്ജീകരിക്കാനുമാകും.</translation>
<translation id="2283803047247799269">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ ടാബ് തിരയുക</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{നിങ്ങളുടെ ബ്രൗസറിന്റെ വേഗത കുറയ്ക്കുന്ന ടാബ് താൽക്കാലികമായി നിർത്താൻ Browther നിർദ്ദേശിക്കുന്നു}other{നിങ്ങളുടെ ബ്രൗസറിന്റെ വേഗത കുറയ്ക്കുന്ന ടാബുകൾ താൽക്കാലികമായി നിർത്താൻ Browther നിർദ്ദേശിക്കുന്നു}}</translation>
<translation id="2307973900865360088">ഡോക്കിൽ നിലനിർത്തൂ</translation>
<translation id="5161617112768367959">Browther-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു. ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുമ്പോഴോ നിങ്ങൾ ഒരു ദോഷകരമായ ഫയൽ ഡൗൺലോഡ് ചെയ്യുമ്പോഴോ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കൾ സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് Browther അയയ്ക്കുകയും ചെയ്തേക്കാം.</translation>
<translation id="4123094831918713833">ഈ പ്രവർത്തനം ഇനിപ്പറയുന്നത് ചെയ്യും:
        <ph name="LINE_BREAKS"/>
          • ചില Browther ക്രമീകരണങ്ങളും Browther കുറുക്കുവഴികളും റീസെറ്റ് ചെയ്യും
          <ph name="LINE_BREAK"/>
          • വിപുലീകരണങ്ങൾ പ്രവർത്തനരഹിതമാക്കും
          <ph name="LINE_BREAK"/>
          • കുക്കികളും മറ്റ് താൽക്കാലിക സൈറ്റ് ഡാറ്റയും ഇല്ലാതാക്കും
          <ph name="LINE_BREAKS"/>
          ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, സംരക്ഷിച്ച പാസ്‌വേഡുകൾ എന്നിവയെ ബാധിക്കില്ല.</translation>
<translation id="5456070119344236353">ഇവിടെ നിന്ന് നിങ്ങളുടെ Android ഫോണിലേക്ക് ഒരു നമ്പർ അയയ്‌ക്കാൻ, രണ്ട് ഉപകരണങ്ങളിൽ നിന്നും Browther-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2356070529366658676">ചോദിക്കുക</translation>
<translation id="2359808026110333948">തുടരുക</translation>
<translation id="6468415397021485143">Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ "<ph name="EXTENSION_NAME"/>" എന്ന വിപുലീകരണം നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="2558600429878197587">ആപ്പുകൾക്കായി പശ്ചാത്തലത്തിൽ റൺ ചെയ്യുന്ന Browther പ്രവർത്തനരഹിതമാക്കുക</translation>
<translation id="5295781918312989856"><ph name="USER_EMAIL_ADDRESS"/> എന്നയാളായി ഈ വിപുലീകരണം ഉപയോഗിക്കാൻ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8418845734693287262">നിങ്ങളുടെ അക്കൗണ്ടിന്റെ സൈൻ ഇൻ വിശദാംശങ്ങൾ കാലഹരണപ്പെട്ടതിനാൽ ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{ഒന്നോ അതിലധികമോ Browther വിപുലീകരണങ്ങൾ ഒരു HID ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ടായിരുന്നു}=1{ഒന്നോ അതിലധികമോ Browther വിപുലീകരണങ്ങൾ ഒരു HID ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ട്}other{ഒന്നോ അതിലധികമോ Browther വിപുലീകരണങ്ങൾ # HID ഉപകരണങ്ങൾ ആക്‌സസ് ചെയ്യുന്നുണ്ട്}}</translation>
<translation id="434258293817844111">Browther-ന് ഈ സൈറ്റിനായി ക്യാമറ, മൈക്രോഫോൺ അനുമതികൾ ആവശ്യമാണ്</translation>
<translation id="2403703063067034158">സ്റ്റാർട്ടപ്പിലെ പിശക്: സജ്ജീകരണത്തിന്റെ മറ്റൊരു ഇൻസ്റ്റൻസ് നിലവിൽ റൺ ചെയ്യുന്നുണ്ട്, പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5458993228789433099">ഏതൊരു ആപ്പിൽ നിന്നുമുള്ള ലിങ്കുകൾ Browther-ൽ തുറക്കുക, നിങ്ങളുടെ ടാസ്‌ക്ബാറിൽ ബ്രൗസർ ആക്‌സസ് ചെയ്യാവുന്ന നിലയിൽ നിലനിർത്തുക</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther-ൽ നിന്നുള്ള ടൂളുകൾ<ph name="END_LINK"/> ഉപയോഗിച്ച്, നിങ്ങൾക്ക് സുരക്ഷിതമായി ബ്രൗസ് ചെയ്യാനും നിയന്ത്രണത്തിൽ തുടരാനുമാകും</translation>
<translation id="2451727308784734061">Password Manager-ലേക്ക് വേഗത്തിൽ എത്താൻ നിങ്ങളുടെ കുറുക്കുവഴി ഉപയോഗിക്കുക. നിങ്ങളുടെ കമ്പ്യൂട്ടറിന്റെ ഹോം സ്‌ക്രീനിലേക്കോ ആപ്പ് ലോഞ്ചറിലേക്കോ കുറുക്കുവഴി നീക്കാം.</translation>
<translation id="2280315911954332435">Browther ഉടൻ അടയ്‌ക്കും</translation>
<translation id="6410820860979094113">Browther-ത്തിൽ</translation>
<translation id="2485422356828889247">അണ്‍‌ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യുക</translation>
<translation id="2513154137948333830">റീബൂട്ട് ചെയ്യേണ്ടതുണ്ട്: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് ടെക്സ്റ്റ് തിരഞ്ഞെടുക്കുക</translation>
<translation id="7892218991241200190">നിലവിലുള്ള പാസ്‌വേഡുകൾ മാറ്റി പകരം പുതിയവ ചേർക്കാൻ Browther ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="8976443723926188033">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ Browther-ത്തിന് സ്റ്റോറേജ് ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="4131374838781785973">Browther Origin ഹെൽപ്പർ</translation>
<translation id="2575822587468774919">'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് തിരയാൻ എന്തെങ്കിലും തിരഞ്ഞെടുക്കുക</translation>
<translation id="8705561858232289221">പാസ്‌വേഡുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="437162022240011372">Browther ഉപയോഗിക്കുന്നത് തുടരുക</translation>
<translation id="259935314519650377">ഡൗൺലോഡ് ചെയ്ത ഇൻസ്റ്റാളർ കാഷെ ചെയ്യാനായില്ല. പിശക്: <ph name="UNPACK_CACHING_ERROR_CODE"/></translation>
<translation id="2620436844016719705">സിസ്റ്റം</translation>
<translation id="2907676829052962091">നിങ്ങളുടെ ഓർഗനൈസേഷന് നിങ്ങളുടെ ബുക്ക്‌മാർക്കുകളും ചരിത്രവും പാസ്‌വേഡുകളും പോലുള്ള ബ്രൗസിംഗ് ഡാറ്റ കാണാനും മാനേജ് ചെയ്യാനും കഴിയും. മറ്റ് Browther പ്രൊഫൈലുകളിലെ ബ്രൗസിംഗ് ഡാറ്റ അതിന് കാണാനാകില്ല</translation>
<translation id="1289116577679005654"><ph name="ACCOUNT_EMAIL"/> അക്കൗണ്ടിൽ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും ഇത് നിങ്ങൾ തന്നെയാണെന്ന് പരിശോധിച്ചുറപ്പിക്കുക</translation>
<translation id="7192278346779151664">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിനിടെ ഒരു ഓപ്പറേറ്റിംഗ് സിസ്റ്റം പിശക് സംഭവിച്ചു. Browther വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="7724398260867885339">നിങ്ങളൊരു ഉപകരണം പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് താൽപ്പര്യമുള്ള തരത്തിൽ Browther സജ്ജീകരിക്കാനുമാകും</translation>
<translation id="1679595317134614424">Browther ടാബ്</translation>
<translation id="7189168846924379421">അധിക സുരക്ഷക്കായി, Browther നിങ്ങളുടെ ഡാറ്റ എന്‍‌ക്രിപ്റ്റ് ചെയ്യും.</translation>
<translation id="4052643592793184278">Browther-ൽ നിന്ന് നിങ്ങളുടെ Browther sync chain നീക്കം ചെയ്യാൻ, സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="7694616023994438906">പാസ്‌വേഡുകളും ബുക്ക്‌മാർക്കുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="2738871930057338499">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. HTTP 403 നിരോധിച്ചിരിക്കുന്നു. നിങ്ങളുടെ പ്രോക്‌സി കോൺഫിഗറേഷൻ പരിശോധിക്കുക.</translation>
<translation id="2753623023919742414">തിരയാൻ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="9078193405195503710">Browther നിങ്ങളുടെ ഡിഫോൾട്ട് PDF വ്യൂവറായി സജ്ജീകരിക്കുക</translation>
<translation id="2456995288904753506">സ്റ്റാൻഡേർഡ് ഓട്ടോഫിൽ വിട്ടുപോയേക്കാവുന്ന പ്രയാസമുള്ള ഫീൽഡുകൾ Browther-ന് ഓട്ടോഫിൽ ചെയ്യാനാകും</translation>
<translation id="3271730304285122987">ഈ വിപുലീകരണത്തിൽ മാല്‍വെയർ അടങ്ങിയിരിക്കുന്നു, ഇത് സുരക്ഷിതമല്ല. Browther-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="2799223571221894425">വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="1427337251963884503">നിങ്ങളുടെ Browther</translation>
<translation id="2816462166102338036">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ വീഡിയോ തിരയുക</translation>
<translation id="2841525013647267359">ഈ ഭാഷയിൽ നിന്ന് വിവർത്തനം ചെയ്യുക</translation>
<translation id="2846251086934905009">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാളർ പൂർത്തിയായില്ല. ഇൻസ്റ്റാൾ ചെയ്യൽ റദ്ദാക്കി.</translation>
<translation id="928966105228355994">Browther-ൽ നിന്ന് നീക്കംചെയ്യുക...</translation>
<translation id="587805782197019018">നിങ്ങൾ സൈൻ ഇൻ ചെയ്തിരിക്കുമ്പോൾ Browther-ൽ നിങ്ങളെ സുരക്ഷിതരാക്കുകയും മറ്റ് Browther ആപ്പുകളിൽ നിങ്ങളുടെ സുരക്ഷ മെച്ചപ്പെടുത്താൻ ഉപയോഗിക്കുകയും ചെയ്യും</translation>
<translation id="2885378588091291677">ടാസ്‌ക് മാനേജര്‍</translation>
<translation id="3055995278166070443">&amp;Browther-നെക്കുറിച്ച്</translation>
<translation id="2915996080311180594">പിന്നീട് റീസ്‌റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="2928420929544864228">ഇൻസ്റ്റാൾ ചെയ്യൽ പൂർത്തിയായി.</translation>
<translation id="70453521937551896">നിങ്ങളുടെ പാസ്ഫ്രെയ്‌സ് ഉപയോഗിച്ച് നിങ്ങളുടെ ഡാറ്റ എൻക്രിപ്റ്റ് ചെയ്‌തു. നിങ്ങളുടെ Browther sync chain-ൽ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും അത് നൽകുക.</translation>
<translation id="2945997411976714835">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാൾ ചെയ്യൽ പ്രക്രിയ ആരംഭിക്കാനായില്ല.</translation>
<translation id="3188308520233701133">iOS-ൽ Browther-നായി സംരക്ഷിച്ച പാസ്‌വേഡുകൾ ഉപയോഗിച്ച് സൈറ്റുകളിലേക്ക് കൂടുതൽ വേഗത്തിൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="8145318807880784886">ബുക്ക്‌മാർക്കുകളും പാസ്‌വേഡുകളും ക്രമീകരണവും വേർതിരിച്ച് നിർത്താൻ പുതിയൊരു Browther പ്രൊഫൈൽ ചേർക്കുക.</translation>
<translation id="4330268530227888227">നിങ്ങളുടെ സ്ഥാപനം Browther മാനേജ് ചെയ്യുന്നു</translation>
<translation id="6488090896442998436">Browther അപ്‌‌ടുഡേറ്റാണ്</translation>
<translation id="300557164611864786">ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുകയോ നിങ്ങൾ ദോഷകരമായ ഒരു ഫയൽ ഡൗൺലോഡ് ചെയ്യുകയോ ആണെങ്കിൽ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കളും സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് Browther അയച്ചേക്കാം</translation>
<translation id="2447145782593796785">നിങ്ങളുടെ രക്ഷിതാവിന്റെ ചോയ്‌സുകൾ ഉപയോഗിച്ച് ഓൺലൈനിൽ സുരക്ഷിതരായിരിക്കാൻ, Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3003694935412297923">എല്ലാ ടാസ്‌ക്കുകളും</translation>
<translation id="7554113777150891030">{count,plural, =1{നിങ്ങളുടെ Browther sync chain-ൽ ചില ഡാറ്റ സംരക്ഷിക്കുന്നതിനും അത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഉപയോഗിക്കുന്നതിനും മുമ്പ് ഇത് നിങ്ങൾ തന്നെയാണെന്ന് Browther-ന് പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ, ഈ ഡാറ്റ (1 ഇനം) ഇല്ലാതാക്കും.}other{നിങ്ങളുടെ Browther sync chain-ൽ ചില ഡാറ്റ സംരക്ഷിക്കുന്നതിനും അത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഉപയോഗിക്കുന്നതിനും മുമ്പ് ഇത് നിങ്ങൾ തന്നെയാണെന്ന് Browther-ന് പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ ഈ ഡാറ്റ ({count} ഇനങ്ങൾ) ഇല്ലാതാക്കും.}}</translation>
<translation id="5522228731050510047">Browther-ലെ പുതിയ ടാബിൽ <ph name="URL"/> തുറക്കുക.</translation>
<translation id="6358780591055960280">Browther-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="1386422761453740126">Browther-ലേക്ക് ചേർക്കുന്നു...</translation>
<translation id="3038232873781883849">ഇൻസ്റ്റാൾ ചെയ്യാൻ കാത്തിരിക്കുന്നു...</translation>
<translation id="3045032126857188731">വിവർത്തനം ചെയ്‌ത ഭാഷ: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ഫീഡ്ബാക്ക് ഡയലോഗ് അടയ്ക്കുക</translation>
<translation id="369127628511662602">മറ്റ് Browther പ്രൊഫൈലുകൾ</translation>
<translation id="2370255879896574713">Browther-ലേക്ക് ക്രാഷ് റിപ്പോർട്ടുകളും <ph name="UMA_LINK"/> എന്നതും അയയ്‌ക്കുന്നതിലൂടെ Browther മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{ഒന്നോ അതിലധികമോ Browther വിപുലീകരണങ്ങൾ ഒരു USB ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ടായിരുന്നു}=1{ഒന്നോ അതിലധികമോ Browther വിപുലീകരണങ്ങൾ ഒരു USB ഉപകരണം ആക്‌സസ് ചെയ്യുന്നുണ്ട്}other{ഒന്നോ അതിലധികമോ Browther വിപുലീകരണങ്ങൾ # USB ഉപകരണങ്ങൾ ആക്‌സസ് ചെയ്യുന്നുണ്ട്}}</translation>
<translation id="2065456480740480340">Browther ചരിത്രം</translation>
<translation id="5011660649081947055">ആര്‍ക്കൈവ് അണ്‍‌കം‌പ്രസ് ചെയ്യാന്‍ ഇന്‍സ്റ്റാളറിന് കഴിഞ്ഞില്ല. Browther വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="310459126943037700">ടാസ്‌ക്(കൾ) അവസാനിപ്പിക്കാനായില്ല.</translation>
<translation id="3104828284009500087">പേജിൽ എന്തും തിരയുക</translation>
<translation id="4917564010081457061">നിങ്ങളുടെ പാസ്‌വേഡുകളും ബുക്ക്‌മാർക്കുകളും ചരിത്രവും ഉപകരണങ്ങളിലുടനീളം കൃത്യമായി സമന്വയിപ്പിച്ച് നിലനിർത്തുക. നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസർ Browther-ലേക്ക് അപ്ഡേറ്റ് ചെയ്ത് നിങ്ങൾക്ക് അറിയാവുന്നതും ഇഷ്ടമുള്ളതുമായ ഫീച്ചറുകൾ എളുപ്പത്തിൽ ആക്സസ് ചെയ്യുക.</translation>
<translation id="1041472930719344928">Browther നിങ്ങളുടെ മൈക്രോഫോൺ ഉപയോഗിക്കുന്നു.</translation>
<translation id="3130333203120345554">പുതിയ തിരയൽ</translation>
<translation id="3137969841538672700">തിരയാൻ വലിച്ചിടുക</translation>
<translation id="5312717254055363883">ഈ ടാബ് അധിക ഉറവിടങ്ങൾ ഉപയോഗിക്കുന്നു. നിങ്ങളുടെ പ്രകടനം മെച്ചപ്പെടുത്താനായി അതിനെ നിഷ്ക്രിയമാക്കാൻ Browther-നെ അനുവദിക്കുക.</translation>
<translation id="373523409348786203">നിങ്ങളുടെ സ്‌ക്രീൻ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ Browther-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക</translation>
<translation id="802113445299754598">Browther വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="3161522574479303604">എല്ലാ ഭാഷകളും</translation>
<translation id="4522189060330781648">നിങ്ങളുടെ കമ്പ്യൂട്ടറിലെ മറ്റൊരു പ്രോഗ്രാം, Browther പ്രവർത്തിക്കുന്ന രീതി മാറ്റിയേക്കാവുന്ന ഒരു തീം ചേർത്തു.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">നിങ്ങളുടെ പുതിയ Browther പ്രൊഫൈൽ ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="5150830326120505481">Browther-ൽ നിന്ന് നിങ്ങളുടെ Browther sync chain നീക്കം ചെയ്യാൻ, ക്രമീകരണം പേജിൽ Browther-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="7113660200899017820">പിന്നീട്, സംരക്ഷിച്ച വിവരങ്ങൾ സ്വയമേവ ഫോമുകൾ പൂരിപ്പിക്കാൻ ഉപയോഗിക്കണമെന്നുണ്ടോ എന്ന് Browther നിങ്ങളോട് ചോദിക്കും</translation>
<translation id="4475011322243623412">Browther-ത്തിന് ഡാറ്റാ ഡയറക്‌റ്ററി വായിക്കാനോ അതിൽ എഴുതാനോ കഴിയില്ല:

<ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">ഇപ്പോള്‍ പുനരാരംഭിക്കുക</translation>
<translation id="3536063527222598206">Browther API കീകൾ നഷ്‌ടമായി. Browther-ന്‍റെ ചില പ്രവർത്തനങ്ങൾ പ്രവർത്തനരഹിതമാകും.</translation>
<translation id="1011450868746766298">Browther അടയ്‌ക്കുമ്പോൾ അപ്ലിക്കേഷനുകൾ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കുന്നത് തുടരുക</translation>
<translation id="179611081153855734">സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിച്ച് ഏതെങ്കിലും സൈറ്റ് ലോഡ് ചെയ്യുന്നതിന് മുമ്പ് Browther നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകും</translation>
<translation id="8965591964936552871">Browther-ൽ സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ടെങ്കിൽ എല്ലാ Browther വിൻഡോകളും അടയ്ക്കുമ്പോൾ, നിങ്ങളുടെ Browther sync chain ഒഴികെ മിക്ക സൈറ്റുകളിൽ നിന്നും നിങ്ങൾ സൈൻ ഔട്ട് ആകും. നിങ്ങളെ ഓർക്കാൻ സൈറ്റുകളെ അനുവദിക്കുന്നതിന്, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">Browther-ന് പുറത്ത് നിന്ന് നിങ്ങളുടെ ഡിഫോൾട്ട് തിരയൽ എഞ്ചിൻ മാറ്റി. നിങ്ങൾക്ക് പരിരക്ഷ നൽകാൻ, Browther അത് റീസെറ്റ് ചെയ്തു.</translation>
<translation id="1170501833661894915">എല്ലാ ഉപകരണങ്ങളിലും നിങ്ങളുടെ പാസ്‌വേഡുകളും ബുക്ക്‌മാർക്കുകളും മറ്റും ലഭ്യമാക്കുന്നതിന് Browther-ൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="3352986031709923790">തിരയൽ ഏരിയയുടെ മുകളിലെ വലത് മൂല: വലതുഭാഗത്ത് <ph name="RIGHT"/>%, മുകളിൽ <ph name="TOP"/>%</translation>
<translation id="120745000989996104">നിങ്ങളുടെ അക്കൗണ്ടിലെ Browther ഡാറ്റ</translation>
<translation id="3369405342922656244">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ പേജ് തിരയുക</translation>
<translation id="7173761126541905083">നിങ്ങളുടെ ഫോണിലെ Browther-ൽ നിങ്ങളുടെ പാസ്‌വേഡുകൾ ഉപയോഗിക്കുക</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">നിലവിലുള്ള Browther പ്രൊഫൈലിലേക്ക് മാറണോ?</translation>
<translation id="3412460710772753638">ഈ ഉപകരണത്തിലെ Password Manager-ൽ</translation>
<translation id="4282363917570905631">നിങ്ങളുടെ ഫോണിലെ Browther ഉപയോഗിച്ച് മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് പ്രയോജനപ്പെടുത്തൂ</translation>
<translation id="986094398735583155">നിങ്ങൾക്ക് അനുയോജ്യമായ രീതിയിൽ Browther സജ്ജീകരിക്കുക...</translation>
<translation id="3266047225484320321">അപഹരിക്കപ്പെട്ട പാസ്‌വേഡ് ഉപയോഗിച്ച് നിങ്ങൾ സൈൻ ഇൻ ചെയ്യുമ്പോൾ Browther നിങ്ങളെ അറിയിക്കും</translation>
<translation id="3508047337876211050">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും <ph name="ITEMS_COUNT"/> ഇനങ്ങൾ ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി Browther-ത്തിൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> എന്നതിന് Browther പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
<translation id="7225005776233199285">എല്ലാ Browther വിൻഡോകളും അടച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5465054931427475969">നിങ്ങളുടെ വിൻഡോ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ Browther-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/>, ഇതിനകം സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ട്.  നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, <ph name="USER_EMAIL_ADDRESS"/> എന്ന വിലാസത്തിൽ നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈലിൽ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8133590217245064579">നിങ്ങളുടെ സ്‌ക്രീൻ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണത്തിൽ Browther-നായി സ്‌ക്രീൻ റെക്കോർഡിംഗ് അനുവദിക്കുക.</translation>
<translation id="3597003331831379823">പ്രത്യേക പ്രിവിലേജുകൾ ആവശ്യമുള്ള സജ്ജീകരണം റൺ ചെയ്യാനായില്ല. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Browther-ൽ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="2492221622209669678">ഈ ഉപകരണത്തിൽ നിന്ന് ഈ വ്യക്തിയുടെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കും. ഡാറ്റ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നതായി Browther-ത്തിലേക്ക് സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="6793778233257855801"><ph name="ORIGIN"/> എന്നതിൽ നിന്ന് നിങ്ങളുടെ Android ഫോണിലേക്ക് ഒരു നമ്പർ അയയ്‌ക്കാൻ, രണ്ട് ഉപകരണങ്ങളിൽ നിന്നും Browther-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="3667616615096815454">ഇൻസ്റ്റാൾ ചെയ്യാനാകുന്നില്ല, സെർവറിന് ഈ ആപ്പ് പരിചിതമല്ല.</translation>
<translation id="5585500151754164442">നിങ്ങളുടെ <ph name="BEGIN_LINK"/>സ്വന്തം പാസ്ഫ്രെയ്‌സ്<ph name="END_LINK"/> ഉപയോഗിച്ച് Browther sync chain-ലെ എല്ലാ Browther ഡാറ്റയും എൻക്രിപ്റ്റ് ചെയ്യുക. Google Pay-യിൽ നിന്നുള്ള പേയ്‌മെന്റ് രീതികളും വിലാസങ്ങളും എൻക്രിപ്റ്റ് ചെയ്യില്ല. Browther-ൽ നിന്നുള്ള ബ്രൗസിംഗ് ചരിത്രം സമന്വയിപ്പിക്കില്ല.</translation>
<translation id="404323216042159951">Browther-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവില്ല. നിങ്ങളുടെ ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിക്കുക.</translation>
<translation id="5004936474632127765">Browther അദൃശ്യ വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="6236643159256182256">വ്യക്തിപരമാക്കലിനും മറ്റ് ആവശ്യങ്ങൾക്കുമായി Browther-ഉം മറ്റ് Browther സേവനങ്ങളും ലിങ്ക് ചെയ്യുക</translation>
<translation id="3729187154190517324">"ടാബും മറ്റും ചേർക്കുക" ബട്ടൺ ഉപയോഗിച്ച് ഒന്നിലധികം ടാബുകളും ഫയലുകളും ടൂളുകളും ചേർത്ത് നിങ്ങളുടെ തിരയലിന്റെ വ്യാപ്‌തി വർദ്ധിപ്പിക്കുക.</translation>
<translation id="1400697664933775238">Browther പ്രൊഫൈലുകൾ മാനേജ് ചെയ്യുക</translation>
<translation id="2461315395128103158">ചില ഡൗൺലോഡുകൾ Browther ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="8058420662026104226">നിങ്ങളുടെ അവലോകനം ആവശ്യമുള്ള എന്തെങ്കിലും ഉണ്ടെങ്കിൽ Browther നിങ്ങളെ അറിയിക്കും</translation>
<translation id="3177448557921912221">നിങ്ങളുടെ ജീവിതത്തിന്റെ വ്യത്യസ്ത ഭാഗങ്ങൾ വേർതിരിക്കാൻ Browther പ്രൊഫൈലുകൾ സഹായിക്കുന്നു. ഇപ്പോൾ ഒരു പുതിയ പ്രൊഫൈൽ ചേർക്കുക.</translation>
<translation id="1541177876035612043">നിങ്ങൾ സന്ദർശിക്കാനിടയുള്ള പേജുകൾ Browther മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു, ഇതുവഴി നിങ്ങൾ ആ പേജുകൾ സന്ദർശിക്കുമ്പോൾ അവ അതിവേഗം ലോഡ് ചെയ്യും</translation>
<translation id="3810973564298564668">നിയന്ത്രിക്കൂ</translation>
<translation id="1117103475254549453">സംരക്ഷിച്ച പാസ്‌വേഡുകൾ ഉപയോഗിക്കാൻ, QR കോഡ് ഉപയോഗിച്ച്, iOS-നുള്ള Browther ഡൗൺലോഡ് ചെയ്‌ത ശേഷം നിങ്ങളുടെ Browther sync chain-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="8880695882192156860">Browther നുറുങ്ങ്: മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ്</translation>
<translation id="3846683726093018685">**സംഗ്രഹിക്കുക:** 30 വാക്കുകൾക്കുള്ളിൽ ഒറ്റ വാചകത്തിൽ, സ്‌ക്രീൻഷോട്ടിലെ ഉള്ളടക്കത്തിന്റെ പ്രാഥമിക വിഷയവും ലക്ഷ്യവും വിവരിക്കുക.

          **ചോദ്യങ്ങൾ നിർദ്ദേശിക്കുക:** സ്‌ക്രീൻഷോട്ട് മനസ്സിലാക്കുന്നതിന് ഉപയോക്താവ് ചോദിക്കാനിടയുള്ള, ചിന്ദോദ്ദീപകമായ 3-5 ചോദ്യങ്ങൾ അടങ്ങുന്ന ബുള്ളറ്റ് ചെയ്ത ഒരു ലിസ്റ്റ് ജനറേറ്റ് ചെയ്യുക. വിഷ്വൽ ഒബ്‌ജക്റ്റിനെ കുറിച്ചോ അതിന്റെ ഡിസൈനിനെ കുറിച്ചോ പ്ലേസ്‌മെന്റിനെ കുറിച്ചോ ഉള്ള ഒരു ചോദ്യമെങ്കിലും ഈ ചോദ്യങ്ങളിൽ ഉണ്ടായിരിക്കണം.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> - Browther Origin</translation>
<translation id="3885770153807205175">ഭാഷാ പിക്കർ</translation>
<translation id="4861846616763552424">Browther ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക. എന്തോ ഒന്നിന് നിങ്ങളുടെ ശ്രദ്ധ വേണം -വിശദാംശങ്ങൾക്ക് ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="6126366281251241386">Browther തുറന്ന് ബ്രൗസിംഗ് ആരംഭിക്കാൻ നിങ്ങളുടെ പേരിൽ ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="3892148308691398805">ടെക്‌സ്‌റ്റ് പകർത്തുക</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> ഇതിനകം ഈ Browther പ്രൊഫൈലിലേക്ക് സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു. നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, Browther-ന് നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈൽ സൃഷ്‌ടിക്കാനാകും.</translation>
<translation id="3821553157234855663">നിങ്ങളുടെ Browther ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="3941890832296813527">ഇൻസ്റ്റാൾ ചെയ്യുന്നതിൽ പിശക്: ഇൻസ്റ്റാളർ ഫയൽ നാമം അസാധുവാണ് അല്ലെങ്കിൽ പിന്തുണയില്ല.</translation>
<translation id="6482299900191767005">പാസ്‌വേഡുകൾ പകർത്താൻ Browther ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="5853011008278898603">Browther sync chain-ൽ സംരക്ഷിച്ചിരിക്കുന്ന നിങ്ങളുടെ പാസ്‌വേഡുകൾ, പേയ്‌മെന്റ് രീതികൾ, വിലാസങ്ങൾ എന്നിവ ഈ ഉപകരണത്തിൽ നിന്ന് നീക്കം ചെയ്യും. Browther-ൽ അവ വീണ്ടും ഉപയോഗിക്കാൻ, വീണ്ടും സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="395904275706073188">പരിരക്ഷിത പേജുകൾ വായിക്കാനാകില്ല. മറ്റൊരു പേജ് പരീക്ഷിക്കുക.</translation>
<translation id="1832973663231751701">Browther നിങ്ങളെ എങ്ങനെ സുരക്ഷിതരായി സൂക്ഷിക്കുന്നുവെന്ന് അറിയുക</translation>
<translation id="4531502594774670767">നിങ്ങൾ വിലാസ ബാറിലോ സെർച്ച് ബോക്സിലോ ടൈപ്പ് ചെയ്യുമ്പോൾ, നിർദ്ദേശങ്ങൾ ലഭിക്കുന്നതിന് Browther നിങ്ങളുടെ സ്ഥാപനത്തിന്റെ തിരയൽ, AI, ഏജന്റ് ടൂളുകളിലേക്ക് നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്നത് അയയ്ക്കുന്നു.</translation>
<translation id="300013383485253006">&amp;Browther for Testing-നെക്കുറിച്ച്</translation>
<translation id="1152920704813762236">ChromeOS-നെ കുറിച്ച്</translation>
<translation id="8126752030994997015">നിങ്ങൾ ഒരു സൈറ്റ് സന്ദർശിക്കുമ്പോൾ, നിങ്ങളുടെ IP വിലാസം മറയ്ക്കുന്ന ഒരു സ്വകാര്യതാ സെർവർ വഴി, URL-ന്റെ സ്‌പഷ്‌ടമല്ലാത്ത ഭാഗം <ph name="BEGIN_LINK"/>Browther സുരക്ഷിത ബ്രൗസിംഗിലേക്ക്<ph name="END_LINK"/> Browther അയയ്ക്കുന്നു. ഒരു സൈറ്റ് സംശയാസ്പദമായ എന്തെങ്കിലും ചെയ്താൽ, മുഴുവൻ URL-കളും പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകളും അയയ്ക്കും.</translation>
<translation id="3703994572283698466">ChromeOS സാധ്യമാക്കിയത് <ph name="BEGIN_LINK_LINUX_OSS"/>Linux വികസന പരിതസ്ഥിതി<ph name="END_LINK_LINUX_OSS"/> പോലുള്ള അധിക <ph name="BEGIN_LINK_CROS_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_CROS_OSS"/> ഉപയോഗിച്ചാണ്.</translation>
<translation id="4022972681110646219">സ്‌ക്രീൻ വിവർത്തനം ചെയ്യുക</translation>
<translation id="4023601594785368013">ഒറിജിനൽ ഭാഷ: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">ഏത് ആപ്പിൽ നിന്നും Browther-ൽ ലിങ്കുകൾ തുറക്കുക. കൂടാതെ എളുപ്പത്തിലുള്ള ആക്‌സസിനായി, അത് നിങ്ങളുടെ ടാസ്‌ക്‌ബാറിൽ പിൻ ചെയ്യും.</translation>
<translation id="3437506136408403836"><ph name="BEGIN_LINK"/>നിലവിലെ ക്രമീകരണം<ph name="END_LINK"/> റിപ്പോർട്ട് ചെയ്‌തുകൊണ്ട് Browther മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="4050175100176540509">ഏറ്റവും പുതിയ പതിപ്പിൽ പ്രധാനപ്പെട്ട സുരക്ഷാ മെച്ചപ്പെടുത്തലുകളും പുതിയ ഫീച്ചറുകളും ലഭ്യമാണ്.</translation>
<translation id="4055805654398742145">P&amp;assword Manager</translation>
<translation id="2164947358785939495">നിങ്ങളുടെ കമ്പ്യൂട്ടറിലെ മറ്റൊരു പ്രോഗ്രാം, Browther പ്രവർത്തിക്കുന്ന രീതി മാറ്റിയേക്കാവുന്ന ഒരു വിപുലീകരണം ചേർത്തു.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{ഒരു മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ Browther അടയ്‌ക്കും. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.}other{# മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ Browther അടയ്‌ക്കും. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.}}</translation>
<translation id="1535413545339990419">'Browther-ത്തെ കുറിച്ച്' പേജിലേക്ക് പോകുക</translation>
<translation id="692283249649018289">നിങ്ങളുടെ ബ്രൗസറിന് പുതിയ രൂപം നൽകാൻ Browther ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="6375229634133804834">നിങ്ങളുടെ Browther ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="4148957013307229264">ഇന്‍സ്റ്റാളുചെയ്യുന്നു...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - Browther</translation>
<translation id="2911246138082876798">Browther-നായി മികച്ച അപ്ലിക്കേഷനുകളും വിപുലീകരണങ്ങളും തീമുകളും കണ്ടെത്തുക.</translation>
<translation id="2528977475313334293">ഈ വിപുലീകരണവും മറ്റും നിങ്ങളുടെ എല്ലാ കമ്പ്യൂട്ടറുകളിലും ലഭിക്കാൻ, Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="8244267655940711467">നിങ്ങളുടെ രക്ഷിതാക്കളുടെ ചോയ്‌സുകൾ ഉപയോഗിച്ച് ഓൺലൈനിൽ സുരക്ഷിതരായിരിക്കാൻ, <ph name="USER_EMAIL_ADDRESS"/> ആയി ഇതിനകം സൈൻ ഇൻ ചെയ്ത നിങ്ങളുടെ Browther പ്രൊഫൈലിലേക്ക് മാറുക</translation>
<translation id="4222932583846282852">റദ്ദാക്കുന്നു...</translation>
<translation id="4224210481850767180">ഇൻസ്റ്റാൾ ചെയ്യുന്നത് റദ്ദാക്കി.</translation>
<translation id="8219359042845534271">നിങ്ങളുടെ Browther ഡാറ്റ ഈ അക്കൗണ്ടുമായി ലിങ്ക് ചെയ്യണോ?</translation>
<translation id="5520777668172961882">സ്റ്റാൻഡേർഡ് പരിരക്ഷയ്‌ക്ക് പുറമെ, സൈറ്റുകളിൽ നിന്നുള്ള കൂടുതൽ ഡാറ്റ വിശകലനം ചെയ്യുന്നതിലൂടെ, Browther-ന് മുമ്പ് അറിയാത്തവ ഉൾപ്പെടെയുള്ള അപകടകരമായ സൈറ്റുകളെക്കുറിച്ച് മുന്നറിയിപ്പ് നൽകുന്നു. നിങ്ങൾക്ക് Browther മുന്നറിയിപ്പുകൾ ഒഴിവാക്കാൻ തീരുമാനിക്കാം.</translation>
<translation id="2014920019837536689">Browther-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="4341512411059715879">Browther ഉപയോഗിക്കുന്നതിനുള്ള സഹായം തേടുക</translation>
<translation id="4281844954008187215">സേവന നിബന്ധനകൾ</translation>
<translation id="322492684764924424">അവ്യക്തമായ പിശകിനാൽ ഇൻസ്റ്റാൾ ചെയ്യൽ പരാജയപ്പെട്ടു. Browther നിലവിൽ പ്രവർത്തിക്കുന്നുണ്ടെങ്കിൽ, അത് അടച്ചതിനുശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="3813060261346666066">Browther-ൽ നിന്ന് പാസ്‌വേഡുകൾ എക്‌സ്പോർട്ട് ചെയ്യുക</translation>
<translation id="4304713468139749426">പാസ്‌വേഡ് മാനേജർ</translation>
<translation id="4334241893986177674">ഈ സ്ക്രീൻഷോട്ട് തിരയുക</translation>
<translation id="4334294535648607276">ഡൗൺലോഡ് പൂർത്തിയായി.</translation>
<translation id="2177954934431828302">Windows ആരംഭിക്കുമ്പോൾ Browther ലോഞ്ച് ചെയ്യുക</translation>
<translation id="2472318668926455009">Browther നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറായി സജ്ജീകരിച്ച് നിങ്ങൾക്ക് അറിയാവുന്നതും ഇഷ്ടമുള്ളതും നിങ്ങൾ വിശ്വസിക്കുന്നതുമായ ഫീച്ചറുകളിലേക്ക് എളുപ്പത്തിൽ ആക്‌സസ് നേടുക. അതിവേഗ ആക്‌സസിനായി Browther നിങ്ങളുടെ ടാസ്‌ക്‌ബാറിലേക്ക് പിൻ ചെയ്യും.</translation>
<translation id="1068681683510904753">ഈ ഉപകരണം ഉപയോഗിക്കുന്നതിന് മുമ്പ് ഇനിപ്പറയുന്ന സേവന നിബന്ധനകൾ നിങ്ങൾ വായിച്ച് അംഗീകരിക്കണമെന്ന് <ph name="MANAGER"/> ആവശ്യപ്പെടുന്നു. ഈ നിബന്ധനകൾ ChromeOS നിബന്ധനകൾ വിപുലീകരിക്കുകയോ പരിഷ്‌കരിക്കുകയോ പരിമിതപ്പെടുത്തുകയോ ചെയ്യുന്നില്ല.</translation>
<translation id="2897580280700805340">എന്തായാലും Browther-ത്തിൽ നിന്ന് പുറത്തുകടക്കണോ?</translation>
<translation id="4413205837991854510">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ കുറുക്കുവഴി എല്ലായ്‌പ്പോഴും കാണിക്കുക</translation>
<translation id="2454897022983434851">Browther-ത്തെ പശ്ചാത്തലത്തിൽ പ്രവർത്തിക്കാൻ അനുവദിക്കുക</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് Browther നിർദ്ദേശിക്കുന്നു. <ph name="BEGIN_LINK"/>പിന്തുണയ്ക്കുന്ന വിപുലീകരണങ്ങളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/>}other{നിങ്ങൾ അവ നീക്കം ചെയ്യാൻ Browther നിർദ്ദേശിക്കുന്നു. <ph name="BEGIN_LINK"/>പിന്തുണയ്ക്കുന്ന വിപുലീകരണങ്ങളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Browther ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക</translation>
<translation id="4427306783828095590">ഫിഷിംഗും മാല്‍വെയറും ബ്ലോക്ക് ചെയ്യുന്നതിന് മെച്ചപ്പെടുത്തിയ പരിരക്ഷ കൂടുതൽ കാര്യങ്ങൾ ചെയ്യുന്നു</translation>
<translation id="4434353761996769206">ഇൻസ്റ്റാളർ പിശക്: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/>, Browther മാനേജ് ചെയ്യുന്നു</translation>
<translation id="4007482010626246887">Browther പ്രൊഫൈൽ ചേർക്കുക</translation>
<translation id="6888322430074420631">Browther for Testing-നെക്കുറിച്ച്</translation>
<translation id="8912436499620582668">നിങ്ങളുടെ Browther sync chain-ൽ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും പാസ്‌ഫ്രെയ്‌സ് നൽകുക</translation>
<translation id="4493028449971051158">സ്റ്റാർട്ടപ്പിലെ പിശക്: അഡ്‌മിൻ എന്ന നിലവിൽ ഇൻസ്റ്റാളർ റൺ ചെയ്യുക.</translation>
<translation id="4501471624619070934">ഈ രാജ്യത്ത് ആക്സസ് നിയന്ത്രിച്ചിരിക്കുന്നതിനാല്‍‌ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="8976207309012239417">ഡാറ്റ ശേഖരിക്കുന്നതും ഉപയോഗിക്കുന്നതും എങ്ങനെയെന്നത് പോലുള്ള സ്വകാര്യതാ വ്യവസ്ഥകൾ ഈ വിപുലീകരണം പ്രസിദ്ധീകരിച്ചിട്ടില്ല. നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് Browther നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="8888202093812883067">Browther Origin-ലേക്ക് സ്വാഗതം; പുതിയ ബ്രൗസർ വിൻഡോ തുറന്നു</translation>
<translation id="6391148383688605718">നിങ്ങളുടെ ചുറ്റുപാടുകൾ മാപ്പ് ചെയ്യാനും കൈകൾ ട്രാക്ക് ചെയ്യാനും Browther-ന് അനുമതി ആവശ്യമാണ്</translation>
<translation id="7756445485815468244">നിങ്ങൾ മറ്റൊരു Browther പ്രൊഫൈലിൽ <ph name="USER_EMAIL_ADDRESS"/> ആയി നിലവിൽ സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു</translation>
<translation id="137435413163730206">ബ്രൗസ് ചെയ്യലും തിരയലും വേഗത്തിലാക്കുന്നതിന്, പേജുകൾ Browther മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു. <ph name="BEGIN_LINK"/>മുൻകൂട്ടി ലോഡ് ചെയ്ത പേജുകളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">ഹാനികരമാണെന്ന് നിങ്ങൾ കരുതുന്ന ഒരു സൈറ്റ് റിപ്പോർട്ട് ചെയ്യുമ്പോൾ എല്ലാവർക്കുമായി ഓൺലൈൻ സുരക്ഷ മെച്ചപ്പെടുത്തുക.</translation>
<translation id="3266647901351304597">നിങ്ങൾ സുരക്ഷിത ബ്രൗസിംഗ് ഓഫാക്കിയതിനാലും ഫയൽ പരിശോധിച്ചുറപ്പിക്കാൻ കഴിയാത്തതിനാലും Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="6980208900390333646">നിങ്ങളുടെ ഫോണിൽ Browther-ലൂടെ Google Lens പരീക്ഷിക്കൂ</translation>
<translation id="4594305310729380060">ഈ ഉപകരണത്തിലെ Password Manager-ലേക്ക്</translation>
<translation id="5282047884678321451">Browther Origin അപ്ലിക്കേഷനുകൾ</translation>
<translation id="4598116752460667024">ലിസ്റ്റിൽ നിന്നുള്ള ഏതെങ്കിലും പ്രോസസിനായി തിരയുക.</translation>
<translation id="4970880042055371251">ChromeOS പതിപ്പ്</translation>
<translation id="4482468019601425607">എകദേശം അപ്‌‌ടുഡേറ്റാണ്! അപ്‌ഡേറ്റുചെയ്യൽ പൂർത്തിയാക്കാൻ Browther വീണ്ടും ആരംഭിക്കുക.</translation>
<translation id="5517890123509214766">Browther-ന്റെ V8 എഞ്ചിൻ ഉപയോഗിച്ച് സൈറ്റുകളുടെ വേഗത കൂട്ടുന്നു, എന്നാൽ ആക്രമണങ്ങൾക്കെതിരായി Browther-ന്റെ പ്രതിരോധം അൽപ്പം കുറയ്ക്കുന്നു</translation>
<translation id="7690070364551268156">നിങ്ങൾ Browther ഉപയോഗ റിപ്പോർട്ടുകളും പങ്കിടുന്നുവെങ്കിൽ, ആ റിപ്പോർട്ടുകളിൽ നിങ്ങൾ സന്ദർശിക്കുന്ന URL-കളും ഉൾപ്പെടും</translation>
<translation id="5020487088453637212">മറ്റൊരു കമ്പ്യൂട്ടറിൽ (<ph name="HOST_NAME"/>) മറ്റൊരു Browther പ്രോസസ് (<ph name="PROCESS_ID"/>) പ്രൊഫൈൽ ഉപയോഗിക്കുന്നതുപോലെ തോന്നുന്നു. Browther പ്രൊഫൈൽ ലോക്കുചെയ്‌തതിനാൽ ഇത് കേടാകുകയില്ല. മറ്റ് പ്രോസസുകളൊന്നും ഈ പ്രൊഫൈൽ ഉപയോഗിക്കുന്നില്ലെന്ന് ഉറപ്പാണെങ്കിൽ നിങ്ങൾക്ക് പ്രൊഫൈൽ അൺലോക്ക് ചെയ്‌ത് Browther വീണ്ടും സമാരംഭിക്കാം.</translation>
<translation id="4680828127924988555">ഇൻസ്റ്റാൾ ചെയ്യൽ റദ്ദാക്കുക</translation>
<translation id="8134827615154347946">നിങ്ങളുടെ Browther ഡാറ്റയിൽ ചിലത് ഇതുവരെ നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിച്ചിട്ടില്ല. സൈൻ ഔട്ട് ചെയ്യുന്നതിന് മുമ്പ് അൽപ്പസമയം കാത്തിരിക്കുക. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ ഈ ഡാറ്റ ഇല്ലാതാക്കും.</translation>
<translation id="3508712423420506333">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിരിക്കുമ്പോൾ, Browther-ൽ നിങ്ങളുടെ Browther sync chain-ൽ നിന്നുള്ള പാസ്‌വേഡുകളും മറ്റും ഉപയോഗിക്കാനാകും. <ph name="SHORTCUT"/> എന്നതിന് നിങ്ങളുടെ Browther സേവനങ്ങൾ ക്രമീകരണം മാറ്റാനാകും.</translation>
<translation id="2388739442635757494">ഈ കമ്പ്യൂട്ടറിലെ Browther-ത്തിൽ മുമ്പ് മറ്റാരോ <ph name="ACCOUNT_EMAIL_LAST"/> എന്നയാളായി സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നു. നിങ്ങളുടെ വിവരങ്ങൾ പ്രത്യേകം വേർതിരിച്ച് സൂക്ഷിക്കാൻ പുതിയ Browther ഉപയോക്താവിനെ സൃഷ്‌ടിക്കുക.</translation>
<translation id="4724676981607797757">പിന്തുണയ്ക്കാത്ത പ്രോട്ടോക്കോൾ പിശക് കാരണം ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടു.</translation>
<translation id="8305313684264112434">എന്തായാലും Browther-ത്തിൽ നിന്ന് പുറത്തുകടക്കണോ?</translation>
<translation id="418155915144835101">Browther-നുള്ള ഒരു പ്രത്യേക സുരക്ഷാ അപ്‌ഡേറ്റ് പ്രയോഗിച്ചിരിക്കുന്നു. ഇപ്പോൾ റീസ്‌റ്റാർട്ട് ചെയ്യുക, ഞങ്ങൾ നിങ്ങളുടെ ടാബുകൾ പുനഃസ്ഥാപിക്കും.</translation>
<translation id="2683970367518529374">Browther-നോട് ചോദിക്കുക</translation>
<translation id="5064473048847774331">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> എന്നിവയും മറ്റ് <ph name="COUNT"/> അനുമതികളും Browther നീക്കം ചെയ്തു.</translation>
<translation id="5941343075741207533">Browther-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. 24 മണിക്കൂറിന് ശേഷം വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കിൽ <ph name="BEGIN_LINK"/>നിങ്ങളുടെ Browther അക്കൗണ്ടിലെ പാസ്‌വേഡുകൾ പരിശോധിക്കുക<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">Browther തിരയലിൽ ഉപയോഗിക്കുന്ന അതേ സ്പെൽ ചെക്കർ ഇത് ഉപയോഗിക്കുന്നു. ബ്രൗസറിൽ നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്ന ടെക്‌സ്‌റ്റ് Browther-ന് അയയ്ക്കുന്നു. ക്രമീകരണത്തിൽ എപ്പോഴും ഈ രീതി മാറ്റാനാകും.</translation>
<translation id="4581078588976787792">അക്കൗണ്ട് ഇല്ലാതെ Browther ഉപയോഗിക്കുക</translation>
<translation id="3394520491703535051">mDNS ട്രാഫിക്ക് അനുവദിക്കാൻ Browther Origin-നുള്ള ഇൻബൗണ്ട് നയം.</translation>
<translation id="6563126962881169552">&amp;Browther അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="4918086044614829423">സ്വീകരിക്കുക</translation>
<translation id="4918844574251943176">ചിത്രം പകർത്തി</translation>
<translation id="5240982928057703861">Browther പശ്ചാത്തല മോഡിലാണ്.</translation>
<translation id="3603134280602182991">Browther സൈൻ ഇൻ ഡയലോഗ് അടയ്ക്കാൻ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="6120233890602288442">Browther പ്രൊഫൈലുകൾ ഉപയോഗിച്ച് നിങ്ങളുടെ എല്ലാ Browther ഉള്ളടക്കവും വേർതിരിക്കാം. സുഹൃത്തുക്കൾക്കും കുടുംബത്തിനും വ്യത്യസ്‌ത പ്രൊഫൈലുകൾ സൃഷ്‌ടിക്കുക അല്ലെങ്കിൽ ജോലികാര്യങ്ങളും വിനോദവും പ്രത്യേകമായി തരംതിരിക്കുക.</translation>
<translation id="5722688387568011881">അതിഥികൾക്ക് ഒന്നും ശേഷിപ്പിക്കാതെ തന്നെ Browther ഉപയോഗിക്കാനാകും.</translation>
<translation id="7786958592460743302">Browther-ലെ നിങ്ങളുടെ അക്കൗണ്ട്</translation>
<translation id="9114640791491590337">Browther-ലേക്ക് സ്വയം ചേരുക</translation>
<translation id="3536391594566515053">നിങ്ങളുടെ ടാബുകളിൽ പ്രവർത്തിക്കാനും നിങ്ങൾ നൽകുന്ന ടാസ്ക്കുകൾ പൂർത്തിയാക്കാനും Browther-ലെ Gemini ഓട്ടോ ബ്രൗസ് ഉപയോഗിക്കുന്നു. <ph name="LINK_BEGIN"/>കൂടുതലറിയുക<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">നിങ്ങളുടെ കൈകൾ ട്രാക്ക് ചെയ്യാൻ Browther-ന് അനുമതി ആവശ്യമാണ്</translation>
<translation id="1627123463102858476">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/> എന്നീ അനുമതികൾ Browther നീക്കം ചെയ്തു.</translation>
<translation id="5174969993834422967">നിങ്ങൾ സാധാരണയായി അറിയിപ്പുകൾ ബ്ലോക്ക് ചെയ്യാറുണ്ട്. നിങ്ങൾക്ക് അറിയിപ്പ് അയയ്ക്കുന്നതിന് ഈ സൈറ്റിനെ അനുവദിക്കാൻ, നിങ്ങളുടെ ലൊക്കേഷൻ ബാറിന്റെ വലത് മൂലയിലെ അറിയിപ്പ് ഐക്കൺ ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="5174983315706567306">മതിയായ ഡിസ്‌ക് സ്പെയ്‌സ് ഇല്ല.</translation>
<translation id="7091313576354542088">Browther അക്കൗണ്ട് വീണ്ടും പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്</translation>
<translation id="9045390598305758496">സംരക്ഷിച്ച പാസ്‌വേഡുകളൊന്നുമില്ല. നിങ്ങളുടെ പാസ്‌വേഡുകൾ സംരക്ഷിക്കുകയാണങ്കിൽ, Browther-ന് അവ പരിശോധിക്കാനാവും.</translation>
<translation id="5686724084351858452">Browther-ത്തിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യുക</translation>
<translation id="5234764350956374838">ഡിസ്മിസ്സ് ചെയ്യുക</translation>
<translation id="5254739261293693943">ഈ വീഡിയോയെ കുറിച്ച് ചോദിക്കുക</translation>
<translation id="8165028066129227692">നിങ്ങളുടെ മാറ്റങ്ങൾ ബാധകമാക്കാൻ Browther സമാരംഭിക്കുക</translation>
<translation id="5286907366254680517">തിരിച്ചറിഞ്ഞു</translation>
<translation id="198210130507193824">Browther ആപ്പ് നേടുക</translation>
<translation id="8472078903122489041">Browther അപ്ഡേറ്റർ ഇന്റേണൽ സേവനം</translation>
<translation id="5346389065299425353">ഒന്നിലധികം ടാബുകളും ഫയലുകളും ടൂളുകളും ചേർത്ത് നിങ്ങളുടെ തിരയലിന്റെ വ്യാപ്‌തി വർദ്ധിപ്പിക്കുക</translation>
<translation id="3904682305383981098">നിങ്ങളുടെ അവലോകനത്തിനായി Browther ചില സുരക്ഷാ നിർദ്ദേശങ്ങൾ കണ്ടെത്തി</translation>
<translation id="509616246140011182">മറ്റ് Browther പ്രൊഫൈലുകൾ</translation>
<translation id="8214429210535362385">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിന് നിങ്ങളുടെ Browther പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള Browther ഡാറ്റ <ph name="USER_NAME"/> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. Browther അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാനാകുമെങ്കിലും, ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">അധിക കോഡ്: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">വ്യക്തിപരമാക്കൽ ലഭിക്കാൻ, വെബ്, ആപ്പ് ആക്റ്റിവിറ്റിയിൽ Browther ഉൾപ്പെടുത്തുക</translation>
<translation id="8096544113811780871">ചില ഫയലുകൾ Browther ബ്ലോക്ക് ചെയ്യുന്നത് എന്തുകൊണ്ടാണെന്ന് അറിയുക</translation>
<translation id="2384387444932590174">Browther അപ്‌ഡേറ്റ് ചെയ്യുന്നു, (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ അനുവദിക്കുക</translation>
<translation id="6557334704331248411">Browther-ൽ നിന്ന് നീക്കംചെയ്യുക</translation>
<translation id="5832041381258620673">പ്രകടനം കുറയ്ക്കുന്നു, എന്നാൽ ആക്രമണങ്ങൾക്കെതിരായി Browther-ന്റെ പ്രതിരോധം വളരെയധികം വർദ്ധിപ്പിക്കുന്നു</translation>
<translation id="3763317028635993788">നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറായി Browther സജ്ജമാക്കുക</translation>
<translation id="862357563072119126"><ph name="PAGE_TITLE"/> - Browther Origin ബീറ്റ</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{നിങ്ങളുടെ ബ്രൗസറിന്റെ വേഗത കുറയ്ക്കുന്ന ടാബ് താൽക്കാലികമായി നിർത്താൻ Browther നിർദ്ദേശിക്കുന്നു}other{നിങ്ങളുടെ ബ്രൗസറിന്റെ വേഗത കുറയ്ക്കുന്ന ടാബുകൾ താൽക്കാലികമായി നിർത്താൻ Browther നിർദ്ദേശിക്കുന്നു}}</translation>
<translation id="4423621904097888155">ഈ Linux വിതരണത്തിൽ ഇനി പിന്തുണയില്ലാത്തതിനാൽ Browther ശരിയായി പ്രവർത്തിച്ചേക്കില്ല</translation>
<translation id="6201726364919996698">നിങ്ങളുടെ വ്യക്തിഗത അക്കൗണ്ടുകൾക്കും സോഷ്യൽ നെറ്റ്‌വർക്ക് അക്കൗണ്ടുകൾക്കും ഫയൽ ദോഷകരമായേക്കാം എന്നതിനാൽ Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="7679204468655335605">Browther-ത്തിന് ഈ സൈറ്റുമായി ലൊക്കേഷൻ പങ്കിടുന്നതിന് നിങ്ങളുടെ ലൊക്കേഷനിലേക്കുള്ള ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="1163572992704966942">Browther ഏറ്റവും പുതിയ സിസ്‌റ്റം അപ്‌ഡേറ്റുകൾ ഇൻസ്റ്റാളുചെയ്യുന്നതുവരെ കാത്തിരിക്കുക.</translation>
<translation id="5050118226119231029">പാസ്‌വേഡുകൾ എഡിറ്റ് ചെയ്യാൻ Browther ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് ടൈപ്പ് ചെയ്യുക.</translation>
<translation id="5524890928877629608">തിരയൽ ഏരിയയുടെ മുകളിലെ ഇടത് മൂല: ഇടതുഭാഗത്ത് <ph name="LEFT"/>%, മുകളിൽ <ph name="TOP"/>%</translation>
<translation id="5875549039106594731">Browther-ൽ PDF-കൾ തുറക്കുക</translation>
<translation id="5536164441519929134">ഈ ടാബിനെ<ph name="LINE_BREAK"/>കുറിച്ച് ചോദിക്കുക</translation>
<translation id="5579324208890605088">സ്റ്റാർട്ടപ്പിലെ പിശക്: അഡ്‌മിൻ എന്ന നിലയിലല്ലാതെ, ഒരു സാധാരണ ഉപയോക്താവായി ഇൻസ്റ്റാളർ റൺ ചെയ്യുക.</translation>
<translation id="202315329304302571">Browther ഡിഫോൾട്ടായി ഉപയോഗിക്കുക, അത് പിൻ ചെയ്യുക</translation>
<translation id="5596627076506792578">കൂടുതൽ‍ ഓപ്‌ഷനുകൾ</translation>
<translation id="5605834417512968703">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് തിരയാൻ എന്തെങ്കിലും തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ ചിത്രമുപയോഗിച്ചുള്ള തിരയലിൽ നിന്ന് പുറത്ത് കടക്കാൻ 'Escape' അമർത്തുക</translation>
<translation id="5618818588972826921">'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് തിരയാൻ എന്തെങ്കിലും ടെക്സ്റ്റോ ചിത്രമോ തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ 'ചിത്രമുപയോഗിച്ചുള്ള തിരയലിൽ' നിന്ന് പുറത്തുകടക്കാൻ Escape അമർത്തുക</translation>
<translation id="5823076755666406442">{0,plural, =0{Browther-ത്തിനൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}=1{Browther-ത്തിനൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}other{# ദിവസമായി Browther-ത്തിനൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}}</translation>
<translation id="8414129876440043675">Browther അടയ്‌ക്കുമ്പോഴെല്ലാം നിങ്ങളുടെ ഉപകരണത്തിൽ നിന്ന് സൈറ്റ് ഡാറ്റ ഇല്ലാതാക്കുക</translation>
<translation id="5156991567152325333">Browther ഇപ്പോൾ റീസ്‌റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="5710072384986281834">Browther LLC</translation>
<translation id="1536693367017293028">ഈ ഭാഷയിൽ Browther പ്രദർശിപ്പിക്കുക</translation>
<translation id="569897634095159764">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. പ്രോക്സി സെർവറിന് പരിശോധിച്ചുറപ്പിക്കൽ ആവശ്യമാണ്.</translation>
<translation id="4215338057953170891">വ്യക്തിപരമായ ബ്രൗസിംഗും ജോലിയും വേർതിരിച്ച് നിർത്താൻ Browther പ്രൊഫൈലുകൾ നിങ്ങളെ അനുവദിക്കുന്നു. ഇപ്പോൾ ഒരു പുതിയ പ്രൊഫൈൽ ചേർക്കുക.</translation>
<translation id="5366435608642317052">നിഷ്ക്രിയമായ ടാബുകളിൽ നിന്നുള്ള മെമ്മറി Browther മായ്ക്കുന്നു. ഇത് സജീവമായ ടാബുകൾക്കും മറ്റ് ആപ്പുകൾക്കും കൂടുതൽ കമ്പ്യൂട്ടർ റിസോഴ്‌സുകൾ നൽകുകയും Browther-ന്റെ വേഗത നിലനിർത്തുകയും ചെയ്യുന്നു. നിഷ്ക്രിയമായ ടാബുകളിലേക്ക് നിങ്ങൾ മടങ്ങുമ്പോൾ അവ സ്വയമേവ വീണ്ടും സജീവമാകും. <ph name="BEGIN_LINK"/>മെമ്മറി സേവറിനെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/></translation>
<translation id="4941518395341035738">നിങ്ങൾ പാസ്‌ഫ്രെയ്‌സ് മറന്നുപോയെങ്കിലോ ഈ ക്രമീകരണം മാറ്റണമെന്നുണ്ടെങ്കിലോ, നിങ്ങളുടെ അക്കൗണ്ടിലെ Browther ഡാറ്റ <ph name="SETTINGS_LINK"/></translation>
<translation id="7763291835437810978">Browther ഇഷ്‌ടാനുസൃതമാക്കുകയും നിയന്ത്രിക്കുകയും ചെയ്യൂ. Browther ഡിഫോൾട്ടായി സജ്ജീകരിക്കുക.</translation>
<translation id="5809516625706423866">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. HTTP 401 അംഗീകൃതമല്ല. നിങ്ങളുടെ പ്രോക്‌സി കോൺഫിഗറേഷൻ പരിശോധിക്കുക.</translation>
<translation id="1827132270895283425">Browther-ന്റെ V8 എഞ്ചിൻ ഉപയോഗിച്ച് സൈറ്റുകളുടെ വേഗത കൂട്ടുന്നു, എന്നാൽ ആക്രമണങ്ങൾക്കെതിരായി Browther-ന്റെ പ്രതിരോധം അൽപ്പം കുറയ്ക്കുന്നു. ഈ ക്രമീകരണം ഓഫാണ്.</translation>
<translation id="1553025851718680114">നിങ്ങളുടെ Browther sync chain-ലെ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും, Browther അപ്ഡേറ്റ് ചെയ്യുക</translation>
<translation id="5824893331272123205">ഈ പേജ് ലോഡ് ചെയ്യാനായില്ല, വീണ്ടും ശ്രമിക്കുക</translation>
<translation id="6642862349634944253">Browther Origin-ത്തിലേക്ക് സ്വാഗതം</translation>
<translation id="5871205389137001634">ചിത്രമുപയോഗിച്ചുള്ള തിരയലിൽ നിന്ന് പുറത്ത് കടക്കാൻ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="7586794330537887406">ഈ ഇനങ്ങളിൽ മാൽവെയർ അടങ്ങുന്നതായി Browther കണ്ടെത്തി:</translation>
<translation id="1666897346518812892">നിങ്ങളുടെ ബ്രൗസറിന് ഏറ്റവും സുരക്ഷിതമായ ക്രമീകരണമാണുള്ളതെന്ന് ഉറപ്പാക്കാൻ Browther പതിവായി പരിശോധിക്കുന്നു. നിങ്ങളുടെ അവലോകനം ആവശ്യമുള്ള എന്തെങ്കിലും ഉണ്ടെങ്കിൽ ഞങ്ങൾ നിങ്ങളെ അറിയിക്കും.</translation>
<translation id="5895138241574237353">പുനരാരംഭിക്കുക</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ</translation>
<translation id="5924017743176219022">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യുന്നു...</translation>
<translation id="5941711191222866238">ചെറുതാക്കുക</translation>
<translation id="4938357262936377412">ഈ ബുക്ക്‌മാർക്കും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും നേടാൻ, Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="260974496993853147">Browther നിങ്ങൾക്ക് അനുയോജ്യമാക്കൂ</translation>
<translation id="5960071705175224773">ഒരു അജ്ഞാത ആപ്പ് നിങ്ങളുടെ ക്രമീകരണം മാറ്റി</translation>
<translation id="5968400720580217226">AI മോഡ്</translation>
<translation id="8697015289720079159">{COUNT,plural, =1{ഒരു മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ Browther അടയ്‌ക്കും.}other{# മിനിറ്റ് ഉപയോഗിക്കാതിരുന്നാൽ നിങ്ങളുടെ സ്ഥാപനം സ്വയമേവ Browther അടയ്‌ക്കും.}}</translation>
<translation id="5852664780493076676">സമന്വയിപ്പിക്കാൻ തുടങ്ങുന്നതിന് Browther അപ്‌ഡേറ്റ് ചെയ്യുക</translation>
<translation id="6003112304606738118">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="HOURS"/> മണിക്കൂർ ശേഷിക്കുന്നു</translation>
<translation id="6009821354356307391">ഫോളോ അപ്പ് ആവശ്യപ്പെടുക</translation>
<translation id="6040143037577758943">അടയ്ക്കുക</translation>
<translation id="2495504229007749358">നിങ്ങളുടെ ഡാറ്റ പരിരക്ഷിക്കുന്നതിന്, അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ലാത്ത സൈറ്റുകളിൽ നിന്നുള്ള അനുമതികൾ നീക്കം ചെയ്യാൻ Browther-നെ അനുവദിക്കുക. അറിയിപ്പുകൾ നിർത്തുന്നില്ല.</translation>
<translation id="6038969823662006832">&amp;Browther-ത്തിൽ തുറക്കുക</translation>
<translation id="6069027071882229820">ചിത്രം ആയി പകർത്തുക</translation>
<translation id="6606690217326148454"><ph name="EXTENSION_NAME"/> Browther-ത്തിലേക്ക് ചേർത്തു</translation>
<translation id="6037324269860323082">Browther ഇഷ്ടാനുസൃതമാക്കി നിയന്ത്രിക്കുക. അപ്‌ഡേറ്റ് ലഭ്യമാണ്.</translation>
<translation id="3695768481578778794">ഓണാണ് • ഈ വിപുലീകരണം എവിടെ നിന്നാണ് വരുന്നതെന്ന് Browther-ന് പരിശോധിച്ചുറപ്പിക്കാനാകില്ല</translation>
<translation id="4401885752362736126">Browther-ലെ നിങ്ങളുടെ അക്കൗണ്ട്</translation>
<translation id="4310817187912076496">Browther ടൂൾബാറിൽ ആക്‌സസ് അഭ്യർത്ഥനകൾ കാണിക്കാൻ വിപുലീകരണം അനുവദിക്കുക</translation>
<translation id="4602490888173698813"><ph name="FILE_NAME"/> അപകടകരമായതിനാൽ, Browther ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="5139243417751674628">ഉടൻ തന്നെ Browther അടയ്‌ക്കുകയും ഡാറ്റ ഇല്ലാതാക്കുകയും ചെയ്യും</translation>
<translation id="4696750309605389299">നിങ്ങൾക്ക് ഇവിടെ Browther പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
<translation id="7475001351099358916">നിങ്ങൾ കുക്കികൾ അനുവദിച്ചാൽ, മുൻകൂട്ടി ലോഡ് ചെയ്യുമ്പോൾ Browther അവ ഉപയോഗിച്ചേക്കാം</translation>
<translation id="6165508094623778733">കൂടുതലറിയുക</translation>
<translation id="5975099973700540482">നിങ്ങളുടെ അക്കൗണ്ടിലെ Browther ഡാറ്റ മായ്ക്കുക</translation>
<translation id="6800151735486681860">ഈ ഫയൽ അപകടകരമായേക്കാം<ph name="LINE_BREAK"/>നിങ്ങൾ പാസ്‌വേഡ് നൽകിയാൽ Browther-ന് നിങ്ങൾക്കായി ഈ ഡൗൺലോഡ് പരിശോധിക്കാൻ കഴിയും. ഫയലിനെ സംബന്ധിച്ച വിവരങ്ങൾ Browther സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് അയയ്‌ക്കും, എന്നാൽ ഫയലിന്റെ ഉള്ളടക്കവും പാസ്‌വേഡും നിങ്ങളുടെ ഉപകരണത്തിൽ തന്നെ നിലനിൽക്കും.</translation>
<translation id="6182736845697986886">അപ്‌ഡേറ്റ് സെർവർ ആന്തരിക പിശക് കാരണം ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടു.</translation>
<translation id="48832130233362517">നിങ്ങൾ <ph name="TARGET_DEVICE_NAME"/> ഉപകരണത്തിൽ Browther-ലാണ് സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നതെന്ന് ഉറപ്പാക്കുക, തുടർന്ന് വീണ്ടും അയയ്‌ക്കാൻ ശ്രമിക്കുക.</translation>
<translation id="8868210753005945522">നിങ്ങളുടെ കമ്പ്യൂട്ടറിലെ മറ്റൊരു പ്രോഗ്രാം, Browther പ്രവർത്തിക്കുന്ന രീതി മാറ്റിയേക്കാവുന്ന ഒരു ആപ്പ് ചേർത്തു.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">Browther-ത്തിന്റെ ഏറ്റവും പുതിയ പതിപ്പ് ഈ കമ്പ്യൂട്ടറില്‍ ഇപ്പോൾ തന്നെയുണ്ട്. സോഫ്റ്റ്‌വെയര്‍ പ്രവര്‍ത്തിക്കുന്നില്ലെങ്കില്‍, Browther അൺഇൻസ്റ്റാൾ ചെയ്‌ത് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="9222998061982994203">{0,plural, =0{Browther ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കും}=1{ഒരു സെക്കൻഡിൽ Browther വീണ്ടും സമാരംഭിക്കും}other{# സെക്കൻഡിൽ Browther വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="6239161312595354541">ഈ വീഡിയോയെ കുറിച്ച് ചിത്രമുപയോഗിച്ചുള്ള തിരയലിനോട് ചോദിക്കുക</translation>
<translation id="1755464917870815989">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ Browther-ന് സ്റ്റോറേജ് ആക്‌സസ് അനുമതി ആവശ്യമാണ്</translation>
<translation id="304681001513922736">Browther-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു</translation>
<translation id="7785903492969539081">Browther ഡിഫോൾട്ട് ബ്രൗസറാക്കൂ</translation>
<translation id="3987833816263696343">Browther-ത്തിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യണോ?</translation>
<translation id="4723540739671534529">ഈ ടാബുകൾ അധിക വിഭവങ്ങൾ ഉപയോഗിക്കുന്നു. നിങ്ങളുടെ പ്രകടനം മെച്ചപ്പെടുത്താനായി അവ നിഷ്ക്രിയമാക്കാൻ Browther-നെ അനുവദിക്കുക.</translation>
<translation id="6540151687468239291">നിങ്ങളുടെ Browther പ്രൊഫൈൽ ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="770793114032605647">നിങ്ങളുടെ Browther പ്രൊഫൈലിന് പേര് നൽകുക</translation>
<translation id="385867753870250529">Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഒരു വിപുലീകരണം നിങ്ങളോട് ആവശ്യപ്പെടുന്നു</translation>
<translation id="2022337046348377650"><ph name="FILE_NAME"/> അപകടകരമാകാൻ ഇടയുള്ളതിനാൽ, Browther ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="45270956603278068">Browther നിങ്ങളുടെ ക്യാമറ ഉപയോഗിക്കുന്നു.</translation>
<translation id="6327105987658262776">അപ്ഡേറ്റ് ലഭ്യമല്ല.</translation>
<translation id="673633752219771459">Browther-ത്തിൽ മറ്റൊരു പ്രവർത്തനം പുരോഗമിക്കുകയാണ്. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="1482759407165416070">ഇപ്പോൾ നിങ്ങളുടെ Browther sync chain ഉപയോഗിച്ച്, പങ്കിട്ട കമ്പ്യൂട്ടറുകളിൽ Browther ഉപയോഗിക്കാൻ എളുപ്പമാണ്.</translation>
<translation id="5538042432112726532">Browther കുറുക്കുവഴി</translation>
<translation id="833085228901080512">ഈ ഫയൽ സാധാരണയായി ഡൗൺലോഡ് ചെയ്യാത്തതിനാലും ഇത് അപകടകരമായേക്കാം എന്നതിനാലും Browther ഈ ഡൗൺലോഡ് ബ്ലോക്ക് ചെയ്തു</translation>
<translation id="491120842288314439">Browther അൺഇൻസ്റ്റാൾ ചെയ്യാൻ നിങ്ങൾ താൽപ്പര്യപ്പെടുന്നുവെന്ന് തീർച്ചയാണോ?</translation>
<translation id="6375219077595103062">Password Manager-ലേക്ക് ഒരു കുറുക്കുവഴി ചേർക്കുക</translation>
<translation id="6388799252195623474">ഇക്കാര്യത്തിൽ എന്നെ സഹായിക്കൂ</translation>
<translation id="6715003312952407375">തുടരുന്നതിന്, Browther-ലേക്ക് <ph name="EMAIL"/> എന്നതായി സൈൻ ഇൻ ചെയ്യുക. നിങ്ങളുടെ ഓർഗനൈസേഷന്റെ നയങ്ങൾ നിങ്ങൾക്ക് ലഭിച്ചിട്ടുണ്ടെന്ന് ഇത് ഉറപ്പാക്കുന്നു.</translation>
<translation id="1897845318651970239">ഒരു കമ്പ്യൂട്ടർ സ്ക്രീനിനുള്ളിലെ Browther ലോഗോ.</translation>
<translation id="4702069255970029302">മിന്നൽ വേഗത്തിൽ വെബ്‌ പേജുകളും ആപ്പുകളും പ്രവർത്തിപ്പിക്കുന്ന ഒരു വെബ് ബ്രൗസറാണ് Browther Origin. ഇത് വേഗതയുള്ളതും സ്ഥിരതയാർന്നതും ഉപയോഗിക്കാൻ എളുപ്പമുള്ളതുമാണ്. Browther Origin-ൽ അന്തർനിർമ്മിതമായ മാൽവെയർ, ഫിഷിംഗ് എന്നിവയ്‌ക്കെതിരായുള്ള പരിരക്ഷയോടൊപ്പം കൂടുതൽ സുരക്ഷിതമായി വെബ് ബ്രൗസ് ചെയ്യുക.</translation>
<translation id="5669767676913031391">Browther വേഗത്തിൽ റൺ ചെയ്യുകയും JavaScript ഉപയോഗിക്കുന്ന ഫീച്ചറുകൾ ഡിസൈൻ ചെയ്തിരിക്കുന്നത് പോലെ പ്രവർത്തിക്കുകയും വേണം</translation>
<translation id="6436260184216827876">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ലഭ്യമല്ല. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="2139300032719313227">ChromeOS റീസ്റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="6110616900529884221">നിങ്ങൾ സന്ദർശിക്കാനിടയുള്ള കൂടുതൽ പേജുകൾ Browther മുൻകൂട്ടി ലോഡ് ചെയ്യുന്നു, ഇതുവഴി നിങ്ങൾ ആ പേജുകൾ സന്ദർശിക്കുമ്പോൾ അവ അതിവേഗം ലോഡ് ചെയ്യും</translation>
<translation id="1217194059001819677">നിരക്കുകൾ ട്രാക്ക് ചെയ്യാനും ഏതെങ്കിലും സൈറ്റിൽ നിരക്ക് കുറയുമ്പോൾ അറിയിപ്പുകൾ നേടാനും നിങ്ങളുടെ ഫോണിൽ Browther ഡൗൺലോഡ് ചെയ്യുക</translation>
<translation id="7058555680120557198">ഓഫാണ് • ഈ വിപുലീകരണം എവിടെ നിന്നാണ് വരുന്നതെന്ന് Browther-ന് പരിശോധിച്ചുറപ്പിക്കാനാകില്ല</translation>
<translation id="676533642429632127">Browther പ്രൊഫൈലുകളിലേക്ക് സ്വാഗതം</translation>
<translation id="5518682889576009702">അടുത്ത തവണ <ph name="DEVICE_TYPE"/> എന്നതിൽ Browther തുറക്കുമ്പോൾ, ടാബ് ഗ്രൂപ്പുകൾ ഉപയോഗിക്കാനുള്ള ഒരു പ്രോംപ്റ്റ് നിങ്ങൾ കാണും.</translation>
<translation id="6038105561107837619">Browther-ൽ നിന്ന് അക്കൗണ്ട് നീക്കം ചെയ്യുക</translation>
<translation id="2675662665675552980">നിങ്ങൾ Browther ആരംഭിക്കുമ്പോൾ ദൃശ്യമാകുന്ന പേജും അത് നിയന്ത്രിയ്ക്കും.</translation>
<translation id="648319183876919572">അപകടകരമായ വെബ്‌സൈറ്റുകളിൽ നിന്നും ഡൗൺലോഡുകളിൽ നിന്നും നിങ്ങളെ പരിരക്ഷിക്കാൻ മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് കൂടുതൽ കാര്യങ്ങൾ ചെയ്യുന്നു</translation>
<translation id="2930243146591999795">Browther അൺഇൻസ്റ്റാൾ ചെയ്യുക</translation>
<translation id="5241183382286817629">Browther-ൽ കുറുക്കുവഴികൾ തുറക്കൽ</translation>
<translation id="7907014599435829661"><ph name="TIMEOUT_DURATION"/> ഉപയോഗിച്ചില്ലെങ്കിൽ നിങ്ങളുടെ സ്ഥാപനം Browther ഡാറ്റ അടയ്ക്കുന്നു. ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാക്കി. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.</translation>
<translation id="2088471423667794811">ഓരോ പ്രൊഫൈലും ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ എന്നിവയും മറ്റും പോലുള്ള അതിന്റെ സ്വന്തം Browther വിവരങ്ങൾ സൂക്ഷിക്കുന്നു</translation>
<translation id="9040334484455218184"><ph name="BEGIN_LINK"/>Browther നിങ്ങളുടെ ഡാറ്റ എങ്ങനെ സ്വകാര്യമായി നിലനിർത്തുന്നു<ph name="END_LINK"/> എന്നതിനെക്കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="1718697235867382480">Browther റീസ്റ്റാർട്ട് ചെയ്തുകഴിഞ്ഞാൽ, ഈ ക്രമീകരണത്തിലെ മാറ്റങ്ങൾ ബാധകമാക്കും.</translation>
<translation id="6331317152404762758">നിങ്ങൾക്ക് മറ്റൊരു Browther പ്രൊഫൈലിൽ നിന്നുള്ള പാസ്‌വേഡുകൾ കാണാൻ പ്രൊഫൈൽ മാറ്റാം</translation>
<translation id="6097706403184348562">അക്ഷരപ്പിശകുകൾ പരിഹരിക്കാൻ, ടെക്‌സ്‌റ്റ് ഫീൽഡുകളിൽ നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്ന ടെക്‌സ്‌റ്റ് Browther, Browther-ന് അയയ്ക്കുന്നു</translation>
<translation id="2319647238307402812">Browther അറിയിപ്പ് ക്രമീകരണത്തിലേക്ക് പോവുക</translation>
<translation id="6600016381025017075">ഈ പേജിൽ എന്തും തിരയുക</translation>
<translation id="8031938899816118394">നിങ്ങളുടെ മാറ്റങ്ങൾ അടുത്ത തവണ Browther വീണ്ടും ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.</translation>
<translation id="7412185356697187964">Windows ആരംഭിക്കുമ്പോൾ Browther ഇപ്പോൾ ലോഞ്ച് ചെയ്യുന്നതിനാൽ നിങ്ങൾക്ക് തൽക്ഷണം ബ്രൗസ് ചെയ്യാൻ ആരംഭിക്കാം. നിങ്ങൾക്ക് ഇത് ക്രമീകരണത്തിൽ ഓഫാക്കാം.</translation>
<translation id="9123343592576384616">നിങ്ങൾ നിർത്തിയ ഇടത്ത് നിന്ന് തുടരൂ: നിങ്ങളുടെ അവസാനത്തെ സെഷനിൽ നിന്നുള്ള ടാബുകൾ Browther പുനഃസ്ഥാപിച്ചു. ഇനിപ്പറയുന്നതിൽ നിങ്ങൾക്ക് ഇത് ഓഫാക്കാം</translation>
<translation id="5847926498049048567">നിങ്ങളുടെ ചുറ്റുപാടുകളുടെ 3D മാപ്പ് സൃഷ്‌ടിക്കാൻ Browther-ന് ക്യാമറാ അനുമതി ആവശ്യമാണ്</translation>
<translation id="5532585028508811858">ബുക്ക്‌മാർക്കുകൾ നിങ്ങളുടെ Browther sync chain-ലും സംരക്ഷിക്കുകയാണെങ്കിൽ, Browther-ൽ ഉൽപ്പന്ന വിലകൾ ട്രാക്ക് ചെയ്യാനും അവയുടെ വില കുറയുമ്പോൾ അറിയിപ്പ് നേടാനുമാകും</translation>
<translation id="6676384891291319759">ഇന്റര്‍‌നെറ്റ് ആക്‌സസ് ചെയ്യുക</translation>
<translation id="1363996462118479832">സൈൻ ഇൻ ചെയ്യുന്നതിലെ പിശക് മൂലം ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="3373239673945775810">Browther-ൽ നിന്ന് ഈ ആപ്പിന്റെ ഡാറ്റ നീക്കം ചെയ്യുക</translation>
<translation id="8122759674786039814">Browther, നിങ്ങൾ കാണുന്ന പരസ്യങ്ങളിൽ നിങ്ങൾക്ക് കൂടുതൽ നിയന്ത്രണം നൽകുകയും നിങ്ങളെ വ്യക്തിപരമാക്കിയ പരസ്യങ്ങൾ കാണിക്കുമ്പോൾ സൈറ്റുകൾക്ക് നിങ്ങളെക്കുറിച്ച് അറിയാൻ കഴിയുന്ന വിവരങ്ങൾ പരിമിതപ്പെടുത്തുകയും ചെയ്യുന്നു</translation>
<translation id="6277682530398500159">Browther-ന് ഈ സൈറ്റിനായി മൈക്രോഫോൺ അനുമതി ആവശ്യമാണ്</translation>
<translation id="6712881677154121168">ഡൗൺലോഡ് ചെയ്യുന്നതിൽ പിശക്: <ph name="DOWNLOAD_ERROR"/></translation>
<translation id="2972046656127603037">Browther-ന്റെ ഏറ്റവും പുതിയ ഒരു പതിപ്പിൽ നിന്നുള്ളതായതിനാൽ നിങ്ങളുടെ പ്രൊഫൈൽ ഉപയോഗിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമായേക്കില്ല. മറ്റൊരു പ്രൊഫൈൽ ഡയറക്‌ടറി വ്യക്തമാക്കുകയോ Browther-ന്റെ ഏറ്റവും പുതിയ പതിപ്പ് ഉപയോഗിക്കുകയോ ചെയ്യുക.</translation>
<translation id="871671753163165892">വ്യക്തിപരമാക്കലും മറ്റ് ഫീച്ചറുകളും ലഭിക്കാൻ, വെബ്, ആപ്പ് ആക്റ്റിവിറ്റിയിലും ലിങ്ക് ചെയ്‌ത Browther സേവനങ്ങളിലും Browther ഉൾപ്പെടുത്തുക</translation>
<translation id="5000832110229523807">നിങ്ങളുടെ കമ്പ്യൂട്ടറിലെ എല്ലാ ഉപയോക്താക്കൾക്കുമായി നിലവിൽ Browther ഇൻസ്റ്റാൾ ചെയ്‌തിട്ടുണ്ട്.</translation>
<translation id="5204575479550973859">ബുക്ക്‌മാർക്കുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. സൈൻ ഇൻ ചെയ്‌തുകഴിഞ്ഞാൽ ഈ ബുക്ക്‌മാർക്ക് നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിക്കും.</translation>
<translation id="2874208284092283937">Browther-ന്റെ V8 എഞ്ചിൻ ഉപയോഗിച്ച് സൈറ്റുകളുടെ വേഗത കൂട്ടുന്നു, എന്നാൽ ആക്രമണങ്ങൾക്കെതിരായി Browther-ന്റെ പ്രതിരോധം അൽപ്പം കുറയ്ക്കുന്നു. ഈ ക്രമീകരണം ഓണാണ്.</translation>
<translation id="3268577459683869744">{count,plural, =1{നിങ്ങളുടെ Browther ഡാറ്റയിൽ ചിലത് ഇതുവരെ നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിച്ചിട്ടില്ല. സൈൻ ഔട്ട് ചെയ്യുന്നതിന് മുമ്പ് അൽപ്പസമയം കാത്തിരിക്കുക. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ, ഈ ഡാറ്റ (1 ഇനം) ഇല്ലാതാക്കും.}other{നിങ്ങളുടെ Browther ഡാറ്റയിൽ ചിലത് ഇതുവരെ നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിച്ചിട്ടില്ല. സൈൻ ഔട്ട് ചെയ്യുന്നതിന് മുമ്പ് അൽപ്പസമയം കാത്തിരിക്കുക. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ ഈ ഡാറ്റ ({count} ഇനങ്ങൾ) ഇല്ലാതാക്കും.}}</translation>
<translation id="7683816018918395929">ഈ ഫയൽ അപകടകരമാകാൻ സാധ്യതയുള്ളതിനാൽ ഇത് സ്‌കാൻ ചെയ്യാൻ Browther നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="1547295885616600893">ChromeOS സാധ്യമാക്കിയത് അധിക <ph name="BEGIN_LINK_CROS_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയർ<ph name="END_LINK_CROS_OSS"/> ഉപയോഗിച്ചാണ്.</translation>
<translation id="6831043979455480757">വിവർത്തനം ചെയ്യുക</translation>
<translation id="2142653375108595728">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എപ്പോഴെങ്കിലും അപഹരിക്കപ്പെട്ടിട്ടുണ്ടെങ്കിൽ അക്കാര്യം Browther നിങ്ങളെ അറിയിക്കും</translation>
<translation id="684888714667046800">ഇന്റർനെറ്റിലേക്ക് കണക്റ്റ് ചെയ്യാനാകുന്നില്ല. നിങ്ങൾ ഫയർവാൾ ഉപയോഗിക്കുന്നുണ്ടെങ്കിൽ, <ph name="PRODUCT_EXE_NAME"/> വൈറ്റ്‌ലിസ്റ്റിൽ ഉണ്ടെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">തുടരാൻ ടാബ് ചെയ്യുക</translation>
<translation id="6862030660799253820">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിച്ച് ഈ ചിത്രം തിരയുക</translation>
<translation id="3860339351709082396">"<ph name="EXTENSION_NAME"/>" എന്നതിൽ മാൽ‌വെയർ അടങ്ങുന്നതായി Browther കണ്ടെത്തി</translation>
<translation id="6877155553248388166">തിരയൽ ഏരിയയുടെ താഴെയുള്ള വലത് മൂല: വലതുഭാഗത്ത് <ph name="RIGHT"/>%, താഴെ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">പകര്‍ത്തുക</translation>
<translation id="7804113502310231166">Browther നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറായി സജ്ജീകരിച്ച് അത് ടാസ്‌ക്ബാറിൽ പിൻ ചെയ്യുക</translation>
<translation id="3228374215117173004">&amp;Browther പ്രൊഫൈലുകൾ മാനേജ് ചെയ്യുക</translation>
<translation id="6934579572334859869">ഈ ചിത്രത്തെ കുറിച്ച് ചിത്രമുപയോഗിച്ചുള്ള തിരയലിനോട് ചോദിക്കുക</translation>
<translation id="5995328366516663808">നിങ്ങൾ <ph name="BOOKMARK_LIMIT"/> ബുക്ക്‌മാർക്കുകൾ എന്ന Browther-ന്റെ പരിധിയിലെത്തി, അതിനാൽ നിങ്ങളുടെ ചില ബുക്ക്‌മാർക്കുകൾ ഇതുവരെ Browther sync chain-ൽ സംരക്ഷിച്ചിട്ടില്ല.

ഏതാനും ബുക്ക്‌മാർക്കുകൾ ഇല്ലാതാക്കുന്നത് വരെ നിങ്ങളുടെ അക്കൗണ്ടിൽ പുതിയവ സംരക്ഷിക്കാനാകില്ല. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്യുകയാണെങ്കിൽ, സംരക്ഷിക്കാത്ത ബുക്ക്‌മാർക്കുകൾ ഇല്ലാതാകും.</translation>
<translation id="6965382102122355670">ശരി</translation>
<translation id="4533562834763015352">ദുർബലമായ പാസ്‌വേഡുകൾ ഊഹിക്കാൻ എളുപ്പമാണ്. <ph name="BEGIN_LINK"/>നിങ്ങൾക്കായി ശക്തമായ പാസ്‌വേഡുകൾ സൃഷ്ടിക്കാനും ഓർമ്മിക്കാനും<ph name="END_LINK"/> Browther-ത്തെ അനുവദിക്കുക.</translation>
<translation id="3453763134178591239">ChromeOS നിബന്ധനകൾ</translation>
<translation id="5379058926689137454">ഈ സൈറ്റിനായി, Browther-ത്തിന് നിങ്ങളുടെ മൈക്രോഫോൺ ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="4684462982894889021"><ph name="ACCOUNT_EMAIL"/> അക്കൗണ്ടിൽ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും നിങ്ങളുടെ പാസ്‌ഫ്രെയ്‌സ് നൽകുക</translation>
<translation id="7011190694940573312">ഓപ്പറേറ്റിംഗ് സിസ്റ്റത്തിന്റെ ഈ പതിപ്പ് പിന്തുണയ്ക്കാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="7024536598735240744">അൺപാക്ക് ചെയ്യുന്നതിൽ പിശക്: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ഇൻസ്റ്റാൾ ചെയ്യൽ നിർത്തി.</translation>
<translation id="8257174622576051374">Browther നിങ്ങളുടേതാക്കുക</translation>
<translation id="7047386856539490735">ഈ ഫലങ്ങൾ ഉപയോഗപ്രദമാണോ?</translation>
<translation id="1772745060691790742">Browther അപ്‌ഡേറ്റ് ചെയ്യുക</translation>
<translation id="4937970118065051027">ചിത്രത്തിൽ ഉപകാരപ്രദമായ വിവരണമില്ലെങ്കിൽ നിങ്ങൾക്കായി ഒരു വിവരണം നൽകാൻ Browther ശ്രമിക്കും. വിവരണങ്ങൾ സൃഷ്‌ടിക്കാൻ, ചിത്രങ്ങൾ Browther-ലേക്ക് അയയ്ക്കുന്നു.</translation>
<translation id="1594112132009288601">Browther for Testing ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="5915000938288527952">സന്ദേശങ്ങൾ, ഡോക്യുമെന്റുകൾ, മറ്റ് ആപ്പുകൾ എന്നിവയിലെ ലിങ്കുകളിൽ ക്ലിക്ക് ചെയ്യുമ്പോഴെല്ലാം നിങ്ങൾക്ക് Browther ഉപയോഗിക്കാം</translation>
<translation id="8775664994493381735">Browther-ൽ നിന്ന് <ph name="EXTENSION_NAME"/> നീക്കംചെയ്യുക</translation>
<translation id="3276648807841991013"><ph name="TIMEOUT_DURATION"/> ഉപയോഗിച്ചില്ലെങ്കിൽ നിങ്ങളുടെ സ്ഥാപനം Browther ഡാറ്റ ഇല്ലാതാക്കുന്നു. ഇതിൽ ബ്രൗസിംഗ് ചരിത്രവും സ്വയമേവ പൂരിപ്പിക്കൽ വിവരങ്ങളും ഡൗൺലോഡുകളും ഉൾപ്പെടും.</translation>
<translation id="4725226878394159809">Browther-ന് ഈ സൈറ്റിനായി ക്യാമറാ അനുമതി ആവശ്യമാണ്</translation>
<translation id="8931474625901592021">Browther ലോഞ്ച് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="8242947409070121799">Browther-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. 24 മണിക്കൂറിന് ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="1737922827960215472">എപ്പോൾ വേണമെങ്കിലും അതിവേഗം ലഭിക്കുന്നതിന്, Browther നിങ്ങളുടെ ഡോക്കിൽ നിലനിർത്തൂ</translation>
<translation id="335855266303176628">സന്ദേശങ്ങൾ, ഡോക്യുമെന്റുകൾ മറ്റ് ആപ്പുകൾ എന്നിവയിലെ ലിങ്കുകളിൽ ക്ലിക്ക് ചെയ്യുമ്പോഴെല്ലാം Browther ഉപയോഗിക്കുക</translation>
<translation id="709455597778444012">ടാസ്‌ക് മാനേജർ - Browther</translation>
<translation id="7147140345767587643">Browther-ന്റെ നിർണ്ണയം അനുസരിച്ചുള്ള നിങ്ങളുടെ താൽപ്പര്യങ്ങൾ</translation>
<translation id="7337408274890534789">തൽക്ഷണം ബ്രൗസ് ചെയ്യാൻ ആരംഭിക്കുക: Windows ആരംഭിക്കുമ്പോൾ ഇപ്പോൾ Browther ലോഞ്ച് ചെയ്യാനാകും.</translation>
<translation id="7274695763216404502">പിൻ ചെയ്‌തു! ടൂൾബാറിൽ നിന്ന് ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ വീണ്ടും ഉപയോഗിക്കുക</translation>
<translation id="7288567540154601580">ടാബുകളും വിപുലീകരണങ്ങളും</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{നിങ്ങൾ അത് നീക്കം ചെയ്യാൻ Browther നിർദ്ദേശിക്കുന്നു}other{നിങ്ങൾ അവ നീക്കം ചെയ്യാൻ Browther നിർദ്ദേശിക്കുന്നു}}</translation>
<translation id="1527644038571473502">സിസ്റ്റം ഓഡിയോ പങ്കിടാൻ, സിസ്റ്റം ക്രമീകരണം തുറന്ന് Browther-നായി 'സിസ്റ്റം ഓഡിയോ റെക്കോർഡിംഗ് മാത്രം' അനുവദിക്കുക. തുടർന്ന്, നിങ്ങൾ Browther റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="1427913074981060872">നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളെ അവയുടെ പരസ്യങ്ങളുടെ പ്രകടനം അളക്കാൻ സഹായിക്കുന്ന Browther-ൽ നിന്നുള്ള വിവരങ്ങൾ അഭ്യർത്ഥിക്കാൻ ആഡ് മെഷർമെന്റ് അനുവദിക്കുന്നു. സൈറ്റുകൾക്കിടയിൽ കഴിയുന്നത്ര കുറച്ച് വിവരങ്ങൾ കൈമാറുന്നതിലൂടെ ആഡ് മെഷർമെന്റ് ക്രോസ്-സൈറ്റ് ട്രാക്കിംഗ് നിയന്ത്രിക്കുന്നു.</translation>
<translation id="1657652725060525338">Browther അപ്‌ഡേറ്റ് ചെയ്യുന്നു</translation>
<translation id="884846289464870238">നിങ്ങളുടെ 'മുൻഗണനകൾ ഫയൽ' കേടായതാണ് അല്ലെങ്കിൽ അസാധുവാണ്.

നിങ്ങളുടെ ക്രമീകരണങ്ങൾ വീണ്ടെടുക്കാൻ Browther-ന് കഴിയില്ല.</translation>
<translation id="7339898014177206373">പുതിയ വിന്‍ഡോ</translation>
<translation id="633044855886370183">നിങ്ങളുടെ വെബ്, ബുക്ക്മാർക്കുകൾ,മറ്റ് Browther ഫയൽ എന്നിവ ഇവിടെ തത്സമയമാണ്.</translation>
<translation id="1185960088713242527">നിങ്ങളുടെ പാസ്ഫ്രെയ്‌സ് ഉള്ള ആളുകൾക്ക് മാത്രമേ, എൻക്രിപ്റ്റ് ചെയ്‌ത ഡാറ്റ വായിക്കാൻ കഴിയൂ. Browther-ലേക്ക് പാസ്ഫ്രെയ്‌സ് അയയ്ക്കുകയോ സംഭരിക്കുകയോ ചെയ്യുന്നില്ല. നിങ്ങൾ പാസ്‌ഫ്രെയ്‌സ് മറന്നുപോയെങ്കിലോ ഈ ക്രമീകരണം മാറ്റണമെന്നുണ്ടെങ്കിലോ, <ph name="BEGIN_LINK"/>നിങ്ങളുടെ അക്കൗണ്ടിലെ Browther ഡാറ്റ ഇല്ലാതാക്കേണ്ടതുണ്ട്<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110"><ph name="TARGET_URL_HOSTNAME"/> ആക്‌സസ് ചെയ്യാൻ <ph name="ALTERNATIVE_BROWSER_NAME"/> തുറക്കുന്നതിനായി നിങ്ങളുടെ സിസ്‌റ്റം അഡ്‌മിൻ Browther കോൺഫിഗർ ചെയ്‌തു.</translation>
<translation id="7352651011704765696">എന്തോ കുഴപ്പം സംഭവിച്ചു</translation>
<translation id="6638123710106659002">ഭാവിയിൽ Browther അപ്ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് macOS 13 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ macOS 12 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="7286289384512061761">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/> എന്നീ അനുമതികൾ Browther നീക്കം ചെയ്തു.</translation>
<translation id="113593073175678746">ഈ വിപുലീകരണം ഇനി പിന്തുണയ്ക്കില്ല. പകരം, നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് Browther നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="137615076640044304">നിങ്ങൾ നിർത്തിയ ഇടത്ത് നിന്ന് തുടരൂ: നിങ്ങൾ റീസ്റ്റാർട്ട് ചെയ്യുമ്പോഴെല്ലാം Browther നിങ്ങളുടെ ടാബുകൾ പുനഃസ്ഥാപിക്കുന്നു. ഇത് ഓഫാക്കാൻ, ഇനിപ്പറയുന്നതിലേക്ക് പോകുക</translation>
<translation id="5967238175620483220">Browther-ലേക്ക് പാസ്‌വേഡുകൾ ഇമ്പോർട്ട് ചെയ്യുക</translation>
<translation id="4935019315986703336"><ph name="PAGE_TITLE"/> - Browther Origin Dev</translation>
<translation id="7450541714075000668">ടെക്‌സ്റ്റ് പകർത്തി</translation>
<translation id="7766009218653304791">ഈ സൈറ്റിനായി, Browther-ത്തിന് നിങ്ങളുടെ ക്യാമറ ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="5844418066487488520">നിങ്ങളുടെ മൈക്രോഫോൺ ഉപയോഗിക്കാൻ, <ph name="BEGIN_LINK"/>സിസ്റ്റം ക്രമീകരണം<ph name="END_LINK"/> എന്നതിൽ Browther-ന് ആക്‌സസ് നൽകുക</translation>
<translation id="8065480549334161841">ഭാവിയിൽ Browther അപ്‌ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് Windows 10 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ Windows 7 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="6299293759264950896">Browther വീണ്ടും ആരംഭിക്കണോ?</translation>
<translation id="180908550381040105">നിലവിൽ പ്രവർത്തിച്ചുക്കൊണ്ടിരിക്കുന്ന Browther-ത്തിന്റെ സമാന പതിപ്പ് ഇൻസ്റ്റാൾ ചെയ്യാൻ കഴിയില്ല. Browther അവസാനിപ്പിച്ചതിന് ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="7625576878150380853">Browther-ൽ സൈൻ ഇൻ ചെയ്യുമ്പോൾ, നിങ്ങളുടെ Browther sync chain-ൽ പാസ്‌വേഡുകളും മറ്റും സംരക്ഷിക്കുകയും ഉപയോഗിക്കുകയും ചെയ്യും. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">സൈറ്റുകൾ പ്രതീക്ഷിച്ചത് പോലെ പ്രവർത്തിക്കും. Browther-ൽ സൈൻ ഇൻ ചെയ്‌തിട്ടുണ്ടെങ്കിൽ എല്ലാ Browther വിൻഡോകളും അടയ്ക്കുമ്പോൾ, നിങ്ങളുടെ Browther sync chain ഒഴികെ മിക്ക സൈറ്റുകളിൽ നിന്നും നിങ്ങൾ സൈൻ ഔട്ട് ആകും.</translation>
<translation id="7099370564362681943">{0,plural, =1{ഒരു മിനിറ്റിൽ Browther വീണ്ടും സമാരംഭിക്കും}other{# മിനിറ്റിൽ Browther വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="3602613943932672197">നിങ്ങളുടെ ഡാറ്റ പരിരക്ഷിക്കുന്നതിന്, അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ലാത്ത സൈറ്റുകളിൽ നിന്നുള്ള അനുമതികൾ നീക്കം ചെയ്യാൻ Browther-നെ അനുവദിക്കുക.</translation>
<translation id="8759568213742229377">തൽക്ഷണം ബ്രൗസ് ചെയ്യാൻ ആരംഭിക്കുന്നതിന് Browther സ്വയമേവ ലോഞ്ച് ചെയ്യുക.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ഇൻസ്റ്റാളർ</translation>
<translation id="8991800242749014880">Browther നിങ്ങളുടെ ക്യാമറയും മൈക്രോഫോണും ഉപയോഗിക്കുന്നു.</translation>
<translation id="2692328388439821508">Browther കൂടുതൽ മികച്ചതായി</translation>
<translation id="4318444066563223295">നിങ്ങൾക്ക് ഇപ്പോൾ Browther-ൽ കൂടുതൽ ഫീച്ചറുകൾ ലഭ്യമാണ്</translation>
<translation id="7649070708921625228">സഹായം</translation>
<translation id="5591287320769313116">നിങ്ങൾക്കായി ബ്രൗസ് ചെയ്യാൻ Browther-നെ അനുവദിക്കുക</translation>
<translation id="7658239707568436148">റദ്ദാക്കൂ</translation>
<translation id="6325482130534634729">Browther നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറല്ല</translation>
<translation id="8185915921134219287">നിങ്ങളുടെ ഉപകരണങ്ങളിലുടനീളം Browther സമന്വയിപ്പിച്ച് വ്യക്തിഗതമാക്കുക</translation>
<translation id="5120421624925726813">Browther അപ്‌ഡേറ്റ്</translation>
<translation id="7716950018788545737">ടാസ്‌ക്(കൾ) അവസാനിച്ചു.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/> എന്നതിനായി സിസ്റ്റം ട്രേസ് ചെയ്യൽ സേവനങ്ങൾ നൽകുന്നു. ഈ സേവനം പ്രവർത്തനരഹിതമാക്കിയാൽ, ബ്രൗസർ സൃഷ്‌ടിച്ച പ്രകടന ട്രെയ്‌സ് ചെയ്യലിൽ, സന്ദർഭ സ്വിച്ചും തയ്യാറായ ത്രെഡ് ഇവന്റുകളും പോലെ സിസ്‌റ്റത്തിലുടനീളമുള്ള ഇവന്റുകൾ ഉൾപ്പെടില്ല.</translation>
<translation id="6542096191573265107">ഇത് ഈ ഉപകരണത്തിൽ നിന്ന് നിങ്ങളുടെ ബ്രൗസിംഗ് വിവരങ്ങളെ ഇല്ലാതാക്കും. പിന്നീട് വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL"/> എന്നയാളായി Browther-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="7747138024166251722">ഇൻസ്റ്റാളറിന് താൽക്കാലിക ഡയറക്റ്ററി സൃഷ്‌ടിക്കാനായില്ല. ശൂന്യമായ ഡിസ്‍ക് സ്പെയിസും സോഫ്റ്റ്‌വെയർ ഇൻസ്റ്റാൾ ചെയ്യാനുള്ള അനുമതിയും പരിശോധിക്കുക.</translation>
<translation id="351575328720488268">ഡിഫോൾട്ട് Browther-ലേക്ക് റീസെറ്റ് ചെയ്യുക</translation>
<translation id="1054170408395182418">ഡിഫോൾട്ടായി Browther സജ്ജീകരിച്ച് ടാസ്‌ക്ബാറിൽ പിൻ ചെയ്യുക</translation>
<translation id="4569594230301902490">Browther കൂടുതൽ വേഗതയുള്ളതാക്കുക</translation>
<translation id="8041924294044943913"><ph name="PAGE_TITLE"/> - Browther Origin Canary</translation>
<translation id="7893465573639396635">നിങ്ങളുടെ ഇന്റർനെറ്റ് ട്രാഫിക്കിലേക്ക് ആക്സസുള്ള ആളുകൾക്ക് നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകൾ കാണുന്നത് പ്രയാസകരമാക്കും. DNS-ൽ (ഡൊമൈൻ നാമ സിസ്റ്റം) ഒരു സൈറ്റിന്റെ IP വിലാസം തിരയാൻ Browther ഒരു സുരക്ഷിത കണക്ഷൻ ഉപയോഗിക്കുന്നു.</translation>
<translation id="7810005234485217901">എളുപ്പത്തിൽ ആക്‌സസ് ചെയ്യാൻ നിങ്ങൾക്ക് ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ പിൻ ചെയ്യാം</translation>
<translation id="2462631024103158515">ഈ അക്കൗണ്ടുള്ള Browther പ്രൊഫൈൽ ഈ ഉപകരണത്തിൽ നിലവിലുണ്ട്</translation>
<translation id="7845233973568007926">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ കമ്പ്യൂട്ടർ റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="311190437086049332">Browther-ന് പുതിയ രൂപം നൽകാൻ അത് ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="6728847658878265103">ഏറ്റവും പുതിയ പതിപ്പിലേക്ക് Browther അപ്‌ഡേറ്റ് ചെയ്യാനായില്ല, അതിനാൽ പുതിയ ഫീച്ചറുകളും സുരക്ഷാ പരിഹാരങ്ങളും നിങ്ങൾക്ക് ലഭിക്കുന്നില്ല.</translation>
<translation id="7872446069773932638">ഡൗൺലോഡ് ചെയ്യുന്നു... <ph name="SECONDS"/> സെക്കൻഡ് ശേഷിക്കുന്നു</translation>
<translation id="5374532739787768601">നിങ്ങൾ പാസ്‌ഫ്രെയ്‌സ് മറന്നുപോയെങ്കിലോ ഈ ക്രമീകരണം മാറ്റണമെന്നുണ്ടെങ്കിലോ, <ph name="BEGIN_LINK"/>നിങ്ങളുടെ അക്കൗണ്ടിലെ Browther ഡാറ്റ ഇല്ലാതാക്കുക<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">ഈ ചിത്രത്തെക്കുറിച്ച് ചോദിക്കുക</translation>
<translation id="9172499982238113829">Browther ഡിഫോൾട്ട് ബ്രൗസറായി സജ്ജീകരിക്കുക</translation>
<translation id="3313826726620159669">സാധ്യമാകുമ്പോൾ, Browther, HTTPS-യിലേക്ക് സുരക്ഷിതമല്ലാത്ത കണക്ഷനുകൾ സ്വയമേവ അപ്‌ഗ്രേഡ് ചെയ്യുന്നു</translation>
<translation id="3317928686912559532">Browther-ൽ നിങ്ങൾ <ph name="USER_EMAIL_ADDRESS"/> എന്നായി സൈൻ ഇൻ ചെയ്‌തു. വീണ്ടും സൈൻ ഇൻ ചെയ്യുന്നതിന് സമാന അക്കൗണ്ട് ഉപയോഗിക്കുക.</translation>
<translation id="6007009085341946457">ഇത് Browther-ത്തിന്റെ ദ്വിതീയ ഇൻസ്‌റ്റലേഷനായതിനാൽ, നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാക്കാൻ കഴിയില്ല.</translation>
<translation id="8004582292198964060">ബ്രൗസര്‍</translation>
<translation id="8010081455002666927">സ്വയമേവ തിരിച്ചറിയുക</translation>
<translation id="174885789898161653">Browther-ത്തിന് ആക്‌സസ് ലഭിച്ചുകഴിഞ്ഞാൽ, വെബ്‌സൈറ്റുകൾക്ക് നിങ്ങളോട് ആക്‌സസ് ചോദിക്കാനാകും.</translation>
<translation id="3001754454174546602">എപ്പോൾ വേണമെങ്കിലും അതിവേഗം Browther ലഭിക്കാൻ, നിങ്ങളുടെ ടാസ്‌ക്‌ബാറിലേക്ക് അതിനെ പിൻ ചെയ്യുക</translation>
<translation id="80471789339884597">ഇൻസ്റ്റാൾ ചെയ്തതിന് നന്ദി. <ph name="BUNDLE_NAME"/> ഉപയോഗിക്കും മുമ്പ് നിങ്ങളുടെ എല്ലാ ബ്രൗസറുകളും റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="8054112667659782652">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ കുറുക്കുവഴി എല്ലായ്‌പ്പോഴും കാണിക്കുക</translation>
<translation id="6993312779622863465">ആപ്പുകൾക്കായി പശ്ചാത്തലത്തിൽ റൺ ചെയ്യുന്ന Browther പ്രവർത്തനരഹിതമാക്കുക</translation>
<translation id="80790299200510644">ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ</translation>
<translation id="8086881907087796310">നിങ്ങളുടെ കമ്പ്യൂട്ടർ ഏറ്റവും കുറഞ്ഞ ഹാർഡ്‌വെയർ ആവശ്യകതകൾ പാലിക്കാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യാനായില്ല.</translation>
<translation id="3217614128548917842"><ph name="PAGE_TITLE"/> - Browther Origin for Testing</translation>
<translation id="543407324609820492">Browther-ന് ഈ സൈറ്റിനായി ലൊക്കേഷൻ അനുമതി ആവശ്യമാണ്</translation>
<translation id="1767887552863788514">അടുത്ത തവണ <ph name="DEVICE_TYPE"/> എന്നതിൽ Browther തുറക്കുമ്പോൾ, നിരക്ക് ട്രാക്ക് ചെയ്യൽ അലേർട്ടുകൾ പ്രവർത്തനക്ഷമമാക്കാനുള്ള ഒരു പ്രോംപ്റ്റ് നിങ്ങൾ കാണും.</translation>
<translation id="8118331347066725040">Lens ഉപയോഗിച്ചുള്ള തിരയലിനുള്ള ഫീഡ്ബാക്ക് അയയ്‌ക്കുക</translation>
<translation id="5334309298019785904">നിങ്ങളുടെ ഡൊമെയ്‌നിൽ സമന്വയിപ്പിക്കൽ ലഭ്യമല്ലാത്തതിനാൽ ChromeOS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="813913629614996137">ആരംഭിക്കുന്നു...</translation>
<translation id="4879101934056397619">Browther അധിക സേവന നിബന്ധനകൾ</translation>
<translation id="4505690237431768764">ഈ ഫയൽ അപകടകരമായതിനാൽ Browther ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="8177472873527554730">പേജിൽ ഉള്ളടക്കം കണ്ടെത്താനാകുന്നില്ല</translation>
<translation id="4720341280133158605"><ph name="USER_EMAIL"/> അക്കൗണ്ടിൽ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും നിങ്ങളുടെ പാസ്‌ഫ്രെയ്‌സ് നൽകുക</translation>
<translation id="8221491193165283816">നിങ്ങൾ സാധാരണയായി അറിയിപ്പുകൾ ബ്ലോക്ക് ചെയ്യാറുണ്ട്. നിങ്ങൾക്ക് അറിയിപ്പ് അയയ്ക്കുന്നതിന് ഈ സൈറ്റിനെ അനുവദിക്കാൻ, ഇവിടെ ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="1083711467946065278">നിങ്ങളുടെ ക്യാമറ ഉപയോഗിക്കാൻ, <ph name="BEGIN_LINK"/>സിസ്റ്റം ക്രമീകരണം<ph name="END_LINK"/> എന്നതിൽ Browther-ന് ആക്‌സസ് നൽകുക</translation>
<translation id="6569785137733211804">ഈ വിപുലീകരണം എവിടെ നിന്നാണ് വരുന്നതെന്ന് Browther-ന് പരിശോധിച്ചുറപ്പിക്കാനാകില്ല, കൂടാതെ അത് സുരക്ഷിതമല്ലായിരിക്കാം. Browther-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="1122818205373648656">ചിത്രത്തിൽ ഉപകാരപ്രദമായ വിവരണമില്ലെങ്കിൽ നിങ്ങൾക്കായി ഒരു വിവരണം നൽകാൻ Browther ശ്രമിക്കും. വിവരണങ്ങൾ സൃഷ്‌ടിക്കാൻ, ചിത്രങ്ങൾ Browther-ലേക്ക് അയയ്ക്കുന്നു. ഏതുസമയത്തും ക്രമീകരണത്തിൽ നിങ്ങൾക്കിത് ഓഫാക്കാം.</translation>
<translation id="6877990294324319801">പുതിയൊരു പ്രൊഫൈലിൽ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യണോ?</translation>
<translation id="6478811748813986578">സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളെയും ഡൗൺലോഡുകളെയും കുറിച്ച് <ph name="BEGIN_LINK"/>Browther നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകുന്നു<ph name="END_LINK"/></translation>
<translation id="1685486387921540822">നിങ്ങൾ അടുത്തിടെ സന്ദർശിച്ചിട്ടില്ല. <ph name="PERMISSION"/> അനുമതി Browther നീക്കം ചെയ്തു.</translation>
<translation id="8921153410460268589">Browther iOS ആപ്പിലെ ക്യാമറ ഉപയോഗിച്ച് നിങ്ങൾ കാണുന്നത് ഷോപ്പ് ചെയ്യുക, വിവർത്തനം ചെയ്യുക, തിരിച്ചറിയുക</translation>
<translation id="8313851650939857356">സ്റ്റാർട്ടപ്പിലെ പിശക്: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534"><ph name="TIMEOUT_DURATION"/> ഉപയോഗിച്ചില്ലെങ്കിൽ നിങ്ങളുടെ സ്ഥാപനം Browther ഡാറ്റ അടയ്ക്കുന്നു.</translation>
<translation id="8321888067342493336">ചിത്രം ആയി സംരക്ഷിക്കുക</translation>
<translation id="143016831128278157">നിങ്ങളുടെ ഉപകരണങ്ങളിലുടനീളം Browther സമന്വയിപ്പിച്ച് വ്യക്തിഗതമാക്കാൻ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="4784945022248750283"><ph name="USER_EMAIL_ADDRESS"/> മുമ്പ് Browther ഉപയോഗിച്ചിട്ടുണ്ട്</translation>
<translation id="1288164710697017468">നിങ്ങളുടെ <ph name="ACCOUNT_EMAIL"/> എന്ന Browther sync chain-ൽ Browther ഡാറ്റ ഉപയോഗിക്കുന്നത് തുടരാൻ Browther അപ്‌ഡേറ്റ് ചെയ്യുക</translation>
<translation id="8648401677359150296">ഭാവിയിൽ Browther അപ്‌ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് Windows 10 അല്ലെങ്കിൽ അതിന് ശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ Windows 8 ആണ് ഉപയോഗിക്കുന്നത്.</translation>
<translation id="8362914115861174987">ഈ ഭാഷയിലേക്ക് വിവർത്തനം ചെയ്യുക</translation>
<translation id="8367705492654390392">എന്തും ചോദിക്കൂ</translation>
<translation id="5769022907892823357">പാസ്‌വേഡുകളും മറ്റും നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ലഭിക്കാൻ Browther-ലേക്ക് സൈൻ ഇൻ ചെയ്യുക. സൈൻ ഇൻ ചെയ്‌തുകഴിഞ്ഞാൽ ഈ പാസ്‌വേഡ് നിങ്ങളുടെ Browther sync chain-ൽ സംരക്ഷിക്കും.</translation>
<translation id="4782442810031768771">തുടർന്ന്, നിങ്ങൾ Browther റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="8265348385714408341">നിങ്ങൾ അത് നീക്കം ചെയ്യണമെന്ന് Browther നിർദ്ദേശിക്കുന്നു. <ph name="BEGIN_LINK"/>പിന്തുണയ്ക്കുന്ന വിപുലീകരണങ്ങളെ കുറിച്ച് കൂടുതലറിയുക<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">ഈ വിപുലീകരണം അതിന്റെ ഡെവലപ്പർ പ്രസിദ്ധീകരിച്ചത് റദ്ദാക്കി, ഇത് സുരക്ഷിതമല്ലായിരിക്കാം. Browther-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="1613655732912855341">നിങ്ങളുടെ Browther sync chain-ൽ ചില ഡാറ്റ സംരക്ഷിക്കുന്നതിനും അത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും ഉപയോഗിക്കുന്നതിനും മുമ്പ് ഇത് നിങ്ങൾ തന്നെയാണെന്ന് Browther-ന് പരിശോധിച്ചുറപ്പിക്കേണ്ടതുണ്ട്. നിങ്ങൾ ഇപ്പോൾ സൈൻ ഔട്ട് ചെയ്താൽ ഈ ഡാറ്റ ഇല്ലാതാക്കും.</translation>
<translation id="9103715009358215214">{0,plural, =1{ഒരു ദിവസത്തിനുള്ളിൽ Browther വീണ്ടും സമാരംഭിക്കുക}other{# ദിവസത്തിനുള്ളിൽ Browther വീണ്ടും സമാരംഭിക്കുക}}</translation>
<translation id="8438543370129609977">നിങ്ങൾ ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ ഉപയോഗിക്കുമ്പോൾ, പേജിന്റെ പേര്, URL, PDF-കൾ ഉൾപ്പെടെയുള്ള ഉള്ളടക്കം എന്നിവയെല്ലാം സെർവറിലേക്ക് അയയ്ക്കുന്നു. <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">Browther-ലെ 'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് തിരയുന്നതിനെ കുറിച്ച് കൂടുതലറിയുക</translation>
<translation id="1401757916223057494">ഇൻസ്റ്റാളർ ആർക്കൈവ് കേടായതാണ് അല്ലെങ്കിൽ അസാധുവാണ്. Browther വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="5029760494698649486">Browther-ത്തിന് Windows 10 അല്ലെങ്കിൽ അതിനുശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്.</translation>
<translation id="7906734902028783072">ഓപ്ഷണൽ: പ്രശ്നനിർണ്ണയ, ഉപയോഗ ഡാറ്റ സ്വയമേവ Browther-ന് അയച്ച് ChromeOS ഫീച്ചറുകളും പ്രകടനവും മെച്ചപ്പെടുത്താൻ സഹായിക്കുക.</translation>
<translation id="6791756730901393492">നിങ്ങളുടെ Browther sync chain-ലെ Browther ഡാറ്റ ഉപയോഗിക്കാനും സംരക്ഷിക്കാനും, ഇത് നിങ്ങൾ തന്നെയാണെന്ന് പരിശോധിച്ചുറപ്പിക്കുക</translation>
<translation id="4879869745782826167">Browther-ൽ സൈൻ ഇൻ ചെയ്യാനുള്ള നിർദ്ദേശങ്ങൾ കാണിക്കുന്നു</translation>
<translation id="2967761098021401720">Browther കാലഹരണപ്പെട്ടു</translation>
<translation id="7674832651694000881">നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറായി Browther തിരഞ്ഞെടുത്തതിന് നന്ദി!</translation>
<translation id="4507581730979762077">നിങ്ങളുടെ പാസ്‌വേഡുകൾ സംരക്ഷിക്കുകയാണങ്കിൽ, Browther-ന് അവ പരിശോധിക്കാനാകും</translation>
<translation id="7205233182271132386">നിങ്ങളുടെ പാസ്‌വേഡുകളിൽ ഏതെങ്കിലുമൊന്ന് പബ്ലിക് ഡാറ്റാ ലംഘനത്തിൽ ഉൾപ്പെട്ടതായി Browther കണ്ടെത്തിയാൽ മുന്നറിയിപ്പ് നേടുക</translation>
<translation id="8555465886620020932">സേവന പിശക്: <ph name="SERVICE_ERROR"/></translation>
<translation id="8556420416730706394">എളുപ്പത്തിൽ ആക്‌സസ് ചെയ്യാൻ നിങ്ങൾക്ക് ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ പിൻ ചെയ്യാം; സൈഡ് പാനലിന്റെ മുകളിലുള്ള 'പിൻ ചെയ്യുക' ബട്ടൺ ക്ലിക്ക് ചെയ്യുക</translation>
<translation id="856656450041460113">ഭാഷാ ലിസ്റ്റ് തിരയുക</translation>
<translation id="75470458211269379">Browther sync chain ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുമ്പോൾ Browther-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവും</translation>
<translation id="2108930010779660436">ഒന്നിലധികം സ്ഥാപനങ്ങൾ Browther മാനേജ് ചെയ്യുന്നു</translation>
<translation id="7209630341463003999">പകർപ്പവകാശം <ph name="YEAR"/> Browther രചയിതാക്കൾ. എല്ലാ അവകാശങ്ങളും നിക്ഷിപ്‌തം.</translation>
<translation id="8601359445272098721">പുതിയത്! "സ്ക്രീൻ വിവർത്തനം ചെയ്യുക" ബട്ടൺ തിരഞ്ഞെടുക്കുന്നതിലൂടെ നിങ്ങളുടെ സ്ക്രീനിലെ ടെക്സ്റ്റും ചിത്രങ്ങളും വിവർത്തനം ചെയ്യാം</translation>
