<translation id="7299962884342109067">Browther-ന്റെ ഏറ്റവും ശക്തമായ സുരക്ഷ നേടുക</translation>
<translation id="983803489796659991">അപ്‌ഡേറ്റ് സെർവറിൽ ആപ്പിനായി ഹാഷ് ഡാറ്റയൊന്നും ഇല്ലാത്തതിനാൽ ഇൻസ്റ്റാൾ ചെയ്യുന്നത് പരാജയപ്പെട്ടു.</translation>
<translation id="8775461190334353148">അക്കൗണ്ട് ഇല്ലാതെ Browther ഉപയോഗിക്കുക</translation>
<translation id="7146761239544860058">Browther രചയിതാക്കൾ</translation>
<translation id="989970834842471429">'ചിത്രമുപയോഗിച്ചുള്ള തിരയൽ' ഉപയോഗിച്ച് തിരയാൻ എന്തെങ്കിലും ടെക്സ്റ്റോ ചിത്രമോ തിരഞ്ഞെടുക്കുക</translation>
<translation id="6616551030373607751">നിങ്ങളുടെ ലൊക്കേഷൻ ഉപയോഗിക്കാൻ, <ph name="BEGIN_LINK"/>സിസ്റ്റം ക്രമീകരണം<ph name="END_LINK"/> എന്നതിൽ Browther-ന് ആക്‌സസ് നൽകുക</translation>
<translation id="137466361146087520">Google Chrome ബീറ്റ</translation>
<translation id="7535429826459677826">Google Chrome Dev</translation>
<translation id="5110032212554763592">അവ്യക്തമായ പിശകിനാൽ ഇൻസ്റ്റാൾ ചെയ്യൽ പരാജയപ്പെട്ടു. Browther വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="9074842261125908635">അറിയാത്ത ഉറവിടങ്ങളിൽ നിന്നുള്ള വിപുലീകരണങ്ങൾ, ആപ്പുകൾ, തീമുകൾ എന്നിവ നിങ്ങളുടെ ഉപകരണത്തിന് ദോഷകരമാകാം. അവ <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> എന്നതിൽ നിന്ന് മാത്രം ഇൻസ്റ്റാൾ ചെയ്യാൻ Browther നിർദ്ദേശിക്കുന്നു</translation>
<translation id="3593119910409528681">ഈ വിപുലീകരണം Browther വെബ് സ്റ്റോർ നയം ലംഘിക്കുന്നു, ഇത് സുരക്ഷിതമല്ലായിരിക്കാം. Browther-ൽ നിന്ന് ഇത് നീക്കം ചെയ്യുന്നതിലൂടെ, നിങ്ങളുടെ വ്യക്തിപരമായ വിവരങ്ങൾ ഉൾപ്പെടെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകളിലെ ഡാറ്റ അതിന് ഇനി കാണാനും മാറ്റാനുമാകില്ല.</translation>
<translation id="5245976396374147971">മുന്നറിയിപ്പ്: നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം റെക്കോർഡ് ചെയ്യുന്നതിൽ നിന്ന് വിപുലീകരണങ്ങളെ തടയാൻ Browther-ന് കഴിയില്ല. അദൃശ്യമോഡിൽ ഈ വിപുലീകരണം പ്രവർത്തനരഹിതമാക്കാൻ, ഈ ഓപ്ഷൻ തിരഞ്ഞെടുത്തത് റദ്ദാക്കുക.</translation>
<translation id="3629539416935660172">Browther സുരക്ഷിതമാക്കുന്നതിന്, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> എന്നതിൽ ലിസ്റ്റുചെയ്യാത്ത ചില വിപുലീകരണങ്ങൾ ഞങ്ങൾ പ്രവർത്തനരഹിതമാക്കി, അവ നിങ്ങളുടെ അറിവില്ലാതെ ചേർത്തിരിക്കാനിടയുണ്ട്.</translation>
<translation id="157534302749986451">Browther സുരക്ഷിതമാക്കാൻ, <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> എന്നതിൽ ലിസ്റ്റുചെയ്യാത്ത ഇനിപ്പറയുന്ന വിപുലീകരണം ഞങ്ങൾ പ്രവർത്തനരഹിതമാക്കി, അവ നിങ്ങളുടെ അറിവില്ലാതെ ചേർത്തിരിക്കാനിടയുണ്ട്.</translation>
<translation id="3031052147361385845">Browther ആൾ&amp;മാറാട്ട വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="5556794247782664281">Browther ആൾ&amp;മാറാട്ട വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{Browther-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും.}=1{Browther-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{Browther-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് Browther വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു}=1{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് Browther വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് Browther വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് Browther വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു}=1{അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് Browther വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് Browther വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="8762228142105311329">{COUNT, plural, =0 {അഡ്വാൻസ്ഡ് പ്രൊട്ടെക്ഷൻ അപ്ഡേറ്റ് പ്രയോഗിക്കാൻ നിങ്ങളുടെ Browther പുനരാരംഭിക്കേണ്ടതുണ്ട്} =1 {അഡ്വാൻസ്ഡ് പ്രൊട്ടെക്ഷൻ അപ്‌ഡേറ്റ് പ്രയോഗിക്കാൻ നിങ്ങളുടെ Browther പുനരാരംഭിക്കേണ്ടതുണ്ട്. നിങ്ങളുടെ സ്വകാര്യ വിൻഡോ തിരികെ തുറക്കുന്നില്ല.} other {അഡ്വാൻസ്ഡ് പ്രൊട്ടെക്ഷൻ അപ്ഡേറ്റ് പ്രയോഗിക്കാൻ നിങ്ങളുടെ Browther പുനരാരംഭിക്കേണ്ടതുണ്ട്. നിങ്ങളുടെ # സ്വകാര്യ വിൻഡോകൾ തിരികെ തുറക്കുന്നില്ല.}}</translation>
<translation id="5749154344207139683">നമുക്ക് ഈ 1 മിനിറ്റ് സർവേ എടുത്തു പ്രൈവറ്റ് മെച്ചപ്പെടുത്താൻ സഹായിക്കൂ.</translation>
<translation id="6954203250660846933">നിങ്ങൾ വിലാസ ബാറിലോ സെർച്ച് ബോക്‌സിലോ ടൈപ്പ് ചെയ്യുമ്പോൾ, മികച്ച നിർദ്ദേശങ്ങൾ ലഭിക്കുന്നതിന് ടൈപ്പ് ചെയ്യുന്നതെന്തോ അത് Browther നിങ്ങളുടെ ഡിഫോൾട്ട് തിരയൽ യന്ത്രത്തിലേക്ക് അയയ്ക്കുന്നു. ഇത് അദൃശ്യ മോഡിൽ ഓഫാണ്.</translation>
<translation id="3542179014707218534">Browther അദൃശ്യ മോഡ്</translation>
<translation id="2076355018722231995">അദൃശ്യ മോഡിൽ ബ്രൗസ് ചെയ്യുമ്പോൾ, സുരക്ഷിതമല്ലാത്ത കണക്ഷൻ ഉപയോഗിച്ച് ഒരു സൈറ്റ് ലോഡ് ചെയ്യുന്നതിന് മുമ്പ് Browther നിങ്ങൾക്ക് മുന്നറിയിപ്പ് നൽകും</translation>
</translationbundle>