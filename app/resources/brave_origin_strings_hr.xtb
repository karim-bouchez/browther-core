<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="1026101648481255140">Nastavi instaliranje</translation>
<translation id="7099479769133613710">Ponovo pokrenite da biste ažurirali &amp;Chrome OS</translation>
<translation id="2479110114759182442">Browther preporučuje da pregledate ovo proširenje</translation>
<translation id="3814674848168165531">Kad web-lokacija zatraži privatno predučitavanje veza na stranici, Browther upotrebljava Braveove poslužitelje. Na taj se način vaš identitet sakriva od predučitane web-lokacije, ali Browther saznaje koje se web-lokacije predučitavaju.</translation>
<translation id="1065672644894730302">Vaše postavke nije moguće čitati. Neke značajke možda nisu dostupne i promjene postavki neće biti spremljene.</translation>
<translation id="7577672138294294152">Tvoj je roditelj isključio "Dopuštenja za web-lokacije, aplikacije i proširenja" za Browther</translation>
<translation id="5918095577778020936">Browther želi izvesti vaše zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="112640046208448578">Identificirajte stvari ili mjesta i kopirajte ili prevedite tekst. Kad upotrebljavate pretraživanje slika, snimka zaslona stranice šalje se poslužitelju. <ph name="LEARN_MORE"/></translation>
<translation id="5468853758063275923">Browther je vaš zadani preglednik</translation>
<translation id="8522292744959221145">Da biste provjerili jesu li vaše zaporke sigurne od povrede podataka i drugih poteškoća sa sigurnošću, <ph name="BEGIN_LINK"/>prijavite se na Browther<ph name="END_LINK"/>.</translation>
<translation id="2627788872035182013">Kliknite Braveov izbornik</translation>
<translation id="1157985233335035034">Nedavni jezici</translation>
<translation id="7813580490378477695"><ph name="PARTNER_NAME"/> dodao je proširenje koje može promijeniti Braveov način rada.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">Instaliranje nije uspjelo jer vaša verzija Windowsa nije podržana.</translation>
<translation id="8541922081612557424">O pregledniku Browther</translation>
<translation id="1203500561924088507">Zahvaljujemo što ste izvršili instaliranje. Da biste mogli koristiti <ph name="BUNDLE_NAME"/>, morate ponovno pokrenuti preglednik.</translation>
<translation id="1232234696885483911">Kad otvorite pretraživanje slika, naslov, URL i sadržaj stranice, uključujući PDF-ove, automatski će se poslati poslužitelju. <ph name="LEARN_MORE"/></translation>
<translation id="1934377710648094656">Dok ste prijavljeni, možete koristiti svoje zaporke i još mnogo toga sa svojeg Browther računa u Braveu. Da biste to promijenili, idite na Vaš račun u Braveu.</translation>
<translation id="8799570501820813406">Dok je ova kartica bila neaktivna, memorija je oslobođena kako bi Browther ostao brz. Možete odabrati da ta web-lokacija uvijek bude neaktivna.</translation>
<translation id="8767381092474532098">Browther je blokirao ovo preuzimanje jer je datoteka opasna</translation>
<translation id="3256289531845594061">Kad se na Braveove usluge kao što su Gmail ili YouTube prijavljujete pomoću računa <ph name="USER_EMAIL"/>, možete se automatski prijaviti u Browther istim računom</translation>
<translation id="1290883685122687410">Pogreška pri postavljanju: <ph name="METAINSTALLER_EXIT_CODE"/> <ph name="WINDOWS_ERROR"/></translation>
<translation id="4798342026247191171">Postavite novi profil u Braveu</translation>
<translation id="878572309106296578">Browther treba pristup Bluetoothu kako bi pronašao 
 Bluetooth uređaje. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/>.</translation>
<translation id="1330562121671411446">Prepoznaj jezik</translation>
<translation id="6204677860546245308">Upotrijebite postavke preglednika koje preporučuje Browther</translation>
<translation id="108284536240904209">Izbriši i podatke s Bravea (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">Prikvačeno! Pretraživanju slika možete ponovo pristupiti pomoću novog gumba na alatnoj traci</translation>
<translation id="1356661055722410047">Novo! Možete prevesti tekst i slike na zaslonu</translation>
<translation id="1383876407941801731">Traži</translation>
<translation id="7009295044271335553">&amp;Upravljajte profilima na Braveu</translation>
<translation id="1404026649028693342">Uvijek prikaži AI način</translation>
<translation id="141901961143729572">Podijelite svoje misli</translation>
<translation id="3880714039086599943">Da biste dijelili prozor, u postavkama sustava dopustite snimanje zaslona za Browther.</translation>
<translation id="1586284627848250203">Zatražite pomoć za Browther for Testing</translation>
<translation id="1497802159252041924">Instalacijska pogreška: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">Ova je stranica zaštićena</translation>
<translation id="5147525139567260139">Dijeljenje kartice Browther</translation>
<translation id="721261350616678948">Prijava na Browther</translation>
<translation id="1547469039832541117">Završava istaknut zadatak.</translation>
<translation id="1530633922026945685">Browther treba dopuštenje za pristup kameri radi izrade 3D karte vašeg okruženja</translation>
<translation id="9125033103884432">{NUM_EXTENSIONS,plural, =1{Ovo proširenje više nije podržano. Browther preporučuje da ga uklonite.}one{Ova proširenja više nisu podržana. Browther preporučuje da ih uklonite.}few{Ova proširenja više nisu podržana. Browther preporučuje da ih uklonite.}other{Ova proširenja više nisu podržana. Browther preporučuje da ih uklonite.}}</translation>
<translation id="51545890371361355">Prikvači Browther</translation>
<translation id="6570689355868013775">Braveovi sigurnosni alati</translation>
<translation id="1902837727299679178">Browther želi izbrisati vaše podatke Upravitelja zaporki. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="4449148723378534338">Pregledajte ključne kontrole privatnosti i sigurnosti u Braveu</translation>
<translation id="1640672724030957280">Preuzimanje...</translation>
<translation id="1680687534629375545">Postavite pitanja Browther pretraživanju slika o toj stranici</translation>
<translation id="1709772298389099340">Pruža dodatne ovlasti za <ph name="BROWSER_NAME"/>.</translation>
<translation id="2913217021115517297">Radi poboljšanja tih značajki Browther šalje Braveu vaše interakcije s njim. Pregledatelji te podatke mogu čitati, obrađivati i označavati.</translation>
<translation id="1722488837206509557">To će vam omogućiti odabir između dostupnih uređaja i prikaz sadržaja na njima.</translation>
<translation id="8004287232784878841">Browther će uskoro izbrisati podatke o pregledavanju</translation>
<translation id="4197839351786449392">Browther će pokušati nadograditi kretanja na HTTPS</translation>
<translation id="7814200940910057384">Podaci Bravea izbrisani su</translation>
<translation id="9048361966237194186">Browther će se ponovo pokrenuti za <ph name="REMAINING_TIME"/></translation>
<translation id="5524150602137990006">Kad HTTPS nije dostupan, Browther će upotrebljavati nesigurnu vezu bez upozorenja</translation>
<translation id="6797402139308059782">Neka Browther radi u pozadini</translation>
<translation id="5875673934455379806">Ponovo instaliraj Browther</translation>
<translation id="4529028207655448215">Browther pokušava sljedeće: <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="7362761326208547489">Sljedeći put kad otvorite Browther na uređaju <ph name="DEVICE_TYPE"/>, prikazat će vam se upit za upotrebu Braveovog upravitelja zaporki.</translation>
<translation id="1838374766361614909">Brisanje pretraživanja</translation>
<translation id="3541642064306182066">Da biste podatke o pregledavanju izbrisali samo s ovog uređaja, a zadržali ih na svojem Browther računu, <ph name="BEGIN_LINK"/>odjavite se iz Bravea<ph name="END_LINK"/>.</translation>
<translation id="5679816001365584346">Preuzmite Browther na telefon da biste otvarali ili izrađivali nove grupe kartica u pokretu.</translation>
<translation id="4559627161887338743">Možete upravljati Browther računima na koje ste prijavljeni. Vaši Browther računi koriste se za preglednik Browther, Trgovinu Play, Gmail i brojne druge usluge. Ako želite dodati račun za nekog drugog, na primjer člana obitelji, dodajte novu osobu na uređaj <ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>Saznajte više<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">Pretražite pomoću pretraživanja slika</translation>
<translation id="1880677175115548835">Odaberite tekst</translation>
<translation id="4528406859989804913">Prijavljujete se upravljanim računom i dajete administratoru kontrolu nad svojim profilom u sustavu Browther. Vaši podaci u sustavu Browther, primjerice, aplikacije, oznake, povijest, zaporke i ostale postavke, trajno će se povezati s korisnikom <ph name="USER_NAME"/>. Moći ćete izbrisati te podatke putem Nadzorne ploče Browther računa, ali ih nećete moći povezati s nekim drugim računom. Ako želite, možete izraditi novi profil kako biste zadržali postojeće podatke u sustavu Browther zasebno. <ph name="LEARN_MORE"/></translation>
<translation id="2207454583030080759">Browther štedi bateriju ograničavajući pozadinsku aktivnost i vizualne efekte, kao što je glatko pomicanje i broj sličica u sekundi videozapisa. <ph name="BEGIN_LINK"/>Saznajte više o štednji energije<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">Postavite pitanje o ovoj stranici</translation>
<translation id="8643267611122541711">Browther Updater Service</translation>
<translation id="1649714546770135458">Ako isključite tu opciju, možete se prijaviti na Braveove web-lokacije kao što je Gmail bez prijavljivanja u Browther</translation>
<translation id="189297655255130768">Browther ne reagira. Ponovo pokrenuti sada?</translation>
<translation id="8422047647688939115">Vaša organizacija <ph name="MANAGER"/> zahtijeva da se prijavite u Browther</translation>
<translation id="4035053306113201399">Potrebno je ponovo pokrenuti Chrome OS kako bi se ažuriranje primijenilo.</translation>
<translation id="9048754176089806686">Browther je blokirao ovo preuzimanje jer se ova vrsta datoteke obično ne preuzima i mogla bi biti opasna</translation>
<translation id="1953553007165777902">Preuzimanje... Još <ph name="MINUTE"/> min</translation>
<translation id="2470048290583727811">Savjet za Browther: spremite zaporke</translation>
<translation id="1775322105159056176">Browther ne može utvrditi niti postaviti zadani preglednik</translation>
<translation id="4372901050442507812">Saznajte zašto Browther blokira neke datoteke, otvara se u novoj kartici</translation>
<translation id="2703425183860615504">Održava Braveov softver ažurnim. Ako se ta usluga onemogući ili zaustavi, Braveov softver neće se ažurirati, što znači da se mogu pojaviti sigurnosne ranjivosti koje se neće moći popraviti, pa značajke možda neće funkcionirati. Ova se usluga sama deinstalira kada ne postoji Braveov softver koji je koristi.</translation>
<translation id="9220324636239049437">Time će se izbrisati jedna stavka s uređaja. Da biste kasnije dohvatili svoje podatke, prijavite se na Browther kao <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">Instaliranje nije uspjelo. Pokušajte ponovo.</translation>
<translation id="831418749472885028">Da biste provjerili jesu li vaše druge zaporke sigurne od povrede podataka i drugih poteškoća sa sigurnošću, <ph name="BEGIN_LINK"/>prijavite se na Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">Postavke.</translation>
<translation id="5499149312981370855">Odaberite želite li uključiti povijest na Braveu za prilagođenije doživljaje na Braveovim uslugama</translation>
<translation id="6959434860418352144">Kliknite gumb Prilagodi Browther na stranici Nova kartica da biste Braveu dali novi izgled</translation>
<translation id="2066690553719545730">Uvijek prikaži AI način</translation>
<translation id="2472891440303445472">Browther je blokirao ovo preuzimanje jer je ova datoteka obmanjujuća i može napraviti neočekivane promjene na vašem uređaju</translation>
<translation id="2054358978145431867">Sljedeći put kad otvorite Browther iOS, prikazat će vam se upit da isprobate značajku <ph name="FEATURE_NAME"/>.</translation>
<translation id="2726948994393234543">Vaše zaporke i drugi podaci iz Bravea koje ste spremili na Browther račun uklonit će se s ovog uređaja. Da biste ih ponovo upotrebljavali u Braveu, ponovo se prijavite.</translation>
<translation id="4375530476448642348">{COUNT,plural, =1{Vaša organizacija automatski briše podatke o pregledavanju kada se Browther ne koristi jednu minutu. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}one{Vaša organizacija automatski briše podatke o pregledavanju kada se Browther ne koristi # minutu. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}few{Vaša organizacija automatski briše podatke o pregledavanju kada se Browther ne koristi # minute. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}other{Vaša organizacija automatski briše podatke o pregledavanju kada se Browther ne koristi # minuta. To može uključivati povijest, automatsko popunjavanje i preuzimanja. Kartice će ostati otvorene.}}</translation>
<translation id="2126108037660393668">Preuzeta datoteka nije zadovoljila provjeru.</translation>
<translation id="2135919691573380097">Prijavite tu web-lokaciju</translation>
<translation id="2137162749895930932">Zatvorite zaslon za prijevod</translation>
<translation id="5789330946301045610">Browther je blokirao ovo preuzimanje jer ova web-lokacija ne upotrebljava sigurnu vezu i datoteka se možda neovlašteno mijenjala</translation>
<translation id="2170098639895543546">Odaberite bilo što na stranici</translation>
<translation id="142389341645668510">Prilagodi Browther</translation>
<translation id="2174917724755363426">Instaliranje nije dovršeno. Jeste li sigurni da ga želite otkazati?</translation>
<translation id="8745514854244955877">Browther – Prijava na mrežu – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">Pogreška provjere ažuriranja: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="2058539073923004395">Uklanjanje računa iz Bravea</translation>
<translation id="5550942974310218641">Budite sigurniji u pokretu uz poboljšano sigurno pregledavanje u Braveu za iOS</translation>
<translation id="6677253423995557759">Opasna web-lokacija. Browther je uklonio obavijesti.</translation>
<translation id="2236949375853147973">Moja aktivnost</translation>
<translation id="457168681575748148">Da biste mogli pristupati svojim adresama i drugim podacima na svim svojim uređajima, prijavite se na Browther. Adresa će se spremiti na vaš Browther račun nakon što se prijavite.</translation>
<translation id="5659384504794665581">Ako dijelite računalo, prijatelji i članovi obitelji mogu zasebno pregledavati i postaviti Browther prema svojim željama.</translation>
<translation id="2283803047247799269">Pretražite tu karticu pomoću pretraživanja slika</translation>
<translation id="8984404842684436004">{NUM_TABS,plural, =1{Browther preporučuje pauziranje kartice koja usporava preglednik}one{Browther preporučuje pauziranje kartica koje usporavaju preglednik}few{Browther preporučuje pauziranje kartica koje usporavaju preglednik}other{Browther preporučuje pauziranje kartica koje usporavaju preglednik}}</translation>
<translation id="2307973900865360088">Zadrži na traci</translation>
<translation id="7810992039564280750">Provjerava URL-ove s popisom nesigurnih web-lokacija pohranjenih u Braveu. Ako neka web-lokacija pokuša ukrasti vašu zaporku ili ako preuzmete štetnu datoteku, Browther također može sigurnom pregledavanju poslati URL-ove, uključujući dijelove sadržaja web-stranice.</translation>
<translation id="5042718521573656164">Tom ćete radnjom:
        <ph name="LINE_BREAKS"/>
          • vratiti neke postavke Bravea i Braveove prečace na zadano
          <ph name="LINE_BREAK"/>
          • onemogućiti proširenja
          <ph name="LINE_BREAK"/>
          • izbrisati kolačiće i druge privremene podatke web-lokacije.
          <ph name="LINE_BREAKS"/>
          To neće utjecati na oznake, povijest i spremljene zaporke.</translation>
<translation id="9095263438435683933">Da biste poslali broj s ovog uređaja na svoj Android telefon, prijavite se na Browther na oba uređaja.</translation>
<translation id="2356070529366658676">Upitaj</translation>
<translation id="2359808026110333948">Nastavi</translation>
<translation id="6485997157403727556">Proširenje <ph name="EXTENSION_NAME"/> traži da se prijavite u Browther</translation>
<translation id="7017760840808989683">Onemogući rad Bravea u pozadini za aplikacije</translation>
<translation id="8491912023989916905">Da biste upotrebljavali ovo proširenje kao <ph name="USER_EMAIL_ADDRESS"/>, prijavite se u Browther.</translation>
<translation id="8418845734693287262">Chrome OS nije mogao sinkronizirati podatke vašeg računa jer su podaci prijave na račun zastarjeli.</translation>
<translation id="5617265241715541684">{NUM_DEVICES,plural, =0{Jedno ili više Braveovih proširenja pristupalo je jednom HID uređaju}=1{Jedno ili više Braveovih proširenja pristupa jednom HID uređaju}one{Jedno ili više Braveovih proširenja pristupa # HID uređaju}few{Jedno ili više Braveovih proširenja pristupa # HID uređaja}other{Jedno ili više Braveovih proširenja pristupa # HID uređaja}}</translation>
<translation id="1248225940185478633">Browther treba dopuštenje za fotoaparat i mikrofon za ovu web-lokaciju</translation>
<translation id="2403703063067034158">Pogreška pokretanja: trenutačno je u tijeku drugi primjerak postavljanja. Pokušajte ponovno kasnije.</translation>
<translation id="5298352791080868905">Otvorite veze u Braveu iz bilo koje aplikacije i zadržite pristup pregledniku na programskoj traci</translation>
<translation id="2118275934191847461">Uz <ph name="BEGIN_LINK"/>Braveove alate<ph name="END_LINK"/> možete sigurno pregledavati i zadržati kontrolu</translation>
<translation id="2451727308784734061">Pomoću prečaca brzo pristupite Upravitelju zaporki. Prečac možete premjestiti na početni zaslon računala ili u pokretač aplikacija.</translation>
<translation id="6381750314821942592">Browther će se uskoro zatvoriti</translation>
<translation id="6078442581074612226">U Braveu</translation>
<translation id="2485422356828889247">Deinstaliraj</translation>
<translation id="2513154137948333830">Potrebno je ponovno pokretanje: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">Odaberite tekst pomoću pretraživanja slika</translation>
<translation id="70183448213529602">Browther pokušava zamijeniti postojeće zaporke. Upišite svoju zaporku za Windows da biste to dopustili.</translation>
<translation id="7798069806040634998">Browther treba pristup pohrani radi preuzimanja datoteka</translation>
<translation id="2351700486811407088">Browther Origin Helper</translation>
<translation id="2575822587468774919">Odaberite bilo što za pretraživanje pomoću pretraživanja slika</translation>
<translation id="3830890663494219270">Da biste mogli pristupati svojim zaporkama i drugim podacima na svim svojim uređajima, prijavite se na Browther</translation>
<translation id="6252796827759111076">Nastavi s upotrebom Bravea</translation>
<translation id="259935314519650377">Spremanje preuzetog alata za instalaciju u predmemoriju nije uspjelo. Pogreška: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">Sustav</translation>
<translation id="7931230852267968641">Vaša organizacija može vidjeti podatke o pregledavanju, kao što su oznake, povijest i zaporke, te upravljati njima. Ne može vidjeti podatke o pregledavanju na drugim profilima na Braveu.</translation>
<translation id="2257221826278123061">Potvrdite svoj identitet kako biste upotrebljavali i spremali podatke iz Bravea na svojem računu, <ph name="ACCOUNT_EMAIL"/></translation>
<translation id="7387051847644272380">Došlo je do pogreške operativnog sustava tijekom instalacije. Ponovo preuzmite Browther.</translation>
<translation id="2648689842065142443">Ako dijelite uređaj, prijatelji i članovi obitelji mogu zasebno pregledavati i postaviti Browther prema svojim željama</translation>
<translation id="6791166902140255175">Braveova kartica</translation>
<translation id="8372880274820509128">Radi dodatne sigurnosti Browther će šifrirati vaše podatke.</translation>
<translation id="8752006915531191162">Odjavite se da biste uklonili Browther račun iz Bravea</translation>
<translation id="5344406739101555055">Da biste mogli pristupati svojim zaporkama, oznakama i drugim podacima na svim svojim uređajima, prijavite se na Browther</translation>
<translation id="2738871930057338499">Povezivanje s internetom nije moguće. HTTP 403 Zabranjeno je. Provjerite konfiguraciju proxyja.</translation>
<translation id="2753623023919742414">Kliknite za pretraživanje</translation>
<translation id="1312769823139326127">Postavite Browther kao zadani preglednik za PDF</translation>
<translation id="3173824377856109157">Browther može automatski popuniti složena polja koja standardno automatsko popunjavanje može propustiti</translation>
<translation id="1187986649024576560">Ovo proširenje sadrži zlonamjerni softver i nije sigurno. Uklonite ga iz Bravea kako više ne bi moglo vidjeti i mijenjati vaše podatke na web-lokacijama koje posjećujete, uključujući vaše osobne podatke.</translation>
<translation id="2799223571221894425">Pokreni ponovo</translation>
<translation id="5962774139606909656">Vaš Browther</translation>
<translation id="2816462166102338036">Pretražite taj videozapis pomoću pretraživanja slika</translation>
<translation id="2841525013647267359">Jezik izvornika</translation>
<translation id="2846251086934905009">Pogreška pri instalaciji: program za instalaciju nije dovršio radnju. Instalacija je prekinuta.</translation>
<translation id="777113543093865885">Ukloni iz Bravea...</translation>
<translation id="5265419033369521352">Štiti vas na Braveu i može se upotrebljavati za poboljšanje sigurnosti u drugim Braveovim aplikacijama kad ste prijavljeni.</translation>
<translation id="2885378588091291677">Upravitelj zadataka</translation>
<translation id="2176825726964012531">O pregledniku &amp;Browther</translation>
<translation id="2915996080311180594">Ponovo pokreni kasnije</translation>
<translation id="2928420929544864228">Instaliranje je dovršeno.</translation>
<translation id="2481553173340651149">Vaši se podaci šifriraju vašom šifrom. Unesite je da biste upotrebljavali i spremali podatke Bravea na svojem Browther računu.</translation>
<translation id="2945997411976714835">Pogreška instalacije: nije uspjelo pokretanje programa za instalaciju.</translation>
<translation id="2413255940314578781">Brže se prijavite na web-lokacije pomoću spremljenih zaporki za Browther na iOS-u</translation>
<translation id="122765104641632123">Dodajte novi profil u Braveu da biste odvojili oznake, zaporke i postavke.</translation>
<translation id="3688936822855019158">Vaša organizacija upravlja Braveom</translation>
<translation id="8208853227947884571">Browther je ažuran</translation>
<translation id="5122472867956731189">Ako neka web-lokacija pokuša ukrasti vašu zaporku ili ako preuzmete štetnu datoteku, Browther također može sigurnom pregledavanju poslati URL-ove, uključujući dijelove sadržaja web-stranice</translation>
<translation id="3963199983793987097">Za više sigurnosti online uz postavke koje su odabrali tvoji roditelji, prijavi se na Browther</translation>
<translation id="3003694935412297923">Svi zadaci</translation>
<translation id="7611046016537686219">{count,plural, =1{Browther treba potvrditi da ste to vi da bi se neki podaci mogli spremiti na vaš Browther račun i upotrebljavati na svim vašim uređajima. Ako se sada odjavite, ti će se podaci (1 stavka) izbrisati.}one{Browther treba potvrditi da ste to vi da bi se neki podaci mogli spremiti na vaš Browther račun i upotrebljavati na svim vašim uređajima. Ako se sada odjavite, ti će se podaci ({count} stavka) izbrisati.}few{Browther treba potvrditi da ste to vi da bi se neki podaci mogli spremiti na vaš Browther račun i upotrebljavati na svim vašim uređajima. Ako se sada odjavite, ti će se podaci ({count} stavke) izbrisati.}other{Browther treba potvrditi da ste to vi da bi se neki podaci mogli spremiti na vaš Browther račun i upotrebljavati na svim vašim uređajima. Ako se sada odjavite, ti će se podaci ({count} stavki) izbrisati.}}</translation>
<translation id="4202995875619419215">Otvorite <ph name="URL"/> u novoj kartici u Braveu.</translation>
<translation id="8755404239607088219">Browther ne može provjeriti vaše zaporke. Pokušajte ponovno kasnije.</translation>
<translation id="8880183781256147665">Dodavanje u preglednik Browther...</translation>
