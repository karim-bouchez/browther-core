<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="te">
<translation id="1026101648481255140">ఇన్‌స్టలేషన్‌ను కొనసాగించండి</translation>
<translation id="7099479769133613710">&amp;ChromeOSను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="7264054672589027446">ఈ ఎక్స్‌టెన్షన్‌ను రివ్యూ చేయమని Browther మీకు సిఫార్సు చేస్తోంది</translation>
<translation id="7848219163187166649">వారి పేజీలో లింక్‌లను ప్రైవేట్‌గా ప్రీ - లోడ్ చేయమని సైట్ కోరినప్పుడు, Browther, Browther సర్వర్‌లను ఉపయోగిస్తుంది. ఇది ప్రీ - లోడ్ చేయబడిన సైట్ నుండి మీ గుర్తింపును దాచిపెడుతుంది, కానీ ఏ సైట్‌లు ప్రీ - లోడ్ అయ్యాయి అనేది Braveకు తెలుస్తుంది.</translation>
<translation id="1065672644894730302">మీ ప్రాధాన్యతలు చదవబడలేవు. కొన్ని లక్షణాలు అందుబాటులో ఉండకపోవచ్చు మరియు ప్రాధాన్యతలకు మార్పులు సేవ్ చేయబడకపోవచ్చు.</translation>
<translation id="8837164267124113709">Braveలో సైట్‌లు, యాప్‌లు, ఎక్స్‌టెన్షన్‌లకు సంబంధించిన అనుమతులను మీ తల్లి/తండ్రి ఆఫ్ చేశారు</translation>
<translation id="881513728707488138">Browther మీ పాస్‌వర్డ్‌లను ఎగుమతి చేయాలనుకుంటోంది. దీనిని అనుమతించడం కోసం మీ Windows పాస్‌వర్డ్‌ని టైప్ చేయండి.</translation>
<translation id="112640046208448578">వస్తువులను లేదా ప్రదేశాలను గుర్తించండి, టెక్స్ట్‌ను కాపీ చేయండి లేదా అనువదించండి. మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించినప్పుడు, పేజీకి సంబంధించిన స్క్రీన్‌షాట్, సర్వర్‌కు పంపబడుతుంది. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">మీ డిఫాల్ట్ బ్రౌజర్ Browther</translation>
<translation id="6580138787163923852">డేటా ఉల్లంఘనల నుండి, ఇతర భద్రతా సమస్యల నుండి మీ పాస్‌వర్డ్‌లు సురక్షితంగా ఉన్నాయో లేదో చెక్ చేయడానికి, <ph name="BEGIN_LINK"/>Braveకు సైన్ ఇన్ చేయండి<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">Browther మెనూను క్లిక్ చేయండి</translation>
<translation id="1157985233335035034">ఇటీవలి భాషలు</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> ఎక్స్‌టెన్షన్ కారణంగా Browther పని చేసే విధానం మారవచ్చు.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">మీ Windows వెర్షన్‌ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="8291401179516272335">Browther గురించి</translation>
<translation id="1203500561924088507">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME"/>‌ను ఉపయోగించడానికి ముందు మీరు బ్రౌజర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="1232234696885483911">మీరు ఇమేజ్ సెర్చ్‌ను తెరిచినప్పుడు, PDFలతో సహా పేజీ టైటిల్, URL, కంటెంట్ ఆటోమేటిక్‌గా సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">మీరు సైన్ ఇన్ చేసినప్పుడు, Braveలో మీ Browther ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. దీన్ని మార్చడానికి, “Braveలో మీ ఖాతా”కు వెళ్లండి.</translation>
<translation id="9034321258761608912">ఈ ట్యాబ్ ఇన్‌యాక్టివ్‌గా ఉన్నప్పుడు, Braveను వేగంగా ఉంచడానికి మెమరీ ఖాళీ చేయబడింది. మీరు ఏ సమయంలోనైనా ఈ సైట్ ఇన్‌యాక్టివ్‌గా ఉండకుండా మినహాయించడాన్ని ఎంచుకోవచ్చు.</translation>
<translation id="249571811018731941">ఫైల్ ప్రమాదకరంగా ఉన్నందున Browther ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/>‌తో Gmail లేదా YouTube వంటి Browther సర్వీస్‌లకు ఆటోమేటిక్‌గా సైన్ ఇన్ చేస్తున్నప్పుడు, మీరు అదే ఖాతాతో Braveకి సైన్ ఇన్ చేయవచ్చు</translation>
<translation id="1290883685122687410">సెటప్ ఎర్రర్: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">మీ కొత్త Browther ప్రొఫైల్‍ను సెట్ అప్ చేయండి</translation>
<translation id="4437862975743821367">బ్లూటూత్ పరికరాలను 
 అన్వేషించడానికి Braveకు బ్లూటూత్ యాక్సెస్ అవసరం. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">భాషను గుర్తించండి</translation>
<translation id="1206925267243987362">Browther సిఫార్సు చేసిన బ్రౌజర్ సెట్టింగ్‌లను ఉపయోగించండి</translation>
<translation id="8270483548049772782">Browther (<ph name="URL"/>) నుండి కూడా డేటాను తొలగించండి</translation>
<translation id="1345251407431278948">పిన్ చేశారు! మీరు టూల్‌బార్‌లోని కొత్త బటన్‌ను ఉపయోగించి ఇమేజ్ సెర్చ్‌ను మళ్లీ యాక్సెస్ చేయవచ్చు</translation>
<translation id="1356661055722410047">కొత్తది! మీరు ఇప్పుడు మీ స్క్రీన్‌పై టెక్స్ట్‌ను, ఇమేజ్‌లను రెండింటినీ అనువదించవచ్చు</translation>
<translation id="1383876407941801731">సెర్చ్</translation>
<translation id="1592588950737518481">&amp;Browther ప్రొఫైల్స్‌ను మేనేజ్ చేయండి</translation>
<translation id="1404026649028693342">AI మోడ్‌ను ఎల్లప్పుడూ చూడండి</translation>
<translation id="141901961143729572">మీ ఆలోచనలను షేర్ చేయండి</translation>
<translation id="1743952081001089298">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Browther కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="8627385813382688019">Browther for Testingకు సంబంధించి సహాయాన్ని పొందండి</translation>
<translation id="1497802159252041924">ఇన్‌స్టాలేషన్ ఎర్రర్: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">ఈ పేజీకి ప్రొటెక్షన్ జోడించబడింది</translation>
<translation id="7252430412915798987">Browther ట్యాబ్‌ను షేర్ చేయండి</translation>
<translation id="6388429281015199562">Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="1547469039832541117">హైలైట్ అయిన టాస్క్‌ను ముగిస్తుంది.</translation>
<translation id="1801944307203212016">మీ పరిసరాల 3D మ్యాప్‌ను క్రియేట్ చేయడానికి Braveకు మీ కెమెరాను యాక్సెస్ చేసే అనుమతి కావాలి</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{ఈ ఎక్స్‌టెన్షన్ ఇకపై సపోర్ట్ చేయదు. మీరు దాన్ని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది.}other{ఈ ఎక్స్‌టెన్షన్‌లు ఇకపై సపోర్ట్ చేయబడవు. మీరు వాటిని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది.}}</translation>
<translation id="4667068923142532753">Braveను పిన్ చేయండి</translation>
<translation id="3006560544901646947">Browther భద్రతా టూల్స్</translation>
<translation id="686052171138185761">Browther మీ Password Manager డేటాను తొలగించాలనుకుంటోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="8713026329083542796">Braveలోని ముఖ్య గోప్యతా, సెక్యూరిటీ కంట్రోల్స్‌ను రివ్యూ చేయండి</translation>
<translation id="1640672724030957280">డౌన్‌లోడ్ చేయబడుతోంది...</translation>
<translation id="1680687534629375545">ఈ పేజీ గురించి వివరాలు తెలుసుకోవడానికి ఇమేజ్ సెర్చ్‌ను అడగండి</translation>
<translation id="1709772298389099340"><ph name="BROWSER_NAME"/> కోసం అదనపు అధికారాలను అందిస్తుంది.</translation>
<translation id="4243382967656566037">ఈ ఫీచర్‌లను మెరుగుపరచడంలో సహాయం చేయడానికి, Browther వాటితో మీ ఇంటరాక్షన్‌లను Braveకు పంపుతుంది. రివ్యూవర్‌లు ఈ డేటాను చదవవచ్చు, ప్రాసెస్ చేయవచ్చు లేదా అదనపు గమనికలను జోడించవచ్చు.</translation>
<translation id="1722488837206509557">ఇది అందుబాటులో ఉన్న పరికరాల నుండి ఎంచుకోవడానికి, వాటిలో కంటెంట్‌ను డిస్‌ప్లే చేయడానికి మిమ్మల్ని అనుమతిస్తుంది.</translation>
<translation id="6820510278633522408">Browther త్వరలోనే బ్రౌజింగ్ డేటాను తొలగిస్తుంది</translation>
<translation id="7775028004939172516">Browther నావిగేషన్‌లను HTTPSకి అప్‌గ్రేడ్ చేయడానికి ట్రై చేస్తుంది</translation>
<translation id="6963959729951758069">Browther డేటా తీసేసింది</translation>
<translation id="4085139922884095932">Browther <ph name="REMAINING_TIME"/> సమయంలో రీస్టార్ట్ అవుతుంది</translation>
<translation id="2586248102295515296">HTTPS అందుబాటులో లేనప్పుడు, Browther మిమ్మల్ని హెచ్చరించకుండా సురక్షితం కాని కనెక్షన్‌ను ఉపయోగిస్తుంది</translation>
<translation id="3975328336074677101">బ్యాక్‌గ్రౌండ్‌లో Braveని అమలు చేయడానికి అనుమతించండి</translation>
<translation id="2497443204974841650">Braveను మళ్లీ ఇన్‌స్టాల్ చేయి</translation>
<translation id="1724309687045787742"><ph name="AUTHENTICATION_PURPOSE"/> కోసం Browther ట్రై చేస్తోంది</translation>
<translation id="4553225588627299783">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE"/>‌లో Braveను తెరిచినప్పుడు, Browther Password Managerను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="1838374766361614909">శోధనను తీసివేయండి</translation>
<translation id="2337233040802538155">ఈ పరికరం నుండి మాత్రమే బ్రౌజింగ్ డేటాను తొలగించడానికి, దీన్ని మీ Browther ఖాతాలో ఉంచుతూ, <ph name="BEGIN_LINK"/>Browther నుండి సైన్ అవుట్ చేయండి<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">ప్రయాణంలో ఉన్నప్పుడు కొత్త ట్యాబ్ గ్రూప్‌లను తెరవడానికి లేదా క్రియేట్ చేయడానికి మీ ఫోన్‌లో Braveను డౌన్‌లోడ్ చేసుకోండి.</translation>
<translation id="2063443520349987970">మీరు సైన్ ఇన్ చేసిన Browther ఖాతాలను మీరు మేనేజ్ చేయవచ్చు. Browther బ్రౌజర్, Play Store, Gmail, ఇంకా మరిన్నింటి కోసం మీ Browther ఖాతాలు ఉపయోగించబడతాయి. ఫ్యామిలీ మెంబర్ వంటి వారి కోసం మీరు ఖాతాను జోడించాలనుకుంటే, బదులుగా కొత్త వ్యక్తిని మీ <ph name="DEVICE_TYPE"/>కు జోడించండి. <ph name="LINK_BEGIN"/>మరింత తెలుసుకోండి<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయండి</translation>
<translation id="1880677175115548835">టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="3183933389992069620">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ Browther ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ Browther డేటా శాశ్వతంగా <ph name="USER_NAME"/>కు అనుబంధించబడుతుంది. మీరు Browther ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. మీరు ప్రస్తుతం ఉన్న మీ Browther డేటాను వేరుగా ఉంచడానికి ఐచ్ఛికంగా కొత్త ప్రొఫైల్‌ను క్రియేట్ చేయవచ్చు. <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther బ్యాక్‌గ్రౌండ్ యాక్టివిటీని, స్మూత్ స్క్రోలింగ్, వీడియో ఫ్రేమ్ రేట్‌ల వంటి విజువల్ ఎఫెక్ట్‌లను పరిమితం చేయడం ద్వారా బ్యాటరీ పవర్‌ను ఆదా చేస్తుంది. <ph name="BEGIN_LINK"/>ఎనర్జీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">ఈ పేజీ వివరాలను అడగండి</translation>
<translation id="9128006428501241840">Browther అప్‌డేటర్ సర్వీస్</translation>
<translation id="6302815314157879372">దీనిని ఆఫ్ చేయడం ద్వారా, మీరు Braveకి సైన్ ఇన్ చేయకుండానే Gmail లాంటి Browther సైట్‌లలో సైన్ ఇన్ చేయగలరు</translation>
<translation id="1063611196035804685">Browther ప్రతిస్పందించడం లేదు. ఇప్పుడు మళ్లీ ప్రారంభించాలా?</translation>
<translation id="2873360330889594383">మీ సంస్థ పాలసీ, <ph name="MANAGER"/> ప్రకారం మీరు Braveకు సైన్ ఇన్ చేయాలి</translation>
<translation id="4035053306113201399">అప్‌డేట్‌ను వర్తింపజేయడానికి ChromeOSను రీస్టార్ట్ చేయాలి.</translation>
<translation id="2861285003831382718">ఫైల్ రకం సాధారణంగా డౌన్‌లోడ్ అవ్వదు, అలాగే ఇది ప్రమాదకరమైనది అయినందున Browther ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="1953553007165777902">డౌన్‌లోడ్ అవుతోంది... <ph name="MINUTE"/> నిమిషం(లు) సమయం మిగిలి ఉంది</translation>
<translation id="2080160985220483492">Browther చిట్కా: పాస్‌వర్డ్‌లను సేవ్ చేయండి</translation>
<translation id="8037497710694492565">Browther డిఫాల్ట్ బ్రౌజర్‌ను నిశ్చయించలేదు లేదా సెట్ చేయలేదు</translation>
<translation id="7395009124247513849">Browther కొన్ని ఫైళ్లను బ్లాక్ చేసి, కొత్త ట్యాబ్‌లో ఎందుకు తెరుస్తుందో తెలుసుకోండి</translation>
<translation id="762710512520170632">మీ Browther సాఫ్ట్‌వేర్‌ను అప్‌డేట్‌గా ఉంచుతుంది. ఈ సర్వీస్ డిజేబుల్ చేయబడినా లేదా ఆపివేయబడినా, మీ Browther సాఫ్ట్‌వేర్ అప్‌డేట్ చేసి ఉంచబడదు, అంటే సంభవించే సెక్యూరిటీ లోపాలను పరిష్కరించడం సాధ్యం కాదు, ఫీచర్‌లు పని చేయకపోవచ్చు. Browther సాఫ్ట్‌వేర్ ఉపయోగించనప్పుడు ఈ సర్వీస్ దానికదే అన్‌ఇన్‌స్టాల్ అవుతుంది.</translation>
<translation id="5793588180426267429">ఇది ఈ పరికరం నుండి 1 అంశాన్ని తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Braveకు <ph name="USER_EMAIL"/> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="2018879682492276940">ఇన్‌స్టాల్ చేయడం విఫలమైంది. దయచేసి మళ్లీ ట్రై చేయండి.</translation>
<translation id="6351516710581760512">డేటా ఉల్లంఘనల నుండి, ఇతర భద్రతా సమస్యల నుండి మీ ఇతర పాస్‌వర్డ్‌లు సురక్షితంగా ఉన్నాయో లేదో చెక్ చేయడానికి, <ph name="BEGIN_LINK"/>Braveకు సైన్ ఇన్ చేయండి<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">సెట్టింగ్‌లు.</translation>
<translation id="8194525816714210105">Browther సర్వీస్‌లలో మరింత వ్యక్తిగతీకరించిన అనుభవం కోసం Browther హిస్టరీని చేర్చాలో, లేదో ఎంచుకోండి</translation>
<translation id="5909559127548969159">Braveకు కొత్త రూపాన్ని అందించడానికి కొత్త ట్యాబ్ పేజీలో Braveను అనుకూలంగా మార్చండి బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="2066690553719545730">AI మోడ్‌ను ఎల్లప్పుడూ చూడండి</translation>
<translation id="3283892260110318935">ఫైల్ మోసపూరితమైనది అలాగే మీ పరికరానికి ఊహించని మార్పులు చేసే అవకాశం ఉన్నందున Browther ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="6160571936643742128">మీరు నెక్స్ట్ టైమ్ Browther iOSను తెరిచినప్పుడు, <ph name="FEATURE_NAME"/>‌ను ట్రై చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="8380517409933452343">మీ Browther ఖాతాలో మీరు సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, ఇతర Browther డేటా ఈ డివైజ్ నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Braveలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{Braveను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}other{Braveను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా బ్రౌజింగ్ డేటాను తొలగిస్తుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు. మీ ట్యాబ్‌లు తెరిచి ఉంటాయి.}}</translation>
<translation id="2126108037660393668">డౌన్‌లోడ్ చేయబడిన ఫైల్ వెరిఫికేషన్ విఫలమైంది.</translation>
<translation id="2135919691573380097">ఈ సైట్‌ను రిపోర్ట్ చేయండి</translation>
<translation id="2137162749895930932">స్క్రీన్‌ను అనువదించండి అనే ఆప్షన్‌ను మూసివేయండి</translation>
<translation id="4283559398694996391">సైట్ సురక్షిత కనెక్షన్‌ను ఉపయోగించని అలాగే ఫైల్ ట్యాంపర్ చేయబడిన కారణంగా Browther ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="2170098639895543546">పేజీలో ఏదైనా ఎంచుకోండి</translation>
<translation id="2495182092286337191">Braveను అనుకూలంగా మార్చండి</translation>
<translation id="2174917724755363426">ఇన్‌స్టాలేషన్ పూర్తి కాలేదు. మీరు ఖచ్చితంగా రద్దు చేయాలనుకుంటున్నారా?</translation>
<translation id="4877141231724140862">Browther - నెట్‌వర్క్ సైన్ ఇన్ - <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">అప్‌డేట్‌ల కోసం చెక్ చేసేటప్పుడు ఎర్రర్ ఏర్పడింది: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">Browther నుండి ఖాతాను తీసివేయండి</translation>
<translation id="1084363153644366288">iOS కోసం Braveలో మెరుగైన సురక్షిత బ్రౌజింగ్‌కు సంబంధించి ప్రయాణంలో సురక్షితంగా ఉండండి</translation>
<translation id="7949164640723239455">హానికరమైన సైట్. Browther నోటిఫికేషన్‌లను తీసివేసింది.</translation>
<translation id="2236949375853147973">నా యాక్టివిటీ</translation>
<translation id="4536403809133456417">Braveకు సైన్ ఇన్ చేసి, మీ పరికరాలన్నింటిలో మీ అడ్రస్‌లను, ఇంకా మరిన్నింటిని పొందండి. మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ అడ్రస్ మీ Browther ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="5627930103267312171">మీరు కంప్యూటర్‌ను షేర్‌ చేస్తే, స్నేహితులు, ఫ్యామిలీ మెంబర్‌లు విడివిడిగా బ్రౌజ్ చేయవచ్చు. Braveను వారికి నచ్చిన రీతిలో సెటప్ చేసుకోవచ్చు.</translation>
<translation id="2283803047247799269">ఇమేజ్ సెర్చ్‌తో ఈ ట్యాబ్‌ను సెర్చ్ చేయండి</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని Browther సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని Browther సిఫార్సు చేస్తుంది}}</translation>
<translation id="2307973900865360088">డాక్‌లో ఉంచండి</translation>
<translation id="5161617112768367959">Braveలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది. ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Browther, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు.</translation>
<translation id="4123094831918713833">ఈ చర్య కారణంగా:
        <ph name="LINE_BREAKS"/>
          • కొన్ని Browther సెట్టింగ్‌లు, Browther షార్ట్‌కట్‌లు రీసెట్ అవుతాయి
          <ph name="LINE_BREAK"/>
          • ఎక్స్‌టెన్షన్‌లు డిజేబుల్ అవుతాయి
          <ph name="LINE_BREAK"/>
          • కుక్కీలు, ఇతర తాత్కాలిక సైట్ డేటాను తొలగించడం జరుగుతుంది
          <ph name="LINE_BREAKS"/>
          బుక్‌మార్క్స్, హిస్టరీ, ఇంకా సేవ్ అయిన పాస్‌వర్డ్‌లు ప్రభావితం కావు.</translation>
<translation id="5456070119344236353">ఇక్కడి నుండి మీ Android ఫోన్‌కు నంబర్‌ను పంపడానికి, రెండు పరికరాలలోని Braveకు సైన్ ఇన్ చేయండి.</translation>
<translation id="2356070529366658676">అడుగు</translation>
<translation id="2359808026110333948">కొనసాగించండి</translation>
<translation id="6468415397021485143">ఎక్స్‌టెన్షన్ "<ph name="EXTENSION_NAME"/>" కోసం, మీరు Braveకు సైన్ ఇన్ చేయాలి</translation>
<translation id="2558600429878197587">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Braveను డిజేబుల్ చేయండి</translation>
<translation id="5295781918312989856"><ph name="USER_EMAIL_ADDRESS"/>‌గా ఈ ఎక్స్‌టెన్షన్‌ను ఉపయోగించడానికి, Braveకు సైన్ ఇన్ చేయండి.</translation>
<translation id="8418845734693287262">మీ ఖాతా సైన్ ఇన్ వివరాల గడువు ముగిసినందున ChromeOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ Browther ఎక్స్‌టెన్షన్‌లు 1 HID పరికరాన్ని యాక్సెస్ చేస్తున్నాయి}=1{1 HID పరికరం ఒకటి లేదా అంతకంటే ఎక్కువ Browther ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ Browther ఎక్స్‌టెన్షన్‌లు # HID పరికరాలను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="434258293817844111">ఈ సైట్ కోసం Braveకు కెమెరా, ఇంకా మైక్రోఫోన్ అనుమతులు అవసరం</translation>
<translation id="2403703063067034158">స్టార్టప్ ఎర్రర్: ప్రస్తుతం వేరొక సెటప్ రన్ అవుతోంది, దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="5458993228789433099">ఏదైనా యాప్ నుండి Braveలో లింక్‌లను తెరవండి, మీ టాస్క్‌బార్‌లో బ్రౌజర్‌ను యాక్సెస్ చేయండి</translation>
<translation id="1677640217693742525"><ph name="BEGIN_LINK"/>Browther నుండి టూల్స్‌<ph name="END_LINK"/>‌తో, మీరు సురక్షితంగా బ్రౌజ్ చేయవచ్చు, కంట్రోల్‌లో ఉండవచ్చు</translation>
<translation id="2451727308784734061">Password Managerను త్వరగా చేరుకోవడానికి మీ షార్ట్‌కట్‌ను ఉపయోగించండి. మీరు మీ షార్ట్‌కట్‌ను మీ కంప్యూటర్ మొదటి స్క్రీన్ లేదా యాప్ లాంచర్‌కు తరలించవచ్చు.</translation>
<translation id="2280315911954332435">Browther త్వరలోనే మూసివేయబడుతుంది</translation>
<translation id="6410820860979094113">Braveలో</translation>
<translation id="2485422356828889247">అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="2513154137948333830">రీబూట్ అవసరం: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">ఇమేజ్ సెర్చ్‌ను ఉపయోగించి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="7892218991241200190">Browther ఇప్పటికే ఉన్న పాస్‌వర్డ్‌లను రీప్లేస్ చేయడానికి ట్రై చేస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="8976443723926188033">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Braveకు స్టోరేజ్‌ యాక్సెస్ అవసరం</translation>
<translation id="4131374838781785973">Browther Origin సహాయకం</translation>
<translation id="2575822587468774919">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి</translation>
<translation id="8705561858232289221">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="437162022240011372">Braveని ఉపయోగించడం కొనసాగించండి</translation>
<translation id="259935314519650377">డౌన్‌లోడ్ చేసిన ఇన్‌స్టాలర్‌ను కాష్ చేయడంలో విఫలమైంది. ఎర్రర్: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">సిస్టమ్</translation>
<translation id="2907676829052962091">మీ సంస్థ మీ బుక్‌మార్క్‌లు, హిస్టరీ, అలాగే పాస్‌వర్డ్‌ల వంటి బ్రౌజింగ్ డేటాను చూడగలదు, మేనేజ్ చేయగలదు. ఇతర Browther ప్రొఫైల్స్‌లోని బ్రౌజింగ్ డేటాను ఇది చూడలేదు</translation>
<translation id="1289116577679005654">మీ ఖాతా <ph name="ACCOUNT_EMAIL"/>‌లో Browther డేటాను ఉపయోగించింది, సేవ్ చేసింది మీరేనని వెరిఫై చేయండి</translation>
<translation id="7192278346779151664">ఇన‌స్ట‌లేష‌న్‌ సమయంలో ఆపరేటింగ్ సిస్టమ్ ఎర్ర‌ర్‌ ఏర్పడింది. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="7724398260867885339">మీరు ఒక పరికరాన్ని షేర్ చేస్తే, ఫ్రెండ్స్, ఫ్యామిలీ విడివిడిగా బ్రౌజ్ చేయవచ్చు, Braveను వారికి నచ్చిన విధంగా సెటప్ చేసుకోవచ్చు</translation>
<translation id="1679595317134614424">Browther ట్యాబ్</translation>
<translation id="7189168846924379421">అదనపు భద్రత కోసం, Browther మీ డేటాను ఎన్‌క్రిప్ట్ చేస్తుంది.</translation>
<translation id="4052643592793184278">Browther నుండి మీ Browther ఖాతాను తీసివేయడానికి, సైన్ అవుట్ చేయండి</translation>
<translation id="7694616023994438906">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="2738871930057338499">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 403 అనుమతి లేదు. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="2753623023919742414">సెర్చ్ చేయడానికి క్లిక్ చేయండి</translation>
<translation id="9078193405195503710">మీ ఆటోమేటిక్ సెట్టింగ్ PDF వ్యూయర్‌గా Braveను సెట్ చేయండి</translation>
<translation id="2456995288904753506">స్టాండర్డ్ ఆటోఫిల్ మిస్ అయ్యే అవకాశమున్న కష్టమైన ఫీల్డ్స్‌ను Browther ఆటోఫిల్ చేయగలదు</translation>
<translation id="3271730304285122987">ఈ ఎక్స్‌టెన్షన్‌లో మాల్‌వేర్ ఉంది, ఇది సురక్షితం కాకపోవచ్చు. Browther నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="2799223571221894425">మళ్లీ ప్రారంభించండి</translation>
<translation id="1427337251963884503">మీ Browther</translation>
<translation id="2816462166102338036">ఇమేజ్ సెర్చ్‌తో ఈ వీడియోను సెర్చ్ చేయండి</translation>
<translation id="2841525013647267359">ఈ భాష నుండి అనువదించండి</translation>
<translation id="2846251086934905009">ఇన్‌స్టాల్ లోపం: ఇన్‌స్టాలర్ ప్రాసెస్‌ను పూర్తి చేయలేదు. ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="928966105228355994">Browther నుండి తీసివేయండి...</translation>
<translation id="587805782197019018">Braveలో మిమ్మల్ని సురక్షితంగా ఉంచుతుంది, మీరు సైన్ ఇన్ చేసినప్పుడు ఇతర Browther యాప్‌లలో మీ సెక్యూరిటీని మెరుగుపరచడానికి ఉపయోగించబడవచ్చు</translation>
<translation id="2885378588091291677">విధి సంచాలకులు</translation>
<translation id="3055995278166070443">&amp;Browther గురించి</translation>
<translation id="2915996080311180594">తర్వాత రీస్టార్ట్ చేయండి</translation>
<translation id="2928420929544864228">ఇన్‌స్టాలేషన్ పూర్తయింది.</translation>
<translation id="70453521937551896">మీ రహస్య పదబంధంతో మీ డేటా ఎన్‌క్రిప్ట్ అయింది. మీ Browther ఖాతాలో Browther డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి దాన్ని ఎంటర్ చేయండి.</translation>
<translation id="2945997411976714835">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ప్రాసెస్‌ను ప్రారంభించడంలో విఫలమైంది.</translation>
<translation id="3188308520233701133">iOSలో Browther కోసం సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించి సైట్‌లకు వేగంగా సైన్ ఇన్ చేయండి</translation>
<translation id="8145318807880784886">బుక్‌మార్క్‌లు, పాస్‌వర్డ్‌లు, సెట్టింగ్‌లను విడి విడిగా ఉంచడానికి కొత్త Browther ప్రొఫైల్‌ను జోడించండి.</translation>
<translation id="4330268530227888227">మీ సంస్థ Braveను మేనేజ్ చేస్తుంది</translation>
<translation id="6488090896442998436">Browther తాజాగా ఉంది</translation>
<translation id="300557164611864786">ఏదైనా సైట్ మీ పాస్‌వర్డ్‌ను దొంగిలించే ప్రయత్నం చేసినా, లేదంటే ఏదైనా హానికరమైన ఫైల్‌ను మీరు డౌన్‌లోడ్ చేసినా, సదరు URLలను, ఆయా పేజీల కంటెంట్‌లోని కొన్ని భాగాలను కూడా Browther, 'సురక్షిత బ్రౌజింగ్'కు పంపవచ్చు</translation>
<translation id="2447145782593796785">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3003694935412297923">అన్ని టాస్క్‌లు</translation>
<translation id="7554113777150891030">{count,plural, =1{మీ Browther ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని Browther ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Browther ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు, అది మీరేనని Browther ధృవీకరించాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="5522228731050510047"><ph name="URL"/> ను Braveలో కొత్త ట్యాబ్‌లో తెరవండి.</translation>
<translation id="6358780591055960280">Browther మీ పాస్‌వర్డ్‌లను చెక్ చేయలేకపోయింది. తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="1386422761453740126">Braveకి జోడిస్తోంది...</translation>
<translation id="3038232873781883849">ఇన్‌స్టాల్ చేయడానికి వేచి ఉంది...</translation>
<translation id="3045032126857188731">అనువదించిన భాష: <ph name="LANGUAGE"/></translation>
<translation id="3047590466164881923">ఫీడ్‌బ్యాక్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="369127628511662602">ఇతర Browther ప్రొఫైల్స్</translation>
<translation id="2370255879896574713">Braveకు వినియోగ గణాంకాలు, <ph name="UMA_LINK"/>ను పంపడం ద్వారా Braveను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{ఒకటి లేదా అంతకంటే ఎక్కువ Browther ఎక్స్‌టెన్షన్‌లు 1 USB పరికరాన్ని యాక్సెస్ చేస్తున్నాయి}=1{1 USB పరికరం ఒకటి లేదా అంతకంటే ఎక్కువ Browther ఎక్స్‌టెన్షన్‌ల ద్వారా యాక్సెస్ చేయబడుతోంది}other{ఒకటి లేదా అంతకంటే ఎక్కువ Browther ఎక్స్‌టెన్షన్‌లు # USB పరికరాలను యాక్సెస్ చేస్తున్నాయి}}</translation>
<translation id="2065456480740480340">Browther హిస్టరీ</translation>
<translation id="5011660649081947055">ఇన్‌స్టాలర్ ఆర్కైవ్‌ను వాస్తవ పరిమాణానికి తీసుకుని రావడంలో విఫలమైంది. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="310459126943037700">టాస్క్(లు) ముగించడంలో విఫలమైంది.</translation>
<translation id="3104828284009500087">పేజీలో ఏదైనా సెర్చ్ చేయండి</translation>
<translation id="4917564010081457061">మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, హిస్టరీని డివైజ్‌లన్నింటిలో పర్‌ఫెక్ట్‌గా సింక్ చేసి ఉంచుకోండి. మీ ఆటోమేటిక్ బ్రౌజర్‌ను Braveకు అప్‌డేట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే ఫీచర్‌లను సులభంగా యాక్సెస్ చేయండి.</translation>
<translation id="1041472930719344928">Browther మీ మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="3130333203120345554">కొత్త సెర్చ్</translation>
<translation id="3137969841538672700">సెర్చ్ చేయడానికి ఇమేజ్‌లో కొంత భాగాన్ని ఎంచుకోండి</translation>
<translation id="5312717254055363883">ఈ ట్యాబ్ అదనపు రిసోర్స్‌లను ఉపయోగిస్తోంది. మీ పనితీరును మెరుగుపరచడానికి, దాన్ని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Braveకు అనుమతినివ్వండి.</translation>
<translation id="373523409348786203">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Browther కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="802113445299754598">Braveను పునఃప్రారంభించండి</translation>
<translation id="3161522574479303604">అన్ని భాషలు</translation>
<translation id="4522189060330781648">మీ కంప్యూటర్‌లోని మరో ప్రోగ్రామ్ జోడించిన థీమ్ కారణంగా, Browther పని చేసే విధానం మారవచ్చు.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">మీ కొత్త Browther ప్రొఫైల్‌ను అనుకూలంగా మార్చుకోండి</translation>
<translation id="5150830326120505481">Browther నుండి మీ Browther ఖాతాను తీసివేయడానికి, సెట్టింగ్‌ల పేజీలోని Browther నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="7113660200899017820">తర్వాత, మీ కోసం ఫారమ్‌లను ఆటోఫిల్ చేయడానికి సేవ్ చేసిన సమాచారాన్ని ఉపయోగించాలనుకుంటున్నారా అని Browther అడగవచ్చు</translation>
<translation id="4475011322243623412">Browther దీని డేటా డైరెక్టరీని చదవలేదు మరియు దీనిలో రాయ‌లేదు: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">ఇప్పుడు పునఃప్రారంభించండి</translation>
<translation id="3536063527222598206">Browther API కీలు లేవు. Browther కార్యాచరణలో కొంత భాగం నిలిపివేయబడుతుంది.</translation>
<translation id="1011450868746766298">Browther మూసివేయబడినప్పుడు నేపథ్య యాప్‌లను అమలు చేయడాన్ని కొనసాగించండి</translation>
<translation id="179611081153855734">సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి ఏదైనా సైట్‌ను లోడ్ చేసే ముందు Browther మిమ్మల్ని హెచ్చరిస్తుంది</translation>
<translation id="8965591964936552871">మీరు Braveకు సైన్ ఇన్ చేసినట్లయితే, Browther విండోలన్నింటినీ మూసివేసినప్పుడు, మీ Browther ఖాతా మినహా, దాదాపుగా సైట్‌లన్నింటి నుండి సైన్ అవుట్ అవుతారు. మిమ్మల్ని సైట్‌లు గుర్తుంచుకోవడానికి, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">మీ ఆటోమేటిక్ సెట్టింగ్ సెర్చ్ ఇంజిన్ Browther వెలుపల నుండి మార్చబడింది. మిమ్మల్ని రక్షించడానికి, Browther దాన్ని రీసెట్ చేసింది.</translation>
<translation id="1170501833661894915">మీ డివైజ్‌లన్నింటిలో మీ బుక్‌మార్క్‌లు, పాస్‌వర్డ్‌లు, మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="3352986031709923790">సెర్చ్ ఏరియాకు ఎగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT"/>%, ఎగువ <ph name="TOP"/>%</translation>
<translation id="120745000989996104">మీ ఖాతాలోని Browther డేటా</translation>
<translation id="3369405342922656244">ఇమేజ్ సెర్చ్‌తో ఈ పేజీని సెర్చ్ చేయండి</translation>
<translation id="7173761126541905083">మీ ఫోన్‌లో Braveతో మీ పాస్‌వర్డ్‌లను ఉపయోగించండి</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">ప్రస్తుతం ఉన్న Browther ప్రొఫైల్‌కు స్విచ్ చేయాలా?</translation>
<translation id="3412460710772753638">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌లో</translation>
<translation id="4282363917570905631">మీ ఫోన్‌లో Braveతో మెరుగైన సురక్షిత బ్రౌజింగ్‌ను విస్తరించండి</translation>
<translation id="986094398735583155">మీరు కోరుకున్న విధంగా Browther వ్యక్తిగతీకరించబడుతోంది...</translation>
<translation id="3266047225484320321">చోరీకి గురైన పాస్‌వర్డ్‌తో మీరు సైన్ ఇన్ చేసినప్పుడు Browther మీకు తెలియజేస్తుంది</translation>
<translation id="3508047337876211050">ఇది ఈ పరికరం నుండి <ph name="ITEMS_COUNT"/> అంశాలను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Braveకు <ph name="USER_EMAIL"/> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="7772248897860792723"><ph name="SHORTCUT"/> Browther ప్రొఫైళ్ల మధ్య స్విచ్ చేయగలదు</translation>
<translation id="7225005776233199285">దయచేసి అన్ని Browther విండోలను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="5465054931427475969">మీ విండోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Browther కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి</translation>
<translation id="6905469223518185641"><ph name="EXISTING_USER"/>‌తో ఇప్పటికే సైన్ ఇన్ చేశారు.  మీ బ్రౌజింగ్‌ను ప్రత్యేకంగా ఉంచడానికి, <ph name="USER_EMAIL_ADDRESS"/>‌గా మీ స్వంత ప్రొఫైల్‌లో Braveకి సైన్ ఇన్ చేయండి.</translation>
<translation id="8133590217245064579">మీ స్క్రీన్‌ను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లలో Browther కోసం స్క్రీన్ రికార్డింగ్‌ను అనుమతించండి.</translation>
<translation id="3597003331831379823">అదనపు అధికారాలతో సెటప్‌ను రన్ చేయడం విఫలమైంది. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="2492221622209669678">ఈ వ్యక్తి బ్రౌజింగ్ డేటా‌ ఈ పరికరం నుండి తొలగించబడుతుంది. డేటాను పునరుద్ధరించడానికి, <ph name="USER_EMAIL"/>గా Braveకు సైన్ ఇన్ చేయండి.</translation>
<translation id="6793778233257855801"><ph name="ORIGIN"/> నుండి మీ Android ఫోన్‌కు నంబర్‌ను పంపడానికి, రెండు పరికరాలలోని Braveకు సైన్ ఇన్ చేయండి.</translation>
<translation id="3667616615096815454">ఇన్‌స్టాల్ చేయడం సాధ్యపడలేదు, అప్లికేషన్‌ను సర్వర్ గుర్తించలేదు.</translation>
<translation id="5585500151754164442">మీ Browther ఖాతాలో Browther డేటా మొత్తాన్ని ఎన్‌క్రిప్ట్ చేయడానికి మీ <ph name="BEGIN_LINK"/>స్వంత రహస్య పదబంధాన్ని<ph name="END_LINK"/> ఉపయోగించండి. Google Pay నుండి పేమెంట్ ఆప్షన్‌లు, అడ్రస్‌లు ఎన్‌క్రిప్ట్ అవ్వవు. Braveకు చెందిన బ్రౌజింగ్ హిస్టరీ సింక్ అవ్వదు.</translation>
<translation id="404323216042159951">Browther మీ పాస్‌వర్డ్‌లను చెక్ చేయలేకపోయింది. మీ ఇంటర్నెట్ కనెక్షన్ సరిచూసుకుని, తర్వాత ట్రై చేయండి.</translation>
<translation id="5004936474632127765">కొత్త Browther &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="6236643159256182256">వ్యక్తిగతీకరణ, ఇతర ప్రయోజనాల కోసం Browther, ఇతర Browther సర్వీస్‌లను లింక్ చేయండి</translation>
<translation id="3729187154190517324">"ట్యాబ్‌ను, మరిన్నింటిని జోడించండి" బటన్‌ను ఉపయోగించి పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి.</translation>
<translation id="1400697664933775238">Browther ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="2461315395128103158">Browther కొన్ని డౌన్‌లోడ్‌లను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="8058420662026104226">దేనికైనా మీ రివ్యూ అవసరం అయితే, Browther మీకు తెలియజేస్తుంది</translation>
<translation id="3177448557921912221">Browther ప్రొఫైల్స్ మీ జీవితానికి సంబంధించిన వేర్వేరు విభాగాలను విడి విడిగా ఉంచడంలో మీకు సహాయపడతాయి. ఇప్పుడే కొత్త ప్రొఫైల్‌ను జోడించండి.</translation>
<translation id="1541177876035612043">Browther మీరు చూసే అవకాశం ఉన్న పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని చూసినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="3810973564298564668">మేనేజ్ చేయండి</translation>
<translation id="1117103475254549453">మీరు సేవ్ చేసిన పాస్‌వర్డ్‌లను ఉపయోగించడానికి, QR కోడ్‌ను ఫాలో అయ్యి, iOSకు సంబంధించిన Braveను డౌన్‌లోడ్ చేసి, ఆపై మీ Browther ఖాతాకు సైన్ ఇన్ చేయండి</translation>
<translation id="8880695882192156860">Browther చిట్కా: మెరుగైన సురక్షిత బ్రౌజింగ్</translation>
<translation id="3846683726093018685">**సారాంశం:** 30 పదాల కన్నా తక్కువ ఉన్న ఒక వాక్యంలో, స్క్రీన్‌షాట్‌లో ప్రధాన సబ్జెక్ట్, కంటెంట్ ఉద్దేశాన్ని వివరించండి.

          **ప్రశ్నలను సూచించండి:** స్క్రీన్‌షాట్‌ను బాగా అర్థం చేసుకోవడానికి యూజర్ అడగగలిగే ఆలోచనను రేకెత్తించే విధంగా ఉండే 3-5 ప్రశ్నల బుల్లెట్‌లతో కూడిన లిస్ట్‌ను జెనరేట్ చేయండి. ఈ ప్రశ్నలలో కనీసం ఒక విజువల్ ఆబ్జెక్ట్, దాని డిజైన్, లేదా దాని లొకేషన్‌కు సంబంధించి నిర్దిష్టంగా ఒక ప్రశ్న అయినా ఉండాలి.</translation>
<translation id="6004388035596644950"><ph name="PAGE_TITLE"/> - Browther Origin</translation>
<translation id="3885770153807205175">భాష సెలెక్టర్</translation>
<translation id="4861846616763552424">Braveను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. మీరు గమనించాల్సిన విషయం ఒకటి ఉంది - వివరాల కోసం క్లిక్ చేయండి.</translation>
<translation id="6126366281251241386">Braveను తెరిచి, బ్రౌజింగ్‌ను ప్రారంభించడానికి మీ పేరును క్లిక్ చేయండి.</translation>
<translation id="3892148308691398805">టెక్స్ట్‌ను కాపీ చేయి</translation>
<translation id="3760801273210219822"><ph name="EXISTING_USER"/> ఇప్పటికే ఈ Browther ప్రొఫైల్‌కు సైన్ ఇన్ చేశారు. మీరు బ్రౌజ్ చేసిన వాటిని విడిగా ఉంచడానికి, Browther మీ కోసం మీ సొంత ప్రొఫైల్‌ను క్రియేట్ చేయగలదు.</translation>
<translation id="3821553157234855663">మీ Braveను అనుకూలంగా మార్చండి</translation>
<translation id="3941890832296813527">ఇన్‌స్టలేషన్ ఎర్రర్: ఇన్‌స్టాలర్ ఫైల్ పేరు చెల్లదు లేదా సపోర్ట్ చేయదు.</translation>
<translation id="6482299900191767005">పాస్‌వర్డ్‌లను కాపీ చేయడానికి Browther ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="5853011008278898603">మీరు Browther ఖాతాలో సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, పేమెంట్ ఆప్షన్‌లు, ఇంకా అడ్రస్‌లు ఈ పరికరం నుండి తీసివేయబడతాయి. వాటిని మళ్లీ Braveలో ఉపయోగించడానికి, తిరిగి సైన్ ఇన్ చేయండి.</translation>
<translation id="395904275706073188">ప్రొటెక్షన్ ఉన్న పేజీలను రీడ్ చేయడం సాధ్యం కాలేదు. వేరే పేజీని ట్రై చేయండి.</translation>
<translation id="1832973663231751701">Browther మిమ్మల్ని ఎలా సురక్షితంగా ఉంచుతుందో తెలుసుకోండి</translation>
<translation id="4531502594774670767">మీరు అడ్రస్ బార్ లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, Browther మీరు టైప్ చేసే దాన్ని మీ సంస్థకు సంబంధించిన సెర్చ్, AI, ఇంకా ఏజెంట్ టూల్స్‌కు పంపి, మీకు సూచనలను అందిస్తుంది.</translation>
<translation id="300013383485253006">&amp;Browther for Testing పరిచయం</translation>
<translation id="1152920704813762236">ChromeOS గురించి</translation>
<translation id="8126752030994997015">మీరు సైట్‌కు వెళ్లినప్పుడు, Browther మీ IP అడ్రస్‌ను దాచిపెట్టే గోప్యతా సర్వర్ ద్వారా URLకు సంబంధించిన గందరగోళానికి గురి చేసే భాగాన్ని <ph name="BEGIN_LINK"/>Browther సురక్షిత బ్రౌజింగ్<ph name="END_LINK"/>కు పంపుతుంది. ఏదైనా సైట్ అనుమానాస్పదంగా ఉంటే, పూర్తి URLలు, పేజీ కంటెంట్‌కు సంబంధించిన బిట్‌లు కూడా పంపబడతాయి.</translation>
<translation id="3703994572283698466">ChromeOS అనేది <ph name="BEGIN_LINK_LINUX_OSS"/>Linux డెవలప్‌మెంట్ ఎన్విరాన్‌మెంట్<ph name="END_LINK_LINUX_OSS"/> తరహాలోనే, అదనపు <ph name="BEGIN_LINK_CROS_OSS"/>ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS"/> ద్వారా సాధ్యమైంది.</translation>
<translation id="4022972681110646219">స్క్రీన్‌ను అనువదించండి</translation>
<translation id="4023601594785368013">అసలు భాష: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">ఏదైనా యాప్ నుండి Braveలో లింక్‌లను తెరవండి. అలాగే సులభంగా యాక్సెస్ చేయడానికి, అది మీ టాస్క్‌బార్‌కు పిన్ అవుతుంది.</translation>
<translation id="3437506136408403836"><ph name="BEGIN_LINK"/>ప్రస్తుత సెట్టింగ్‌లను<ph name="END_LINK"/> రిపోర్ట్ చేయడం ద్వారా Braveను మెరుగుపరచడంలో సహాయపడండి</translation>
<translation id="4050175100176540509">ముఖ్యమైన భద్రతా మెరుగుదలలు మరియు కొత్త ఫీచర్‌లు తాజా వెర్షన్‌లో అందుబాటులో ఉన్నాయి.</translation>
<translation id="4055805654398742145">Password Manager</translation>
<translation id="2164947358785939495">మీ కంప్యూటర్‌లోని మరో ప్రోగ్రామ్ జోడించిన ఎక్స్‌టెన్షన్ కారణంగా Browther పని చేసే విధానం మారవచ్చు.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{Braveను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}other{Braveను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది. బ్రౌజింగ్ డేటాను తొలగించడం జరుగుతుంది. ఇందులో భాగంగా హిస్టరీ, ఆటోఫిల్, డౌన్‌లోడ్‌లు ఉండవచ్చు.}}</translation>
<translation id="1535413545339990419">Browther పేజీ వివరాలకు వెళ్లండి</translation>
<translation id="692283249649018289">మీ బ్రౌజర్‌కు కొత్త రూపాన్ని అందించడానికి Braveను అనుకూలంగా మార్చండి</translation>
<translation id="6375229634133804834">మీ Braveను అనుకూలంగా మార్చండి</translation>
<translation id="4148957013307229264">వ్యవస్థాపిస్తోంది...</translation>
<translation id="2399933334889379115"><ph name="PAGE_TITLE"/> - నెట్‌వర్క్ సైన్ ఇన్ - Browther</translation>
<translation id="2911246138082876798">Browther కోసం గొప్ప యాప్‌లు, ఆటలు, ఎక్స్‌టెన్షన్‌లు మరియు థీమ్‌లను కనుగొనండి.</translation>
<translation id="2528977475313334293">మీ కంప్యూటర్‌లన్నింటిలో ఈ ఎక్స్‌టెన్షన్‌తో పాటు మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="8244267655940711467">మీ తల్లి/తండ్రి ఛాయిస్‌లతో ఆన్‌లైన్‌లో సురక్షితంగా ఉండటానికి, మీరు ఇప్పటికే <ph name="USER_EMAIL_ADDRESS"/>‌గా సైన్ ఇన్ చేసిన మీ Browther ప్రొఫైల్‌కు మారండి</translation>
<translation id="4222932583846282852">రద్దు చేస్తోంది...</translation>
<translation id="4224210481850767180">ఇన్‌స్టాలేషన్ రద్దు చేయబడింది.</translation>
<translation id="8219359042845534271">మీ Browther డేటాను ఈ ఖాతాకు జోడించాలా?</translation>
<translation id="5520777668172961882">స్టాండర్డ్ రక్షణ కంటే ఎక్కువగా సైట్‌లలోని డేటాను విశ్లేషించి, Braveకు మనుపెన్నడూ తెలియని ప్రమాదకరమైన సైట్‌ల గురించి కూడా ఇది హెచ్చరిస్తుంది. Browther హెచ్చరికలను స్కిప్ చేయడానికి మీరు ఎంచుకోవచ్చు.</translation>
<translation id="2014920019837536689">Browther నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="4341512411059715879">Browther గురించి సహాయాన్ని పొందండి</translation>
<translation id="4281844954008187215">సర్వీస్ నియమాలు</translation>
<translation id="322492684764924424">పేర్కొనబడని ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది. ప్రస్తుతం Browther అమలు చేయబడుతుంటే, దయచేసి దీనిని మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="3813060261346666066">Browther నుండి పాస్‌వర్డ్‌లను ఎగుమతి చేయండి</translation>
<translation id="4304713468139749426">పాస్‌వర్డ్ మేనేజర్</translation>
<translation id="4334241893986177674">ఈ స్క్రీన్‌షాట్ కోసం సెర్చ్ చేయండి</translation>
<translation id="4334294535648607276">డౌన్‌లోడ్ పూర్తయింది.</translation>
<translation id="2177954934431828302">Windows ప్రారంభమైనప్పుడు Braveను ప్రారంభించండి</translation>
<translation id="2472318668926455009">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం ద్వారా మీకు తెలిసిన, మీరు ఇష్టపడే, విశ్వసించే ఫీచర్‌లకు యాక్సెస్‌ను సులభంగా పొందండి. క్విక్ యాక్సెస్ కోసం Browther మీ టాస్క్‌బార్‌కు పిన్ చేయబడుతుంది.</translation>
<translation id="1068681683510904753">మీరు ఈ పరికరాన్ని ఉపయోగించడానికి ముందు సర్వీస్ నియమాలను చదివి, అంగీకరించాలని <ph name="MANAGER"/> కోరుతోంది. ఈ నియమాలు ChromeOS నియమాలను విస్తరింపజేయవు, సవరించవు లేదా పరిమితం చేయవు.</translation>
<translation id="2897580280700805340">ఏదేమైనా Browther నుండి నిష్క్రమించాలా?</translation>
<translation id="4413205837991854510">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="2454897022983434851">బ్యాక్‌గ్రౌండ్‌లో అమలయ్యేందుకు Braveని అనుమతించండి</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK"/>సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/>}other{మీరు వాటిని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK"/>సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">Braveను అనుకూలంగా మార్చండి మరియు నియంత్రించండి</translation>
<translation id="4427306783828095590">ఫిషింగ్, అలాగే మాల్‌వేర్‌ను బ్లాక్ చేయడానికి మెరుగుపరచిన రక్షణ మరింత చేయగలదు</translation>
<translation id="4434353761996769206">ఇన్‌స్టాలర్ ఎర్రర్: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846"><ph name="MANAGER"/>, Braveను మేనేజ్ చేస్తుంది</translation>
<translation id="4007482010626246887">Browther ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="6888322430074420631">Browther for Testing పరిచయం</translation>
<translation id="8912436499620582668">మీ Browther ఖాతాలోని Browther డేటాను ఉపయోగించడానికి, అందులో డేటాను సేవ్ చేయడానికి, మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="4493028449971051158">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా రన్ చేయండి.</translation>
<translation id="4501471624619070934">ఈ దేశంలో యాక్సెస్ పరిమితం చేయబడినందున ఇన్‌స్టలేషన్ విఫలమైంది.</translation>
<translation id="8976207309012239417">ఈ ఎక్స్‌టెన్షన్ అది డేటాను ఎలా సేకరిస్తుంది, దాన్ని ఎలా ఉపయోగిస్తుంది వంటి గోప్యతా పద్ధతులను పబ్లిష్ చేయలేదు. మీరు దాన్ని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది.</translation>
<translation id="8888202093812883067">Browther Originకు స్వాగతం; కొత్త బ్రౌజర్ విండో తెరవబడింది</translation>
<translation id="6391148383688605718">మీ పరిసరాలను మ్యాప్ చేయడానికి, మీ చేతి సంజ్ఞలు అలాగే కదలికలను ట్రాక్ చేయడానికి Braveకి అనుమతి అవసరం</translation>
<translation id="7756445485815468244">మీరు ఇప్పటికే మరొక Browther ప్రొఫైల్‌లో <ph name="USER_EMAIL_ADDRESS"/>‌గా సైన్ ఇన్ చేశారు</translation>
<translation id="137435413163730206">Browther పేజీలను ప్రీ - లోడ్ చేస్తుంది, దీని వల్ల బ్రౌజింగ్, సెర్చింగ్ త్వరగా అవుతుంది. <ph name="BEGIN_LINK"/>ప్రీ - లోడ్ పేజీల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">మీరు హానికరమని భావించే సైట్‌ను రిపోర్ట్ చేసినప్పుడు అందరికీ ఆన్‌లైన్ భద్రతను మెరుగుపరచండి.</translation>
<translation id="3266647901351304597">మీరు సురక్షిత బ్రౌజింగ్‌ను ఆఫ్ చేశారు అలాగే ఫైల్‌ను వెరిఫై చేయడం సాధ్యం కానందున Browther ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="6980208900390333646">మీ ఫోన్‌లో Braveతో Google Lensను ట్రై చేయండి</translation>
<translation id="4594305310729380060">ఈ పరికరంలోని పాస్‌వర్డ్ మేనేజర్‌కు</translation>
<translation id="5282047884678321451">Browther Origin యాప్‌లు</translation>
<translation id="4598116752460667024">లిస్ట్ నుండి ఏదైనా ప్రాసెస్ కోసం సెర్చ్ చేయండి.</translation>
<translation id="4970880042055371251">ChromeOS వెర్షన్</translation>
<translation id="4482468019601425607">దాదాపుగా నవీకృతంగా ఉంది! అప్‌డేట్‌ను పూర్తి చేయడానికి Braveని పునఃప్రారంభించండి.</translation>
<translation id="5517890123509214766">Braveకు చెందిన V8 ఇంజిన్, వెబ్‌సైట్లను స్పీడ్‌గా లోడ్ చేస్తుంది. అయితే సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో తక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="7690070364551268156">మీరు Browther వినియోగ రిపోర్ట్‌లను కూడా షేర్ చేస్తున్నట్లయితే, ఆ రిపోర్ట్‌లలో మీరు సందర్శించే URLలు ఉంటాయి</translation>
<translation id="5020487088453637212">ఈ ప్రొఫైల్‌ను మరొక కంప్యూటర్ (<ph name="HOST_NAME"/>)లో మరో Browther ప్రాసెస్ (<ph name="PROCESS_ID"/>) ఉపయోగిస్తున్నట్లు కనిపిస్తోంది. Browther ప్రొఫైల్‌ను లాక్ చేసినందున అది పాడవదు. ఈ ప్రొఫైల్‌ను వేరే ప్రాసెస్‌లు ఏవీ ఉపయోగించడం లేదని మీకు ఖచ్చితంగా తెలిస్తే, ప్రొఫైల్‌ను అన్‌లాక్ చేసి Braveను మళ్లీ ప్రారంభించవచ్చు.</translation>
<translation id="4680828127924988555">ఇన్‌స్టాలేషన్‌ను రద్దు చేయండి</translation>
<translation id="8134827615154347946">మీ Browther డేటాలో కొంత భాగం ఇంకా మీ Browther ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="3508712423420506333">మీరు సైన్ ఇన్ చేసినప్పుడు, Braveలో మీ Browther ఖాతా నుండి సేవ్ చేసిన మీ పాస్‌వర్డ్‌లు, మరిన్నింటిని ఉపయోగించవచ్చు. <ph name="SHORTCUT"/> మీ Browther సర్వీస్‌ల సెట్టింగ్‌లను మార్చగలదు.</translation>
<translation id="2388739442635757494">ఒకరు ఈ కంప్యూటర్‌లో మునుపు <ph name="ACCOUNT_EMAIL_LAST"/> లాగా Braveకు సైన్ ఇన్ చేశారు. దయచేసి మీ సమాచారాన్ని విడిగా ఉంచేందుకు కొత్త Browther వినియోగదారును క్రియేట్ చేయండి.</translation>
<translation id="4724676981607797757">సపోర్ట్ చేయని ప్రోటోకాల్ ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="8305313684264112434">ఏదేమైనా Braveని మూసివేయాలా?</translation>
<translation id="418155915144835101">Braveకి సంబంధించిన ప్రత్యేక భద్రతా అప్‌డేట్ వర్తింపజేయబడింది. ఇప్పుడే పునఃప్రారంభించండి, మేము మీ ట్యాబ్‌లను పునరుద్ధరిస్తాము.</translation>
<translation id="2683970367518529374">Braveను అడగండి</translation>
<translation id="5064473048847774331">మీరు ఇటీవల వెళ్లలేదు. Browther <ph name="PERMISSION_1"/>, <ph name="PERMISSION_2"/>, మరో <ph name="COUNT"/>‌ను తీసివేసింది.</translation>
<translation id="5941343075741207533">Browther మీ పాస్‌వర్డ్‌లను చెక్ చేయలేకపోయింది. 24 గంటల తర్వాత మళ్లీ ట్రై చేయండి లేదా <ph name="BEGIN_LINK"/>మీ Browther ఖాతాలో పాస్‌వర్డ్‌లను చెక్ చేయండి<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">Brave Searchలో ఉపయోగించే స్పెల్ చెకర్‌నే ఇది ఉపయోగిస్తుంది. మీరు బ్రౌజర్‌లో టైప్ చేసే టెక్స్ట్‌ను Braveకు పంపుతుంది. ఈ ఆప్షన్‌ను తర్వాత ఎప్పుడైనా మీరు సెట్టింగ్‌లలో మార్చవచ్చు.</translation>
<translation id="4581078588976787792">ఖాతా లేకుండా Braveను ఉపయోగించండి</translation>
<translation id="3394520491703535051">mDNS ట్రాఫిక్‌ను అనుమతించడానికి Browther Origin ఇన్‌బౌండ్ నియమం.</translation>
<translation id="6563126962881169552">&amp;Braveను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="4918086044614829423">ఆమోదించు</translation>
<translation id="4918844574251943176">ఇమేజ్ కాపీ చేయబడింది</translation>
<translation id="5240982928057703861">Browther నేపథ్య మోడ్‌లో ఉంది.</translation>
<translation id="3603134280602182991">క్లిక్ చేసి, Browther సైన్ ఇన్ డైలాగ్‌ను మూసివేయండి</translation>
<translation id="6120233890602288442">Browther ప్రొఫైళ్లతో, మీ Browther సంబంధిత అంశాలన్నింటినీ విభజించవచ్చు. ఫ్రెండ్స్, ఫ్యామిలీ కోసం ప్రొఫైళ్లను క్రియేట్ చేయండి, లేదా ఆఫీస్, వినోదం మధ్య ప్రొఫైళ్లను విభజించి ఉపయోగించండి.</translation>
<translation id="5722688387568011881">గెస్ట్‌లు ఎటువంటి హిస్టరీని వదలకుండానే Braveను ఉపయోగించవచ్చు.</translation>
<translation id="7786958592460743302">Braveలో మీ ఖాతా</translation>
<translation id="9114640791491590337">Braveకు మిమ్మల్ని జోడించుకోండి</translation>
<translation id="3536391594566515053">Braveలో Gemini మీ ట్యాబ్‌లలో పని చేయడానికి, మీరు ఇచ్చిన టాస్క్‌లను పూర్తి చేయడానికి ఆటోమేటిక్ బ్రౌజ్‌ను ఉపయోగిస్తుంది. <ph name="LINK_BEGIN"/>మరింత తెలుసుకోండి<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">Browther మీ హ్యాండ్స్‌ను ట్రాక్ చేయడానికి అనుమతి అవసరం</translation>
<translation id="1627123463102858476">మీరు ఇటీవల వెళ్లలేదు. Browther <ph name="PERMISSION_1"/>,‌ <ph name="PERMISSION_2"/>, <ph name="PERMISSION_3"/>ను తీసివేసింది.</translation>
<translation id="5174969993834422967">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, మీ లొకేషన్ బార్ కుడి మూలన ఉన్న నోటిఫికేషన్ చిహ్నాన్ని క్లిక్ చేయండి.</translation>
<translation id="5174983315706567306">తగినంత డిస్క్ స్పేస్ లేదు.</translation>
<translation id="7091313576354542088">Browther ఖాతాకు మళ్లీ ప్రామాణీకరణ అనసరమవుతుంది</translation>
<translation id="9045390598305758496">సేవ్ చేసిన పాస్‌వర్డ్‌లు లేవు. మీరు మీ పాస్‌వర్డ్‌లను సేవ్ చేసినప్పుడు Browther వాటిని చెక్ చేయగలదు.</translation>
<translation id="5686724084351858452">Browther నుండి సైన్ అవుట్ చేయండి</translation>
<translation id="5234764350956374838">తొలగించండి</translation>
<translation id="5254739261293693943">ఈ వీడియో గురించి అడగండి</translation>
<translation id="8165028066129227692">మీ మార్పులను వర్తింపజేయడానికి, Braveని పునఃప్రారంభించండి</translation>
<translation id="5286907366254680517">గుర్తించబడింది</translation>
<translation id="198210130507193824">Browther యాప్‌ను పొందండి</translation>
<translation id="8472078903122489041">Browther అప్‌డేటర్ ఇంటర్నల్ సర్వీస్</translation>
<translation id="5346389065299425353">పలు ట్యాబ్‌లు, ఫైల్స్, టూల్స్‌ను జోడించడం ద్వారా మీ సెర్చ్‌ను మరింత లోతుగా చేయండి</translation>
<translation id="3904682305383981098">Browther మీ రివ్యూ కోసం కొన్ని భద్రతా సిఫార్సులను కనుగొంది</translation>
<translation id="509616246140011182">ఇతర Browther ప్రొఫైల్స్</translation>
<translation id="8214429210535362385">మీరు నిర్వహించబడే ఖాతాతో సైన్ ఇన్ చేస్తున్నారు. దీని నిర్వాహకునికి మీ Browther ప్రొఫైల్‌పై నియంత్రణను అందిస్తున్నారు. మీ యాప్‌లు, బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు, ఇతర సెట్టింగ్‌ల వంటి మీ Browther డేటా శాశ్వతంగా <ph name="USER_NAME"/>కు అనుబంధించబడుతుంది. మీరు Browther ఖాతాల డ్యాష్‌బోర్డ్ ద్వారా ఈ డేటాను తొలగించవచ్చు. కానీ ఈ డేటాను మరో ఖాతాతో అనుబంధించలేరు. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">అదనపు కోడ్: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">వ్యక్తిగతీకరణను పొందడానికి, వెబ్ &amp; యాప్ యాక్టివిటీలో Braveను చేర్చండి</translation>
<translation id="8096544113811780871">Browther కొన్ని ఫైల్స్‌ను ఎందుకు బ్లాక్ చేస్తుందో తెలుసుకోండి</translation>
<translation id="2384387444932590174">Browther నవీకరించబడుతోంది (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">Browther సైన్-ఇన్‌ని అనుమతించండి</translation>
<translation id="6557334704331248411">Browther నుండి తీసివేయండి</translation>
<translation id="5832041381258620673">పనితీరును తగ్గిస్తుంది, కానీ Browther, సైబర్ అటాక్‌ల‌ను ఎదుర్కోవ‌డంలో ఎక్కువ రెసిస్టెన్స్‌ను (నిరోధకతను) చూపిస్తుంది</translation>
<translation id="3763317028635993788">Braveను మీ డిఫాల్ట్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="862357563072119126"><ph name="PAGE_TITLE"/> - Browther Origin బీటా</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌ను పాజ్ చేయమని Browther సిఫార్సు చేస్తుంది}other{మీ బ్రౌజర్ వేగాన్ని తగ్గించే ట్యాబ్‌లను పాజ్ చేయమని Browther సిఫార్సు చేస్తుంది}}</translation>
<translation id="4423621904097888155">Braveకు ఇక ఈ Linux డిస్ట్రిబ్యూషన్‌లో సపోర్ట్ లేనందున అది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="6201726364919996698">ఈ డౌన్‌లోడ్‌ను Browther బ్లాక్ చేసింది, ఎందుకంటే మీ వ్యక్తిగత, సోషల్ నెట్‌వర్క్ ఖాతాలకు ఆ ఫైల్ హాని కలిగించగలదు</translation>
<translation id="7679204468655335605">ఈ సైట్‌తో మీ లొకేషన్‌ను షేర్ చేయడానికి Braveకు మీ లొకేషన్ యాక్సెస్ అవసరం</translation>
<translation id="1163572992704966942">దయచేసి Browther తాజా సిస్టమ్ అప్‌డేట్‌లను ఇన్‌స్టాల్ చేస్తున్నప్పుడు వేచి ఉండండి.</translation>
<translation id="5050118226119231029">పాస్‌వర్డ్‌లను ఎడిట్ చేయడానికి Browther ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="5524890928877629608">సెర్చ్ ఏరియాకు ఎగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT"/>%, ఎగువ <ph name="TOP"/>%</translation>
<translation id="5875549039106594731">Braveలో PDFలను తెరవండి</translation>
<translation id="5536164441519929134">ఈ ట్యాబ్ గురించి<ph name="LINE_BREAK"/>అడగండి</translation>
<translation id="5579324208890605088">స్టార్టప్ ఎర్రర్: దయచేసి ఇన్‌స్టాలర్‌ను అడ్మినిస్ట్రేటర్‌గా కాకుండా ఒక సాధారణ యూజర్‌గా రన్ చేయండి.</translation>
<translation id="202315329304302571">పిన్ అయ్యేలా చేయడానికి ఆటోమేటిక్‌గా Braveను ఉపయోగించండి</translation>
<translation id="5596627076506792578">మరిన్ని ఆప్షన్‌లు</translation>
<translation id="5605834417512968703">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="5618818588972826921">ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడానికి ఏదైనా టెక్స్ట్ లేదా ఇమేజ్‌ను ఎంచుకోండి లేదా ఇమేజ్ సెర్చ్ నుండి ఎగ్జిట్ అవ్వడానికి Escapeను నొక్కండి</translation>
<translation id="5823076755666406442">{0,plural, =0{ఒక Browther అప్‌డేట్ అందుబాటులో ఉంది}=1{ఒక Browther అప్‌డేట్ అందుబాటులో ఉంది}other{ఒక Browther అప్‌డేట్ # రోజులుగా అందుబాటులో ఉంది}}</translation>
<translation id="8414129876440043675">మీరు Braveను మూసివేసినప్పుడల్లా మీ పరికరంలోని సైట్ డేటాను తొలగించండి</translation>
<translation id="5156991567152325333">దయచేసి ఇప్పుడు Braveను మళ్ళీ ప్రారంభించండి</translation>
<translation id="5710072384986281834">dev&amp;din Inc</translation>
<translation id="1536693367017293028">Braveను ఈ భాషలో ప్రదర్శించు</translation>
<translation id="569897634095159764">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. ప్రాక్సీ సర్వర్ ప్రామాణీకరణ కోరుతోంది.</translation>
<translation id="4215338057953170891">Browther ప్రొఫైల్స్ వ్యక్తిగత బ్రౌజింగ్‌ను, పనిని విడి విడిగా ఉంచే వీలును మీకు కల్పిస్తాయి. ఇప్పుడే కొత్త ప్రొఫైల్‌ను జోడించండి.</translation>
<translation id="5366435608642317052">Browther ఇన్‌యాక్టివ్ ట్యాబ్‌ల నుండి మెమరీని ఖాళీ చేస్తుంది. దీని ద్వారా యాక్టివ్ ట్యాబ్‌లకు, ఇతర యాప్‌లకు మరిన్ని కంప్యూటర్ రిసోర్స్‌లు లభిస్తాయి, దీనితో Browther వేగంగా పని చేస్తుంది. మీ ఇన్‌యాక్టివ్ ట్యాబ్‌లకు మీరు తిరిగి వచ్చినప్పుడు, అవి ఆటోమేటిక్‌గా మళ్లీ యాక్టివ్‌గా మారతాయి. <ph name="BEGIN_LINK"/>మెమరీ సేవర్ గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="4941518395341035738">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, మీ ఖాతాలోని Browther డేటాను <ph name="SETTINGS_LINK"/></translation>
<translation id="7763291835437810978">Braveను అనుకూలంగా మార్చండి, కంట్రోల్ చేయండి. Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి.</translation>
<translation id="5809516625706423866">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. HTTP 401 అనధికార యాక్సెస్. దయచేసి మీ ప్రాక్సీ కాన్ఫిగరేషన్‌ను చెక్ చేయండి.</translation>
<translation id="1827132270895283425">Browther V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ Browther అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆఫ్ చేయబడింది.</translation>
<translation id="1553025851718680114">మీ Browther ఖాతాలో Browther డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, Braveను అప్‌డేట్ చేయండి</translation>
<translation id="5824893331272123205">ఈ ప్యానెల్‌ను లోడ్ చేయడం సాధ్యపడలేదు, మళ్లీ ట్రై చేయండి</translation>
<translation id="6642862349634944253">Browther Originకు స్వాగతం</translation>
<translation id="5871205389137001634">ఇమేజ్ సెర్చ్‌ నుండి ఎగ్జిట్ అవ్వడానికి క్లిక్ చేయండి</translation>
<translation id="7586794330537887406">ఈ ఐటెమ్‌లు మాల్‌వేర్‌ను కలిగి ఉన్నట్టుగా Browther కనుగొన్నది:</translation>
<translation id="1666897346518812892">మీ బ్రౌజర్ సెట్టింగ్‌లు అత్యంత సురక్షితంగా ఉండేలా చూసుకోవడానికి Browther క్రమం తప్పకుండా చెక్ చేస్తూ ఉంటుంది. దేనికైనా మీ రివ్యూ అవసరం అయితే, మేము మీకు తెలియజేస్తాము.</translation>
<translation id="5895138241574237353">మళ్ళీ ప్రారంభించండి</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE"/> - నెట్‌వర్క్ సైన్ ఇన్</translation>
<translation id="5924017743176219022">ఇంటర్నెట్‌కు కనెక్ట్ చేస్తోంది...</translation>
<translation id="5941711191222866238">కనిష్టీకరించు</translation>
<translation id="4938357262936377412">మీ పరికరాలన్నింటిలో ఈ బుక్‌మార్క్‌తో పాటు మరిన్ని పొందడానికి, Braveకు సైన్ ఇన్ చేయండి</translation>
<translation id="260974496993853147">Braveను మీకు నచ్చినట్లు సెటప్ చేయండి</translation>
<translation id="5960071705175224773">మీ సెట్టింగ్‌లు తెలియని యాప్ ద్వారా మార్చబడ్డాయి</translation>
<translation id="5968400720580217226">AI మోడ్</translation>
<translation id="8697015289720079159">{COUNT,plural, =1{Braveను 1 నిమిషం పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}other{Braveను # నిమిషాల పాటు ఉపయోగించనప్పుడు, మీ సంస్థ ఆటోమేటిక్‌గా దాన్ని మూసివేస్తుంది.}}</translation>
<translation id="5852664780493076676">సింక్‌ను ప్రారంభించడానికి Braveను అప్‌డేట్ చేయండి</translation>
<translation id="6003112304606738118">డౌన్‌లోడ్ అవుతోంది... <ph name="HOURS"/> గంట(లు) సమయం మిగిలి ఉంది</translation>
<translation id="6009821354356307391">అదనపు క్వెరీని అడగండి</translation>
<translation id="6040143037577758943">మూసివేయండి</translation>
<translation id="2495504229007749358">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Braveకు అనుమతినివ్వండి. నోటిఫికేషన్‌లు అందుతూనే ఉంటాయి.</translation>
<translation id="6038969823662006832">&amp;Braveలో తెరవండి</translation>
<translation id="6069027071882229820">ఇమేజ్‌గా కాపీ చేయండి</translation>
<translation id="6606690217326148454">Braveకు <ph name="EXTENSION_NAME"/> జోడించబడింది</translation>
<translation id="6037324269860323082">Braveను అనుకూలంగా మార్చండి మరియు నియంత్రించండి. అప్‌డేట్ అందుబాటులో ఉంది.</translation>
<translation id="3695768481578778794">ఆన్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Browther వెరిఫై చేయలేదు</translation>
<translation id="4401885752362736126">Braveలో మీ ఖాతా</translation>
<translation id="4310817187912076496">Browther టూల్‌బార్‌లో యాక్సెస్ రిక్వెస్ట్‌లను చూపడానికి ఎక్స్‌టెన్షన్‌ను అనుమతించండి</translation>
<translation id="4602490888173698813"><ph name="FILE_NAME"/> హానికరం, కావున Browther దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="5139243417751674628">Browther త్వరలోనే మూసివేయబడుతుంది, డేటా తొలగించబడుతుంది</translation>
<translation id="4696750309605389299">మీరు ఇక్కడ Browther ప్రొఫైళ్ల మధ్య స్విచ్ అవ్వవచ్చు</translation>
<translation id="7475001351099358916">మీరు కుక్కీలను అనుమతిస్తే, ప్రీ - లోడ్ చేసేటప్పుడు Browther వాటిని ఉపయోగించవచ్చు</translation>
<translation id="6165508094623778733">మరింత తెలుసుకోండి</translation>
<translation id="5975099973700540482">మీ ఖాతాలో Browther డేటాను క్లియర్ చేయండి</translation>
<translation id="6800151735486681860">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు<ph name="LINE_BREAK"/>మీరు పాస్‌వర్డ్‌ను అందించినట్లయితే Browther మీ కోసం ఈ డౌన్‌లోడ్‌ను చెక్ చేస్తుంది. ఫైల్ గురించిన సమాచారం Browther సురక్షిత బ్రౌజింగ్‌కు పంపబడుతుంది, అయితే ఫైల్ కంటెంట్, పాస్‌వర్డ్ మీ పరికరంలో ఉంటాయి.</translation>
<translation id="6182736845697986886">అప్‌డేట్ సర్వర్ అంతర్గత ఎర్రర్ కారణంగా ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="48832130233362517">మీ <ph name="TARGET_DEVICE_NAME"/>లో మీరు Braveకు సైన్ ఇన్ చేశారని నిర్ధారించుకుని, ఆపై మళ్లీ పంపడానికి ట్రై చేయండి.</translation>
<translation id="8868210753005945522">మీ కంప్యూటర్‌లోని మరొక ప్రోగ్రామ్ జోడించిన యాప్ కారణంగా, Browther పని చేసే విధానం మారవచ్చు.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">ఈ కంప్యూటర్‌లో ఇప్పటికే మరింత తాజాదైన Browther వెర్షన్ ఉంది. సాఫ్ట్‌వేర్ పని చేయకపోతే, దయచేసి Braveను అన్ఇన్‌స్టాల్ చేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="9222998061982994203">{0,plural, =0{Browther ఇప్పుడు తిరిగి ప్రారంభించబడుతుంది}=1{1 సెకనులో Browther తిరిగి ప్రారంభించబడుతుంది}other{# సెకన్లలో Browther తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="6239161312595354541">ఈ వీడియో గురించి వివరాలు తెలుసుకోవడానికి ఇమేజ్ సెర్చ్‌ను అడగండి</translation>
<translation id="1755464917870815989">ఫైళ్లను డౌన్‌లోడ్ చేయడానికి Braveకు స్టోరేజ్ యాక్సెస్‌కు సంబంధించిన అనుమతి అవసరం</translation>
<translation id="304681001513922736">Braveలో స్టోర్ చేయబడిన సురక్షితం కాని సైట్‌ల లిస్ట్‌తో కూడిన URLలను చెక్ చేస్తుంది</translation>
<translation id="7785903492969539081">Braveను డిఫాల్ట్ బ్రౌజర్‌గా చేయి</translation>
<translation id="3987833816263696343">Browther నుండి సైన్ అవుట్ చేయాలా?</translation>
<translation id="4723540739671534529">ఈ ట్యాబ్‌లు అదనపు రిసోర్స్‌లను ఉపయోగిస్తున్నాయి. మీ పనితీరును మెరుగుపరచడానికి, వాటిని ఇన్‌యాక్టివ్‌గా ఉంచడానికి Braveకు అనుమతినివ్వండి.</translation>
<translation id="6540151687468239291">మీ Browther ప్రొఫైల్‌ను అనుకూలంగా మార్చండి</translation>
<translation id="770793114032605647">మీ Browther ప్రొఫైల్‌కు పేరు పెట్టండి</translation>
<translation id="385867753870250529">ఒక ఎక్స్‌టెన్షన్ మీరు Braveకి సైన్ ఇన్ చేయాల్సిందిగా కోరుతోంది</translation>
<translation id="2022337046348377650"><ph name="FILE_NAME"/> హానికరం కావచ్చు, కావున Browther దాన్ని బ్లాక్ చేసింది.</translation>
<translation id="45270956603278068">Browther మీ కెమెరాను ఉపయోగిస్తోంది.</translation>
<translation id="6327105987658262776">అప్‌డేట్ ఏదీ అందుబాటులో లేదు.</translation>
<translation id="673633752219771459">Braveలో మరొక వ్యవస్థాపన జరుగుతోంది. దయచేసి తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="1482759407165416070">ఇప్పుడు మీ Browther ఖాతాతో, షేర్ చేయ‌బ‌డిన కంప్యూట‌ర్‌ల‌లో Braveను సులభంగా ఉపయోగించవచ్చు.</translation>
<translation id="5538042432112726532">Browther షార్ట్‌కట్</translation>
<translation id="833085228901080512">ఫైల్ సాధారణంగా డౌన్‌లోడ్ అవ్వని, అలాగే ఇది ప్రమాదకరమైనది అయినందున Browther ఈ డౌన్‌లోడ్‌ను బ్లాక్ చేసింది</translation>
<translation id="491120842288314439">మీరు ఖచ్చితంగా Braveను అన్ఇన్‌స్టాల్ చేయాలనుకుంటున్నారా?</translation>
<translation id="6375219077595103062">Password Managerకు షార్ట్‌కట్‌ను జోడించండి</translation>
<translation id="6388799252195623474">ఈ విషయంలో నాకు సహాయం కావాలి</translation>
<translation id="6715003312952407375">కొనసాగించడానికి, Braveకి <ph name="EMAIL"/>‌తో సైన్ ఇన్ చేయండి. ఇది మీ సంస్థకు సంబంధించిన పాలసీలను మీరు పొందారని నిర్ధారిస్తుంది.</translation>
<translation id="1897845318651970239">కంప్యూటర్ స్క్రీన్‌లో Browther లోగో.</translation>
<translation id="4702069255970029302">Browther Origin అనేది మెరుపు వేగంతో వెబ్‌పేజీలను మరియు యాప్‌ల‌ను అమలు చేసే వెబ్ బ్రౌజర్. ఇది వేగవంతమైనది, స్థిరమైనది మరియు ఉపయోగించడానికి సులభమైనది. Browther Originలో రూపొందించిన మాల్‌వేర్‌ మరియు ఫిషింగ్ రక్షణతో మరింత సురక్షితంగా వెబ్‌లో బ్రౌజ్ చేయండి.</translation>
<translation id="5669767676913031391">Browther మరింత వేగంగా పని చేస్తుంది, JavaScriptను ఉపయోగించే ఫీచర్‌లు డిజైన్ చేసిన విధంగానే పని చేస్తాయి</translation>
<translation id="6436260184216827876">ఇమేజ్ సెర్చ్ అందుబాటులో లేదు. తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="2139300032719313227">ChromeOSను రీస్టార్ట్ చేయండి</translation>
<translation id="6110616900529884221">Browther మీరు సందర్శించే అవకాశం ఉన్న ఇంకా మరిన్ని పేజీలను ప్రీ - లోడ్ చేస్తుంది, తద్వారా మీరు వాటిని సందర్శించినప్పుడు అవి మరింత త్వరగా లోడ్ అవుతాయి</translation>
<translation id="1217194059001819677">ధరలను ట్రాక్ చేయడానికి, ఏదైనా సైట్‌లో ధర తగ్గినప్పుడు అలర్ట్‌లను పొందడానికి మీ ఫోన్‌లో Braveను డౌన్‌లోడ్ చేసుకోండి</translation>
<translation id="7058555680120557198">ఆఫ్‌లో ఉంది • ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Browther వెరిఫై చేయలేదు</translation>
<translation id="676533642429632127">Browther ప్రొఫైళ్లకు స్వాగతం</translation>
<translation id="5518682889576009702">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE"/>‌లో Braveను తెరిచినప్పుడు, ట్యాబ్ గ్రూప్‌లను ఉపయోగించమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="6038105561107837619">Browther నుండి ఖాతాను తీసివేయండి</translation>
<translation id="2675662665675552980">ఇది మీరు Braveని ప్రారంభించేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="648319183876919572">ప్రమాదకరమైన వెబ్‌సైట్‌ల నుండి, డౌన్‌లోడ్‌ల నుండి మెరుగైన సురక్షిత బ్రౌజింగ్ మీకు మరింత రక్షణను అందిస్తుంది</translation>
<translation id="2930243146591999795">Braveను అన్ఇన్‌స్టాల్ చేయి</translation>
<translation id="5241183382286817629">షార్ట్‌కట్‌లు Braveలో తెరవబడతాయి</translation>
<translation id="7907014599435829661">Braveను <ph name="TIMEOUT_DURATION"/> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది. బ్రౌజింగ్ డేటా తొలగించబడింది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="2088471423667794811">ప్రతి ప్రొఫైల్‌లో బుక్‌మార్క్‌లు, హిస్టరీ, పాస్‌వర్డ్‌లు లాంటి దాని సొంత Browther సమాచారం ఉంటుంది</translation>
<translation id="9040334484455218184"><ph name="BEGIN_LINK"/>Browther మీ డేటాను ఎలా ప్రైవేట్‌గా ఉంచుతుంది<ph name="END_LINK"/> అనే దాని గురించి మరింత తెలుసుకోండి</translation>
<translation id="1718697235867382480">Browther రీస్టార్ట్ అయిన తర్వాత ఈ సెట్టింగ్‌కు మార్పులు వర్తింపజేయడం జరుగుతుంది.</translation>
<translation id="6331317152404762758">మీరు మరొక Browther ప్రొఫైల్‌కు మారి, పాస్‌వర్డ్‌లను చూడవచ్చు</translation>
<translation id="6097706403184348562">అక్షరక్రమ లోపాలను పరిష్కరించడానికి, మీరు వచన ఫీల్డ్‌లలో టైప్ చేసే వచనాన్ని, Browther Braveకు పంపుతుంది</translation>
<translation id="2319647238307402812">Browther నోటిఫికేషన్ సెట్టింగ్‌లకు వెళ్లు</translation>
<translation id="6600016381025017075">ఈ పేజీలో దేన్నైనా సెర్చ్ చేయండి</translation>
<translation id="8031938899816118394">మీ మార్పులు మీరు Braveని మరుసటిసారి ప్రారంభించినప్పుడు ప్రభావాన్ని చూపుతాయి.</translation>
<translation id="7412185356697187964">Windows ప్రారంభమైనప్పుడు Browther ఇప్పుడు ప్రారంభమవుతుంది, కాబట్టి మీరు తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించవచ్చు. మీరు దీన్ని సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="9123343592576384616">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: Browther మీ చివరి సెషన్ నుండి మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. మీరు వీటిలో ఆఫ్ చేయవచ్చు</translation>
<translation id="5847926498049048567">మీ పరిసరాల 3D మ్యాప్‌ను క్రియేట్ చేయడానికి Braveకు కెమెరా అనుమతి అవసరం</translation>
<translation id="5532585028508811858">మీ బుక్‌మార్క్‌లను Browther ఖాతాలో కూడా సేవ్ చేస్తే, మీరు Braveలో ప్రోడక్ట్ ధరలను ట్రాక్ చేయవచ్చు, ధర తగ్గినప్పుడు తెలియజేయబడుతుంది</translation>
<translation id="6676384891291319759">ఇంటర్నెట్‌ను యాక్సెస్ చేయండి</translation>
<translation id="1363996462118479832">సైన్ ఇన్ చేయడంలో ఎర్రర్ ఏర్పడినందున ChromeOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="3373239673945775810">Browther నుండి ఈ యాప్ డేటాను తీసివేయండి</translation>
<translation id="8122759674786039814">సైట్‌లు మీకు వ్యక్తిగతీకరించిన యాడ్‌లను చూపినప్పుడు మీకు కనిపించే యాప్‌లపై మరింత కంట్రోల్‌ను, ఇంకా సైట్‌లు మీ గురించి తెలుసుకునే సమాచారాన్ని Browther పరిమితం చేస్తుంది</translation>
<translation id="6277682530398500159">ఈ సైట్ కోసం Braveకు మైక్రోఫోన్ అనుమతి అవసరం</translation>
<translation id="6712881677154121168">డౌన్‌లోడ్ చేయడంలో ఎర్రర్ ఏర్పడింది: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">మీ ప్రొఫైల్, కొత్త Browther వెర్షన్‌కు చెందినది కాబట్టి, దీనిని ఉపయోగించడం సాధ్యపడదు.

కొన్ని ఫీచర్‌లు అందుబాటులో ఉండకపోవచ్చు. దయచేసి వేరొక ప్రొఫైల్ డైరెక్టరీని పేర్కొనండి లేదా Browther యొక్క కొత్త వెర్షన్‌ను ఉపయోగించండి.</translation>
<translation id="871671753163165892">వ్యక్తిగతీకరణను, ఇతర ఫీచర్‌లను పొందడానికి, Braveను 'వెబ్ &amp; యాప్ యాక్టివిటీ'లో, లింక్ అయిన Browther సర్వీస్‌లలో చేర్చండి</translation>
<translation id="5000832110229523807">మీ కంప్యూటర్‌లోని వినియోగదారులందరికీ Browther ఇప్పటికే ఇన్‌స్టాల్ చేయబడింది.</translation>
<translation id="5204575479550973859">మీ డివైజ్‌లన్నింటిలో మీ పాస్‌వర్డ్‌లను, బుక్‌మార్క్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి మీరు సైన్ ఇన్ చేసిన తర్వాత ఈ బుక్‌మార్క్ మీ Browther ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="2874208284092283937">Browther V8 ఇంజిన్‌తో సైట్‌లను వేగవంతం చేస్తుంది కానీ Browther అటాక్‌లకు కొద్దిగా తక్కువ నిరోధకతను కలిగిస్తుంది. ఈ సెట్టింగ్ ఆన్ చేయబడింది.</translation>
<translation id="3268577459683869744">{count,plural, =1{మీ Browther డేటాలో కొంత భాగం, ఇంకా మీ Browther ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా (1 ఐటెమ్) తొలగించబడుతుంది.}other{మీ Browther డేటాలో కొంత భాగం, ఇంకా మీ Browther ఖాతాలో సేవ్ కాలేదు. సైన్ అవుట్ చేయడానికి ముందు, కొన్ని నిమిషాలు వేచి ఉండటానికి ట్రై చేయండి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా ({count} ఐటెమ్‌లు) తొలగించబడుతుంది.}}</translation>
<translation id="7683816018918395929">ఈ ఫైల్ ప్రమాదకరమైనది కావచ్చు, కాబట్టి దీనిని స్కాన్ చేయమని Browther సిఫార్సు చేస్తోంది.</translation>
<translation id="1547295885616600893">ChromeOS అనేది అదనపు <ph name="BEGIN_LINK_CROS_OSS"/>ఓపెన్ సోర్స్ సాఫ్ట్‌వేర్<ph name="END_LINK_CROS_OSS"/> ద్వారా సాధ్యమైంది.</translation>
<translation id="6831043979455480757">అనువదించు</translation>
<translation id="2142653375108595728">మీ పాస్‌వర్డ్‌లు ఎప్పుడైనా హ్యాక్ అయితే, Browther మీకు తెలియచేస్తుంది</translation>
<translation id="684888714667046800">ఇంటర్నెట్‌కు కనెక్ట్ చేయడం సాధ్యపడలేదు. మీరు ఫైర్‌వాల్‌ను ఉపయోగిస్తుంటే, దయచేసి <ph name="PRODUCT_EXE_NAME"/> వైట్‌లిస్ట్‌లో ఉందని నిర్ధారించుకోండి.</translation>
<translation id="7333549743055076502">Browther - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">కొనసాగించడానికి ట్యాబ్ చేయండి</translation>
<translation id="6862030660799253820">ఇమేజ్ సెర్చ్‌తో ఈ ఇమేజ్‌ను సెర్చ్ చేయండి</translation>
<translation id="3860339351709082396">"<ph name="EXTENSION_NAME"/>"లో మాల్‌వేర్ ఉన్నట్టుగా Browther కనుగొన్నది</translation>
<translation id="6877155553248388166">సెర్చ్ ఏరియాకు దిగువ కుడి మూలన: కుడి వైపు <ph name="RIGHT"/>%, దిగువ <ph name="BOTTOM"/>%</translation>
<translation id="6896758677409633944">కాపీ చేయండి</translation>
<translation id="7804113502310231166">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, దానిని మీ టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="3228374215117173004">&amp;Browther ప్రొఫైల్స్‌ను మేనేజ్ చేయండి</translation>
<translation id="6934579572334859869">ఈ ఇమేజ్ గురించి వివరాలు తెలుసుకోవడానికి ఇమేజ్ సెర్చ్‌ను అడగండి</translation>
<translation id="5995328366516663808">మీరు Browther పరిమితి అయిన <ph name="BOOKMARK_LIMIT"/> బుక్‌మార్క్‌లను చేరుకున్నారు, కాబట్టి మీ బుక్‌మార్క్‌లలో కొన్ని ఇంకా మీ Browther ఖాతాలో సేవ్ కాలేదు.

మీరు కొన్ని బుక్‌మార్క్‌లను తొలగించే వరకు మీ ఖాతాలో కొత్త బుక్‌మార్క్‌లను సేవ్ చేయడం సాధ్యపడదు. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, సేవ్ చేయని బుక్‌మార్క్‌లు తొలగించబడతాయి.</translation>
<translation id="6965382102122355670">సరే</translation>
<translation id="4533562834763015352">బలహీనమైన పాస్‌వర్డ్‌లను ఊహించడం చాలా సులభం. <ph name="BEGIN_LINK"/>మీ కోసం శక్తివంతమైన పాస్‌వర్డ్‌లను క్రియేట్ చేయడం, గుర్తుంచుకోవడం<ph name="END_LINK"/> చేయడానికి Braveను అనుమతించండి.</translation>
<translation id="3453763134178591239">ChromeOS నియమాలు</translation>
<translation id="5379058926689137454">ఈ సైట్ కోసం మీ మైక్రోఫోన్‌ను యాక్సెస్ చేయడానికి Braveకు అనుమతి అవసరం</translation>
<translation id="4684462982894889021">మీ ఖాతా <ph name="ACCOUNT_EMAIL"/>‌లో Browther డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="7011190694940573312">ఈ వెర్షన్ ఆపరేటింగ్ సిస్టమ్ సపోర్ట్ చేయనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="7024536598735240744">డెవలపర్ మోడ్‌లో ఉన్న ఎర్రర్: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ఇన్‌స్టాలేషన్ ఆగిపోయింది.</translation>
<translation id="8257174622576051374">Braveను మీకు నచ్చిన విధంగా తయారు చేసుకోండి</translation>
<translation id="7047386856539490735">ఈ ఫలితాలు ఉపయోగకరంగా ఉన్నాయా?</translation>
<translation id="1772745060691790742">Braveను అప్‌డేట్ చేయి</translation>
<translation id="4937970118065051027">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి Browther ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Braveకు పంపబడతాయి.</translation>
<translation id="1594112132009288601">Browther for Testingను అనుకూలంగా మార్చండి</translation>
<translation id="5915000938288527952">మీరు మెసేజ్‌ల్లో, డాక్యుమెంట్‌ల్లో, ఇంకా ఇతర యాప్‌ల్లో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Braveను ఉపయోగించవచ్చు</translation>
<translation id="8775664994493381735">Browther నుండి <ph name="EXTENSION_NAME"/>‌ను తీసివేయండి</translation>
<translation id="3276648807841991013">Browther డేటాను <ph name="TIMEOUT_DURATION"/> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని తొలగిస్తుంది. ఈ తొలగించబడే డేటాలో హిస్టరీ, ఆటోమేటిక్‌గా పూరించబడిన డేటా, ఇంకా డౌన్‌లోడ్‌లు ఉండవచ్చు.</translation>
<translation id="4725226878394159809">ఈ సైట్ కోసం Braveకు కెమెరా అనుమతి అవసరం</translation>
<translation id="8931474625901592021">Braveను ప్రారంభించడం సాధ్యపడలేదు. మళ్లీ ట్రై చేయండి.</translation>
<translation id="8242947409070121799">Browther మీ పాస్‌వర్డ్‌లను చెక్ చేయలేకపోయింది. 24 గంటల తర్వాత మళ్లీ ట్రై చేయండి.</translation>
<translation id="1737922827960215472">Braveను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని మీ డాక్‌లో ఉంచుకోండి</translation>
<translation id="335855266303176628">మీరు మెసేజ్‌లలో, డాక్యుమెంట్‌లలో, ఇంకా ఇతర యాప్‌లలో ఉండే లింక్‌లను క్లిక్ చేసినప్పుడల్లా Braveను ఉపయోగించండి</translation>
<translation id="709455597778444012">విధి నిర్వాహకుడు - Browther</translation>
<translation id="7147140345767587643">Browther అంచనా ఆధారంగా మీ ఆసక్తులు</translation>
<translation id="7337408274890534789">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించండి: Windows ప్రారంభమైనప్పుడు Browther ఇప్పుడు ప్రారంభించబడుతుంది.</translation>
<translation id="7274695763216404502">పిన్ చేశారు! టూల్‌బార్ నుండి ఇమేజ్ సెర్చ్‌ను మళ్లీ ఉపయోగించండి</translation>
<translation id="7288567540154601580">ట్యాబ్‌లు, ఎక్స్‌టెన్షన్‌లు</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{మీరు దాన్ని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది}other{మీరు వాటిని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది}}</translation>
<translation id="1527644038571473502">సిస్టమ్ ఆడియోను షేర్ చేయడానికి, సిస్టమ్ సెట్టింగ్‌లను తెరిచి, Browther కోసం 'సిస్టమ్ ఆడియో రికార్డింగ్ మాత్రమే'ను అనుమతించండి. ఆపై మీరు Braveను రీస్టార్ట్ చేయాలి.</translation>
<translation id="1427913074981060872">మీరు సందర్శించే సైట్‌లను Browther నుండి సమాచారాన్ని రిక్వెస్ట్ చేసేలా 'యాడ్‌ల అంచనా' అనుమతిస్తుంది, ఇది యాడ్‌ల పనితీరును అంచనా వేయడంలో సైట్‌కు సహాయపడుతుంది. 'యాడ్‌ల అంచనా', సైట్‌ల మధ్య వీలయినంత తక్కువ సమాచారాన్ని బదిలీ చేసి, క్రాస్-సైట్ ట్రాకింగ్‌ను తగ్గిస్తుంది.</translation>
<translation id="1657652725060525338">Braveని అప్‌డేట్ చేస్తోంది</translation>
<translation id="884846289464870238">మీ ప్రాధాన్యతల ఫైల్ పాడైంది లేదా చెల్లదు. Browther మీ సెట్టింగ్‌లను పునరుద్ధరించలేకపోయింది.</translation>
<translation id="7339898014177206373">కొత్త విండో</translation>
<translation id="633044855886370183">మీ వెబ్, బుక్‌మార్క్‌లు మరియు ఇతర Browther అంశాలు ఇక్కడ చూపబడతాయి.</translation>
<translation id="1185960088713242527">మీ రహస్య పదబంధం ఉన్న కొంతమంది మాత్రమే ఎన్‌క్రిప్ట్ చేసిన మీ డేటాను చదవగలరు. రహస్య పదబంధం Braveకు పంపబడదు లేదా Braveలో స్టోర్ అవ్వదు. మీరు మీ రహస్య పదభందాన్ని మర్చిపోతే లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకుంటే, మీరు <ph name="BEGIN_LINK"/>మీ ఖాతాలోని Browther డేటాను తొలగించాల్సి ఉంటుంది<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110"><ph name="TARGET_URL_HOSTNAME"/>ను యాక్సెస్ చేయడం కోసం <ph name="ALTERNATIVE_BROWSER_NAME"/>ను తెరిచే విధంగా Braveను మీ సిస్టమ్ నిర్వాహకుడు కాన్ఫిగర్ చేశారు.</translation>
<translation id="7352651011704765696">ఏదో తప్పు జరిగింది</translation>
<translation id="6638123710106659002">భవిష్యత్తులో Browther అప్‌డేట్‌లను పొందడానికి, మీకు macOS 13 కానీ, అంతకన్నా లేటెస్ట్ వెర్షన్ కానీ ఉండాలి. ఈ కంప్యూటర్ macOS 12 వెర్షన్‌ను ఉపయోగిస్తోంది.</translation>
<translation id="7286289384512061761">మీరు ఇటీవల వెళ్లలేదు. Browther <ph name="PERMISSION_1"/>,‌ <ph name="PERMISSION_2"/>ను తీసివేసింది.</translation>
<translation id="113593073175678746">ఈ ఎక్స్‌టెన్షన్ ఇకపై సపోర్ట్ చేయదు. బదులుగా దాన్ని తీసివేయమని Browther సిఫార్సు చేస్తోంది.</translation>
<translation id="137615076640044304">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ Browther మీ ట్యాబ్‌లను రీస్టోర్ చేస్తుంది. దీన్ని ఆఫ్ చేసి, ఇక్కడికి వెళ్లండి</translation>
<translation id="5967238175620483220">Braveకు పాస్‌వర్డ్‌లను దిగుమతి చేయండి</translation>
<translation id="4935019315986703336"><ph name="PAGE_TITLE"/> - Browther Origin Dev</translation>
<translation id="7450541714075000668">టెక్స్ట్ కాపీ చేయబడింది</translation>
<translation id="7766009218653304791">ఈ సైట్ కోసం మీ కెమెరాను యాక్సెస్ చేయడానికి Braveకు అనుమతి అవసరం</translation>
<translation id="5844418066487488520">మైక్రోఫోన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK"/>సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK"/>‌లో Braveకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="8065480549334161841">భవిష్యత్తులో Browther అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 7ను ఉపయోగిస్తోంది.</translation>
<translation id="6299293759264950896">Braveను రీ-లాంచ్ చేయాలా?</translation>
<translation id="180908550381040105">ప్రస్తుతం అమలు అవుతోన్న అదే Browther వెర్షన్‌ను ఇన్‌స్టాల్ చేయలేరు. దయచేసి Braveను మూసివేసి, మళ్లీ ట్రై చేయండి.</translation>
<translation id="7625576878150380853">మీరు Braveకి సైన్ ఇన్ చేసినప్పుడల్లా, మీ Browther ఖాతాలో పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని సేవ్ చేస్తారు, ఉపయోగిస్తారు. <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">సైట్‌లు బహుశా ఊహించిన విధంగా పని చేస్తాయి. మీరు Braveకు సైన్ ఇన్ చేసినట్లయితే మీ Browther ఖాతా మినహా అన్ని Browther విండోలను మూసివేసినప్పుడు మీరు చాలా సైట్‌ల నుండి సైన్ అవుట్ చేయబడతారు.</translation>
<translation id="7099370564362681943">{0,plural, =1{1 నిమిషంలో Browther తిరిగి ప్రారంభించబడుతుంది}other{# నిమిషాల్లో Browther తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="3602613943932672197">మీ డేటాను సురక్షితంగా ఉంచడానికి, మీరు ఇటీవల ఉపయోగించని సైట్‌లకు అనుమతులను తీసివేయడానికి Braveకు అనుమతినివ్వండి.</translation>
<translation id="8759568213742229377">తక్షణమే బ్రౌజింగ్‌ను ప్రారంభించడానికి Braveను ఆటోమేటిక్‌గా లాంచ్ చేయండి.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> ఇన్‌స్టాలర్</translation>
<translation id="8991800242749014880">Browther మీ కెమెరా మరియు మైక్రోఫోన్‌ని ఉపయోగిస్తోంది.</translation>
<translation id="2692328388439821508">Browther ఇప్పుడు మెరుగైంది</translation>
<translation id="4318444066563223295">ఇప్పుడు మీకు Braveలో మరిన్ని ఫీచర్లు అందుబాటులో ఉన్నాయి</translation>
<translation id="7649070708921625228">సహాయం</translation>
<translation id="5591287320769313116">మీ కోసం బ్రౌజ్ చేయడానికి Braveను అనుమతించండి</translation>
<translation id="7658239707568436148">రద్దు చేయండి</translation>
<translation id="6325482130534634729">Browther మీ డిఫాల్ట్ బ్రౌజర్ కాదు</translation>
<translation id="8185915921134219287">మీ పరికరాల అంతటా Braveను సింక్ చేయండి మరియు వ్యక్తిగతీకరించండి</translation>
<translation id="5120421624925726813">Browther అప్‌డేట్</translation>
<translation id="7716950018788545737">టాస్క్(లు) ముగిసింది.</translation>
<translation id="77283119132245232"><ph name="BROWSER_NAME"/>‌కు సిస్టమ్‌ను ట్రేస్ చేసే సర్వీస్‌లను అందిస్తోంది. ఈ సర్వీస్ డిజేబుల్ అయితే, బ్రౌజర్ ద్వారా క్రియేట్ అయిన పనితీరు ట్రేస్‌లలో కాంటెక్స్ట్ స్విచ్, సిద్ధంగా ఉన్న థ్రెడ్ ఈవెంట్‌ల వంటి సిస్టమ్ అంతటికీ సంబంధించిన ఈవెంట్‌లు ఉండవు.</translation>
<translation id="6542096191573265107">ఇది ఈ పరికరం నుండి మీ బ్రౌజింగ్ డేటాను తొలగిస్తుంది. మీ డేటాను తర్వాత తిరిగి పొందడానికి, Braveకు <ph name="USER_EMAIL"/> లాగా సైన్ ఇన్ చేయండి.</translation>
<translation id="7747138024166251722">ఇన్‌స్టాలర్ ఒక తాత్కాలిక డైరక్టరీని సృష్టించలేకపోయింది. సాఫ్ట్‌వేర్‌ను ఇన్‌స్టాల్ చేయడానికి దయచేసి ఖాళీ డిస్క్ స్థలం, అనుమతిని చెక్ చేయండి.</translation>
<translation id="351575328720488268">ఆటోమేటిక్‌గా ఉండే Browther రూపానికి రీసెట్ చేయండి</translation>
<translation id="1054170408395182418">Braveను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="4569594230301902490">Braveను వేగవంతం చేయండి</translation>
<translation id="8041924294044943913"><ph name="PAGE_TITLE"/> - Browther Origin Canary</translation>
<translation id="7893465573639396635">మీ ఇంటర్నెట్ ట్రాఫిక్‌కు యాక్సెస్ ఉన్న వ్యక్తులు మీరు బ్రౌజ్ చేసే సైట్‌లను చూడటం కష్టతరం చేయండి. DNS (డొమైన్ నేమ్ సిస్టమ్)లో సైట్ IP అడ్రస్‌ను చూసేందుకు Browther సురక్షితమైన కనెక్షన్‌ను ఉపయోగిస్తుంది.</translation>
<translation id="7810005234485217901">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు</translation>
<translation id="2462631024103158515">ఈ పరికరంలో ఇప్పటికే ఈ ఖాతాతో ఒక Browther ప్రొఫైల్ ఉంది</translation>
<translation id="7845233973568007926">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME"/>‌ను ఉపయోగించడానికి ముందు మీరు కంప్యూటర్‌ను తప్పకుండా రీస్టార్ట్ చేయాలి.</translation>
<translation id="311190437086049332">Braveకు కొత్త రూపాన్ని అందించడానికి దాన్ని అనుకూలంగా మార్చండి</translation>
<translation id="6728847658878265103">Braveను తాజా వెర్షన్‌కు అప్‌డేట్ చేయడం సాధ్యం కాలేదు, కాబట్టి మీరు కొత్త ఫీచర్‌లు మరియు భద్రతా పరిష్కారాలను పొందడం లేదు.</translation>
<translation id="7872446069773932638">డౌన్‌లోడ్ అవుతోంది... <ph name="SECONDS"/> సెకను(లు) సమయం మిగిలి ఉంది</translation>
<translation id="5374532739787768601">మీ రహస్య పదబంధాన్ని మీరు మర్చిపోయినా లేదా ఈ సెట్టింగ్‌ను మార్చాలనుకున్నా, <ph name="BEGIN_LINK"/>మీ ఖాతాలోని Browther డేటాను తొలగించండి<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">ఈ ఇమేజ్ గురించి వివరాలు తెలుసుకోవడానికి అడగండి</translation>
<translation id="9172499982238113829">Braveను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయండి</translation>
<translation id="3313826726620159669">వీలైనప్పుడు, Browther ఆటోమేటిక్‌గా సురక్షితం కాని కనెక్షన్‌లను HTTPSకు అప్‌గ్రేడ్ చేస్తుంది</translation>
<translation id="3317928686912559532">మీరు <ph name="USER_EMAIL_ADDRESS"/>గా Braveకు సైన్ ఇన్ చేశారు. దయచేసి మళ్లీ సైన్ ఇన్ చేయడానికి ఇదే ఖాతాను ఉపయోగించండి.</translation>
<translation id="6007009085341946457">ఇది Browther రెండవ ఇన‌స్ట‌లేష‌న్. దీన్ని మీ డిఫాల్ట్ బ్రౌజర్‌గా చేయడం సాధ్యపడదు.</translation>
<translation id="8004582292198964060">బ్రౌజర్</translation>
<translation id="8010081455002666927">ఆటోమేటిక్ గుర్తింపు</translation>
<translation id="174885789898161653">ఓసారి Braveకి యాక్సెస్ లభించాక, ఆపై వెబ్‌సైట్‌లకు ఏమైనా యాక్సెస్‌ కావాలంటే అవి మిమ్మల్ని అడగవచ్చు.</translation>
<translation id="3001754454174546602">Braveను మీకు కావలసినప్పుడల్లా త్వరగా పొందడానికి దాన్ని టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="80471789339884597">ఇన్‌స్టాల్ చేసినందుకు ధన్యవాదాలు. <ph name="BUNDLE_NAME"/>‌ను ఉపయోగించే ముందు మీరు తప్పకుండా మీ అన్ని బ్రౌజర్‌లను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8054112667659782652">ఇమేజ్ సెర్చ్ షార్ట్‌కట్‌ను ఎల్లప్పుడూ చూపించండి</translation>
<translation id="6993312779622863465">యాప్‌లకు సంబంధించి బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతున్న Braveను డిజేబుల్ చేయండి</translation>
<translation id="80790299200510644">ఇమేజ్ సెర్చ్</translation>
<translation id="8086881907087796310">మీ కంప్యూటర్ కనీస హార్డ్‌వేర్ అవసరాలకు అనుగుణంగా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="3217614128548917842"><ph name="PAGE_TITLE"/> - Browther Origin for Testing</translation>
<translation id="543407324609820492">ఈ సైట్ కోసం Braveకు లొకేషన్ అనుమతి అవసరం</translation>
<translation id="1767887552863788514">మీరు నెక్స్ట్ టైమ్ మీ <ph name="DEVICE_TYPE"/>‌లో Braveను తెరిచినప్పుడు, ధర ట్రాకింగ్ అలర్ట్‌లను ఎనేబుల్ చేయమని మీకొక ప్రాంప్ట్ కనిపిస్తుంది.</translation>
<translation id="8118331347066725040">Lensతో సెర్చ్ చేయడం కోసం ఫీడ్‌బ్యాక్‌ను పంపండి</translation>
<translation id="5334309298019785904">మీ డొమైన్ కోసం సింక్ అందుబాటులో లేనందున, ChromeOS మీ డేటాను సింక్ చేయలేకపోయింది.</translation>
<translation id="813913629614996137">ప్రారంభిస్తోంది...</translation>
<translation id="4879101934056397619">Browther అదనపు సర్వీస్ నియమాలు</translation>
<translation id="4505690237431768764">ఈ ఫైల్ అపాయకరమైనది, కాబట్టి Browther దీన్ని బ్లాక్ చేసింది.</translation>
<translation id="8177472873527554730">పేజీలో కంటెంట్ కనుగొనడం సాధ్యం కాలేదు</translation>
<translation id="4720341280133158605">మీ ఖాతా, <ph name="USER_EMAIL"/>‌లో Browther డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి మీ రహస్య పదబంధాన్ని ఎంటర్ చేయండి</translation>
<translation id="8221491193165283816">మీరు సాధారణంగా నోటిఫికేషన్‌లను బ్లాక్ చేస్తుంటారు. ఈ సైట్ నుండి నోటిఫికేషన్‌లను పొందాలంటే, ఇక్కడ క్లిక్ చేయండి.</translation>
<translation id="1083711467946065278">మీ కెమెరాను ఉపయోగించడానికి, <ph name="BEGIN_LINK"/>సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK"/>‌లో Braveకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="6569785137733211804">ఈ ఎక్స్‌టెన్షన్ ఎక్కడ నుండి వచ్చిందో Browther వెరిఫై చేయడం సాధ్యం కాదు, ఇది సురక్షితం కాకపోవచ్చు. Browther నుండి దాన్ని తీసివేయండి, తద్వారా ఇది వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="1122818205373648656">చిత్రంలో ఉపయోగకరమైన వివరణ లేకుంటే, మీ కోసం ఒక వివరణను అందించడానికి Browther ప్రయత్నిస్తుంది. వివరణలను క్రియేట్ చేయడానికి, చిత్రాలు Braveకు పంపబడతాయి. మీరు దీన్ని ఎప్పుడైనా సెట్టింగ్‌లలో ఆఫ్ చేయవచ్చు.</translation>
<translation id="6877990294324319801">కొత్త ప్రొఫైల్‌లో Braveకి సైన్ ఇన్ చేయాలా?</translation>
<translation id="6478811748813986578">సురక్షితం కాని సైట్‌లు, డౌన్‌లోడ్‌ల గురించి <ph name="BEGIN_LINK"/>Browther మిమ్మల్ని హెచ్చరిస్తుంది<ph name="END_LINK"/></translation>
<translation id="1685486387921540822">మీరు ఇటీవల వెళ్లలేదు. Browther <ph name="PERMISSION"/>‌ను తీసివేసింది.</translation>
<translation id="8921153410460268589">Browther iOS యాప్‌లో మీ కెమెరాతో మీరు చూసే వాటిని షాపింగ్ చేయండి, అనువదించండి, అలాగే గుర్తించండి</translation>
<translation id="8313851650939857356">స్టార్టప్ ఎర్రర్: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">Braveను <ph name="TIMEOUT_DURATION"/> సమయం పాటు వినియోగించకపోతే, మీ సంస్థ దానిని మూసివేస్తుంది.</translation>
<translation id="8321888067342493336">ఇమేజ్‌గా సేవ్ చేయండి</translation>
<translation id="143016831128278157">మీ పరికరాల అంతటా Braveను సింక్ చేయడానికి, వ్యక్తిగతీకరించడానికి సైన్ ఇన్ చేయండి</translation>
<translation id="4784945022248750283"><ph name="USER_EMAIL_ADDRESS"/> మునుపు Braveని ఉపయోగించింది</translation>
<translation id="1288164710697017468">మీ Browther ఖాతా <ph name="ACCOUNT_EMAIL"/>‌లోని Browther డేటాను ఉపయోగించేందుకు Braveను అప్‌డేట్ చేయండి</translation>
<translation id="8648401677359150296">భవిష్యత్తు Browther అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8ను ఉపయోగిస్తోంది.</translation>
<translation id="8362914115861174987">ఈ భాషలోకి అనువదించండి</translation>
<translation id="8367705492654390392">ఏదైనా అడగండి</translation>
<translation id="5769022907892823357">మీ పరికరాలన్నిటిలో మీ పాస్‌వర్డ్‌లను, ఇంకా మరిన్నింటిని పొందడానికి Braveకు సైన్ ఇన్ చేయండి. ఈ పాస్‌వర్డ్, మీరు సైన్ ఇన్ చేసిన తర్వాత మీ Browther ఖాతాలో సేవ్ అవుతుంది.</translation>
<translation id="4782442810031768771">ఆపై మీరు Braveను రీస్టార్ట్ చేయాలి.</translation>
<translation id="8265348385714408341">మీరు దాన్ని తీసివేయవలసిందిగా Browther సిఫార్సు చేస్తోంది. <ph name="BEGIN_LINK"/>సపోర్ట్ చేసే ఎక్స్‌టెన్షన్‌ల గురించి మరింత తెలుసుకోండి<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">ఈ ఎక్స్‌టెన్షన్ పబ్లిషింగ్‌ను దాని డెవలపర్ రద్దు చేశారు, ఇది సురక్షితం కాకపోవచ్చు. Browther నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="1613655732912855341">మీ Browther ఖాతాలో కొంత డేటాను సేవ్ చేయడానికి, దాన్ని మీ డివైజ్‌లన్నింటిలో ఉపయోగించుకోవడానికి ముందు Browther ఇది మీరేనని వెరిఫై చేయాలి. మీరు ఇప్పుడు సైన్ అవుట్ చేస్తే, ఈ డేటా తొలగించబడుతుంది.</translation>
<translation id="9103715009358215214">{0,plural, =1{ఒక రోజులోపు Braveను తిరిగి ప్రారంభించండి}other{# రోజులలోపు Braveను తిరిగి ప్రారంభించండి}}</translation>
<translation id="8438543370129609977">మీరు ఇమేజ్ సెర్చ్‌ను ఉపయోగించడం ద్వారా, PDFలతో పాటు పేజీ టైటిల్, URL, ఇంకా కంటెంట్ సర్వర్‌కు పంపబడతాయి. <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">Braveలో ఇమేజ్ సెర్చ్‌తో సెర్చ్ చేయడం గురించి మరింత తెలుసుకోండి</translation>
<translation id="1401757916223057494">ఇన్‌స్టాలర్ ఆర్కైవ్ పాడైంది లేదా చెల్లదు. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="5029760494698649486">Braveకు Windows 10 లేదా అంతకంటే ఆధునికమైన వెర్షన్ అవసరం.</translation>
<translation id="7906734902028783072">ఆప్షనల్: Braveకు సమస్య విశ్లేషణ, అలాగే వినియోగ డేటాను ఆటోమేటిక్‌గా పంపడం ద్వారా ChromeOS ఫీచర్‌లను, ఇంకా పనితీరును మెరుగుపరచడంలో సహాయపడండి.</translation>
<translation id="6791756730901393492">మీ Browther ఖాతాలో Browther డేటాను ఉపయోగించడానికి, సేవ్ చేయడానికి, ఇది మీరేనని వెరిఫై చేయండి</translation>
<translation id="4879869745782826167">Braveకు సైన్ ఇన్ చేయడానికి ప్రాంప్ట్‌లను చూపిస్తుంది</translation>
<translation id="2967761098021401720">Browther కాలం చెల్లినది</translation>
<translation id="7674832651694000881">మీ ఆటోమేటిక్ బ్రౌజర్‌గా Braveను ఎంచుకున్నందుకు ధన్యవాదాలు!</translation>
<translation id="4507581730979762077">మీరు వాటిని సేవ్ చేసినప్పుడు Browther మీ పాస్‌వర్డ్‌లను చెక్ చేయగలదు</translation>
<translation id="7205233182271132386">Browther మీ పాస్‌వర్డ్‌లలో ఒకదానిని పబ్లిక్ డేటా ఉల్లంఘనలో కనుగొంటే హెచ్చరికను పొందండి</translation>
<translation id="8555465886620020932">సర్వీస్ ఎర్రర్: <ph name="SERVICE_ERROR"/>.</translation>
<translation id="8556420416730706394">సులభంగా యాక్సెస్ చేయడం కోసం మీరు ఇమేజ్ సెర్చ్‌ను పిన్ చేయవచ్చు; సైడ్ ప్యానెల్‌లో ఎగువున ఉన్న 'పిన్ చేయండి' బటన్‌ను క్లిక్ చేయండి</translation>
<translation id="856656450041460113">భాష లిస్ట్‌ను సెర్చ్ చేయండి</translation>
<translation id="75470458211269379">మీరు మీ Browther ఖాతాతో సైన్ ఇన్ చేసి ఉన్నప్పుడు, Browther మీ పాస్‌వర్డ్‌లను చెక్ చేయగలుగుతుంది</translation>
<translation id="2108930010779660436">పలు సంస్థలు Braveను మేనేజ్ చేస్తాయి</translation>
<translation id="7209630341463003999">కాపీరైట్ <ph name="YEAR"/> Browther రచయితలు. అన్ని హ‌క్కులు రిజ‌ర్వ్ చేయ‌బ‌డ్డాయి.</translation>
<translation id="8601359445272098721">కొత్తది! "స్క్రీన్‌ను అనువదించండి" బటన్‌ను ఎంచుకోవడం ద్వారా, మీరు ఇప్పుడు మీ స్క్రీన్‌పై టెక్స్ట్‌ను, ఇమేజ్‌లను రెండింటినీ అనువదించవచ్చు</translation>
<translation id="782928371899183269">Braveని ప్రారంభిస్తోంది...</translation>
<translation id="8624541899164515475">సెట్టింగ్‌లు, కొత్త ట్యాబ్‌లో తెరుచుకుంటాయి.</translation>
<translation id="5879341334716115002">Browther for Testingను మీ ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేయడం సాధ్యపడదు.</translation>
<translation id="2433912322225810055">ఇది మీరు Braveను ప్రారంభించేటప్పుడు లేదా ఓమ్నిబాక్స్ నుండి వెతికేటప్పుడు చూపబడే పేజీని కూడా నియంత్రిస్తుంది.</translation>
<translation id="4816541973978692496">ఇది మీ Browther</translation>
<translation id="8712637175834984815">అర్థమైంది</translation>
<translation id="9037464035997618895">Braveకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="7897185368811431919">అన్నింటినీ Braveలోనే ఉంచండి</translation>
<translation id="8747073452963259673">సెర్చ్ ఏరియాకు దిగువ ఎడమ మూలన: ఎడమ వైపు <ph name="LEFT"/>%, దిగువ <ph name="BOTTOM"/>%</translation>
<translation id="878572486461146056">ఇన్‌స్టలేషన్ ఎర్రర్: మీ నెట్‌వర్క్ అడ్మినిస్ట్రేటర్ ఇన్‌స్టాలేషన్‌ను నిరోధించే గ్రూప్ పాలసీని వర్తింపజేశారు: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">ఈ సైట్ కోసం మీ కెమెరా మరియు మైక్రోఫోన్‌ను యాక్సెస్ చేయడానికి Braveకు అనుమతి అవసరం</translation>
<translation id="8813277370772331957">నాకు తర్వాత గుర్తు చేయి</translation>
<translation id="6831999464349484462">Braveకు సైన్ ఇన్ చేయాలా?</translation>
<translation id="3698151322107951111">Braveను ఆటోమేటిక్ బ్రౌజర్‌గా సెట్ చేసి, టాస్క్‌బార్‌కు పిన్ చేయండి</translation>
<translation id="8826492472752484139">“Password Manager”ను క్లిక్ చేయండి</translation>
<translation id="6933858244219479645">ChromeOS సిస్టమ్</translation>
<translation id="3986927308621489499">Braveలో మెనూలు, సెట్టింగ్‌లు, అలర్ట్‌లు, ఇతర టెక్స్ట్‌ను డిస్‌ప్లే చేయడానికి ఈ భాష ఉపయోగించబడుతుంది</translation>
<translation id="8862326446509486874">సిస్టమ్-స్థాయిలో ఇన్‌స్టాల్‌ చేయ‌డానికి మీకు సరైన హక్కులు లేవు. నిర్వాహకుడి లాగా ఇన్‌స్టాలర్‌ను మ‌ళ్లీ రన్ చేయ‌డానికి ప్రయత్నించండి.</translation>
<translation id="5318226144018267261">Browther ప్రొఫైల్‌ను జోడించండి</translation>
<translation id="1298790608554316415">అలా అయితే, Braveలో సేవ్ అయిన మీ పాస్‌వర్డ్ ‌ను దయచేసి ఎడిట్ చేయండి, అప్పుడు అది మీ కొత్త పాస్‌వర్డ్‌‌తో మ్యాచ్ అవుతుంది.</translation>
<translation id="960933321883777733">మీ సంస్థ పాలసీ ప్రకారం మీరు Braveకు సైన్ ఇన్ చేయాలి</translation>
<translation id="948979409756947611">Browther పాస్‌వర్డ్‌లను చూపడానికి ప్రయత్నిస్తోంది. దీన్ని అనుమతించడానికి మీ Windows పాస్‌వర్డ్‌ను టైప్ చేయండి.</translation>
<translation id="1418854271943945136">Browther ఇకపై మీ ఆటోమేటిక్ బ్రౌజర్‌గా ఉండదు. Braveను ఆటోమేటిక్ బ్రౌజర్‌గా చేయాలా?</translation>
<translation id="7228667329366610727">Braveని అప్‌డేట్ చేయడం సాధ్యం కాదు</translation>
<translation id="4817697255467736794">Browther Enterprise లోగో</translation>
<translation id="3507731466523097529">మీ ప్రొఫైల్‌ను తెరుస్తున్నప్పుడు ఏదో పొరపాటు జరిగినందున Braveను ప్రారంభించడం సాధ్యపడలేదు. Braveను రీస్టార్ట్ చేయడానికి ట్రై చేయండి.</translation>
<translation id="3234473600657230663">Browther ప్రొఫైళ్లను మేనేజ్ చేయండి</translation>
<translation id="8953887022581653484">ఈ డౌన్‌లోడ్‌ను Browther బ్లాక్ చేసింది, ఎందుకంటే ఆ ఆర్కైవ్ ఫైల్‌లో మాల్‌వేర్‌ను దాచి ఉంచగల ఇతర ఫైల్స్ ఉన్నాయి</translation>
<translation id="532304972436358335">మీరు ఇతర Browther సర్వీస్‌లకు సైన్ ఇన్ చేసినప్పుడు Braveకి సైన్ ఇన్ చేయండి</translation>
<translation id="3425998261052065067">Browther ఆటోమేటిక్‌గా మూసివేయబడింది</translation>
<translation id="4377377022617011492">Browther కాలం చెల్లినది</translation>
<translation id="3247296757162889864">{0,plural, =1{ఒక గంటలో Browther తిరిగి ప్రారంభించబడుతుంది}other{# గంటల్లో Browther తిరిగి ప్రారంభించబడుతుంది}}</translation>
<translation id="9106236359747881194">సెర్చ్ చేయడానికి టెక్స్ట్‌ను ఎంచుకోండి</translation>
<translation id="5115014198092384730">భవిష్యత్తులో Browther అప్‌డేట్‌లను పొందడానికి, మీకు Windows 10 లేదా ఆ తర్వాత వచ్చిన ఏదైనా వెర్షన్ అవసరం అవుతుంది. ఈ కంప్యూటర్ Windows 8.1ను ఉపయోగిస్తోంది.</translation>
<translation id="7129101984664345614">కొత్త Browther &amp;ట్యాబ్‌లో లింక్‌ని తెరువు</translation>
<translation id="911206726377975832">మీ బ్రౌజింగ్ డేటాను కూడా తొలగించాలా?</translation>
<translation id="9134482777260927479">హోమ్‌వర్క్‌లో సహాయం</translation>
<translation id="9148058034647219655">నిష్క్రమించండి</translation>
<translation id="1734388504720121468">మీరు ఆపివేసిన చోట నుండి కొనసాగించండి: మీరు రీస్టార్ట్ చేసిన ప్రతిసారీ Browther మీ ట్యాబ్‌లను రీస్టోర్ చేయగలదు. దీన్ని ఆన్ చేయడానికి, వీటికి వెళ్లండి</translation>
<translation id="8633974232736772207"><ph name="TARGET_URL_HOSTNAME"/>‌ను యాక్సెస్ చేయడం కోసం ఒక ప్రత్యామ్నాయ బ్రౌజర్‌ను తెరిచే విధంగా Braveను మీ సిస్టమ్ నిర్వాహకులు కాన్ఫిగర్ చేశారు.</translation>
<translation id="1122669402846843682">Browther చిట్కా: Lensతో సెర్చ్ చేయండి</translation>
<translation id="595330134356385835">&amp;Braveను అప్‌డేట్ చేయడానికి రీ-లాంచ్ చేయండి</translation>
<translation id="2556178781950124146">Browther Origin (mDNS-In)</translation>
<translation id="6491100124044190139">మీరు Braveకు సైన్ ఇన్ చేసినప్పుడు మరిన్ని పొందండి</translation>
<translation id="1665840797775025867">Braveను మీకు అనుకూలంగా ఉండే విధంగా వ్యక్తిగతీకరించుకోండి</translation>
<translation id="4407047432656809023">Braveకి ఇప్పుడు Windows XP లేదా Windows Vistaలో మద్దతు లేనందున ఇది సరిగ్గా పని చేయకపోవచ్చు</translation>
<translation id="945522503751344254">ఫీడ్‌బ్యాక్ పంపండి</translation>
<translation id="7620348044248809366">Braveను ఎవరు ఉపయోగిస్తున్నారు?</translation>
<translation id="7299962884342109067">Browther అత్యంత సురక్షితమైన సెక్యూరిటీని పొందండి</translation>
<translation id="983803489796659991">అప్‌డేట్ సర్వర్‌లో అప్లికేషన్ కోసం హ్యాష్ డేటా లేనందున ఇన్‌స్టాలేషన్ విఫలమైంది.</translation>
<translation id="8775461190334353148">ఖాతా లేకుండా Braveను ఉపయోగించండి</translation>
<translation id="7146761239544860058">Browther రచయితలు</translation>
<translation id="989970834842471429">"ఇమేజ్ సెర్చ్‌"తో సెర్చ్ చేయడానికి టెక్స్ట్‌ను లేదా ఇమేజ్‌ను ఎంచుకోండి</translation>
<translation id="6616551030373607751">మీ లొకేషన్‌ను ఉపయోగించడానికి, <ph name="BEGIN_LINK"/>సిస్టమ్ సెట్టింగ్‌ల<ph name="END_LINK"/>‌లో Braveకు యాక్సెస్ ఇవ్వండి</translation>
<translation id="137466361146087520">Google Chrome బీటా</translation>
<translation id="7535429826459677826">Google Chrome డెవలపర్</translation>
<translation id="5110032212554763592">తెలియ‌ని ఎర్ర‌ర్‌ కారణంగా ఇన‌స్ట‌లేష‌న్‌ విఫలమైంది. దయచేసి Braveను మళ్లీ డౌన్‌లోడ్ చేయండి.</translation>
<translation id="9074842261125908635">తెలియని మూలాలకు చెందిన ఎక్స్‌టెన్షన్‌లు, యాప్‌లు, రూపాలు మీ పరికరానికి హాని కలిగించవచ్చు. <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> నుండి మాత్రమే వాటిని ఇన్‌స్టాల్ చేయని Browther సిఫార్సు చేస్తోంది</translation>
<translation id="3593119910409528681">ఈ ఎక్స్‌టెన్ష‌న్ Browther వెబ్ స్టోర్ పాలసీని ఉల్లంఘిస్తోంది, ఇది సురక్షితం కాకపోవచ్చు. Browther నుండి దాన్ని తీసివేయండి, తద్వారా ఇది మీ వ్యక్తిగత సమాచారంతో సహా మీరు సందర్శించే సైట్‌లలోని మీ డేటాను ఇకపై చూడలేదు, మార్చలేదు.</translation>
<translation id="5245976396374147971">హెచ్చరిక: Browther మీ బ్రౌజింగ్ హిస్టరీను రికార్డ్ చేయకుండా ఎక్స్‌టెన్ష‌న్‌లను నివారించలేదు. ఈ ఎక్స్‌టెన్ష‌న్‌ను అజ్ఞాత మోడ్‌లో డిజేబుల్ చేయడానికి, ఈ ఆప్షన్‌ను రద్దు చేయండి.</translation>
<translation id="3629539416935660172">Braveను సురక్షితం చేయడానికి, మేము <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>లో జాబితా చేయబడని మరియు మీకు తెలియకుండానే జోడించబడిన కొన్ని పొడిగింపులను నిలిపివేసాము.</translation>
<translation id="157534302749986451">Braveని సురక్షితం చేయడానికి, మేము క్రింది పొడిగింపుని నిలిపివేసాము, ఇది <ph name="IDS_EXTENSION_WEB_STORE_TITLE"/>లో జాబితా చేయబడలేదు మరియు మీకు తెలియకుండా జోడించబడి ఉండవచ్చు.</translation>
<translation id="3031052147361385845">Browther అజ్ఞా&amp;త విండోలో లింక్‌ని తెరువు</translation>
<translation id="5556794247782664281">Browther అజ్ఞా&amp;త విండోలో లింక్‌ని తెరువు</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{Braveకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది.}=1{Braveకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{Braveకు కొత్త అప్‌డేట్ అందుబాటులో ఉంది, మీరు పునఃప్రారంభించిన వెంటనే వర్తింపజేయబడుతుంది. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="6181263681651521876">{COUNT,plural, =0{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{ఈ అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="1341091418019636353">{COUNT,plural, =0{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు}=1{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ అజ్ఞాత విండో మళ్లీ తెరవబడదు.}other{అప్‌డేట్‌ను వర్తింపజేయడం కోసం మీరు Braveను పునఃప్రారంభించాలని మీ నిర్వాహకుడు కోరుతున్నారు. మీ # అజ్ఞాత విండోలు మళ్లీ తెరవబడవు.}}</translation>
<translation id="8762228142105311329">{COUNT, plural, =0 {అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Braveని మళ్లీ ప్రారంభించాలి — Advanced Protectionకి ఇది అవసరం.} =1 {అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Braveని మళ్లీ ప్రారంభించాలి — Advanced Protectionకి ఇది అవసరం. మీ వ్యక్తిగత విండో తిరిగి ఓపెన్ కాదవుతుంది.} other {అప్‌డేట్‌ను వర్తింపజేయడానికి మీరు Braveని మళ్లీ ప్రారంభించాలి — Advanced Protectionకి ఇది అవసరం. మీ # వ్యక్తిగత విండోలు తిరిగి ఓపెన్ కాదవుతాయి.}}</translation>
<translation id="5749154344207139683">గోప్యత మెరుగుపర్చడంలో సహాయపడడానికి ఈ 1 నిమిషం సర్వే చేయండి.</translation>
<translation id="6954203250660846933">మీరు అడ్రస్ బార్‌లో లేదా సెర్చ్ బాక్స్‌లో టైప్ చేసినప్పుడు, మెరుగైన సూచనలను పొందడానికి Browther మీరు టైప్ చేసిన దానిని మీ ఆటోమేటిక్ సెర్చ్ ఇంజిన్‌కు పంపుతుంది. అజ్ఞాత మోడ్‌లో ఇది ఆఫ్‌లో ఉంటుంది.</translation>
<translation id="3542179014707218534">Browther అజ్ఞాత మోడ్</translation>
<translation id="2076355018722231995">అజ్ఞాత మోడ్‌లో బ్రౌజ్ చేస్తున్నప్పుడు, సురక్షితం కాని కనెక్షన్‌ను ఉపయోగించి సైట్‌ను లోడ్ చేసే ముందు Browther మిమ్మల్ని హెచ్చరిస్తుంది</translation>
</translationbundle>