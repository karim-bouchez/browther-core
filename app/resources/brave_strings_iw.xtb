<translation id="8624541899164515475">הגדרות, ייפתחו בכרטיסייה חדשה.</translation>
<translation id="5879341334716115002">‏לא ניתן להגדיר את Browther for Testing כדפדפן ברירת המחדל.</translation>
<translation id="2433912322225810055">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Browther או מבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="4816541973978692496">‏זהו ה-Browther שלך</translation>
<translation id="8712637175834984815">הבנתי</translation>
<translation id="9037464035997618895">‏להיכנס אל Browther?</translation>
<translation id="7897185368811431919">‏ב-Browther אפשר לעשות הכל</translation>
<translation id="8747073452963259673">‏הפינה השמאלית התחתונה של אזור החיפוש: ‎<ph name="LEFT"/>%‎ משמאל, ‎<ph name="BOTTOM"/>%‎ מלמטה</translation>
<translation id="878572486461146056">שגיאת התקנה: מנהל הרשת החיל מדיניות קבוצתית שמונעת את ההתקנה: <ph name="INSTALL_ERROR"/></translation>
<translation id="1576369213923770885">‏Browther זקוק להרשאת גישה אל המצלמה והמיקרופון בשביל האתר הזה</translation>
<translation id="8813277370772331957">אני רוצה לקבל תזכורת אחר כך</translation>
<translation id="6831999464349484462">‏להיכנס אל Browther?</translation>
<translation id="3698151322107951111">‏הגדרת Browther כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="8826492472752484139">לוחצים על 'מנהל הסיסמאות'</translation>
<translation id="6933858244219479645">‏מערכת ChromeOS</translation>
<translation id="3986927308621489499">‏זו השפה שבה מוצגים תפריטים, הגדרות, התראות וטקסטים אחרים ב-Browther</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="5318226144018267261">‏הוספת פרופיל Browther</translation>
<translation id="1298790608554316415">‏אם שינית את הסיסמה הזו, יש לערוך את הסיסמה השמורה ב-Browther כך שהיא תתאים לסיסמה החדשה שלך.</translation>
<translation id="960933321883777733">‏לפי דרישת הארגון שלך, עליך להיכנס לחשבון ב-Browther</translation>
<translation id="948979409756947611">‏Browther מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="1418854271943945136">‏‫Browther כבר לא מוגדר כדפדפן ברירת המחדל שלך. אני רוצה ש-Browther יהיה דפדפן ברירת המחדל</translation>
<translation id="7228667329366610727">‏לא ניתן לעדכן את Browther</translation>
<translation id="4817697255467736794">‏הלוגו של Browther Enterprise</translation>
<translation id="3507731466523097529">‏אי אפשר להפעיל את Browther בגלל שמשהו השתבש בפתיחת הפרופיל. כדאי לנסות להפעיל מחדש את Browther.</translation>
<translation id="3234473600657230663">‏ניהול הפרופילים ב-Browther</translation>
<translation id="8953887022581653484">‏‫Browther חסם את ההורדה הזו כי קובץ הארכיון כולל קבצים אחרים שעלולים להסתיר תוכנות זדוניות</translation>
<translation id="532304972436358335">‏כניסה אל Browther כשנכנסים לשירותי Browther אחרים</translation>
<translation id="3425998261052065067">‏Browther נסגר באופן אוטומטי</translation>
<translation id="4377377022617011492">‏Browther אינו מעודכן</translation>
<translation id="3247296757162889864">{0,plural, =1{‏Browther יופעל מחדש בעוד שעה}one{‏Browther יופעל מחדש בעוד # שעות}two{‏Browther יופעל מחדש בעוד # שעות}other{‏Browther יופעל מחדש בעוד # שעות}}</translation>
<translation id="9106236359747881194">אפשר לבחור טקסט לחיפוש</translation>
<translation id="5115014198092384730">‏כדי לקבל עדכונים של Browther בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="7129101984664345614">‏פתיחת הקישור &amp;בכרטיסיית Browther חדשה</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="9134482777260927479">עזרה בשיעורי הבית</translation>
<translation id="9148058034647219655">יציאה</translation>
<translation id="1734388504720121468">‏רוצה להמשיך מהמקום שבו הפסקת? Browther יכול לשחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להפעיל את האפשרות הזו, צריך לעבור אל</translation>
<translation id="8633974232736772207">‏לפי הגדרת מנהל המערכת, Browther יפתח דפדפן חלופי כדי לגשת אל <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="1122669402846843682">‏טיפ ל-Browther: חיפוש באמצעות Lens</translation>
<translation id="595330134356385835">‏הפעלה מחדש לצורך עדכון &amp;Browther</translation>
<translation id="4659389438500978709">‏Browther ‏(mDNS-In)</translation>
<translation id="6491100124044190139">‏רוצה ליהנות מהיתרונות של כניסה לחשבון ב-Browther?</translation>
<translation id="1665840797775025867">‏אפשר להתאים אישית את Browther בדרך שנוחה לך</translation>
<translation id="4407047432656809023">‏ייתכן ש-Browther לא יפעל כראוי כי הוא כבר לא נתמך ב-Windows XP וב-Windows Vista</translation>
<translation id="945522503751344254"> שליחת משוב</translation>
<translation id="7620348044248809366">‏מי משתמש/ת ב-Browther?</translation>
<translation id="7299962884342109067">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של Browther?</translation>
<translation id="983803489796659991">‏ההתקנה נכשלה כי שרת העדכון לא מכיל נתוני גיבוב (hash) של האפליקציה.</translation>
<translation id="8775461190334353148">‏שימוש ב-Browther ללא חשבון</translation>
<translation id="7146761239544860058">‏מחברי Browther</translation>
<translation id="989970834842471429">אפשר לבחור טקסט או תמונה לחיפוש באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="6616551030373607751">‏כדי להשתמש בשירותי המיקום, צריך להיכנס אל <ph name="BEGIN_LINK"/>הגדרות המערכת<ph name="END_LINK"/> ולתת ל-Browther גישה</translation>
<translation id="137466361146087520">‏גרסת הבטא של Google Chrome</translation>
<translation id="7535429826459677826">‏גרסת הפיתוח של Google Chrome</translation>
<translation id="5110032212554763592">‏ההתקנה נכשלה בשל שגיאה לא מזוהה. יש להוריד שוב את Browther.</translation>
<translation id="9074842261125908635">הרחבות, אפליקציות וערכות נושא ממקורות לא ידועים עלולים להזיק למכשיר שלך. Browther ממליץ להתקין אותם רק מ-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/></translation>
<translation id="3593119910409528681">תוסף זה מפר את מדיניות חנות האינטרנט ועלול להיות לא בטוח. הסר אותו מ-Browther כדי שלא יוכל לראות ולשנות את הנתונים שלך באתרים שבהם אתה מבקר, כולל המידע האישי שלך.</translation>
<translation id="5245976396374147971">‏אזהרה: Browther לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב גלישה בסתר, צריך לבטל את הבחירה של האפשרות הזו.</translation>
<translation id="3629539416935660172">‏כדי לשפר את האבטחה של Browther, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="157534302749986451">‏כדי לשפר את האבטחה של Browther, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE"/> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="3031052147361385845">‏פתח את הקישור בחלון &amp;גלישה בסתר של Browther</translation>
<translation id="5556794247782664281">‏פתח את הקישור בחלון &amp;גלישה בסתר של Browther</translation>
<translation id="4555500675737067970">{COUNT,plural, =0{‏יש עדכון חדש בשביל Browther והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש.}=1{‏יש עדכון חדש בשביל Browther והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. החלון האנונימי לא ייפתח מחדש.}two{‏יש עדכון חדש בשביל Browther והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}many{‏יש עדכון חדש בשביל Browther והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏יש עדכון חדש בשביל Browther והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
