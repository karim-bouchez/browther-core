<translation id="5975099973700540482">‏צריך למחוק את נתוני Browther בחשבון</translation>
<translation id="6800151735486681860">‏הקובץ הזה עלול להיות מסוכן<ph name="LINE_BREAK"/>דפדפן Browther יכול לבדוק את ההורדה הזו אם מזינים את הסיסמה. מידע על הקובץ נשלח אל התכונה 'גלישה בטוחה של Browther', אבל הסיסמה והתוכן של הקובץ נשארים במכשיר.</translation>
<translation id="6182736845697986886">ההתקנה נכשלה עקב שגיאה פנימית בשרת העדכון.</translation>
<translation id="48832130233362517">‏יש לוודא שנכנסת ל-Browther ב-<ph name="TARGET_DEVICE_NAME"/> שלך ולשלוח שוב.</translation>
<translation id="8868210753005945522">‏תוכנה אחרת במחשב שלך הוסיפה אפליקציה שעשויה לשנות את אופן הפעולה של Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2779436101182061679">‏במחשב זה קיימת כבר גרסה מתקדמת יותר של Browther. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Browther ולנסות שוב.</translation>
<translation id="9222998061982994203">{0,plural, =0{‏Browther יופעל מחדש עכשיו}=1{‏Browther יופעל מחדש בעוד שנייה אחת}one{‏Browther יופעל מחדש בעוד # שניות}two{‏Browther יופעל מחדש בעוד # שניות}other{‏Browther יופעל מחדש בעוד # שניות}}</translation>
<translation id="6239161312595354541">רוצה לשאול משהו לגבי הסרטון הזה בחיפוש תמונות?</translation>
<translation id="1755464917870815989">‏נדרשת הרשאת גישה לאחסון ב-Browther כדי להוריד קבצים</translation>
<translation id="304681001513922736">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Browther</translation>
<translation id="7785903492969539081">‏יש להפוך את Browther לדפדפן ברירת המחדל</translation>
<translation id="3987833816263696343">‏האם לצאת מ-Browther?</translation>
<translation id="4723540739671534529">‏הכרטיסיות האלה משתמשות במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Browther להשבית אותן.</translation>
<translation id="6540151687468239291">‏התאמה אישית של פרופיל Browther</translation>
<translation id="770793114032605647">‏בחירת שם לפרופיל Browther שלך</translation>
<translation id="385867753870250529">‏תוסף מבקש ממך להיכנס ל-Browther</translation>
<translation id="2022337046348377650">‏<ph name="FILE_NAME"/> עלול להיות מסוכן, ולכן Browther חסם אותו.</translation>
<translation id="45270956603278068">‏Browther משתמש במצלמה שלך.</translation>
<translation id="6327105987658262776">אין עדכונים זמינים.</translation>
<translation id="673633752219771459">‏מתבצעת כרגע פעולה אחרת ב-Browther. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="1482759407165416070">‏קל יותר כעת להשתמש ב-Browther באמצעות חשבון Browther שלך ובמחשבים משותפים.</translation>
<translation id="5538042432112726532">‏קיצור דרך ב-Browther</translation>
<translation id="833085228901080512">‏Browther חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים כאלה ויכול להיות שהקובץ מסוכן</translation>
<translation id="491120842288314439">‏ברצונך באמת להסיר את התקנת Browther?</translation>
<translation id="6375219077595103062">ניתן להוסיף קיצור דרך למנהל הסיסמאות</translation>
<translation id="6388799252195623474">אני רוצה עזרה בנושא הזה</translation>
<translation id="6715003312952407375">‏כדי להמשיך, עליך להיכנס ל-Browther באמצעות החשבון <ph name="EMAIL"/>. כך המדיניות של הארגון תחול על המכשיר שלך.</translation>
<translation id="1897845318651970239">‏הלוגו של Browther בתוך מסך מחשב.</translation>
<translation id="3669522483038684532">‏Browther הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש שמאפשר לך לגלוש באינטרנט בצורה מאובטחת יותר הודות להגנה מפני תוכנות זדוניות ופישינג המובנית ב-Browther.</translation>
<translation id="5669767676913031391">‏דפדפן Browther פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך</translation>
<translation id="6436260184216827876">התכונה 'חיפוש תמונות' לא זמינה. יש לנסות שוב מאוחר יותר.</translation>
<translation id="2139300032719313227">‏הפעלה מחדש של ChromeOS</translation>
<translation id="6110616900529884221">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Browther טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="1217194059001819677">‏כדי לעקוב אחרי מחירים ולקבל התראות על ירידות במחיר באתר מסוים, כדאי להוריד את Browther לטלפון שלך</translation>
<translation id="7058555680120557198">‏מושבת • Browther לא יכול לאמת את מקור התוסף הזה</translation>
<translation id="676533642429632127">‏ברוך בואך לפרופילים של Browther</translation>
<translation id="5518682889576009702">‏בפתיחה הבאה של Browther במכשיר <ph name="DEVICE_TYPE"/>, תופיע הנחיה להשתמש בקבוצות של כרטיסיות.</translation>
<translation id="6038105561107837619">‏הסרת החשבון מ-Browther</translation>
<translation id="2675662665675552980">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Browther.</translation>
<translation id="648319183876919572">הגרסה המשופרת של הגלישה הבטוחה מגנה עליך טוב יותר מפני הורדות ואתרים מסוכנים</translation>
<translation id="2930243146591999795">‏הסרה של התקנת Browther</translation>
<translation id="5241183382286817629">‏קיצורי הדרך נפתחים ב-Browther</translation>
<translation id="7907014599435829661">‏לפי הגדרת הארגון, Browther נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION"/>. נתוני הגלישה נמחקו. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="2088471423667794811">‏בכל פרופיל מאוחסנים נתוני Browther משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="9040334484455218184">‏<ph name="BEGIN_LINK"/>מידע נוסף לגבי השמירה על פרטיות הנתונים ב-Browther<ph name="END_LINK"/></translation>
<translation id="1718697235867382480">‏השינויים בהגדרה הזו ייכנסו לתוקף לאחר הפעלה מחדש של Browther.</translation>
<translation id="6331317152404762758">‏אפשר לעבור לפרופיל Browther אחר כדי לראות סיסמאות</translation>
<translation id="6097706403184348562">‏Browther שולח את הטקסט שמוקלד בשדות טקסט ל-Browther כדי לתקן שגיאות כתיב</translation>
<translation id="2319647238307402812">‏מעבר אל הגדרות ההודעות של Browther</translation>
<translation id="6600016381025017075">אפשר לחפש משהו בדף הזה</translation>
<translation id="8031938899816118394">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Browther‏.</translation>
<translation id="7412185356697187964">‏‫Browther מופעל עכשיו יחד עם Windows, כך שאפשר להתחיל לגלוש מיד. ניתן להשבית זאת בהגדרות.</translation>
<translation id="9123343592576384616">‏אפשר להמשיך מהמקום שבו הפסקת: Browther שחזר את הכרטיסיות מהסשן האחרון שלך. כדי להשבית את האפשרות הזאת, צריך לעבור אל</translation>
<translation id="5847926498049048567">‏נדרשת הרשאת גישה למצלמה ב-Browther כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="5532585028508811858">‏אם הסימניות שלך נשמרות גם בחשבון Browther, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Browther ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="1363996462118479832">‏לא בוצע סנכרון של הנתונים ב-ChromeOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="3373239673945775810">‏להסיר את הנתונים של האפליקציה הזאת מ-Browther?</translation>
<translation id="8122759674786039814">‏ב-Browther יש לך יותר שליטה במודעות שמוצגות לך, וחלות הגבלות על המידע עליך שהאתרים יכולים לקבל בהצגת מודעות בהתאמה אישית.</translation>
<translation id="6277682530398500159">‏נדרשת הרשאת גישה למיקרופון ב-Browther עבור האתר הזה</translation>
<translation id="6712881677154121168">שגיאה בהורדה: <ph name="DOWNLOAD_ERROR"/>.</translation>
<translation id="2972046656127603037">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגיע מגרסה חדשה יותר של Browther.

ייתכן שחלק מהתכונות לא יהיו זמינות. יש לציין ספריית פרופיל אחרת או להשתמש בגרסה חדשה יותר של Browther.</translation>
<translation id="871671753163165892">‏כדי להשתמש בהתאמה אישית ובתכונות אחרות, צריך לכלול את Browther ב'פעילות באינטרנט ובאפליקציות' ובשירותי Browther המקושרים</translation>
<translation id="5000832110229523807">‏Browther כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="5204575479550973859">‏כדי לקבל גישה לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס ל-Browther. לאחר הכניסה, הסימנייה הזו תישמר בחשבון Browther.</translation>
<translation id="2874208284092283937">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Browther, אבל Browther יהיה קצת פחות עמיד בפני מתקפות. ההגדרה הזו פועלת.</translation>
<translation id="3268577459683869744">{count,plural, =1{‏חלק מהנתונים ב-Browther עדיין לא נשמרו בחשבון Browther. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏חלק מהנתונים ב-Browther עדיין לא נשמרו בחשבון Browther. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏חלק מהנתונים ב-Browther עדיין לא נשמרו בחשבון Browther. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏חלק מהנתונים ב-Browther עדיין לא נשמרו בחשבון Browther. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
<translation id="7683816018918395929">‏ההמלצה של Browther היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="1547295885616600893">‏<ph name="BEGIN_LINK_CROS_OSS"/>תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS"/> נוספת מאפשרת את השימוש ב-ChromeOS.</translation>
<translation id="6831043979455480757">תרגום</translation>
<translation id="2142653375108595728">‏Browther מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="684888714667046800">לא ניתן להתחבר לאינטרנט. אם משתמשים בחומת אש, צריך לוודא ש-<ph name="PRODUCT_EXE_NAME"/> ברשימת ההיתרים.</translation>
<translation id="7333549743055076502">‏Browther‏ - <ph name="PAGE_TITLE"/></translation>
<translation id="6859580922007887573">צריך ללחוץ כדי להמשיך</translation>
<translation id="6862030660799253820">חיפוש התמונה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="3860339351709082396">‏הפריט "<ph name="EXTENSION_NAME"/>" שנמצא ב-Browther מכיל תוכנה זדונית</translation>
<translation id="6877155553248388166">‏הפינה הימנית התחתונה של אזור החיפוש: ‎<ph name="RIGHT"/>%‎ מימין, ‎<ph name="BOTTOM"/>%‎ מלמטה</translation>
<translation id="6896758677409633944">העתקה</translation>
<translation id="7804113502310231166">‏הגדרת Browther כדפדפן ברירת המחדל והצמדה שלו לסרגל המשימות</translation>
<translation id="3228374215117173004">‏&amp;ניהול הפרופילים ב-Browther</translation>
<translation id="6934579572334859869">שליחת שאלה אל חיפוש התמונות לגבי התמונה הזו</translation>
<translation id="5995328366516663808">‏הגעת למגבלת הסימניות ב-Browther (<ph name="BOOKMARK_LIMIT"/>), לכן חלק מהסימניות עדיין לא נשמרו בחשבון Browther.

כדי לשמור סימניות חדשות בחשבון, צריך למחוק חלק מהסימניות הקיימות. יציאה מהחשבון תמחק את הסימניות שלא נשמרו.</translation>
<translation id="6965382102122355670">אישור</translation>
<translation id="4533562834763015352">‏קל לנחש סיסמאות חלשות. באמצעות Browther אפשר <ph name="BEGIN_LINK"/>ליצור ולזכור סיסמאות חזקות<ph name="END_LINK"/>.</translation>
<translation id="3453763134178591239">‏התנאים לשימוש ב-ChromeOS</translation>
<translation id="5379058926689137454">‏Browther זקוק להרשאת גישה למיקרופון בשביל האתר הזה</translation>
<translation id="4684462982894889021">‏כדי להשתמש בנתונים של Browther ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL"/>, צריך להזין את ביטוי הסיסמה</translation>
<translation id="7011190694940573312">ההתקנה נכשלה כי הגרסה הזו של מערכת ההפעלה לא נתמכת.</translation>
<translation id="7024536598735240744">שגיאה בפתיחה: <ph name="UNPACK_ERROR"/>.</translation>
<translation id="7025789849649390912">ההתקנה נעצרה.</translation>
<translation id="8257174622576051374">‏אפשר להתאים אישית את Browther בדרך שנוחה לך</translation>
<translation id="7047386856539490735">התוצאות האלה מועילות?</translation>
<translation id="1772745060691790742">‏יש לעדכן את Browther‏</translation>
<translation id="4937970118065051027">‏אם אין לתמונה תיאור מועיל, Browther ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Browther.</translation>
<translation id="1594112132009288601">‏התאמה אישית של Browther for Testing</translation>
<translation id="5915000938288527952">‏אפשר להשתמש ב-Browther בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות</translation>
<translation id="8775664994493381735">‏הסרה של <ph name="EXTENSION_NAME"/> מ-Browther</translation>
<translation id="3276648807841991013">‏לפי הגדרת הארגון, נתוני Browther נמחקים אוטומטית כשלא משתמשים בהם במשך <ph name="TIMEOUT_DURATION"/>. בין הנתונים שנמחקו: היסטוריה, מילוי אוטומטי והורדות.</translation>
<translation id="4725226878394159809">‏נדרשת הרשאת גישה למצלמה ב-Browther עבור האתר הזה</translation>
<translation id="8931474625901592021">‏לא ניתן היה להפעיל את Browther. יש לנסות שוב.</translation>
<translation id="8242947409070121799">‏Browther לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות.</translation>
<translation id="1737922827960215472">‏כדאי להשאיר את Browther ב-Dock כדי לגשת אליו במהירות מתי שרוצים</translation>
<translation id="335855266303176628">‏שימוש ב-Browther בכל פעם שלוחצים על קישורים בהודעות, במסמכים ובאפליקציות אחרות.</translation>
<translation id="709455597778444012">‏מנהל המשימות - Browther</translation>
<translation id="7147140345767587643">‏תחומי העניין שלך בהתאם להערכה של Browther</translation>
<translation id="7337408274890534789">‏רוצה לגלוש מיד? עכשיו אפשר להגדיר את Browther להתחיל לפעול יחד עם Windows.</translation>
<translation id="7274695763216404502">התכונה הוצמדה. מעכשיו אפשר להשתמש בתכונה 'חיפוש תמונות' דרך סרגל הכלים</translation>
<translation id="7288567540154601580">כרטיסיות ותוספים</translation>
<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{‏ההמלצה של Browther היא להסיר אותו}one{‏ההמלצה של Browther היא להסיר אותם}two{‏ההמלצה של Browther היא להסיר אותם}other{‏ההמלצה של Browther היא להסיר אותם}}</translation>
<translation id="1527644038571473502">‏כדי לשתף אודיו מהמערכת, צריך לפתוח את הגדרות המערכת ולבחור באפשרות "הקלטת אודיו של המערכת בלבד" ל-Browther. לאחר מכן צריך להפעיל מחדש את Browther.</translation>
<translation id="1427913074981060872">‏מדידת המודעות מאפשרת לאתרים שביקרת בהם לבקש מ-Browther מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="1657652725060525338">‏העדכון של Browther‏ מתבצע</translation>
<translation id="884846289464870238">‏קובץ ההעדפות שלך פגום או לא חוקי. 

Browther לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="7339898014177206373">חלון חדש</translation>
<translation id="633044855886370183">‏היסטוריית האתרים, הסימניות ונתונים נוספים מ-Browther נמצאים כאן.</translation>
<translation id="1185960088713242527">‏רק מי שיודע את ביטוי הסיסמה יכול לקרוא את הנתונים המוצפנים. ביטוי הסיסמה לא נשלח אל Browther ולא מאוחסן אצלה. אם שכחת את ביטוי הסיסמה או שברצונך לשנות את ההגדרה הזו, עליך <ph name="BEGIN_LINK"/>למחוק את נתוני Browther בחשבון<ph name="END_LINK"/>.</translation>
<translation id="7125151836477182110">‏לפי הגדרת מנהל המערכת, Browther יפתח את<ph name="ALTERNATIVE_BROWSER_NAME"/> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME"/>.</translation>
<translation id="7352651011704765696">משהו השתבש</translation>
<translation id="6638123710106659002">‏כדי לקבל עדכונים של Browther בעתיד, צריך macOS מגרסה 13 ואילך. במחשב הזה פועלת גרסה 12 של macOS.</translation>
<translation id="7286289384512061761">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1"/>" ו"<ph name="PERMISSION_2"/>" הוסרו על ידי Browther.</translation>
<translation id="113593073175678746">‏התוסף הזה כבר לא נתמך. ההמלצה של Browther היא להסיר אותו.</translation>
<translation id="137615076640044304">‏אפשר להמשיך מהמקום שבו הפסקת: Browther משחזר את הכרטיסיות שלך בכל הפעלה מחדש. כדי להשבית את האפשרות הזו, צריך לעבור אל</translation>
<translation id="5967238175620483220">‏ייבוא סיסמאות אל Browther</translation>
<translation id="4719434010343478165">‏<ph name="PAGE_TITLE"/> - Browther בגרסת פיתוח</translation>
<translation id="7450541714075000668">הטקסט הועתק</translation>
<translation id="7766009218653304791">‏Browther זקוק להרשאת גישה למצלמה בשביל האתר הזה</translation>
<translation id="5844418066487488520">‏כדי להשתמש במיקרופון, צריך להיכנס אל <ph name="BEGIN_LINK"/>הגדרות המערכת<ph name="END_LINK"/> ולתת ל-Browther גישה</translation>
<translation id="8065480549334161841">‏כדי לקבל עדכונים של Browther בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="6299293759264950896">‏להפעיל את Browther מחדש?</translation>
<translation id="180908550381040105">‏לא ניתן להתקין את אותה גרסת Browther שפועלת כרגע. יש לסגור את Browther ולנסות שוב.</translation>
<translation id="7625576878150380853">‏אפשר לשמור סיסמאות ופרטים נוספים בחשבון Browther ולהשתמש בהם כשמחוברים לחשבון ב-Browther. ‏<ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">‏סביר להניח שאתרים יפעלו כצפוי. אם סוגרים את כל החלונות של Browther, מתבצעת יציאה מהחשבון ברוב האתרים, חוץ מחשבון Browther אם הוא מחובר ל-Browther.</translation>
<translation id="7099370564362681943">{0,plural, =1{‏Browther יופעל מחדש בעוד דקה}one{‏Browther יופעל מחדש בעוד # דקות}two{‏Browther יופעל מחדש בעוד # דקות}other{‏Browther יופעל מחדש בעוד # דקות}}</translation>
<translation id="3602613943932672197">‏כדי להגן על הנתונים שלך, כדאי לאפשר ל-Browther להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה.</translation>
<translation id="8759568213742229377">‏כדי להתחיל לגלוש מיד, אפשר להפעיל את Browther באופן אוטומטי.</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME"/></translation>
<translation id="8991800242749014880">‏Browther משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="2692328388439821508">‏Browther השתפר</translation>
<translation id="4318444066563223295">‏עכשיו יש לך יותר תכונות זמינות ב-Browther</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="5591287320769313116">‏רוצה ש-Browther יחפש בשבילך?</translation>
<translation id="7658239707568436148">ביטול</translation>
<translation id="6325482130534634729">‏Browther אינו דפדפן ברירת המחדל שלך</translation>
<translation id="8185915921134219287">‏סנכרון והתאמה אישית של Browther בכל המכשירים שברשותך</translation>
<translation id="5120421624925726813">‏עדכון ל-Browther</translation>
<translation id="7716950018788545737">המשימות הסתיימו.</translation>
<translation id="77283119132245232">השירות הזה מספק תיעוד של עקבות המערכת ל-<ph name="BROWSER_NAME"/>. אם השירות הזה מושבת, נתוני המעקב אחר הביצועים שנוצרים על ידי הדפדפן לא יכללו אירועים כלל-מערכתיים, כמו אירועי החלפת הקשר ואירועי שרשור מוכנים.</translation>
<translation id="6542096191573265107">‏פעולה זו תמחק את נתוני הגלישה מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Browther עם <ph name="USER_EMAIL"/>.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="351575328720488268">‏איפוס לברירת המחדל של Browther</translation>
<translation id="1054170408395182418">‏הגדרת Browther כדפדפן ברירת המחדל והצמדה שלו לסרגל האפליקציות</translation>
<translation id="4569594230301902490">‏שיפור המהירות ב-Browther</translation>
<translation id="5525298466557654312">‏<ph name="PAGE_TITLE"/> – Browther בגרסת Canary</translation>
<translation id="7893465573639396635">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫Browther משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="7810005234485217901">אפשר להצמיד את התכונה 'חיפוש תמונות' כדי לאפשר גישה נוחה</translation>
<translation id="2462631024103158515">‏כבר קיים במכשיר פרופיל Browther עם החשבון הזה.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="311190437086049332">‏אפשר להתאים אישית את Browther כדי לשנות את המראה שלו.</translation>
<translation id="6728847658878265103">‏עדכון Browther לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
