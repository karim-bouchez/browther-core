<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="7099479769133613710">‏הפעלה מחדש לצורך עדכון ‎&amp;ChromeOS</translation>
<translation id="7264054672589027446">‏לפי המלצת Browther, כדאי לבדוק את התוסף הזה</translation>
<translation id="7848219163187166649">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת Browther משתמשת בשרתי Browther. כך מוסתרת הזהות שלך מהאתר שנטען מראש, אבל Browther יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="8837164267124113709">‏ההורה שלך השבית ב-Browther את ההגדרה 'הרשאות לאתרים, לאפליקציות ולתוספים'</translation>
<translation id="881513728707488138">‏Browther רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="112640046208448578">אפשר לנסות לזהות דברים או מקומות ולהעתיק או לתרגם טקסטים. כשמשתמשים בחיפוש תמונות, צילום מסך של הדף נשלח לשרת. <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">‏Browther מוגדר כדפדפן ברירת המחדל</translation>
<translation id="6580138787163923852">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK"/>יש להיכנס ל-Browther<ph name="END_LINK"/>.</translation>
<translation id="1089111274164380772">‏לוחצים על תפריט Browther</translation>
<translation id="1157985233335035034">שפות אחרונות</translation>
<translation id="3673786631598474384">‏התוסף התווסף על ידי <ph name="PARTNER_NAME"/> ויכול לשנות את אופן הפעולה של Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">‏ההתקנה נכשלה כי הגרסה של Windows לא נתמכת.</translation>
<translation id="8291401179516272335">‏על Browther</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME"/>.</translation>
<translation id="1232234696885483911">‏כשפותחים את חיפוש התמונות, כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים באופן אוטומטי לשרת. <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">‏אחרי הכניסה לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Browther ב-Browther. כדי לשנות את האפשרות הזאת, כדאי לעבור אל "החשבון שלך ב-Browther".</translation>
<translation id="9034321258761608912">‏בזמן שהכרטיסייה הזו לא הייתה פעילה, התפנה זיכרון כדי ש-Browther ימשיך לפעול במהירות. ניתן לבחור להחריג תמיד את האתר הזה כדי שיישאר במצב פעיל.</translation>
<translation id="249571811018731941">‏Browther חסם את ההורדה הזאת כי הקובץ מסוכן</translation>
<translation id="8850227089720975601">‏כשנכנסים לשירותי Browther כמו Gmail או YouTube עם <ph name="USER_EMAIL"/>, אפשר להיכנס אוטומטית ל-Browther עם אותו חשבון</translation>
<translation id="1290883685122687410">שגיאה בהגדרה: <ph name="METAINSTALLER_EXIT_CODE"/>. <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">‏הגדרת הפרופיל החדש שלך ב-Browther</translation>
<translation id="4437862975743821367">‏ל-Browther נדרשת גישה ל-Bluetooth כדי למצוא 
 מכשירי Bluetooth. <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">זיהוי שפה אוטומטי</translation>
<translation id="1206925267243987362">‏שימוש בהגדרות הדפדפן המומלצות של Browther</translation>
<translation id="8270483548049772782">‏אני רוצה למחוק את הנתונים גם מ-Browther (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">התכונה הוצמדה. מעכשיו אפשר לגשת לחיפוש התמונות דרך הכפתור החדש בסרגל הכלים</translation>
<translation id="1356661055722410047">חדש! אפשר לתרגם טקסט ותמונות במסך</translation>
<translation id="1383876407941801731">חיפוש</translation>
<translation id="1592588950737518481">‏&amp;ניהול הפרופילים ב-Browther</translation>
<translation id="1404026649028693342">‏תמיד להציג את מצב AI</translation>
<translation id="141901961143729572">כאן אפשר לשתף את המחשבות שלך</translation>
<translation id="1743952081001089298">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Browther בקטע "הגדרות המערכת".</translation>
<translation id="8627385813382688019">‏קבלת עזרה לגבי Browther for Testing</translation>
<translation id="1497802159252041924">שגיאת התקנה: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">הדף הזה מוגן</translation>
<translation id="7252430412915798987">‏שיתוף כרטיסיית Browther</translation>
<translation id="6388429281015199562">‏כניסה ל-Browther</translation>
<translation id="1547469039832541117">סיום המשימה המודגשת.</translation>
<translation id="1801944307203212016">‏Browther זקוק להרשאת גישה למצלמה כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{‏התוסף הזה כבר לא נתמך. אנחנו ממליצים להסיר אותו מ-Browther.}one{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-Browther.}two{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-Browther.}other{‏התוספים האלה כבר לא נתמכים. אנחנו ממליצים להסיר אותם מ-Browther.}}</translation>
<translation id="4667068923142532753">‏הצמדת Browther</translation>
<translation id="3006560544901646947">‏הכלים לבטיחות של Browther</translation>
<translation id="686052171138185761">‏‫Browther רוצה למחוק את הנתונים שלך במנהל הסיסמאות. כדי לאפשר זאת, צריך להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="8713026329083542796">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Browther</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1680687534629375545">רוצה לשאול שאלה על הדף הזה ב"חיפוש התמונות"?</translation>
<translation id="1709772298389099340">השירות הזה מספק הרשאות מורחבות ל-<ph name="BROWSER_NAME"/>.</translation>
<translation id="4243382967656566037">‏כדי לשפר את התכונות האלו, Browther שולח את האינטראקציות שלך איתן ל-Browther. בודקים אנושיים יכולים לקרוא את הנתונים האלה, לעבד אותם ולהוסיף להם הערות.</translation>
<translation id="1722488837206509557">כך תהיה לך אפשרות לבחור מבין המכשירים הזמינים ולהציג בהם תוכן.</translation>
<translation id="6820510278633522408">‏נתוני הגלישה ב-Browther יימחקו בקרוב</translation>
<translation id="7775028004939172516">‏Browther ינסה לשדרג את הניווטים ל-HTTPS</translation>
<translation id="6963959729951758069">‏נתוני Browther נמחקו</translation>
<translation id="4085139922884095932">‏Browther יופעל מחדש בעוד <ph name="REMAINING_TIME"/></translation>
<translation id="2586248102295515296">‏כש-HTTPS לא יהיה זמין, Browther ישתמש בחיבור לא מאובטח בלי להציג אזהרה</translation>
<translation id="3975328336074677101">‏התרה ל-Browther לפעול ברקע</translation>
<translation id="2497443204974841650">‏התקנת Browther מחדש</translation>
<translation id="1724309687045787742">‏Browther מנסה <ph name="AUTHENTICATION_PURPOSE"/></translation>
<translation id="4553225588627299783">‏בפעם הבאה ש-Browther ייפתח במכשיר <ph name="DEVICE_TYPE"/>, תופיע הנחיה להשתמש במנהל הסיסמאות של Browther.</translation>
<translation id="1838374766361614909">ניקוי חיפוש</translation>
<translation id="2337233040802538155">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון שלך ב-Browther, <ph name="BEGIN_LINK"/>עליך לצאת מהחשבון ב-Browther<ph name="END_LINK"/>.</translation>
<translation id="3927415701154897844">‏כדי לפתוח או ליצור קבוצות חדשות של כרטיסיות תוך כדי תנועה, כדאי להוריד את Browther לטלפון שלך.</translation>
<translation id="2063443520349987970">‏יש לך אפשרות לנהל את חשבונות Browther שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן Browther, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות Browther שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE"/>. <ph name="LINK_BEGIN"/>מידע נוסף<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">חיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="1880677175115548835">בחירת טקסט</translation>
<translation id="3183933389992069620">‏נכנסת עם חשבון מנוהל שנותן למנהל המערכת שלו שליטה על הפרופיל שלך ב-Browther. הנתונים שלך ב-Browther, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME"/>. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Browther, אבל אי אפשר לשייך את הנתונים האלה לחשבון אחר. לחלופין, באפשרותך ליצור פרופיל חדש כדי לשמור את הנתונים הקיימים שלך ב-Browther בנפרד.<ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">‏‫Browther חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. <ph name="BEGIN_LINK"/>מידע נוסף על מצב חיסכון באנרגיה<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">כאן שואלים שאלה לגבי הדף הזה</translation>
<translation id="9128006428501241840">‏שירות לעדכון של Browther</translation>
<translation id="6302815314157879372">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי Browther, כמו Gmail, בלי להיכנס אל Browther</translation>
<translation id="1063611196035804685">‏Browther אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="2873360330889594383">‏לפי דרישת הארגון שלך, <ph name="MANAGER"/>, עליך להיכנס לחשבון ב-Browther</translation>
<translation id="4035053306113201399">‏צריך להפעיל מחדש את ChromeOS כדי להחיל את העדכון הזה.</translation>
<translation id="2861285003831382718">‏Browther חסם את ההורדה הזאת כי לרוב לא מתבצעת הורדה של קבצים מהסוג הזה ויכול להיות שהקובץ מסוכן</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE"/> דק'</translation>
<translation id="2080160985220483492">‏טיפ ל-Browther: שמירת סיסמאות</translation>
<translation id="8037497710694492565">‏ב-Browther לא ניתן לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="7395009124247513849">‏מידע על חסימה של קבצים מסוימים ב-Browther, נפתח בכרטיסייה חדשה</translation>
<translation id="762710512520170632">‏השירות הזה שומר על תוכנת Browther עדכנית. אם השירות הזה מושבת או מופסק, תוכנת Browther לא תתעדכן באופן קבוע. כתוצאה מכך, לא ניתן יהיה לתקן פרצות אבטחה שעלולות להיווצר, וייתכן שחלק מהתכונות לא יפעלו. השירות הזה יוסר באופן אוטומטי אם אין תוכנת Browther שמשתמשת בו.</translation>
<translation id="5793588180426267429">‏הפעולה הזו תמחק פריט אחד מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, היכנס אל Browther עם <ph name="USER_EMAIL"/>.</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="6351516710581760512">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK"/>יש להיכנס ל-Browther<ph name="END_LINK"/>.</translation>
<translation id="2039417478970545937">הגדרות.</translation>
<translation id="8194525816714210105">‏בוחרים אם לכלול את ההיסטוריה ב-Browther להתאמה אישית מדויקת יותר בשירותי Browther</translation>
<translation id="5909559127548969159">‏אפשר ללחוץ על הכפתור "התאמה אישית של Browther" בדף הכרטיסייה החדשה כדי לשנות את המראה שלו</translation>
<translation id="2066690553719545730">‏תמיד להציג את מצב AI</translation>
<translation id="3283892260110318935">‏Browther חסם את ההורדה הזאת כי הקובץ מטעה ועשוי לבצע שינויים לא צפויים במכשיר שלך</translation>
<translation id="6160571936643742128">‏בפעם הבאה ש-Browther ייפתח ב-iOS, תופיע הנחיה לנסות את <ph name="FEATURE_NAME"/>.</translation>
<translation id="8380517409933452343">‏הסיסמאות ונתונים אחרים מ-Browther ששמרת בחשבון שלך ב-Browther יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Browther, צריך להיכנס בחזרה לחשבון.</translation>
<translation id="1388132502102606439">{COUNT,plural, =1{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Browther במשך דקה. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}one{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Browther במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}two{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Browther במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}other{‏נתוני הגלישה נמחקים באופן אוטומטי על ידי הארגון כשלא נעשה שימוש ב-Browther במשך # דקות. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות. הכרטיסיות יישארו פתוחות.}}</translation>
<translation id="2126108037660393668">נכשל האימות של הקובץ שהורד.</translation>
<translation id="2135919691573380097">דיווח על האתר הזה</translation>
<translation id="2137162749895930932">סגירת המסך לתרגום</translation>
<translation id="4283559398694996391">‏Browther חסם את ההורדה הזאת כי האתר לא משתמש בחיבור מאובטח ויכול להיות שבוצעו שינויים לא מורשים בקובץ</translation>
<translation id="2170098639895543546">צריך לבחור משהו מהדף</translation>
<translation id="2495182092286337191">‏התאמה אישית של Browther</translation>
<translation id="2174917724755363426">ההתקנה לא הושלמה. להמשיך בביטול?</translation>
<translation id="4877141231724140862">‏Browther – כניסה לרשת – <ph name="PAGE_TITLE"/></translation>
<translation id="2190166659037789668">השגיאה בבדיקת העדכון: <ph name="UPDATE_CHECK_ERROR"/>.</translation>
<translation id="6696114732806961952">‏הסרת החשבון מ-Browther</translation>
<translation id="1084363153644366288">‏אפשר ליהנות מאינטרנט בטוח יותר בכל מקום עם הגרסה המשופרת של גלישה בטוחה ב-Browther ל-iOS</translation>
<translation id="7949164640723239455">‏אתר מסוכן. ‫Browther הסיר את ההתראות.</translation>
<translation id="2236949375853147973">הפעילות שלי</translation>
<translation id="4536403809133456417">‏כדי לקבל גישה לכתובות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Browther. לאחר הכניסה, הכתובת הזו תישמר בחשבון שלך ב-Browther.</translation>
<translation id="5627930103267312171">‏אם משתפים מחשב, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את Browther בדיוק כפי שהם רוצים.</translation>
<translation id="2283803047247799269">חיפוש הכרטיסייה הזו באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="1133671091758900032">{NUM_TABS,plural, =1{‏ההמלצה של Browther היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של Browther היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של Browther היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של Browther היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="2307973900865360088">‏אני רוצה להשאיר את Browther ב-Dock</translation>
<translation id="5161617112768367959">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Browther. אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, Browther עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים.</translation>
<translation id="4123094831918713833">‏בעקבות האיפוס:
          <ph name="LINE_BREAKS"/>
           • יתאפסו חלק מההגדרות ומקיצורי הדרך של Browther
           <ph name="LINE_BREAK"/>
           • התוספים יושבתו
           <ph name="LINE_BREAK"/>
           • יימחקו קובצי Cookie ונתונים זמניים אחרים מאתרים
            <ph name="LINE_BREAKS"/>
           לא תהיה השפעה על הסימניות, ההיסטוריה והסיסמאות שמורות.</translation>
<translation id="5456070119344236353">‏כדי לשלוח מספר מכאן לטלפון Android, יש להיכנס ל-Browther בשני המכשירים.</translation>
<translation id="2356070529366658676">לשאול</translation>
<translation id="2359808026110333948">המשך</translation>
<translation id="6468415397021485143">‏התוסף "<ph name="EXTENSION_NAME"/>" מבקש ממך להיכנס ל-Browther</translation>
<translation id="2558600429878197587">‏השבתת הפעילות של Browther ברקע לאפליקציות</translation>
<translation id="5295781918312989856">‏כדי להשתמש בתוסף הזה בתור <ph name="USER_EMAIL_ADDRESS"/>, עליך להיכנס ל-Browther.</translation>
<translation id="8418845734693287262">‏לא בוצע סנכרון של הנתונים שלך ב-ChromeOS כי פרטי הכניסה לחשבון לא מעודכנים.</translation>
<translation id="5288505984482120202">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-Browther ניגש למכשיר ממשק אנושי (HID) אחד}=1{‏תוסף אחד לפחות ל-Browther ניגש למכשיר ממשק אנושי (HID) אחד}one{‏תוסף אחד לפחות ל-Browther ניגש ל-# מכשירי ממשק אנושי (HID)}two{‏תוסף אחד לפחות ל-Browther ניגש ל-# מכשירי ממשק אנושי (HID)}other{‏תוסף אחד לפחות ל-Browther ניגש ל-# מכשירי ממשק אנושי (HID)}}</translation>
<translation id="434258293817844111">‏נדרשות הרשאות גישה למצלמה ולמיקרופון ב-Browther עבור האתר הזה</translation>
<translation id="2403703063067034158">שגיאה בזמן ההפעלה: יש עוד הגדרה שפועלת כרגע. אפשר לנסות שוב מאוחר יותר.</translation>
<translation id="5458993228789433099">‏הגדרת Browther כברירת מחדל מאפשרת לפתוח קישורים מכל אפליקציה ולהשאיר את הדפדפן נגיש בסרגל האפליקציות</translation>
<translation id="1677640217693742525">‏בעזרת <ph name="BEGIN_LINK"/>הכלים של Browther<ph name="END_LINK"/> אפשר לגלוש בבטחה ובשליטה</translation>
<translation id="2451727308784734061">באמצעות קיצורי הדרך אפשר להגיע מהר למנהל הסיסמאות. ניתן להעביר את קיצור הדרך למרכז האפליקציות או למסך הבית של המחשב.</translation>
<translation id="2280315911954332435">‏Browther ייסגר בקרוב</translation>
<translation id="6410820860979094113">‏ב-Browther</translation>
<translation id="2485422356828889247">הסרה</translation>
<translation id="2513154137948333830">נדרשת הפעלה מחדש: <ph name="INSTALL_SUCCESS"/></translation>
<translation id="2542968102051442371">בחירה של טקסט באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="7892218991241200190">‏Browther מנסה להחליף את הסיסמאות הקיימות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="8976443723926188033">‏Browther זקוק לגישה לאחסון כדי להוריד קבצים</translation>
<translation id="1973587471928846950">Browther Helper</translation>
<translation id="2575822587468774919">אפשר לבחור משהו לחיפוש באמצעות התכונה 'חיפוש תמונות'</translation>
<translation id="8705561858232289221">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Browther</translation>
<translation id="437162022240011372">‏המשך השימוש ב-Browther</translation>
<translation id="259935314519650377">שמירת מנהל ההתקנה שהורד במטמון נכשלה. השגיאה: <ph name="UNPACK_CACHING_ERROR_CODE"/>.</translation>
<translation id="2620436844016719705">מערכת</translation>
<translation id="2907676829052962091">‏האדמין בארגון שלך יכול לראות ולנהל את נתוני הגלישה, כמו הסימניות, ההיסטוריה והסיסמאות. אין לאדמין אפשרות לראות את נתוני הגלישה בפרופילים אחרים של Browther</translation>
<translation id="1289116577679005654">‏כדי להשתמש בנתונים של Browther ולשמור אותם בחשבון <ph name="ACCOUNT_EMAIL"/>, עליך לאמת את הזהות שלך</translation>
<translation id="7192278346779151664">‏במהלך ההתקנה ארעה שגיאה של מערכת ההפעלה. יש להוריד שוב את Browther.</translation>
<translation id="7724398260867885339">‏אם משתפים מכשיר, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את Browther בדיוק כפי שהם רוצים</translation>
<translation id="1679595317134614424">‏כרטיסייה של Browther</translation>
<translation id="7189168846924379421">‏לשיפור האבטחה, Browther יצפין את הנתונים.</translation>
<translation id="4052643592793184278">‏כדי להסיר את החשבון שלך ב-Browther מ-Browther, צריך לצאת מהחשבון</translation>
<translation id="7694616023994438906">‏כדי לקבל גישה לסיסמאות, לסימניות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Browther</translation>
<translation id="2738871930057338499">‏לא ניתן להתחבר לאינטרנט. HTTP 403: קוד איסור. צריך לבדוק את ההגדרה של שרת ה-proxy.</translation>
<translation id="2753623023919742414">צריך ללחוץ כדי לחפש</translation>
<translation id="9078193405195503710">‏הגדרת Browther ככלי ברירת המחדל לצפייה בקובצי PDF</translation>
<translation id="2456995288904753506">‏‫Browther יכול למלא אוטומטית שדות בעייתיים שהמילוי האוטומטי הרגיל עלול לפספס</translation>
<translation id="3271730304285122987">‏התוסף הזה מכיל תוכנה זדונית והוא לא בטוח. צריך להסיר אותו מ-Browther כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="2799223571221894425">הפעלה מחדש</translation>
<translation id="1427337251963884503">‏ה-Browther שלך</translation>
<translation id="2816462166102338036">חיפוש הסרטון הזה באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="2841525013647267359">תרגום מ:</translation>
<translation id="2846251086934905009">שגיאת התקנה: פעולת מנהל ההתקנה לא הושלמה. ההתקנה בוטלה.</translation>
<translation id="928966105228355994">‏הסרה מ-Browther...</translation>
<translation id="587805782197019018">‏מגינה עליך ב-Browther ועשויה לשפר את רמת האבטחה באפליקציות אחרות של Browther. ההגנה הזו פעילה רק אם נכנסים לחשבון.</translation>
<translation id="2885378588091291677">מנהל המשימות</translation>
<translation id="3055995278166070443">‏מידע על &amp;Browther‏</translation>
<translation id="2915996080311180594">הפעלה מחדש מאוחר יותר</translation>
<translation id="2928420929544864228">ההתקנה הושלמה.</translation>
<translation id="70453521937551896">‏הנתונים שלך מוצפנים באמצעות ביטוי הסיסמה. כדי להשתמש בנתוני Browther ולשמור אותם בחשבון Browther, עליך להזין את ביטוי הסיסמה.</translation>
<translation id="2945997411976714835">שגיאת התקנה: הפעלת התהליך של מנהל ההתקנה נכשלה.</translation>
<translation id="3188308520233701133">‏רוצה להיכנס מהר יותר לאתרים? כדאי להשתמש בסיסמאות שמורות ב-Browther ב-iOS</translation>
<translation id="8145318807880784886">‏אפשר להוסיף פרופיל חדש ב-Browther כדי להפריד בין הסימניות, הסיסמאות וההגדרות.</translation>
<translation id="4330268530227888227">‏‫Browther מנוהל על ידי הארגון שלך</translation>
<translation id="6488090896442998436">‏Browther‏ מעודכן</translation>
<translation id="300557164611864786">‏אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, Browther עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים</translation>
<translation id="2447145782593796785">‏כדי לשמור על הבטיחות אונליין בהתאם לאפשרויות שנבחרו על ידי ההורה שלך, עליך להיכנס ל-Browther</translation>
<translation id="3003694935412297923">כל המשימות</translation>
<translation id="7554113777150891030">{count,plural, =1{‏‫Browther צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Browther ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו (פריט אחד).}one{‏‫Browther צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Browther ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}two{‏‫Browther צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Browther ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}other{‏‫Browther צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Browther ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו ({count} פריטים).}}</translation>
