<translation id="5346389065299425353">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים</translation>
<translation id="3904682305383981098">‏יש ל-Browther כמה המלצות לגבי בטיחות שכדאי לבדוק</translation>
<translation id="509616246140011182">‏פרופילים אחרים ב-Browther</translation>
<translation id="8214429210535362385">‏הכניסה שלך מתבצעת באמצעות חשבון מנוהל שמעניק למנהל המערכת שלו שליטה על הפרופיל שלך ב-Browther. הנתונים שלך ב-Browther, כגון יישומים, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME"/>. ניתן למחוק את הנתונים האלה באמצעות לוח הבקרה של חשבונות Browther, אבל לא ניתן לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE"/></translation>
<translation id="5368118228313795342">קוד נוסף: <ph name="EXTRA_CODE"/>.</translation>
<translation id="5244017809112094908">‏כדי להשתמש בהתאמה אישית, צריך לכלול את Browther ב'פעילות באינטרנט ובאפליקציות'</translation>
<translation id="8096544113811780871">‏למה קבצים מסוימים נחסמים ב-Browther</translation>
<translation id="2384387444932590174">‏מתבצע עדכון של Browther‏ (<ph name="PROGRESS_PERCENT"/>)</translation>
<translation id="2651210046538078820">‏התרת כניסה אל Browther</translation>
<translation id="6557334704331248411">‏להסיר מ-‏Browther‏</translation>
<translation id="5832041381258620673">‏ירידה ברמת הביצועים בתמורה להגברת העמידות של Browther בפני מתקפות</translation>
<translation id="3763317028635993788">‏הגדרת Browther כדפדפן ברירת המחדל שלך</translation>
<translation id="8756552710915246172">‏<ph name="PAGE_TITLE"/> - Browther בגרסת בטא</translation>
<translation id="1280422694222936333">{NUM_TABS,plural, =1{‏ההמלצה של Browther היא להשהות את הכרטיסייה שמאטה את הדפדפן}one{‏ההמלצה של Browther היא להשהות את הכרטיסיות שמאטות את הדפדפן}two{‏ההמלצה של Browther היא להשהות את הכרטיסיות שמאטות את הדפדפן}other{‏ההמלצה של Browther היא להשהות את הכרטיסיות שמאטות את הדפדפן}}</translation>
<translation id="4423621904097888155">‏יכול להיות ש-Browther לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="6201726364919996698">‏‫Browther חסם את ההורדה הזו כי הקובץ יכול לפגוע בחשבונות האישיים ובחשבונות שלך ברשתות החברתיות</translation>
<translation id="7679204468655335605">‏Browther זקוק לגישה למיקום שלך כדי לשתף אותו עם האתר הזה</translation>
<translation id="1163572992704966942">‏יש להמתין בזמן ש-Browther מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="5050118226119231029">‏Browther מנסה לערוך את הסיסמאות. כדי לאפשר זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="5524890928877629608">‏הפינה השמאלית העליונה של אזור החיפוש: ‎<ph name="LEFT"/>%‎ משמאל, ‎<ph name="TOP"/>%‎ מלמעלה</translation>
<translation id="5875549039106594731">‏פתיחה של קובצי PDF ב-Browther</translation>
<translation id="5536164441519929134">יש לי שאלה<ph name="LINE_BREAK"/>לגבי הכרטיסייה הזו</translation>
<translation id="5579324208890605088">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כמשתמש רגיל ולא כאדמין.</translation>
<translation id="202315329304302571">‏שימוש ב-Browther כברירת מחדל והצמדה שלו</translation>
<translation id="5596627076506792578">אפשרויות נוספות</translation>
<translation id="5605834417512968703">‏אפשר לבחור משהו לחיפוש באמצעות התכונה 'חיפוש תמונות' או ללחוץ על Escape כדי לצאת מחיפוש התמונות</translation>
