<translation id="8086881907087796310">ההתקנה נכשלה כי המחשב לא עומד בדרישות החומרה המינימליות.</translation>
<translation id="4734875482699037091">‏<ph name="PAGE_TITLE"/> –‏ Browther for Testing</translation>
<translation id="543407324609820492">‏נדרשת הרשאת מיקום ב-Browther עבור האתר הזה</translation>
<translation id="1767887552863788514">‏בפתיחה הבאה של Browther במכשיר <ph name="DEVICE_TYPE"/>, תופיע הנחיה להפעיל התראות על מעקב מחירים.</translation>
<translation id="8118331347066725040">‏שליחת משוב על חיפוש באמצעות Lens</translation>
<translation id="5334309298019785904">‏לא בוצע סנכרון של הנתונים ב-ChromeOS כי אפשרות הסנכרון לא זמינה עבור הדומיין שלך.</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="4879101934056397619">‏תנאים והגבלות נוספים של Browther</translation>
<translation id="4505690237431768764">‏Browther‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8177472873527554730">לא נמצא תוכן בדף</translation>
<translation id="4720341280133158605">‏כדי להשתמש בנתונים של Browther ולשמור אותם בחשבון <ph name="USER_EMAIL"/>, צריך להזין את ביטוי הסיסמה</translation>
<translation id="8221491193165283816">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות יש ללחוץ כאן.</translation>
<translation id="1083711467946065278">‏כדי להשתמש במצלמה, צריך להיכנס אל <ph name="BEGIN_LINK"/>הגדרות המערכת<ph name="END_LINK"/> ולתת ל-Browther גישה</translation>
<translation id="6569785137733211804">‏‫Browther לא יכול לאמת את מקור התוסף הזה ויכול להיות שהוא לא בטוח. צריך להסיר אותו מ-Browther כדי לא לאפשר לו יותר לראות ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="1122818205373648656">‏אם אין לתמונה תיאור מועיל, Browther ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Browther. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="6877990294324319801">‏להיכנס ל-Browther עם פרופיל חדש?</translation>
<translation id="6478811748813986578">‏<ph name="BEGIN_LINK"/>ב-Browther מוצגות אזהרות<ph name="END_LINK"/> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="1685486387921540822">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאה "<ph name="PERMISSION"/>" הוסרה על ידי Browther.</translation>
<translation id="8921153410460268589">‏אפשר לקנות, לתרגם ולזהות את מה שרואים במצלמה באפליקציית Browther ל-iOS</translation>
<translation id="8313851650939857356">שגיאת הפעלה: <ph name="STARTUP_ERROR"/>.</translation>
<translation id="7386947683604296534">‏לפי הגדרת הארגון, Browther נסגר אוטומטית כשלא משתמשים בו במשך <ph name="TIMEOUT_DURATION"/>.</translation>
<translation id="8321888067342493336">שמירה כתמונה</translation>
<translation id="143016831128278157">‏כניסה לחשבון תסנכרן ותתאים אישית את Browther בכל המכשירים שברשותך</translation>
<translation id="4784945022248750283">‏בכתובת <ph name="USER_EMAIL_ADDRESS"/> השתמשו בעבר ב-Browther</translation>
