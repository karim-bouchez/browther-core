<translation id="8648401677359150296">‏כדי לקבל עדכונים של Browther בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="8362914115861174987">תרגום ל</translation>
<translation id="8367705492654390392">אפשר לשאול הכל</translation>
<translation id="5769022907892823357">‏כדי לקבל גישה לסיסמאות ולנתונים נוספים בכל המכשירים שלך, כדאי להיכנס ל-Browther. לאחר הכניסה, הסיסמה הזו תישמר בחשבון שלך ב-Browther.</translation>
<translation id="4782442810031768771">‏לאחר מכן יהיה עליך להפעיל מחדש את Browther.</translation>
<translation id="8265348385714408341">‏ההמלצה של Browther היא להסיר אותו. <ph name="BEGIN_LINK"/>מידע נוסף על תוספים נתמכים<ph name="END_LINK"/></translation>
<translation id="3866087820766911633">‏הפרסום של התוסף הזה בוטל על ידי המפתח שלו, ויכול להיות שהתוסף לא בטוח. צריך להסיר אותו מ-Browther כדי לא לאפשר לו יותר להציג ולשנות את הנתונים שלך באתרים שאליהם תתבצע כניסה, כולל הפרטים האישיים שלך.</translation>
<translation id="1613655732912855341">‏‫Browther צריך לאמת את הזהות שלך לפני שאפשר יהיה לשמור חלק מהנתונים בחשבון Browther ולהשתמש בהם בכל המכשירים שלך. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="9103715009358215214">{0,plural, =1{‏צריך להפעיל מחדש את Browther בתוך יום אחד}one{‏צריך להפעיל מחדש את Browther בתוך # ימים}two{‏צריך להפעיל מחדש את Browther בתוך # ימים}other{‏צריך להפעיל מחדש את Browther בתוך # ימים}}</translation>
<translation id="8438543370129609977">‏כשמשתמשים בתכונה 'חיפוש תמונות', כותרת הדף, כתובת ה-URL והתוכן שלו, כולל קובצי PDF, נשלחים לשרת. <ph name="LEARN_MORE"/></translation>
<translation id="3550129882823305293">‏מידע נוסף על חיפוש באמצעות התכונה "חיפוש תמונות" ב-Browther</translation>
<translation id="1401757916223057494">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את Browther.</translation>
