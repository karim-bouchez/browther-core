<translation id="3525563861100145512">{NUM_DEVICES,plural, =0{‏תוסף אחד לפחות ל-Browther ניגש להתקן USB אחד}=1{‏תוסף אחד לפחות ל-Browther ניגש להתקן USB אחד}one{‏תוסף אחד לפחות ל-Browther ניגש ל-# התקני USB}two{‏תוסף אחד לפחות ל-Browther ניגש ל-# התקני USB}other{‏תוסף אחד לפחות ל-Browther ניגש ל-# התקני USB}}</translation>
<translation id="2065456480740480340">‏ההיסטוריה ב-Browther</translation>
<translation id="5011660649081947055">‏המתקין לא הצליח לבטל את דחיסת הארכיון. יש להוריד שוב את Browther.</translation>
<translation id="310459126943037700">סיום המשימות נכשל.</translation>
<translation id="3104828284009500087">אפשר לחפש משהו בדף הזה</translation>
<translation id="4917564010081457061">‏רוצה לסנכרן את הסיסמאות, הסימניות וההיסטוריה שלך באופן מושלם בין המכשירים? כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך לעדכן את דפדפן ברירת המחדל ל-Browther.</translation>
<translation id="1041472930719344928">‏Browther משתמש במיקרופון שלך.</translation>
<translation id="3130333203120345554">חיפוש חדש</translation>
<translation id="3137969841538672700">צריך לגרור כדי לחפש</translation>
<translation id="5312717254055363883">‏בכרטיסייה הזו נעשה שימוש במשאבים נוספים. כדי לשפר את הביצועים, כדאי לאפשר ל-Browther להשבית אותה.</translation>
<translation id="373523409348786203">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-Browther בקטע "הגדרות המערכת"</translation>
<translation id="802113445299754598">‏הפעלה מחדש של Browther</translation>
<translation id="3161522574479303604">כל השפות</translation>
<translation id="4522189060330781648">‏תוכנה אחרת במחשב שלך הוסיפה עיצוב שעשוי לשנות את אופן הפעולה של Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="2604272613984010799">‏התאמה אישית של פרופיל Browther החדש</translation>
<translation id="5150830326120505481">‏כדי להסיר את החשבון שלך ב-Browther מ-Browther, צריך לצאת מ-Browther בדף ההגדרות</translation>
<translation id="7113660200899017820">‏בהמשך, תוצג לך שאלה ב-Browther אם להשתמש במידע השמור כדי למלא בשבילך טפסים באופן אוטומטי</translation>
<translation id="4475011322243623412">‏Browther אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY"/></translation>
<translation id="3286538390144397061">הפעל מחדש כעת</translation>
<translation id="3536063527222598206">‏המפתחות של Browther API חסרים. פונקציונליות מסוימת של Browther תהיה מושבתת.</translation>
<translation id="1011450868746766298">‏המשך הפעלת יישומים ברקע כאשר Browther סגור</translation>
<translation id="179611081153855734">‏Browther יציג אזהרה לפני טעינת אתר כלשהו באמצעות חיבור לא מאובטח</translation>
<translation id="8965591964936552871">‏אם סוגרים את כל החלונות של Browther, מתבצעת יציאה מהחשבון ברוב האתרים, אבל לא מחשבון Browther, אם נכנסת אליו ב-Browther. כדי לאפשר לאתרים לזכור אותך, <ph name="SETTINGS_LINK"/>.</translation>
<translation id="6626350400537358074">‏מנוע החיפוש שמוגדר כברירת מחדל השתנה מחוץ ל-Browther. כדי להגן עליך, Browther איפס את ההגדרה.</translation>
<translation id="1170501833661894915">‏כדי לקבל גישה לסיסמאות, לסימניות ולנתונים נוספים בכל המכשירים, צריך להיכנס לחשבון ב-Browther</translation>
<translation id="3352986031709923790">‏הפינה הימנית העליונה של אזור החיפוש: ‎<ph name="RIGHT"/>%‎ מימין, ‎<ph name="TOP"/>%‎ מלמעלה</translation>
<translation id="120745000989996104">‏נתוני Browther בחשבון שלך</translation>
<translation id="3369405342922656244">חיפוש הדף הזה באמצעות התכונה "חיפוש תמונות"</translation>
<translation id="7173761126541905083">‏רוצה להשתמש בסיסמאות שלך ב-Browther בטלפון?</translation>
<translation id="2645435784669275700">ChromeOS</translation>
<translation id="5266583242423616945">‏לעבור לפרופיל קיים של Browther?</translation>
<translation id="3412460710772753638">עדכון במנהל הסיסמאות במכשיר הזה</translation>
<translation id="4282363917570905631">‏רוצה להרחיב את הגרסה המשופרת של גלישה בטוחה ב-Browther בטלפון?</translation>
<translation id="986094398735583155">‏‫Browther מבצע התאמה אישית…</translation>
<translation id="3266047225484320321">‏אם מערכת Browther תזהה שנכנסת עם סיסמה שנחשפה, היא תתריע לך על כך</translation>
<translation id="3508047337876211050">‏פעולה זו תמחק <ph name="ITEMS_COUNT"/> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Browther עם <ph name="USER_EMAIL"/>.</translation>
<translation id="7772248897860792723">‏ניתן לעבור בין פרופילים של Browther באמצעות <ph name="SHORTCUT"/></translation>
<translation id="7225005776233199285">‏יש לסגור את כל חלונות Browther ולנסות שוב.</translation>
<translation id="5465054931427475969">‏כדי לשתף את החלון, צריך לאפשר הקלטת מסך ב-Browther בקטע "הגדרות המערכת"</translation>
<translation id="6905469223518185641">‏כבר בוצעה כניסה לחשבון על ידי <ph name="EXISTING_USER"/>.  כדי להפריד בין פעילויות הגלישה, עליך להיכנס ל-Browther בפרופיל שלך עם האימייל <ph name="USER_EMAIL_ADDRESS"/>.</translation>
<translation id="8133590217245064579">‏כדי לשתף את המסך, צריך לאפשר הקלטת מסך ב-Browther בקטע "הגדרות המערכת".</translation>
<translation id="3597003331831379823">הפעלת ההגדרה נכשלה עם הרשאות מורחבות. <ph name="METAINSTALLER_ERROR"/></translation>
<translation id="611080704131468868">‏כניסה ל-Browther</translation>
<translation id="2492221622209669678">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-Browther בתור <ph name="USER_EMAIL"/>.</translation>
<translation id="6793778233257855801">‏כדי לשלוח מספר מ-<ph name="ORIGIN"/> לטלפון Android שלך, צריך להיכנס אל Browther בשני המכשירים.</translation>
<translation id="3667616615096815454">אין אפשרות להתקין, האפליקציה לא מוכרת לשרת.</translation>
<translation id="5585500151754164442">‏שימוש ב<ph name="BEGIN_LINK"/>ביטוי סיסמה משלך<ph name="END_LINK"/> כדי להצפין את כל נתוני Browther בחשבון Browther. אמצעי תשלום וכתובות שנשמרו ב-Google Pay לא יוצפנו. היסטוריית הגלישה ב-Browther לא תסונכרן.</translation>
<translation id="404323216042159951">‏Browther לא יכול לבדוק את הסיסמאות שלך. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="5004936474632127765">‏פתיחת הקישור ב&amp;כרטיסיית Browther חדשה</translation>
<translation id="6236643159256182256">‏אפשר לקשר את Browther לשירותי Browther אחרים לצורך התאמה אישית ולמטרות אחרות</translation>
<translation id="3729187154190517324">כדי להעמיק את החיפוש, אפשר להוסיף כמה כרטיסיות, קבצים וכלים באמצעות הכפתור "הוספת כרטיסייה ועוד".</translation>
<translation id="1400697664933775238">‏ניהול הפרופילים ב-Browther</translation>
<translation id="2461315395128103158">‏למה הורדות מסוימות נחסמות ב-Browther</translation>
<translation id="8058420662026104226">‏Browther יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="3177448557921912221">‏פרופילים ב-Browther עוזרים להפריד בין חלקים שונים בחיים. אפשר להוסיף פרופיל חדש עכשיו.</translation>
<translation id="1541177876035612043">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Browther טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="3810973564298564668">ניהול</translation>
<translation id="1117103475254549453">‏כדי להשתמש בסיסמאות השמורות, צריך לסרוק את קוד ה-QR, להוריד את Browther ל-iOS ולהיכנס לחשבון Browther</translation>
<translation id="8880695882192156860">‏טיפ ל-Browther: הגרסה המשופרת של הגלישה הבטוחה</translation>
<translation id="3846683726093018685">**סיכום:** במשפט אחד של פחות מ-30 מילים, צריך לתאר את הנושא והמטרה העיקריים של התוכן בצילום המסך.

          **הצעת שאלות:** יצירת רשימה של 3-5 שאלות מעוררות מחשבה שהמשתמש יכול לשאול כדי להבין טוב יותר את צילום המסך. לפחות שאלה אחת צריכה להתייחס באופן ספציפי לאובייקט חזותי, לעיצוב שלו או למיקום שלו.</translation>
<translation id="8293474885560144454"><ph name="PAGE_TITLE"/> - Browther</translation>
<translation id="3885770153807205175">הכלי לבחירת שפה</translation>
<translation id="4861846616763552424">‏התאמה אישית וניהול של Browther נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="6126366281251241386">‏יש ללחוץ על השם שלך כדי לפתוח את Browther ולהתחיל לגלוש.</translation>
<translation id="3892148308691398805">העתקת הטקסט</translation>
<translation id="3760801273210219822">‏המשתמש <ph name="EXISTING_USER"/> כבר מחובר לפרופיל Browther הזה. כדי להפריד בין פעילויות גלישה, Browther יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="3821553157234855663">‏התאמה אישית של Browther</translation>
<translation id="3941890832296813527">שגיאת התקנה: שם הקובץ של מנהל ההתקנה לא תקין או לא נתמך.</translation>
<translation id="6482299900191767005">‏Browther מנסה להעתיק את הסיסמאות. כדי לאפשר למערכת לעשות זאת, יש להזין את הסיסמה שלך ל-Windows.</translation>
<translation id="5853011008278898603">‏הסיסמאות, אמצעי התשלום והכתובות ששמרת בחשבון שלך ב-Browther יוסרו מהמכשיר הזה. כדי להשתמש בהם שוב ב-Browther, צריך להיכנס שוב לחשבון.</translation>
<translation id="395904275706073188">לא ניתן לקרוא דפים מוגנים. כדאי לנסות דף אחר.</translation>
<translation id="1832973663231751701">‏איך מערכת Browther שומרת על האבטחה שלך</translation>
<translation id="4531502594774670767">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Browther שולח את הטקסט הזה לכלי החיפוש, הבינה המלאכותית והסוכנים של הארגון כדי לקבל הצעות.</translation>
<translation id="300013383485253006">‏מידע על &amp;Browther for Testing</translation>
<translation id="1152920704813762236">‏מידע על ChromeOS</translation>
<translation id="8126752030994997015">‏כשמבקרים באתר מסוים, Browther שולח ל<ph name="BEGIN_LINK"/>גלישה בטוחה של Browther<ph name="END_LINK"/> קטע קוד מעורפל מכתובת ה-URL דרך שרת פרטיות שמסתיר את כתובת ה-IP. אם האתר פועל באופן שמעורר חשד, יישלחו גם כתובות URL מלאות וקטעי תוכן מדפים.</translation>
<translation id="3703994572283698466">‏השימוש ב-ChromeOS מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS"/>תוכנות קוד פתוח<ph name="END_LINK_CROS_OSS"/> נוספות כמו <ph name="BEGIN_LINK_LINUX_OSS"/>סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS"/>.</translation>
<translation id="4022972681110646219">תרגום המסך</translation>
<translation id="4023601594785368013">שפה מקורית: <ph name="LANGUAGE"/></translation>
<translation id="6450460108719059465">‏אפשר לפתוח קישורים ב-Browther מכל אפליקציה. בנוסף Browther מוצמד לשורת המשימות לגישה נוחה.</translation>
<translation id="3437506136408403836">‏דיווח על <ph name="BEGIN_LINK"/>ההגדרות הנוכחיות<ph name="END_LINK"/> יעזור לשפר את Browther</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4055805654398742145">מנהל הס&amp;יסמאות</translation>
<translation id="2164947358785939495">‏תוכנה אחרת במחשב שלך הוסיפה תוסף שעלול לשנות את אופן הפעולה של Browther.

<ph name="EXTENSION_NAME"/></translation>
<translation id="3398985784952805125">{COUNT,plural, =1{‏לפי הגדרת הארגון, Browther נסגר אוטומטית כשלא משתמשים בו במשך דקה. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}one{‏לפי הגדרת הארגון, Browther נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}two{‏לפי הגדרת הארגון, Browther נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}other{‏לפי הגדרת הארגון, Browther נסגר אוטומטית כשלא משתמשים בו במשך # דקות. נתוני הגלישה נמחקים. בין הנתונים שיימחקו: היסטוריה, מילוי אוטומטי והורדות.}}</translation>
<translation id="1535413545339990419">‏מעבר לדף 'מידע על Browther'</translation>
<translation id="692283249649018289">‏אפשר להתאים אישית את Browther כדי לשנות את מראה הדפדפן</translation>
<translation id="6375229634133804834">‏התאמה אישית של Browther</translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="2399933334889379115">‏<ph name="PAGE_TITLE"/> – כניסה לרשת – Browther</translation>
<translation id="2911246138082876798">‏אפליקציות, משחקים, תוספים ועיצובים מעולים בשביל Browther.</translation>
<translation id="2528977475313334293">‏כדי לקבל גישה לתוסף הזה ולנתונים נוספים בכל המחשבים, צריך להיכנס ל-Browther</translation>
<translation id="8244267655940711467">‏כדי לשמור על הבטיחות אונליין בהתאם לאפשרויות שנבחרו על ידי ההורה שלך, עליך לעבור לפרופיל Browther שבו כבר נכנסת לחשבון עם האימייל <ph name="USER_EMAIL_ADDRESS"/></translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4224210481850767180">ההתקנה בוטלה.</translation>
<translation id="8219359042845534271">‏האם לקשר את הנתונים שלך ב-Browther לחשבון זה?</translation>
<translation id="5520777668172961882">‏מקבלים אזהרות לגבי אתרים מסוכנים, גם כאלה שלא היו ידועים ל-Browther לפני כן, בעזרת ניתוח של יותר נתונים מאתרים בהשוואה להגנה הרגילה. אפשר לדלג על האזהרות מ-Browther.</translation>
<translation id="2014920019837536689">‏יציאה מ-Browther</translation>
<translation id="4341512411059715879">‏עזרה בנושא Browther</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="322492684764924424">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם Browther פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="3813060261346666066">‏ייצוא סיסמאות מ-Browther</translation>
<translation id="4304713468139749426">מנהל הסיסמאות</translation>
<translation id="4334241893986177674">חיפוש צילום המסך הזה</translation>
<translation id="4334294535648607276">ההורדה הושלמה.</translation>
<translation id="2177954934431828302">‏הפעלת Browther יחד עם Windows</translation>
<translation id="2472318668926455009">‏כדי להשתמש בקלות בתכונות המוכרות והאהובות, צריך להגדיר את Browther בתור דפדפן ברירת המחדל. לגישה מהירה, Browther יוצמד לסרגל האפליקציות.</translation>
<translation id="1068681683510904753">‏לפי דרישת <ph name="MANAGER"/>, יש לקרוא את התנאים וההגבלות הבאים ולהסכים להם לפני השימוש במכשיר הזה. תנאים אלה לא מרחיבים, משנים או מגבילים את התנאים של ChromeOS.</translation>
<translation id="2897580280700805340">‏לסגור את Browther בכל זאת?</translation>
<translation id="4413205837991854510">תמיד להציג את קיצור הדרך לחיפוש תמונות</translation>
<translation id="2454897022983434851">‏Browther יכול לפעול ברקע</translation>
<translation id="6192767293556958458">{NUM_EXTENSIONS,plural, =1{‏אנחנו ממליצים להסיר אותו מ-Browther. <ph name="BEGIN_LINK"/>מידע נוסף על תוספים נתמכים<ph name="END_LINK"/>}one{‏אנחנו ממליצים להסיר אותם מ-Browther. <ph name="BEGIN_LINK"/>מידע נוסף על תוספים נתמכים<ph name="END_LINK"/>}two{‏אנחנו ממליצים להסיר אותם מ-Browther. <ph name="BEGIN_LINK"/>מידע נוסף על תוספים נתמכים<ph name="END_LINK"/>}other{‏אנחנו ממליצים להסיר אותם מ-Browther. <ph name="BEGIN_LINK"/>מידע נוסף על תוספים נתמכים<ph name="END_LINK"/>}}</translation>
<translation id="4276381981942009836">‏התאמה אישית ושליטה ב-Browther</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="4434353761996769206">שגיאת מנהל התקנה: <ph name="INSTALLER_ERROR"/></translation>
<translation id="4870160002723711846">‏הארגון '<ph name="MANAGER"/>' מנהל את Browther</translation>
<translation id="4007482010626246887">‏הוספת פרופיל Browther</translation>
<translation id="6888322430074420631">‏מידע על Browther for Testing</translation>
<translation id="8912436499620582668">‏כדי להשתמש בנתוני Browther ולשמור אותם בחשבון Browther, עליך להזין את ביטוי הסיסמה שלך</translation>
<translation id="4493028449971051158">שגיאת הפעלה: יש להפעיל את מנהל ההתקנה כאדמין.</translation>
<translation id="4501471624619070934">ההתקנה נכשלה כי הגישה מוגבלת במדינה הזו.</translation>
<translation id="8976207309012239417">‏לתוסף הזה לא פורסמו נוהלי פרטיות, למשל האופן שבו הוא אוסף נתונים ומשתמש בהם. ההמלצה של Browther היא להסיר אותו.</translation>
<translation id="2174621824527957495">‏ברוך בואך אל Browther. נפתח חלון חדש בדפדפן</translation>
<translation id="6391148383688605718">‏ל-Browther נדרשת הרשאה כדי למפות את הסביבה שלך ולעקוב אחרי תנועות הידיים</translation>
<translation id="7756445485815468244">‏כבר נכנסת לחשבון בתור <ph name="USER_EMAIL_ADDRESS"/> בפרופיל Browther אחר</translation>
<translation id="137435413163730206">‏‫Browther טוען מראש דפים וכך ניתן לגלוש ולחפש מהר יותר. <ph name="BEGIN_LINK"/>מידע נוסף על טעינה מראש של דפים<ph name="END_LINK"/></translation>
<translation id="4549180975214802957">כדי לשפר את הבטיחות באינטרנט לכולם, אפשר לדווח על אתר שלדעתך עשוי לגרום נזק.</translation>
<translation id="3266647901351304597">‏Browther חסם את ההורדה הזאת כי השבתת את הגלישה הבטוחה ואי אפשר לאמת את הקובץ</translation>
<translation id="6980208900390333646">‏רוצה לנסות את Google Lens ב-Browther בטלפון?</translation>
<translation id="4594305310729380060">שמירה למנהל הסיסמאות במכשיר הזה</translation>
<translation id="738228944918383850">‏יישומי Browther</translation>
<translation id="4598116752460667024">מחפשים תהליך כלשהו מהרשימה.</translation>
<translation id="4970880042055371251">‏גרסת ChromeOS</translation>
<translation id="4482468019601425607">‏העדכון כמעט הושלם! הפעל מחדש את Browther‏ כדי לסיים את העדכון.</translation>
<translation id="5517890123509214766">‏אפשר להאיץ ביצועים של אתרים באמצעות מנוע V8 של Browther, אבל Browther יהיה קצת פחות עמיד בפני מתקפות.</translation>
<translation id="7690070364551268156">‏אם בנוסף ישותפו דוחות שימוש ב-Browther, הדוחות האלה יכללו את כתובות ה-URL שבהן ביקרת</translation>
<translation id="5020487088453637212">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך Browther אחר (<ph name="PROCESS_ID"/>) במחשב אחר (<ph name="HOST_NAME"/>)‏. Browther נעל את הפרופיל כדי שלא ייפגם. אם וידאת שאף תהליך אחר אינו משתמש בפרופיל זה, אפשר את נעילת הפרופיל ולהפעיל את Browther מחדש.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="8134827615154347946">‏חלק מהנתונים ב-Browther עדיין לא נשמרו בחשבון Browther. כדאי לחכות כמה דקות לפני היציאה מהחשבון. אם תתבצע יציאה מהחשבון, הנתונים האלה יימחקו.</translation>
<translation id="3508712423420506333">‏כשמחוברים לחשבון, אפשר להשתמש בסיסמאות ובפרטים נוספים מחשבון Browther ב-Browther. אפשר לשנות את ההגדרות של שירותי Browther באמצעות קיצור הדרך <ph name="SHORTCUT"/>.</translation>
<translation id="2388739442635757494">‏מישהו נכנס בעבר ל-Browther מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST"/>. יש ליצור משתמש חדש ל-Browther כדי לשמור על פרטיות המידע שלך.</translation>
<translation id="4724676981607797757">ההתקנה נכשלה בגלל שגיאת פרוטוקול שלא נתמך.</translation>
<translation id="8305313684264112434">‏לסגור את Browther בכל זאת?</translation>
<translation id="418155915144835101">‏בוצע עדכון אבטחה מיוחד של Browther. עכשיו עליך להפעיל מחדש ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="2683970367518529374">‏שואלים את Browther</translation>
<translation id="5064473048847774331">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1"/>", "<ph name="PERMISSION_2"/>" ועוד <ph name="COUNT"/> הרשאות הוסרו על ידי Browther.</translation>
<translation id="5941343075741207533">‏Browther לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות או <ph name="BEGIN_LINK"/>לבדוק את הסיסמאות בחשבון Browther<ph name="END_LINK"/>.</translation>
<translation id="3854190830798038395">‏נעשה כאן שימוש בבדיקת האיות של חיפוש Browther. הטקסט המוקלד בדפדפן נשלח אל Browther. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="4581078588976787792">‏שימוש ב-Browther ללא חשבון</translation>
<translation id="5921583137589782067">‏כלל נכנס עבור Browther על מנת לאפשר תנועת mDNS.</translation>
<translation id="6563126962881169552">‏הפעלה מחדש לצורך עדכון &amp;Browther</translation>
<translation id="4918086044614829423">אישור</translation>
<translation id="4918844574251943176">התמונה הועתקה</translation>
<translation id="5240982928057703861">‏Browther נמצא במצב רקע.</translation>
<translation id="3603134280602182991">‏אפשר ללחוץ כדי לסגור את תיבת הדו-שיח של הכניסה ל-Browther</translation>
<translation id="6120233890602288442">‏באמצעות פרופילים ב-Browther, אפשר להפריד את כל הפריטים ב-Browther. אפשר ליצור פרופילים שמיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="5722688387568011881">‏אורחים יכולים להשתמש ב-Browther בלי להשאיר דבר מאחור.</translation>
<translation id="7786958592460743302">‏החשבון שלך ב-Browther</translation>
<translation id="9114640791491590337">‏הוספת החשבון שלך ל-Browther</translation>
<translation id="3536391594566515053">‏‫Gemini ב-Browther משתמש בגלישה אוטומטית כדי לפעול בכרטיסיות שלך ולהשלים משימות שהוא מקבל ממך. <ph name="LINK_BEGIN"/>מידע נוסף<ph name="LINK_END"/></translation>
<translation id="5620073061430082932">‏צריך לתת ל-Browther הרשאה כדי לעקוב אחרי תנועות הידיים</translation>
<translation id="1627123463102858476">‏לא נכנסת לאתר הזה בזמן האחרון. ההרשאות "<ph name="PERMISSION_1"/>", "<ph name="PERMISSION_2"/>" ו"<ph name="PERMISSION_3"/>" הוסרו על ידי Browther.</translation>
<translation id="5174969993834422967">הבחירה שלך היא בדרך כלל לחסום התראות. כדי לאפשר לאתר הזה להציג התראות, יש ללחוץ על סמל ההתראה בפינה השמאלית של סרגל המיקום.</translation>
<translation id="5174983315706567306">אין מספיק מקום בכונן.</translation>
<translation id="7091313576354542088">‏נדרש אימות מחדש לחשבון Browther</translation>
<translation id="9045390598305758496">‏אין סיסמאות שמורות. Browther יכול לבדוק את הסיסמאות שלך רק אם שמרת אותן.</translation>
