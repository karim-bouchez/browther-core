<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="1026101648481255140">इन्स्टल गर्ने प्रक्रिया सुचारु गर्नुहोस्</translation>
<translation id="7099479769133613710">&amp;ChromeOS अपडेट गर्न यसलाई रिलन्च गर्नुहोस्</translation>
<translation id="7264054672589027446">Browther तपाईंलाई यो एक्स्टेन्सनको समीक्षा गर्न सिफारिस गर्छ</translation>
<translation id="7848219163187166649">कुनै साइटले आफ्नो पेजमा भएका लिंकहरू गोप्य तरिकाले प्रिलोड गर्न लगाएका खण्डमा Browther ले Browther का सर्भरहरू प्रयोग गर्छ। यसो गर्दा प्रिलोड गरिएको साइटमा भएको तपाईंको पहिचान खुलाउने जानकारी लुकाइन्छ तर Browther ले कुन कुन साइट प्रिलोड गरिन्छन् भन्ने कुरा सिक्छ।</translation>
<translation id="1065672644894730302">तपाइँका प्राथमिकातहरू पढ्न सकिदैन।

केही सुविधाहरू अनुपलब्ध हुन सक्छन् र प्राथमिकताहरूमा परिवर्तनहरू बचत हुने छैनन्।</translation>
<translation id="8837164267124113709">तपाईंका अभिभावकले Browther का हकमा "साइट, एप तथा एक्सटेन्सनसम्बन्धी अनुमति" अफ गर्नुभएको छ</translation>
<translation id="881513728707488138">Browther तपाईंका पासवर्डहरू निर्यात गर्न चाहन्छ। यसो गर्ने अनुमति दिन Windows को आफ्नो पासवर्ड टाइप गर्नुहोस्‌।</translation>
<translation id="112640046208448578">वस्तु वा ठाउँहरू पहिचान गर्नुहोस् र टेक्स्ट कपी वा अनुवाद गर्नुहोस्। तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा प्रयोग गर्दा यो पेजको एउटा स्क्रिनसट सर्भरमा पठाइन्छ। <ph name="LEARN_MORE"/></translation>
<translation id="8280092658684559253">Browther तपाईंको डिफल्ट ब्राउजर हो</translation>
<translation id="6580138787163923852">तपाईंका पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK"/>Browther मा साइन इन गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="1089111274164380772">Browther मेनुमा क्लिक गर्नुहोस्</translation>
<translation id="1157985233335035034">हालसालै चयन गरिएका भाषाहरू</translation>
<translation id="3673786631598474384"><ph name="PARTNER_NAME"/> ले Browther ले काम गर्ने तरिका परिवर्तन गर्न सक्ने एक्स्टेन्सन हालेको छ।

<ph name="EXTENSION_NAME"/></translation>
<translation id="1184145431117212167">तपाईंको डिभाइसमा भएको Windows को संस्करणमा नचल्ने भएकाले इन्स्टल गर्न सकिएन।</translation>
<translation id="8291401179516272335">Browther का बारेमा</translation>
<translation id="1203500561924088507">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="1232234696885483911">तपाईंले फोटो प्रयोग गरी खोज्ने सुविधा खोल्दा PDF सहित पेजको शीर्षक, URL र कन्टेन्ट स्वतः सर्भरमा पठाइने छन्। <ph name="LEARN_MORE"/></translation>
<translation id="3496831315930641015">तपाईं साइन इन अवस्थामा भएका बेला आफ्नो Browther खातामा सेभ गरिएका पासवर्ड तथा अन्य कुराहरू Browther मा प्रयोग गर्न सक्नुहुन्छ। यो कुरा परिवर्तन गर्न “Browther मा भएको तपाईंको खाता” मा जानुहोस्।</translation>
<translation id="9034321258761608912">यो ट्याब निष्क्रिय हुँदा Browther छिटो चल्ने बनाइराख्न मेमोरी खाली गरिएको थियो। तपाईं यो साइटलाई जुनसुकै बेला सक्रिय राखिराख्ने विकल्प छनौट गर्न सक्नुहुन्छ।</translation>
<translation id="249571811018731941">यो फाइल खतरनाक भएकाले Browther ले यो फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="8850227089720975601"><ph name="USER_EMAIL"/> मार्फत Browther का Gmail वा YouTube लगायतका सेवाहरूमा साइन इन गर्दा तपाईं उही खातामार्फत Browther मा स्वतः साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="1290883685122687410">सेटअप गर्ने क्रममा निम्न त्रुटि भयो: <ph name="METAINSTALLER_EXIT_CODE"/>। <ph name="WINDOWS_ERROR"/></translation>
<translation id="6235774143043174856">Browther मा आफ्नो नयाँ प्रोफाइल सेटअप गर्नुहोस्</translation>
<translation id="4437862975743821367">Browther सँग ब्लुटुथ डिभाइसहरू खोज्नका निम्ति 
 ब्लुटुथको एक्सेस हुनु पर्छ। <ph name="IDS_SERIAL_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="1330562121671411446">भाषा पहिचान गर्नुहोस्</translation>
<translation id="1206925267243987362">Browther ले सिफारिस गरेको ब्राउजरको सेटिङ प्रयोग गर्नुहोस्</translation>
<translation id="8270483548049772782">यो जानकारी Browther बाट पनि मेटाउनुहोस् (<ph name="URL"/>)</translation>
<translation id="1345251407431278948">पिन गरियो! तपाईं टुलबारमा भएको नयाँ बटन थिचेर फोटो प्रयोग गरी खोज्ने सुविधा फेरि एक्सेस गर्न सक्नुहुन्छ</translation>
<translation id="1356661055722410047">नयाँ सुविधा! तपाईं आफ्नो स्क्रिनमा देखाइने टेक्स्ट र फोटो दुवै अनुवाद गर्न सक्नुहुन्छ</translation>
<translation id="1383876407941801731">खोज्नुहोस्</translation>
<translation id="1592588950737518481">&amp;Browther प्रोफाइलरू व्यवस्थापन गर्नुहोस्</translation>
<translation id="1404026649028693342">AI मोड सधैँ देखाउनुहोस्</translation>
<translation id="141901961143729572">आफ्ना विचार व्यक्त गर्नुहोस्</translation>
<translation id="1743952081001089298">आफ्नो विन्डो सेयर गर्न सिस्टम सेटिङमा गई Browther लाई स्क्रिन रेकर्ड गर्ने अनुमति दिनुहोस्।</translation>
