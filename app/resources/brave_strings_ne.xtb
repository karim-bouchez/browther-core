<translation id="3145046053387919070">{NUM_EXTENSIONS,plural, =1{Browther ले तपाईंलाई यो एक्स्टेन्सन हटाउन सिफारिस गर्छ}other{Browther ले तपाईंलाई ती एक्स्टेन्सनहरू हटाउन सिफारिस गर्छ}}</translation>
<translation id="1527644038571473502">Browther मा सिस्टमको अडियो सेयर गर्न सिस्टम सेटिङ खोल्नुहोस् र "सिस्टमको अडियो मात्र रेकर्ड गर्ने अनुमति" अन गर्नुहोस्। त्यसपछि तपाईंले Browther रिस्टार्ट गर्नु पर्ने हुन्छ।</translation>
<translation id="1427913074981060872">तपाईंले खोल्ने साइटहरूले विज्ञापनको पर्फर्मेन्स मापन गर्ने सुविधाका सहायताले Browther सँग साइटलाई त्यसका विज्ञापनहरूको पर्फर्मेन्स मापन गर्न सघाउने जानकारी माग्न सक्छन्। विज्ञापनको पर्फर्मेन्स मापन गर्ने सुविधाले विभिन्न साइटहरूका बिचमा सकेसम्म कम जानकारी ट्रान्स्फर गरेर ती साइटमा गरिने गतिविधि ट्र्याक गर्न दिँदैन।</translation>
<translation id="1657652725060525338">Browther लाई अद्यावधिक गर्दै</translation>
<translation id="884846289464870238">तपाइँको प्राथमिकता फाइल दूषित वा अवैध छ।

Browther ले तपाइँका सेटिङहरू पुनर्प्राप्त गर्न असक्षम छ।.</translation>
<translation id="7339898014177206373">नयाँ विन्डो</translation>
<translation id="633044855886370183">तपाईंको वेब, बुकमार्कहरू, र अन्य Browther सामान यहाँ रहन्छन्।</translation>
<translation id="1185960088713242527">तपाईंको पासफ्रेज भएका व्यक्ति मात्र तपाईंको इन्क्रिप्ट गरिएको डेटा पढ्न सक्छन्। उक्त पासफ्रेज Browther मा पठाइँदैन वा Browther ले उक्त पासफ्रेज सेभ गर्दैन। तपाईंले आफ्नो पासफ्रेज बिर्सनुभयो वा तपाईं यो सेटिङ परिवर्तन गर्न चाहनुहुन्छ भने तपाईंले <ph name="BEGIN_LINK"/>आफ्नो खातामा भएको Browther को डेटा मेटाउनु<ph name="END_LINK"/> पर्ने हुन्छ।</translation>
<translation id="7125151836477182110">तपाईंको प्रणालीका प्रशासकले <ph name="TARGET_URL_HOSTNAME"/> माथि पहुँच गर्नका लागि <ph name="ALTERNATIVE_BROWSER_NAME"/> खोल्न Browther कन्फिगर गरेको छ।</translation>
<translation id="7352651011704765696">कुनै त्रुटि भयो</translation>
<translation id="6638123710106659002">तपाईंको कम्प्युटरमा macOS 13 वा सोभन्दा नयाँ संस्करण इन्स्टल गरिएको छ भने मात्र तपाईं भविष्यमा Browther का अपडेटहरू प्राप्त गर्नुहुन्छ। यो कम्प्युटरमा macOS 12 प्रयोग भइरहेको छ।</translation>
<translation id="7286289384512061761">तपाईंले हालसालै कुनै पनि साइट खोल्नुभएको छैन। Browther ले <ph name="PERMISSION_1"/> र <ph name="PERMISSION_2"/> सम्बन्धी अनुमति रद्द गरेको छ।</translation>
<translation id="113593073175678746">यो एक्स्टेन्सन अब प्रयोग गर्न मिल्दैन। बरु Browther ले तपाईंलाई यो एक्स्टेन्सन हटाउन सिफारिस गर्छ।</translation>
<translation id="137615076640044304">आफूले छाडेकै ठाउँबाट जारी राख्नुहोस्: हरेक पटक रिस्टार्ट गर्दा Browther ले तपाईंका ट्याबहरू रिस्टोर गर्छ। यसलाई अफ गर्न निम्नमा जानुहोस्:</translation>
<translation id="5967238175620483220">पासवर्डहरू Browther मा इम्पोर्ट गर्नुहोस्</translation>
<translation id="4719434010343478165"><ph name="PAGE_TITLE"/> - Browther Dev</translation>
<translation id="7450541714075000668">टेक्स्ट कपी गरियो</translation>
<translation id="7766009218653304791">Browther लाई यो साइटका लागि तपाईंको क्यामेरामाथि पहुँच राख्ने अनुमति चाहिन्छ</translation>
<translation id="5844418066487488520">माइक्रोफोन प्रयोग गर्न <ph name="BEGIN_LINK"/>सिस्टम सेटिङ<ph name="END_LINK"/>मा गई Browther लाई माइक्रोफोनको एक्सेस दिनुहोस्</translation>
<translation id="8065480549334161841">तपाईंको कम्प्युटरमा Windows १० वा सोभन्दा नयाँ संस्करण छ भने मात्र तपाईं भविष्यमा Browther का अपडेट प्राप्त गर्नुहुन्छ। यो कम्प्युटरमा Windows ७ प्रयोग भइरहेको छ।</translation>
<translation id="6299293759264950896">Browther बन्द गरेर फेरि खोल्ने हो?</translation>
<translation id="180908550381040105">हाल चलिरहेको समान Browther संस्करण स्थापना गर्न सकिंदैन। कृपया Braveलाई बन्द गरि पुन: प्रयास गर्नुहोस्।</translation>
<translation id="7625576878150380853">तपाईंले Browther मा साइन इन गरेका बेला तपाईं आफ्नो Browther खातामा पासवर्डलगायतका कुराहरू सेभ गर्न र उक्त खातामा सेभ गरिएका पासवर्डलगायतका कुराहरू प्रयोग गर्न सक्नुहुन्छ। <ph name="LEARN_MORE"/></translation>
<translation id="2761156087685028805">साइटहरूले अपेक्षित रूपमा काम गर्ने छन्। तपाईंले Browther का सबै विन्डो बन्द गर्नुभयो भने तपाईंलाई अधिकांश साइटहरूबाट साइन आउट गरिने छ तर तपाईं Browther मा साइन इन अवस्थामा हुनुहुन्छ भने तपाईंलाई तपाईंको Browther खाताबाट भने साइन आउट गरिने छैन।</translation>
<translation id="7099370564362681943">{0,plural, =1{Browther १ मिनेटमा पुनः सुरु हुने छ}other{Browther # मिनेटमा पुनः सुरु हुने छ}}</translation>
<translation id="3602613943932672197">तपाईंको जानकारीको सुरक्षार्थ Browther लाई तपाईंले हालसालै नखोलेका साइटहरूलाई दिइएका अनुमति रद्द गर्न दिनुहोस्।</translation>
<translation id="8759568213742229377">ब्राउजिङ तुरुन्तै सुरु गर्न Browther स्वतः सुरु गर्नुहोस्।</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME"/> इन्स्टलर</translation>
<translation id="8991800242749014880">Browther ले तपइँको क्यामेरा र माइक्रोफोन प्रयोग गर्दैछ।</translation>
<translation id="2692328388439821508">Browther भर्खरै झन राम्रो भयो</translation>
<translation id="4318444066563223295">अब Browther मा तपाईंका निम्ति थप सुविधाहरू उपलब्ध भएका छन्</translation>
<translation id="7649070708921625228">मद्दत</translation>
<translation id="5591287320769313116">Browther लाई तपाईंको तर्फबाट ब्राउज गर्न दिनुहोस्</translation>
<translation id="7658239707568436148">रद्द गर्नुहोस्</translation>
<translation id="6325482130534634729">Browther तपाईंको डिफल्ट ब्राउजर होइन</translation>
<translation id="8185915921134219287">आफ्ना यन्त्रहरूभरि Browther लाई सिंक तथा वैयक्तीकृत गर्नुहोस्</translation>
<translation id="5120421624925726813">Browther अपडेट</translation>
<translation id="7716950018788545737">कार्य(हरू) अन्त्य गरिए।</translation>
<translation id="77283119132245232">यसले <ph name="BROWSER_NAME"/> का सिस्टम ट्रेस गर्नेसम्बन्धी सेवाहरू उपलब्ध गराउँछ। यो सेवा अफ गरियो भने ब्राउजरले बनाएका पर्फर्मेन्स ट्रेसहरूमा कन्टेन्ट स्विच र रेडी थ्रेड इभेन्ट जस्ता सिस्टमसम्बन्धी सबै इभेन्टहरू समावेश गरिने छैन।</translation>
<translation id="6542096191573265107">यसले यो डिभाइसको तपाईंको ब्राउजिङ सम्बन्धी डेटा मेट्नेछ। पछि आफ्नो डेटा प्राप्त गर्न Browther मा <ph name="USER_EMAIL"/> को रूपमा साइन इन गर्नुहोस्।</translation>
<translation id="7747138024166251722">स्थापनाकर्ताले एक अस्थायी डाइरेक्टरी सिर्जना गर्न सकेन। कृपया खाली डिस्क स्थान र सफ्टवेयर स्थापना गर्न अनुमति जाँच गर्नुहोस् ।</translation>
<translation id="351575328720488268">रिसेट गरी Browther को डिफल्ट थिम प्रयोग गर्नुहोस्</translation>
<translation id="1054170408395182418">Browther लाई डिफल्ट ब्राउजर बनाउनुहोस् र टास्कबारमा पिन गर्नुहोस्</translation>
<translation id="4569594230301902490">Browther लाई अझ छिटो काम गर्ने बनाउनुहोस्</translation>
<translation id="5525298466557654312"><ph name="PAGE_TITLE"/> - Browther Canary</translation>
<translation id="7893465573639396635">तपाईंको इन्टरनेट ट्राफिक प्रयोग गर्न सक्ने मान्छेहरूलाई तपाईं कुन कुन वेबसाइटहरूमा जानुहुन्छ भन्ने कुरा हेर्न अझ कठिन बनाइदिनुहोस्। Browther ले DNS (डोमेन नेम सिस्टम) मा कुनै वेबसाइटको IP एड्रेस हेर्न सुरक्षित कनेक्सन प्रयोग गर्छ।</translation>
<translation id="7810005234485217901">तपाईं फोटो प्रयोग गरी खोज्ने सुविधा पिन गरी सजिलैसँग एक्सेस गर्न सक्नुहुन्छ</translation>
<translation id="2462631024103158515">यस यन्त्रमा यो खाता प्रयोग गरेर Browther प्रोफाइल बनाइसकिएको छ</translation>
<translation id="7845233973568007926">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्नो कम्प्युटर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="311190437086049332">Browther लाई नयाँ स्वरूप दिन यसलाई कस्टमाइज गर्नुहोस्</translation>
<translation id="6728847658878265103">Browther लाई नवीनतम संस्करणमा अद्यावधिक गर्न सकिएन, जसका कारण तपाईं नयाँ सुविधाहरू तथा सुरक्षासम्बन्धी समाधानहरू चलाउनबाट वञ्चित भइराख्नुभएको छ।</translation>
<translation id="7872446069773932638">डाउनलोड गरिँदै छ... <ph name="SECONDS"/> सेकेन्ड बाँकी छ</translation>
<translation id="5374532739787768601">तपाईंले आफ्नो पासफ्रेज बिर्सनुभयो वा तपाईं यो सेटिङ परिवर्तन गर्न चाहनुहुन्छ भने <ph name="BEGIN_LINK"/>आफ्नो खातामा भएको Browther को डेटा मेटाउनुहोस्<ph name="END_LINK"/></translation>
<translation id="7877212753140190672">यो फोटोका बारेमा सोध्नुहोस्</translation>
<translation id="9172499982238113829">Browther लाई डिफल्ट ब्राउजर बनाउनुहोस्</translation>
<translation id="3313826726620159669">Browther ले सम्भव भएसम्म असुरक्षित कनेक्सनहरू स्वतः अपग्रेड गरी तिनलाई HTTPS मा रूपान्तरण गर्छ</translation>
<translation id="3317928686912559532">तपाईंलाई Browther मा <ph name="USER_EMAIL_ADDRESS"/> को रूपमा साइन इन गरिएको थियो। कृपया फेरि साइन इन गर्न यही खाता प्रयोग गर्नुहोस्।</translation>
<translation id="6007009085341946457">यो Browther को एउटा सहायक स्थापना हो र यसलाई तपाईँको डिफल्ट ब्राउजर बनाउन सकिँदैन।</translation>
<translation id="8004582292198964060">ब्राउजर</translation>
<translation id="8010081455002666927">स्वतः पत्ता लगाउनुहोस्</translation>
<translation id="174885789898161653">Browther ले पहुँच प्राप्त गरेपछि, वेबसाइटहरू तपाईंसँग पहुँच माग्न सक्ने छन्।</translation>
<translation id="3001754454174546602">जुनसुकै बेला फटाफट Browther एक्सेस गर्न त्यसलाई आफ्नो टास्कबारमा पिन गर्नुहोस्</translation>
<translation id="80471789339884597">इन्स्टल गर्नुभएकोमा धन्यवाद। <ph name="BUNDLE_NAME"/> प्रयोग गर्नुअघि तपाईंले अनिवार्य रूपमा आफ्ना सबै ब्राउजर रिस्टार्ट गर्नु पर्छ।</translation>
<translation id="8054112667659782652">फोटो प्रयोग गरी खोज्ने सुविधाको सर्टकट सधैँ देखाउनुहोस्</translation>
<translation id="6993312779622863465">एपहरू चलिरहेका बेला Browther लाई ब्याकग्राउन्डमा चल्न नदिनुहोस्</translation>
<translation id="80790299200510644">फोटो प्रयोग गरी खोज्ने सुविधा</translation>
<translation id="8086881907087796310">तपाईंको कम्प्युटरले हार्डवेयरसम्बन्धी न्यूनतम मापदण्डहरू पूरा नगर्ने भएकाले इन्स्टल गर्ने प्रक्रिया पूरा हुन सकेन।</translation>
<translation id="4734875482699037091"><ph name="PAGE_TITLE"/> - Browther for Testing</translation>
<translation id="543407324609820492">यो साइट चलाउन Browther लाई लोकेसन प्रयोग गर्ने अनुमति दिनु पर्ने हुन्छ</translation>
<translation id="1767887552863788514">तपाईंले अर्को पटक आफ्नो <ph name="DEVICE_TYPE"/> मा Browther खोल्दा तपाईंलाई मूल्य ट्र्याकिङसम्बन्धी अलर्टहरू अन गर्ने प्रम्प्ट देखाइने छ।</translation>
<translation id="8118331347066725040">लेन्समार्फत खोज्ने सुविधासम्बन्धी प्रतिक्रिया पठाउनुहोस्</translation>
<translation id="5334309298019785904">तपाईंको डोमेनका हकमा सिंक गर्ने सुविधा उपलब्ध नभएको हुनाले ChromeOS ले तपाईंको डेटा सिंक गर्न सकेन।</translation>
<translation id="813913629614996137">सुरुवात गर्दै...</translation>
<translation id="4879101934056397619">Browther का सेवाका अतिरिक्त सर्तहरू</translation>
<translation id="4505690237431768764">यो फाइल खतरनाक छ, त्यसैले Browther ले यसमाथि रोक लगाएको छ।</translation>
<translation id="8177472873527554730">यो पेजमा सामग्री भेटिएन</translation>
<translation id="4720341280133158605">आफ्नो खाता (<ph name="USER_EMAIL"/>) मा Browther को डेटा सेभ तथा प्रयोग गर्न आफ्नो पासफ्रेज हाल्नुहोस्</translation>
<translation id="8221491193165283816">तपाईं सामान्यतया नोटिफिकेसनहरूमाथि रोक लगाउनुहुन्छ। यो साइटलाई तपाईंलाई नोटिफिकेसन पठाउन अनुमति दिन यहाँ क्लिक गर्नुहोस्।</translation>
<translation id="1083711467946065278">क्यामेरा प्रयोग गर्न <ph name="BEGIN_LINK"/>सिस्टम सेटिङ<ph name="END_LINK"/>मा गई Browther लाई क्यामेराको एक्सेस दिनुहोस्</translation>
<translation id="6569785137733211804">Browther ले यो एक्स्टेन्सनको स्रोत पुष्टि गर्न सक्दैन र यो असुरक्षित हुन सक्छ। यो एक्स्टेन्सनले अबदेखि तपाईंले खोल्ने साइटहरूमा रहेका व्यक्तिगत जानकारीलगायतका तपाईंको डेटा हेर्न र परिवर्तन गर्न नसकोस् भन्नाका लागि यसलाई Browther बाट हटाउनुहोस्।</translation>
<translation id="1122818205373648656">कुनै छविमा उपयोगी विवरण नभएका खण्डमा Browther ले तपाईंलाई एउटा विवरण उपलब्ध गराउने प्रयास गर्ने छ। विवरणहरू सिर्जना गर्न फोटो Browther मा पठाइन्छ। तपाईं सेटिङहरूमा गई जुनसुकै बेला यसलाई निष्क्रिय पार्न सक्नुहुन्छ।</translation>
<translation id="6877990294324319801">नयाँ प्रोफाइल बनाएर Browther मा साइन इन गर्ने हो?</translation>
<translation id="6478811748813986578"><ph name="BEGIN_LINK"/>Browther ले तपाईंलाई<ph name="END_LINK"/> असुरक्षित साइट तथा डाउनलोडका बारेमा चेतावनी दिन्छ</translation>
<translation id="1685486387921540822">तपाईंले हालसालै कुनै पनि साइट खोल्नुभएको छैन। Browther ले <ph name="PERMISSION"/> सम्बन्धी अनुमति सम्बन्धी अनुमति रद्द गरेको छ।</translation>
<translation id="8921153410460268589">Browther iOS एपमार्फत क्यामेरामा देखिएका कुराहरू किनमेल, अनुवाद तथा पहिचान गर्नुहोस्</translation>
<translation id="8313851650939857356">स्टार्टअप गर्ने क्रममा निम्न त्रुटि भयो: <ph name="STARTUP_ERROR"/>।</translation>
<translation id="7386947683604296534">तपाईंको सङ्गठनले तोकेको नियमअनुसार तपाईंले <ph name="TIMEOUT_DURATION"/> सम्म Browther प्रयोग गर्नुभएन भने त्यो स्वतः बन्द हुन्छ।</translation>
<translation id="8321888067342493336">फोटोका रूपमा सेभ गर्नुहोस्</translation>
<translation id="143016831128278157">आफ्ना यन्त्रहरूभरि Browther लाई सिंक तथा पर्सनलाइज गर्न साइन इन गर्नुहोस्</translation>
<translation id="4784945022248750283"><ph name="USER_EMAIL_ADDRESS"/> ले पहिला Browther प्रयोग गरिरहेको थियो</translation>
<translation id="1288164710697017468">आफ्नो Browther खाता (<ph name="ACCOUNT_EMAIL"/>) मा Browther को डेटा प्रयोग गरिरहन Browther अपडेट गर्नुहोस्</translation>
<translation id="8648401677359150296">तपाईंको कम्प्युटरमा Windows १० वा सोभन्दा नयाँ संस्करण छ भने मात्र तपाईं भविष्यमा Browther का अपडेट प्राप्त गर्नुहुन्छ। यो कम्प्युटरमा Windows ८ प्रयोग भइरहेको छ।</translation>
<translation id="8362914115861174987">यो भाषामा अनुवाद गर्नुहोस्:</translation>
<translation id="8367705492654390392">जस्तोसुकै प्रश्न सोध्नुहोस्</translation>
<translation id="5769022907892823357">आफ्ना सबै डिभाइसमा आफ्ना पासवर्डलगायतका थप कुराहरू प्राप्त गर्न Browther मा साइन इन गर्नुहोस्। तपाईंले साइन इन गरेपछि यो पासवर्ड तपाईंको Browther खातामा सेभ गरिने छ।</translation>
