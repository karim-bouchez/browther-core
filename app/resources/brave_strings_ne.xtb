<translation id="1497802159252041924">इन्स्टल गर्ने क्रममा त्रुटि भयो: <ph name="INSTALL_ERROR"/></translation>
<translation id="1518627427551567882">यो पेज सुरक्षित गरिएको छ</translation>
<translation id="7252430412915798987">Browther को ट्याब सेयर गर्नुहोस्</translation>
<translation id="6388429281015199562">Browther मा साइन इन गर्नुहोस्</translation>
<translation id="1547469039832541117">हाइलाइट गरिएको कार्य अन्त्य गर्छ।</translation>
<translation id="1801944307203212016">Browther लाई तपाईं वरपरको ठाउँको 3D नक्सा बनाउन तपाईंको क्यामेरा प्रयोग गर्ने अनुमति चाहिन्छ</translation>
<translation id="2181686311472635460">{NUM_EXTENSIONS,plural, =1{यो एक्स्टेन्सन अब प्रयोग गर्न मिल्दैन। Browther ले तपाईंलाई यो एक्स्टेन्सन हटाउन सिफारिस गर्छ।}other{यी एक्स्टेन्सनहरू अब प्रयोग गर्न मिल्दैनन्। Browther ले तपाईंलाई यी एक्स्टेन्सनहरू हटाउन सिफारिस गर्छ।}}</translation>
<translation id="4667068923142532753">Browther पिन गर्नुहोस्</translation>
<translation id="3006560544901646947">Browther का सुरक्षासम्बन्धी टुलहरू</translation>
<translation id="686052171138185761">Browther तपाईंको पासवर्ड म्यानेजरमा भएको जानकारी मेटाउन चाहन्छ। यसो गर्ने अनुमति दिन Windows को पासवर्ड टाइप गर्नुहोस्।</translation>
<translation id="8713026329083542796">Browther मा भएका गोपनीयता र सुरक्षासम्बन्धी मुख्य नियन्त्रण सुविधाहरूको समीक्षा गर्नुहोस्</translation>
<translation id="1640672724030957280">डाउनलोड गरिँदै छ...</translation>
<translation id="1680687534629375545">फोटो प्रयोग गरी खोज्ने सुविधालाई यो पेजका बारेमा सोध्नुहोस्</translation>
<translation id="1709772298389099340">यो सेवाले <ph name="BROWSER_NAME"/> का खास विशेषाधिकारहरू उपलब्ध गराउँछ।</translation>
<translation id="4243382967656566037">यी सुविधाहरूको गुणस्तर सुधार्ने प्रयोजनका लागि Browther ले तपाईंले यी सुविधासँग गरेका अन्तर्क्रियासम्बन्धी जानकारी Browther लाई पठाउँछ। समीक्षकहरू यो जानकारी पढ्न, प्रोसेस गर्न र एनोटेट गर्न सक्छन्।</translation>
<translation id="1722488837206509557">तपाईंले यो अनुमति दिनुभयो भने तपाईं उपलब्ध डिभाइसहरूमध्येबाट कुनै डिभाइस चयन गर्न र उक्त डिभाइसमा सामग्री देखाउन सक्नु हुने छ।</translation>
<translation id="6820510278633522408">Browther ले चाँडै नै ब्राउजिङ डेटा मेटाउने छ</translation>
<translation id="7775028004939172516">Browther ले वेबपेजहरू लोड गर्न HTTPS प्रयोग गर्ने प्रयास गर्ने छ</translation>
<translation id="6963959729951758069">Browther सम्बन्धी डेटा हटाइयो</translation>
<translation id="4085139922884095932">Browther <ph name="REMAINING_TIME"/> पछि रिस्टार्ट हुने छ</translation>
<translation id="2586248102295515296">HTTPS उपलब्ध नहुँदा Browther ले तपाईंलाई चेतावनी नदिइकनै असुरक्षित कनेक्सन प्रयोग गर्ने छ</translation>
<translation id="3975328336074677101">Browther पृष्ठभूमिमा चलाउछन्</translation>
<translation id="2497443204974841650">Browther पुनर्स्थापित गर्नुहोस्</translation>
<translation id="1724309687045787742">Browther <ph name="AUTHENTICATION_PURPOSE"/> प्रयास गर्दै छ</translation>
<translation id="4553225588627299783">तपाईंले अर्को पटक आफ्नो <ph name="DEVICE_TYPE"/> मा Browther खोल्दा तपाईंलाई Browther पासवर्ड म्यानेजर प्रयोग गर्ने प्रम्प्ट देखाइने छ।</translation>
<translation id="1838374766361614909">खोजी खाली गर्नुहोस्</translation>
<translation id="2337233040802538155">तपाईंको Browther खातामा ब्राउजिङ डेटा यथावत् राखी यो डिभाइसबाट मात्र ब्राउजिङ डेटा मेटाउन <ph name="BEGIN_LINK"/>Browther बाट साइन आउट गर्नुहोस्<ph name="END_LINK"/>।</translation>
<translation id="3927415701154897844">जुनसुकै बेला जहाँसुकैबाट नयाँ ट्याब समूहहरू खोल्न वा बनाउन आफ्नो फोनमा Browther डाउनलोड गर्नुहोस्।</translation>
<translation id="2063443520349987970">तपाईं साइन इन गरिएका आफ्ना Browther खाताहरू व्यवस्थापन गर्न सक्नुहुन्छ। तपाईंका Browther खाताहरू Browther ब्राउजर, Play स्टोर, Gmail र अन्य एपहरूमा प्रयोग गरिन्छन्। तपाईं परिवारका सदस्य जस्ता अरू कसैको खाता थप्न चाहनुहुन्छ भने उहाँको खाता थप्नुको साटो उहाँलाई नयाँ व्यक्तिका रूपमा आफ्नो <ph name="DEVICE_TYPE"/> मा सामेल गराउनुहोस्। <ph name="LINK_BEGIN"/>थप जान्नुहोस्<ph name="LINK_END"/></translation>
<translation id="1862852878885210965">फोटो प्रयोग गरी खोज्ने सुविधामार्फत खोज्नुहोस्</translation>
<translation id="1880677175115548835">टेक्स्ट म्यासेज चयन गर्नुहोस्</translation>
<translation id="3183933389992069620">तपाईंले व्यवस्थित खातासँगै साइन इन गरि यसको व्यवस्थापकलाई तपाईंको Browther प्रोफाइल माथि नियन्त्रण दिइरहनुभएको छ। तपाईंको Browther डाटा, जस्तै तपाईंका एप्स, बुकमार्कहरू, इतिहास, पासवर्डहरू, र अन्य सेटिङहरू <ph name="USER_NAME"/> मा स्थायी रूपमा बाँधिनेछन्। तपाईं यस डाटालाई गूगल खाता ड्यासबोर्ड मार्फत मेटाउन सक्षम हुनुहुनेछ, तर तपाईं यस खातालाई अर्को खातामा संलग्न गर्न सक्षम हुनुहुनेछैन। तपाईंले आफ्नो विद्यमान Browther डाटालाई अलग राख्न वैकल्पिक रूपमा नयाँ प्रोफाइल सिर्जना गर्न सक्नुहुन्छ। <ph name="LEARN_MORE"/></translation>
<translation id="8330480262129054297">Browther ले ब्याकग्राउन्डमा हुने गतिविधि र निर्वाध स्क्रोलिङ तथा भिडियोको फ्रेम रेटलगायतका भिजुअल इफेक्टहरू सीमित पारेर ब्याट्रीको पावर जोगाउँछ। <ph name="BEGIN_LINK"/>इनर्जी सेभरका बारेमा थप जान्नुहोस्<ph name="END_LINK"/></translation>
<translation id="1898804291554630487">यो पेजका बारेमा प्रश्न सोध्नुहोस्</translation>
<translation id="9128006428501241840">Browther अपडेटर सर्भिस</translation>
<translation id="6302815314157879372">यसलाई निष्क्रिय पारेर, तपाईं Browther मा साइन इन नगरिकनै Gmail जस्ता Browther का साइटहरूमा साइन इन गर्न सक्नुहुन्छ</translation>
<translation id="1063611196035804685">Browther ले कुनै प्रतिक्रिया जनाइरहेको छैन। अहिले नै पुन: लन्च गर्ने?</translation>
<translation id="2873360330889594383">तपाईंको सङ्गठन <ph name="MANAGER"/> को नीतिअनुसार तपाईंले Browther मा साइन इन गर्नु पर्ने हुन्छ</translation>
<translation id="4035053306113201399">यो अपडेट लागू गर्न ChromeOS रिस्टार्ट गर्नु पर्ने हुन्छ।</translation>
<translation id="2861285003831382718">यस प्रकारको फाइल सामान्यतया डाउनलोड नगरिने र खतरनाक हुन सक्ने भएकाले Browther ले उक्त प्रकारको फाइल डाउनलोड गर्ने कार्य ब्लक गरेको छ</translation>
<translation id="1953553007165777902">डाउनलोड गरिँदै छ... <ph name="MINUTE"/> मिनेट बाँकी छ</translation>
<translation id="2080160985220483492">Browther सम्बन्धी सुझाव: पासवर्डहरू सेभ गर्नुहोस्</translation>
<translation id="8037497710694492565">Browther ले डिफल्ट ब्राउजर निर्धारण वा सेट गर्न सक्दैन</translation>
<translation id="7395009124247513849">Browther ले केही फाइलहरू ब्लक गर्नुको कारण जान्नुहोस् (नयाँ ट्याबमा खुल्छ)</translation>
<translation id="762710512520170632">तपाईंको Browther सफ्टवेयर अप टू डेट राख्छ। यो सेवा अफ गरिएका वा रोकिएका खण्डमा तपाईंको Browther सफ्टवेयर अप टू डेट राखिने छैन। त्यसकारण, उक्त सफ्टवेयरमा देखिन सक्ने समस्याहरू समाधान गर्न सकिँदैन र त्यसमा भएका सुविधाहरूले काम नगर्न सक्छन्। कुनै पनि Browther सफ्टवेयरले यो सेवा प्रयोग गरिरहेको छैन भने यो सेवा स्वतः अनइन्स्टल हुन्छ।</translation>
<translation id="5793588180426267429">यसले यो डिभाइसको १ वस्तु मेट्नेछ। पछि आफ्नो डेटा प्राप्त गर्न Browther मा <ph name="USER_EMAIL"/> को रूपमा साइन इन गर्नुहोस्।</translation>
<translation id="2018879682492276940">इन्स्टल गर्न सकिएन। कृपया फेरि प्रयास गर्नुहोस्।</translation>
<translation id="6351516710581760512">तपाईंका अन्य पासवर्डहरू कतै खुलासा भएका छन् कि छैनन् तथा सुरक्षासम्बन्धी अन्य समस्याबाट सुरक्षित छन् कि छैनन् भन्ने कुरा जाँच्न <ph name="BEGIN_LINK"/>Browther मा साइन इन गर्नुहोस्<ph name="END_LINK"/>।</translation>
