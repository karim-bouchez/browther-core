+// [Browther/Sawtunaa] Audio tap V2 (decode-ahead natif, jumeau du tap vidéo
+// Basarunaa — cf. browther-private docs/sawtunaa/AV_SYNC.md § Option B).
+// Quand le switch est présent (posé par le browser, jamais par défaut),
+// AudioRendererImpl force un latency hint de 2 s (avance de PCM décodé dans
+// AudioRendererAlgorithm) et traite le PCM in-place dans ce buffer d'avance
+// AVANT consommation par le sink. Littéral dupliqué de
+// brave/components/constants/brave_switches.h (kSawtunaaAudioTap) : media/ ne
+// peut pas dépendre de brave/ — garder les deux en phase.
+constexpr char kSawtunaaAudioTapSwitch[] = "sawtunaa-audio-tap";
+
+bool IsSawtunaaAudioTapEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kSawtunaaAudioTapSwitch);
+}
+
+// [Browther/Sawtunaa] Taille de batch envoyée au traitement natif (~256 ms
+// @48 kHz) : assez gros pour amortir l'aller-retour Mojo, assez petit pour
+// itérer confortablement dans le budget decode-ahead de 2 s.
+constexpr int kSawtunaaBatchFrames = 12288;
+// Borne de rétention : au-delà, CanRead_Locked() suspend les lectures amont
+// (la régulation upstream IsQueueFull ne voit pas les buffers retenus).
+constexpr int kSawtunaaMaxPendingFrames = 48000;
+
+// [Browther/Sawtunaa] Concatène le PCM des buffers retenus en planar float32
+// (bloc L puis bloc R). ReadFrames gère tous les formats sources
+// (S16/S32/F32/planar) et la vue post-TrimStart. Les originaux ne sont PAS
+// mutés (partagés avec le callback de transcription live-caption).
+std::vector<float> SawtunaaBuffersToPlanar(
+    const std::vector<scoped_refptr<AudioBuffer>>& buffers,
+    int channels,
+    int total_frames) {
+  std::vector<float> planar(static_cast<size_t>(total_frames) * channels);
+  auto out = base::span(planar);
+  int offset = 0;
+  for (const auto& buffer : buffers) {
+    const int frames = buffer->frame_count();
+    std::unique_ptr<AudioBus> bus = AudioBus::Create(channels, frames);
+    buffer->ReadFrames(frames, 0, 0, bus.get());
+    for (int ch = 0; ch < channels; ++ch) {
+      auto dst = out.subspan(
+          static_cast<size_t>(ch) * total_frames + offset,
+          static_cast<size_t>(frames));
+      std::ranges::copy(bus->AllChannels()[ch], dst.begin());
+    }
+    offset += frames;
+  }
+  return planar;
+}
