 namespace media {
 
+namespace {
+
+// [Browther/Sawtunaa] Audio tap V2 (decode-ahead natif, jumeau du tap vidéo
+// Basarunaa — cf. browther-private docs/sawtunaa/AV_SYNC.md § Option B).
+// Quand le switch est présent (posé par le browser, jamais par défaut),
+// AudioRendererImpl force un latency hint de 2 s (avance de PCM décodé dans
+// AudioRendererAlgorithm) et traite le PCM in-place dans ce buffer d'avance
+// AVANT consommation par le sink. Littéral dupliqué de
+// brave/components/constants/brave_switches.h (kSawtunaaAudioTap) : media/ ne
+// peut pas dépendre de brave/ — garder les deux en phase.
+constexpr char kSawtunaaAudioTapSwitch[] = "sawtunaa-audio-tap";
+
+bool IsSawtunaaAudioTapEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      kSawtunaaAudioTapSwitch);
+}
+
+// [Browther/Sawtunaa] SPIKE (étape 1) : traitement trivial qui prouve le point
+// d'insertion — remplacé par NSNet2 natif en batch (étape 2). Mute alterné
+// calé sur le TEMPS MÉDIA (1 s de son / 1 s de silence) : validation à
+// l'oreille sans ambiguïté, et prouve au passage que le buffer traité porte le
+// bon timestamp. Le buffer est converti en float planar via ReadFrames (gère
+// TOUS les formats sources, S16/S32/F32/planar, et la vue post-TrimStart),
+// traité, puis RECRÉÉ : on ne mute pas l'original (partagé avec le callback de
+// transcription live-caption).
+scoped_refptr<AudioBuffer> SawtunaaTapProcessBuffer(
+    const scoped_refptr<AudioBuffer>& buffer) {
+  std::unique_ptr<AudioBus> bus =
+      AudioBus::Create(buffer->channel_count(), buffer->frame_count());
+  buffer->ReadFrames(buffer->frame_count(), 0, 0, bus.get());
+  // Secondes médias impaires -> silence (granularité = 1 buffer ~20 ms, la
+  // frontière peut baver d'un buffer : sans importance pour le spike).
+  const bool mute_this_second = (buffer->timestamp().InSeconds() % 2) == 1;
+  const float gain = mute_this_second ? 0.0f : 1.0f;
+  for (AudioBus::Channel channel : bus->AllChannels()) {
+    for (float& sample : channel) {
+      sample *= gain;
+    }
+  }
+  return AudioBuffer::CopyFrom(buffer->channel_layout(), buffer->sample_rate(),
+                               buffer->timestamp(), bus.get());
+}
+
+}  // namespace
