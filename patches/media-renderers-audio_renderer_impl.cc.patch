+bool AudioRendererImpl::SawtunaaTapEligible_Locked(
+    const AudioBuffer& buffer) const {
+  lock_.AssertAcquired();
+  if (!sawtunaa_tap_active_ || sawtunaa_tap_bypass_) {
+    return false;
+  }
+  // Bitstream (AC3/DTS passthrough) : PCM inaccessible. > 2 canaux : non géré
+  // V1. Mismatch de layout avec les paramètres courants : flux exotique →
+  // upstream. Tous ces cas = passthrough silencieux du buffer.
+  return !buffer.IsBitstreamFormat() && buffer.frame_count() > 0 &&
+         buffer.channel_count() == audio_parameters_.channels() &&
+         audio_parameters_.channels() <= 2 &&
+         buffer.sample_rate() == audio_parameters_.sample_rate();
+}
+
+void AudioRendererImpl::SawtunaaMaybeSendBatch_Locked() {
+  lock_.AssertAcquired();
+  if (!sawtunaa_tap_active_ || sawtunaa_tap_bypass_ || sawtunaa_inflight_) {
+    return;
+  }
+  const bool flush = sawtunaa_eos_pending_;
+  if (!flush && sawtunaa_pending_frames_ < kSawtunaaBatchFrames) {
+    return;
+  }
+  if (sawtunaa_pending_.empty() && !flush) {
+    return;
+  }
+
+  const int channels = audio_parameters_.channels();
+  const int sample_rate = audio_parameters_.sample_rate();
+  const ChannelLayout layout = audio_parameters_.channel_layout();
+  const int frames = sawtunaa_pending_frames_;
+  std::vector<scoped_refptr<AudioBuffer>> originals =
+      std::move(sawtunaa_pending_);
+  sawtunaa_pending_.clear();
+  sawtunaa_pending_frames_ = 0;
+
+  std::vector<float> planar =
+      SawtunaaBuffersToPlanar(originals, channels, frames);
+
+  sawtunaa_inflight_ = true;
+  static int swt_batch_n = 0;
+  if ((swt_batch_n++ % 20) == 0) {
+    MEDIA_LOG(INFO, media_log_)
+        << "[swtTAP] batch sent frames=" << frames << " flush=" << flush
+        << " lead="
+        << (algorithm_->BufferedFrames() * static_cast<int64_t>(1000) /
+            std::max(1, sample_rate))
+        << "ms";
+  }
+
+  // Réponse re-postée sur le thread média. Les originaux voyagent dans le
+  // bind (fallback passthrough si le service décline).
+  auto done = base::BindPostTaskToCurrentDefault(base::BindOnce(
+      &AudioRendererImpl::OnSawtunaaBatchDone, weak_factory_.GetWeakPtr(),
+      sawtunaa_generation_, std::move(originals), flush, channels, sample_rate,
+      layout));
+  {
+    // L'appel embedder ne fait qu'un PostTask interne, mais pas de raison de
+    // le faire sous notre lock.
+    base::AutoUnlock auto_unlock(lock_);
+    sawtunaa_tap_process_.Run(
+        static_cast<int64_t>(player_id_.GetUnsafeValue()), std::move(planar),
+        frames, channels, sample_rate, flush, std::move(done));
+  }
+}
+
+void AudioRendererImpl::OnSawtunaaBatchDone(
+    int generation,
+    std::vector<scoped_refptr<AudioBuffer>> originals,
+    bool flush,
+    int channels,
+    int sample_rate,
+    ChannelLayout layout,
+    bool ok,
+    std::vector<float> processed) {
+  DCHECK(task_runner_->RunsTasksInCurrentSequence());
+  base::AutoLock auto_lock(lock_);
+  sawtunaa_inflight_ = false;
+  if (generation != sawtunaa_generation_ || state_ == kUninitialized ||
+      state_ == kFlushing || state_ == kFlushed) {
+    // Seek/flush/teardown entre-temps : résultat obsolète.
+    return;
+  }
+
+  if (!ok) {
+    // Service indisponible (modèle absent, rate non géré, erreur ORT) →
+    // PASSTHROUGH : les originaux entrent tels quels, et le flux entier passe
+    // en bypass (plus de rétention — évite le ping-pong par batch).
+    sawtunaa_tap_bypass_ = true;
+    MEDIA_LOG(INFO, media_log_)
+        << "[swtTAP] service declined batch (rate=" << sample_rate
+        << ") -> passthrough for this stream";
+    for (auto& buffer : originals) {
+      algorithm_->EnqueueBuffer(std::move(buffer));
+    }
+    for (auto& buffer : sawtunaa_pending_) {
+      algorithm_->EnqueueBuffer(std::move(buffer));
+    }
+    sawtunaa_pending_.clear();
+    sawtunaa_pending_frames_ = 0;
+  } else if (!processed.empty() &&
+             processed.size() % static_cast<size_t>(channels) == 0) {
+    // Reconstruction : un AudioBuffer PlanarF32 unique, timestamps continus
+    // depuis le premier buffer retenu du flux (la sortie du traitement est
+    // alignée échantillon-près sur l'entrée).
+    const int frames = static_cast<int>(processed.size()) / channels;
+    std::unique_ptr<AudioBus> bus = AudioBus::Create(channels, frames);
+    auto in = base::span(processed);
+    for (int ch = 0; ch < channels; ++ch) {
+      std::ranges::copy(in.subspan(static_cast<size_t>(ch) * frames,
+                                   static_cast<size_t>(frames)),
+                        bus->AllChannels()[ch].begin());
+    }
+    scoped_refptr<AudioBuffer> out =
+        AudioBuffer::CopyFrom(layout, sample_rate, sawtunaa_out_ts_, bus.get());
+    sawtunaa_out_ts_ +=
+        AudioTimestampHelper::FramesToTime(frames, sample_rate);
+    algorithm_->EnqueueBuffer(std::move(out));
+    VLOG(1) << "[swtTAP] batch done frames=" << frames
+            << " out_ts=" << sawtunaa_out_ts_.InMilliseconds() << "ms";
+  }
+
+  // EOS différé : le flush est revenu, la queue STFT est vidée → on peut
+  // marquer la fin de flux.
+  if (flush && sawtunaa_eos_pending_) {
+    sawtunaa_eos_pending_ = false;
+    algorithm_->MarkEndOfStream();
+    if (first_packet_timestamp_ == kNoTimestamp &&
+        (state_ == kPlaying || state_ == kReinitializingSink)) {
+      task_runner_->PostTask(
+          FROM_HERE, base::BindOnce(&AudioRendererImpl::OnPlaybackEnded,
+                                    weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  // Transitions de buffering (jumeau de la fin de HandleDecodedBuffer_Locked)
+  // + batch suivant si le pending a suffisamment regonflé + réamorçage des
+  // lectures (CanRead a pu être suspendu par le cap pending).
+  if (state_ == kPlaying || state_ == kReinitializingSink) {
+    if (received_end_of_stream_ || algorithm_->IsQueueAdequateForPlayback()) {
+      if (buffering_state_ == BUFFERING_HAVE_NOTHING) {
+        SetBufferingState_Locked(BUFFERING_HAVE_ENOUGH);
+      }
+    }
+  }
+  SawtunaaMaybeSendBatch_Locked();
+  AttemptRead_Locked();
+}
+
+void AudioRendererImpl::SawtunaaResetOnFlush_Locked() {
+  lock_.AssertAcquired();
+  if (!sawtunaa_tap_active_) {
+    return;
+  }
+  ++sawtunaa_generation_;
+  sawtunaa_pending_.clear();
+  sawtunaa_pending_frames_ = 0;
+  sawtunaa_out_ts_valid_ = false;
+  sawtunaa_eos_pending_ = false;
+  // Reset des états du flux côté service (GRU/rings/overlap) — un batch
+  // obsolète encore en vol côté browser sera traité AVANT ce reset (même
+  // séquence ordonnée) puis sa réponse droppée ici par la génération.
+  if (sawtunaa_tap_control_) {
+    sawtunaa_tap_control_.Run(
+        static_cast<int64_t>(player_id_.GetUnsafeValue()), /*destroy=*/false);
+  }
+}
