+  // [Browther/Basarunaa] decode-ahead (détection v2, notify+pull). The media
+  // player notifies the embedder of EVERY decode-ahead video frame (main
+  // render thread, metadata only — no pixels) and hands it a pull handle to
+  // read back an arbitrary buffered frame on demand (CPU + downscaled packed
+  // BGRA). A null sink (default) means the embedder wants no frames. All
+  // types are intentionally POD (no embedder types) so the blink media stack
+  // stays free of embedder deps.
+  // Reply of a pull: (bgra_pixels — empty on failure (frame evicted/seek/
+  // teardown), width, height, actual_media_timestamp).
+  using LeadFrameReadbackDoneCB =
+      base::OnceCallback<void(std::vector<uint8_t>, int, int, base::TimeDelta)>;
+  // Pull: (target_media_timestamp, done). Serialized per player (small FIFO).
+  using LeadFrameReadbackCB =
+      base::RepeatingCallback<void(base::TimeDelta, LeadFrameReadbackDoneCB)>;
+  // Notification: (player_id — stable per media player, so the embedder can
+  // keep per-player detection state, media_timestamp, pull handle).
+  using VideoLeadFrameSink = base::RepeatingCallback<
+      void(int64_t, base::TimeDelta, const LeadFrameReadbackCB&)>;
+  virtual VideoLeadFrameSink GetVideoLeadFrameSink(RenderFrame* render_frame);
+
+  // [Browther/Sawtunaa] audio tap V2 (native NSNet2 music removal). The media
+  // pipeline (AudioRendererImpl) hands decoded PCM batches to the embedder
+  // BEFORE they enter the playback buffer and swaps in the processed result
+  // (decode-ahead budget ~2 s). POD types only, same layering rule as the
+  // video sink above. Null callbacks (default) = tap disabled.
+  // Process reply: (ok — false means the caller must pass the ORIGINAL
+  // buffers through (model missing/unsupported stream/error), processed PCM,
+  // planar float32, |channels| blocks; may be shorter than the input —
+  // structural STFT retention — or longer on flush).
+  using SawtunaaAudioTapDoneCB =
+      base::OnceCallback<void(bool, std::vector<float>)>;
+  // (stream_id — stable per media player, planar PCM, frames, channels,
+  //  sample_rate, flush — end-of-stream/config-change: drain the tail, done).
+  // Callable from ANY thread (the embedder hops internally); |done| must be
+  // callable from any thread too (callers wrap with BindPostTask).
+  using SawtunaaAudioTapProcessCB =
+      base::RepeatingCallback<void(int64_t,
+                                   std::vector<float>,
+                                   int,
+                                   int,
+                                   int,
+                                   bool,
+                                   SawtunaaAudioTapDoneCB)>;
+  // (stream_id, destroy — true: player teardown, false: seek/flush reset).
+  using SawtunaaAudioTapControlCB = base::RepeatingCallback<void(int64_t, bool)>;
+  struct CONTENT_EXPORT SawtunaaAudioTap {
+    SawtunaaAudioTap();
+    SawtunaaAudioTap(SawtunaaAudioTap&&);
+    SawtunaaAudioTap& operator=(SawtunaaAudioTap&&);
+    ~SawtunaaAudioTap();
+    SawtunaaAudioTapProcessCB process;
+    SawtunaaAudioTapControlCB control;
+  };
+  virtual SawtunaaAudioTap GetSawtunaaAudioTap(RenderFrame* render_frame);
