diff --git a/media/renderers/video_renderer_impl.cc b/media/renderers/video_renderer_impl.cc
index a342b81050aca..8d3eae8652338 100644
--- a/media/renderers/video_renderer_impl.cc
+++ b/media/renderers/video_renderer_impl.cc
@@ -625,6 +625,22 @@ void VideoRendererImpl::FrameReady(VideoDecoderStream::ReadResult result) {
   last_decoder_stream_avg_duration_ = video_decoder_stream_->AverageDuration();
 
   const bool is_eos = frame->metadata().end_of_stream;
+  // [Browther/Basarunaa] decode-ahead spike (voie native, plan A) — prouve que le
+  // renderer décode les frames EN AVANCE de l'affichage : log périodique du temps
+  // média de la frame décodée + profondeur de file (≈ avance). Point de tap pour
