+// [Browther/Basarunaa] Callback invoqué (sur le thread média) avec chaque frame
+// décodée disponible EN AVANCE de l'affichage (decode-ahead). Le readback
+// GPU->CPU se fait côté sink (WebMediaPlayerImpl, qui possède le raster context)
+// après un hop vers le main thread. Défaut null = feature désactivée.
+using LeadFrameCB = base::RepeatingCallback<void(scoped_refptr<VideoFrame>)>;
+
+// [Browther/Sawtunaa] audio tap V2 : AudioRendererImpl retient le PCM décodé,
+// l'envoie par batchs à l'embedder (NSNet2 natif browser) via ces callbacks
+// POD et n'enqueue que le résultat traité. Aliases structurels de
+// content::ContentRendererClient::SawtunaaAudioTap* (media/ ne peut inclure ni
+// content/ ni blink/). Appelables depuis le thread média (hop interne côté
+// embedder) ; |done| est invoqué sur un thread arbitraire (les appelants le
+// wrappent avec BindPostTaskToCurrentDefault). Défaut null = tap désactivé.
+using SawtunaaAudioTapDoneCB =
+    base::OnceCallback<void(bool, std::vector<float>)>;
+using SawtunaaAudioTapProcessCB = base::RepeatingCallback<
+    void(int64_t, std::vector<float>, int, int, int, bool,
+         SawtunaaAudioTapDoneCB)>;
+using SawtunaaAudioTapControlCB = base::RepeatingCallback<void(int64_t, bool)>;
+
