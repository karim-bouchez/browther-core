+// [Browther/Sawtunaa] Resync A/V option A (cf. browther-private
+// docs/sawtunaa/AV_SYNC.md) : le fake stream est l'horloge vidéo d'un onglet
+// capturé via tabCapture. Quand le browser pose --sawtunaa-av-sync-delay-ms
+// sur le service audio (pref kSawtunaaEnabled ON), on ajoute la latence du
+// traitement Sawtunaa au delay rapporté -> AudioClock recale la vidéo
+// d'autant -> lip-sync. Sans le switch (Sawtunaa OFF) : comportement
+// upstream inchangé (switch absent -> délai nul).
+//
+// LIMITE V1 CONNUE : le switch est process-wide, donc quand un profil a
+// Sawtunaa ON, TOUS les FakeAudioOutputStream du service audio prennent ce
+// délai — y compris ceux hors tabCapture (fallback quand le device physique
+// échoue, --mute-audio). Effet borné aux users Sawtunaa-ON (zéro impact
+// sinon) et sans traitement audio réel dans ces cas ; le décalage vidéo qui
+// en résulte est le prix d'Option A. Le gating par-stream (savoir si le
+// stream vient du diverting tabCapture) = Option B (traitement natif), V2.
+base::TimeDelta GetSawtunaaAvSyncDelay() {
+  constexpr char kSwitchName[] = "sawtunaa-av-sync-delay-ms";
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  if (!command_line.HasSwitch(kSwitchName)) {
+    return base::TimeDelta();
+  }
+  int delay_ms = 0;
+  if (!base::StringToInt(command_line.GetSwitchValueASCII(kSwitchName),
+                         &delay_ms) ||
+      delay_ms <= 0 || delay_ms > 10000) {
+    return base::TimeDelta();
+  }
+  return base::Milliseconds(delay_ms);
+}
+
+}  // namespace
+
 // static
 AudioOutputStream* FakeAudioOutputStream::MakeFakeStream(
     AudioManagerBase* manager, const AudioParameters& params) {
@@ -23,7 +60,8 @@ AudioOutputStream* FakeAudioOutputStream::MakeFakeStream(
