+// [Browther/Basarunaa] decode-ahead — readback GPU->CPU des frames lead sur une
+// séquence DÉDIÉE (hors main render thread). Vit et meurt sur le worker. Copie
+// allégée de blink::SyncReadbackThread (webcodecs/background_readback.cc) : un
+// readback GPU->CPU synchrone sur le main thread déstabilise la couche
+// graphique macOS (crash ImageIO/WindowManagement) -> on le déporte ici avec
+// SON PROPRE RasterContextProvider bindé à cette séquence (surtout PAS le
+// raster_context_provider_ du compositor, thread-affine au main thread).
+class LeadFrameReadbackThread
+    : public base::RefCountedThreadSafe<LeadFrameReadbackThread> {
+ public:
+  LeadFrameReadbackThread() { DETACH_FROM_THREAD(thread_checker_); }
+
+  LeadFrameReadbackThread(const LeadFrameReadbackThread&) = delete;
+  LeadFrameReadbackThread& operator=(const LeadFrameReadbackThread&) = delete;
+
+  scoped_refptr<media::VideoFrame> ReadbackToFrame(
+      scoped_refptr<media::VideoFrame> frame) {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    if (!frame || !LazyInitialize()) {
+      return nullptr;
+    }
+    // update_source_release_token=false : la lead frame est ENCORE possédée par
+    // le pipeline d'affichage (elle sera composée ~0,7 s plus tard) -> NE PAS
+    // écraser son release sync-token (course = bug A). Sûr ici : le readback est
+    // synchrone et |frame| (scoped_refptr par valeur) reste vivant tout l'appel.
+    return media::ReadbackTextureBackedFrameToMemorySync(
+        *frame, context_provider_->RasterInterface(), &pool_,
+        /*update_source_release_token=*/false);
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<LeadFrameReadbackThread>;
+  ~LeadFrameReadbackThread() = default;
+
+  bool LazyInitialize() {
+    DCHECK_CALLED_ON_VALID_THREAD(thread_checker_);
+    if (context_provider_) {
+      return true;
+    }
+    context_provider_ = CreateRasterGraphicsContextProvider(
+        KURL("chrome://BrowtherLeadReadback"),
+        Platform::RasterContextType::kWebCodecsReadback);
+    if (!context_provider_) {
+      return false;
+    }
+    if (!context_provider_->BindToCurrentSequence()) {
+      context_provider_ = nullptr;
+      return false;
+    }
+    return true;
+  }
+
+  media::VideoFramePool pool_;
+  std::unique_ptr<WebGraphicsContext3DProvider> context_provider_;
+  THREAD_CHECKER(thread_checker_);
+};
