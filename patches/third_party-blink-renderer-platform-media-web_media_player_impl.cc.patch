+void WebMediaPlayerImpl::BasarunaaDisableTapForProtectedContent() {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (basarunaa_protected_content_) {
+    return;
+  }
+  basarunaa_protected_content_ = true;
+  if (!lead_frame_sink_ && lead_ring_.empty() && lead_readback_queue_.empty()) {
+    return;  // tap jamais branché (Basarunaa OFF / build sans la capacité)
+  }
+  // Ordre calqué sur le destructeur : on coupe la notification AVANT de vider
+  // les files, pour qu'un done qui réentrerait ne réamorce rien.
+  lead_frame_sink_.Reset();
+  lead_ring_.clear();
+  while (!lead_readback_queue_.empty()) {
+    std::move(lead_readback_queue_.front().second)
+        .Run({}, 0, 0, base::TimeDelta());
+    lead_readback_queue_.pop_front();
+  }
+  // Le readback éventuellement EN VOL n'est pas dans la file : sa reply est
+  // neutralisée par le latch dans OnLeadReadbackDone.
+  MEDIA_LOG(INFO, media_log_.get())
+      << "[bsrV2] protected content -> lead frame tap disabled";
+}
+
+void WebMediaPlayerImpl::OnLeadFrame(scoped_refptr<media::VideoFrame> frame) {
+  // [Browther/Basarunaa] decode-ahead ② (détection v2, notify+pull) : alimente
+  // le ring de frames décodées-en-avance (refs seulement) puis NOTIFIE
+  // l'embedder — métadonnées, pas de pixels. Les readbacks GPU->CPU ne se font
+  // plus qu'À LA DEMANDE de l'embedder (checkpoints ~1/s + dichotomie au cut),
+  // via ReadbackLeadFrameAt. ~0 readback sans cut, vs 1/frame en Phase A.
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!frame)
+    return;
+
+  // [Browther/Basarunaa] Sink absent = pref Basarunaa OFF quand ce player a
+  // été créé (ou build sans la capacité --basarunaa-video-tap) OU embedder
+  // sans analyse -> ne rien faire. Gate normal du tap, pas un debug.
+  // Couvre aussi le contenu protégé : BasarunaaDisableTapForProtectedContent()
+  // a reset le sink (une frame déjà postée par le thread média peut encore
+  // arriver ici après la coupure).
+  if (!lead_frame_sink_ || basarunaa_protected_content_)
+    return;
+
+  // Ring : reset sur seek arrière (ts recule), éviction des frames dépassées
+  // par la lecture (la dichotomie ne travaille que sur la fenêtre d'avance),
+  // cap dur aligné sur kAbsoluteMaxFramesBasarunaa. Les frames de la fenêtre
+  // sont déjà vivantes dans la file du VideoRendererAlgorithm : on n'ajoute
+  // que des pointeurs (validé POC étape 0).
+  const base::TimeDelta ts = frame->timestamp();
+  if (!lead_ring_.empty() && ts < lead_ring_.back()->timestamp()) {
+    lead_ring_.clear();
+  }
+  lead_ring_.push_back(std::move(frame));
+  const base::TimeDelta playhead = GetCurrentTimeInternal();
+  while (!lead_ring_.empty() && lead_ring_.front()->timestamp() < playhead) {
+    lead_ring_.pop_front();
+  }
+  constexpr size_t kLeadRingCap = 120;
+  while (lead_ring_.size() > kLeadRingCap) {
+    lead_ring_.pop_front();
+  }
+
+  if (!lead_readback_cb_) {
+    lead_readback_cb_ = base::BindRepeating(
+        &WebMediaPlayerImpl::ReadbackLeadFrameAt, weak_this_);
+  }
+  // [Browther/Basarunaa] Mesure : si lead@tap reste ~+2000 ms, l'avance
+  // decode-ahead survit sous charge. VLOG(1) : réactivable via
+  // --vmodule=web_media_player_impl=1 (silencieux sinon).
+  VLOG(1) << "[bsrLAT] tap media_ts=" << ts.InMilliseconds()
+          << "ms lead@tap=" << (ts - playhead).InMilliseconds()
+          << "ms ring=" << lead_ring_.size();
+  // L'URL chargée accompagne CHAQUE notification : c'est la seule clé commune
+  // avec le JS de la page (`video.currentSrc`), qui en a besoin pour poser le
+  // flou sur le bon <video> quand un frame en compte plusieurs. Constante pour
+  // un player donné — recopiée à chaque frame par simplicité, le coût est une
+  // string de quelques dizaines d'octets.
+  lead_frame_sink_.Run(
+      static_cast<int64_t>(media_player_id_.GetUnsafeValue()),
+      demuxer_manager_->LoadedUrl().spec(), ts, lead_readback_cb_);
+}
+
+void WebMediaPlayerImpl::ReadbackLeadFrameAt(base::TimeDelta target_ts,
+                                             LeadFrameReadbackDoneCB done) {
+  // [Browther/Basarunaa] Service « readback à la demande » (handle donné à
+  // l'embedder). La frame est ÉPINGLÉE ici (ref copiée dans la file) : la
+  // requête devient immune à l'éviction du ring pendant l'attente.
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  // Contenu protégé : l'embedder garde le handle aussi longtemps que son
+  // detector vit — il peut le rappeler après la coupure. Refus sec.
+  if (basarunaa_protected_content_) {
+    std::move(done).Run({}, 0, 0, base::TimeDelta());
+    return;
+  }
+  // Recherche binaire par ts (ring trié croissant par construction). Les ts
+  // demandés viennent des notifications (valeurs exactes) ; la tolérance ne
+  // couvre que les re-demandes après éviction partielle — la frame réellement
+  // lue est rapportée via actual_ts du reply.
+  scoped_refptr<media::VideoFrame> picked;
+  if (!lead_ring_.empty()) {
+    const auto it = std::lower_bound(
+        lead_ring_.begin(), lead_ring_.end(), target_ts,
+        [](const scoped_refptr<media::VideoFrame>& f, base::TimeDelta t) {
+          return f->timestamp() < t;
+        });
+    constexpr base::TimeDelta kTol = base::Milliseconds(20);
+    base::TimeDelta best = base::TimeDelta::Max();
+    for (const auto& cand :
+         {it, it == lead_ring_.begin() ? it : std::prev(it)}) {
+      if (cand == lead_ring_.end()) {
+        continue;
+      }
+      const base::TimeDelta d = ((*cand)->timestamp() - target_ts).magnitude();
+      if (d <= kTol && d < best) {
+        best = d;
+        picked = *cand;
+      }
+    }
+  }
+  constexpr size_t kMaxReadbackQueue = 6;
+  if (!picked || lead_readback_queue_.size() >= kMaxReadbackQueue) {
+    VLOG(1) << "[bsrV2] readback MISS target=" << target_ts.InMilliseconds()
+            << "ms (ring=" << lead_ring_.size()
+            << " queue=" << lead_readback_queue_.size() << ")";
+    std::move(done).Run({}, 0, 0, base::TimeDelta());
+    return;
+  }
+  lead_readback_queue_.emplace_back(std::move(picked), std::move(done));
+  PumpLeadReadback();
+}
+
+void WebMediaPlayerImpl::PumpLeadReadback() {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (lead_readback_busy_ || lead_readback_queue_.empty()) {
+    return;
+  }
+  scoped_refptr<media::VideoFrame> frame =
+      std::move(lead_readback_queue_.front().first);
+  LeadFrameReadbackDoneCB done =
+      std::move(lead_readback_queue_.front().second);
+  lead_readback_queue_.pop_front();
+  lead_readback_busy_ = true;
+  lead_readback_start_ticks_ = base::TimeTicks::Now();
+  if (frame->HasSharedImage()) {
+    // Frame GPU-backed (VideoToolbox) : le readback synchrone BLOQUE le main
+    // render thread et déstabilise la couche graphique macOS (crash
+    // ImageIO/WindowManagement, isolé 2026-07-02) -> déporté sur la SÉQUENCE
+    // DÉDIÉE (LeadFrameReadbackThread, son propre RasterInterface). Reply sur
+    // le main thread.
+    if (!lead_readback_impl_) {
+      // Test sur |lead_readback_impl_| (pas le runner) : après le ReleaseSoon
+      // du dtor, le runner survit mais l'impl est nulle — ne jamais binder une
+      // ref nulle.
+      if (!lead_readback_runner_) {
+        lead_readback_runner_ = base::ThreadPool::CreateSingleThreadTaskRunner(
+            {base::WithBaseSyncPrimitives()},
+            base::SingleThreadTaskRunnerThreadMode::DEDICATED);
+      }
+      lead_readback_impl_ = base::MakeRefCounted<LeadFrameReadbackThread>();
+    }
+    lead_readback_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&LeadFrameReadbackThread::ReadbackToFrame,
+                       lead_readback_impl_, std::move(frame)),
+        base::BindOnce(&WebMediaPlayerImpl::OnLeadReadbackDone, weak_this_,
+                       std::move(done)));
+    return;
+  }
+  if (frame->IsMappable()) {
+    // Décodage SW : pixels déjà en CPU, traitement inline (opérations CPU
+    // only, sûres sur le main thread).
+    OnLeadReadbackDone(std::move(done), std::move(frame));
+    return;
+  }
+  MEDIA_LOG(INFO, media_log_.get())
+      << "[bsrV2] readback SKIP (storage="
+      << static_cast<int>(frame->storage_type()) << ")";
+  OnLeadReadbackDone(std::move(done), nullptr);
+}
+
+void WebMediaPlayerImpl::OnLeadReadbackDone(
+    LeadFrameReadbackDoneCB done,
+    scoped_refptr<media::VideoFrame> cpu_frame) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  lead_readback_busy_ = false;
+  // Le chiffrement a été découvert PENDANT ce readback : la frame lue est du
+  // média protégé déchiffré → elle ne sort pas d'ici (reply vide).
+  if (basarunaa_protected_content_) {
+    std::move(done).Run({}, 0, 0, base::TimeDelta());
+    return;
+  }
+  const double readback_ms =
+      (base::TimeTicks::Now() - lead_readback_start_ticks_).InMillisecondsF();
+  if (!cpu_frame) {
+    MEDIA_LOG(INFO, media_log_.get()) << "[bsrV2] readback FAILED (worker)";
+    std::move(done).Run({}, 0, 0, base::TimeDelta());
+    PumpLeadReadback();
+    return;
+  }
+
+  // Downscale -> I420 ~640px de large (entrée ML : YOLO11n letterbox 640,
+  // < 640 affame le modèle desktop -> fuite par non-détection, cf. design §5).
+  // Dimensions paires (contrainte de sous-échantillonnage I420). Le hash 8×8
+  // de l'embedder est aussi calculé sur ce buffer -> un probe de dichotomie
+  // qui s'avère frame de cut est déjà au format ML (zéro double readback).
+  const gfx::Size src = cpu_frame->visible_rect().size();
+  const int dst_w = 640;
+  const int dst_h =
+      std::max(2, src.height() * dst_w / std::max(1, src.width()));
+  const gfx::Size dst_size((dst_w + 1) & ~1, (dst_h + 1) & ~1);
+  scoped_refptr<media::VideoFrame> small = media::VideoFrame::CreateFrame(
+      media::PIXEL_FORMAT_I420, dst_size, gfx::Rect(dst_size), dst_size,
+      cpu_frame->timestamp());
+  if (!lead_frame_converter_)
+    lead_frame_converter_ = std::make_unique<media::VideoFrameConverter>();
+  const bool scaled =
+      small && lead_frame_converter_->ConvertAndScale(*cpu_frame, *small).is_ok();
+  media::VideoFrame* rgba_src = scaled ? small.get() : cpu_frame.get();
+
+  // -> packé 4 octets/pixel. NB : ConvertVideoFrameToRGBPixels n'accepte QUE
+  // kN32_SkColorType pour les YUV (CHECK paint_canvas_video_renderer.cc) = BGRA
+  // sur Apple little-endian -> le Mojo AnalyzeImage reçoit ImageFormat::kBgra8.
+  const gfx::Size rgba_size = rgba_src->visible_rect().size();
+  std::vector<uint8_t> rgba(static_cast<size_t>(rgba_size.width()) *
+                            rgba_size.height() * 4);
+  media::PaintCanvasVideoRenderer::ConvertVideoFrameToRGBPixels(
+      rgba_src, rgba, static_cast<size_t>(rgba_size.width()) * 4,
+      kN32_SkColorType, /*premultiply_alpha=*/false,
+      media::PaintCanvasVideoRenderer::kFilterNone, /*disable_threading=*/true);
+
+  VLOG(1) << "[bsrV2] readback OK ts=" << cpu_frame->timestamp().InMilliseconds()
+          << "ms " << readback_ms << "ms src=" << src.width() << "x"
+          << src.height() << " -> bgra=" << rgba_size.width() << "x"
+          << rgba_size.height() << (scaled ? "" : " NOSCALE");
+  std::move(done).Run(std::move(rgba), rgba_size.width(), rgba_size.height(),
+                      cpu_frame->timestamp());
+  // Repompe APRÈS le done : un done synchrone peut avoir ré-enfilé le probe
+  // suivant de la dichotomie (busy_ est déjà false -> son propre pump l'a
+  // lancé ; celui-ci devient alors no-op).
+  PumpLeadReadback();
+}
