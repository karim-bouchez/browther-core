+void WebMediaPlayerImpl::OnLeadFrame(scoped_refptr<media::VideoFrame> frame) {
+  // [Browther/Basarunaa] decode-ahead ② : readback GPU->CPU d'une frame décodée
+  // en avance + downscale + RGBA, relayé au sink (-> RFO renderer -> ML ③).
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!frame)
+    return;
+
+  // [Browther/Basarunaa] Sink absent = pref Basarunaa OFF pour ce renderer (le
+  // browser n'a pas injecté --basarunaa-video-tap) OU embedder sans analyse ->
+  // ne rien faire : PAS de readback GPU->CPU. Gate normal du tap, pas un debug.
+  if (!lead_frame_sink_)
+    return;
+
+  const gfx::Size src = frame->visible_rect().size();
+
+  // 1) GPU -> CPU. Frame GPU-backed (VideoToolbox) : le readback synchrone
+  // BLOQUE le main render thread et déstabilise la couche graphique macOS
+  // (crash ImageIO/WindowManagement, isolé 2026-07-02) -> on le déporte sur une
+  // SÉQUENCE DÉDIÉE (LeadFrameReadbackThread, son propre RasterInterface). Le
+  // reply revient sur le main thread. Frame déjà mappable (SW/dav1d) = pas de
+  // readback -> on traite inline (opérations CPU only, sûres sur le main thread).
+  if (frame->HasSharedImage()) {
+    if (!lead_readback_runner_) {
+      lead_readback_runner_ = base::ThreadPool::CreateSingleThreadTaskRunner(
+          {base::WithBaseSyncPrimitives()},
+          base::SingleThreadTaskRunnerThreadMode::DEDICATED);
+      lead_readback_impl_ = base::MakeRefCounted<LeadFrameReadbackThread>();
+    }
+    lead_readback_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE,
+        base::BindOnce(&LeadFrameReadbackThread::ReadbackToFrame,
+                       lead_readback_impl_, frame),
+        base::BindOnce(&WebMediaPlayerImpl::ProcessLeadCpuFrame, weak_this_,
+                       src));
+    return;
+  }
+  if (frame->IsMappable()) {
+    ProcessLeadCpuFrame(src, std::move(frame));
+    return;
+  }
+  MEDIA_LOG(INFO, media_log_.get())
+      << "[bsrDA] readback SKIP (has_si=" << frame->HasSharedImage()
+      << " mappable=" << frame->IsMappable()
+      << " storage=" << static_cast<int>(frame->storage_type()) << ")";
+}
+
+void WebMediaPlayerImpl::ProcessLeadCpuFrame(
+    gfx::Size src,
+    scoped_refptr<media::VideoFrame> cpu_frame) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!cpu_frame) {
+    MEDIA_LOG(INFO, media_log_.get()) << "[bsrDA] readback FAILED (worker)";
+    return;
+  }
+  // Le sink a pu être invalidé entre le post et le reply.
+  if (!lead_frame_sink_)
+    return;
+
+  // 2) Downscale -> I420 ~640px de large (entrée ML : YOLO11n letterbox 640,
+  // < 640 affame le modèle desktop -> fuite par non-détection, cf. design §5).
+  // Dimensions paires (contrainte de sous-échantillonnage I420).
+  const int dst_w = 640;
+  const int dst_h =
+      std::max(2, src.height() * dst_w / std::max(1, src.width()));
+  const gfx::Size dst_size((dst_w + 1) & ~1, (dst_h + 1) & ~1);
+  scoped_refptr<media::VideoFrame> small = media::VideoFrame::CreateFrame(
+      media::PIXEL_FORMAT_I420, dst_size, gfx::Rect(dst_size), dst_size,
+      cpu_frame->timestamp());
+  if (!lead_frame_converter_)
+    lead_frame_converter_ = std::make_unique<media::VideoFrameConverter>();
+  const bool scaled =
+      small && lead_frame_converter_->ConvertAndScale(*cpu_frame, *small).is_ok();
+  media::VideoFrame* rgba_src = scaled ? small.get() : cpu_frame.get();
+
+  // 3) -> packé 4 octets/pixel. NB : ConvertVideoFrameToRGBPixels n'accepte QUE
+  // kN32_SkColorType pour les YUV (CHECK paint_canvas_video_renderer.cc) = BGRA
+  // sur Apple little-endian -> le Mojo AnalyzeImage reçoit ImageFormat::kBgra8.
+  const gfx::Size rgba_size = rgba_src->visible_rect().size();
+  std::vector<uint8_t> rgba(static_cast<size_t>(rgba_size.width()) *
+                            rgba_size.height() * 4);
+  media::PaintCanvasVideoRenderer::ConvertVideoFrameToRGBPixels(
+      rgba_src, rgba, static_cast<size_t>(rgba_size.width()) * 4,
+      kN32_SkColorType, /*premultiply_alpha=*/false,
+      media::PaintCanvasVideoRenderer::kFilterNone, /*disable_threading=*/true);
+
+  // 4) Remettre le buffer BGRA à l'embedder (RFO Basarunaa -> Mojo ->  ML).
+  MEDIA_LOG(INFO, media_log_.get())
+      << "[bsrDA] lead OK src=" << src.width() << "x" << src.height()
+      << " -> bgra=" << rgba_size.width() << "x" << rgba_size.height()
+      << (scaled ? "" : " NOSCALE") << " bytes=" << rgba.size()
+      << " ts=" << cpu_frame->timestamp().InMilliseconds() << "ms";
+
+  lead_frame_sink_.Run(std::move(rgba), rgba_size.width(), rgba_size.height(),
+                       cpu_frame->timestamp());
+}
