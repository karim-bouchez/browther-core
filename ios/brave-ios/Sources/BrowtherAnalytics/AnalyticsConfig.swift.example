// Template — le vrai fichier `AnalyticsConfig.swift` est généré au build
// par `private/scripts/gen-analytics-config-ios.sh` à partir de
// `private/configs/analytics.env`. Ce fichier .example est versionné, le
// .swift généré est gitignoré.

import Foundation

enum AnalyticsConfig {
  /// DSN brute Sentry (format https://<KEY>@o<ORG_ID>.ingest.de.sentry.io/<PROJECT_ID>)
  static let sentryDsn: String = ""

  /// API key projet PostHog (commence par `phc_...`)
  static let posthogApiKey: String = ""

  /// Endpoint PostHog (EU = https://eu.i.posthog.com)
  static let posthogHost: String = "https://eu.i.posthog.com"

  /// API Browther (POST /api/stats/ingest pour stats publiques anonymes)
  static let browtherApiUrl: String = "https://browther-api.devndin.com"
}
