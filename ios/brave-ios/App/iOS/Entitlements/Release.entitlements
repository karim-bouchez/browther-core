<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Browther: com.apple.developer.web-browser commenté tant qu'Apple n'a pas
	     approuvé le form Default Browser Entitlement pour Team MWBMAMYDUD. AMFI
	     refuse de lancer l'app sur device si un entitlement restreint est demandé
	     mais pas accordé par le provisioning profile. Réactiver après approbation
	     (parité avec `Debug.entitlements` ; voir CLAUDE.md Phase 2.5).
	<key>com.apple.developer.web-browser</key>
	<true/>
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(MOZ_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
