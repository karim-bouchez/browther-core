<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Browther: com.apple.developer.web-browser réactivé 2026-05-29 après
	     approbation Apple (request 35A6Y5Y5RM submitted 2026-05-24).
	     Les 2 autres entitlements restreints restent commentés (capabilities
	     non demandées au Team MWBMAMYDUD ; AMFI refuserait de signer).
	     - com.apple.developer.browser.app-installation : alternative app stores EU
	     - com.apple.developer.playable-content : CarPlay audio interaction
	<key>com.apple.developer.browser.app-installation</key>
	<true/>
	<key>com.apple.developer.playable-content</key>
	<true/>
	-->
	<key>com.apple.developer.web-browser</key>
	<true/>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(MOZ_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
