#include "Release.xcconfig"

// Browther: Automatic signing (héritage Base.xcconfig). Xcode utilise le cert
// `Apple Distribution: Chaima Addou (MWBMAMYDUD)` automatiquement quand on
// archive en Release (AppStore) et génère les profiles Distribution via
// `-allowProvisioningUpdates`. L'upstream Brave forçait Manual + leur cert
// nommé "Apple Distribution: Brave Software, Inc." + profiles "Brave iOS
// Release ..." qu'on n'a pas. En Automatic, plus simple et plus portable.
