// This is for _Global_ swift flags and will be applied to _all_ targets.
// Configuration inheritence only works through Xcode defined levels, not configuration files.
// So need to use unique name and utilize in subclasses
// (e.g. can't use $(inherited) to 'pull' these changes, into sub-configurations)

brave_ios_marketing_version = 0.0
brave_version_build = 0

#include "../../../../../out/ios_current_link/args.xcconfig"

// Browther: override le build number APRÈS l'include de args.xcconfig
// (qui le force à la valeur GN du dernier BraveCore build, typiquement 0).
// Bumper ici à chaque upload TestFlight/App Store sans devoir rebuild
// BraveCore.xcframework. Sinon App Store Connect rejette l'upload :
// "build version must be higher than previous build with same version".
// build 2 = resoumission 2026-06-23 (fix refus MFi com.yubico.ylp 2.1.0).
// build 3 = resoumission 2026-06-26 (fixes refus round 2 : NSLocalNetworkUsageDescription
// 5.1.1, onboarding iPad plein écran 2.1(a), retrait VPN NEVPNManager 2.5.1).
// build 4 = soumission 2026-08-29, première depuis le 19 juin. Contenu : les
// deux correctifs de fuite d'URL vers Sentry (raison principale de cette
// soumission — en production, les URL visitées pouvaient partir), le bandeau
// « accès anticipé » sur la NTP, l'étape d'onboarding « suivre les canaux
// dev&din », la collecte de corpus opt-in, le pré-filtre/vérificateur NanoDet
// sur les images, le flou vidéo en cascade, les panels dans la bonne langue.
// BraveCore rebuildé sur la même base Chromium (aucun roll upstream depuis
// mars) — validé sur device en Release AVANT soumission.
brave_version_build = 4

// Browther: version marketing en CalVer (parité Desktop "Browther 2026.MM.JJ").
// App Store Connect impose CFBundleShortVersionString = au plus 3 entiers SANS
// zéro initial → impossible de répliquer tel quel le 4-parties zéro-paddé du DMG
// mac (2026.05.30.4). Mapping retenu : marketing = AAAA.M.J (date du build) +
// build counter = brave_version_build ci-dessus (l'équivalent du ".N" mac).
// Override APRÈS l'include (sinon args.xcconfig force la version Brave 1.90).
// ⚠️ Bumper la date à chaque soumission ; App Store compare composante par
// composante (2026.x > 1.90, donc la transition depuis 1.90 est valide).
brave_ios_marketing_version = 2026.8.29

FRAMEWORK_BASE_BUNDLE_ID = com.devndin.browther
BASE_BUNDLE_ID = $(FRAMEWORK_BASE_BUNDLE_ID).ios

DEVELOPMENT_TEAM = MWBMAMYDUD

// Browther: défaut signing automatic pour TOUTES les configs (Release, Beta,
// Nightly, Debug AppStore, etc.) sauf override explicite dans pbxproj.
// Sans ça, les configs qui n'ont pas CODE_SIGN_STYLE dans pbxproj tombent
// sur le défaut Xcode = Manual, ce qui bloque `-allowProvisioningUpdates`.
// Release-AppStore.xcconfig override avec Manual + Apple Distribution si
// jamais on veut un signing manuel pour l'App Store ; sinon Automatic suffit.
CODE_SIGN_STYLE = Automatic

BRAVE_URL_SCHEME = browther
