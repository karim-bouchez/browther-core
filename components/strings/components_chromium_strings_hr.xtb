<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="130631256467250065">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete uređaj.</translation>
<translation id="5681560603157873402">Otvorite izbornik preglednika Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          i provjerite je li konfiguracija postavljena na "bez proxyja" ili "izravno".</translation>
<translation id="4903497818305945122">Prijavljivanje padova nije dostupno u pregledniku Browther.</translation>
<translation id="5747951541048369241">Gledate sigurnu stranicu Bravea</translation>
<translation id="7041193161756628041">Browther pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="4670277172953498174">Logotip Bravea</translation>
<translation id="3474898875907708105">Browther pokušava urediti načine plaćanja.</translation>
<translation id="5700544173546684818">Browther omogućuju projekt utemeljen na otvorenom kôdu <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> i drugi <ph name="BEGIN_LINK_OSS"/>softveri utemeljeni na otvorenom kôdu<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Browther je blokirao ovu stranicu</translation>
<translation id="1339376981847018870">U postavkama vatrozida ili antivirusnog programa omogućite Braveu da pristupa mreži.</translation>
<translation id="4949828774841497663">Idite na Aplikacije &gt; Postavke sustava &gt; Mreža, odaberite
          aktivnu mrežu, kliknite gumb Pojedinosti... i poništite odabir svih proxyja
          koji su možda odabrani.</translation>
<translation id="4191403906356422893">Otvorite izbornik Bravea &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mreža i internet &gt; Proxy i poništite odabir opcije Automatski otkrij postavke.</translation>
<translation id="958169674889932546">Te su stranice namijenjene razvojnim programerima Bravea i možda se ne održavaju ili testiraju aktivno. Da biste ih omogućili, otvorite <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknite gumb za omogućivanje stranica za otklanjanje pogrešaka, a zatim se ponovo vratite na ovu stranicu.</translation>
<translation id="4303967029316005584">Browther je omogućio i drugi <ph name="BEGIN_LINK_OSS"/>softver otvorenog izvornog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Promjene će početi vrijediti sljedeći put kad ponovo pokrenete Browther.</translation>
<translation id="221029295134825758">Browther treba pristup Bluetoothu za nastavak 
 uparivanja. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther je omogućio <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>, projekt otvorenog izvornog koda.</translation>
<translation id="3134645574591615830">Otvorite
        izbornik Bravea &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        pa poništite odabir stavke "<ph name="NO_PREFETCH_DESCRIPTION"/>".
        Ako se time ne riješi poteškoća, preporučujemo da ponovo odaberete tu opciju
        radi bolje izvedbe.</translation>
<translation id="8927199829149811571">Pregledavate sigurnu stranicu Browther for Testing</translation>
<translation id="4220066730874343807">Browther se nije ispravno zatvorio.</translation>
</translationbundle>