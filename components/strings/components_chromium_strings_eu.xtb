<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="eu">
<translation id="130631256467250065">Aldaketek gailua abiarazten duzun hurrengo aldian izango dute eragina.</translation>
<translation id="5681560603157873402">Joan
          Browther-eko menura &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          eta ziurtatu konfigurazioa "proxyrik ez" edo "zuzena" gisa dagoela ezarrita.</translation>
<translation id="4903497818305945122">Browther-ek ez du hutsegiteen berri emateko aukerarik ematen.</translation>
<translation id="5747951541048369241">Browther-eko orri seguru bat ari zara ikusten</translation>
<translation id="7041193161756628041">Browther-ek ordainketa-metodoak betetzeko ezarpenak aldatu behar ditu.</translation>
<translation id="4670277172953498174">Browther logotipoa</translation>
<translation id="3474898875907708105">Browther-ek ordainketa-metodoak editatu behar ditu.</translation>
<translation id="5700544173546684818">Kode irekiko <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> proiektuari esker eta <ph name="BEGIN_LINK_OSS"/>kode irekiko softwareari<ph name="END_LINK_OSS"/> esker da posible Browther arakatzailea.</translation>
<translation id="8935269788853634726">Browther-ek blokeatu du orria</translation>
<translation id="1339376981847018870">Eman suebakiaren edo birusen aurkako softwarearen ezarpenetan sarea erabiltzeko baimena Browther-i.</translation>
<translation id="4949828774841497663">Joan Aplikazioak &gt; Sistemaren ezarpenak &gt; Sarea aukerara eta hautatu
          sare aktiboa. Bertan, sakatu Xehetasunak… botoia eta desautatu hautatutako
          proxyak.</translation>
<translation id="4191403906356422893">Joan
          Browther-eko menura &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Sareak eta Internet &gt; Proxya
          eta desautatu "Automatically detect settings" (hauteman automatikoki ezarpenak).</translation>
<translation id="958169674889932546">Orri hauek Browther-en garatzaileek erabiltzeko pentsatuta daude, eta baliteke aktiboki ez mantentzea edo probatzea. Haiek gaitzeko, joan <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> helbidera, sakatu orrien arazketa gaitzeko botoia eta itzuli orri honetara.</translation>
<translation id="4303967029316005584"><ph name="BEGIN_LINK_OSS"/>Kode irekiko beste software<ph name="END_LINK_OSS"/> batzuek ere posible egiten dute Browther.</translation>
<translation id="8031938899816118394">Aldaketek Browther abiarazten duzun hurrengo aldian izango dute eragina.</translation>
<translation id="221029295134825758">Browther-ek Bluetootha erabiltzeko baimena behar du parekatzen jarraitzeko. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Kode irekiko <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> proiektuak egiten du posible Browther.</translation>
<translation id="3134645574591615830">Sakatu
          Browther menua &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          eta desautatu "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Arazoa horrela konpontzen ez bada, aukera hori berriro hautatzea gomendatzen dizugu errendimendua hobetzeko.</translation>
<translation id="8927199829149811571">Browther for Testing-eko orri seguru bat ari zara ikusten</translation>
<translation id="4220066730874343807">Browther ez da behar bezala itxi.</translation>
</translationbundle>