<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ro">
<translation id="130631256467250065">Modificările dvs. se vor aplica următoarea dată când reporniți dispozitivul.</translation>
<translation id="5681560603157873402">Accesează
          meniul Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          și asigură-te că ai setat pentru configurație valoarea Fără proxy sau Directă.</translation>
<translation id="4903497818305945122">Raportarea blocărilor nu este disponibilă în Browther.</translation>
<translation id="5747951541048369241">Se afișează o pagină Browther securizată</translation>
<translation id="7041193161756628041">Browther încearcă să modifice setările pentru completarea metodelor de plată.</translation>
<translation id="4670277172953498174">Sigla Browther</translation>
<translation id="3474898875907708105">Browther încearcă să modifice metodele de plată.</translation>
<translation id="5700544173546684818">Browther există mulțumită proiectului open source <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> și a altor <ph name="BEGIN_LINK_OSS"/>produse software open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Pagina a fost blocată de Browther</translation>
<translation id="1339376981847018870">Din setările pentru firewall sau antivirus, permite browserului Browther să acceseze
          rețeaua.</translation>
<translation id="4949828774841497663">Accesează Aplicații &gt; Setări de sistem &gt; Rețea, selectează rețeaua
          activă, dă clic pe butonul Detalii... și debifează orice proxy
          care ar fi fost selectat.</translation>
<translation id="4191403906356422893">Accesează
          meniul Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Rețea și internet &gt; Proxy
          și debifează opțiunea Detectează automat setările.</translation>
<translation id="958169674889932546">Aceste pagini sunt destinate utilizării de către dezvoltatorii Browther și este posibil să nu fie întreținute sau testate în mod activ. Pentru a le activa, accesează <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, dă clic pe butonul pentru a activa paginile de remediere a erorilor, apoi accesează din nou această pagină.</translation>
<translation id="4303967029316005584">Browther acceptă și alte opțiuni de <ph name="BEGIN_LINK_OSS"/>software open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Modificările dvs. vor intra în vigoare următoarea dată când reporniți Browther.</translation>
<translation id="221029295134825758">Browther are nevoie de acces la Bluetooth pentru a continua conectarea. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther există datorită proiectului open source <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Accesează
          meniul Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          și debifează „<ph name="NO_PREFETCH_DESCRIPTION"/>”.
          Dacă această acțiune nu rezolvă problema, îți recomandăm să selectezi din nou
          această opțiune pentru performanță îmbunătățită.</translation>
<translation id="8927199829149811571">Se afișează o pagină Browther for Testing</translation>
<translation id="4220066730874343807">Browther nu s-a închis corect.</translation>
</translationbundle>