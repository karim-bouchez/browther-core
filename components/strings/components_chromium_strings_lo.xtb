<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lo">
<translation id="130631256467250065">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ອຸປະກອນຂອງທ່ານໃໝ່.</translation>
<translation id="5681560603157873402">ເຂົ້າໄປ
          ເມນູ Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ແລະ ກວດສອບວ່າມີການກຳນົດການຕັ້ງຄ່າຂອງທ່ານເປັນ "ບໍ່ມີພຣັອກຊີ" ຫຼື "ໂດຍກົງ".</translation>
<translation id="4903497818305945122">ບໍ່ມີການລາຍງານການຂັດຂ້ອງຢູ່ໃນ Browther​.</translation>
<translation id="5747951541048369241">ທ່ານກຳລັງເບິ່ງໜ້າ Browther ທີ່ປອດໄພ</translation>
<translation id="7041193161756628041">Browther ກຳລັງພະຍາຍາມແກ້ໄຂການຕັ້ງຄ່າສຳລັບການຕື່ມວິທີການຈ່າຍເງິນ.</translation>
<translation id="4670277172953498174">ໂລໂກ້ Browther</translation>
<translation id="3474898875907708105">Browther ກຳລັງພະຍາຍາມແກ້ໄຂວິທີການຈ່າຍເງິນ.</translation>
<translation id="5700544173546684818">Browther ເຮັດໃຫ້ເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ໂຄງການ open source ແລະ <ph name="BEGIN_LINK_OSS"/>ຊອບແວ open source<ph name="END_LINK_OSS"/> ອື່ນໆ.</translation>
<translation id="8935269788853634726">ໜ້ານີ້ຖືກບລັອກໄວ້ໂດຍ Browther</translation>
<translation id="1339376981847018870">ອະນຸຍາດໃຫ້ Browther ເຂົ້າເຖິງເຄືອຂ່າຍໃນການຕັ້ງຄ່າໄຟຣ໌ວໍ ຫຼື ໂປຣແກຣມ
          ຕ້ານໄວຣັສຂອງທ່ານ.</translation>
<translation id="4949828774841497663">ເຂົ້າໄປແອັບພລິເຄຊັນ &gt; ການຕັ້ງຄ່າລະບົບ &gt; ເຄືອຂ່າຍ, ເລືອກ
          ເຄືອຂ່າຍທີ່ນຳໃຊ້ຢູ່, ຄລິກປຸ່ມລາຍລະອຽດ... ແລ້ວເຊົາເລືອກພຣັອກຊີໃດກໍຕາມ
          ທີ່ອາດເລືອກໄວ້.</translation>
<translation id="4191403906356422893">ເຂົ້າໄປ
          ເມນູ Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ເຄືອຂ່າຍ ແລະ ອິນເຕີເນັດ &gt; ພຣັອກຊີ
          ແລ້ວເຊົາເລືອກ "ກວດຫາການຕັ້ງຄ່າໂດຍອັດຕະໂນມັດ".</translation>
<translation id="958169674889932546">ໜ້າເຫຼົ່ານີ້ມີໄວ້ສຳລັບນັກພັດທະນາ Browther ເທົ່ານັ້ນ ແລະ ອາດບໍ່ໄດ້ຮັບການບຳລຸງຮັກສາ ຫຼື ທົດສອບຢ່າງສະໝ່ຳສະເໝີ. ເພື່ອເປີດການນຳໃຊ້, ໃຫ້ເຂົ້າໄປ <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, ຄລິກປຸ່ມເພື່ອເປີດການນຳໃຊ້ໜ້າດີບັກ, ຈາກນັ້ນນຳທາງໄປຫາໜ້ານີ້ອີກຄັ້ງ.</translation>
<translation id="4303967029316005584">Browther ຍັງເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_OSS"/>ຊອບແວໂອເພນຊອດ<ph name="END_LINK_OSS"/> ອື່ນນຳອີກ.</translation>
<translation id="8031938899816118394">ການປ່ຽນແປງຂອງທ່ານຈະມີຜົນຄັ້ງຕໍ່ໄປທີ່ທ່ານເລີ່ມເປີດໃຊ້ Browther ໃໝ່.</translation>
<translation id="221029295134825758">Browther ຕ້ອງການສິດເຂົ້າເຖິງ Bluetooth ເພື່ອສືບຕໍ່ 
 ການຈັບຄູ່. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther ເປັນໄປໄດ້ໂດຍໂຄງການໂອເພນຊອດ <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">ໄປ​ທີ່
          ເມ​ນູ Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          ແລະ​ຖອນ​ເລືອກ "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          ຖ້າອັນ​ນີ້​ບໍ່​ແກ້​ໄຂ​ບັນ​ຫາ​ໄດ້, ພວກ​ເຮົາ​ແນະ​ນຳ​ໃຫ້​ເລືອກ​ເອົາ​ທາງ​ເລືອກ​ນີ້
          ອີກ​ເພື່ອ​ເພີ່ມ​ການ​ປະ​ຕິ​ບັດ​ງານ.</translation>
<translation id="8927199829149811571">ທ່ານກຳລັງເບິ່ງໜ້າ Browther ສຳລັບການທົດສອບທີ່ປອດໄພ</translation>
<translation id="4220066730874343807">Browther ມອດ​ຢ່າງບໍ່​ຖືກ​ຕ້ອງ.</translation>
</translationbundle>