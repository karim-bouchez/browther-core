<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="130631256467250065">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ, երբ վերագործարկեք սարքը:</translation>
<translation id="5681560603157873402">Բացեք
          Browther-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          և համոզվեք, որ ձեր կազմաձևի համար սահմանված է «առանց պրոքսի սերվերի» կամ «ուղիղ» պարամետրը։</translation>
<translation id="4903497818305945122">Խափանումների մասին հաղորդումը մատչելի չէ Browther-ում:</translation>
<translation id="5747951541048369241">Ցուցադրվող Browther էջն անվտանգ է</translation>
<translation id="7041193161756628041">Browther-ը փորձում է փոխել վճարման եղանակների լրացման կարգավորումները։</translation>
<translation id="4670277172953498174">Browther-ի պատկերանշանը</translation>
<translation id="3474898875907708105">Browther-ը փորձում է փոփոխել վճարման եղանակները։</translation>
<translation id="5700544173546684818">Browther-ը ստեղծվել է շնորհիվ <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> բաց կոդով նախագծի և այլ <ph name="BEGIN_LINK_OSS"/>բաց կոդով ծրագրակազմերի<ph name="END_LINK_OSS"/>:</translation>
<translation id="8935269788853634726">Այս էջն արգելափակվել է Browther-ի կողմից</translation>
<translation id="1339376981847018870">Հրապատի կամ հակավիրուսային ծրագրի կարգավորումներում
       թույլատրեք Browther-ին միանալ ցանցին:</translation>
<translation id="4949828774841497663">Գնացեք Հավելվածներ &gt; Համակարգի կարգավորումներ &gt; Ցանց, ընտրեք
         ակտիվ ցանցը, սեղմեք Մանրամասներ... կոճակը և չեղարկեք ցանկացած                              պրոքսի սերվերի ընտրությունը։</translation>
<translation id="4191403906356422893">Բացեք
          Browther-ի ընտրացանկը &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Ցանց և ինտերնետ &gt; Պրոքսի սերվեր
          և անջատեք «Ավտոմատ որոշել կարգավորումները» պարամետրը։</translation>
<translation id="958169674889932546">Այս էջերը, որոնք նախատեսված են Browther-ի մշակողների համար, չեն կարող պարբերաբար փորձարկվել կամ մշակվել։ Միացնելու համար անցեք <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> էջ, սեղմեք կոճակը՝ վրիպազերծման էջերը միացնելու համար, այնուհետև վերադարձեք այստեղ։</translation>
<translation id="4303967029316005584">Browther-ը նաև աշխատում է այլ <ph name="BEGIN_LINK_OSS"/>բաց կոդով ծրագրակազմի<ph name="END_LINK_OSS"/> շնորհիվ։</translation>
<translation id="8031938899816118394">Փոփոխություններն ուժի մեջ կմտնեն Browther-ը հաջորդ անգամ գործարկելիս:</translation>
<translation id="221029295134825758">Զուգակցումը շարունակելու համար Browther-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther-ը ստեղծվել է <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>-ի բաց կոդով նախագծի հիման վրա։</translation>
<translation id="3134645574591615830">Անցեք
          Browther ընտրացանկ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          և ապանշեք «<ph name="NO_PREFETCH_DESCRIPTION"/>»-ը:
          Եթե խնդիրը չվերանա, խորհուրդ ենք տալիս կրկին ընտրել այս տարբերակը՝
          արդյունավետությունը բարձրացնելու համար:</translation>
<translation id="8927199829149811571">Դուք դիտում եք Browther for Testing-ի անվտանգ էջ</translation>
<translation id="4220066730874343807">Browther-ը ճիշտ չի փակվել:</translation>
</translationbundle>