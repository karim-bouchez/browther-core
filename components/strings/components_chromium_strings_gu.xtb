<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="130631256467250065">તમારા ફેરફારો તમે આગલી વખતે તમારા ઉપકરણને ફરી પ્રારંભ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="5681560603157873402">તમે
          Browther મેનૂ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          પર જાઓ અને ખાતરી કરો કે તમારું કન્ફિગ્યુરેશન "પ્રૉક્સી નહીં" કે "પ્રત્યક્ષ" પર સેટ કરેલું હોય.</translation>
<translation id="4903497818305945122">Browther માં ક્રૅશ રિપોર્ટિંગ ઉપલબ્ધ નથી.</translation>
<translation id="5747951541048369241">તમે એક સુરક્ષિત Browther પેજ જોઈ રહ્યાં છો</translation>
<translation id="7041193161756628041">ચુકવણી પદ્ધતિઓ ભરવા માટે, Browther સેટિંગમાં ફેરફાર કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="4670277172953498174">Browther લોગો</translation>
<translation id="3474898875907708105">Browther ચુકવણી પદ્ધતિઓમાં ફેરફાર કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="5700544173546684818">Browther એ <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ઓપન સ્રોત પ્રોજેક્ટ અને અન્ય <ph name="BEGIN_LINK_OSS"/>ઓપન સ્રોત સૉફ્ટવેર<ph name="END_LINK_OSS"/> દ્વારા શક્ય બનાવ્યું છે.</translation>
<translation id="8935269788853634726">Browther દ્વારા આ પેજને બ્લૉક કરવામાં આવ્યું છે</translation>
<translation id="1339376981847018870">Braveને તમારા ફાયરવૉલ અથવા ઍન્ટિવાયરસ સેટિંગમાં નેટવર્ક ઍક્સેસ કરવાની
        મંજૂરી આપો.</translation>
<translation id="4949828774841497663">ઍપ્લિકેશન &gt; સિસ્ટમના સેટિંગ &gt; નેટવર્ક પર જાઓ,
          સક્રિય નેટવર્ક, વિગતો પર ક્લિક કરો... બટન પસંદ કરો, અને કોઈપણ પ્રૉક્સી નાપસંદ કરો
          જે પસંદ કરવામાં આવ્યું હોય.</translation>
<translation id="4191403906356422893">તમે
          Browther મેનૂ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          નેટવર્ક અને ઇન્ટરનેટ &gt; પ્રૉક્સી
          પર જાઓ અને "ઑટોમૅટિક રીતે સેટિંગની ભાળ મેળવો સેટિંગ"ને નાપસંદ કરો.</translation>
<translation id="958169674889932546">આ પેજ Browther ડેવલપર દ્વારા ઉપયોગમાં લેવાના હેતુથી બનાવવામાં આવ્યા છે અને તેમની સક્રિય રીતે જાળવણી અથવા પરીક્ષણ ન કરવામાં આવે એવું બની શકે છે. તેમને ચાલુ કરવા માટે, નૅવિગેટ કરીને <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> પર જાઓ, પેજને ડિબગ કરવાની સુવિધા ચાલુ કરવા માટેના બટન પર ક્લિક કરો અને નૅવિગેટ કરીને ફરી પાછા આ પેજ પર આવો.</translation>
<translation id="4303967029316005584">અન્ય <ph name="BEGIN_LINK_OSS"/>ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_OSS"/> દ્વારા પણ Braveને શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="8031938899816118394">તમારા ફેરફારો તમે આગલી વખતે Browther ફરીથી લોંચ કરશો ત્યારે પ્રભાવમાં આવશે.</translation>
<translation id="221029295134825758">જોડાણ કરવાનું ચાલુ રાખવા માટે, Braveને બ્લૂટૂથના ઍક્સેસની 
 જરૂર છે. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ઓપન સૉર્સ પ્રોજેક્ટ દ્વારા પણ Braveને શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="3134645574591615830">Browther મેનૂ &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        પર જાઓ અને "<ph name="NO_PREFETCH_DESCRIPTION"/>" પસંદગીને હટાવો.
        જો આનાથી સમસ્યા ઉકેલાતી નથી, તો અમે સુધારેલ પ્રદર્શન માટે ફરીથી આ વિકલ્પને પસંદ કરવાની 
        ભલામણ કરીએ છીએ.</translation>
<translation id="8927199829149811571">તમે સુરક્ષિત Browther for Testing પેજ જોઈ રહ્યાં છો</translation>
<translation id="4220066730874343807">Browther યોગ્ય રીતે શટ ડાઉન થયું નહોતું.</translation>
</translationbundle>