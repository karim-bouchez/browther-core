<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="da">
<translation id="130631256467250065">Dine ændringer træder i kraft, næste gang du genstarter din enhed.</translation>
<translation id="5681560603157873402">Gå til
          Browther-menuen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          , og sørg for, at din konfiguration er indstillet til "ingen proxy" eller "direkte".</translation>
<translation id="4903497818305945122">Nedbrudsrapportering er ikke tilgængeligt i Browther.</translation>
<translation id="5747951541048369241">Du ser en sikker Browther-side</translation>
<translation id="7041193161756628041">Browther forsøger at ændre indstillinger for udfyldning af betalingsmetoder.</translation>
<translation id="4670277172953498174">Browther-logo</translation>
<translation id="3474898875907708105">Browther forsøger at redigere betalingsmetoder.</translation>
<translation id="5700544173546684818">Browther er realiseret ved hjælp af <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>-open source-projektet og anden <ph name="BEGIN_LINK_OSS"/>open source-software<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Browther har blokeret denne side</translation>
<translation id="1339376981847018870">Tillad, at Browther får adgang til netværket i dine indstillinger for firewall eller
        antivirus.</translation>
<translation id="4949828774841497663">Gå til Apps &gt; Systemindstillinger &gt; Netværk, vælg det aktive netværk, klik på knappen Oplysninger…, og fravælg eventuelle proxyer, der måtte være valgt.</translation>
<translation id="4191403906356422893">Gå til
          Browther-menuen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netværk og internet &gt; Proxy,
          og fravælg "Registrer indstillinger automatisk".</translation>
<translation id="958169674889932546">Disse sider er beregnet til brug af Browther-udviklere og vedligeholdes eller testes muligvis ikke aktivt. Hvis du vil aktivere dem, skal du gå til <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klikke på knappen for at aktivere fejlretningssider og derefter gå til denne side igen.</translation>
<translation id="4303967029316005584">Browther leveres også ved hjælp af andet <ph name="BEGIN_LINK_OSS"/>open source-software<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Dine ændringer træder i kraft, næste gang du genstarter Browther.</translation>
<translation id="221029295134825758">Browther skal have adgang til Bluetooth for at fortsætte 
 parringen. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther leveres ved hjælp af open source-projektet <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Gå til
          Browther-menuen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          og fjern markeringen af "<ph name="NO_PREFETCH_DESCRIPTION"/>".
          Hvis det ikke løser problemet, bør du markere dette afkrydsningsfelt
          igen for at forbedre effektiviteten.</translation>
<translation id="8927199829149811571">Du ser en sikker Browther for Testing-side</translation>
<translation id="4220066730874343807">Browther blev ikke afsluttet korrekt.</translation>
</translationbundle>