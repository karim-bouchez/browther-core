<!DOCTYPE translationbundle>
<translationbundle lang="si">
<translation id="130631256467250065">ඔබේ උපාංගය නැවත අරඹන විට ඔබේ වෙනස්කම් බල පැවැත්වෙනු ඇත.</translation>
<translation id="5681560603157873402">Browther මෙනුව වෙත ගොස්
          &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ඔබේ වින්‍යාසය "ප්‍රොක්සි නැත" හෝ "සෘජු" ලෙස සකසා ඇති බවට වග බලා ගන්න.</translation>
<translation id="4903497818305945122">අනතුරු වාර්තාකරණය  Braveහි නැත.</translation>
<translation id="5747951541048369241">ඔබ ආරක්ෂිත Browther පිටුවක් බලමින් සිටී</translation>
<translation id="7041193161756628041">Browther ගෙවීම් ක්‍රම පිරවීම සඳහා සැකසීම් වෙනස් කිරීමට උත්සාහ දරයි.</translation>
<translation id="4670277172953498174">Browther ලාංඡනය</translation>
<translation id="3474898875907708105">Browther ගෙවීම් ක්‍රම සංස්කරණය කිරීමට උත්සාහ කරයි.</translation>
<translation id="5700544173546684818">Browther <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> විවෘත මූලාශ්‍ර ව්‍යාපෘතිය සහ වෙනත් <ph name="BEGIN_LINK_OSS"/>විවෘත මූලාශ්‍ර මෘදුකාංග<ph name="END_LINK_OSS"/> මගින් නිපදවීමට හැකි විය.</translation>
<translation id="8935269788853634726">මෙම පිටුව Browther මගින් අවහිර කර ඇත</translation>
<translation id="1339376981847018870">ඔබගේ ෆයර් වෝල හා ප්‍රතිවයිරස සැකසීම් තුළ Browther හට ජාලයට පිවිසීමට
          අවසර දෙන්න.</translation>
<translation id="4949828774841497663">යෙදුම් &gt; පද්ධති සැකසීම් &gt; ජාලය වෙත ගොස්,
          ක්‍රියාකාරී ජාලය තෝරන්න, විස්තර... බොත්තම ක්ලික් කරන්න, සහ තෝරාගෙන තිබිය හැකි ඕනෑම ප්‍රොක්සි
          තේරීම ඉවත් කරන්න.</translation>
<translation id="4191403906356422893">Browther මෙනුව &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ජාලය සහ අන්තර්ජාලය &gt; ප්‍රොක්සිය
          සහ "ස්වයංක්‍රීයව සැකසීම් හඳුනා ගන්න" වෙත ගොස් තේරීම ඉවත් කරන්න.</translation>
<translation id="958169674889932546">මෙම පිටු Browther සංවර්ධකයින් විසින් භාවිතා කිරීමට අදහස් කර ඇති අතර, ක්‍රියාකාරීව නඩත්තු කිරීම හෝ පරීක්ෂා කිරීම නොකළ හැක. ඒවා සබල කිරීමට, <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> වෙත සංචාලනය කරන්න, නිදොස් කිරීමේ පිටු සබල කිරීමට බොත්තම ක්ලික් කර, ඉන්පසු මෙම පිටුවට නැවත සංචාලනය කරන්න.</translation>
<translation id="4303967029316005584">Browther හට වෙනත් <ph name="BEGIN_LINK_OSS"/>විවෘත මූලාශ්‍ර මෘදුකාංග<ph name="END_LINK_OSS"/> මගින් ද හැකියාව සලසා ඇත</translation>
<translation id="8031938899816118394">නැවත Browther ආරම්බ කරන විට වෙනස්කම් ක්‍රියාත්මක වනු ඇත.</translation>
<translation id="221029295134825758">යුගල කිරීම දිගටම කර ගෙන යාමට Browther හට 
 බ්ලූටූත් ප්‍රවේශය අවශ්‍යයි. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther හට <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> විවෘත මූලාශ්‍ර මෘදුකාංගය මගින් හැකියාව සලසා ඇත</translation>
<translation id="3134645574591615830">මුලින්ම
        Browther මෙනුව වෙත ගොස්&gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        තෝරා "<ph name="NO_PREFETCH_DESCRIPTION"/>." තේරීම ඉවත් කරන්න
        මෙයින් නිරාකරණය නොවුන හොත්, වඩා දියුණු ක්‍රියාකාරීත්වයක් සඳහා මෙම අභිප්‍රේතය නැවත තෝරන්න.</translation>
<translation id="8927199829149811571">ඔබ පරීක්ෂා කිරීම සඳහා සුරක්ෂිත Browther පිටුවක් බලයි</translation>
<translation id="4220066730874343807">Browther නිවැරදිව වැසීමට නොහැකි විය.</translation>
</translationbundle>