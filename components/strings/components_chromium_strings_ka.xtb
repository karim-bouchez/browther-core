<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="130631256467250065">ცვლილებები გააქტიურდება მოწყობილობის შემდეგი გადატვირთვისას.</translation>
<translation id="5681560603157873402">გახსენით:
          Browther-ის მენიუ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          და დარწმუნდით, რომ თქვენი კონფიგურაცია შეიცავს შემდეგი პარამეტრებიდან ერთ-ერთს: „პროქსი-სერვერის გარეშე“ ან „პირდაპირი“.</translation>
<translation id="4903497818305945122">ჩაშლის ანგარიშები ხელმისაწვდომი არ არის Browther-ზე.</translation>
<translation id="5747951541048369241">თქვენ ათვალიერებთ Browther-ის დაცულ გვერდს</translation>
<translation id="7041193161756628041">Browther ცდილობს პარამეტრების შეცვლას, გადახდის მეთოდების შესავსებად.</translation>
<translation id="4670277172953498174">Browther-ის ლოგო</translation>
<translation id="3474898875907708105">Browther ცდილობს გადახდის მეთოდების რედაქტირებას.</translation>
<translation id="5700544173546684818">Browther არსებობს <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ღია წყაროს პროექტის და სხვა <ph name="BEGIN_LINK_OSS"/>ღია წყაროს პროგრამული უზრუნველყოფის<ph name="END_LINK_OSS"/> წყალობით.</translation>
<translation id="8935269788853634726">ეს გვერდი დაბლოკილია Browther-ის მიერ</translation>
<translation id="1339376981847018870">თქვენი ქსელის დაცვის ან ანტივირუსის პარამეტრებში, მიეცით Browther-ს ქსელზე წვდომის
          უფლება.</translation>
<translation id="4949828774841497663">გახსენით: აპები &gt; სისტემის პარამეტრები &gt; ქსელი, აირჩიეთ
          აქტიური ქსელი, დააწკაპუნეთ ღილაკზე „დეტალები...“ და გააუქმეთ ნებისმიერი პროქსი-სერვერის
          არჩევა.</translation>
<translation id="4191403906356422893">გახსენით:
          Browther-ის მენიუ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ქსელი და ინტერნეტი &gt; პროქსი-სერვერი
          და გააუქმეთ არჩევა „პარამეტრების ავტომატური ამოცნობა“.</translation>
<translation id="958169674889932546">ეს გვერდები განკუთვნილია Browther დეველოპერების მიერ გამოყენებისთვის და მათი აქტიურად შენარჩუნება ან ტესტირება დაუშვებელია. მათ ჩასართავად გახსენით <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, დააწკაპუნეთ ღილაკზე გვერდების გამართვის ჩასართავად და შემდეგ ისევ გადადით ამ გვერდზე.</translation>
<translation id="4303967029316005584">Browther, ასევე, მუშაობს <ph name="BEGIN_LINK_OSS"/>ღია კოდის სხვა პროგრამული უზრუნველყოფის<ph name="END_LINK_OSS"/> დამსახურებით.</translation>
<translation id="8031938899816118394">თქვენი ცვლილებები გააქტიურდება Browther-ის შემდეგი გაშვებისას.</translation>
<translation id="221029295134825758">დაწყვილების გასაგრძელებლად Browther საჭიროებს Bluetooth-ზე წვდომას. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther არსებობს <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>-ის ღია კოდის პროექტის წყალობით.</translation>
<translation id="3134645574591615830">გახსენით
         Browther-ის მენიუ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          და მოხსენით მონიშვნა ელემენტიდან „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          თუ პრობლემა ვერ გადაწყდა, გირჩევთ ხელახლა აირჩიოთ
          ეს პარამეტრი, გაუმჯობესებული ეფექტურობისთვის.</translation>
<translation id="8927199829149811571">თქვენი უყურებთ Browther for Testing-ის დაცულ გვერდს</translation>
<translation id="4220066730874343807">Browther სწორად ვერ გაითიშა.</translation>
</translationbundle>