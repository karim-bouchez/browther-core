<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="az">
<translation id="130631256467250065">Dəyişiklikləriniz cihazınızı işə salandan sonra qüvvəyə minəcək.</translation>
<translation id="5681560603157873402">Browther menyusuna &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          keçin və konfiqurasiyanızın "proksi yoxdur" və ya "birbaşa" olaraq ayarlandığına əmin olun.</translation>
<translation id="4903497818305945122">Xəta hesabatı Browther'da əlçatan deyil.</translation>
<translation id="5747951541048369241">Təhlükəsiz Browther səhifəsinə baxırsınız</translation>
<translation id="7041193161756628041">Browther ödəniş metodlarını doldurmaq üçün ayarlara dəyişiklik etməyə çalışır.</translation>
<translation id="4670277172953498174">Browther loqo</translation>
<translation id="3474898875907708105">Browther ödəniş metodlarını redaktə etməyə çalışır.</translation>
<translation id="5700544173546684818">Browther <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> açıq mənbə layihəsi və digər <ph name="BEGIN_LINK_OSS"/>açıq mənbə proqram təminatları tərəfindən<ph name="END_LINK_OSS"/> əlçatan edilib.</translation>
<translation id="8935269788853634726">Bu səhifə Browther tərəfindən bloklanıb</translation>
<translation id="1339376981847018870">Browther'a qoruyucu divar və ya antivirus ayarlarınızda şəbəkəyə daxil olmağa imkan verin.</translation>
<translation id="4949828774841497663">Tətbiqlər &gt; Sistem Ayarları &gt; Şəbəkə bölməsinə keçin,
          aktiv şəbəkə keçin, Detallar... düyməsinə klikləyin və seçilmiş ola biləcək bütün proksilərin
          seçimini silin.</translation>
<translation id="4191403906356422893">Browther menyusu &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Şəbəkə və internet &gt; Proksi
          bölməsinə keçin və "Ayarları avtomatik aşkarlayın" seçimini silin.</translation>
<translation id="958169674889932546">Bu səhifələr Browther developerləri tərəfindən istifadə üçün nəzərdə tutulub və aktiv şəkildə saxlanıla və ya sınaqdan keçirilə bilməz. Aktivləşdirmək üçün <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> ünvanına keçin, sazlama səhifələrini aktivləşdirmək üçün düyməni basın və sonra yenidən bu səhifəyə keçin.</translation>
<translation id="4303967029316005584">Browther, həmçinin <ph name="BEGIN_LINK_OSS"/>digər açıq mənbə proqram təminatı<ph name="END_LINK_OSS"/> olmadan mümkün olmazdı.</translation>
<translation id="8031938899816118394">Dəyişiklikləriniz gələn dəfə Browther'u başlatdıqda qüvvəyə minəcək.</translation>
<translation id="221029295134825758">Browther birləşməyə davam etmək üçün Bluetooth'a giriş tələb edir. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> açıq mənbə layihəsi olmadan mümkün olmazdı.</translation>
<translation id="3134645574591615830">Buraya keçin:
          Browther menyusu &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          və "<ph name="NO_PREFETCH_DESCRIPTION"/>" üzərindən seçimi qaldırın.
Əgər problem bununla həll olmursa, bu variantı qabaqcıl performans üçün seçməyi tövsiyə edirik.</translation>
<translation id="8927199829149811571">Təhlükəsiz Sınaq üçün Browther səhifəsinə baxırsınız</translation>
<translation id="4220066730874343807">Browther düzgün qapadılmadı.</translation>
</translationbundle>