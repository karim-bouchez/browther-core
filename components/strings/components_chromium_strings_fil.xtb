<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fil">
<translation id="130631256467250065">Magkakabisa ang iyong mga pagbabago sa susunod na i-restart ang iyong device.</translation>
<translation id="5681560603157873402">Pumunta sa
          menu ng Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          at tiyaking nakatakda sa "walang proxy" o "direkta" ang iyong configuration.</translation>
<translation id="4903497818305945122">Hindi available ang pag-uulat ng crash sa Browther.</translation>
<translation id="5747951541048369241">Isang ligtas na page ng Browther ang tinitingnan mo</translation>
<translation id="7041193161756628041">Sinusubukan ng Browther na baguhin ang mga setting para sa paglalagay ng mga paraan ng pagbabayad.</translation>
<translation id="4670277172953498174">Logo ng Browther</translation>
<translation id="3474898875907708105">Sinusubukan ng Browther na i-edit ang mga paraan ng pagbabayad.</translation>
<translation id="5700544173546684818">Nagiging posible ang Browther sa pamamagitan ng proyekto sa open source ng <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> at iba pang <ph name="BEGIN_LINK_OSS"/>open source na software<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Na-block ng Browther ang page na ito</translation>
<translation id="1339376981847018870">Pahintulutan ang Browther na i-access ang network sa
          mga setting ng iyong firewall o antivirus.</translation>
<translation id="4949828774841497663">Pumunta sa Applications &gt; System Settings &gt; Network, piliin ang
          aktibong network, i-click ang button na Details... at i-deselect ang anumang proxy
          na posibleng napili.</translation>
<translation id="4191403906356422893">Pumunta sa
          menu ng Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Network at internet &gt; Proxy
          at i-deselect ang "Awtomatikong mag-detect ng mga setting."</translation>
<translation id="958169674889932546">Nakalaan ang mga page na ito para sa paggamit ng mga developer ng Browther, at posibleng hindi ito aktibong pinapanatili o sinusubukan. Para i-enable ang mga ito, mag-navigate papunta sa <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, i-click ang button para i-enable ang mga page sa pag-debug, at pagkatapos ay mag-navigate ulit papunta sa page na ito.</translation>
<translation id="4303967029316005584">Nagiging posible rin ang Browther sa pamamagitan ng iba pang <ph name="BEGIN_LINK_OSS"/>open source na software<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Magkakabisa ang iyong mga pagbabago sa susunod na ilunsad mong muli ang Browther.</translation>
<translation id="221029295134825758">Nangangailangan ang Browther ng access sa Bluetooth para magpatuloy sa 
 pagpapares. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Nagiging posible ang Browther sa pamamagitan ng <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> open source project.</translation>
<translation id="3134645574591615830">Pumunta
          sa menu ng Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          at alisin sa pagkakapili ang "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Kung hindi nito malulutas ang isyu, inirerekomenda naming piliing muli ang opsyong ito
          para sa pinahusay na pagganap.</translation>
<translation id="8927199829149811571">Isang secure na page ng Browther na Pang-test ang tinitingnan mo</translation>
<translation id="4220066730874343807">Hindi nag-shut down nang tama ang Browther.</translation>
</translationbundle>