<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fi">
<translation id="130631256467250065">Muutokset tulevat voimaan, kun käynnistät laitteen seuraavan kerran.</translation>
<translation id="5681560603157873402">Avaa
          Browther-valikko &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ja varmista, että asetus on "ei välityspalvelinta" tai "suora".</translation>
<translation id="4903497818305945122">Virheraportit eivät ole käytettävissä Braveissa.</translation>
<translation id="5747951541048369241">Tämä on suojattu Browther-sivu</translation>
<translation id="7041193161756628041">Browther yrittää muuttaa maksutapojen täyttämisen asetuksia.</translation>
<translation id="4670277172953498174">Browther-logo</translation>
<translation id="3474898875907708105">Browther yrittää muokata maksutapoja.</translation>
<translation id="5700544173546684818">Bravein ovat tehneet mahdolliseksi <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>-projekti ja muut <ph name="BEGIN_LINK_OSS"/>avoimen lähdekoodin ohjelmistot<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Browther on estänyt tämän sivun</translation>
<translation id="1339376981847018870">Myönnä Braveille verkon käyttöoikeus palomuurin tai virustorjuntaohjelmiston
          asetuksissa</translation>
<translation id="4949828774841497663">Siirry kohtaan Sovellukset &gt; Järjestelmäasetukset &gt; Verkko, valitse
          aktiivinen verkko, klikkaa Tiedot…-painiketta ja poista valinta kaikista mahdollisesti
          valituista välityspalvelimista.</translation>
<translation id="4191403906356422893">Siirry
          Browther-valikkoon &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Verkko ja internet &gt; Välityspalvelin
          ja poista valinta "Tunnista asetukset automaattisesti".</translation>
<translation id="958169674889932546">Nämä sivut on tarkoitettu Bravein kehittäjille, eikä niitä välttämättä ylläpidetä tai testata aktiivisesti. Voit ottaa ne käyttöön siirtymällä osoitteeseen <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klikkaamalla painiketta, jolla voit ottaa virheenkorjaussivut käyttöön, ja siirtymällä sitten uudelleen tälle sivulle.</translation>
<translation id="4303967029316005584">Muu <ph name="BEGIN_LINK_OSS"/>avoimen lähdekoodin ohjelmisto<ph name="END_LINK_OSS"/> tukee Braveia.</translation>
<translation id="8031938899816118394">Muutokset tulevat voimaan, kun käynnistät Bravein seuraavan kerran.</translation>
<translation id="221029295134825758">Browther tarvitsee Bluetoothia jatkaakseen 
 laiteparin muodostusta. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Bravein mahdollistivat avoimen lähdekoodin projekti <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Avaa
        Browther-valikko &gt;
       <ph name="SETTINGS_TITLE"/>
        &gt;
       <ph name="ADVANCED_TITLE"/>
        ja poista valinta kohdasta <ph name="NO_PREFETCH_DESCRIPTION"/>.
        Jos ongelma ei ratkea, valitse tämä vaihtoehto
        uudelleen suorituskyvyn parantamiseksi.</translation>
<translation id="8927199829149811571">Tämä on suojattu Browther for Testing ‑sivu</translation>
<translation id="4220066730874343807">Braveia ei suljettu oikein.</translation>
</translationbundle>