<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lt">
<translation id="130631256467250065">Pakeitimai įsigalios kitą kartą iš naujo paleidus įrenginį.</translation>
<translation id="5681560603157873402">Eikite į
          „Browther“ meniu &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ir įsitikinkite, kad konfigūracija nustatyta kaip „be tarpinio serverio“ arba „tiesioginė“.</translation>
<translation id="4903497818305945122">„Browther“ negalima teikti strigčių ataskaitų.</translation>
<translation id="5747951541048369241">Peržiūrite saugų „Browther“ puslapį</translation>
<translation id="7041193161756628041">„Browther“ bando keisti mokėjimo metodų pildymo nustatymus.</translation>
<translation id="4670277172953498174">„Browther“ logotipas</translation>
<translation id="3474898875907708105">„Browther“ bando redaguoti mokėjimo metodus.</translation>
<translation id="5700544173546684818">„Browther“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM"/>„Browther“<ph name="END_LINK_CHROMIUM"/> atvirojo šaltinio projektą ir kitą <ph name="BEGIN_LINK_OSS"/>atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Šį puslapį užblokavo „Browther“</translation>
<translation id="1339376981847018870">Leiskite „Browther“ pasiekti tinklą užkardos arba antivirusinės programos
          nustatymuose.</translation>
<translation id="4949828774841497663">Eikite į skiltį „Programos“ &gt; „Sistemos nustatymai“ &gt; „Tinklas“, pasirinkite
          aktyvų tinklą, spustelėkite mygtuką „Išsami informacija...“ ir panaikinkite visų tarpinių serverių,
          kurie galėjo būti pasirinkti, pasirinkimą.</translation>
<translation id="4191403906356422893">Eikite į
          „Browther“ meniu &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          „Tinklas ir internetas“ &gt; „Tarpinis serveris“
          ir panaikinkite parinkties „Automatiškai aptikti nustatymus“ pasirinkimą.</translation>
<translation id="958169674889932546">Šie puslapiai skirti naudoti „Browther“ kūrėjams ir gali nebūti aktyviai tvarkomi ar išbandomi. Jei norite juos įgalinti, eikite adresu <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, spustelėkite mygtuką, kad įgalintumėte derinimo puslapius, ir tada grįžkite į šį puslapį.</translation>
<translation id="4303967029316005584">„Browther“ taip pat pasiekiama naudojant kitą <ph name="BEGIN_LINK_OSS"/>atvirojo šaltinio programinę įrangą<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Pakeitimai įsigalios kitą kartą iš naujo paleidus „Browther“.</translation>
<translation id="221029295134825758">„Browther“ reikia pasiekti „Bluetooth“, kad galėtų sieti 
 toliau. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">„Browther“ pasiekiama naudojant <ph name="BEGIN_LINK_CHROMIUM"/>„Browther“<ph name="END_LINK_CHROMIUM"/> atvirojo šaltinio projektą.</translation>
<translation id="3134645574591615830">Eikite į
        „Browther“ meniu &gt;
        „<ph name="SETTINGS_TITLE"/>“
        &gt;
        „<ph name="ADVANCED_TITLE"/>“
        ir panaikinkite „<ph name="NO_PREFETCH_DESCRIPTION"/>“ pasirinkimą.
        Jei tai atlikus problema išlieka, rekomenduojame vėl pasirinkti šią parinktį,
        kad pagerėtų našumas.</translation>
<translation id="8927199829149811571">Peržiūrite saugų „Browther for Testing“ puslapį</translation>
<translation id="4220066730874343807">„Browther“ netinkamai išsijungė.</translation>
</translationbundle>