<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="el">
<translation id="130631256467250065">Οι αλλαγές σας θα εφαρμοστούν την επόμενη φορά που θα επανεκκινήσετε τη συσκευή σας.</translation>
<translation id="5681560603157873402">Μεταβείτε
          στο μενού του Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          και βεβαιωθείτε ότι η διαμόρφωσή σας είναι ρυθμισμένη στην επιλογή "χωρίς διακομιστή μεσολάβησης" ή "άμεση".</translation>
<translation id="4903497818305945122">Η αναφορά σφαλμάτων δεν είναι διαθέσιμη στο Browther.</translation>
<translation id="5747951541048369241">Βλέπετε μια ασφαλή σελίδα Browther</translation>
<translation id="7041193161756628041">Το Browther προσπαθεί να τροποποιήσει τις ρυθμίσεις για τη συμπλήρωση τρόπων πληρωμής.</translation>
<translation id="4670277172953498174">Λογότυπο Browther</translation>
<translation id="3474898875907708105">Το Browther προσπαθεί να επεξεργαστεί τους τρόπους πληρωμής.</translation>
<translation id="5700544173546684818">Το Browther υλοποιήθηκε με τη βοήθεια του έργου ανοικτού κώδικα <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> και άλλου <ph name="BEGIN_LINK_OSS"/>λογισμικού ανοικτού κώδικα<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Αυτή η σελίδα έχει αποκλειστεί από το Browther.</translation>
<translation id="1339376981847018870">Επιτρέψτε στο Browther να αποκτήσει πρόσβαση στο δίκτυο από τις ρυθμίσεις του τείχους προστασίας
          ή του λογισμικού προστασίας από ιούς που διαθέτετε.</translation>
<translation id="4949828774841497663">Μεταβείτε στις Εφαρμογές &gt; Ρυθμίσεις συστήματος &gt; Δίκτυο, επιλέξτε το
          ενεργό δίκτυο, κάντε κλικ στο κουμπί "Λεπτομέρειες…" και καταργήστε την επιλογή τυχόν διακομιστών μεσολάβησης
          που μπορεί να έχουν επιλεγεί.</translation>
<translation id="4191403906356422893">Μεταβείτε στο
          μενού του Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Δίκτυο και διαδίκτυο &gt; Διακομιστής μεσολάβησης
          και αποεπιλέξτε την επιλογή Αυτόματος εντοπισμός ρυθμίσεων.</translation>
<translation id="958169674889932546">Αυτές οι σελίδες προορίζονται για χρήση από προγραμματιστές του Browther και ενδέχεται να μην συντηρούνται ή να ελέγχονται ενεργά. Για να τις ενεργοποιήσετε, μεταβείτε στο <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, κάντε κλικ στο κουμπί, για να ενεργοποιήσετε τις σελίδες εντοπισμού σφαλμάτων και, στη συνέχεια, μεταβείτε ξανά σε αυτή τη σελίδα.</translation>
<translation id="4303967029316005584">Το Browther υλοποιήθηκε με τη βοήθεια και άλλων <ph name="BEGIN_LINK_OSS"/>λογισμικών ανοικτού κώδικα<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Οι αλλαγές που πραγματοποιήσατε θα ισχύσουν την επόμενη φορά που θα εκκινήσετε το Browther.</translation>
<translation id="221029295134825758">Το Browther χρειάζεται πρόσβαση στο Bluetooth για να συνεχιστεί 
 η σύζευξη. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Το Browther υλοποιήθηκε με το έργο ανοικτού κώδικα <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Μεταβείτε
        στο μενού του Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        και αποεπιλέξτε "<ph name="NO_PREFETCH_DESCRIPTION"/>".
        Εάν με αυτόν τον τρόπο δεν επιλύεται το ζήτημά σας, συνιστούμε
        να ενεργοποιήσετε ξανά αυτή την επιλογή για βελτιωμένη απόδοση.</translation>
<translation id="8927199829149811571">Βλέπετε μια ασφαλή σελίδα Browther for Testing</translation>
<translation id="4220066730874343807">Το Browther δεν έκλεισε σωστά.</translation>
</translationbundle>