<!DOCTYPE translationbundle>
<translationbundle lang="my">
<translation id="130631256467250065">သင် ပြောင်းလဲခဲ့သည်များမျာ သင်က သင်၏ ကိရိယာကို နောက်တစ်ကြိမ် ပြန်ဖွင့်စဉ် အကျိုးသက်ရောက် လာကြပါမည်။</translation>
<translation id="5681560603157873402">ဤသို့သွားပါ-
          Browther မီနူး &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ထို့နောက် စီစဉ်သတ်မှတ်ချက်ကို “ပရောက်စီ အသုံးမပြုရန်” (သို့) “တိုက်ရိုက်” ဟု သတ်မှတ်ပါ။</translation>
<translation id="4903497818305945122">Browther တွင်ပျက်စီးမှု အစီရင်ခံချက် မရနိုင်ပါ။</translation>
<translation id="5747951541048369241">သင်သည် လုံခြုံသည့် Browther စာမျက်နှာကို ကြည့်ရှုနေပါသည်</translation>
<translation id="7041193161756628041">Browther သည် ငွေပေးချေနည်းလမ်းများ ဖြည့်သည့် ဆက်တင်များကို ပြင်ဆင်ရန် ကြိုးပမ်းနေသည်။</translation>
<translation id="4670277172953498174">Browther လိုဂို</translation>
<translation id="3474898875907708105">Browther က ငွေပေးချေနည်းလမ်းများကို ပြင်ရန် ကြိုးပမ်းနေသည်။</translation>
<translation id="5700544173546684818">Browther အား <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ပွင့်လင်းအရင်းမြစ် စီမံကိန်းနှင့် အခြား <ph name="BEGIN_LINK_OSS"/>ပွင့်လင်း အရင်းမြစ် ဆော့ဝဲ<ph name="END_LINK_OSS"/> မှပြုလုပ်ထားပါသည်။</translation>
<translation id="8935269788853634726">Browther က ဤစာမျက်နှာကို ပိတ်ထားသည်</translation>
<translation id="1339376981847018870">သင့် Firewall သို့မဟုတ် ဗိုင်းရပ်စ်ခုခံစနစ် ဆက်တင်များအတွင်း ကွန်ရက်အသုံးပြုရန် Browther ကိုခွင့်ပြုပါ။</translation>
<translation id="4949828774841497663">‘အပလီကေးရှင်းများ’ &gt; ‘စနစ် ဆက်တင်များ’ &gt; ‘ကွန်ရက်’ သို့ သွားပြီး
          သုံးနေသောကွန်ရက်ကို ရွေးပါ။ ‘အသေးစိတ်...’ ခလုတ်ကို နှိပ်ပြီး ရွေးထားသော ပရောက်စီများကို
          ပြန်ဖြုတ်ပါ။</translation>
<translation id="4191403906356422893">ဤသို့သွားပါ-
          Browther မီနူး &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ကွန်ရက်နှင့် အင်တာနက် &gt; ပရောက်စီ
          ထို့နောက် “ဆက်တင်များကို အလိုအလျောက် သိရှိရန်” ကို ပြန်ဖြုတ်ပါ။</translation>
<translation id="958169674889932546">ဤစာမျက်နှာများကို Browther ဆော့ဖ်ဝဲရေးသူများ သုံးရန်အတွက် ရည်ရွယ်ထားပြီး အမြဲတစေ ပြုပြင်ထိန်းသိမ်းခြင်း/စမ်းသပ်ထားခြင်း မရှိနိုင်ပါ။ ၎င်းတို့ကိုဖွင့်ရန် <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> သို့ သွားပြီး အမှားရှာပြင်ခြင်းစာမျက်နှာများ ဖွင့်ရန် ခလုတ်ကိုနှိပ်ပြီးနောက် ဤစာမျက်နှာသို့ ပြန်လာပါ။</translation>
<translation id="4303967029316005584">အခြား <ph name="BEGIN_LINK_OSS"/>အခမဲ့ ရင်းမြစ်ဆော့ဖ်ဝဲ<ph name="END_LINK_OSS"/> ဖြင့်လည်း Browther ကို ထုတ်လုပ်ထားသည်။</translation>
<translation id="8031938899816118394">Browther ကိုသင်နောက်တစ်ကြိမ် ပြန်လည်စတင်လျှင် သင့်ပြောင်းလဲမှုများ အကျိုးသက်ရောက်မှု ရှိမည်ဖြစ်သည်။</translation>
<translation id="221029295134825758">Browther သည် ဆက်လက်တွဲချိတ်ရန် ဘလူးတုသ်သုံးခွင့် 
 လိုပါသည်။ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> အခမဲ့ ရင်းမြစ်ပရောဂျက်ဖြင့် Browther ကို ထုတ်လုပ်ထားသည်။</translation>
<translation id="3134645574591615830">Browther မီနူးဆီကို သွားပါ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          ပြီးတော့ "<ph name="NO_PREFETCH_DESCRIPTION"/>"ကို ရွေးပါ။
          ၎င်းက ပြဿနာကို ဖြေရှင်းမပေးနိုင်ခဲ့သော်၊ ပိုပြီး အဆင့်မြင့်သည့် လုပ်ကိုင်မှုအတွက် ဒီရွေးချယ်မှုကို ထပ်ပြီး ရွေးချယ်ရန်ကို ကျွန်ပ်တို့ အကြံပေးလိုပါသည်။</translation>
<translation id="8927199829149811571">သင်သည် လုံခြုံသည့် Browther for Testing စာမျက်နှာကို ကြည့်နေခြင်းဖြစ်သည်</translation>
<translation id="4220066730874343807">Browther သည် မှန်ကန်စွာ ပိတ်မသွားခဲ့ပါ။</translation>
</translationbundle>