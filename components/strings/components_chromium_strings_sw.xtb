<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sw">
<translation id="130631256467250065">Mabadiliko yako yatatekelezwa utakapowasha upya tena kifaa chako.</translation>
<translation id="5681560603157873402">Nenda kwenye
          menyu ya Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          na uhakikishe kuwa mipangilio yako imewekwa kuwa "hakuna seva mbadala" au "ya moja kwa moja."</translation>
<translation id="4903497818305945122">Kuripoti uharibifu hakupatikana katika Browther.</translation>
<translation id="5747951541048369241">Unaangalia ukurasa salama wa Browther</translation>
<translation id="7041193161756628041">Browther inajaribu kurekebisha mipangilio kwa ajili ya kujaza njia za kulipa.</translation>
<translation id="4670277172953498174">Nembo ya Browther</translation>
<translation id="3474898875907708105">Browther inajaribu kubadilisha njia za kulipa.</translation>
<translation id="5700544173546684818">Browther imerahisishwa na mradi wa programu huria ya <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> na programu nyingine <ph name="BEGIN_LINK_OSS"/>huria<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Ukurasa huu umezuiwa na Browther</translation>
<translation id="1339376981847018870">Ruhusu Browther ifikie mtandao kwenye mipangilio yako ya kinga mtandao au kingavirusi.</translation>
<translation id="4949828774841497663">Nenda kwenye Programu &gt; Mipangilio ya Mfumo &gt; Mtandao, chagua
          mtandao unaotumika, bofya kitufe cha Maelezo... kisha uache kuchagua seva zozote mbadala
          ambazo huenda umechagua.</translation>
<translation id="4191403906356422893">Nenda kwenye
          menyu ya Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mtandao na intaneti &gt; Seva mbadala
          kisha uache kuchagua "Tambua mipangilio kiotomatiki."</translation>
<translation id="958169674889932546">Kurasa hizi zinanuiwa kutumiwa na wasanidi programu wa Browther na huenda zisiweze kufanyiwa majaribio wala kudumishwa kila wakati. Ili uzifungue, nenda kwenye <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, bofya kitufe ili ufungue kurasa za utatuzi kisha urudi kwenye ukurasa huu tena.</translation>
<translation id="4303967029316005584">Browther inawezeshwa pia na <ph name="BEGIN_LINK_OSS"/>programu nyingine huria<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Mabadiliko yako yataanza kufanya kazi wakati ujao utakapozindua upya Browther.</translation>
<translation id="221029295134825758">Browther inahitaji ruhusa ya kufikia Bluetooth ili iendelee 
 kuoanisha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther inawezeshwa na mradi wa programu huria wa <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Nenda kwenye
        menyu ya Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        <ph name="ADVANCED_TITLE"/>na uondoe tiki kwenye "<ph name="NO_PREFETCH_DESCRIPTION"/>."
        Ikiwa hili halitatatua tatizo, tunapendekeza uchague tena chaguo hili kwa utendaji ulioboreshwa.</translation>
<translation id="8927199829149811571">Unaangalia ukurasa salama wa Browther ya Majaribio</translation>
<translation id="4220066730874343807">Browther haikuzimika kwa njia sahihi.</translation>
</translationbundle>