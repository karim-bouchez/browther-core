<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hi">
<translation id="130631256467250065">अगली बार अपना डिवाइस फिर से शुरू करने पर आपके बदलाव लागू हो जाएंगे.</translation>
<translation id="5681560603157873402">Browther मेन्यू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          पर जाएं और पक्का करें कि कॉन्फ़िगरेशन "कोई प्रॉक्सी नहीं" या "डायरेक्ट" पर सेट किया गया हो.</translation>
<translation id="4903497818305945122">Browther में खराबी रिपोर्ट नहीं कर सकते.</translation>
<translation id="5747951541048369241">एक सुरक्षित Browther पेज देखा जा रहा है</translation>
<translation id="7041193161756628041">Browther, पेमेंट के तरीके की जानकारी भरने के लिए, सेटिंग में बदलाव करने की कोशिश कर रहा है.</translation>
<translation id="4670277172953498174">Browther लोगो</translation>
<translation id="3474898875907708105">Browther पेमेंट के तरीकों में बदलाव करने की कोशिश कर रहा है.</translation>
<translation id="5700544173546684818">Browther <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> खुला स्रोत प्रोजेक्ट और अन्‍य <ph name="BEGIN_LINK_OSS"/>खुले स्रोत प्रोजेक्ट<ph name="END_LINK_OSS"/> द्वारा संभव बनाया गया है.</translation>
<translation id="8935269788853634726">इस पेज को Browther ने ब्लॉक कर दिया है</translation>
<translation id="1339376981847018870">Browther को अपनी फ़ायरवॉल या एंटीवायरस सेटिंग में
          नेटवर्क को एक्सेस करने दें.</translation>
<translation id="4949828774841497663">ऐप्लिकेशन &gt; सिस्टम सेटिंग &gt; नेटवर्क पर जाकर, ऐक्टिव नेटवर्क को चुनें. इसके बाद, 'जानकारी...' बटन पर क्लिक करें और चुनी गई किसी भी प्रॉक्सी से चुने हुए का निशान हटाएं.</translation>
<translation id="4191403906356422893">Browther मेन्यू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          नेटवर्क और इंटरनेट &gt; प्रॉक्सी पर जाएं
          और "ऑटोमैटिक तरीके से पता लगाने की सेटिंग" से चुने हुए का निशान हटाएं.</translation>
<translation id="958169674889932546">इन पेजों को Browther डेवलपर के इस्तेमाल के लिए बनाया गया है. ऐसा हो सकता है कि समय-समय पर इनका रखरखाव या इनकी जांच न की जाती हो. इन पेजों की सेटिंग को चालू करने के लिए, <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> पर जाएं. इसके बाद, बटन पर क्लिक करके डीबग पेजों की सेटिंग को चालू करें और फिर इस पेज पर वापस जाएं.</translation>
<translation id="4303967029316005584">Browther को अन्य <ph name="BEGIN_LINK_OSS"/>ओपन सोर्स सॉफ़्टवेयर<ph name="END_LINK_OSS"/> की मदद से भी बनाया गया है.</translation>
<translation id="8031938899816118394">अगली बार जब आप Browther फिर से लॉन्‍च करेंगे तो आपके बदलाव लागू होंगे .</translation>
<translation id="221029295134825758">दूसरे डिवाइस से जोड़े रखने के लिए, Browther को ब्लूटूथ का ऐक्सेस 
 चाहिए. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther को <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ओपन सोर्स प्रोजेक्ट की मदद से बनाया गया है.</translation>
<translation id="3134645574591615830">यहां जाएं
          Browther मेन्यू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          और "<ph name="NO_PREFETCH_DESCRIPTION"/>" चुना हुआ हटाएं.
          अगर इससे समस्‍या हल नहीं होती, तो बेहतर प्रदर्शन के लिए हम इस विकल्‍प को फिर से चुनने का सुझाव देते हैं.</translation>
<translation id="8927199829149811571">आप एक सुरक्षित Browther for Testing पेज पर हैं</translation>
<translation id="4220066730874343807">Browther सही तरीके से बंद नहीं हुआ.</translation>
</translationbundle>