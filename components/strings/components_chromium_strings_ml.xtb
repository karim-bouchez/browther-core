<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="130631256467250065">നിങ്ങൾ അടുത്ത തവണ ഉപകരണം റീസ്റ്റാർട്ട് ചെയ്യുമ്പോൾ മാറ്റങ്ങൾ പ്രാബല്യത്തിൽ വരും.</translation>
<translation id="5681560603157873402">Browther മെനു &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          എന്നിങ്ങനെ പോയി നിങ്ങളുടെ കോൺഫിഗറേഷൻ ''പ്രോക്‌സി അല്ല'' അല്ലെങ്കിൽ ''നേരിട്ട്'' എന്നതിലേക്ക് സജ്ജീകരിച്ചിട്ടുണ്ടെന്ന് ഉറപ്പാക്കുക.</translation>
<translation id="4903497818305945122">Browther-ത്തിൽ ക്രാഷ് റിപ്പോർട്ടിംഗ് ലഭ്യമല്ല.</translation>
<translation id="5747951541048369241">നിങ്ങൾ സുരക്ഷിതമായ ഒരു Browther പേജാണ് കാണുന്നത്</translation>
<translation id="7041193161756628041">പേയ്‌മെന്റ് രീതികൾ പൂരിപ്പിക്കുന്നതിനുള്ള ക്രമീകരണം പരിഷ്‌കരിക്കാൻ ശ്രമിക്കുകയാണ് Browther.</translation>
<translation id="4670277172953498174">Browther ലോഗോ</translation>
<translation id="3474898875907708105">പേയ്‌മെന്റ് രീതികൾ എഡിറ്റ് ചെയ്യാൻ Browther ശ്രമിക്കുന്നു.</translation>
<translation id="5700544173546684818">Browther സാധ്യമായത് <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ഓപ്പൺ സോഴ്‌സ് പ്രോജക്റ്റും മറ്റ് <ph name="BEGIN_LINK_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയറും<ph name="END_LINK_OSS"/> ഉപയോഗിച്ചാണ്</translation>
<translation id="8935269788853634726">Browther ഈ പേജ് ബ്ലോക്ക് ചെയ്തിരിക്കുന്നു</translation>
<translation id="1339376981847018870">നിങ്ങളുടെ ഫയർവാളിലെയോ ആന്റിവൈറസ് ക്രമീകരണത്തിലെയോ നെറ്റ്‌വർക്ക്
          ആക്‌സസ് ചെയ്യാൻ Browther-നെ അനുവദിക്കുക.</translation>
<translation id="4949828774841497663">ആപ്പുകൾ &gt; സിസ്റ്റം ക്രമീകരണം &gt; നെറ്റ്‌വർക്ക്, സജീവ നെറ്റ്‌വർക്ക്
          തിരഞ്ഞെടുക്കുക, വിശദാംശങ്ങൾ ക്ലിക്ക് ചെയ്യുക... ബട്ടൺ, തിരഞ്ഞെടുത്തിരിക്കാവുന്ന എല്ലാ പ്രോക്സികളും
          തിരഞ്ഞെടുത്തത് മാറ്റുക.</translation>
<translation id="4191403906356422893">Browther മെനു &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          നെറ്റ്‌വർക്കും ഇന്റർനെറ്റും &gt; പ്രോക്സി
          എന്നിങ്ങനെ പോയി "ക്രമീകരണം സ്വയമേവ കണ്ടെത്തുക" തിരഞ്ഞെടുത്തത് മാറ്റുക.</translation>
<translation id="958169674889932546">ഈ പേജുകൾ Browther ഡെവലപ്പർമാരുടെ ഉപയോഗത്തിനായി ഉദ്ദേശിച്ചുള്ളതാണ്, അവ സജീവമായി പരിപാലിച്ചേക്കില്ല അല്ലെങ്കിൽ ടെസ്റ്റ് ചെയ്‌തേക്കില്ല. അവ പ്രവർത്തനക്ഷമമാക്കാൻ, <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> നാവിഗേറ്റ് ചെയ്യുക, ഡീബഗ് പേജുകൾ പ്രവർത്തനക്ഷമമാക്കാൻ ബട്ടൺ ക്ലിക്ക് ചെയ്യുക, തുടർന്ന് ഈ പേജിലേക്ക് വീണ്ടും നാവിഗേറ്റ് ചെയ്യുക.</translation>
<translation id="4303967029316005584">Browther സാധ്യമാക്കിയത് മറ്റ് <ph name="BEGIN_LINK_OSS"/>ഓപ്പൺ സോഴ്‌സ് സോഫ്റ്റ്‌വെയറുകൾ<ph name="END_LINK_OSS"/> കൂടി ഉപയോഗിച്ചാണ്.</translation>
<translation id="8031938899816118394">നിങ്ങളുടെ മാറ്റങ്ങൾ അടുത്ത തവണ Browther വീണ്ടും ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.</translation>
<translation id="221029295134825758">ജോടിയാക്കൽ തുടരാൻ Browther-ന് Bluetooth ആക്സസ് 
 ആവശ്യമാണ്. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther സാധ്യമാക്കിയത് <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ഓപ്പൺ സോഴ്‌സ് പ്രോജക്റ്റ് ഉപയോഗിച്ചാണ്.</translation>
<translation id="3134645574591615830">Browther മെനു &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/> എന്നതിലേക്ക് പോയി
          "<ph name="NO_PREFETCH_DESCRIPTION"/>" തിരഞ്ഞെടുത്തത് മാറ്റുക.
          ഇത് പ്രശ്‌നം പരിഹരിക്കുന്നില്ലെങ്കിൽ, മെച്ചപ്പെട്ട പ്രകടനത്തിനായി ഈ ഓപ്‌ഷൻ വീണ്ടും തിരഞ്ഞെടുക്കാൻ ഞങ്ങൾ ശുപാർശ ചെയ്യുന്നു.</translation>
<translation id="8927199829149811571">സുരക്ഷിതമായ ഒരു Browther for Testing പേജാണ് നിങ്ങൾ കാണുന്നത്</translation>
<translation id="4220066730874343807">Browther ശരിയായി ഷട്ട്ഡൗൺ ചെയ്‌തിട്ടില്ല.</translation>
</translationbundle>