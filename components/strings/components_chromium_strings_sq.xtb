<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sq">
<translation id="130631256467250065">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh pajisjen.</translation>
<translation id="5681560603157873402">Shko te
          menyja e Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          dhe sigurohu që konfigurimi yt të jetë i caktuar në "pa proxy" ose "i drejtpërdrejtë".</translation>
<translation id="4903497818305945122">Raportimi i ndërprerjes aksidentale nuk ofrohet në Browther.</translation>
<translation id="5747951541048369241">Po shikon një faqe të sigurt të Browther</translation>
<translation id="7041193161756628041">Browther po përpiqet të modifikojë cilësimet për plotësimin e mënyrave të pagesave.</translation>
<translation id="4670277172953498174">Logoja e Browther</translation>
<translation id="3474898875907708105">Browther po përpiqet të modifikojë mënyrat e pagesës.</translation>
<translation id="5700544173546684818">Browther është bërë i mundur nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> dhe <ph name="BEGIN_LINK_OSS"/>softuerë të tjerë me burim të hapur<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Kjo faqe është bllokuar nga Browther</translation>
<translation id="1339376981847018870">Lejo Browther të qaset në rrjet, në cilësimet e murit mbrojtës ose
      të antivirusit.</translation>
<translation id="4949828774841497663">Shko te Aplikacionet &gt; Cilësimet e sistemit &gt; Rrjeti, zgjidh
          rrjetin aktiv, kliko te butoni "Detajet..." , dhe hiq përzgjedhjen e çdo proxy
          që mund të jetë zgjedhur.</translation>
<translation id="4191403906356422893">Shko te
          menyja e Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Rrjeti dhe interneti &gt; Proxy
          dhe anulo zgjedhjen e "Zbulo automatikisht cilësimet".</translation>
<translation id="958169674889932546">Këto faqe synohen të përdoren nga zhvilluesit e Browther dhe mund të mos mirëmbahen apo testohen në mënyrë aktive. Për t'i aktivizuar ato, navigo te <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliko butonin për të aktivizuar faqet e korrigjimit dhe më pas navigo përsëri te kjo faqe.</translation>
<translation id="4303967029316005584">Browther është mundësuar po ashtu nga <ph name="BEGIN_LINK_OSS"/>softuerë të tjerë me burim të hapur<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Ndryshimet e tua do të hyjnë në fuqi herën tjetër kur të rinisësh Browther.</translation>
<translation id="221029295134825758">Browther i nevojitet leje te Bluetooth-i për të vazhduar me çiftimin. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther është mundësuar nga projekti me burim të hapur <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Shko te
          menyja e Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          dhe anulo zgjedhjen e "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Nëse kjo nuk e zgjidh këtë problem, rekomandojmë ta zgjedhësh përsëri këtë opsion
          për një veprimtari më të mirë funksionimi.</translation>
<translation id="8927199829149811571">Po shikon një faqe të sigurt të Browther for Testing</translation>
<translation id="4220066730874343807">Browther nuk u mbyll si duhet.</translation>
</translationbundle>