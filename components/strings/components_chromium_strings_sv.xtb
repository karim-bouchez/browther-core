<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sv">
<translation id="130631256467250065">Dina ändringar börjar gälla nästa gång du startar om enheten.</translation>
<translation id="5681560603157873402">Öppna Browther-menyn &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          och se till att konfigurationen är inställd på ingen proxy eller direkt.</translation>
<translation id="4903497818305945122">Felrapportering är inte tillgängligt i Browther.</translation>
<translation id="5747951541048369241">Du visar en säker Browther-sida</translation>
<translation id="7041193161756628041">Browther försöker ändra inställningarna för att fylla i betalningsmetoder.</translation>
<translation id="4670277172953498174">Browther-logotyp</translation>
<translation id="3474898875907708105">Browther försöker redigera betalningsmetoder.</translation>
<translation id="5700544173546684818">Browther finns tack vare projektet <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> med öppen källkod och <ph name="BEGIN_LINK_OSS"/>andra program med öppen källkod<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Den här sidan har blockerats av Browther</translation>
<translation id="1339376981847018870">Tillåt att Browther får åtkomst till nätverket i inställningarna för brandväggen eller
        antivirusprogrammet.</translation>
<translation id="4949828774841497663">Öppna Program &gt; Systeminställningar &gt; Nätverk, välj det
          aktiva nätverket, klicka på knappen Information … och avmarkera
          eventuella proxyservrar.</translation>
<translation id="4191403906356422893">Öppna
          Browther-menyn &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Nätverk och internet &gt; Proxy
          och avmarkera Upptäck inställningar automatiskt.</translation>
<translation id="958169674889932546">Dessa sidor är avsedda för Browther-utvecklare och kanske inte underhålls eller testas aktivt. Om du vill aktivera dem navigerar du till <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klickar på knappen för att aktivera felsökningssidor och navigerar sedan till den här sidan igen.</translation>
<translation id="4303967029316005584">Browther möjliggörs även av andra <ph name="BEGIN_LINK_OSS"/>program med öppen källkod<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Ändringarna tillämpas nästa gång du startar om Browther.</translation>
<translation id="221029295134825758">Browther behöver åtkomst för Bluetooth för att fortsätta 
 parkoppla. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther finns tack vare det öppna källkodsprojektet <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Öppna
        Browther-menyn &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        och avmarkera <ph name="NO_PREFETCH_DESCRIPTION"/>.
        Om det inte hjälper rekommenderar vi att du markerar det
        här alternativet igen så att funktionaliteten förbättras.</translation>
<translation id="8927199829149811571">Du visar en säker Browther for Testing-sida</translation>
<translation id="4220066730874343807">Browther stängdes inte ordentligt.</translation>
</translationbundle>