<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sr-Latn">
<translation id="130631256467250065">Promene će stupiti na snagu kada sledeći put ponovo pokrenete uređaj.</translation>
<translation id="5681560603157873402">Idite u
          Browther meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          i proverite da li je konfiguracija podešena na „no proxy“ (bez proksija) ili „direct“ (direktno).</translation>
<translation id="4903497818305945122">Izveštavanje o otkazivanjima nije dostupno u Browther-u.</translation>
<translation id="5747951541048369241">Gledate bezbednu Browther stranicu.</translation>
<translation id="7041193161756628041">Browther pokušava da izmeni podešavanja za popunjavanje načina plaćanja.</translation>
<translation id="4670277172953498174">Browther logotip</translation>
<translation id="3474898875907708105">Browther pokušava da izmeni načine plaćanja.</translation>
<translation id="5700544173546684818">Browther omogućavaju <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> projekat otvorenog koda i drugi <ph name="BEGIN_LINK_OSS"/>softver otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Browther blokira ovu stranicu</translation>
<translation id="1339376981847018870">Dozvolite Browther-u da pristupa mreži u zaštitnom zidu ili antivirusnim
          podešavanjima.</translation>
<translation id="4949828774841497663">Idite u Applications (Aplikacije) &gt; System Settings (Podešavanja sistema) &gt; Network (Mreža), pa izaberite
          aktivnu mrežu, kliknite na dugme Details... (Detalji), a zatim poništite izbor svih proksija
          koji su izabrani.</translation>
<translation id="4191403906356422893">Idite u
          Browther meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mreža i internet &gt; Proksi
          i poništite izbor opcije Automatski otkrij podešavanja.</translation>
<translation id="958169674889932546">Ove stranice su namenjene programerima Browther-a i možda se ne održavaju niti testiraju aktivno. Da biste ih omogućili, idite na <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknite na dugme da biste omogućili stranice za otklanjanje grešaka, pa ponovo idite na ovu stranicu.</translation>
<translation id="4303967029316005584">Browther omogućava i drugi <ph name="BEGIN_LINK_OSS"/>softver otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Promene će stupiti na snagu kada sledeći put ponovo pokrenete Browther.</translation>
<translation id="221029295134825758">Browther zahteva pristup Bluetooth-u radi nastavljanja sa 
 uparivanjem. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther omogućava <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> projekat otvorenog koda.</translation>
<translation id="3134645574591615830">Otvorite
          Browther meni &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          i opozovite izbor opcije „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
          Ako vam to ne reši problem, preporučujemo da ponovo izaberete
          ovu opciju radi boljih performansi.</translation>
<translation id="8927199829149811571">Pregledate bezbednu Browther for Testing stranicu</translation>
<translation id="4220066730874343807">Browther se nije ispravno zatvorio.</translation>
</translationbundle>