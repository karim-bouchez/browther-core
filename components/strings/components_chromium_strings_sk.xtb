<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="sk">
<translation id="130631256467250065">Zmeny sa prejavia po ďalšom reštartovaní zariadenia.</translation>
<translation id="5681560603157873402">Prejdite do
          ponuky prehliadača Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          a uistite sa, že máte konfiguráciu nastavenú na hodnotu „žiaden proxy server“ alebo „priame“.</translation>
<translation id="4903497818305945122">Správy o zlyhaní nie sú v prehliadači Browther k dispozícii.</translation>
<translation id="5747951541048369241">Prezeráte si zabezpečenú stránku prehliadača Browther</translation>
<translation id="7041193161756628041">Browther sa pokúša upraviť nastavenia vypĺňania spôsobov platby.</translation>
<translation id="4670277172953498174">Logo prehliadača Browther</translation>
<translation id="3474898875907708105">Browther sa pokúša upraviť spôsoby platby.</translation>
<translation id="5700544173546684818">Prehliadač Browther mohol vzniknúť vďaka projektu s otvoreným zdrojom <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> a ďalšiemu <ph name="BEGIN_LINK_OSS"/>softvéru s otvoreným zdrojom<ph name="END_LINK_OSS"/> .</translation>
<translation id="8935269788853634726">Táto stránka bola zablokovaná prehliadačom Browther</translation>
<translation id="1339376981847018870">Prehliadaču Browther povoľte prístup k sieti v nastaveniach brány firewall alebo antivírusového softvéru.</translation>
<translation id="4949828774841497663">Prejdite do sekcie Aplikácie &gt; Nastavenia systému &gt; Sieť, vyberte aktívnu sieť, kliknite na tlačidlo Podrobnosti… a zrušte výber všetkých vybraných proxy serverov.</translation>
<translation id="4191403906356422893">Prejdite do
          ponuky prehliadača Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Sieť a internet &gt; Proxy server a zrušte výber možnosti Automaticky zisťovať nastavenia.</translation>
<translation id="958169674889932546">Tieto stránky môžu používať vývojári prehliadača Browther a nemusia byť aktívne udržiavané ani testované. Ak ich chcete povoliť, prejdite na <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknutím na tlačidlo povoľte stránky ladenia a potom sa vráťte na túto stránku.</translation>
<translation id="4303967029316005584">Prehliadač Browther je založený aj na inom <ph name="BEGIN_LINK_OSS"/>softvéri open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Zmeny sa prejavia pri nasledujúcom reštartovaní prehliadača Browther.</translation>
<translation id="221029295134825758">Prehliadač Browther potrebuje prístup k rozhraniu Bluetooth, aby mohol pokračovať 
 v párovaní. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Prehliadač Browther je založený na projekte open source <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Prejdite do
        ponuky Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        a zrušte výber položky <ph name="NO_PREFETCH_DESCRIPTION"/>.
        Ak to problém nevyrieši, odporúčame túto možnosť vybrať,
        aby ste získali lepšiu výkonnosť.</translation>
<translation id="8927199829149811571">Prezeráte si zabezpečenú stránku Browther for Testing</translation>
<translation id="4220066730874343807">Browther nebol správne vypnutý.</translation>
</translationbundle>