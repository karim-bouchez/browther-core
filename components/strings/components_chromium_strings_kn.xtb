<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kn">
<translation id="130631256467250065">ನಿಮ್ಮ ಸಾಧನವನ್ನು ನೀವು ಮುಂದಿನ ಬಾರಿ ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="5681560603157873402">Browther ಮೆನುಗೆ ಹೋಗಿ &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ಮತ್ತು ನಿಮ್ಮ ಕಾನ್ಫಿಗರೇಶನ್ ಅನ್ನು "ಪ್ರಾಕ್ಸಿ ಇಲ್ಲ" ಅಥವಾ "ನೇರ" ಎಂಬುದಾಗಿ ಸೆಟ್ ಮಾಡಲಾಗಿದೆ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ.</translation>
<translation id="4903497818305945122">Browther ನಲ್ಲಿ ಕ್ರ್ಯಾಶ್ ವರದಿ ಮಾಡುವಿಕೆ ಲಭ್ಯವಿಲ್ಲ.</translation>
<translation id="5747951541048369241">ನೀವು ಸುರಕ್ಷಿತ Browther ಪುಟವನ್ನು ವೀಕ್ಷಿಸುತ್ತಿರುವಿರಿ</translation>
<translation id="7041193161756628041">ಪಾವತಿ ವಿಧಾನಗಳನ್ನು ಭರ್ತಿ ಮಾಡಲು Browther ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಮಾರ್ಪಡಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ.</translation>
<translation id="4670277172953498174">Browther ಲೋಗೋ</translation>
<translation id="3474898875907708105">ಪಾವತಿ ವಿಧಾನಗಳನ್ನು ಎಡಿಟ್ ಮಾಡಲು Browther ಪ್ರಯತ್ನಿಸುತ್ತಿದೆ.</translation>
<translation id="5700544173546684818"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ಓಪನ್ ಸೋರ್ಸ್ ಯೋಜನೆ ಮತ್ತು ಇತರ <ph name="BEGIN_LINK_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_OSS"/> ನಿಂದ Browther ಅನ್ನು ಮಾಡಲು ಸಾಧ್ಯ.</translation>
<translation id="8935269788853634726">Browther ನಿಂದ ಈ ಪುಟವನ್ನು ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ</translation>
<translation id="1339376981847018870">ನಿಮ್ಮ ಫೈರ್‌ವಾಲ್ ಮತ್ತು ಆಂಟಿವೈರಸ್ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ನೆಟ್‌ವರ್ಕ್ ಪ್ರವೇಶಿಸಲು
        Browther ಗೆ ಅನುಮತಿಸಿ.</translation>
<translation id="4949828774841497663">ಅಪ್ಲಿಕೇಶನ್‌ಗಳು &gt; ಸಿಸ್ಟಂ ಸೆಟ್ಟಿಂಗ್‌ಗಳು &gt; ನೆಟ್‌ವರ್ಕ್ ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ, ಸಕ್ರಿಯ ನೆಟ್‌ವರ್ಕ್ ಅನ್ನು ಆಯ್ಕೆ ಮಾಡಿ, ವಿವರಗಳು... ಬಟನ್ ಅನ್ನು ಕ್ಲಿಕ್ ಮಾಡಿ ಮತ್ತು ಆಯ್ಕೆ ಮಾಡಿರಬಹುದಾದ ಯಾವುದೇ ಪ್ರಾಕ್ಸಿಗಳ ಆಯ್ಕೆಯನ್ನು ರದ್ದುಗೊಳಿಸಿ.</translation>
<translation id="4191403906356422893">Browther ಮೆನು &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          ನೆಟ್‌ವರ್ಕ್ ಮತ್ತು ಇಂಟರ್ನೆಟ್ &gt; ಪ್ರಾಕ್ಸಿ
ಎಂಬಲ್ಲಿಗೆ ಹೋಗಿ ಮತ್ತು "ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಪತ್ತೆ ಮಾಡಿ" ಎಂಬುದರ ಆಯ್ಕೆ ರದ್ದುಮಾಡಿ</translation>
<translation id="958169674889932546">ಈ ಪುಟಗಳು Browther ಡೆವಲಪರ್‌ಗಳ ಬಳಕೆಗಾಗಿ ಉದ್ದೇಶಿಸಲಾಗಿದೆ ಮತ್ತು ಅವುಗಳನ್ನು ಸಕ್ರಿಯವಾಗಿ ನಿರ್ವಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಪರೀಕ್ಷಿಸಲಾಗುವುದಿಲ್ಲ. ಅವುಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು, <ph name="BEGIN_LINK"/> chrome://chrome-urls<ph name="LINK_END"/> ಗೆ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ, ಡೀಬಗ್ ಪುಟಗಳನ್ನು ಸಕ್ರಿಯಗೊಳಿಸಲು ಬಟನ್ ಕ್ಲಿಕ್ ಮಾಡಿ, ತದನಂತರ ಈ ಪುಟಕ್ಕೆ ಪುನಃ ನ್ಯಾವಿಗೇಟ್ ಮಾಡಿ.</translation>
<translation id="4303967029316005584">ಇತರ <ph name="BEGIN_LINK_OSS"/>ಓಪನ್ ಸೋರ್ಸ್ ಸಾಫ್ಟ್‌ವೇರ್<ph name="END_LINK_OSS"/> ನಿಂದ Browther ಅನ್ನು ಸಾಕಾರಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="8031938899816118394">ನೀವು ಮುಂದಿನ ಬಾರಿ Browther ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿದಾಗ ನಿಮ್ಮ ಬದಲಾವಣೆಗಳು ಕಾರ್ಯಗತಗೊಳ್ಳುತ್ತವೆ.</translation>
<translation id="221029295134825758">ಜೋಡಣೆಯನ್ನು ಮುಂದುವರಿಸಲು Browther ಗೆ ಬ್ಲೂಟೂತ್ ಪ್ರವೇಶದ ಅಗತ್ಯವಿದೆ. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ಓಪನ್ ಸೋರ್ಸ್ ಪ್ರಾಜೆಕ್ಟ್‌ನಿಂದ Browther ಅನ್ನು ಸಾಕಾರಗೊಳಿಸಲಾಗಿದೆ.</translation>
<translation id="3134645574591615830">ಇದಕ್ಕೆ ಹೋಗಿ
        Browther ಮೆನು &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ಮತ್ತು "<ph name="NO_PREFETCH_DESCRIPTION"/>" ಆಯ್ಕೆ ರದ್ದುಮಾಡಿ.
        ಒಂದು ವೇಳೆ ಇದು ಈ ಸಮಸ್ಯೆಯನ್ನು ಪರಿಹರಿಸದಿದ್ದರೆ, ಸುಧಾರಿತ ಕಾರ್ಯಾಚರಣೆಗಾಗಿ ಮತ್ತೊಮ್ಮೆ
        ಈ ಆಯ್ಕೆಯನ್ನು ಆಯ್ಕೆ ಮಾಡುವಂತೆ ನಾವು ಶಿಫಾರಸು ಮಾಡುತ್ತೇವೆ.</translation>
<translation id="8927199829149811571">ನೀವು ಸುರಕ್ಷಿತ Browther for Testing ಪುಟವನ್ನು ವೀಕ್ಷಿಸುತ್ತಿದ್ದೀರಿ</translation>
<translation id="4220066730874343807">Browther ಅನ್ನು ಸರಿಯಾಗಿ ಸ್ಥಗಿತಗೊಳಿಸಲಾಗಿಲ್ಲ.</translation>
</translationbundle>