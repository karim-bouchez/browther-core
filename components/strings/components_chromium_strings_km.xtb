<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="130631256467250065">ការប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលអ្នកចាប់ផ្តើមឧបករណ៍របស់អ្នកឡើងវិញពេលបន្ទាប់។</translation>
<translation id="5681560603157873402">ចូល​ទៅកាន់​ម៉ឺនុយ Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          ហើយ​ត្រូវប្រាកដថា​ការកំណត់រចនាសម្ព័ន្ធ​របស់អ្នក​ត្រូវបាន​កំណត់ទៅ "គ្មាន​ប្រូកស៊ី" ឬ "ដោយផ្ទាល់"។</translation>
<translation id="4903497818305945122">ការរាយការណ៍ពីការគាំងមិនមាននៅក្នុង Browther ទេ។</translation>
<translation id="5747951541048369241">អ្នក​កំពុង​មើល​ទំព័រ Browther ដែល​មាន​សុវត្ថិភាព</translation>
<translation id="7041193161756628041">Browther កំពុងព្យាយាម​កែប្រែ​ការកំណត់​សម្រាប់​ការបំពេញ​វិធីបង់ប្រាក់។</translation>
<translation id="4670277172953498174">និមិត្តសញ្ញា Browther</translation>
<translation id="3474898875907708105">Browther កំពុង​ព្យាយាម​កែ​វិធីបង់ប្រាក់។</translation>
<translation id="5700544173546684818">Browther អាចបង្កើតឡើងបានដោយគម្រោងប្រភពបើកចំហរ <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> និង <ph name="BEGIN_LINK_OSS"/>កម្មវិធីប្រភពបើកចំហរ<ph name="END_LINK_OSS"/> ផ្សេងទៀត។</translation>
<translation id="8935269788853634726">ទំព័រនេះត្រូវបានទប់ស្កាត់ដោយ Browther</translation>
<translation id="1339376981847018870">អនុញ្ញាតឲ្យ Browther ចូលប្រើបណ្តាញនៅក្នុងការកំណត់ firewall ឬកម្មវិធីកម្ចាត់មេរោគ
        របស់អ្នក។</translation>
<translation id="4949828774841497663">ចូល​ទៅកាន់ កម្មវិធី &gt; ការកំណត់​ប្រព័ន្ធ &gt; បណ្ដាញ ជ្រើសរើស​បណ្តាញ​ដែលកំពុង​ដំណើរការ ចុច​ប៊ូតុង​ព័ត៌មានលម្អិត រួច​ដក​ការ​ជ្រើសរើស​ប្រូកស៊ីដែលអាច​ត្រូវបាន​ជ្រើសរើស។</translation>
<translation id="4191403906356422893">ចូលទៅកាន់​ម៉ឺនុយ Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          បណ្ដាញ និង​អ៊ីនធឺណិត &gt; ប្រូកស៊ី
          ហើយ​ដក​ការ​ជ្រើសរើស "ចាប់ដឹងការកំណត់​ដោយ​ស្វ័យប្រវត្តិ"។</translation>
<translation id="958169674889932546">ទំព័រ​ទាំងនេះ​គឺសម្រាប់ប្រើ​ដោយ​អ្នក​អភិវឌ្ឍន៍ Browther និង​ប្រហែលជា​មិនត្រូវបាន​ថែទាំ ឬ​ធ្វើតេស្ត​យ៉ាងសកម្ម​នោះទេ។ ដើម្បី​បើក​ទំព័រ​ទាំងនេះ សូម​ទៅកាន់ <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, ចុចប៊ូតុង ដើម្បីបើក​ទំព័រ​ជួសជុល បន្ទាប់មក​ទៅកាន់​ទំព័រនេះ​ម្ដងទៀត។</translation>
<translation id="4303967029316005584">Browther អាច​បង្កើត​ឡើង​បាន​ដោយ<ph name="BEGIN_LINK_OSS"/>កម្មវិធីកូដ​ចំហ<ph name="END_LINK_OSS"/>ផ្សេង​ទៀត​ផងដែរ។</translation>
<translation id="8031938899816118394">ការផ្លាស់ប្តូររបស់អ្នកនឹងមានប្រសិទ្ធភាពនៅពេលដែលបើកដំណើរការ Browther ឡើងវិញពេលក្រោយ។</translation>
<translation id="221029295134825758">Browther ត្រូវការសិទ្ធិ​ចូលប្រើប៊្លូធូស ដើម្បីបន្ត
ផ្គូផ្គង។ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther អាច​បង្កើត​ឡើង​បាន​ដោយគម្រោងកូដ​ចំហ <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>។</translation>
<translation id="3134645574591615830">ទៅកាន់
        ម៉ឺនុយ Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ហើយ ដកការជ្រើសរើស "<ph name="NO_PREFETCH_DESCRIPTION"/>."
        ប្រសិនបើវាមិនដោះស្រាយបញ្ហានេះ យើងអាចណែនាំការជ្រើសរើសជម្រើសនេះ
        ម្តងទៀតសម្រាប់ប្រតិបត្តិការដែលបានធ្វើឲ្យប្រសើរឡើង។</translation>
<translation id="8927199829149811571">អ្នកកំពុងមើលទំព័រ Browther for Testing ដែលមានសុវត្ថិភាព</translation>
<translation id="4220066730874343807">Browther មិនបានបិទត្រឹមត្រូវទេ។</translation>
</translationbundle>