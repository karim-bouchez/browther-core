<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="zu">
<translation id="130631256467250065">Izinguquko zakho zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha idivayisi yakho.</translation>
<translation id="5681560603157873402">Iya
          kumenyu yeBrave &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          bese uqinisekisa ukuthi izilungiselelo zakho zisethwe kokuthi "angabibikho ummeleli" noma "okuqondile."</translation>
<translation id="4903497818305945122">Ukubika kokuphahlazeka akutholakali ku-Browther.</translation>
<translation id="5747951541048369241">Ubuka ikhasi le-Browther eliphephile</translation>
<translation id="7041193161756628041">I-Browther izama ukulungisa amasethingi okugcwalisa izindlela zokukhokha.</translation>
<translation id="4670277172953498174">Ilogo ye-Browther</translation>
<translation id="3474898875907708105">I-Browther izama ukuhlela izindlela zokukhokha.</translation>
<translation id="5700544173546684818">I-Browther yenziwa ukuthi ibe khona yi-<ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> iphrojekthi yomthombo ovulekile kanye nenye <ph name="BEGIN_LINK_OSS"/>isofthiwe yomthombo ovulekile<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Leli khasi livinjwe yi-Browther</translation>
<translation id="1339376981847018870">Vumela i-Browther ukufinyelela inethiwekhi kuzilungiselelo zakho zohlelo lokuvikela noma isilwi magciwane.</translation>
<translation id="4949828774841497663">Iya kuma-Application &gt; Amasethingi Ohlelo &gt; Inethiwekhi, khetha
          inethiwekhi esebenzayo, chofoza inkinobho ethi Imininingwane..., bese uyeka ukukhetha noma yibaphi abameleli
          okungenzeka ukuthi bakhethiwe.</translation>
<translation id="4191403906356422893">Iya
          kumenyu yeBrave &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Inethiwekhi ne-inthanethi &gt; Ummeleli
          bese ususa ukukhetha kokuthi "Thola amasethingi ngokuzenzekelayo".</translation>
<translation id="958169674889932546">Lawa makhasi enzelwe ukusetshenziswa onjiniyela beBrave, futhi kungenzeka anganakekelwa noma ahlolwe. Ukuze uzinike amandla, funa kokuthi <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, chofoza inkinobho ukuze unike amandla amakhasi okususa iphutha, bese ufuna kuleli khasi futhi.</translation>
<translation id="4303967029316005584">I-Browther iphinda yenziwe enye <ph name="BEGIN_LINK_OSS"/>isofthiwe yomthombo ovulekile<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Izinguquko zakho zizosebenza ngesikhathi esilandelayo uma uqalisa kabusha i-Browther.</translation>
<translation id="221029295134825758">I-Browther idinga ukufinyelela kwe-Bluetooth ukuze iqhubeke 
 nokumatanisa. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">I-Browther yenziwe yenzeke iphrojekthi yomthombo ovulekile we-<ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Hamba
        kumenyu ye-Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        uphinde uyekise ukukhetha i-"<ph name="NO_PREFETCH_DESCRIPTION"/>."
        Uma ngabe lokhu kungaxazululi inkinga, sincoma ukuphinda ukhethe le nketho  ukuze uthole ukusebenza okuthuthukisiwe.</translation>
<translation id="8927199829149811571">Ubuka ikhasi elivikelekile le-Browther Yokuhlola</translation>
<translation id="4220066730874343807">I-Browther ayizange ivaleke ngokulungile.</translation>
</translationbundle>