<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="130631256467250065">השינויים ייכנסו לתוקף בפעם הבאה שהמכשיר יופעל מחדש.</translation>
<translation id="5681560603157873402">‏צריך להיכנס אל
          תפריט Browther‏ &gt;
          <ph name="SETTINGS_TITLE"/>
          ‏&gt;
          <ph name="SYSTEM_TITLE"/>
          ‏&gt;
          <ph name="PROXIES_TITLE"/>
          ולבדוק שהתצורה מוגדרת לאפשרות no proxy (ללא שרת proxy‏) או direct (ישיר).</translation>
<translation id="4903497818305945122">‏דיווח על התרסקויות אינו זמין ב-Browther.</translation>
<translation id="5747951541048369241">‏זהו דף מאובטח של Browther</translation>
<translation id="7041193161756628041">‏Browther מנסה לשנות את ההגדרות למילוי אמצעי התשלום.</translation>
<translation id="4670277172953498174">‏לוגו של Browther</translation>
<translation id="3474898875907708105">‏Browther מנסה לערוך את אמצעי התשלום.</translation>
<translation id="5700544173546684818">‏Browther קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM"/> Browther‏<ph name="END_LINK_CHROMIUM"/> ו<ph name="BEGIN_LINK_OSS"/>תוכנות קוד פתוח<ph name="END_LINK_OSS"/> אחרות.</translation>
<translation id="8935269788853634726">‏הדף הזה נחסם על ידי Browther</translation>
<translation id="1339376981847018870">‏שינוי הגדרות חומת האש או האנטי-וירוס כדי לאפשר ל-Browther
          לגשת לרשת.</translation>
<translation id="4949828774841497663">‏עוברים אל "אפליקציות" &gt; "הגדרות המערכת" &gt; "רשת", ובוחרים את
          הרשת הפעילה, לוחצים על הכפתור "פרטים…" ומבטלים את הבחירה בכל שרתי ה-proxy
          שנבחרו.</translation>
<translation id="4191403906356422893">‏צריך להיכנס אל
          תפריט Browther‏ &gt;
          <ph name="SETTINGS_TITLE"/>
          ‏&gt;
          <ph name="SYSTEM_TITLE"/>
          ‏&gt;
          <ph name="PROXIES_TITLE"/>
          ‏&gt;
          Network &amp; internet (רשת ואינטרנט) &gt; Proxy (שרת proxy)
          ולבטל את הבחירה באפשרות Automatically detect settings (זיהוי אוטומטי של ההגדרות).</translation>
<translation id="958169674889932546">‏הדפים האלה מיועדים למפתחי Browther. יכול להיות שהם לא מתוחזקים או נבדקים באופן פעיל. כדי להפעיל אותם, עוברים לכתובת <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, לוחצים על הכפתור כדי להפעיל את מצב ניפוי הבאגים בדפים, ואז מנווטים בחזרה לדף הזה.</translation>
<translation id="4303967029316005584">‏Browther קיים גם הודות ל<ph name="BEGIN_LINK_OSS"/>תוכנת קוד פתוח<ph name="END_LINK_OSS"/> אחרת.</translation>
<translation id="8031938899816118394">‏השינויים שביצעת ייכנסו לתוקף בפעם הבאה שתפעיל מחדש את Browther‏.</translation>
<translation id="221029295134825758">‏ל-Browther נדרשת גישה ל-Bluetooth כדי להמשיך 
 את ההתאמה. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">‏Browther קיים הודות לפרויקט הקוד הפתוח של <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">‏יש להיכנס אל
        תפריט Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        ולבטל את הבחירה באפשרות '<ph name="NO_PREFETCH_DESCRIPTION"/>'.
        אם פעולה זו אינה פותרת את הבעיה, מומלץ לבחור שוב באפשרות זו
        לקבלת ביצועים משופרים.</translation>
<translation id="8927199829149811571">‏זהו דף מאובטח של Browther for Testing</translation>
<translation id="4220066730874343807">‏כיבוי Browther לא בוצע כהלכה.</translation>
</translationbundle>