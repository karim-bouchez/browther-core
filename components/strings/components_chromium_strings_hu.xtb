<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hu">
<translation id="130631256467250065">A módosítások az eszköz következő újraindításakor lépnek életbe.</translation>
<translation id="5681560603157873402">Lépjen ide:
          Browther menü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>,
          és gondoskodjon róla, hogy a konfiguráció beállítása „nincs proxy” vagy „közvetlen” legyen.</translation>
<translation id="4903497818305945122">A hibajelentések nem állnak rendelkezésre a Braveban.</translation>
<translation id="5747951541048369241">Jelenleg biztonságos Browther-oldalt tekint meg</translation>
<translation id="7041193161756628041">A Browther módosítani próbálja a fizetési módok kitöltési beállításait.</translation>
<translation id="4670277172953498174">Browther embléma</translation>
<translation id="3474898875907708105">A Browther szerkeszteni próbálja a fizetési módokat.</translation>
<translation id="5700544173546684818">A Browther a <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> nyílt forráskódú projektnek és további <ph name="BEGIN_LINK_OSS"/>nyílt forráskódú szoftvereknek<ph name="END_LINK_OSS"/> köszönhetően jött létre.</translation>
<translation id="8935269788853634726">Ezt az oldalt a Browther blokkolja</translation>
<translation id="1339376981847018870">A hálózat elérésének engedélyezése a Browther számára a tűzfal-
          vagy vírusirtó-beállításokban.</translation>
<translation id="4949828774841497663">Lépjen az Alkalmazások &gt; Rendszerbeállítások &gt; Hálózat menüpontra,
          válassza ki az aktív hálózatot, kattintson a Részletek… gombra, és szüntesse meg
          a kiválasztott proxyk kijelölését.</translation>
<translation id="4191403906356422893">Lépjen ide:
          Browther-menü &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Hálózat és internet &gt; Proxy,
          és szüntesse meg a „Beállítások automatikus észlelése” beállítás kijelölését.</translation>
<translation id="958169674889932546">Ezek az oldalak a Browther fejlesztői számára készültek, és előfordulhat, hogy nincsenek aktívan karbantartva vagy tesztelve. Az engedélyezésükhöz lépjen a <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> oldalra, kattintson a hibaelhárítási oldalak engedélyezéséhez tartozó gombra, majd lépjen ismét erre az oldalra.</translation>
<translation id="4303967029316005584">A Braveot létrejöttéhez más <ph name="BEGIN_LINK_OSS"/>nyílt forráskódú szoftverek<ph name="END_LINK_OSS"/> is hozzájárultak.</translation>
<translation id="8031938899816118394">Módosításai a Browther újraindítása után lépnek érvénybe.</translation>
<translation id="221029295134825758">A Bravenak Bluetooth-hozzáférésre van szükséges a párosítás 
 folytatásához. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">A Browther a <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> nyílt forráskódú projektnek köszönhetően jött létre.</translation>
<translation id="3134645574591615830">Lépjen ide:
        Browther menü &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>,
        és törölje a jelet a(z) „<ph name="NO_PREFETCH_DESCRIPTION"/>” jelölőnégyzetből.
        Ha ettől nem szűnik meg a probléma, javasoljuk, hogy jelölje be ismét ezt a lehetőséget a jobb teljesítmény érdekében.</translation>
<translation id="8927199829149811571">Jelenleg biztonságos Browther for Testing-oldalt tekint meg.</translation>
<translation id="4220066730874343807">A Browther nem záródott be megfelelően.</translation>
</translationbundle>