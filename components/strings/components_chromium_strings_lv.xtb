<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="lv">
<translation id="130631256467250065">Izmaiņas stāsies spēkā nākamajā reizē, kad restartēsiet ierīci.</translation>
<translation id="5681560603157873402">Pārejiet uz Browther izvēlni &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> un konfigurācijai iestatiet opciju “Bez starpniekservera” vai “Tiešs savienojums”.</translation>
<translation id="4903497818305945122">Avāriju pārskatu sūtīšana nav pieejama pārlūkā Browther.</translation>
<translation id="5747951541048369241">Jūs skatāt drošu Browther lapu.</translation>
<translation id="7041193161756628041">Pārlūkā Browther tiek mēģināts mainīt maksājuma veidu aizpildes iestatījumus.</translation>
<translation id="4670277172953498174">Browther logotips</translation>
<translation id="3474898875907708105">Pārlūkā Browther tiek mēģināts automātiski rediģēt maksājuma veidus.</translation>
<translation id="5700544173546684818">Browther ir kļuvis iespējams, pateicoties <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> atklātā pirmkoda projektam un citai <ph name="BEGIN_LINK_OSS"/>atklātā pirmkoda programmatūrai<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Šī lapa ir bloķēta pārlūkā Browther.</translation>
<translation id="1339376981847018870">Ugunsmūra vai antivīrusu programmas iestatījumu maiņa, lai atļautu pārlūkam Browther piekļūt tīklam.</translation>
<translation id="4949828774841497663">Pārejiet uz sadaļu Applications (Lietojumprogrammas) &gt; System Settings (Sistēmas iestatījumi) &gt; Network (Tīkls), atlasiet aktīvo tīklu, noklikšķiniet uz pogas “Details...” (Detalizēta informācija) un noņemiet atlasi visiem starpniekserveriem, kas, iespējams, ir atlasīti.</translation>
<translation id="4191403906356422893">Pārejiet uz Browther izvēlni &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Tīkls un internets &gt; Starpniekserveris un noņemiet atzīmi no izvēles rūtiņas “Automātiski noteikt iestatījumus”.</translation>
<translation id="958169674889932546">Šīs lapas ir paredzētas Browther izstrādātājiem, un tās var nebūt aktīvi uzturētas vai testētas. Lai tās iespējotu, pārejiet uz lapu <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, noklikšķiniet uz pogas, lai iespējotu atkļūdošanas lapas, un pēc tam atkal pārejiet uz šo lapu.</translation>
<translation id="4303967029316005584">Pārlūku Browther nodrošina arī cita <ph name="BEGIN_LINK_OSS"/>atklātā pirmkoda programmatūra<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Izmaiņas stāsies spēkā, kad restartēsiet Browther.</translation>
<translation id="221029295134825758">Pārlūkam Browther ir nepieciešama Bluetooth piekļuve, lai turpinātu savienošanu pārī. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Pārlūku Browther nodrošina <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> atklātā pirmkoda projekts.</translation>
<translation id="3134645574591615830">Atveriet
        Browther izvēlni &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        un noņemiet atzīmi no izvēles rūtiņas “<ph name="NO_PREFETCH_DESCRIPTION"/>”.
        Ja problēmu neizdodas novērst, ieteicams atkal atlasīt šo opciju,
        lai uzlabotu veiktspēju.</translation>
<translation id="8927199829149811571">Jūs skatāt drošu pārlūka Browther for Testing lapu</translation>
<translation id="4220066730874343807">Browther netika pareizi izslēgts.</translation>
</translationbundle>