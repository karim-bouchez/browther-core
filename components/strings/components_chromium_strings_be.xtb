<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="be">
<translation id="130631256467250065">Змены ўступяць у сілу пасля наступнага перазапуску прылады.</translation>
<translation id="5681560603157873402">Перайдзіце ў меню Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> і ўпэўніцеся, што ў канфігурацыі выбрана падключэнне без проксі-сервера або напрамую.</translation>
<translation id="4903497818305945122">Справаздачы аб збоях у браўзеры Browther недаступныя.</translation>
<translation id="5747951541048369241">Вы праглядаеце бяспечную старонку Browther</translation>
<translation id="7041193161756628041">Browther спрабуе замяніць налады запаўнення спосабаў аплаты.</translation>
<translation id="4670277172953498174">Лагатып Browther</translation>
<translation id="3474898875907708105">Browther спрабуе змяніць спосабы аплаты.</translation>
<translation id="5700544173546684818">Browther працуе дзякуючы праекту <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> з адкрытым зыходным кодам і іншаму <ph name="BEGIN_LINK_OSS"/>праграмнаму забеспячэнню з адкрытым зыходным кодам<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Старонка заблакіравана браўзерам Browther</translation>
<translation id="1339376981847018870">Дазвольце Browther доступ да сеткі ў наладах брандмаўэра або
         антывіруса.</translation>
<translation id="4949828774841497663">Перайдзіце ў меню "Праграмы &gt; Сістэмныя налады &gt; Сетка", выберыце актыўную сетку, націсніце кнопку "Падрабязныя звесткі…" і скасуйце выбар усіх проксі-сервераў (калі яны выбраны).</translation>
<translation id="4191403906356422893">Перайдзіце ў меню Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Сетка і інтэрнэт &gt; Проксі-сервер і скасуйце выбар пункта "Аўтаматычна выяўляць налады".</translation>
<translation id="958169674889932546">Гэтыя старонкі прызначаны для распрацоўшчыкаў Browther, таму іх тэхнічная падтрымка ці праверка могуць праводзіцца рэдка. Для ўключэння перайдзіце на старонку <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, націсніце кнопку, каб уключыць старонкі адладкі, і зноў вярніцеся на гэту старонку.</translation>
<translation id="4303967029316005584">Browther працуе ў тым ліку дзякуючы іншаму <ph name="BEGIN_LINK_OSS"/>праграмнаму забеспячэнню з адкрытым зыходным кодам<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Змены ўступяць у сілу пасля перазапуску Browther.</translation>
<translation id="221029295134825758">Каб працягнуць спалучэнне, Browther патрабуе доступу да Bluetooth. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther працуе дзякуючы праекту <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> з адкрытым зыходным кодам.</translation>
<translation id="3134645574591615830">Перайдзіце ў
          меню Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          і адмяніце выбар параметра "<ph name="NO_PREFETCH_DESCRIPTION"/>".
          Калі гэта не вырашыць праблему, рэкамендуем выбраць гэты
          параметр зноў, каб не пагоршылася прадукцыйнасць.</translation>
<translation id="8927199829149811571">Вы гледзіце абароненую старонку Browther for Testing</translation>
<translation id="4220066730874343807">Browther завяршыў працу некарэктна.</translation>
</translationbundle>