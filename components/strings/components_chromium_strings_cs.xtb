<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="cs">
<translation id="130631256467250065">Změny se projeví po příštím restartu zařízení.</translation>
<translation id="5681560603157873402">Přejděte do nabídky Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> a zajistěte, aby konfigurace byla nastavená na možnost „bez proxy“ nebo „přímé“.</translation>
<translation id="4903497818305945122">Hlášení o selhání není v prohlížeči Browther k dispozici.</translation>
<translation id="5747951541048369241">Prohlížíte si zabezpečenou stránku vygenerovanou prohlížečem Browther</translation>
<translation id="7041193161756628041">Browther se pokouší upravit nastavení vyplňování platebních metod.</translation>
<translation id="4670277172953498174">Logo Browther</translation>
<translation id="3474898875907708105">Browther se pokouší upravit platební metody.</translation>
<translation id="5700544173546684818">Browther staví na projektu s otevřeným zdrojovým kódem <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> a využívá i další <ph name="BEGIN_LINK_OSS"/>software s otevřeným zdrojovým kódem<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Tato stránka je blokována prohlížečem Browther</translation>
<translation id="1339376981847018870">V nastavení firewallu a antivirového programu povolte prohlížeči Browther přístup k síti.</translation>
<translation id="4949828774841497663">Přejděte do části Aplikace &gt; Nastavení systému &gt; Síť, vyberte aktivní síť, klikněte na tlačítko Podrobnosti… a zrušte výběr všech proxy serverů, které jsou vybrány.</translation>
<translation id="4191403906356422893">Přejděte do nabídky Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Síť a internet &gt; Proxy a zrušte výběr možnosti Automaticky zjišťovat nastavení.</translation>
<translation id="958169674889932546">Tyto stránky jsou určeny pro vývojáře prohlížeče Browther a nemusí být aktivně udržovány ani testovány. Pokud je chcete povolit, přejděte na adresu <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknutím na příslušné tlačítko povolte ladicí stránky a pak znovu přejděte na tuto stránku.</translation>
<translation id="4303967029316005584">Browther využívá také další <ph name="BEGIN_LINK_OSS"/>open source software<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Změny se projeví po příštím restartu prohlížeče Browther.</translation>
<translation id="221029295134825758">Browther potřebuje přístup k Bluetooth, aby bylo možné
 pokračovat v párování. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther staví na open source projektu <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Přejděte do nabídky Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="ADVANCED_TITLE"/> a zrušte výběr možnosti <ph name="NO_PREFETCH_DESCRIPTION"/>. Pokud to však problém nevyřeší, doporučujeme vám tuto možnost znovu vybrat (za účelem zlepšení výkonu).</translation>
<translation id="8927199829149811571">Prohlížíte si zabezpečenou stránku Browther for Testing</translation>
<translation id="4220066730874343807">Aplikace Browther nebyla řádně ukončena.</translation>
</translationbundle>