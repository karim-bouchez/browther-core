<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="vi">
<translation id="130631256467250065">Thay đổi của bạn sẽ có hiệu lực vào lần tiếp theo bạn khởi động lại thiết bị của mình.</translation>
<translation id="5681560603157873402">Chuyển đến
          trình đơn Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          và đảm bảo cấu hình của bạn được đặt thành "không có proxy" hoặc "trực tiếp".</translation>
<translation id="4903497818305945122">Báo cáo sự cố hiện không khả dụng trong Browther.</translation>
<translation id="5747951541048369241">Bạn đang xem trang Browther an toàn</translation>
<translation id="7041193161756628041">Browther đang cố gắng sửa đổi chế độ cài đặt cho việc điền phương thức thanh toán.</translation>
<translation id="4670277172953498174">Biểu trưng Browther</translation>
<translation id="3474898875907708105">Browther đang cố gắng chỉnh sửa phương thức thanh toán.</translation>
<translation id="5700544173546684818">Browther trở nên khả thi là nhờ dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> và các <ph name="BEGIN_LINK_OSS"/>phần mềm nguồn mở<ph name="END_LINK_OSS"/> khác.</translation>
<translation id="8935269788853634726">Trang này bị Browther chặn</translation>
<translation id="1339376981847018870">Cho phép Browther truy cập mạng trong cài đặt tường lửa hoặc diệt vi-rút 
        của bạn.</translation>
<translation id="4949828774841497663">Chuyển đến phần Ứng dụng &gt; Cài đặt hệ thống &gt; Mạng, chọn
          mạng đang hoạt động, nhấp vào nút Chi tiết..., rồi bỏ chọn mọi máy chủ proxy
          có thể đã được chọn.</translation>
<translation id="4191403906356422893">Chuyển đến
          trình đơn Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mạng và Internet &gt; Proxy
          rồi bỏ chọn "Tự động phát hiện chế độ cài đặt".</translation>
<translation id="958169674889932546">Các trang này dành cho nhà phát triển Browther sử dụng và có thể không được duy trì hoặc kiểm tra liên tục. Để kích hoạt các trang này, hãy chuyển đến <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, nhấp vào nút để kích hoạt trang gỡ lỗi, rồi chuyển đến trang này một lần nữa.</translation>
<translation id="4303967029316005584">Browther cũng được cung cấp thông qua <ph name="BEGIN_LINK_OSS"/>phần mềm nguồn mở<ph name="END_LINK_OSS"/> khác.</translation>
<translation id="8031938899816118394">Các thay đổi của bạn sẽ có hiệu lực vào lần tới khi bạn chạy lại Browther.</translation>
<translation id="221029295134825758">Browther cần có quyền truy cập Bluetooth để tiếp tục 
 ghép nối. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther được cung cấp thông qua dự án nguồn mở <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Chuyển đến
          menu Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          và bỏ chọn "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Nếu cách này không giải quyết được sự cố thì chúng tôi khuyên bạn nên chọn lại tùy chọn này
          để cải thiện hiệu suất.</translation>
<translation id="8927199829149811571">Bạn đang xem một trang Browther for Testing an toàn</translation>
<translation id="4220066730874343807">Browther không tắt đúng cách.</translation>
</translationbundle>