<!DOCTYPE translationbundle>
<translationbundle lang="es">
<translation id="130631256467250065">Los cambios se aplicarán la próxima vez que reinicies el dispositivo.</translation>
<translation id="5681560603157873402">Accede al menú de Browther, haz clic en <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> y asegúrate de que esté seleccionada la opción de configuración sin proxy o directa.</translation>
<translation id="4903497818305945122">Los informes de errores no se encuentran disponibles en Browther.</translation>
<translation id="5747951541048369241">Estás viendo una página de Browther segura</translation>
<translation id="7041193161756628041">Browther está intentando modificar la configuración para completar los métodos de pago.</translation>
<translation id="4670277172953498174">Logotipo de Browther</translation>
<translation id="3474898875907708105">Browther está intentando editar los métodos de pago.</translation>
<translation id="5700544173546684818">Browther se ha creado gracias al proyecto de software libre <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> y a otro <ph name="BEGIN_LINK_OSS"/>software libre<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Browther ha bloqueado esta página</translation>
<translation id="1339376981847018870">Configura tu cortafuegos o tu antivirus para permitir el acceso de Browther
          a la red.</translation>
<translation id="4949828774841497663">Ve a Aplicaciones &gt; Ajustes del sistema &gt; Red, selecciona la red activa, haz clic en el botón Detalles... y desmarca los proxies que puedan estar seleccionados.</translation>
<translation id="4191403906356422893">Ve al menú de Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Red e Internet &gt; Proxy y desmarca la opción Detectar configuración automáticamente.</translation>
<translation id="958169674889932546">Estas páginas están pensadas para que las usen los desarrolladores de Browther y es posible que no se mantengan ni se prueben activamente. Para habilitarlas, ve a <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, haz clic en el botón para habilitar las páginas de depuración y vuelve a esta página.</translation>
<translation id="4303967029316005584">Browther también se ha podido crear gracias a otro <ph name="BEGIN_LINK_OSS"/>software libre<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Los cambios se aplicarán la próxima vez que reinicies Browther.</translation>
<translation id="221029295134825758">Browther necesita acceso al Bluetooth para continuar 
 con la vinculación. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther se ha podido crear gracias al proyecto de software libre <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Accede al
          menú de Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          y desactiva la opción "<ph name="NO_PREFETCH_DESCRIPTION"/>".
          Si esto no soluciona el problema, te recomendamos que vuelvas a seleccionar esta opción
          para conseguir un mejor rendimiento.</translation>
<translation id="8927199829149811571">Estás viendo una página segura de Browther for Testing</translation>
<translation id="4220066730874343807">Browther no se ha cerrado correctamente.</translation>
</translationbundle>