<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="no">
<translation id="130631256467250065">Endringene trer i kraft neste gang du starter enheten på nytt.</translation>
<translation id="5681560603157873402">Gå til
          Browther-menyen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          og sørg for at konfigurasjonen din er angitt til «ingen mellomtjener» eller «direkte».</translation>
<translation id="4903497818305945122">Krasjrapportering er ikke tilgjengelig i Browther.</translation>
<translation id="5747951541048369241">Du ser på en sikker Browther-side</translation>
<translation id="7041193161756628041">Browther prøver å endre innstillingene for utfylling av betalingsmåter.</translation>
<translation id="4670277172953498174">Browther-logo</translation>
<translation id="3474898875907708105">Browther prøver å redigere betalingsmåter.</translation>
<translation id="5700544173546684818">Browther er gjort mulig av åpen kilde-prosjektet <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> og annen <ph name="BEGIN_LINK_OSS"/>åpen kilde-programvare<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Denne siden er blokkert av Browther</translation>
<translation id="1339376981847018870">Tillat at Browther bruker nettverket, i brannmur- eller
          antivirusinnstillingene dine.</translation>
<translation id="4949828774841497663">Gå til Programmer &gt; Systeminnstillinger &gt; Nettverk, velg det aktive nettverket, klikk på «Detaljer…»-knappen, og fjern avmerkingen for eventuelle proxy-tjenere som muligens er valgt.</translation>
<translation id="4191403906356422893">Gå til
          Browther-menyen &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Nettverk og internett &gt; Proxy-tjener
          og velg bort «Oppdag innstillinger automatisk».</translation>
<translation id="958169674889932546">Disse sidene er beregnet for bruk av Browther-utviklere. Det kan hende at de ikke aktivt vedlikeholdes eller testes. For å slå dem på, gå til <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klikk på knappen for å slå på feilsøkingssider, og gå til denne siden igjen.</translation>
<translation id="4303967029316005584">Browther er også gjort mulig av annen <ph name="BEGIN_LINK_OSS"/>programvare med åpen kildekode<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Endringene dine trer i kraft neste gang du starter Browther.</translation>
<translation id="221029295134825758">Browther trenger Bluetooth-tilgang for å fortsette tilkoblingen. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther er gjort mulig av åpen kilde-prosjektet <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Gå til
        Browther-menyen &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og fjern avmerkingen for «<ph name="NO_PREFETCH_DESCRIPTION"/>».
        Hvis dette ikke løser problemet, bør du aktivere dette alternativet
        på nytt for bedre ytelse.</translation>
<translation id="8927199829149811571">Du ser på en sikker side for Browther for testing</translation>
<translation id="4220066730874343807">Browther ble ikke avsluttet på riktig måte.</translation>
</translationbundle>