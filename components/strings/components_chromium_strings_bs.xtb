<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="bs">
<translation id="130631256467250065">Vaše promjene će stupiti na snagu kada sljedeći put ponovo pokrenete uređaj.</translation>
<translation id="5681560603157873402">Idite u
          meni Bravea&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          i provjerite je li vaša konfiguracija postavljena na "bez proksi servera" ili "direktno".</translation>
<translation id="4903497818305945122">Izrada izvještaja o padovima aplikacije nije dostupna na Braveu.</translation>
<translation id="5747951541048369241">Prikazana vam je sigurna stranica Bravea</translation>
<translation id="7041193161756628041">Browther pokušava izmijeniti postavke za popunjavanje načina plaćanja.</translation>
<translation id="4670277172953498174">Logotip Bravea</translation>
<translation id="3474898875907708105">Browther pokušava urediti načine plaćanja.</translation>
<translation id="5700544173546684818">Browther je dostupan zahvaljujući <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> projektu otvorenog koda i drugom <ph name="BEGIN_LINK_OSS"/>softveru otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Ovu stranicu je blokirao Browther</translation>
<translation id="1339376981847018870">U postavkama zaštitnog zida ili antivirusnog programa dozvolite Braveu da pristupi
          mreži.</translation>
<translation id="4949828774841497663">Idite u Aplikacije &gt; Postavke sistema &gt; Mreža, odaberite
          aktivnu mrežu, kliknite na dugme Detalji… i poništite odabir svih proksi servera
          koji su možda odabrani.</translation>
<translation id="4191403906356422893">Idite u
          meni Bravea &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Mreža i internet &gt; Proksi server
          i poništite odabir opcije "Automatski otkrivaj postavke".</translation>
<translation id="958169674889932546">Ove stranice su namijenjene za korištenje programerima Bravea i možda se neće aktivno održavati ili testirati. Da ih omogućite, idite na <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknite na dugme da omogućite stranice za otklanjanje grešaka, zatim se vratite na ovu stranicu.</translation>
<translation id="4303967029316005584">Browther su omogućili i drugi <ph name="BEGIN_LINK_OSS"/>softveri otvorenog koda<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Vaše promjene će stupiti na snagu kada sljedeći put budete ponovo pokrenuli Browther.</translation>
<translation id="221029295134825758">Braveu je potreban pristup Bluetoothu da nastavi s
uparivanjem. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther je omogućio <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> projekat otvorenog koda.</translation>
<translation id="3134645574591615830">Idite na
          meni u Braveu &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          i poništite odabir za "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          Ako ovo ne riješi problem, preporučujemo vam da ponovo odaberete
          ovu opcija za unapređenje performansi.</translation>
<translation id="8927199829149811571">Gledate sigurnu stranicu verzije Browther for Testing</translation>
<translation id="4220066730874343807">Browther se nije ispravno zatvorio.</translation>
</translationbundle>