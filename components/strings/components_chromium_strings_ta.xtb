<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ta">
<translation id="130631256467250065">அடுத்த முறை உங்கள் சாதனத்தை மறுதொடக்கம் செய்யும்போது, மாற்றங்கள் செயல்பாட்டிற்கு வரும்.</translation>
<translation id="5681560603157873402">Browther மெனு &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          என்பதற்குச் சென்று, உங்கள் உள்ளமைவு "பிராக்சி இல்லை" அல்லது "நேரடி" என்று அமைக்கப்பட்டிருப்பதை உறுதிசெய்துகொள்ளவும்.</translation>
<translation id="4903497818305945122">சிதைவு அறிக்கை Browther இல் கிடைக்கவில்லை.</translation>
<translation id="5747951541048369241">பாதுகாப்பான Browther பக்கத்தைப் பார்க்கிறீர்கள்</translation>
<translation id="7041193161756628041">பேமெண்ட் விவரங்களை நிரப்பும் முறைகளுக்கான அமைப்புகளை Browther மாற்ற முயல்கிறது.</translation>
<translation id="4670277172953498174">Browther லோகோ</translation>
<translation id="3474898875907708105">பேமெண்ட் முறைகளை Browther மாற்ற முயல்கிறது.</translation>
<translation id="5700544173546684818"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ஓப்பன் சோர்ஸ் திட்டபணி மற்றும் பிற <ph name="BEGIN_LINK_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருட்களால்<ph name="END_LINK_OSS"/> Browther ஐ உருவாக்குவது சாத்தியமானது.</translation>
<translation id="8935269788853634726">இந்தப் பக்கத்தை Browther தடுத்துள்ளது</translation>
<translation id="1339376981847018870">ஃபயர்வாலிலோ வைரஸ் தடுப்பு
          அமைப்புகளிலோ நெட்வொர்க்கை அணுக Braveமை அனுமதிக்கவும்.</translation>
<translation id="4949828774841497663">ஆப்ஸ் &gt; சிஸ்டம் அமைப்புகள் &gt; நெட்வொர்க் என்பதற்குச் சென்று,
          செயலிலுள்ள நெட்வொர்க்கைத் தேர்ந்தெடுத்து, விவரங்கள்... பட்டனைக் கிளிக் செய்துவிட்டு தேர்ந்தெடுக்கப்பட்டுள்ள
          பிராக்ஸிகளைத் தேர்வுநீக்கவும்.</translation>
<translation id="4191403906356422893">Browther மெனு &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          நெட்வொர்க் &amp; இணையம் &gt; ப்ராக்ஸி
          என்பதற்குச் சென்று "தானாகவே அமைப்புகளைக் கண்டறி" என்பதைத் தேர்வு நீக்கவும்.</translation>
<translation id="958169674889932546">இந்தப் பக்கங்கள் Browther டெவெலப்பர்களுக்கானவை. இவை தொடர்ச்சியாகப் பராமரிக்கப்படாமலோ பரிசோதிக்கப்படாமலோ இருக்கலாம். இவற்றை இயக்க, <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> பக்கத்திற்குச் சென்று, பிழைதிருத்துதல் பக்கங்களை இயக்குவதற்கான பட்டனைக் கிளிக் செய்யவும். பிறகு, இந்தப் பக்கத்திற்குத் திரும்ப வரவும்.</translation>
<translation id="4303967029316005584">பிற <ph name="BEGIN_LINK_OSS"/>ஓப்பன் சோர்ஸ் மென்பொருள்<ph name="END_LINK_OSS"/> மூலமாகவும் Browther உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="8031938899816118394">அடுத்த முறை நீங்கள் Browther ஐ மீண்டும் தொடங்கும்போது உங்கள் மாற்றங்கள் செயல்படும்.</translation>
<translation id="221029295134825758">இணைப்பதைத் தொடர Braveமிற்கு புளூடூத் அணுகல் 
 தேவை. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ஓப்பன் சோர்ஸ் திட்டப்பணி மூலம் Browther உருவாக்கப்பட்டுள்ளது.</translation>
<translation id="3134645574591615830">Browther மெனு &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          என்பதற்குச் சென்று, "<ph name="NO_PREFETCH_DESCRIPTION"/>" என்பதைத் தேர்வுநீக்கம் செய்யவும்.
          இது சிக்கலைத் தீர்க்கவில்லை எனில், மேம்பட்ட செயல்திறனுக்கு இந்த விருப்பத்தை மீண்டும் தேர்ந்தெடுக்கும்படி பரிந்துரைக்கிறோம்.</translation>
<translation id="8927199829149811571">பாதுகாப்பான Browther for Testing பக்கத்தைப் பார்க்கிறீர்கள்</translation>
<translation id="4220066730874343807">Browther சரியாக நிறுத்தப்படவில்லை.</translation>
</translationbundle>