<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ko">
<translation id="130631256467250065">기기를 다시 시작할 때 변경사항이 적용됩니다.</translation>
<translation id="5681560603157873402">Browther 메뉴 &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          (으)로 이동하여
          '프록시 없음' 또는 '직접 연결'로 설정되어 있는지 확인합니다.</translation>
<translation id="4903497818305945122">비정상 종료 보고서는 Brave에서 사용할 수 없습니다.</translation>
<translation id="5747951541048369241">안전한 Browther 페이지를 보는 중</translation>
<translation id="7041193161756628041">Brave에서 결제 수단 입력 설정을 수정하려고 합니다.</translation>
<translation id="4670277172953498174">Browther 로고</translation>
<translation id="3474898875907708105">Brave에서 결제 수단을 수정하려고 합니다.</translation>
<translation id="5700544173546684818">Brave은 <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> 오픈소스 프로젝트를 비롯한 여러 <ph name="BEGIN_LINK_OSS"/>오픈소스 소프트웨어<ph name="END_LINK_OSS"/>에 기초해 만들어진 브라우저입니다.</translation>
<translation id="8935269788853634726">Brave에서 차단한 페이지입니다.</translation>
<translation id="1339376981847018870">Brave이 방화벽이나 백신 프로그램이 설정된
        네트워크에 액세스할 수 있도록 허용합니다.</translation>
<translation id="4949828774841497663">애플리케이션 &gt; 시스템 설정 &gt; 네트워크로 이동하여
          활성 네트워크를 선택하고 세부정보... 버튼을 클릭한 후
          선택되어 있을 수 있는 프록시를 선택 해제합니다.</translation>
<translation id="4191403906356422893">Browther 메뉴 &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          네트워크 및 인터넷
          &gt; 프록시로 이동하여
          '자동으로 설정 검색'을 선택 해제합니다.</translation>
<translation id="958169674889932546">이 페이지는 Browther 개발자를 위한 것으로, 적극적으로 유지보수되거나 테스트되지 않을 수 있습니다. 사용 설정하려면 <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>로 이동하여 버튼을 클릭하여 디버그 페이지를 사용 설정한 다음 이 페이지로 다시 이동하세요.</translation>
<translation id="4303967029316005584">Brave은 다른 <ph name="BEGIN_LINK_OSS"/>오픈소스 소프트웨어<ph name="END_LINK_OSS"/>를 사용하여 제작된 브라우저입니다.</translation>
<translation id="8031938899816118394">변경사항은 다음에 Brave을 다시 시작할 때 적용됩니다.</translation>
<translation id="221029295134825758">페어링을 계속하려면 Brave에서 블루투스 액세스 권한이
필요합니다. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Brave은 <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> 오픈소스 프로젝트를 통해 제작된 브라우저입니다.</translation>
<translation id="3134645574591615830">Browther 메뉴 &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          (으)로 이동하고 '<ph name="NO_PREFETCH_DESCRIPTION"/>'을(를) 선택 취소합니다.
          그래도 문제가 해결되지 않으면 이 옵션을 다시 선택하여
          성능을 개선해 보시기 바랍니다.</translation>
<translation id="8927199829149811571">안전한 Browther for Testing 페이지를 보는 중</translation>
<translation id="4220066730874343807">Brave이 제대로 종료되지 않았습니다.</translation>
</translationbundle>