<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="130631256467250065">تغییرات بار بعد که دستگاه راه‌اندازی می‌شود اعمال می‌شوند.</translation>
<translation id="5681560603157873402">‏به
          «منو Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>»
          بروید و مطمئن شوید پیکربندی روی «no proxy» (بدون پراکسی) یا «direct» (مستقیم) تنظیم شده باشد.</translation>
<translation id="4903497818305945122">‏گزارش خرابی در Browther موجود نیست.</translation>
<translation id="5747951541048369241">‏درحال مشاهده یک صفحه Browther امن هستید</translation>
<translation id="7041193161756628041">‏Chromebook می‌خواهد تنظیمات تکمیل روش‌های پرداخت را اصلاح کند.</translation>
<translation id="4670277172953498174">‏نشان‌واره Browther</translation>
<translation id="3474898875907708105">‏Browther می‌خواهد روش‌های پرداخت را ویرایش کند.</translation>
<translation id="5700544173546684818">‏Browther با پروژه منبع باز <ph name="BEGIN_LINK_CHROMIUM"/>Browther <ph name="END_LINK_CHROMIUM"/> و سایر <ph name="BEGIN_LINK_OSS"/>نرم‌افزار منبع باز<ph name="END_LINK_OSS"/> امکان‌پذیر است.</translation>
<translation id="8935269788853634726">‏این صفحه را Browther مسدود کرده است</translation>
<translation id="1339376981847018870">‏در تنظیمات دیوار آتش و ضدویروستان، به Browther اجازه دسترسی به شبکه را
          بدهید.</translation>
<translation id="4949828774841497663">به «برنامه‌ها &gt; تنظیمات سیستم &gt; شبکه» بروید، شبکه
          فعال را انتخاب کنید، روی دکمه «جزئیات…» کلیک کنید، و همه
          پراکسی‌هایی را که ممکن است انتخاب شده باشند لغو انتخاب کنید.</translation>
<translation id="4191403906356422893">‏به
          «منو Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          شبکه و اینترنت &gt; پراکسی»
          بروید و «Automatically detect settings» (تشخیص خودکار تنظیمات) را لغو انتخاب کنید.</translation>
<translation id="958169674889932546">‏این صفحه‌ها برای استفاده توسعه‌دهندگان Browther درنظر گرفته شده‌اند و ممکن است به‌طور فعال نگهداری یا آزمایش نشوند. برای فعال کردن آن‌ها، به <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> بروید، روی دکمه فعال کردن صفحه‌های اشکال‌زدایی کلیک کنید و سپس دوباره به این صفحه بروید.</translation>
<translation id="4303967029316005584">‏ارائه Browther ازطریق <ph name="BEGIN_LINK_OSS"/>نرم‌افزارهای متن‌باز<ph name="END_LINK_OSS"/> دیگر نیز ممکن شده است.</translation>
<translation id="8031938899816118394">‏دفعه بعدی که Browther را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="221029295134825758">‏Browther باید برای ادامه مرتبط‌سازی به بلوتوث
دسترسی داشته باشد. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">‏ارائه Browther ازطریق پروژه متن‌باز <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ممکن شده است.</translation>
<translation id="3134645574591615830">‏به
          منوی Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          بروید و علامت «<ph name="NO_PREFETCH_DESCRIPTION"/>» را بردارید.
          درصورتی‌که با این کار مشکل حل نشد، توصیه می‌کنیم برای عملکرد بهبودیافته،
          این گزینه را دوباره انتخاب کنید.</translation>
<translation id="8927199829149811571">‏درحال مشاهده یکی از صفحه‌های امن Browther for Testing هستید</translation>
<translation id="4220066730874343807">‏Browther به درستی خاموش نشده است.</translation>
</translationbundle>