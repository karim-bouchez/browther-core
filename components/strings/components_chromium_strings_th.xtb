<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="130631256467250065">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณรีสตาร์ทอุปกรณ์ของคุณ</translation>
<translation id="5681560603157873402">ไปที่
          เมนู Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          และตรวจสอบว่าคุณได้ตั้งการกำหนดค่าเป็น "ไม่มีพร็อกซี" หรือ "โดยตรง"</translation>
<translation id="4903497818305945122">ไม่มีการรายงานข้อขัดข้องใน Browther</translation>
<translation id="5747951541048369241">คุณกำลังดูหน้า Browther ที่ปลอดภัย</translation>
<translation id="7041193161756628041">Browther กำลังพยายามแก้ไขการตั้งค่าสำหรับการกรอกวิธีการชำระเงิน</translation>
<translation id="4670277172953498174">โลโก้ Browther</translation>
<translation id="3474898875907708105">Browther กําลังพยายามแก้ไขวิธีการชําระเงิน</translation>
<translation id="5700544173546684818">Browther เกิดขึ้นได้ด้วยการสนับสนุนจากโครงการโอเพนซอร์ส <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> และ<ph name="BEGIN_LINK_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_OSS"/>อื่นๆ</translation>
<translation id="8935269788853634726">หน้านี้ถูกบล็อกโดย Browther</translation>
<translation id="1339376981847018870">อนุญาตให้ Browther เข้าถึงเครือข่ายในการตั้งค่าไฟร์วอลล์
          หรือการป้องกันไวรัส</translation>
<translation id="4949828774841497663">ไปที่แอปพลิเคชัน &gt; การตั้งค่าระบบ &gt; เครือข่าย เลือกเครือข่ายที่ใช้งานอยู่ คลิกปุ่ม "รายละเอียด..." แล้วยกเลิกการเลือกพร็อกซีที่อาจเลือกไว้</translation>
<translation id="4191403906356422893">ไปที่
          เมนู Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          เครือข่ายและอินเทอร์เน็ต &gt; พร็อกซี
          แล้วยกเลิกการเลือก "ตรวจหาการตั้งค่าโดยอัตโนมัติ"</translation>
<translation id="958169674889932546">หน้าเหล่านี้มีไว้สำหรับนักพัฒนาซอฟต์แวร์ Browther เท่านั้น และอาจไม่ได้รับการดูแลรักษาหรือทดสอบอย่างสม่ำเสมอ หากต้องการเปิดใช้ ให้ไปที่ <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> คลิกปุ่มเพื่อเปิดใช้หน้าแก้ไขข้อบกพร่อง แล้วมาที่หน้านี้อีกครั้ง</translation>
<translation id="4303967029316005584">Browther ยังเกิดขึ้นได้ด้วย<ph name="BEGIN_LINK_OSS"/>ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_OSS"/>อื่นๆ</translation>
<translation id="8031938899816118394">การเปลี่ยนแปลงของคุณจะมีผลในครั้งถัดไปที่คุณเปิด Browther ขึ้นอีก</translation>
<translation id="221029295134825758">Browther ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อจับคู่ต่อ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther เกิดขึ้นได้ด้วยโปรเจ็กต์โอเพนซอร์ส <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/></translation>
<translation id="3134645574591615830">ไปที่
          เมนู Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          และยกเลิกการเลือก "<ph name="NO_PREFETCH_DESCRIPTION"/>"
          หากวิธีนี้ไม่ช่วยแก้ปัญหา เราขอแนะนำให้เลือกตัวเลือกนี้
          อีกครั้งเพื่อให้ประสิทธิภาพการทำงานดียิ่งขึ้น</translation>
<translation id="8927199829149811571">คุณกําลังดูหน้า Browther สําหรับการทดสอบที่ปลอดภัย</translation>
<translation id="4220066730874343807">Browther ไม่ได้ปิดอย่างถูกต้อง</translation>
</translationbundle>