<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ur">
<translation id="130631256467250065">اپنا آلہ اگلی بار دوبارہ شروع کرنے پر آپ کی تبدیلیاں مؤثر ہوں گی۔</translation>
<translation id="5681560603157873402">‏‫Browther مینیو &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          پر جائیں اور یقینی بنائیں کہ آپ کی کنفیگریشن "کوئی پراکسی نہیں" یا "ڈائریکٹ" پر سیٹ ہے۔</translation>
<translation id="4903497818305945122">‏Browther میں کریش رپورٹنگ دستیاب نہیں ہے۔</translation>
<translation id="5747951541048369241">‏آپ ایک محفوظ Browther صفحہ دیکھ رہے ہیں</translation>
<translation id="7041193161756628041">‏ادائیگی کے طریقوں پُر کرنے کی خاطر ترتیبات میں ترمیم کرنے کے لیے Browther کوشش کر رہا ہے۔</translation>
<translation id="4670277172953498174">‏Browther کا لوگو</translation>
<translation id="3474898875907708105">‏Browther ادائیگی کے طریقوں میں ترمیم کرنے کی کوشش کر رہا ہے۔</translation>
<translation id="5700544173546684818">‏Browther کو ‎<ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>‎ اوپن سورس پروجیکٹ اور دیگر <ph name="BEGIN_LINK_OSS"/>اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS"/> کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="8935269788853634726">‏اس صفحے کو Browther نے مسدود کر دیا ہے</translation>
<translation id="1339376981847018870">‏Browther کو اپنے فائروال یا اینٹی وائرس کی
          ترتیبات میں نیٹ ورک تک رسائی حاصل کرنے کی اجازت دیں۔</translation>
<translation id="4949828774841497663">ایپلیکیشنز &gt; سسٹم کی ترتیبات &gt; نیٹ ورک پر جائیں، فعال نیٹ ورک منتخب کریں، تفصیلات... بٹن پر کلک کریں اور ممکنہ طور پر منتخب کردہ کسی بھی پراکسی کو غیر منتخب کریں۔</translation>
<translation id="4191403906356422893">‏‫Browther مینیو &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          نیٹ ورک اور انٹرنیٹ &gt; پراکسی
          پر جائیں اور"خودکار طور پر ترتیبات کو منتخب کریں" کو غیر منتخب کریں۔</translation>
<translation id="958169674889932546">‏یہ صفحات Browther کے ڈویلپرز کے استعمال کے ارادے سے ہیں اور ہو سکتا ہے کہ ان کی فعال طور پر دیکھ بھال یا جانچ نہ کی جائے۔ ان کو فعال کرنے کے لیے، <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> پر نیویگیٹ کریں، ڈیبگ صفحات کو فعال کرنے کے لیے بٹن پر کلک کریں اور پھر اس صفحہ پر دوبارہ نیویگیٹ کریں۔</translation>
<translation id="4303967029316005584">‏Browther کو دوسرے <ph name="BEGIN_LINK_OSS"/>اوپن سورس سافٹ ویئر<ph name="END_LINK_OSS"/> کے ذریعے بھی ممکن بنایا گیا ہے۔</translation>
<translation id="8031938899816118394">‏آپ کی تبدیلیاں Browther کو اگلی بار آپ کے دوبارہ شروع کرنے کے وقت نافذ ہوں گی۔</translation>
<translation id="221029295134825758">‏جوڑا بنانا جاری رکھنے کیلئے Browther کو بلوٹوتھ رسائی کی ضرورت ہے۔ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">‏Browther کو <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> اوپن سورس پروجیکٹ کے ذریعے ممکن بنایا گیا ہے۔</translation>
<translation id="3134645574591615830">‏Browther مینیو &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          پر جائیں اور "<ph name="NO_PREFETCH_DESCRIPTION"/>" کو غیر منتخب کریں۔
          اگر اس سے مسئلہ حل نہیں ہوتا ہے تو ہم
          بہتر کارکردگی کیلئے یہ اختیار دوبارہ منتخب کرنے کی تجویز
          کرتے ہیں۔</translation>
<translation id="8927199829149811571">‏آپ محفوظ Browther for Testing صفحہ دیکھ رہے ہیں</translation>
<translation id="4220066730874343807">‏Browther صحیح سے بند نہیں ہوا۔</translation>
</translationbundle>