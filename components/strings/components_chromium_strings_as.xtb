<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="as">
<translation id="130631256467250065">আপুনি ইয়াৰ পিছৰবাৰ আপোনাৰ ডিভাইচটো ৰিষ্টাৰ্ট কৰিলে সালসলনিখিনি প্ৰয়োগ কৰা হ‘ব।</translation>
<translation id="5681560603157873402">Braveৰ মেনু &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          লৈ যাওক আৰু আপোনাৰ কনফিগাৰেশ্বনটো যাতে "প্ৰক্সী নাই" বা "পোনপটীয়া" হিচাপে ছেট কৰা হয় সেয়া নিশ্চিত কৰক।</translation>
<translation id="4903497818305945122">Braveত ক্ৰেশ্ব ৰিপ'ৰ্ট কৰা সুবিধা নাই।</translation>
<translation id="5747951541048369241">আপুনি এক সুৰক্ষিত Braveৰ পৃষ্ঠা চাই আছে</translation>
<translation id="7041193161756628041">Braveএ পৰিশোধ পদ্ধতি পূৰ কৰাৰ বাবে ছেটিং সংশোধন কৰিবলৈ চেষ্টা কৰি আছে।</translation>
<translation id="4670277172953498174">Braveৰ ল’গ’</translation>
<translation id="3474898875907708105">Braveএ পৰিশোধ পদ্ধতি সম্পাদনা কৰিবলৈ চেষ্টা কৰি আছে।</translation>
<translation id="5700544173546684818">Braveক <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>ৰ মুক্ত উৎসৰ প্ৰ'জেক্ট আৰু অন্য <ph name="BEGIN_LINK_OSS"/>মুক্ত উৎসৰ ছফ্টৱেৰে<ph name="END_LINK_OSS"/> ব্যৱহাৰযোগ্য কৰি তুলিছে।</translation>
<translation id="8935269788853634726">এই পৃষ্ঠাখন Braveএ অৱৰোধ কৰিছে</translation>
<translation id="1339376981847018870">আপোনাৰ ফায়াৰৱাল বা এণ্টিভাইৰাছৰ ছেটিঙৰ নেটৱর্কত এক্সেছ কৰিবলৈ Braveক অনুমতি দিয়ক</translation>
<translation id="4949828774841497663">এপ্লিকেশ্বন &gt; ছিষ্টেমৰ ছেটিং &gt; নেটৱৰ্কলৈ যাওক, সক্ৰিয় নেটৱৰ্ক
          বাছনি কৰক, সবিশেষ... বুটামটোত ক্লিক কৰক আৰু বাছনি কৰা থাকিব পৰা
          আটাইবোৰ প্ৰক্সি বাছনিৰ পৰা আঁতৰাওক।</translation>
<translation id="4191403906356422893">Braveৰ মেনু &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          নেটৱৰ্ক আৰু ইণ্টাৰনেট &gt; প্ৰক্সীলৈ যাওক
          আৰু তাৰ পাছত "স্বয়ংক্ৰিয়ভাৱে ছেটিং চিনাক্ত কৰক" বাছনিৰ পৰা আঁতৰাওক।</translation>
<translation id="958169674889932546">এই পৃষ্ঠাসমূহ Braveৰ বিকাশকৰ্তাৰ ব্যৱহাৰৰ বাবে সৃষ্টি কৰা হৈছে আৰু সেইসমূহ সক্ৰিয়ভাৱে ৰক্ষণাবেক্ষণ বা পৰীক্ষা কৰা নহ’বও পাৰে। সেয়া সক্ষম কৰিবলৈ <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>লৈ যাওক, পৃষ্ঠা ডিবাগ কৰাৰ সুবিধা সক্ষম কৰিবলৈ বুটামটোত ক্লিক কৰক আৰু তাৰ পাছত পুনৰ এই পৃষ্ঠাখনলৈ যাওক।</translation>
<translation id="4303967029316005584">আন <ph name="BEGIN_LINK_OSS"/>মুক্ত উৎসৰ ছফ্টৱেৰ<ph name="END_LINK_OSS"/>ৰ জৰিয়তেও Browther ব্যৱহাৰযোগ্য কৰা হৈছে।</translation>
<translation id="8031938899816118394">আপুনি পৰৱৰ্তী সময়ত Browther পুনৰ লঞ্চ কৰিলে আপুনি কৰা সলনিসমূহ কাৰ্যকৰী হ’ব।</translation>
<translation id="221029295134825758">পেয়াৰ কৰাটো অব্যাহত ৰাখিবলৈ Braveক ব্লুটুথ সুবিধাৰ এক্সেছৰ 
আৱশ্যক। <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314"><ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> মুক্ত উৎসৰ প্ৰ’জেক্টৰ জৰিয়তে Browther ব্যৱহাৰযোগ্য কৰা হৈছে।</translation>
<translation id="3134645574591615830">Browther মেনু
          &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>লৈ যাওক
          আৰু "<ph name="NO_PREFETCH_DESCRIPTION"/>."ৰ বাছনি আঁতৰাওক
          এইটো কৰিলেও যদি সমস্যাটো সমাধান নহয়, তেন্তে আমি উন্নত প্ৰদৰ্শনৰ বাবে
          আকৌ এই বিকল্পটো বাছনি কৰাৰ চুপাৰিছ কৰোঁ৷</translation>
<translation id="8927199829149811571">আপুনি এটা সুৰক্ষিত Browther for Testing পৃষ্ঠা চাই আছে</translation>
<translation id="4220066730874343807">Browther সঠিককৈ বন্ধ হোৱা নাছিল।</translation>
</translationbundle>