<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="pl">
<translation id="130631256467250065">Zmiany zostaną zastosowane przy następnym uruchomieniu urządzenia.</translation>
<translation id="5681560603157873402">Otwórz menu Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> i upewnij się, że w konfiguracji wybrano połączenie bez serwera proxy lub bezpośrednie.</translation>
<translation id="4903497818305945122">Zgłaszanie awarii nie jest dostępne w Browther.</translation>
<translation id="5747951541048369241">Przeglądasz bezpieczną stronę Browther</translation>
<translation id="7041193161756628041">Browther próbuje zmienić ustawienia wypełniania form płatności.</translation>
<translation id="4670277172953498174">Logo Browther</translation>
<translation id="3474898875907708105">Browther próbuje edytować formy płatności.</translation>
<translation id="5700544173546684818">Stworzenie Browther było możliwe dzięki projektowi open source <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> i innym <ph name="BEGIN_LINK_OSS"/>programom o otwartym kodzie źródłowym<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Ta strona została zablokowana przez Browther</translation>
<translation id="1339376981847018870">Zezwalaj Browther na korzystanie z sieci w ustawieniach zapory sieciowej
        lub oprogramowania antywirusowego.</translation>
<translation id="4949828774841497663">Otwórz kolejno Aplikacje &gt; Ustawienia systemu &gt; Sieć, wybierz aktywną sieć, kliknij przycisk Szczegóły… i usuń zaznaczenie wszystkich zaznaczonych serwerów proxy.</translation>
<translation id="4191403906356422893">Otwórz menu Browther &gt; <ph name="SETTINGS_TITLE"/> &gt; <ph name="SYSTEM_TITLE"/> &gt; <ph name="PROXIES_TITLE"/> &gt; Sieć i internet &gt; Serwer proxy i odznacz „Automatycznie wykrywaj ustawienia”.</translation>
<translation id="958169674889932546">Te strony są przeznaczone dla programistów Browther i mogą nie być aktywnie utrzymywane ani testowane. Aby je włączyć, otwórz <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, kliknij przycisk włączania debugowania stron, a potem ponownie otwórz tę stronę.</translation>
<translation id="4303967029316005584">Stworzenie przeglądarki Browther było też możliwe dzięki innemu <ph name="BEGIN_LINK_OSS"/>oprogramowaniu open source<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Zmiany zostaną zastosowane po ponownym uruchomieniu Browther.</translation>
<translation id="221029295134825758">Aby kontynuować parowanie, Browther potrzebuje dostępu do Bluetootha. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Stworzenie przeglądarki Browther było możliwe dzięki projektowi open source <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Wybierz
        menu Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        i odznacz „<ph name="NO_PREFETCH_DESCRIPTION"/>”.
        Jeśli nie rozwiąże to problemu, zalecamy ponowne wybranie tej opcji,
        by poprawić wydajność.</translation>
<translation id="8927199829149811571">Oglądasz bezpieczną stronę Browther for Testing.</translation>
<translation id="4220066730874343807">Browther nie został poprawnie zamknięty.</translation>
</translationbundle>