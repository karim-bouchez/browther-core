<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="af">
<translation id="130631256467250065">Jou veranderinge sal in werking tree wanneer jy jou toestel herbegin.</translation>
<translation id="5681560603157873402">Gaan na
          die Browther-kieslys &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          en maak seker jou opstelling is op “geen instaanbediener nie” of “direk” gestel.</translation>
<translation id="4903497818305945122">Omvalrapportering is nie beskikbaar in Browther nie.</translation>
<translation id="5747951541048369241">Jy bekyk tans 'n veilige Browther-bladsy</translation>
<translation id="7041193161756628041">Browther probeer tans instellings vir die invul van betaalmetodes wysig.</translation>
<translation id="4670277172953498174">Browther-logo</translation>
<translation id="3474898875907708105">Browther probeer tans om betaalmetodes te wysig.</translation>
<translation id="5700544173546684818">Browther word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>-oopbronprojek en ander <ph name="BEGIN_LINK_OSS"/>oopbronsagteware<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Hierdie bladsy is deur Browther geblokkeer</translation>
<translation id="1339376981847018870">Laat Browther in jou brandmuur- of antivirusinstellings toe om by jou netwerk
          in te gaan.</translation>
<translation id="4949828774841497663">Gaan na Apps &gt; Stelselinstellings &gt; Netwerk, kies die
          aktiewe netwerk, klik die Besonderhedeknoppie, en ontkies enige instaanbedieners
          wat dalk gekies is.</translation>
<translation id="4191403906356422893">Gaan na
          die Browther-kieslys &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netwerk en internet &gt; Instaanbediener
          en ontkies “Vind instellings outomaties”.</translation>
<translation id="958169674889932546">Hierdie bladsye is bedoel vir gebruik deur Browther-ontwikkelaars en word dalk nie aktief onderhou of getoets nie. As jy hulle wil aktiveer, navigeer na <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, klik die knoppie om ontfoutbladsye te aktiveer en navigeer dan terug na hierdie bladsy toe.</translation>
<translation id="4303967029316005584">Browther word ook moontlik gemaak deur ander <ph name="BEGIN_LINK_OSS"/>oopbronsagteware<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Jou veranderinge sal in werking tree wanneer jy Browther weer herbegin.</translation>
<translation id="221029295134825758">Browther het Bluetooth-toegang nodig om voort te gaan met 
 saambinding. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther word moontlik gemaak deur die <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>-oopbronprojek.</translation>
<translation id="3134645574591615830">Gaan na
        die Browther-kieslys &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        en ontmerk "<ph name="NO_PREFETCH_DESCRIPTION"/>."
        As dit nie die probleem oplos nie, beveel ons aan dat hierdie opsie
        weer gekies word vir verbeterde werkverrigting.</translation>
<translation id="8927199829149811571">Jy bekyk tans ’n veilige Browther-toetsweergawe-bladsy</translation>
<translation id="4220066730874343807">Browther het nie reg toegemaak nie.</translation>
</translationbundle>