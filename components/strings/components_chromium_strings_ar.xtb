<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ar">
<translation id="130631256467250065">تسري التغييرات في المرة التالية التي تعيد فيها تشغيل الجهاز.</translation>
<translation id="5681560603157873402">‏يُرجى الانتقال إلى
          قائمة Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          والتأكّد من ضبط الإعدادات على "بلا خادم وكيل" أو "مباشر.".</translation>
<translation id="4903497818305945122">‏تقارير الأعطال غير متاحة في Browther.</translation>
<translation id="5747951541048369241">‏أنت تعرض صفحة Browther آمنة</translation>
<translation id="7041193161756628041">‏يحاول Browther تعديل إعدادات ميزة "الملء التلقائي" لبيانات طُرق الدفع.</translation>
<translation id="4670277172953498174">‏شعار Browther</translation>
<translation id="3474898875907708105">‏يحاول Browther تعديل طُرق الدفع.</translation>
<translation id="5700544173546684818">‏أصبح Browther الآن متاحًا بفضل المشروع المفتوح المصدر <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> و<ph name="BEGIN_LINK_OSS"/>برامج أخرى مفتوحة المصدر<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">‏تم حظر هذه الصفحة بواسطة متصفّح Browther.</translation>
<translation id="1339376981847018870">‏اسمح لـ Browther بالدخول إلى الشبكة من خلال إعدادات جدار الحماية أو
        برنامج مكافحة الفيروسات.</translation>
<translation id="4949828774841497663">‏يُرجى الانتقال إلى "التطبيقات" (Applications) &gt; "إعدادات النظام" (System Settings) &gt; "الشبكة" (Network)، ثم اختيار
          الشبكة النشطة، والنقر على زر "التفاصيل…" (Details…‎) وإلغاء اختيار أي خوادم وكيلة
          سبق اختيارها.</translation>
<translation id="4191403906356422893">‏يُرجى الانتقال إلى
          قائمة Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          الشبكة والإنترنت &gt; الخادم الوكيل
          وإلغاء اختيار "رصد الإعدادات تلقائيًا".</translation>
<translation id="958169674889932546">‏هذه الصفحات مخصّصة لمطوّري Browther، وقد لا تتم صيانتها أو اختبارها بشكلٍ منتظم. لتفعيلها، يُرجى الانتقال إلى <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> والنقر على زر تفعيل صفحات تصحيح الأخطاء، ثم الانتقال إلى هذه الصفحة مرة أخرى.</translation>
<translation id="4303967029316005584">‏أصبح Browther متاحًا من خلال <ph name="BEGIN_LINK_OSS"/>برنامج آخر مفتوح المصدر<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">‏ستسري التغييرات في المرة التالية التي تعيد فيها تشغيل Browther.</translation>
<translation id="221029295134825758">‏يجب منح Browther الإذن بالوصول إلى البلوتوث لمواصلة عملية 
الإقران. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">‏أصبح Browther متاحًا من خلال مشروع <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> المفتوح المصدر.</translation>
<translation id="3134645574591615830">‏انتقل إلى
        قائمة Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        وألغ اختيار "<ph name="NO_PREFETCH_DESCRIPTION"/>"
        في حالة ما إذا لم يؤد ذلك إلى حل المشكلة، نوصي بتحديد هذا الخيار
        مرة أخرى من أجل أداء أفضل.</translation>
<translation id="8927199829149811571">‏أنت تعرض صفحة Browther for Testing آمنة.</translation>
<translation id="4220066730874343807">‏لم يغلق Browther بشكل صحيح.</translation>
</translationbundle>