<!DOCTYPE translationbundle>
<translationbundle lang="mr">
<translation id="130631256467250065">तुम्ही आपल्या डिव्हाइसचा पुढील वेळी पुनरारंभ कराल तेव्हा तुमचे बदल प्रभावी होतील.</translation>
<translation id="5681560603157873402">Browther मेनू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
वर जा
          आणि तुमचे कॉन्फिगरेशन "प्रॉक्सी नाही" किंवा "प्रत्यक्ष" वर सेट केले असल्याची खात्री करा.</translation>
<translation id="4903497818305945122">Browther मध्ये क्रॅश अहवाल उपलब्ध नाही.</translation>
<translation id="5747951541048369241">तुम्ही एक सुरक्षित Browther पेज पाहत आहात</translation>
<translation id="7041193161756628041">Browther पेमेंट पद्धती भरण्यासाठी सेटिंग्जमध्ये फेरबदल करण्याचा प्रयत्न करत आहे.</translation>
<translation id="4670277172953498174">Browther लोगो</translation>
<translation id="3474898875907708105">Browther हे पेमेंट पद्धती संपादित करण्याचा प्रयत्‍न करत आहे.</translation>
<translation id="5700544173546684818">Browther हे <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> खुला स्रोत प्रकल्प आणि इतर <ph name="BEGIN_LINK_OSS"/>खुले स्रोत सॉफ्टवेअर<ph name="END_LINK_OSS"/> द्वारे बनवणे शक्य झाले.</translation>
<translation id="8935269788853634726">हे पेज Browther ने ब्लॉक केले आहे</translation>
<translation id="1339376981847018870">तुमच्या फायरवॉल किंवा अँटीव्हायरस सेटिंग्जमधील नेटवर्क ॲक्सेस करण्यास
        Browther ला परवानगी  द्या.</translation>
<translation id="4949828774841497663">अ‍ॅप्लिकेशन &gt; सिस्टीम सेटिंग्ज &gt; नेटवर्क वर जा
          अ‍ॅक्टिव्ह नेटवर्क निवडा, तपशील... बटणावर क्लिक करा, आणि निवडलेल्या कोणत्याही प्रॉक्सीची
          निवड रद्द करा.</translation>
<translation id="4191403906356422893">Browther मेनू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          नेटवर्क आणि इंटरनेट &gt; प्रॉक्सी
यावर जा
          आणि "आपोआप सेटिंग्ज शोधा" ची निवड रद्द करा.</translation>
<translation id="958169674889932546">ही पेज Browther डेव्हलपरद्वारे वापरण्यासाठी आहेत आणि सक्रियपणे देखरेख किंवा चाचणी केली जाऊ शकत नाहीत. ती सुरू करण्यासाठी, <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> वर नेव्हिगेट करा, पेज डीबग करा सुरू करण्यासाठी बटणावर क्लिक करा आणि नंतर या पेजवर पुन्हा नेव्हिगेट करा.</translation>
<translation id="4303967029316005584">Browther हे इतर <ph name="BEGIN_LINK_OSS"/>मुक्त स्रोत सॉफ्टवेअर<ph name="END_LINK_OSS"/> द्वारेदेखील तयार करण्यात आले आहे.</translation>
<translation id="8031938899816118394">तुम्ही पुढल्या वेळी Browther रीलाँच कराल तोपर्यंत तुमचे बदल प्रभावी होतील.</translation>
<translation id="221029295134825758">पेअर करणे पुढे सुरू ठेवण्यासाठी, Browther ला ब्लूटूथ ॲक्सेस करण्याची 
 आवश्यकता आहे. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther हे <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> मुक्त स्रोत प्रोजेक्टद्वारे तयार करण्यात आले आहे.</translation>
<translation id="3134645574591615830">Browther मेनू &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          वर जा आणि "<ph name="NO_PREFETCH_DESCRIPTION"/>" ची निवड रद्द करा.
          हे समस्‍येचे निराकरण करीत नसल्‍यास, आम्‍ही
सुधारित कार्यप्रदर्शनासाठी पुन्हा
          हा पर्याय निवडण्याची शिफारस करतो.</translation>
<translation id="8927199829149811571">तुम्ही सुरक्षित Browther for Testing पेज पाहत आहात</translation>
<translation id="4220066730874343807">Browther योग्यरित्या बंद केले नव्‍हते.</translation>
</translationbundle>