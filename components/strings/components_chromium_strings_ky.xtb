<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ky">
<translation id="130631256467250065">Өзгөртүүлөрүңүз түзмөгүңүз өчүп күйгөндөн кийин күчүнө кирет.</translation>
<translation id="5681560603157873402">Төмөнкүгө өтүңүз:
          Browther менюсу &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>.
          Конфигурация "прокси жок" же "түздөн-түз" деп коюлганын текшериңиз.</translation>
<translation id="4903497818305945122">Browther'да каталар жөнүндө кабар берүү мүмкүн эмес.</translation>
<translation id="5747951541048369241">Коопсуз Browther баракчасын карап жатасыз</translation>
<translation id="7041193161756628041">Browther төлөм ыкмаларын толтуруу параметрлерин өзгөртүүгө аракет кылууда.</translation>
<translation id="4670277172953498174">Browther логотиби</translation>
<translation id="3474898875907708105">Browther төлөм ыкмаларын түзөтүүгө аракет кылууда.</translation>
<translation id="5700544173546684818">Browther <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ачык булак долбоору жана башка <ph name="BEGIN_LINK_OSS"/>ачык программа<ph name="END_LINK_OSS"/> аркылуу мүмкүн болду.</translation>
<translation id="8935269788853634726">Бул баракты Browther бөгөттөп койду</translation>
<translation id="1339376981847018870">Browther'га коргоо системасында тармакка же антивирус параметрлерине кирүүгө уруксат
          бериңиз.</translation>
<translation id="4949828774841497663">Төмөнкүгө өтүңүз Колдонмолор &gt; Тутумдун параметрлери &gt; Тармак, 
          жигердүү тармакты тандап, Чоо-жайы... баскычын чыкылдатып, колдонулган проксилерди
          тандоодон чыгарыңыз.</translation>
<translation id="4191403906356422893">Төмөнкүгө өтүңүз:
          Browther менюсу &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Тармак жана Интернет &gt; Прокси.
          "Параметрлерди автоматтык түрдө аныктоо" дегенди тандоодон чыгарыңыз.</translation>
<translation id="958169674889932546">Бул беттер Browther иштеп чыгуучуларына арналган жана жигердүү түрдө иштетилип же сыналбашы мүмкүн. Аларды иштетүү үчүн <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> бөлүмүнө өтүп, мүчүлүштүктөрдү оңдоо беттерин иштетүү үчүн баскычты басып, бул бетке кайтып келиңиз.</translation>
<translation id="4303967029316005584">Browther башка <ph name="BEGIN_LINK_OSS"/>ачык ресурс программасы<ph name="END_LINK_OSS"/> аркылуу да жеткиликтүү.</translation>
<translation id="8031938899816118394">Өзгөртүүлөрүңүз Browther кийинки жолу кайра ишке киргизилгенде күчүнө кирет.</translation>
<translation id="221029295134825758">Жупташтырууну улантуу үчүн Browther Bluetooth'ду 
 пайдаланууга уруксат алышы керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ачык ресурс долбоору аркылуу түзүлдү.</translation>
<translation id="3134645574591615830">Browther меню &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        өтүп, "<ph name="NO_PREFETCH_DESCRIPTION"/>" дегенди тандоодон чыгарыңыз.
        Эгер ушуну менен маселе чечилбесе, иштин майнаптуулугун жогорулатуу үчүн бул параметрди  
        кайра тандаңыз.</translation>
<translation id="8927199829149811571">Коопсуз Browther for Testing баракчасын карап жатасыз</translation>
<translation id="4220066730874343807">Browther туура эмес жабылып калды.</translation>
</translationbundle>