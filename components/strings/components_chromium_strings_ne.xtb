<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ne">
<translation id="130631256467250065">तपाईंले अर्को पटक तपाईंको यन्त्रलाई पुन: सुरु गर्दा तपाईंका परिवर्तनहरू प्रभावकारी हुनेछन्।</translation>
<translation id="5681560603157873402">Browther मेनु &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          मा जानुहोस् र आफ्नो कन्फिगुरेसन "कुनै पनि प्रोक्सी छैन" वा "डिरेक्ट" मा सेट गरिएको छ भन्ने कुरा सुनिश्चित गर्नुहोस्।</translation>
<translation id="4903497818305945122">क्र्यास रिपोर्टिङ Browther मा उपलब्ध छैन।</translation>
<translation id="5747951541048369241">तपाईं एउटा सुरक्षित Browther पृष्ठ हेर्दै हुनुहुन्छ</translation>
<translation id="7041193161756628041">Browther ले भुक्तानी विधिहरू हाल्नका निम्ति सेटिङ मिलाउन खोज्दै छ।</translation>
<translation id="4670277172953498174">Browther लोगो</translation>
<translation id="3474898875907708105">Browther ले भुक्तानी विधिहरू सम्पादन गर्ने प्रयास गर्दै छ।</translation>
<translation id="5700544173546684818">Braveको कारण सम्भव भएको हो <ph name="BEGIN_LINK_CHROMIUM"/> Browther <ph name="END_LINK_CHROMIUM"/> खुला स्रोत परियोजना र अन्य <ph name="BEGIN_LINK_OSS"/> खुला स्रोत सफ्टवेयर <ph name="END_LINK_OSS"/> ।</translation>
<translation id="8935269788853634726">Browther ले यो पेज ब्लक गरेको छ</translation>
<translation id="1339376981847018870">Browther लाई तपाईँको फायरवाल वा एन्टिभाइरसका
        सेटिङहरूमा नेटवर्कमा पहुँच गर्ने अनुमति दिनुहोस्।</translation>
<translation id="4949828774841497663">"एपहरू &gt; सिस्टम सेटिङ &gt; नेटवर्क" मा जानुहोस्,
          सक्रिय नेटवर्क चयन गर्नुहोस्, विवरणहरू... बटन थिच्नुहोस् र चयन गरिएका हुन सक्ने सबै
          प्रोक्सीहरूको चयन रद्द गर्नुहोस्।</translation>
<translation id="4191403906356422893">"Browther मेनु &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          नेटवर्क तथा इन्टरनेट &gt; प्रोक्सी"
          मा जानुहोस् र "सेटिङ स्वतः पत्ता लगाउनुहोस्" को चयन रद्द गर्नुहोस्।</translation>
<translation id="958169674889932546">यी पेजहरू Browther विकासकर्ताहरूको प्रयोगका लागि बनाइएका हुनाले सक्रिय रूपमा यिनको व्यवस्थापन वा परीक्षण नगरिएको हुन सक्छ। यी पेजहरू अन गर्न <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> मा जानुहोस्, यो बटन क्लिक गरी पेज डिबग गर्ने सुविधा अन गर्नुहोस् र त्यसपछि फेरि यो पेजमा जानुहोस्।</translation>
<translation id="4303967029316005584">Browther बनाउँदा <ph name="BEGIN_LINK_OSS"/>खुला स्रोतका अन्य सफ्टवेयर<ph name="END_LINK_OSS"/>को पनि मद्दत लिइएको छ।</translation>
<translation id="8031938899816118394">तपाईंले अर्को पटक Browther लाई पुन: लन्च गर्दा तपाईंका परिवर्तनहरू प्रभावमा आउनेछन्।</translation>
<translation id="221029295134825758">कनेक्ट गर्ने प्रक्रिया जारी राख्न Browther लाई ब्लुटुथ प्रयोग गर्ने अनुमति
 दिनु पर्ने हुन्छ। <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther बनाउँदा <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> खुला स्रोतको परियोजनाको मद्दत लिइएको छ।</translation>
<translation id="3134645574591615830">जानुहोस्
          Browther मेनुमा &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          र अचयन गर्नुहोस् "<ph name="NO_PREFETCH_DESCRIPTION"/>."
          यदि यसले मुद्दा समाधान गर्दैन भने, हामी सुधारिएको कार्यसम्पादनका लागि यस विकल्पलाई फेरि चयन गर्न सिफारिस गर्दछौं।</translation>
<translation id="8927199829149811571">तपाईं सुरक्षित Browther for Testing पेज हेर्दै हुनुहुन्छ</translation>
<translation id="4220066730874343807">Browther सही तवरले बन्द भएन।</translation>
</translationbundle>