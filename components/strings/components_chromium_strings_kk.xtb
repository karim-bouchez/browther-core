<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="130631256467250065">Өзгерістеріңіз құрылғыңызды келесі қайта іске қосқанда күшіне енеді.</translation>
<translation id="5681560603157873402">"Browther мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>"
          тармағына өтіп, конфигурация "прокси-серверсіз" немесе "тікелей" күйіне орнатылғанын тексеріңіз.</translation>
<translation id="4903497818305945122">Бұзылу туралы хабарлау мүмкіндігі Browther қызметінде қолжетімді емес.</translation>
<translation id="5747951541048369241">Қауіпсіз Browther бетін көрудесіз</translation>
<translation id="7041193161756628041">Browther төлеу әдістерін толтыру параметрлерін өзгерткісі келеді.</translation>
<translation id="4670277172953498174">Browther логотипі</translation>
<translation id="3474898875907708105">Browther төлеу әдістерін өзгерткісі келеді.</translation>
<translation id="5700544173546684818">Browther қолданбасына <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ашық бастапқы код жобасы мен басқа <ph name="BEGIN_LINK_OSS"/>ашық бастапқы код бағдарламалық жасақтамасы<ph name="END_LINK_OSS"/> арқылы қол жеткізілді.</translation>
<translation id="8935269788853634726">Бұл бетке Browther тарапынан тыйым салынған.</translation>
<translation id="1339376981847018870">Брандмауэр немесе антивирус параметрлерінде Browther жүйесіне
          желіге кіруге рұқсат беріңіз.</translation>
<translation id="4949828774841497663">"Қолданбалар &gt; Жүйе параметрлері &gt; Желі" тармағына өтіп, белсенді желіні таңдаңыз да, "Мәліметтер..." түймесін басып, бұрын таңдалған прокси-серверлерді таңдаудан алыңыз.</translation>
<translation id="4191403906356422893">"Browther мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Желі және интернет &gt; Прокси-сервер"
          тармағына өтіп, "Параметрлерді автоматты түрде анықтау" опциясын таңдаудан алыңыз.</translation>
<translation id="958169674889932546">Бұл беттер Browther әзірлеушілерінің қолданысына арналған және белсенді түрде жүргізілмеуі не сыналмауы мүмкін. Оларды қосу үшін <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/> сайтына өтіп, түзету беттерін қосатын түймені басып, осы бетке қайтып келіңіз.</translation>
<translation id="4303967029316005584">Сонымен қатар Browther басқа <ph name="BEGIN_LINK_OSS"/>ашық кодты бағдарламалық құрал<ph name="END_LINK_OSS"/> арқылы қолжетімді болады.</translation>
<translation id="8031938899816118394">Өзгертулеріңіз Browther келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="221029295134825758">Жұптауды жалғастыру үшін Browther-ге Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther браузері <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> ашық кодты бағдарлама жобасы арқылы қолжетімді болады.</translation>
<translation id="3134645574591615830">Browther мәзірі &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="ADVANCED_TITLE"/>
          тармағына өтіп, "<ph name="NO_PREFETCH_DESCRIPTION"/>" таңдауын алып тастаңыз.
          Бұл мәселені шешпесе, өнімділікті жақсарту үшін осы опцияны қайта
          таңдауды ұсынамыз.</translation>
<translation id="8927199829149811571">Қауіпсіз Browther for Testing бетін көріп отырсыз.</translation>
<translation id="4220066730874343807">Browther дұрыс өшірілмеді.</translation>
</translationbundle>