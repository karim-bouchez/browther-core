<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="is">
<translation id="130631256467250065">Breytingarnar taka gildi næst þegar þú endurræsir tækið.</translation>
<translation id="5681560603157873402">Farðu í
          valmynd Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          og gakktu úr skugga um að stillt sé á „ekki proxy“ eða „beint“.</translation>
<translation id="4903497818305945122">Hrunskýrslur eru ekki í boði í Browther.</translation>
<translation id="5747951541048369241">Þú ert að skoða örugga Browther síðu</translation>
<translation id="7041193161756628041">Browther er að reyna að breyta stillingum fyrir útfyllingu greiðslumáta.</translation>
<translation id="4670277172953498174">Browther lógóið</translation>
<translation id="3474898875907708105">Browther er að reyna að breyta greiðslumátum.</translation>
<translation id="5700544173546684818">Opna kóðaverkefnið <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> og annar <ph name="BEGIN_LINK_OSS"/>opinn hugbúnaður<ph name="END_LINK_OSS"/> gerir Browther mögulegt.</translation>
<translation id="8935269788853634726">Browther setti þessa síðu á bannlista</translation>
<translation id="1339376981847018870">Veittu Browther aðgang að netkerfinu þínu í eldveggsstillingunum þínum eða
          vírusvarnarstillingunum.</translation>
<translation id="4949828774841497663">Farðu í Forrit &gt; Kerfisstillingar &gt; Netkerfi og veldu
          virkt netkerfi, smelltu á hnappinn Upplýsingar... og afveldu alla staðgengla
          sem kunna að hafa verið valdir.</translation>
<translation id="4191403906356422893">Farðu í
          valmynd Browther&gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Netkerfi og internet &gt; Proxy
          og afveldu „Greina stillingar sjálfkrafa“.</translation>
<translation id="958169674889932546">Þessar síður eru ætlaðar til notkunar hjá þróunaraðilum Browther og er e.t.v. ekki haldið við eða prófaðar reglulega. Til að kveikja á þeim skaltu fara á <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, smella á hnappinn til að kveikja á villuleitarsíðum og fara síðan aftur á þessa síðu.</translation>
<translation id="4303967029316005584">Browther virkar einnig í krafti annars <ph name="BEGIN_LINK_OSS"/>hugbúnaðar með opinn kóða<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">Breytingar þínar munu taka gildi næst þegar þú endurræsir Browther.</translation>
<translation id="221029295134825758">Browther þarf Bluetooth-aðgang til að halda pörun 
 áfram. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">Browther virkar í krafti verkefnis <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> um opinn kóða.</translation>
<translation id="3134645574591615830">Farðu í
        valmynd Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        og taktu valið af „<ph name="NO_PREFETCH_DESCRIPTION"/>“.
        Ef þetta leysir ekki málið mælum við með að gera þennan valkost
        virkan á ný til að auka afköst.</translation>
<translation id="8927199829149811571">Þú ert að skoða örugga Browther for Testing-síðu</translation>
<translation id="4220066730874343807">Browther lokaðist ekki á réttan hátt.</translation>
</translationbundle>