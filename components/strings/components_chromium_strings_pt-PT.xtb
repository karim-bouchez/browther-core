<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="pt-PT">
<translation id="130631256467250065">As alterações terão efeito da próxima vez que reiniciar o dispositivo.</translation>
<translation id="5681560603157873402">Aceda ao
          menu do Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          e certifique-se de que a sua configuração está definida como "sem proxy" ou "direta".</translation>
<translation id="4903497818305945122">O relatório de falha não está disponível no Browther.</translation>
<translation id="5747951541048369241">Está a ver uma página segura do Browther</translation>
<translation id="7041193161756628041">O Browther está a tentar modificar as definições de preenchimento dos métodos de pagamento.</translation>
<translation id="4670277172953498174">Logótipo do Browther</translation>
<translation id="3474898875907708105">O Browther está a tentar editar os métodos de pagamento.</translation>
<translation id="5700544173546684818">O lançamento do Browther foi possível devido ao projeto de código aberto do <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/> e outro <ph name="BEGIN_LINK_OSS"/>software de código aberto<ph name="END_LINK_OSS"/>.</translation>
<translation id="8935269788853634726">Esta página foi bloqueada pelo Browther</translation>
<translation id="1339376981847018870">Permita que o Browther aceda à rede nas definições da sua firewall ou
          do antivírus.</translation>
<translation id="4949828774841497663">Aceda a Aplicações &gt; Definições do sistema &gt; Rede, selecione a
          rede ativa, clique no botão Detalhes… e desmarque todos os proxies
          que possam ter sido selecionados.</translation>
<translation id="4191403906356422893">Aceda ao
          menu do Browther &gt;
          <ph name="SETTINGS_TITLE"/>
          &gt;
          <ph name="SYSTEM_TITLE"/>
          &gt;
          <ph name="PROXIES_TITLE"/>
          &gt;
          Rede e Internet &gt; Proxy
          e desmarque a opção "Detetar automaticamente as definições".</translation>
<translation id="958169674889932546">Estas páginas destinam-se a ser usadas por programadores do Browther e podem não ser testadas nem mantidas ativamente. Para as ativar, navegue para <ph name="BEGIN_LINK"/>chrome://chrome-urls<ph name="LINK_END"/>, clique no botão para ativar as páginas de depuração e, em seguida, navegue para esta página novamente.</translation>
<translation id="4303967029316005584">A criação do Browther também foi possível devido a outro <ph name="BEGIN_LINK_OSS"/>software de código aberto<ph name="END_LINK_OSS"/>.</translation>
<translation id="8031938899816118394">As alterações serão aplicadas da próxima vez que reiniciar o Browther.</translation>
<translation id="221029295134825758">O Browther necessita do acesso ao Bluetooth para continuar 
a sincronização. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK"/></translation>
<translation id="8530161404084147314">A criação do Browther foi possível devido ao projeto de código aberto <ph name="BEGIN_LINK_CHROMIUM"/>Browther<ph name="END_LINK_CHROMIUM"/>.</translation>
<translation id="3134645574591615830">Aceda ao
        menu Browther &gt;
        <ph name="SETTINGS_TITLE"/>
        &gt;
        <ph name="ADVANCED_TITLE"/>
        e desmarque "<ph name="NO_PREFETCH_DESCRIPTION"/>".
        Se isso não resolver o problema, recomendamos que selecione esta opção
        novamente para um desempenho melhorado.</translation>
<translation id="8927199829149811571">Está a ver uma página segura do Browther for Testing</translation>
<translation id="4220066730874343807">O Browther não foi corretamente encerrado.</translation>
</translationbundle>