import("//brave/build/config.gni")

source_set("browther_analytics") {
  sources = [
    "analytics_config.h",
    "browther_analytics_service.cc",
    "browther_analytics_service.h",
    "distinct_id_provider.cc",
    "distinct_id_provider.h",
    "posthog_client.cc",
    "posthog_client.h",
    "pref_names.h",
    "site_report.cc",
    "site_report.h",
    "stats_client.cc",
    "stats_client.h",
  ]

  # posthog_client.cc : propriété commune `version` (CalVer Browther).
  defines = [ "BROWTHER_ANALYTICS_VERSION=\"$browther_version\"" ]

  deps = [
    "//base",
    "//base/version_info",
    "//brave/components/p3a",
    "//components/metrics",
    "//components/prefs",
    # site_report.cc : eTLD+1 (registry_controlled_domains) + WebContents.
    "//content/public/browser",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}
