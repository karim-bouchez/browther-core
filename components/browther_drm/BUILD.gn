import("//mojo/public/tools/bindings/mojom.gni")

mojom("browther_drm") {
  sources = [ "browther_drm.mojom" ]

  # Consommée depuis blink (chromium_src de media_key_session.cc) → il faut la
  # variante -blink, comme //brave/components/brave_drm.
  export_class_attribute_blink = "CORE_EXPORT"
  export_define_blink = "BLINK_CORE_IMPLEMENTATION=1"
  export_header_blink = "third_party/blink/renderer/core/core_export.h"
}
