module sawtunaa.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";

// Interface exposée à l'iframe principal du renderer, bindée par le
// `SawtunaaContentBinder` (browser-side). Reproduit le contrat de
// `SawtunaaScriptHandler.swift` iOS — 11 actions JS → audio pipeline.
//
// Le renderer (JS injecté par le `SawtunaaRenderFrameObserver`) appelle ces
// méthodes via `Mojo.bindInterface("sawtunaa.mojom.Sawtunaa", handle)`.
// Côté browser, l'implémentation transite par `SawtunaaTabHelper` (Java)
// qui pilote `NSNet2Processor` + `SawtunaaAudioPlayer`.
//
// Toutes les méthodes sont fire-and-forget (pas de réponse) — le scheduler
// JS gère son propre tempo (rVFC + setInterval 30 ms côté iOS).
interface Sawtunaa {
  // Plain text log from JS (debug).
  LogJs(string message);

  // Structured metric (JSON-serialised on JS side). Forwardé à PostHog
  // via `BrowtherAnalyticsBridge` Java.
  EmitMetric(string metric_json);

  // Audio chunk : Float32 PCM @ 48 kHz mono, paired with presentation
  // timestamp (in ms relative to media start). Le browser feed `samples`
  // à NSNet2 (denoise), puis enqueue les sorties pour playback.
  // `samples` est passé tel quel via Mojo (sérialisé en `mojo_base.mojom.BigBuffer`
  // pour les gros buffers — chunk typique 48000 samples = 192 KB).
  PreprocessChunk(double timestamp_ms, array<float> samples);

  // Schedule playback up to media-time `timestamp_ms`. L'AudioPlayer
  // côté Java gère le lookahead cap + skip+trim + gap-fill (cf. iOS).
  PlayAt(double timestamp_ms);

  // Reset playback queue (full clear, garde le model NSNet2 chargé).
  ClearChunks();

  // SPA navigation ou page refresh — reset complet (clearChunks + reset
  // GRU states + emit metric). `url` est passé pour debug.
  PageReset(string url);

  // Seek dans la vidéo : flush la queue jusqu'à `to_ms`.
  SeekTo(double to_ms);

  // Évince le range [start_ms, end_ms] de la queue (sync MSE evict).
  EvictRange(double start_ms, double end_ms);

  // Sync la queue avec les ranges actuellement buffered MSE (cleanup
  // out-of-range).
  SyncRanges(array<TimeRange> ranges);

  // Pause/resume du playback Java (ne touche pas au scheduler JS).
  PauseAudio();
  ResumeAudio();
};

struct TimeRange {
  double start_ms;
  double end_ms;
};

// ── Audio tap V2 (Desktop) ───────────────────────────────────────────────────
// Traitement NSNet2 NATIF (ORT C++, process browser) du PCM décodé intercepté
// dans AudioRendererImpl (decode-ahead 2 s). Renderer → browser, bindé par
// frame via BrowserInterfaceBroker (pattern basarunaa.mojom.ImageAnalyzer).
// Handler browser : SawtunaaAudioProcessor (WebContentsUserData) → ThreadPool
// → SawtunaaAudioService (KeyedService, jumeau BasarunaaService).
// Cf. browther-private docs/sawtunaa/AUDIO_TAP_V2.md.
interface AudioTapProcessor {
  // Traite un batch de PCM planar float32 (|channels| blocs contigus de
  // |frames| samples chacun ; batch typique ~256 ms = 12288 frames stéréo
  // 48 kHz ≈ 96 Ko → BigBuffer passe en shared memory). |stream_id| identifie
  // un media player (stable sur sa durée de vie, attribué croissant côté
  // renderer). |flush| (EOS/config change) : renvoyer aussi la queue interne
  // — après flush, la sortie cumulée du flux == l'entrée cumulée.
  //
  // Reply : |processed| planar même layout, possiblement plus court que
  // l'entrée (rétention STFT ~448 samples) ou plus long (flush). |ok| false =
  // traitement indisponible (modèle absent, rate non géré, erreur ORT) → le
  // renderer fait passthrough de l'original. La sortie est alignée
  // échantillon-près sur l'entrée : le renderer reconstruit les timestamps en
  // continu.
  ProcessBatch(int64 stream_id,
               mojo_base.mojom.BigBuffer pcm_planar,
               int32 frames,
               int32 channels,
               int32 sample_rate,
               bool flush) => (bool ok, mojo_base.mojom.BigBuffer processed);

  // Seek/flush pipeline : drop rings + overlap + états GRU du flux.
  ResetStream(int64 stream_id);

  // Fin de vie du media player (destructeur AudioRendererImpl).
  DestroyStream(int64 stream_id);
};

// Browser → renderer. AssociatedInterface bindée par `SawtunaaRenderFrameObserver`.
// Le browser push la valeur courante de la pref `kSawtunaaEnabled` à chaque
// `RenderFrameCreated` et à chaque toggle utilisateur. Le renderer stocke
// l'état localement et gate l'injection du script + le force-mute sur cette
// valeur, sans avoir besoin de reload.
interface SawtunaaConfig {
  // Push de l'état de la pref. Côté renderer:
  //  - si transition false → true : injecte le script (auto-activate).
  //  - si transition true → false : dispatche `sawtunaa-disable` au main world
  //    (le script JS écoute, restaure les descriptors muted/volume natifs et
  //    stoppe son scheduler).
  SetEnabled(bool enabled);
};
