import("//brave/third_party/onnxruntime/onnxruntime.gni")

static_library("core") {
  sources = [
    "sawtunaa_audio_service.cc",
    "sawtunaa_audio_service.h",
    "sawtunaa_features.cc",
    "sawtunaa_features.h",
  ]

  deps = [
    "//base",
    "//components/keyed_service/core",
  ]

  if (enable_sawtunaa_native_ml) {
    sources += [
      "nsnet2_stream.cc",
      "nsnet2_stream.h",
      "sawtunaa_rate_adapter.cc",
      "sawtunaa_rate_adapter.h",
    ]
    deps += [
      "//brave/third_party/onnxruntime",
      "//media",
      "//third_party/pffft",
    ]
    # ⚠️ ODR : à répliquer dans TOUT target qui inclut
    # sawtunaa_audio_service.h (cf. commentaire du header).
    defines = [ "SAWTUNAA_NATIVE_ML=1" ]

    # ORT's C++ API throws Ort::Exception on errors — enable exceptions for
    # this TU only (même choix que basarunaa/core).
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ "//build/config/compiler:exceptions" ]
  }
}

# Browther/Sawtunaa — golden vectors : rejoue les vecteurs générés par
# private/scripts/gen-sawtunaa-golden.py (moteur Python = référence DSP) dans
# Nsnet2Stream et compare. Binaire de dev, jamais bundlé :
#   pnpm build Component sawtunaa_golden_check   (ou ninja via siso)
#   out/Component_arm64/sawtunaa_golden_check --model=… --golden-dir=…
if (enable_sawtunaa_native_ml) {
  executable("sawtunaa_golden_check") {
    testonly = true
    sources = [ "nsnet2_golden_check_main.cc" ]
    deps = [
      ":core",
      "//base",
      "//brave/third_party/onnxruntime",
    ]
    defines = [ "SAWTUNAA_NATIVE_ML=1" ]
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ "//build/config/compiler:exceptions" ]
  }
}
