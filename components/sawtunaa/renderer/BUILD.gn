# Action GN qui génère sawtunaa_script_generated.h en concaténant le bundle
# Opus decoder (définit `OpusDecoderLib` global, ~105 KB / 888 l) + le
# SawtunaaScript principal (~33 KB / 843 l). Pattern reproduit du loading
# iOS (SawtunaaScriptHandler.swift : `script = opusSource + "\n" + script`).
# Les .js restent sources de vérité, le .h est un raw-string-literal wrapper
# autogénéré à chaque build.
action("generate_sawtunaa_script_header") {
  script = "generate_script_header.py"
  inputs = [
    "sawtunaa_opus_decoder_bundle.js",
    "sawtunaa_script.js",
  ]
  outputs = [ "$target_gen_dir/sawtunaa_script_generated.h" ]
  args = [
    rebase_path("sawtunaa_opus_decoder_bundle.js", root_build_dir),
    rebase_path("sawtunaa_script.js", root_build_dir),
    rebase_path("$target_gen_dir/sawtunaa_script_generated.h", root_build_dir),
  ]
}

source_set("renderer") {
  sources = [
    "sawtunaa_audio_tap_client.cc",
    "sawtunaa_audio_tap_client.h",
    "sawtunaa_js_handler.cc",
    "sawtunaa_js_handler.h",
    "sawtunaa_render_frame_observer.cc",
    "sawtunaa_render_frame_observer.h",
  ]
  deps = [
    ":generate_sawtunaa_script_header",
    "//base",
    "//brave/components/sawtunaa/common/mojom",
    "//content/public/renderer",
    "//gin",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//third_party/blink/public:blink_headers",
    "//v8",
  ]
}
