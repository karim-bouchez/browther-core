# Action GN qui génère sawtunaa_script_generated.h depuis sawtunaa_script.js
# (le .js reste source de vérité, le .h est un raw-string-literal wrapper
# autogénéré à chaque build). Pattern Brave R"JS(...)JS" mais externalisé
# pour éviter d'avoir 843 lignes de JS embedded dans un .cc.
action("generate_sawtunaa_script_header") {
  script = "generate_script_header.py"
  inputs = [ "sawtunaa_script.js" ]
  outputs = [ "$target_gen_dir/sawtunaa_script_generated.h" ]
  args = [
    rebase_path("sawtunaa_script.js", root_build_dir),
    rebase_path("$target_gen_dir/sawtunaa_script_generated.h", root_build_dir),
  ]
}

source_set("renderer") {
  sources = [
    "sawtunaa_js_handler.cc",
    "sawtunaa_js_handler.h",
    "sawtunaa_render_frame_observer.cc",
    "sawtunaa_render_frame_observer.h",
  ]
  deps = [
    ":generate_sawtunaa_script_header",
    "//base",
    "//brave/components/sawtunaa/common/mojom",
    "//content/public/renderer",
    "//gin",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public:blink",
    "//third_party/blink/public:blink_headers",
    "//v8",
  ]
}
