# Browther: filter lists bundlées dans l'app au build time. Évite
# go-updater.brave.com qui requiert un BraveServiceKey privé. Voir
# private/docs/SHIELDS_BUNDLE.md. Le sous-dossier shields_bundled_lists/
# (BUILD.gn + .txt + .json) est régénéré par
# private/scripts/fetch-shields-lists.sh et gitignored.
# Cible : //brave/components/brave_shields/core/browser/shields_bundled_lists:shields_bundled_lists_data

static_library("browser") {
  sources = [
    "ad_block_component_filters_provider.cc",
    "ad_block_component_filters_provider.h",
    "ad_block_component_installer.cc",
    "ad_block_component_installer.h",
    "ad_block_component_service_manager.cc",
    "ad_block_component_service_manager.h",
    "ad_block_custom_resource_provider.cc",
    "ad_block_custom_resource_provider.h",
    "ad_block_default_resource_provider.cc",
    "ad_block_default_resource_provider.h",
    "ad_block_filter_list_catalog_provider.cc",
    "ad_block_filter_list_catalog_provider.h",
    "ad_block_filters_provider.cc",
    "ad_block_filters_provider.h",
    "ad_block_filters_provider_manager.cc",
    "ad_block_filters_provider_manager.h",
    "ad_block_list_p3a.cc",
    "ad_block_list_p3a.h",
    "ad_block_resource_provider.cc",
    "ad_block_resource_provider.h",
    "ad_block_service_helper.cc",
    "ad_block_service_helper.h",
    "brave_shields_locale_utils.cc",
    "brave_shields_locale_utils.h",
    "brave_shields_p3a.cc",
    "brave_shields_p3a.h",
    "brave_shields_settings_service.cc",
    "brave_shields_settings_service.h",
    "brave_shields_utils.cc",
    "brave_shields_utils.h",
    "filter_list_catalog_entry.cc",
    "filter_list_catalog_entry.h",
  ]
  if (is_android) {
    sources += [
      "shields_bundled_apk_extractor.cc",
      "shields_bundled_apk_extractor.h",
    ]
  }
  deps = [
    "//base",
    "//brave/components/brave_component_updater/browser",
    "//brave/components/brave_shields/core/common",
    "//brave/components/brave_shields/core/common:mojom",
    "//brave/components/constants",
    "//brave/components/content_settings/core/common",
    "//brave/components/https_upgrade_exceptions/browser",
    "//brave/components/p3a",
    "//brave/components/p3a_utils",
    "//brave/components/webcompat/core/common",
    "//components/component_updater",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/browser:cookie_settings",
    "//components/content_settings/core/common",
    "//components/keyed_service/core",
    "//components/prefs",
    "//components/value_store",
    "//crypto",
    "//url",
  ]
  public_deps = [
    "//base",
    "//brave/components/brave_shields/core/common/adblock",
  ]

  # Browther: filter lists bundlées dans l'app au build time. Voir
  # private/docs/SHIELDS_BUNDLE.md.
  # - Mac : bundle_data → framework Resources/adblock_lists/
  # - Win/Linux : copy() → $root_out_dir/resources/adblock_lists/
  # - Android : android_assets → APK assets/adblock_lists/, extraits au
  #   premier boot vers DIR_USER_DATA via shields_bundled_apk_extractor.cc
  if (is_mac || is_win || is_linux || is_android) {
    deps += [ "shields_bundled_lists:shields_bundled_lists_data" ]
  }
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "ad_block_custom_resource_provider_unittest.cc",
    "brave_shields_locale_utils_unittest.cc",
    "brave_shields_settings_service_unittest.cc",
  ]

  deps = [
    ":browser",
    "//base/test:test_support",
    "//brave/components/brave_shields/core/common",
    "//brave/components/brave_shields/core/common/adblock",
    "//components/content_settings/core/browser",
    "//components/content_settings/core/common",
    "//components/content_settings/core/test:test_support",
    "//components/prefs",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
    "//url",
  ]
}
