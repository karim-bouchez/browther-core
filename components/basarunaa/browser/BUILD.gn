assert(is_android,
       "basarunaa/browser/ est Android-only. Le pipeline desktop est MV3.")

source_set("browser") {
  sources = [
    "basarunaa_tab_helper.cc",
    "basarunaa_tab_helper.h",
  ]
  deps = [
    "//base",
    "//brave/components/basarunaa/common/mojom:mojom_android",
    "//brave/components/constants",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
  ]

  # Browther: Basarunaa Jalon 2.D — bridges JNI vers BasarunaaBridge.java
  # + BasarunaaTabAnalyzer.java générés par brave/build/android:jni_headers.
  deps += [ "//brave/build/android:jni_headers" ]
}
