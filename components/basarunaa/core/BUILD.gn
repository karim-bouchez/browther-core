import("//brave/third_party/onnxruntime/onnxruntime.gni")

static_library("core") {
  sources = [
    "basarunaa_service.cc",
    "basarunaa_service.h",
  ]

  deps = [
    "//base",
    "//components/keyed_service/core",
  ]

  if (enable_basarunaa_native_ml) {
    deps += [ "//brave/third_party/onnxruntime" ]
    defines = [ "BASARUNAA_NATIVE_ML=1" ]
    # ORT's C++ API throws Ort::Exception on errors — enable exceptions for
    # this TU only. Scoped to basarunaa/core so the rest of the browser keeps
    # the global no-exceptions guarantee.
    configs -= [ "//build/config/compiler:no_exceptions" ]
    configs += [ "//build/config/compiler:exceptions" ]
  }
}
