module basarunaa.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";

// Used by the WebUI page (chrome-untrusted://basarunaa-panel.top-chrome) to
// bootstrap bidirectional communication with the browser process.
// Mirrors the brave_vpn PanelHandlerFactory pattern. Kept minimal for the
// bisect rebuild — the real Basarunaa interface will be added back later.
interface PanelHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePanelHandler(pending_receiver<PanelHandler> panel_handler);
};

// Browser-side handler for requests from the Basarunaa panel WebUI.
// Intentionally empty for the bisect rebuild.
interface PanelHandler {
  // Notify the backend that the UI is ready to be shown. Required so that
  // the embedder reveals the bubble widget on subsequent re-opens (this is
  // the load-bearing handshake that the VPN panel relies on, paired with
  // the `visibilitychange` listener on the WebUI side).
  ShowUI();

  // Notify the backend that the dialog should be closed.
  CloseUI();

  // Read/write the global Basarunaa enabled pref. The pref drives extension
  // load/unload via BraveComponentLoader and the toolbar badge color.
  GetEnabled() => (bool enabled);
  SetEnabled(bool enabled);

  // Read/write the action mode pref (blur-female | blur-male | blur-all).
  GetMode() => (string mode);
  SetMode(string mode);

  // Detection threshold sliders (double in [0.0, 1.0]).
  GetSliders() => (double conf_body, double conf_face, double gender_certainty);
  SetConfBody(double value);
  SetConfFace(double value);
  SetGenderCertainty(double value);

  // Dev-only: debug overlay mode ("none" | "boxes" | "debug") and capture
  // mode (saves analyzed images to ~/Downloads/basarunaa-capture/).
  GetDevSettings() => (string debug_mode, bool capture_mode);
  SetDebugMode(string mode);
  SetCaptureMode(bool enabled);

  // Phase 3.1.5 — M1.3 debug. Runs the native YOLO11n-pose pipeline on a
  // bundled test image (Browther.app/Contents/MacOS/basarunaa/test/groupe.jpg)
  // and logs per-detection bbox + score via LOG(INFO). Returns the number of
  // persons detected (0 on error, or if the image is missing).
  AnalyzeTestImage() => (int32 count);
};

// Phase 3.1.5 — M2.1. Renderer-process side calls this to ask the browser
// process to run the native ML pipeline (YOLO11n-pose) on a packed pixel
// buffer. The renderer captures the SkBitmap from `ImageResourceContent` and
// forwards the raw bytes via `BigBuffer` (auto-promotes to SharedMemory above
// the Mojo inline cutoff). One receiver per `RenderFrameHost`, exposed via
// `BraveContentBrowserClient::RegisterAssociatedInterfaceBindersForRenderFrameHost`.
enum ImageFormat {
  kRgba8,
  kBgra8,
};

struct KeyPoint {
  float x;
  float y;
  float confidence;
};

// Bbox stocké en x1/y1/x2/y2 (coords pixel image originale).
struct Bbox {
  float x1;
  float y1;
  float x2;
  float y2;
};

struct AnalyzedPerson {
  // Bbox in pixel coordinates of the input image (NOT the 640x640 letterbox).
  // Convention {x, y, w, h} = top-left + width/height pour rester compat avec
  // les anciens consommateurs ; la dérivation x2 = x+w / y2 = y+h est triviale.
  float x;
  float y;
  float w;
  float h;
  // Person class score in [0, 1].
  float score;
  // 17 COCO keypoints (M1.4) : nose, eyes, ears, shoulders, elbows, wrists,
  // hips, knees, ankles. Vide si l'inférence ne les a pas produits (modèle
  // détection seule sans pose). Coords dans l'espace pixel original.
  array<KeyPoint> keypoints;
  // Bbox du visage déduit des keypoints 0-4 (nose + eyes + ears) avec un
  // padding de 40%. null si moins de 2 keypoints visibles.
  Bbox? face_bbox;
};

interface ImageAnalyzer {
  AnalyzeImage(mojo_base.mojom.BigBuffer pixels,
               int32 width,
               int32 height,
               ImageFormat format) => (array<AnalyzedPerson> persons);
};
