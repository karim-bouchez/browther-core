module basarunaa.mojom;

import "mojo/public/mojom/base/big_buffer.mojom";

// Used by the WebUI page (chrome-untrusted://basarunaa-panel.top-chrome) to
// bootstrap bidirectional communication with the browser process.
// Mirrors the brave_vpn PanelHandlerFactory pattern.
interface PanelHandlerFactory {
  // The WebUI calls this method when the page is first initialized.
  CreatePanelHandler(pending_receiver<PanelHandler> panel_handler);
};

// Browser-side handler for requests from the Basarunaa panel WebUI.
interface PanelHandler {
  // Notify the backend that the UI is ready to be shown. Required so that
  // the embedder reveals the bubble widget on subsequent re-opens (this is
  // the load-bearing handshake that the VPN panel relies on, paired with
  // the `visibilitychange` listener on the WebUI side).
  ShowUI();

  // Notify the backend that the dialog should be closed.
  CloseUI();

  // Read/write the global Basarunaa enabled pref. The pref drives extension
  // load/unload via BraveComponentLoader and the toolbar badge color.
  GetEnabled() => (bool enabled);
  SetEnabled(bool enabled);

  // Browther : faut-il afficher l'encadré « contenu protégé (DRM) » ?
  // Répond à la question que l'utilisateur se pose en ouvrant le panel après
  // avoir vu le badge AMBRE de la toolbar. MÊME condition que le badge :
  // Basarunaa ON + verdict DRM rendu sur l'onglet actif. Pas de gate
  // `native_tap_active` ici (contrairement à Sawtunaa) : le floutage est coupé
  // sur du DRM quelle que soit la plateforme, il n'existe aucun repli.
  // Cf. private/docs/WIDEVINE_VMP.md § 10.5.
  GetProtectedContent() => (bool visible);

  // Browther : « le floutage ne marche pas sur ce site ». L'utilisateur juge
  // lui-même (il sait ce qu'il s'attendait à voir flouté) et clique ; on
  // n'essaie pas de deviner à sa place. Sert à savoir sur quels sites les gens
  // attendent quelque chose — la couverture réelle dépend de trop de facteurs
  // (players en iframe, DRM, vidéos jamais lues) pour être devinée depuis le
  // code.
  //
  // Vie privée : on ne transmet QUE le domaine enregistrable (eTLD+1) de
  // l'onglet actif — jamais l'URL, jamais le chemin, jamais les paramètres —
  // et uniquement sur clic explicite.
  //
  // `can_report` = faux quand le site n'a pas de domaine (pages internes) ou
  // quand l'utilisateur a coupé les statistiques d'usage : dans ce dernier cas
  // le signalement ne partirait pas, et proposer le bouton serait mentir.
  GetReportSiteState() => (bool can_report, string domain, bool analytics_off);
  ReportSite() => (bool sent);

  // Read/write the action mode pref (blur-female | blur-male | blur-all).
  GetMode() => (string mode);
  SetMode(string mode);

  // Read/write the "censure des yeux" pref (opt-in, default false). Quand ON,
  // l'extension reconstruit la peau sur la bande des yeux de TOUTE personne non
  // déjà floutée par genre — indépendamment du mode.
  GetCensorEyes() => (bool enabled);
  SetCensorEyes(bool enabled);

  // Read/write NSFW detection (Marqo plein cadre + NudeNet). Opt-in, default off :
  // Marqo est CPU-bound (~120ms) → off = latence optimale (genre seul). L'utilisateur
  // l'active s'il veut le flou plein cadre sur contenu explicite.
  GetNsfwEnabled() => (bool enabled);
  SetNsfwEnabled(bool enabled);

  // Detection threshold sliders (double in [0.0, 1.0]).
  // Browther dev tuning : sentinel_conf (NanoDet vidéo), min_skeleton (filtre
  // anti-faux-positifs), nsfw_conf (Marqo), nudenet_conf (parties explicites).
  GetSliders() => (double conf_body,
                   double gender_certainty,
                   double sentinel_conf,
                   double min_skeleton,
                   double nsfw_conf,
                   double nudenet_conf);
  SetConfBody(double value);
  SetGenderCertainty(double value);
  SetSentinelConf(double value);
  SetMinSkeleton(double value);
  SetNsfwConf(double value);
  SetNudenetConf(double value);

  // Dev-only: debug overlay mode ("none" | "boxes" | "debug"), capture mode
  // (saves analyzed images to ~/Downloads/basarunaa-capture/), et blur_enabled
  // (false = coupe le floutage en gardant l'analyse + l'overlay debug).
  // `collect_enabled` : collecte d'un corpus de navigation pour le
  // ré-entraînement du modèle. Opt-in strict, default false, local.
  GetDevSettings() => (string debug_mode, bool capture_mode, bool blur_enabled,
                       bool collect_enabled);
  SetDebugMode(string mode);
  SetCaptureMode(bool enabled);
  SetBlurEnabled(bool enabled);
  SetCollectEnabled(bool enabled);
};

// Phase 3.1.5 — Étape 2 mini-spike (2026-05-10). On recrée l'interface
// ImageAnalyzer pour valider que le pattern Mojo IPC renderer→browser pur
// (sans V8/cppgc/JS bridge) est stable. Le bridge MV3 (Phase 2 V1) qui
// utilisait V8 + cppgc::Wrappable + WeakPtr a été retiré le matin même —
// hypothèse : le crash venait de cette chaîne JS, pas de Mojo+BigBuffer.
// Cette interface sera consommée par un C++ RenderFrameObserver hooké sur
// les évènements Blink (M2.2). V1 minimal : juste bbox + score, pas de
// keypoints (à rajouter en M2.5 quand le pattern est validé).
// Browther/Basarunaa — push browser→renderer de la pref utilisateur
// `kBasarunaaEnabled` (jumeau de `sawtunaa.mojom SawtunaaConfig`). Le switch
// `--basarunaa-video-tap` ne porte QUE la capacité du build (feature
// decode-ahead) : la pref, elle, est poussée en LIVE par
// BasarunaaVideoTapTabHelper à RenderFrameCreated et à chaque toggle. Sans ce
// canal, le tap vidéo restait figé à la valeur lue au démarrage du process
// renderer (OFF = readbacks + ML qui tournent pour rien, ON = tap mort
// jusqu'au restart).
interface VideoTapConfig {
  SetEnabled(bool enabled);
};

enum ImageFormat {
  kRgba8,
  kBgra8,
};

// Un keypoint COCO (17 par personne, ordre YOLO-pose). x/y NORMALISÉS [0,1] sur
// l'image analysée. Sert à l'overlay pour : dessiner le squelette (debug), le
// filtre min-squelette (anti faux-positif main/objet), et le flou en forme de
// corps (polygone). confidence < seuil = keypoint non fiable.
struct KeyPoint {
  float x;
  float y;
  float confidence;
};

struct AnalyzedPerson {
  // Bbox dans coords pixel image originale (top-left + w,h).
  float x;
  float y;
  float w;
  float h;
  // Score de la classe gagnante dans [0, 1] (= gender_conf).
  float score;
  // Genre single-shot gender-v2n : -1 inconnu, 0 homme, 1 femme, 2 enfant.
  // L'enfant (2) n'est pas une cible en mode genré → non flouté si confiant
  // (flouté par le filet gender_certainty s'il est incertain). Parité image.
  int8 gender;
  // Confiance du genre (= score de la classe) dans [0, 1] ; < 0 si non détecté.
  float gender_conf;
  // Décision shouldBlur du browser (repli + stats NTP). L'overlay la RECALCULE
  // depuis le genre VOTÉ (plus stable) ; ce flag sert de repli avant le 1er vote.
  bool blur;
  // 17 keypoints COCO (x/y normalisés) → squelette debug + filtre min-squelette +
  // flou polygone côté overlay. Vide si le décodage pose a échoué.
  array<KeyPoint> keypoints;
};

interface ImageAnalyzer {
  // Analyse INCONDITIONNELLE : le browser analyse TOUTE frame qu'il reçoit (plus
  // de cadence/skip côté browser — c'est le RFO renderer qui décide quoi envoyer :
  // keyframes à cadence garantie + paires n-1/n aux cuts, cf. refonte 2026-07-04).
  // Renvoie TOUTES les personnes détectées (pas seulement celles à flouter, pour
  // l'overlay debug) + le mode debug ("none"|"boxes"|"debug") + blur_enabled, lus
  // dans les prefs profil. La nature de la frame (keyframe / avant-cut / après-cut)
  // n'est PAS transmise ici : elle est connue du RFO qui a décidé le tap, et
  // rattachée côté renderer au dispatch vers la page (via le callback lié).
  // Le reply porte aussi `mode` (blur-female|blur-male|blur-all) + `gender_certainty`
  // pour que l'overlay RECALCULE shouldBlur depuis le genre VOTÉ (le vote vivant
  // côté overlay, pas ici). Ce sont les mêmes prefs qui servent au flag `blur` repli.
  // want_nsfw : le RFO throttle le check NSFW (Marqo) à ~1/s + sur les cuts (le
  // NSFW ne change pas d'une frame à l'autre) → il n'est calculé que sur ces
  // frames-là ; ailleurs nsfw_score revient < 0 et l'overlay gèle le dernier
  // verdict. Évite de payer Marqo (~120ms) à chaque analyse.
  AnalyzeImage(mojo_base.mojom.BigBuffer pixels,
               int32 width,
               int32 height,
               ImageFormat format,
               bool want_nsfw)
      => (array<AnalyzedPerson> persons,
          string debug_mode,
          bool blur_enabled,
          string mode,
          double gender_certainty,
          double min_skeleton,
          // NSFW image entière (Marqo) : nsfw = flou plein cadre à appliquer ;
          // nsfw_score [0,1] pour le HUD debug (< 0 si Marqo indispo).
          bool nsfw,
          float nsfw_score,
          // Browther : pref « censure des yeux » (opt-in). L'overlay dessine une
          // bande floutée forte (backdrop-filter, masquée en ellipse) sur les yeux
          // de chaque personne NON floutée par genre — indépendamment du mode.
          bool censor_eyes);
};
