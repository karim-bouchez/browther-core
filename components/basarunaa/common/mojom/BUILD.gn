import("//mojo/public/tools/bindings/mojom.gni")
import("//tools/grit/preprocess_if_expr.gni")

preprocess_folder = "preprocessed"
preprocess_mojo_manifest = "preprocessed_mojo_manifest.json"

preprocess_if_expr("preprocess_mojo") {
  deps = [ ":mojom_js" ]
  in_folder = "$target_gen_dir"
  out_folder = "$target_gen_dir/$preprocess_folder"
  out_manifest = "$target_gen_dir/$preprocess_mojo_manifest"
  in_files = [ "basarunaa.mojom-lite.js" ]
}

mojom("mojom") {
  sources = [ "basarunaa.mojom" ]

  public_deps = [ "//mojo/public/mojom/base" ]
}

# Browther: Jalon 2 port natif Android. IDL séparé pour ne pas mélanger
# avec le WebUI panel desktop + M2 spike ImageAnalyzer. generate_java=true
# pour exposer les types via Java/JNI au BasarunaaTabAnalyzer + bridge.
if (is_android) {
  mojom("mojom_android") {
    generate_java = true
    sources = [ "basarunaa_android.mojom" ]
  }
}
