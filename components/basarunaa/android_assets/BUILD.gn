#
# Basarunaa Android — bundle modèles ONNX (Jalon 1 bench + Jalon 2.E pipeline prod).
#
# Bundle les 6 modèles ONNX du pipeline Basarunaa sous
# `assets/basarunaa/*.onnx` dans l'APK. Lus au runtime par
# `BasarunaaBenchmark` (Jalon 1) et `BasarunaaEngine` (Jalon 2.E) via
# `AssetManager.open("basarunaa/...")`.
#
# Les fichiers .onnx sont gitignored : ils sont copiés ici à chaque build
# par `private/scripts/fetch-basarunaa-models.sh` (source = le POC
# `private/extensions/basarunaa/public/models/`). Relancer ce script après
# chaque sync upstream (les modèles ne survivent pas à un nouveau worktree).
#
# Cible tirée par `brave_chrome_java_deps` (voir
# `brave/build/android/config.gni`) — sinon la resource Android ne se
# propage pas à `chrome_java`.
#
# Modèles prod bundlés (single-shot 2026-07-13, retrait sentinel 2026-08-03,
# ré-exposition NSFW opt-in 2026-08-04) :
#   - gender-v2n-640.onnx                (~6 MB)  — persons + genre 3 classes
#     + 17 keypoints COCO, one-shot (remplace la cascade ET le sentinel)
#   - nudenet-320.onnx                   (12 MB)  — NSFW plein cadre, opt-in
#     (pref nsfw_enabled OFF par défaut ; NudeNet seul, pas de Marqo — cf.
#     NudeNetDetector.java)
# Les .tflite restants ne servent qu'à BasarunaaBenchmark (bench latence).
#
# Le modèle nsfw-marqo-vit-384 (23 MB) reste hors-bundle : POC macOS l'a
# remplacé par NudeNet (2× plus léger + équivalent recall).
#
# V3 (2026-06-09) — 4 modèles .tflite additionnels (~22 MB) pour le runtime
# TFLite + GpuDelegate. Les 2 modèles non-convertibles (yolov8n-face,
# nudenet-320) restent en ONNX et sont chargés par leurs détecteurs ORT
# respectifs (cf. private/docs/V3_GPU_BENCH.md § Phase 1). yolo11n-pose en
# FP32 seulement (FP16 KO, max_diff 3.27 cf. mêmes notes).

import("//build/config/android/rules.gni")

assert(is_android)

android_assets("basarunaa_models_android_assets") {
  # Uniquement renaming_sources (PAS sources). `sources` ET
  # `renaming_sources` sont deux listes distinctes qui s'ADDITIONNENT dans
  # l'APK : utiliser les deux pour le même fichier = doublons.
  # nanodet-plus-m_320.onnx retiré 2026-08-03 (sentinel prod supprimé —
  # vidéo one-tier gender-v2n). Le .fp32.tflite reste pour BasarunaaBenchmark.
  renaming_sources = [
    "gender-v2n-640.onnx",
    "genderage.fp16.tflite",
    "genderage.fp32.tflite",
    "nanodet-plus-m_320.fp32.tflite",
    "nudenet-320.onnx",
    "pplcnet_pedestrian_attribute.fp16.tflite",
    "pplcnet_pedestrian_attribute.fp32.tflite",
    "yolo11n-pose.fp32.tflite",
  ]
  renaming_destinations = [
    "basarunaa/gender-v2n-640.onnx",
    "basarunaa/genderage.fp16.tflite",
    "basarunaa/genderage.fp32.tflite",
    "basarunaa/nanodet-plus-m_320.fp32.tflite",
    "basarunaa/nudenet-320.onnx",
    "basarunaa/pplcnet_pedestrian_attribute.fp16.tflite",
    "basarunaa/pplcnet_pedestrian_attribute.fp32.tflite",
    "basarunaa/yolo11n-pose.fp32.tflite",
  ]
  # Les modèles ONNX et TFLite sont déjà des blobs binaires compressés
  # (Protobuf pour ONNX, FlatBuffer pour TFLite). Pas besoin d'une
  # compression APK supplémentaire (négligeable + bloquerait le
  # mmap-friendly openFd() côté runtime).
  disable_compression = true
}
