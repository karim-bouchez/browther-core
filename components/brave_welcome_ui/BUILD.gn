import("//brave/components/brave_origin/buildflags/buildflags.gni")
import("//brave/components/common/typescript.gni")

if (is_brave_origin_branded) {
  _welcome_logo_source = "assets/brave_origin_logo@2x.webp"
} else {
  _welcome_logo_source = "assets/brave_logo_3d@2x.webp"
}

copy("welcome_logo") {
  sources = [ _welcome_logo_source ]
  outputs =
      [ "$root_gen_dir/brave/components/brave_welcome_ui/welcome_logo@2x.webp" ]
}

transpile_web_ui("brave_welcome_ui") {
  output_module = false
  entry_points = [ [
        "brave_welcome",
        rebase_path("brave_welcome.tsx"),
      ] ]

  resource_name = "brave_welcome"

  imports_from = [
    "//brave/components/brave_welcome_ui/",

    # Browther : l'introduction importe les médias, icônes et visuels de l'iOS
    # À LEUR PLACE (mêmes fichiers sur toutes les plateformes,
    # ONBOARDING-SPEC.md § 6) et le gros interrupteur des panneaux.
    "//brave/components/brave_shields/resources/panel/components/browther-big-toggle/",
    "//brave/ios/brave-ios/Sources/Brave/Assets/Images.xcassets/",
    "//brave/ios/brave-ios/Sources/Brave/Frontend/Browther/Intro/Resources/",
    "//brave/ios/brave-ios/Sources/Onboarding/WelcomeFocus/Resources/FocusOnboardingImages.xcassets/",
  ]

  deps = [ ":welcome_logo" ]
}

pack_web_resources("generated_resources") {
  resource_name = "brave_welcome"
  output_dir = "$root_gen_dir/brave/components/brave_welcome/resources"
  deps = [ ":brave_welcome_ui" ]
}
